+// caller advances its own state as the C loop would have.
+static void ia64_yuv_linear_chunks(uint32_t* dest, int n, sampler2DRect samplerY,
+                                   I32 yU, int32_t yDU, int32_t yOffsetV,
+                                   int32_t yStrideV, int16_t yFracV,
+                                   sampler2DRect samplerU,
+                                   sampler2DRect samplerV, I32 cU, int32_t cDU,
+                                   int32_t cOffsetV, int32_t cStrideV,
+                                   int16_t cFracV,
+                                   const YUVMatrix& colorSpace) {
+  IA64YUVRowLinear p;
+  p.yu01 = ia64_lanes32(yU.x - yDU, yU.y - yDU);
+  p.yu23 = ia64_lanes32(yU.z - yDU, yU.w - yDU);
+  p.cu01 = ia64_lanes32(cU.x - cDU, cU.y - cDU);
+  p.cu23 = ia64_lanes32(cU.z - cDU, cU.w - cDU);
+  p.ydu = ia64_lanes32(yDU, yDU);
+  p.cdu = ia64_lanes32(cDU, cDU);
+  p.y = (const uint8_t*)samplerY->buf + yOffsetV;
+  p.u = (const uint8_t*)samplerU->buf + cOffsetV;
+  p.v = (const uint8_t*)samplerV->buf + cOffsetV;
+  p.ystride = yStrideV;
+  p.cstride = cStrideV;
+  p.fy = ia64_lanes16(yFracV, yFracV, yFracV, yFracV);
+  p.fc = ia64_lanes16(cFracV, cFracV, cFracV, cFracV);
+  p.yw2 = ia64_lanes32(int32_t(samplerY->width) - 2,
+                       int32_t(samplerY->width) - 2);
+  p.cw2 = ia64_lanes32(int32_t(samplerU->width) - 2,
+                       int32_t(samplerU->width) - 2);
+  p.c127 = ia64_lanes32(127, 127);
+  p.yc = ia64_low_u64(colorSpace.yCoeffs);
+  p.yb = ia64_low_u64(colorSpace.yBias);
+  p.uvb = ia64_low_u64(colorSpace.uvBias);
+  p.brc = ia64_low_u64(colorSpace.br_uvCoeffs);
+  p.ggc = ia64_low_u64(colorSpace.gg_uvCoeffs);
+  p.mask = ia64_low_u64(colorSpace.br_yMask);
+  swgl_yuv42_row_linear_ia64(dest, n, &p);
