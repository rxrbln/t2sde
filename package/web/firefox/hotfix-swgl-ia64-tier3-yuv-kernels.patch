+// textureLinearRowPairedR8 + convert), same generator: positions are not
+// fractions-split here, the kernel clamps them as those functions do.
+struct IA64YUVRowLinear {
+  uint64_t yu01, yu23, cu01, cu23;  // positions (yU, cU), two int32 lanes each
+  uint64_t ydu, cdu;                // position steps, both lanes
+  const uint8_t *y, *u, *v;         // row 0 of each plane
+  int64_t ystride, cstride;         // to row 1 (0 at the last row)
+  uint64_t fy, fc;                  // row fractions, four lanes
+  uint64_t yw2, cw2, c127;          // width - 2 and 127, both lanes
+  uint64_t yc, yb, uvb, brc, ggc, mask;  // YUVMatrix, low half of each
+};
+extern "C" void swgl_yuv42_row_linear_ia64(uint32_t* dst, long n,
+                                           const IA64YUVRowLinear* params);
