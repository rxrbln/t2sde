+// 64-bit register: lanes are little-endian, positions and fractions are
+// pre-decremented by one step since the kernel advances them first.
+struct IA64YUVRow {
+  uint64_t yu01, yu23;  // luma positions, two int32 lanes each
+  uint64_t cu;          // chroma positions (A, B)
+  uint64_t fxy, fxc;    // ycFracX, low and high half
+  uint64_t ydu, cdu;    // position steps, both lanes
+  uint64_t fxdy, fxdc;  // ycFracDX, low and high half
+  const uint8_t *y, *u, *v;
+  int64_t ystride, cstride;
+  uint64_t fy, fc;  // row fractions, four lanes
+  uint64_t yc, yb, uvb, brc, ggc, mask;  // YUVMatrix, low half of each
+};
+extern "C" void swgl_yuv42_row_ia64(uint32_t* dst, long n,
+                                    const IA64YUVRow* params);
+
+template <typename V>
+static ALWAYS_INLINE uint64_t ia64_low_u64(const V& v) {
+  uint64_t r;
+  memcpy(&r, &v, sizeof(r));
+  return r;
+}
+
+static ALWAYS_INLINE uint64_t ia64_lanes32(int32_t a, int32_t b) {
+  return uint64_t(uint32_t(a)) | uint64_t(uint32_t(b)) << 32;
+}
+
+static ALWAYS_INLINE uint64_t ia64_lanes16(int32_t a, int32_t b, int32_t c,
+                                           int32_t d) {
+  return uint64_t(uint16_t(a)) | uint64_t(uint16_t(b)) << 16 |
+         uint64_t(uint16_t(c)) << 32 | uint64_t(uint16_t(d)) << 48;
+}
