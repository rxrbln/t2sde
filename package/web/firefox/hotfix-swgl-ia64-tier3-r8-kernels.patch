# Tier III (dav1d's terminology, see package/multimedia/dav1d/ia64-simd.patch)
# kernels for the R8 bilinear span with a constant row: a standalone assembly
# file with its own register frame, modulo-scheduled with rotating registers
# and br.ctop. One op list, four entry points that differ in the commit:
#
#   mask   mask bytes only; the generic C commit runs after it (any blend key)
#   bcast  the mask in every channel (no color, no blend)
#   color  muldiv255(color, mask)
#   over   that, blended premultiplied source-over onto the destination
#
# The fused ones run only for a uniform color (NoColor is passed as 255, which
# is exact) and no blend or exactly premultiplied source-over; clip-mask, AA
# and other blend keys keep the mask kernel. ps_text_run's grayscale glyphs and
# ps_quad_textured's masks are what reach this path.
#
# The .S is generated by a scheduler kept in the benchmark tree, not here. It
# models what the Itanium 2 manual and the PMU showed matters: nops take
# dispersal ports (a nop.i past the second I slot splits the issue), getf
# issues only on M2, multimedia -> multimedia latency is effectively 3, and
# framebuffer reads are scheduled as L2 hits with an lfetch ahead. It also
# saves pr, because mov pr.rot clobbers p16-p63, which the ABI preserves.
#
# Itanium 2 (Montecito), cycles per pixel, byte-identical output; x86-64 for
# scale is the same benchmark on a Ryzen 5900HX:
#                            C path    Tier III   x86-64
#   R8 mask 0.5 texel/px      38.3        6.6      31.4
#   R8 mask color             --          7.9      32.4
#   R8 mask color blend       51.7       10.8      40.1

--- firefox-158.0/gfx/wr/swgl/src/swgl_ext.h.vanilla
+++ firefox-158.0/gfx/wr/swgl/src/swgl_ext.h
@@ -631,6 +631,57 @@
 #define swgl_commitTextureLinearColorR8(s, p, uv_rect, color) \
   swgl_commitTextureLinear(R8, s, p, uv_rect, color, swgl_SpanLength)
 
+#ifdef __ia64__
+// Tier III kernels for the constant-row R8 loop below, generated by
+// tools/ia64-gen/genr8row_s.py. Each runs n four-pixel steps of
+// textureLinearUnpackedR8 and advances x[] by n steps; they differ in the
+// commit:
+//   mask   writes the mask bytes, for the generic commit
+//   bcast  expand_mask: the mask in every channel (no color, no blend)
+//   color  muldiv255(color, mask)
+//   over   that, blended premultiplied source-over onto dst
+// The generator hard-codes this layout.
+struct IA64R8Row {
+  float x[4];
+  float step, min_x, max_x;
+  int32_t width2;
+  uint64_t fracy;  // the y fraction in all four 16-bit lanes
+  uint64_t color;  // one pixel of the packed color, 16-bit lanes
+};
+static_assert(__builtin_offsetof(IA64R8Row, step) == 16 &&
+                  __builtin_offsetof(IA64R8Row, width2) == 28 &&
+                  __builtin_offsetof(IA64R8Row, fracy) == 32 &&
+                  __builtin_offsetof(IA64R8Row, color) == 40,
+              "IA64R8Row layout is hard-coded in genr8row_s.py");
+#  define IA64_R8_KERNEL(variant)                                   \
+    extern "C" void swgl_r8_linear_row_##variant##_ia64(            \
+        uint32_t* dst, const uint8_t* row0, const uint8_t* row1, long n, \
+        IA64R8Row* params)
+IA64_R8_KERNEL(mask);
+IA64_R8_KERNEL(bcast);
+IA64_R8_KERNEL(color);
+IA64_R8_KERNEL(over);
+#  undef IA64_R8_KERNEL
+
+// The fused kernels take one pixel of color. NoColor is exactly a color of
+// 255: (255 * m + 255) >> 8 == m for every m in 0..255.
+static ALWAYS_INLINE bool ia64_r8_color(NoColor, uint64_t& c) {
+  c = 0x00FF00FF00FF00FFULL;
+  return true;
+}
+static ALWAYS_INLINE bool ia64_r8_color(WideRGBA8 color, uint64_t& c) {
+  struct Quads {
+    uint64_t q[4];
+  } p = bit_cast<Quads>(color);
+  c = p.q[0];
+  return p.q[1] == c && p.q[2] == c && p.q[3] == c;
+}
+template <typename C>
+static ALWAYS_INLINE bool ia64_r8_color(C, uint64_t&) {
+  return false;
+}
+#endif
