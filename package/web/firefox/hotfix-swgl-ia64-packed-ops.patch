--- firefox-153.0.1/gfx/wr/swgl/src/vector_type.h.vanilla
+++ firefox-153.0.1/gfx/wr/swgl/src/vector_type.h
@@ -534,6 +534,38 @@
 };
 #endif
 
+#ifdef __ia64__
+// GCC's ia64 backend has no patterns for the saturating packed ops, so the
+// portable fallbacks below expand to 24 instructions for a saturating add and
+// 51 for a saturating pack. A 16-byte vector is a TImode register pair here,
+// hence the per-half wrapping at the call sites.
+typedef int16_t ia64_i16x4 __attribute__((vector_size(8)));
+typedef uint16_t ia64_u16x4 __attribute__((vector_size(8)));
+typedef uint8_t ia64_u8x8 __attribute__((vector_size(8)));
+
+// == _mm_adds_epi16
+SI ia64_i16x4 ia64_padd2_sss(ia64_i16x4 a, ia64_i16x4 b) {
+  ia64_i16x4 r;
+  __asm__("padd2.sss %0 = %1, %2" : "=r"(r) : "r"(a), "r"(b));
+  return r;
+}
+
+// == _mm_adds_epu16
+SI ia64_u16x4 ia64_padd2_uuu(ia64_u16x4 a, ia64_u16x4 b) {
+  ia64_u16x4 r;
+  __asm__("padd2.uuu %0 = %1, %2" : "=r"(r) : "r"(a), "r"(b));
+  return r;
+}
+
+// Lanes are read as signed and saturated into unsigned bytes; |a| supplies the
+// low four bytes and |b| the high four, matching _mm_packus_epi16(lo, hi).
+SI ia64_u8x8 ia64_pack2_uss(ia64_u16x4 a, ia64_u16x4 b) {
+  ia64_u8x8 r;
+  __asm__("pack2.uss %0 = %1, %2" : "=r"(r) : "r"(a), "r"(b));
+  return r;
+}
+#endif
+
 template <typename T, typename P>
 SI T unaligned_load(const P* p) {
   return Unaligned<T>::load(p);
