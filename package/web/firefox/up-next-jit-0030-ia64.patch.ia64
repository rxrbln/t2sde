+void MacroAssembler::atomicEffectOpJS(Scalar::Type arrayType, Synchronization sync, AtomicOp op, Register value, const Address& mem, Register temp) {
+  MOZ_CRASH("ia64: atomicEffectOpJS is not supported");
+}
+
+void MacroAssembler::atomicEffectOpJS(Scalar::Type arrayType, Synchronization sync, AtomicOp op, Register value, const BaseIndex& mem, Register temp) {
+  MOZ_CRASH("ia64: atomicEffectOpJS is not supported");
+}
