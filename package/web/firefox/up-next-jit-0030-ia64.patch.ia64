+
+MacroAssembler& MacroAssemblerIa64::asMasm() {
+  return *static_cast<MacroAssembler*>(this);
+}
+
+const MacroAssembler& MacroAssemblerIa64::asMasm() const {
+  return *static_cast<const MacroAssembler*>(this);
+}
+
+// ===========================================================================
+// Relocations. ReadMovlImm()/WriteMovlImm() live in MacroAssembler-ia64.h.
+
+void MacroAssemblerIa64::writeDataRelocation(ImmGCPtr ptr) {
+  if (!ptr.value) {
+    return;
+  }
+  if (gc::IsInsideNursery(ptr.value)) {
+    embedsNurseryPointers_ = true;
+  }
+  dataRelocations_.writeUnsigned(m_buffer.nextOffset().getOffset());
+}
+
+void MacroAssemblerIa64::writeJumpRelocation() {
+  jumpRelocations_.writeUnsigned(m_buffer.nextOffset().getOffset());
+}
+
+void MacroAssemblerIa64::TraceDataRelocations(JSTracer* trc, JitCode* code,
+                                              CompactBufferReader& reader) {
+  mozilla::Maybe<AutoWritableJitCode> awjc;
+  while (reader.more()) {
+    size_t offset = reader.readUnsigned();
+    uint8_t* bundle = code->raw() + offset;
+    uint64_t word = ReadMovlImm(bundle);
+    if (!word) {
+      continue;
+    }
+    gc::Cell* cell = reinterpret_cast<gc::Cell*>(uintptr_t(word));
+    gc::Cell* prior = cell;
+    TraceManuallyBarrieredGenericPointerEdge(trc, &cell, "jit-masm-ptr");
+    if (cell != prior) {
+      if (awjc.isNothing()) {
+        awjc.emplace(code);
+      }
+      WriteMovlImm(bundle, uint64_t(uintptr_t(cell)));
+    }
+  }
+}
+
+void MacroAssemblerIa64::TraceJumpRelocations(JSTracer* trc, JitCode* code,
+                                              CompactBufferReader& reader) {
+  mozilla::Maybe<AutoWritableJitCode> awjc;
+  while (reader.more()) {
+    size_t offset = reader.readUnsigned();
+    uint8_t* bundle = code->raw() + offset;
+    uint64_t word = ReadMovlImm(bundle);
+    if (!word) {
+      continue;
+    }
+    JitCode* child =
+        JitCode::FromExecutable(reinterpret_cast<uint8_t*>(uintptr_t(word)));
+    TraceManuallyBarrieredEdge(trc, &child, "jitcode");
+    if (uintptr_t(child->raw()) != uintptr_t(word)) {
+      if (awjc.isNothing()) {
+        awjc.emplace(code);
+      }
+      WriteMovlImm(bundle, uint64_t(uintptr_t(child->raw())));
+    }
+  }
+}
+
+// ===========================================================================
+// Code labels and toggled instructions.
+
+void MacroAssemblerIa64::mov(CodeLabel* label, Register dest) {
+  BufferOffset bo = emitMovl(dest.encoding(), 0);
+  label->patchAt()->bind(bo.getOffset());
+  if (!movlCodeLabels_.append(uint32_t(bo.getOffset()))) {
+    setOOM();
+  }
+}
+
+// ===========================================================================
+// Exception handling.
+
+bool MacroAssemblerIa64::buildOOLFakeExitFrame(void* fakeReturnAddr) {
+  asMasm().Push(FrameDescriptor(FrameType::IonJS));
+  asMasm().Push(ImmPtr(fakeReturnAddr));
+  asMasm().Push(FramePointer);
+  return true;
+}
+
+void MacroAssemblerIa64::handleFailureWithHandlerTail(
+    Label* profilerExitTail, Label* bailoutTail,
+    uint32_t* returnValueCheckOffset) {
+  const Register kind = CallTempReg0;
+  const Register target = CallTempReg1;
+  const Register rfe = CallTempReg2;
+
+  // Reserve space for exception information and hand it to the C++ handler.
+  asMasm().subFromStackPtr(Imm32(sizeof(ResumeFromException)));
+  movePtr(StackPointer, rfe);
+
+  using Fn = void (*)(ResumeFromException* rfe);
+  asMasm().setupUnalignedABICall(CallTempReg3);
+  asMasm().passABIArg(rfe);
+  asMasm().callWithABI<Fn, HandleException>(
+      ABIType::General, CheckUnsafeCallWithABI::DontCheckHasExitFrame);
+
+  *returnValueCheckOffset = asMasm().currentOffset();
+
+  Label entryFrame, catch_, finally, returnBaseline, returnIon, bailout;
+  Label wasmInterpEntry, wasmCatch;
+
+  load32(Address(StackPointer, ResumeFromException::offsetOfKind()), kind);
+  asMasm().branch32(Assembler::Equal, kind,
+                    Imm32(ExceptionResumeKind::EntryFrame), &entryFrame);
+  asMasm().branch32(Assembler::Equal, kind, Imm32(ExceptionResumeKind::Catch),
+                    &catch_);
+  asMasm().branch32(Assembler::Equal, kind, Imm32(ExceptionResumeKind::Finally),
+                    &finally);
+  asMasm().branch32(Assembler::Equal, kind,
+                    Imm32(ExceptionResumeKind::ForcedReturnBaseline),
+                    &returnBaseline);
+  asMasm().branch32(Assembler::Equal, kind,
+                    Imm32(ExceptionResumeKind::ForcedReturnIon), &returnIon);
+  asMasm().branch32(Assembler::Equal, kind, Imm32(ExceptionResumeKind::Bailout),
+                    &bailout);
+  asMasm().branch32(Assembler::Equal, kind,
+                    Imm32(ExceptionResumeKind::WasmInterpEntry),
+                    &wasmInterpEntry);
+  asMasm().branch32(Assembler::Equal, kind,
+                    Imm32(ExceptionResumeKind::WasmCatch), &wasmCatch);
+  breakpoint();
+
+  // No handler: return the error value from the entry frame.
+  bind(&entryFrame);
+  asMasm().moveValue(MagicValue(JS_ION_ERROR), JSReturnOperand);
+  loadPtr(Address(StackPointer, ResumeFromException::offsetOfFramePointer()),
+          FramePointer);
+  loadPtr(Address(StackPointer, ResumeFromException::offsetOfStackPointer()),
+          StackPointer);
+  ret();
+
+  // A catch handler is always in a baseline frame.
+  bind(&catch_);
+  loadPtr(Address(StackPointer, ResumeFromException::offsetOfTarget()), target);
+  loadPtr(Address(StackPointer, ResumeFromException::offsetOfFramePointer()),
+          FramePointer);
+  loadPtr(Address(StackPointer, ResumeFromException::offsetOfStackPointer()),
+          StackPointer);
+  jump(target);
+
+  // A finally block wants the exception, the exception stack and true.
+  bind(&finally);
+  {
+    ValueOperand exception(CallTempReg4);
+    ValueOperand exceptionStack(CallTempReg5);
+    loadValue(Address(StackPointer, ResumeFromException::offsetOfException()),
+              exception);
+    loadValue(
+        Address(StackPointer, ResumeFromException::offsetOfExceptionStack()),
+        exceptionStack);
+    loadPtr(Address(StackPointer, ResumeFromException::offsetOfTarget()),
+            target);
+    loadPtr(Address(StackPointer, ResumeFromException::offsetOfFramePointer()),
+            FramePointer);
+    loadPtr(Address(StackPointer, ResumeFromException::offsetOfStackPointer()),
+            StackPointer);
+    pushValue(exception);
+    pushValue(exceptionStack);
+    pushValue(BooleanValue(true));
+    jump(target);
+  }
+
+  Label profilingInstrumentation;
+  bind(&returnBaseline);
+  loadPtr(Address(StackPointer, ResumeFromException::offsetOfFramePointer()),
+          FramePointer);
+  loadPtr(Address(StackPointer, ResumeFromException::offsetOfStackPointer()),
+          StackPointer);
+  loadValue(Address(FramePointer, BaselineFrame::reverseOffsetOfReturnValue()),
+            JSReturnOperand);
+  jump(&profilingInstrumentation);
+
+  bind(&returnIon);
+  loadValue(Address(StackPointer, ResumeFromException::offsetOfException()),
+            JSReturnOperand);
+  loadPtr(Address(StackPointer, ResumeFromException::offsetOfFramePointer()),
+          FramePointer);
+  loadPtr(Address(StackPointer, ResumeFromException::offsetOfStackPointer()),
+          StackPointer);
+
+  bind(&profilingInstrumentation);
+  {
+    Label skipProfilingInstrumentation;
+    AbsoluteAddress addressOfEnabled(
+        asMasm().runtime()->geckoProfiler().addressOfEnabled());
+    asMasm().branch32(Assembler::Equal, addressOfEnabled, Imm32(0),
+                      &skipProfilingInstrumentation);
+    jump(profilerExitTail);
+    bind(&skipProfilingInstrumentation);
+  }
+  movePtr(FramePointer, StackPointer);
+  pop(FramePointer);
+  ret();
+
+  bind(&bailout);
+  loadPtr(Address(StackPointer, ResumeFromException::offsetOfBailoutInfo()),
+          CallTempReg1);
+  loadPtr(Address(StackPointer, ResumeFromException::offsetOfStackPointer()),
+          StackPointer);
+  move32(Imm32(1), ReturnReg);
+  jump(bailoutTail);
+
+  bind(&wasmInterpEntry);
+  bind(&wasmCatch);
+  breakpoint();
+}
+
+void MacroAssemblerIa64::profilerEnterFrame(Register framePtr,
+                                            Register scratch) {
+  asMasm().loadJSContext(scratch);
+  loadPtr(Address(scratch, offsetof(JSContext, profilingActivation_)), scratch);
+  storePtr(framePtr,
+           Address(scratch, JitActivation::offsetOfLastProfilingFrame()));
+  storePtr(ImmPtr(nullptr),
+           Address(scratch, JitActivation::offsetOfLastProfilingCallSite()));
+}
+
+void MacroAssemblerIa64::profilerExitFrame() {
+  jump(asMasm().runtime()->jitRuntime()->getProfilerExitFrameTail());
+}
+
+void MacroAssemblerIa64::processCodeLabels(uint8_t* rawCode) {
+  for (size_t i = 0; i < numCodeLabels(); i++) {
+    CodeLabel label = codeLabel(i);
+    if (!label.patchAt()->bound()) {
+      continue;
+    }
+    size_t patchOffset = label.patchAt()->offset();
+    uint8_t* target = rawCode + label.target()->offset();
+
+    bool isMovl = false;
+    for (uint32_t off : movlCodeLabels_) {
+      if (off == patchOffset) {
+        isMovl = true;
+        break;
+      }
+    }
+    if (isMovl) {
+      WriteMovlImm(rawCode + patchOffset, uint64_t(uintptr_t(target)));
+    } else {
+      memcpy(rawCode + patchOffset, &target, sizeof(target));
+    }
+  }
+}
+
+void Assembler::Bind(uint8_t* rawCode, const CodeLabel& label) {
+  if (!label.patchAt().bound()) {
+    return;
+  }
+  uint8_t* target = rawCode + label.target().offset();
+  memcpy(rawCode + label.patchAt().offset(), &target, sizeof(target));
+}
+
+CodeOffset MacroAssemblerIa64::toggledJump(Label* label) {
+  CodeOffset offset(currentOffset());
+  emitBranchToLabel(&ia64::BrCondRel, 0, label);
+  return offset;
+}
+
+// A toggled call follows the same convention as call(): the return address goes
+// on the memory stack, which is what the debug trap handler's stub frame setup
+// expects. The disabled form runs every bundle but the last, so that last
+// bundle pops the pushed address instead of calling.
+CodeOffset MacroAssemblerIa64::toggledCall(JitCode* target, bool enabled) {
+  CodeOffset offset(currentOffset());
+  CodeLabel retLabel;
+  mov(&retLabel, ScratchReg);
+  push(ScratchReg);
+  writeJumpRelocation();
+  emitMovl(ScratchReg.encoding(), uint64_t(uintptr_t(target->raw())));
+  emitI(ia64::MovToBr(6, ScratchReg.encoding()));
+  if (enabled) {
+    emitB(ia64::BrCall(0, 6));
+  } else {
+    emitM(ia64::Adds(StackPointer.encoding(), int64_t(sizeof(uintptr_t)),
+                     StackPointer.encoding()));
+  }
+  bind(&retLabel);
+  addCodeLabel(retLabel);
+  MOZ_ASSERT_IF(!oom(), currentOffset() - offset.offset() ==
+                            Assembler::kToggledCallBundles *
+                                sizeof(ia64::Bundle));
+  return offset;
+}
+
+void MacroAssemblerIa64::movePtr(ImmGCPtr imm, Register dest) {
+  writeDataRelocation(imm);
+  emitMovl(dest.encoding(), uint64_t(uintptr_t(imm.value)));
+}
+
+// ===========================================================================
+// Compares and tests. Predicates p6 (the relation) and p7 (its complement) are
+// the scratch pair; the returned value says which of the two the caller should
+// predicate on.
+
+static const uint32_t kP = 6;
+static const uint32_t kQ = 7;
+
+uint32_t MacroAssemblerIa64::emitCompare(Assembler::Condition cond,
+                                         Register lhs, Register rhs) {
+  uint32_t a = lhs.encoding();
+  uint32_t b = rhs.encoding();
+
+  // Shared JIT code uses Zero/NonZero interchangeably with Equal/NotEqual for
+  // comparisons, because on x86 they are the same condition code.
+  switch (cond) {
+    case Assembler::Equal:
+    case Assembler::Zero:
+      emitI(ia64::CmpEq(kP, kQ, a, b));
+      return kP;
+    case Assembler::NotEqual:
+    case Assembler::NonZero:
+      emitI(ia64::CmpEq(kP, kQ, a, b));
+      return kQ;
+    case Assembler::LessThan:
+      emitI(ia64::CmpLt(kP, kQ, a, b));
+      return kP;
+    case Assembler::GreaterThanOrEqual:
+      emitI(ia64::CmpLt(kP, kQ, a, b));
+      return kQ;
+    case Assembler::GreaterThan:
+      // a > b  <=>  b < a
+      emitI(ia64::CmpLt(kP, kQ, b, a));
+      return kP;
+    case Assembler::LessThanOrEqual:
+      emitI(ia64::CmpLt(kP, kQ, b, a));
+      return kQ;
+    case Assembler::Below:
+      emitI(ia64::CmpLtu(kP, kQ, a, b));
+      return kP;
+    case Assembler::AboveOrEqual:
+      emitI(ia64::CmpLtu(kP, kQ, a, b));
+      return kQ;
+    case Assembler::Above:
+      emitI(ia64::CmpLtu(kP, kQ, b, a));
+      return kP;
+    case Assembler::BelowOrEqual:
+      emitI(ia64::CmpLtu(kP, kQ, b, a));
+      return kQ;
+    default:
+      MOZ_CRASH("unsupported condition for ia64 compare");
+  }
+}
+
+uint32_t MacroAssemblerIa64::emitCompare(Assembler::Condition cond,
+                                         Register lhs, Imm32 rhs) {
+  if (rhs.value == 0) {
+    return emitCompare(cond, lhs, Register{Registers::zero});
+  }
+  emitMovl(ScratchReg.encoding(), uint64_t(int64_t(rhs.value)));
+  return emitCompare(cond, lhs, ScratchReg);
+}
+
+uint32_t MacroAssemblerIa64::emitCompare(Assembler::Condition cond,
+                                         Register lhs, ImmWord rhs) {
+  if (rhs.value == 0) {
+    return emitCompare(cond, lhs, Register{Registers::zero});
+  }
+  emitMovl(ScratchReg.encoding(), rhs.value);
+  return emitCompare(cond, lhs, ScratchReg);
+}
+
+uint32_t MacroAssemblerIa64::emitTest(Assembler::Condition cond, Register lhs,
+                                      Register rhs, unsigned width) {
+  MOZ_ASSERT(cond == Assembler::Zero || cond == Assembler::NonZero ||
+             cond == Assembler::Equal || cond == Assembler::NotEqual ||
+             cond == Assembler::Signed || cond == Assembler::NotSigned);
+  emitM(ia64::And(ScratchReg.encoding(), lhs.encoding(), rhs.encoding()));
+  if (cond != Assembler::Signed && cond != Assembler::NotSigned) {
+    emitI(ia64::CmpEq(kP, kQ, ScratchReg.encoding(), Registers::zero));
+    return (cond == Assembler::Zero || cond == Assembler::Equal) ? kP : kQ;
+  }
+  if (width == 32) {
+    ma_sxt(ScratchReg, ScratchReg, 4);
+  }
+  emitI(ia64::CmpLt(kP, kQ, ScratchReg.encoding(), Registers::zero));
+  return cond == Assembler::Signed ? kP : kQ;
+}
+
+uint32_t MacroAssemblerIa64::emitTest(Assembler::Condition cond, Register lhs,
+                                      Imm32 rhs, unsigned width) {
+  emitMovl(ScratchReg.encoding(), uint64_t(uint32_t(rhs.value)));
+  emitM(
+      ia64::And(ScratchReg.encoding(), lhs.encoding(), ScratchReg.encoding()));
+  if (cond != Assembler::Signed && cond != Assembler::NotSigned) {
+    emitI(ia64::CmpEq(kP, kQ, ScratchReg.encoding(), Registers::zero));
+    return (cond == Assembler::Zero || cond == Assembler::Equal) ? kP : kQ;
+  }
+  if (width == 32) {
+    ma_sxt(ScratchReg, ScratchReg, 4);
+  }
+  emitI(ia64::CmpLt(kP, kQ, ScratchReg.encoding(), Registers::zero));
+  return cond == Assembler::Signed ? kP : kQ;
+}
+
+// ===========================================================================
+// Floating point.
+//
+// [SMDOC] IA-64 floating point in the JIT
+//
+// An IA-64 floating-point register holds an 82-bit value and the precision is
+// a property of the instruction, not of the register: fma.d rounds to IEEE
+// double, fma.s to IEEE single, and the unsuffixed form keeps the full
+// register format. The invariant this backend maintains is that every
+// allocatable register always holds a value that is exactly representable as
+// an IEEE double, so that spilling through stfd and comparing with fcmp are
+// both exact. Only the four non-allocatable scratch registers f2-f5 ever hold
+// an extended intermediate, and only inside the divide and square-root
+// sequences below.
+//
+// There is no divide and no square root instruction. frcpa and frsqrta produce
+// an approximation good to about 8 bits and clear their predicate output when
+// the operands are such that the refinement below would not work, in which
+// case they have already placed the IEEE-correct result in f1. Everything else
+// is Newton-Raphson in the .s1 status field, which is configured for the full
+// exponent range and register precision, with one final .s0 fma that rounds
+// once to the destination format.
+
+FaultingCodeOffset MacroAssemblerIa64::ma_loadFp(const Address& addr,
+                                                 FloatRegister dest) {
+  computeAddress(addr, ScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  if (dest.isDouble()) {
+    emitM(ia64::Ldfd(dest.encoding(), ScratchReg.encoding()));
+  } else {
+    emitM(ia64::Ldfs(dest.encoding(), ScratchReg.encoding()));
+  }
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::ma_loadFp(const BaseIndex& addr,
+                                                 FloatRegister dest) {
+  computeAddress(addr, SecondScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  if (dest.isDouble()) {
+    emitM(ia64::Ldfd(dest.encoding(), SecondScratchReg.encoding()));
+  } else {
+    emitM(ia64::Ldfs(dest.encoding(), SecondScratchReg.encoding()));
+  }
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::ma_storeFp(FloatRegister src,
+                                                  const Address& addr) {
+  computeAddress(addr, ScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  if (src.isDouble()) {
+    emitM(ia64::Stfd(ScratchReg.encoding(), src.encoding()));
+  } else {
+    emitM(ia64::Stfs(ScratchReg.encoding(), src.encoding()));
+  }
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::ma_storeFp(FloatRegister src,
+                                                  const BaseIndex& addr) {
+  computeAddress(addr, SecondScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  if (src.isDouble()) {
+    emitM(ia64::Stfd(SecondScratchReg.encoding(), src.encoding()));
+  } else {
+    emitM(ia64::Stfs(SecondScratchReg.encoding(), src.encoding()));
+  }
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::loadDouble(const Address& addr,
+                                                  FloatRegister dest) {
+  return ma_loadFp(addr, dest.asDouble());
+}
+FaultingCodeOffset MacroAssemblerIa64::loadDouble(const BaseIndex& addr,
+                                                  FloatRegister dest) {
+  return ma_loadFp(addr, dest.asDouble());
+}
+FaultingCodeOffset MacroAssemblerIa64::loadFloat32(const Address& addr,
+                                                   FloatRegister dest) {
+  return ma_loadFp(addr, dest.asSingle());
+}
+FaultingCodeOffset MacroAssemblerIa64::loadFloat32(const BaseIndex& addr,
+                                                   FloatRegister dest) {
+  return ma_loadFp(addr, dest.asSingle());
+}
+
+void MacroAssemblerIa64::ma_fpBits(FloatRegister src, Register dest) {
+  if (src.isDouble()) {
+    emitM(ia64::GetfD(dest.encoding(), src.encoding()));
+  } else {
+    emitM(ia64::GetfS(dest.encoding(), src.encoding()));
+    ma_sxt(dest, dest, 4);
+  }
+}
+
+// fcmp writes a predicate and its complement, so most of the fourteen
+// conditions are one instruction; the two that mix an equality test with an
+// orderedness test need the answer seeded first and then overwritten by a
+// predicated compare.
+uint32_t MacroAssemblerIa64::emitFpCompare(Assembler::DoubleCondition cond,
+                                           FloatRegister lhs,
+                                           FloatRegister rhs) {
+  uint32_t a = lhs.encoding();
+  uint32_t b = rhs.encoding();
+
+  switch (cond) {
+    case Assembler::DoubleEqual:
+      emitF(ia64::FcmpEq(kFpP, kFpQ, a, b));
+      return kFpP;
+    case Assembler::DoubleNotEqualOrUnordered:
+      emitF(ia64::FcmpEq(kFpP, kFpQ, a, b));
+      return kFpQ;
+    case Assembler::DoubleLessThan:
+      emitF(ia64::FcmpLt(kFpP, kFpQ, a, b));
+      return kFpP;
+    case Assembler::DoubleGreaterThanOrEqualOrUnordered:
+      emitF(ia64::FcmpLt(kFpP, kFpQ, a, b));
+      return kFpQ;
+    case Assembler::DoubleLessThanOrEqual:
+      emitF(ia64::FcmpLe(kFpP, kFpQ, a, b));
+      return kFpP;
+    case Assembler::DoubleGreaterThanOrUnordered:
+      emitF(ia64::FcmpLe(kFpP, kFpQ, a, b));
+      return kFpQ;
+    case Assembler::DoubleGreaterThan:
+      emitF(ia64::FcmpLt(kFpP, kFpQ, b, a));
+      return kFpP;
+    case Assembler::DoubleLessThanOrEqualOrUnordered:
+      emitF(ia64::FcmpLt(kFpP, kFpQ, b, a));
+      return kFpQ;
+    case Assembler::DoubleGreaterThanOrEqual:
+      emitF(ia64::FcmpLe(kFpP, kFpQ, b, a));
+      return kFpP;
+    case Assembler::DoubleLessThanOrUnordered:
+      emitF(ia64::FcmpLe(kFpP, kFpQ, b, a));
+      return kFpQ;
+    case Assembler::DoubleUnordered:
+      emitF(ia64::FcmpUnord(kFpP, kFpQ, a, b));
+      return kFpP;
+    case Assembler::DoubleOrdered:
+      emitF(ia64::FcmpUnord(kFpP, kFpQ, a, b));
+      return kFpQ;
+    case Assembler::DoubleNotEqual:
+      // False unless the compare below runs and finds the two different.
+      emitI(ia64::CmpNe(kFpR, kFpS, Registers::zero, Registers::zero));
+      emitF(ia64::FcmpUnord(kFpP, kFpQ, a, b));
+      emitF(ia64::FcmpEq(kFpS, kFpR, a, b, ia64::sf0, kFpQ));
+      return kFpR;
+    case Assembler::DoubleEqualOrUnordered:
+      emitI(ia64::CmpEq(kFpR, kFpS, Registers::zero, Registers::zero));
+      emitF(ia64::FcmpUnord(kFpP, kFpQ, a, b));
+      emitF(ia64::FcmpEq(kFpR, kFpS, a, b, ia64::sf0, kFpQ));
+      return kFpR;
+  }
+  MOZ_CRASH("unexpected ia64 double condition");
+}
+
+// The refinement proper: y converges on 1/b and q on the quotient, and the
+// last fma is the only rounding step, which is what makes the result correctly
+// rounded. All intermediates use sf1, whose exponent range and precision are
+// the widest available.
+void MacroAssemblerIa64::emitDivRefine(uint32_t a, uint32_t b, uint32_t dest,
+                                       bool isDouble, bool round) {
+  const uint32_t y = kFpT0;
+  const uint32_t q = kFpT1;
+  const uint32_t e = kFpT2;
+  const uint32_t e2 = kFpT3;
+
+  emitF(ia64::Fnma(e, b, y, ia64::fpOne, ia64::sf1));
+  emitF(ia64::Fma(q, a, y, ia64::fpZero, ia64::sf1));
+  emitF(ia64::Fma(e2, e, e, ia64::fpZero, ia64::sf1));
+  emitF(ia64::Fma(y, e, y, y, ia64::sf1));
+  emitF(ia64::Fma(q, e, q, q, ia64::sf1));
+  emitF(ia64::Fma(y, e2, y, y, ia64::sf1));
+  emitF(ia64::Fma(q, e2, q, q, ia64::sf1));
+  emitF(ia64::Fnma(e, b, y, ia64::fpOne, ia64::sf1));
+  emitF(ia64::Fma(y, e, y, y, ia64::sf1));
+  emitF(ia64::Fnma(e, b, q, a, ia64::sf1));
+  if (!round) {
+    emitF(ia64::Fma(dest, e, y, q, ia64::sf1));
+  } else if (isDouble) {
+    emitF(ia64::FmaD(dest, e, y, q));
+  } else {
+    emitF(ia64::FmaS(dest, e, y, q));
+  }
+}
+
+// g converges on sqrt(a) and h on 1/(2*sqrt(a)); the final fma corrects g by
+// the residual and rounds once.
+void MacroAssemblerIa64::emitSqrtRefine(uint32_t a, uint32_t dest,
+                                        bool isDouble, bool round) {
+  const uint32_t h = kFpT0;
+  const uint32_t g = kFpT1;
+  const uint32_t e = kFpT2;
+  const uint32_t half = kFpT3;
+
+  emitMovl(ScratchReg.encoding(), 0x3fe0000000000000ULL);
+  emitM(ia64::SetfD(half, ScratchReg.encoding()));
+  emitF(ia64::Fma(g, a, h, ia64::fpZero, ia64::sf1));
+  emitF(ia64::Fma(h, half, h, ia64::fpZero, ia64::sf1));
+  for (int i = 0; i < 3; i++) {
+    emitF(ia64::Fnma(e, g, h, half, ia64::sf1));
+    emitF(ia64::Fma(g, g, e, g, ia64::sf1));
+    emitF(ia64::Fma(h, h, e, h, ia64::sf1));
+  }
+  emitF(ia64::Fnma(e, g, g, a, ia64::sf1));
+  if (!round) {
+    emitF(ia64::Fma(dest, e, h, g, ia64::sf1));
+  } else if (isDouble) {
+    emitF(ia64::FmaD(dest, e, h, g));
+  } else {
+    emitF(ia64::FmaS(dest, e, h, g));
+  }
+}
+
+// The exponent bias of the 82-bit register format; setf.exp takes a biased
+// exponent in bits 16:0 and a sign in bit 17, and sets the significand to 1.0.
+static const int64_t kFpExpBias = 0xffff;
+
+void MacroAssemblerIa64::ma_fdiv(FloatRegister lhs, FloatRegister rhs,
+                                 FloatRegister dest, bool isDouble) {
+  const uint32_t a = lhs.encoding();
+  const uint32_t b = rhs.encoding();
+  const uint32_t y = kFpT0;
+  const uint32_t scale = kFpT2;
+  const uint32_t aS = kFpT4;
+  const uint32_t bS = kFpT5;
+  const uint32_t r14 = Registers::r14;
+  const uint32_t r15 = Registers::r15;
+  const uint32_t sc = ScratchReg.encoding();
+  const uint32_t sc2 = SecondScratchReg.encoding();
+
+  Label fast, special, done;
+
+  // frcpa clears its predicate whenever the refinement below would not work.
+  // For zero, infinity and NaN operands it has already produced the
+  // IEEE-correct quotient; for a denormal operand or a quotient outside the
+  // destination's exponent range it has produced only the seed, and those have
+  // to be redone with both operands rescaled into [1, 2).
+  emitF(ia64::Frcpa(y, kFpP, a, b, ia64::sf1));
+  emitBranchToLabel(&ia64::BrCondRel, kFpP, &fast);
+
+  emitF(ia64::Fclass(
+      kFpR, kFpS, a,
+      ia64::FcNan | ia64::FcInf | ia64::FcZero | ia64::FcAnySign));
+  emitBranchToLabel(&ia64::BrCondRel, kFpR, &special);
+  emitF(ia64::Fclass(
+      kFpR, kFpS, b,
+      ia64::FcNan | ia64::FcInf | ia64::FcZero | ia64::FcAnySign));
+  emitBranchToLabel(&ia64::BrCondRel, kFpR, &special);
+
+  // Two more temporaries than the assembler owns are wanted for the exponent
+  // arithmetic; this path is cold, so borrow them from the stack.
+  push(Register{Registers::r14});
+  push(Register{Registers::r15});
+  emitMovl(r14, uint64_t(kFpExpBias));
+
+  emitM(ia64::GetfExp(sc, a));
+  emitI(ia64::ExtrU(r15, sc, 17, 1));
+  emitI(ia64::ShlImm(r15, r15, 17));
+  emitM(ia64::Or(r15, r15, r14));
+  emitM(ia64::SetfExp(aS, r15));
+  emitF(ia64::FmergeSe(aS, aS, a));
+  emitI(ia64::ExtrU(sc, sc, 0, 17));
+
+  emitM(ia64::GetfExp(sc2, b));
+  emitI(ia64::ExtrU(r15, sc2, 17, 1));
+  emitI(ia64::ShlImm(r15, r15, 17));
+  emitM(ia64::Or(r15, r15, r14));
+  emitM(ia64::SetfExp(bS, r15));
+  emitF(ia64::FmergeSe(bS, bS, b));
+  emitI(ia64::ExtrU(sc2, sc2, 0, 17));
+
+  // The quotient of the rescaled operands has to be multiplied by
+  // 2^(exponent(a) - exponent(b)); keep that exponent in ScratchReg, which the
+  // refinement does not touch.
+  emitM(ia64::Sub(sc, sc, sc2));
+  emitM(ia64::Add(sc, sc, r14));
+
+  pop(Register{Registers::r15});
+  pop(Register{Registers::r14});
+
+  emitF(ia64::Frcpa(y, kFpP, aS, bS, ia64::sf1));
+  emitDivRefine(aS, bS, dest.encoding(), isDouble, /* round = */ false);
+  emitM(ia64::SetfExp(scale, sc));
+  if (isDouble) {
+    emitF(ia64::FmaD(dest.encoding(), dest.encoding(), scale, ia64::fpZero));
+  } else {
+    emitF(ia64::FmaS(dest.encoding(), dest.encoding(), scale, ia64::fpZero));
+  }
+  jump(&done);
+
+  bind(&special);
+  emitF(ia64::Fmov(dest.encoding(), y));
+  jump(&done);
+
+  bind(&fast);
+  emitDivRefine(a, b, dest.encoding(), isDouble, /* round = */ true);
+  bind(&done);
+}
+
+void MacroAssemblerIa64::ma_fsqrt(FloatRegister src, FloatRegister dest,
+                                  bool isDouble) {
+  const uint32_t a = src.encoding();
+  const uint32_t h = kFpT0;
+  const uint32_t scale = kFpT2;
+  const uint32_t aS = kFpT4;
+  const uint32_t r14 = Registers::r14;
+  const uint32_t r15 = Registers::r15;
+  const uint32_t sc = ScratchReg.encoding();
+  const uint32_t sc2 = SecondScratchReg.encoding();
+
+  Label fast, special, copySrc, done;
+
+  emitF(ia64::Frsqrta(h, kFpP, a, ia64::sf1));
+  emitBranchToLabel(&ia64::BrCondRel, kFpP, &fast);
+
+  // Zero, infinity, NaN and every negative value take the special path below;
+  // only a denormal or out-of-range positive value needs rescaling.
+  emitF(ia64::Fclass(
+      kFpR, kFpS, a,
+      ia64::FcNan | ia64::FcInf | ia64::FcZero | ia64::FcAnySign));
+  emitBranchToLabel(&ia64::BrCondRel, kFpR, &special);
+  emitF(ia64::Fclass(kFpR, kFpS, a,
+                     ia64::FcNorm | ia64::FcUnorm | ia64::FcNeg));
+  emitBranchToLabel(&ia64::BrCondRel, kFpR, &special);
+
+  push(Register{Registers::r14});
+  push(Register{Registers::r15});
+  emitMovl(r14, uint64_t(kFpExpBias));
+
+  // Rescale by an even power of two so that the square root of the scale is
+  // exact: aS lands in [1, 4) and the result is multiplied by 2^((e - p) / 2).
+  emitM(ia64::GetfExp(sc, a));
+  emitI(ia64::ExtrU(sc, sc, 0, 17));
+  emitM(ia64::Sub(r15, sc, r14));
+  emitI(ia64::ExtrU(sc2, r15, 0, 1));
+  emitM(ia64::Sub(r15, r15, sc2));
+  emitI(ia64::ShrImm(r15, r15, 1));
+  emitM(ia64::Add(sc2, sc2, r14));
+  emitM(ia64::SetfExp(aS, sc2));
+  emitF(ia64::FmergeSe(aS, aS, a));
+  emitM(ia64::Add(sc2, r15, r14));
+
+  pop(Register{Registers::r15});
+  pop(Register{Registers::r14});
+
+  emitF(ia64::Frsqrta(h, kFpP, aS, ia64::sf1));
+  emitSqrtRefine(aS, dest.encoding(), isDouble, /* round = */ false);
+  emitM(ia64::SetfExp(scale, sc2));
+  if (isDouble) {
+    emitF(ia64::FmaD(dest.encoding(), dest.encoding(), scale, ia64::fpZero));
+  } else {
+    emitF(ia64::FmaS(dest.encoding(), dest.encoding(), scale, ia64::fpZero));
+  }
+  jump(&done);
+
+  bind(&special);
+  // frsqrta computes 1/sqrt, so for +/-0 it answers +/-infinity and for
+  // +infinity it answers +0, where sqrt has to answer the argument itself.
+  // Its NaN answers, which cover negative arguments too, are already right.
+  emitF(ia64::Fclass(kFpR, kFpS, a, ia64::FcZero | ia64::FcAnySign));
+  emitBranchToLabel(&ia64::BrCondRel, kFpR, &copySrc);
+  emitF(ia64::Fclass(kFpR, kFpS, a, ia64::FcInf | ia64::FcPos));
+  emitBranchToLabel(&ia64::BrCondRel, kFpR, &copySrc);
+  emitF(ia64::Fmov(dest.encoding(), h));
+  jump(&done);
+
+  bind(&copySrc);
+  emitF(ia64::Fmov(dest.encoding(), a));
+  jump(&done);
+
+  bind(&fast);
+  emitSqrtRefine(a, dest.encoding(), isDouble, /* round = */ true);
+  bind(&done);
+}
+
+void MacroAssemblerIa64::ma_minmax(FloatRegister other, FloatRegister srcDest,
+                                   bool isMax, bool handleNaN) {
+  Label done, takeOther, nan;
+  bool isDouble = srcDest.isDouble();
+
+  uint32_t p = emitFpCompare(Assembler::DoubleUnordered, srcDest, other);
+  emitBranchToLabel(&ia64::BrCondRel, p, &nan);
+
+  p = emitFpCompare(
+      isMax ? Assembler::DoubleGreaterThan : Assembler::DoubleLessThan, srcDest,
+      other);
+  emitBranchToLabel(&ia64::BrCondRel, p, &done);
+
+  p = emitFpCompare(
+      isMax ? Assembler::DoubleLessThan : Assembler::DoubleGreaterThan, srcDest,
+      other);
+  emitBranchToLabel(&ia64::BrCondRel, p, &takeOther);
+
+  // The two compare equal, which for anything but the two zeroes means the
+  // bit patterns agree as well. min(-0, +0) must be -0 and max(-0, +0) must be
+  // +0, which or-ing respectively and-ing the sign bits produces.
+  ma_fpBits(srcDest, ScratchReg);
+  ma_fpBits(other, SecondScratchReg);
+  if (isMax) {
+    emitM(ia64::And(ScratchReg.encoding(), ScratchReg.encoding(),
+                    SecondScratchReg.encoding()));
+  } else {
+    emitM(ia64::Or(ScratchReg.encoding(), ScratchReg.encoding(),
+                   SecondScratchReg.encoding()));
+  }
+  if (isDouble) {
+    emitM(ia64::SetfD(srcDest.encoding(), ScratchReg.encoding()));
+  } else {
+    emitM(ia64::SetfS(srcDest.encoding(), ScratchReg.encoding()));
+  }
+  jump(&done);
+
+  bind(&takeOther);
+  emitF(ia64::Fmov(srcDest.encoding(), other.encoding()));
+  jump(&done);
+
+  bind(&nan);
+  if (handleNaN) {
+    // Adding the two propagates the NaN; the result only has to be some NaN.
+    if (isDouble) {
+      emitF(ia64::FaddD(srcDest.encoding(), srcDest.encoding(),
+                        other.encoding()));
+    } else {
+      emitF(ia64::FmaS(srcDest.encoding(), srcDest.encoding(), ia64::fpOne,
+                       other.encoding()));
+    }
+  }
+  bind(&done);
+}
+
+void MacroAssemblerIa64::ma_intToFp(Register src, FloatRegister dest,
+                                    unsigned width, bool isUnsigned,
+                                    bool isDouble) {
+  MOZ_ASSERT(width == 32 || width == 64);
+  Register in = src;
+  if (width == 32) {
+    if (isUnsigned) {
+      ma_zxt(ScratchReg, src, 4);
+    } else {
+      ma_sxt(ScratchReg, src, 4);
+    }
+    in = ScratchReg;
+  }
+  emitM(ia64::SetfSig(dest.encoding(), in.encoding()));
+  // setf.sig leaves the register in integer format, whose value is the
+  // significand read as unsigned; fcvt.xf reinterprets it as signed.
+  if (!(width == 64 && isUnsigned)) {
+    emitF(ia64::FcvtXf(dest.encoding(), dest.encoding()));
+  }
+  if (isDouble) {
+    emitF(ia64::FnormD(dest.encoding(), dest.encoding()));
+  } else {
+    emitF(ia64::FmaS(dest.encoding(), dest.encoding(), ia64::fpOne,
+                     ia64::fpZero));
+  }
+}
+
+void MacroAssemblerIa64::ma_fpToInt(FloatRegister src, Register dest,
+                                    unsigned width, bool exact,
+                                    bool negativeZeroCheck, Label* fail) {
+  MOZ_ASSERT(width == 32 || width == 64);
+  MOZ_ASSERT_IF(exact || negativeZeroCheck || width == 32, fail);
+
+  emitF(ia64::FcvtFxTrunc(kFpT0, src.encoding()));
+  emitM(ia64::GetfSig(dest.encoding(), kFpT0));
+
+  if (width == 32) {
+    // NaN and out-of-range inputs land on the integer indefinite value, which
+    // does not survive a round trip through the low 32 bits either.
+    ma_sxt(ScratchReg, dest, 4);
+    emitI(ia64::CmpEq(kP, kQ, ScratchReg.encoding(), dest.encoding()));
+    emitBranchToLabel(&ia64::BrCondRel, kQ, fail);
+  }
+
+  if (exact) {
+    emitM(ia64::SetfSig(kFpT1, dest.encoding()));
+    emitF(ia64::FcvtXf(kFpT1, kFpT1));
+    emitF(ia64::FcmpEq(kFpP, kFpQ, kFpT1, src.encoding()));
+    emitBranchToLabel(&ia64::BrCondRel, kFpQ, fail);
+  }
+
+  if (negativeZeroCheck) {
+    Label notZero;
+    emitI(ia64::CmpEq(kP, kQ, dest.encoding(), Registers::zero));
+    emitBranchToLabel(&ia64::BrCondRel, kQ, &notZero);
+    ma_fpBits(src, ScratchReg);
+    emitI(ia64::CmpLt(kP, kQ, ScratchReg.encoding(), Registers::zero));
+    emitBranchToLabel(&ia64::BrCondRel, kP, fail);
+    bind(&notZero);
+  }
+}
+
+void MacroAssemblerIa64::ma_fpRound(FloatRegister src, Register dest,
+                                    FpRound mode, Label* fail) {
+  emitF(ia64::FcvtFxTrunc(kFpT0, src.encoding()));
+  emitM(ia64::GetfSig(dest.encoding(), kFpT0));
+
+  if (mode != RoundTrunc) {
+    // fcvt.fx.trunc rounds toward zero; floor and ceil differ from it by one
+    // whenever the input was not already integral and had the wrong sign.
+    emitM(ia64::SetfSig(kFpT1, dest.encoding()));
+    emitF(ia64::FcvtXf(kFpT1, kFpT1));
+    if (mode == RoundFloor) {
+      emitF(ia64::FcmpLt(kFpP, kFpQ, src.encoding(), kFpT1));
+      emitM(ia64::Adds(dest.encoding(), -1, dest.encoding(), kFpP));
+    } else {
+      emitF(ia64::FcmpLt(kFpP, kFpQ, kFpT1, src.encoding()));
+      emitM(ia64::Adds(dest.encoding(), 1, dest.encoding(), kFpP));
+    }
+  }
+
+  ma_sxt(ScratchReg, dest, 4);
+  emitI(ia64::CmpEq(kP, kQ, ScratchReg.encoding(), dest.encoding()));
+  emitBranchToLabel(&ia64::BrCondRel, kQ, fail);
+
+  // A zero result has to be checked against -0 and, for ceil and trunc, the
+  // whole of the interval that rounds to it.
+  Label notZero;
+  emitI(ia64::CmpEq(kP, kQ, dest.encoding(), Registers::zero));
+  emitBranchToLabel(&ia64::BrCondRel, kQ, &notZero);
+  ma_fpBits(src, ScratchReg);
+  if (mode == RoundFloor) {
+    // Only a negative input or a NaN can reach here with a zero result.
+    emitI(ia64::CmpLt(kP, kQ, ScratchReg.encoding(), Registers::zero));
+    emitBranchToLabel(&ia64::BrCondRel, kP, fail);
+  } else {
+    // Anything but +0.0 rounds to -0 or is a NaN.
+    emitI(ia64::CmpEq(kP, kQ, ScratchReg.encoding(), Registers::zero));
+    emitBranchToLabel(&ia64::BrCondRel, kQ, fail);
+  }
+  bind(&notZero);
+}
+
+void MacroAssemblerIa64::unboxValue(const ValueOperand& src, AnyRegister dest,
+                                    JSValueType type) {
+  if (!dest.isFloat()) {
+    unboxNonDouble(src, dest.gpr(), type);
+    return;
+  }
+  Label notInt32, done;
+  asMasm().branchTestInt32(Assembler::NotEqual, src, &notInt32);
+  unboxInt32(src, SecondScratchReg);
+  convertInt32ToDouble(SecondScratchReg, dest.fpu());
+  jump(&done);
+  bind(&notInt32);
+  unboxDouble(src, dest.fpu());
+  bind(&done);
+}
+
+template <typename T>
+void MacroAssemblerIa64::loadUnboxedValueImpl(const T& src, MIRType type,
+                                              AnyRegister dest) {
+  if (!dest.isFloat()) {
+    unboxNonDouble(src, dest.gpr(), ValueTypeFromMIRType(type));
+    return;
+  }
+  Label notInt32, done;
+  asMasm().branchTestInt32(Assembler::NotEqual, src, &notInt32);
+  load32(src, SecondScratchReg);
+  convertInt32ToDouble(SecondScratchReg, dest.fpu());
+  jump(&done);
+  bind(&notInt32);
+  ma_loadFp(src, dest.fpu().asDouble());
+  bind(&done);
+}
+
+template void MacroAssemblerIa64::loadUnboxedValueImpl(const Address&, MIRType,
+                                                       AnyRegister);
+template void MacroAssemblerIa64::loadUnboxedValueImpl(const BaseIndex&,
+                                                       MIRType, AnyRegister);
+
+// ===========================================================================
+// Addressing.
+
+void MacroAssemblerIa64::computeAddress(const BaseIndex& addr, Register out) {
+  // Accumulate into |out| whenever it does not alias an input, so that callers
+  // holding a live value in the other scratch register are not disturbed.
+  Register tmp = out;
+  if (out == addr.base || out == addr.index) {
+    tmp = (out == ScratchReg) ? SecondScratchReg : ScratchReg;
+  }
+  uint32_t shift = ScaleToShift(addr.scale);
+  if (shift == 0) {
+    emitM(
+        ia64::Add(out.encoding(), addr.base.encoding(), addr.index.encoding()));
+  } else {
+    emitI(ia64::ShlImm(tmp.encoding(), addr.index.encoding(), shift));
+    emitM(ia64::Add(out.encoding(), addr.base.encoding(), tmp.encoding()));
+  }
+  if (addr.offset == 0) {
+    return;
+  }
+  if (addr.offset >= -8192 && addr.offset <= 8191) {
+    emitM(ia64::Adds(out.encoding(), addr.offset, out.encoding()));
+    return;
+  }
+  Register offTmp = (out == ScratchReg) ? SecondScratchReg : ScratchReg;
+  emitMovl(offTmp.encoding(), uint64_t(int64_t(addr.offset)));
+  emitM(ia64::Add(out.encoding(), out.encoding(), offTmp.encoding()));
+}
+
+// ===========================================================================
+// Shifts, extends and multiply.
+//
+// The shift, extend and multiply encoders are still being added to
+// AssemblerCore-ia64.h. Everything that can be synthesised from the encoders
+// that already exist is synthesised here so that the rest of the backend is
+// complete; what is left is one MOZ_CRASH per operation, each of which becomes
+// a single instruction once its encoding lands.
+
+void MacroAssemblerIa64::ma_lsl(Register dest, Register src, Imm32 shift) {
+  uint32_t n = uint32_t(shift.value) & 63;
+  emitI(ia64::ShlImm(dest.encoding(), src.encoding(), n));
+}
+
+void MacroAssemblerIa64::ma_lsr(Register dest, Register src, Imm32 shift) {
+  uint32_t n = uint32_t(shift.value) & 63;
+  emitI(ia64::ShrUImm(dest.encoding(), src.encoding(), n));
+}
+
+void MacroAssemblerIa64::ma_asr(Register dest, Register src, Imm32 shift) {
+  uint32_t n = uint32_t(shift.value) & 63;
+  emitI(ia64::ShrImm(dest.encoding(), src.encoding(), n));
+}
+
+void MacroAssemblerIa64::ma_lsl(Register dest, Register src, Register shift) {
+  emitI(ia64::Shl(dest.encoding(), src.encoding(), shift.encoding()));
+}
+
+void MacroAssemblerIa64::ma_lsr(Register dest, Register src, Register shift) {
+  emitI(ia64::ShrU(dest.encoding(), src.encoding(), shift.encoding()));
+}
+
+void MacroAssemblerIa64::ma_asr(Register dest, Register src, Register shift) {
+  emitI(ia64::Shr(dest.encoding(), src.encoding(), shift.encoding()));
+}
+
+// Rotates are a shift pair plus an or; IA-64's shrp would do it in one
+// instruction but that encoding is not available yet.
+void MacroAssemblerIa64::ma_rol(Register dest, Register src, Imm32 count,
+                                unsigned width) {
+  MOZ_ASSERT(width == 32 || width == 64);
+  uint32_t n = uint32_t(count.value) & (width - 1);
+  if (width == 32) {
+    emitI(ia64::Zxt4(ScratchReg.encoding(), src.encoding()));
+    if (n == 0) {
+      emitM(ia64::MovReg(dest.encoding(), ScratchReg.encoding()));
+      return;
+    }
+    emitI(ia64::ShlImm(dest.encoding(), ScratchReg.encoding(), n));
+    emitI(ia64::ShrUImm(ScratchReg.encoding(), ScratchReg.encoding(), 32 - n));
+    emitM(ia64::Or(dest.encoding(), dest.encoding(), ScratchReg.encoding()));
+    emitI(ia64::Zxt4(dest.encoding(), dest.encoding()));
+    return;
+  }
+  if (n == 0) {
+    emitM(ia64::MovReg(dest.encoding(), src.encoding()));
+    return;
+  }
+  emitI(ia64::ShlImm(ScratchReg.encoding(), src.encoding(), n));
+  emitI(ia64::ShrUImm(dest.encoding(), src.encoding(), 64 - n));
+  emitM(ia64::Or(dest.encoding(), dest.encoding(), ScratchReg.encoding()));
+}
+
+void MacroAssemblerIa64::ma_ror(Register dest, Register src, Imm32 count,
+                                unsigned width) {
+  MOZ_ASSERT(width == 32 || width == 64);
+  uint32_t n = uint32_t(count.value) & (width - 1);
+  ma_rol(dest, src, Imm32(int32_t((width - n) & (width - 1))), width);
+}
+
+void MacroAssemblerIa64::ma_sxt(Register dest, Register src, unsigned bytes) {
+  switch (bytes) {
+    case 1:
+      emitI(ia64::Sxt1(dest.encoding(), src.encoding()));
+      return;
+    case 2:
+      emitI(ia64::Sxt2(dest.encoding(), src.encoding()));
+      return;
+    case 4:
+      emitI(ia64::Sxt4(dest.encoding(), src.encoding()));
+      return;
+    default:
+      MOZ_CRASH("bad width for ia64 sign extend");
+  }
+}
+
+void MacroAssemblerIa64::ma_zxt(Register dest, Register src, unsigned bytes) {
+  switch (bytes) {
+    case 1:
+      emitI(ia64::Zxt1(dest.encoding(), src.encoding()));
+      return;
+    case 2:
+      emitI(ia64::Zxt2(dest.encoding(), src.encoding()));
+      return;
+    case 4:
+      emitI(ia64::Zxt4(dest.encoding(), src.encoding()));
+      return;
+    default:
+      MOZ_CRASH("bad width for ia64 zero extend");
+  }
+}
+
+// Neither multiply nor divide has an ALU form on IA-64. The hardware sequence
+// for a multiply is setf.sig/xma.l/getf.sig, but xma has no encoder yet, so
+// both operations are software loops built out of the verified encoders. Both
+// need one register more than the two assembler scratches provide; the extra
+// one is borrowed from the allocatable set and parked in b7 for the duration,
+// which is free because nothing in a macro sequence uses a branch register.
+
+static Register BorrowScratch(Register avoid1, Register avoid2 = InvalidReg) {
+  const Register candidates[] = {Register{Registers::r14},
+                                 Register{Registers::r15},
+                                 Register{Registers::r16}};
+  for (Register r : candidates) {
+    if (r != avoid1 && r != avoid2) {
+      return r;
+    }
+  }
+  MOZ_CRASH("no register left to borrow");
+}
+
+// IA-64 has no integer multiplier: the only one is the floating-point unit's
+// 82-bit fixed-point multiply-add over the significands, reached through
+// setf.sig and getf.sig.
+void MacroAssemblerIa64::ma_mul(Register dest, Register lhs, Register rhs) {
+  emitM(ia64::SetfSig(kFpT0, lhs.encoding()));
+  emitM(ia64::SetfSig(kFpT1, rhs.encoding()));
+  emitF(ia64::XmaL(kFpT0, kFpT0, kFpT1, ia64::fpZero));
+  emitM(ia64::GetfSig(dest.encoding(), kFpT0));
+}
+
+// Restoring long division. |n| is shifted left one bit per step with the
+// quotient accumulating into the bits it vacates, and |r| collects the
+// remainder, so the dividend and the quotient share a register.
+void MacroAssemblerIa64::ma_divmod(Register divOutput, Register remOutput,
+                                   Register lhs, Register rhs, bool isUnsigned,
+                                   unsigned width) {
+  MOZ_ASSERT(width == 32 || width == 64);
+  MOZ_ASSERT(divOutput != InvalidReg || remOutput != InvalidReg);
+  MOZ_ASSERT(divOutput != remOutput || divOutput == InvalidReg);
+
+  // The remainder needs a register throughout; when only the quotient is
+  // wanted its output register does that job and is overwritten at the end.
+  Register acc = remOutput != InvalidReg ? remOutput : divOutput;
+  MOZ_ASSERT(acc != ScratchReg && acc != SecondScratchReg);
+
+  const uint32_t n = ScratchReg.encoding();        // dividend, then quotient
+  const uint32_t d = SecondScratchReg.encoding();  // divisor
+  const uint32_t r = acc.encoding();               // remainder
+  const uint32_t z = Registers::zero;
+  const uint32_t i = BorrowScratch(divOutput, remOutput).encoding();
+
+  // The loop clobbers p6..p9, so the sign predicates live above that.
+  const uint32_t kNegDividend = 10;
+  const uint32_t kNegQuotient = 11;
+
+  emitI(ia64::MovToBr(7, i));
+
+  if (width == 32) {
+    if (isUnsigned) {
+      emitI(ia64::Zxt4(n, lhs.encoding()));
+      emitI(ia64::Zxt4(d, rhs.encoding()));
+    } else {
+      emitI(ia64::Sxt4(n, lhs.encoding()));
+      emitI(ia64::Sxt4(d, rhs.encoding()));
+    }
+  } else {
+    emitM(ia64::MovReg(n, lhs.encoding()));
+    emitM(ia64::MovReg(d, rhs.encoding()));
+  }
+
+  if (!isUnsigned) {
+    // The quotient is negative when the operand signs differ; |dest| is still
+    // free at this point, so it can hold the xor that tests that.
+    emitM(ia64::Xor(r, n, d));
+    emitI(ia64::CmpLt(kNegQuotient, 12, r, z));
+    emitI(ia64::CmpLt(kNegDividend, 12, n, z));
+    emitM(ia64::Sub(n, z, n, kNegDividend));
+    emitI(ia64::CmpLt(12, 13, d, z));
+    emitM(ia64::Sub(d, z, d, 12));
+  }
+
+  emitM(ia64::MovReg(r, z));
+  emitM(ia64::Adds(i, 64, z));
+
+  Label loop;
+  bind(&loop);
+  emitI(ia64::CmpLt(kP, kQ, n, z));   // p6 = top bit of the dividend
+  emitI(ia64::ShlImm(n, n, 1));
+  emitI(ia64::ShlImm(r, r, 1));
+  emitM(ia64::Adds(r, 1, r, kP));
+  emitI(ia64::CmpLtu(8, 9, r, d));    // p9 = r >= d
+  emitM(ia64::Sub(r, r, d, 9));
+  emitM(ia64::Adds(n, 1, n, 9));
+  emitM(ia64::Adds(i, -1, i));
+  emitI(ia64::CmpEq(kP, kQ, i, z));
+  emitBranchToLabel(&ia64::BrCondRel, kQ, &loop);
+
+  if (!isUnsigned) {
+    // The remainder takes the sign of the dividend, the quotient that of the
+    // xor of the two operand signs.
+    emitM(ia64::Sub(r, z, r, kNegDividend));
+    emitM(ia64::Sub(n, z, n, kNegQuotient));
+  }
+
+  if (remOutput != InvalidReg && width == 32) {
+    emitI(isUnsigned ? ia64::Zxt4(r, r) : ia64::Sxt4(r, r));
+  }
+  if (divOutput != InvalidReg) {
+    emitM(ia64::MovReg(divOutput.encoding(), n));
+    if (width == 32) {
+      emitI(isUnsigned ? ia64::Zxt4(divOutput.encoding(), divOutput.encoding())
+                       : ia64::Sxt4(divOutput.encoding(),
+                                    divOutput.encoding()));
+    }
+  }
+
+  emitI(ia64::MovFromBr(i, 7));
+}
+
+void MacroAssemblerIa64::ma_cmov(Assembler::Condition cond, Register src,
+                                 Register dest) {
+  MOZ_CRASH("ia64: ma_cmov needs the compare that produced |cond|");
+}
+
+// ===========================================================================
+// Jumps.
+
+void MacroAssemblerIa64::jump(Label* label) {
+  // p0 is hardwired true, so an unpredicated br.cond is an unconditional jump.
+  emitBranchToLabel(&ia64::BrCondRel, 0, label);
+}
+
+void MacroAssemblerIa64::jump(Register reg) {
+  emitI(ia64::MovToBr(6, reg.encoding()));
+  emitB(ia64::BrCond(6));
+}
+
+void MacroAssemblerIa64::jump(ImmPtr ptr) {
+  movePtr(ptr, ScratchReg);
+  jump(ScratchReg);
+}
+
+void MacroAssemblerIa64::jump(TrampolinePtr code) { jump(ImmPtr(code.value)); }
+
+void MacroAssemblerIa64::jump(JitCode* code) {
+  writeJumpRelocation();
+  emitMovl(ScratchReg.encoding(), uint64_t(uintptr_t(code->raw())));
+  jump(ScratchReg);
+}
+
+void MacroAssemblerIa64::jump(const Address& addr) {
+  loadPtr(addr, ScratchReg);
+  jump(ScratchReg);
+}
+
+// ===========================================================================
+// Loads and stores. IA-64 addresses memory through a bare register, so every
+// Address or BaseIndex costs a computeAddress first.
+
+FaultingCodeOffset MacroAssemblerIa64::loadPtr(const Address& addr,
+                                               Register dest) {
+  computeAddress(addr, ScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::Ld8(dest.encoding(), ScratchReg.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::loadPtr(const BaseIndex& addr,
+                                               Register dest) {
+  computeAddress(addr, SecondScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::Ld8(dest.encoding(), SecondScratchReg.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::loadPtr(AbsoluteAddress addr,
+                                               Register dest) {
+  computeAddress(addr, ScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::Ld8(dest.encoding(), ScratchReg.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::loadPtr(ImmPtr addr, Register dest) {
+  return loadPtr(AbsoluteAddress(addr.value), dest);
+}
+
+FaultingCodeOffset MacroAssemblerIa64::load32(const Address& addr,
+                                              Register dest) {
+  computeAddress(addr, ScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::Ld4(dest.encoding(), ScratchReg.encoding()));
+  // ld4 zero-extends; the JIT keeps int32 values sign-extended in registers so
+  // that the 64-bit compares used by branch32() stay correct.
+  ma_sxt(dest, dest, 4);
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::load32(const BaseIndex& addr,
+                                              Register dest) {
+  computeAddress(addr, SecondScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::Ld4(dest.encoding(), SecondScratchReg.encoding()));
+  ma_sxt(dest, dest, 4);
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::load32(AbsoluteAddress addr,
+                                              Register dest) {
+  computeAddress(addr, ScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::Ld4(dest.encoding(), ScratchReg.encoding()));
+  ma_sxt(dest, dest, 4);
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::load32(ImmPtr addr, Register dest) {
+  return load32(AbsoluteAddress(addr.value), dest);
+}
+
+#define IA64_DEFINE_NARROW_LOAD(Name, LoadInsn, Bytes, Extend)             \
+  FaultingCodeOffset MacroAssemblerIa64::Name(const Address& addr,         \
+                                              Register dest) {            \
+    computeAddress(addr, ScratchReg);                                     \
+    FaultingCodeOffset fco(currentOffset());                              \
+    emitM(ia64::LoadInsn(dest.encoding(), ScratchReg.encoding()));        \
+    Extend(dest, dest, Bytes);                                            \
+    return fco;                                                           \
+  }                                                                       \
+  FaultingCodeOffset MacroAssemblerIa64::Name(const BaseIndex& addr,      \
+                                              Register dest) {            \
+    computeAddress(addr, SecondScratchReg);                               \
+    FaultingCodeOffset fco(currentOffset());                              \
+    emitM(ia64::LoadInsn(dest.encoding(), SecondScratchReg.encoding()));  \
+    Extend(dest, dest, Bytes);                                            \
+    return fco;                                                           \
+  }
+
+IA64_DEFINE_NARROW_LOAD(load8SignExtend, Ld1, 1, ma_sxt)
+IA64_DEFINE_NARROW_LOAD(load8ZeroExtend, Ld1, 1, ma_zxt)
+IA64_DEFINE_NARROW_LOAD(load16SignExtend, Ld2, 2, ma_sxt)
+IA64_DEFINE_NARROW_LOAD(load16ZeroExtend, Ld2, 2, ma_zxt)
+
+#undef IA64_DEFINE_NARROW_LOAD
+
+template <typename T>
+void MacroAssemblerIa64::ma_loadUnaligned(const T& src, Register dest,
+                                          unsigned bytes, bool signExtend) {
+  MOZ_ASSERT(bytes == 2 || bytes == 4 || bytes == 8);
+  MOZ_ASSERT(dest != ScratchReg && dest != SecondScratchReg);
+  computeAddress(src, SecondScratchReg);
+  emitM(ia64::Ld1(dest.encoding(), SecondScratchReg.encoding()));
+  for (unsigned i = 1; i < bytes; i++) {
+    emitM(
+        ia64::Adds(SecondScratchReg.encoding(), 1, SecondScratchReg.encoding()));
+    emitM(ia64::Ld1(ScratchReg.encoding(), SecondScratchReg.encoding()));
+    emitI(ia64::ShlImm(ScratchReg.encoding(), ScratchReg.encoding(), i * 8));
+    emitM(ia64::Or(dest.encoding(), dest.encoding(), ScratchReg.encoding()));
+  }
+  // The byte-wise result is zero-extended by construction.
+  if (signExtend && bytes < 8) {
+    ma_sxt(dest, dest, bytes);
+  }
+}
+
+template void MacroAssemblerIa64::ma_loadUnaligned(const Address&, Register,
+                                                   unsigned, bool);
+template void MacroAssemblerIa64::ma_loadUnaligned(const BaseIndex&, Register,
+                                                   unsigned, bool);
+
+template <typename T>
+void MacroAssemblerIa64::ma_storeUnaligned(Register src, const T& dest,
+                                           unsigned bytes) {
+  MOZ_ASSERT(bytes == 2 || bytes == 4 || bytes == 8);
+  MOZ_ASSERT(src != ScratchReg && src != SecondScratchReg);
+  computeAddress(dest, SecondScratchReg);
+  emitM(ia64::St1(SecondScratchReg.encoding(), src.encoding()));
+  for (unsigned i = 1; i < bytes; i++) {
+    emitM(
+        ia64::Adds(SecondScratchReg.encoding(), 1, SecondScratchReg.encoding()));
+    emitI(ia64::ShrUImm(ScratchReg.encoding(), src.encoding(), i * 8));
+    emitM(ia64::St1(SecondScratchReg.encoding(), ScratchReg.encoding()));
+  }
+}
+
+template void MacroAssemblerIa64::ma_storeUnaligned(Register, const Address&,
+                                                    unsigned);
+template void MacroAssemblerIa64::ma_storeUnaligned(Register, const BaseIndex&,
+                                                    unsigned);
+
+#define IA64_DEFINE_STORE(Name, StoreInsn)                                 \
+  FaultingCodeOffset MacroAssemblerIa64::Name(Register src,                \
+                                              const Address& dest) {       \
+    computeAddress(dest, ScratchReg);                                      \
+    FaultingCodeOffset fco(currentOffset());                               \
+    emitM(ia64::StoreInsn(ScratchReg.encoding(), src.encoding()));         \
+    return fco;                                                            \
+  }                                                                        \
+  FaultingCodeOffset MacroAssemblerIa64::Name(Register src,                \
+                                              const BaseIndex& dest) {     \
+    computeAddress(dest, SecondScratchReg);                                \
+    FaultingCodeOffset fco(currentOffset());                               \
+    emitM(ia64::StoreInsn(SecondScratchReg.encoding(), src.encoding()));   \
+    return fco;                                                            \
+  }
+
+IA64_DEFINE_STORE(storePtr, St8)
+IA64_DEFINE_STORE(store32, St4)
+IA64_DEFINE_STORE(store16, St2)
+IA64_DEFINE_STORE(store8, St1)
+
+#undef IA64_DEFINE_STORE
+
+FaultingCodeOffset MacroAssemblerIa64::storePtr(Register src,
+                                                AbsoluteAddress dest) {
+  computeAddress(dest, ScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::St8(ScratchReg.encoding(), src.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::store32(Register src,
+                                               AbsoluteAddress dest) {
+  computeAddress(dest, ScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::St4(ScratchReg.encoding(), src.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::storePtr(ImmWord imm,
+                                                const Address& dest) {
+  computeAddress(dest, ScratchReg);
+  emitMovl(SecondScratchReg.encoding(), imm.value);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::St8(ScratchReg.encoding(), SecondScratchReg.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::storePtr(ImmWord imm,
+                                                const BaseIndex& dest) {
+  computeAddress(dest, ScratchReg);
+  emitMovl(SecondScratchReg.encoding(), imm.value);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::St8(ScratchReg.encoding(), SecondScratchReg.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::storePtr(ImmPtr imm,
+                                                const Address& dest) {
+  return storePtr(ImmWord(uintptr_t(imm.value)), dest);
+}
+
+FaultingCodeOffset MacroAssemblerIa64::storePtr(ImmPtr imm,
+                                                const BaseIndex& dest) {
+  return storePtr(ImmWord(uintptr_t(imm.value)), dest);
+}
+
+FaultingCodeOffset MacroAssemblerIa64::storePtr(ImmGCPtr imm,
+                                                const Address& dest) {
+  computeAddress(dest, ScratchReg);
+  movePtr(imm, SecondScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::St8(ScratchReg.encoding(), SecondScratchReg.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::storePtr(ImmGCPtr imm,
+                                                const BaseIndex& dest) {
+  computeAddress(dest, ScratchReg);
+  movePtr(imm, SecondScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::St8(ScratchReg.encoding(), SecondScratchReg.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::store32(Imm32 imm,
+                                               const Address& dest) {
+  computeAddress(dest, ScratchReg);
+  move32(imm, SecondScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::St4(ScratchReg.encoding(), SecondScratchReg.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::store32(Imm32 imm,
+                                               const BaseIndex& dest) {
+  computeAddress(dest, ScratchReg);
+  move32(imm, SecondScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::St4(ScratchReg.encoding(), SecondScratchReg.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::store32(Imm32 imm,
+                                               AbsoluteAddress dest) {
+  computeAddress(dest, ScratchReg);
+  move32(imm, SecondScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::St4(ScratchReg.encoding(), SecondScratchReg.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::store16(Imm32 imm,
+                                               const Address& dest) {
+  computeAddress(dest, ScratchReg);
+  move32(imm, SecondScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::St2(ScratchReg.encoding(), SecondScratchReg.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::store16(Imm32 imm,
+                                               const BaseIndex& dest) {
+  computeAddress(dest, ScratchReg);
+  move32(imm, SecondScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::St2(ScratchReg.encoding(), SecondScratchReg.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::store8(Imm32 imm, const Address& dest) {
+  computeAddress(dest, ScratchReg);
+  move32(imm, SecondScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::St1(ScratchReg.encoding(), SecondScratchReg.encoding()));
+  return fco;
+}
+
+FaultingCodeOffset MacroAssemblerIa64::store8(Imm32 imm,
+                                              const BaseIndex& dest) {
+  computeAddress(dest, ScratchReg);
+  move32(imm, SecondScratchReg);
+  FaultingCodeOffset fco(currentOffset());
+  emitM(ia64::St1(ScratchReg.encoding(), SecondScratchReg.encoding()));
+  return fco;
+}
+
+// ===========================================================================
+// Raw stack pushes and pops.
+
+void MacroAssemblerIa64::push(Register reg) {
+  // Pushing the stack pointer must store its value from before the push, which
+  // is what x86's "push %rsp" does and what the callers rely on.
+  if (reg == StackPointer) {
+    emitM(ia64::MovReg(ScratchReg.encoding(), StackPointer.encoding()));
+    reg = ScratchReg;
+  }
+  emitM(ia64::Adds(StackPointer.encoding(), -int64_t(sizeof(intptr_t)),
+                   StackPointer.encoding()));
+  emitM(ia64::St8(StackPointer.encoding(), reg.encoding()));
+}
+
+void MacroAssemblerIa64::push(Imm32 imm) {
+  move32(imm, ScratchReg);
+  push(ScratchReg);
+}
+
+void MacroAssemblerIa64::push(ImmWord imm) {
+  movePtr(imm, ScratchReg);
+  push(ScratchReg);
+}
+
+void MacroAssemblerIa64::push(ImmPtr imm) {
+  push(ImmWord(uintptr_t(imm.value)));
+}
+
+void MacroAssemblerIa64::push(ImmGCPtr imm) {
+  movePtr(imm, ScratchReg);
+  push(ScratchReg);
+}
+
+void MacroAssemblerIa64::push(const Address& addr) {
+  loadPtr(addr, SecondScratchReg);
+  push(SecondScratchReg);
+}
+
+void MacroAssemblerIa64::pop(Register reg) {
+  emitM(ia64::Ld8(reg.encoding(), StackPointer.encoding()));
+  emitM(ia64::Adds(StackPointer.encoding(), sizeof(intptr_t),
+                   StackPointer.encoding()));
+}
+
+void MacroAssemblerIa64::pop(const ValueOperand& val) { pop(val.valueReg()); }
+
+void MacroAssemblerIa64::push(FloatRegister reg) {
+  emitM(ia64::Adds(StackPointer.encoding(), -int64_t(sizeof(double)),
+                   StackPointer.encoding()));
+  emitM(ia64::Stfd(StackPointer.encoding(), reg.encoding()));
+}
+
+void MacroAssemblerIa64::pop(FloatRegister reg) {
+  emitM(ia64::Ldfd(reg.encoding(), StackPointer.encoding()));
+  emitM(ia64::Adds(StackPointer.encoding(), sizeof(double),
+                   StackPointer.encoding()));
+}
+
+// |n| counts the return address too, exactly as x86's "ret imm16" does.
+void MacroAssemblerIa64::retn(Imm32 n) {
+  emitM(ia64::Ld8(ScratchReg.encoding(), StackPointer.encoding()));
+  emitM(ia64::Adds(StackPointer.encoding(), n.value, StackPointer.encoding()));
+  emitI(ia64::MovToBr(6, ScratchReg.encoding()));
+  emitB(ia64::BrCond(6));
+}
+
+// ===========================================================================
+// Values. JS_PUNBOX64 keeps a Value in one 64-bit register.
+
+void MacroAssembler::moveValue(const ValueOperand& src,
+                               const ValueOperand& dest) {
+  if (src.valueReg() != dest.valueReg()) {
+    movePtr(src.valueReg(), dest.valueReg());
+  }
+}
+
+void MacroAssembler::moveValue(const Value& src, const ValueOperand& dest) {
+  if (!src.isGCThing()) {
+    movePtr(ImmWord(src.asRawBits()), dest.valueReg());
+    return;
+  }
+  // A GC-thing Value must go through ImmGCPtr so the pointer is traced; the
+  // tag is or'ed back on afterwards.
+  movePtr(ImmGCPtr(src.toGCThing()), dest.valueReg());
+  emitMovl(ScratchReg.encoding(), uint64_t(src.asRawBits()) & ValueTagMask);
+  emitM(ia64::Or(dest.valueReg().encoding(), dest.valueReg().encoding(),
+                 ScratchReg.encoding()));
+}
+
+void MacroAssemblerIa64::loadValue(const Address& src, ValueOperand val) {
+  loadPtr(src, val.valueReg());
+}
+
+void MacroAssemblerIa64::loadValue(const BaseIndex& src, ValueOperand val) {
+  loadPtr(src, val.valueReg());
+}
+
+void MacroAssemblerIa64::storeValue(ValueOperand val, const Address& dest) {
+  storePtr(val.valueReg(), dest);
+}
+
+void MacroAssemblerIa64::storeValue(ValueOperand val, const BaseIndex& dest) {
+  storePtr(val.valueReg(), dest);
+}
+
+void MacroAssemblerIa64::storeValue(const Value& val, const Address& dest) {
+  asMasm().moveValue(val, ValueOperand(SecondScratchReg));
+  storePtr(SecondScratchReg, dest);
+}
+
+void MacroAssemblerIa64::storeValue(const Value& val, const BaseIndex& dest) {
+  // storePtr() to a BaseIndex computes the address in SecondScratchReg, so the
+  // boxed value cannot live there; address it out of ScratchReg instead.
+  asMasm().moveValue(val, ValueOperand(SecondScratchReg));
+  computeAddress(dest, ScratchReg);
+  emitM(ia64::St8(ScratchReg.encoding(), SecondScratchReg.encoding()));
+}
+
+void MacroAssemblerIa64::storeValue(JSValueType type, Register reg,
+                                    const Address& dest) {
+  tagValue(type, reg, ValueOperand(SecondScratchReg));
+  storePtr(SecondScratchReg, dest);
+}
+
+void MacroAssemblerIa64::storeValue(JSValueType type, Register reg,
+                                    const BaseIndex& dest) {
+  tagValue(type, reg, ValueOperand(SecondScratchReg));
+  computeAddress(dest, ScratchReg);
+  emitM(ia64::St8(ScratchReg.encoding(), SecondScratchReg.encoding()));
+}
+
+void MacroAssemblerIa64::pushValue(ValueOperand val) { push(val.valueReg()); }
+
+void MacroAssemblerIa64::pushValue(const Value& val) {
+  asMasm().moveValue(val, ValueOperand(SecondScratchReg));
+  push(SecondScratchReg);
+}
+
+void MacroAssemblerIa64::pushValue(const Address& addr) { push(addr); }
+
+void MacroAssemblerIa64::pushValue(JSValueType type, Register reg) {
+  tagValue(type, reg, ValueOperand(SecondScratchReg));
+  push(SecondScratchReg);
+}
+
+void MacroAssemblerIa64::popValue(ValueOperand val) { pop(val.valueReg()); }
+
+void MacroAssemblerIa64::tagValue(JSValueType type, Register payload,
+                                  ValueOperand dest) {
+  Register out = dest.valueReg();
+  if (type == JSVAL_TYPE_INT32 || type == JSVAL_TYPE_BOOLEAN) {
+    ma_zxt(out, payload, 4);
+  } else {
+    emitMovl(ScratchReg.encoding(), JS::detail::ValueGCThingPayloadMask);
+    emitM(
+        ia64::And(out.encoding(), payload.encoding(), ScratchReg.encoding()));
+  }
+  emitMovl(ScratchReg.encoding(), JSVAL_TYPE_TO_SHIFTED_TAG(type));
+  emitM(ia64::Or(out.encoding(), out.encoding(), ScratchReg.encoding()));
+}
+
+void MacroAssemblerIa64::emitTagOf(const Address& value, Register tag) {
+  loadPtr(value, tag);
+  emitMovl(ScratchReg.encoding(), ValueTagMask);
+  emitM(ia64::And(tag.encoding(), tag.encoding(), ScratchReg.encoding()));
+}
+
+void MacroAssemblerIa64::emitTagOf(const BaseIndex& value, Register tag) {
+  loadPtr(value, tag);
+  emitMovl(ScratchReg.encoding(), ValueTagMask);
+  emitM(ia64::And(tag.encoding(), tag.encoding(), ScratchReg.encoding()));
+}
+
+void MacroAssemblerIa64::unboxNonDouble(const ValueOperand& src, Register dest,
+                                        JSValueType type) {
+  MOZ_ASSERT(type != JSVAL_TYPE_DOUBLE);
+  if (type == JSVAL_TYPE_INT32) {
+    ma_sxt(dest, src.valueReg(), 4);
+    return;
+  }
+  if (type == JSVAL_TYPE_BOOLEAN) {
+    ma_zxt(dest, src.valueReg(), 4);
+    return;
+  }
+  emitMovl(ScratchReg.encoding(), JSVAL_TYPE_TO_SHIFTED_TAG(type));
+  emitM(ia64::Xor(dest.encoding(), src.valueReg().encoding(),
+                  ScratchReg.encoding()));
+}
+
+void MacroAssemblerIa64::unboxNonDouble(const Address& src, Register dest,
+                                        JSValueType type) {
+  loadPtr(src, dest);
+  unboxNonDouble(ValueOperand(dest), dest, type);
+}
+
+void MacroAssemblerIa64::unboxNonDouble(const BaseIndex& src, Register dest,
+                                        JSValueType type) {
+  loadPtr(src, dest);
+  unboxNonDouble(ValueOperand(dest), dest, type);
+}
+
+void MacroAssemblerIa64::unboxGCThingForGCBarrier(const ValueOperand& src,
+                                                  Register dest) {
+  emitMovl(ScratchReg.encoding(), JS::detail::ValueGCThingPayloadMask);
+  emitM(ia64::And(dest.encoding(), src.valueReg().encoding(),
+                  ScratchReg.encoding()));
+}
+
+void MacroAssemblerIa64::unboxGCThingForGCBarrier(const Address& src,
+                                                  Register dest) {
+  loadPtr(src, dest);
+  unboxGCThingForGCBarrier(ValueOperand(dest), dest);
+}
+
+#define IA64_DEFINE_UNBOX(Name, Type)                                     \
+  void MacroAssemblerIa64::Name(const ValueOperand& src, Register dest) { \
+    unboxNonDouble(src, dest, Type);                                      \
+  }                                                                       \
+  void MacroAssemblerIa64::Name(const Address& src, Register dest) {      \
+    unboxNonDouble(src, dest, Type);                                      \
+  }
+
+IA64_DEFINE_UNBOX(unboxString, JSVAL_TYPE_STRING)
+IA64_DEFINE_UNBOX(unboxSymbol, JSVAL_TYPE_SYMBOL)
+IA64_DEFINE_UNBOX(unboxBigInt, JSVAL_TYPE_BIGINT)
+
+#undef IA64_DEFINE_UNBOX
+
+#define IA64_DEFINE_UNBOX3(Name, Type)                                    \
+  void MacroAssemblerIa64::Name(const ValueOperand& src, Register dest) { \
+    unboxNonDouble(src, dest, Type);                                      \
+  }                                                                       \
+  void MacroAssemblerIa64::Name(const Address& src, Register dest) {      \
+    unboxNonDouble(src, dest, Type);                                      \
+  }                                                                       \
+  void MacroAssemblerIa64::Name(const BaseIndex& src, Register dest) {    \
+    unboxNonDouble(src, dest, Type);                                      \
+  }
+
+IA64_DEFINE_UNBOX3(unboxInt32, JSVAL_TYPE_INT32)
+IA64_DEFINE_UNBOX3(unboxBoolean, JSVAL_TYPE_BOOLEAN)
+IA64_DEFINE_UNBOX3(unboxObject, JSVAL_TYPE_OBJECT)
+
+#undef IA64_DEFINE_UNBOX3
+
+void MacroAssemblerIa64::incrementInt32Value(const Address& addr) {
+  computeAddress(addr, SecondScratchReg);
+  emitM(ia64::Ld4(ScratchReg.encoding(), SecondScratchReg.encoding()));
+  emitM(ia64::Adds(ScratchReg.encoding(), 1, ScratchReg.encoding()));
+  emitM(ia64::St4(SecondScratchReg.encoding(), ScratchReg.encoding()));
+}
+
+Assembler::Condition MacroAssemblerIa64::testInt32Truthy(
+    bool truthy, const ValueOperand& value) {
+  MOZ_CRASH("ia64: testInt32Truthy leaves no condition code behind");
+}
+
+Assembler::Condition MacroAssemblerIa64::testStringTruthy(
+    bool truthy, const ValueOperand& value) {
+  MOZ_CRASH("ia64: testStringTruthy leaves no condition code behind");
+}
+
+Assembler::Condition MacroAssemblerIa64::testBigIntTruthy(
+    bool truthy, const ValueOperand& value) {
+  MOZ_CRASH("ia64: testBigIntTruthy leaves no condition code behind");
+}
+
+void MacroAssemblerIa64::testNullSet(Condition cond, ValueOperand value,
+                                     Register dest) {
+  emitTagOf(value, SecondScratchReg);
+  asMasm().cmp32Set(cond, SecondScratchReg, ImmWord(JSVAL_SHIFTED_TAG_NULL),
+                    dest);
+}
+
+void MacroAssemblerIa64::testObjectSet(Condition cond, ValueOperand value,
+                                       Register dest) {
+  emitTagOf(value, SecondScratchReg);
+  asMasm().cmp32Set(cond, SecondScratchReg, ImmWord(JSVAL_SHIFTED_TAG_OBJECT),
+                    dest);
+}
+
+void MacroAssemblerIa64::testUndefinedSet(Condition cond, ValueOperand value,
+                                          Register dest) {
+  emitTagOf(value, SecondScratchReg);
+  asMasm().cmp32Set(cond, SecondScratchReg,
+                    ImmWord(JSVAL_SHIFTED_TAG_UNDEFINED), dest);
+}
+
+// ===========================================================================
+// MacroAssembler: stack management.
+
+void MacroAssembler::flush() {}
+
+void MacroAssembler::comment(const char* msg) {}
+
+void MacroAssembler::subFromStackPtr(Imm32 imm32) {
+  if (imm32.value) {
+    subPtr(imm32, StackPointer);
+  }
+}
+
+void MacroAssembler::freeStackTo(uint32_t framePushed) {
+  MOZ_ASSERT(framePushed <= framePushed_);
+  addPtr(Imm32(int32_t(framePushed_ - framePushed)), StackPointer);
+  framePushed_ = framePushed;
+}
+
+size_t MacroAssembler::PushRegsInMaskSizeInBytes(LiveRegisterSet set) {
+  return set.gprs().size() * sizeof(intptr_t) + set.fpus().getPushSizeInBytes();
+}
+
+// Every floating-point spill slot is an 8-byte IEEE double: a single is
+// exactly representable as one, so stfd/ldfd round-trips either kind.
+void MacroAssembler::PushRegsInMask(LiveRegisterSet set) {
+  FloatRegisterSet fpus(set.fpus().reduceSetForPush());
+  int32_t diff =
+      int32_t(set.gprs().size() * sizeof(intptr_t) + fpus.getPushSizeInBytes());
+  const int32_t reserved = diff;
+  reserveStack(reserved);
+  for (GeneralRegisterBackwardIterator iter(set.gprs()); iter.more(); ++iter) {
+    diff -= sizeof(intptr_t);
+    storePtr(*iter, Address(StackPointer, diff));
+  }
+  for (FloatRegisterBackwardIterator iter(fpus); iter.more(); ++iter) {
+    diff -= sizeof(double);
+    ma_storeFp((*iter).asDouble(), Address(StackPointer, diff));
+  }
+  MOZ_ASSERT(diff == 0);
+}
+
+// |dest| addresses the *end* of the save area, one past its highest byte, and
+// the layout has to be byte-for-byte the one PushRegsInMask() produces, since
+// PopRegsInMask() is what reads it back. Fill downwards from |dest|.
+void MacroAssembler::storeRegsInMask(LiveRegisterSet set, Address dest,
+                                     Register scratch) {
+  FloatRegisterSet fpus(set.fpus().reduceSetForPush());
+  int32_t offset = dest.offset;
+  for (GeneralRegisterBackwardIterator iter(set.gprs()); iter.more(); ++iter) {
+    offset -= sizeof(intptr_t);
+    storePtr(*iter, Address(dest.base, offset));
+  }
+  for (FloatRegisterBackwardIterator iter(fpus); iter.more(); ++iter) {
+    offset -= sizeof(double);
+    ma_storeFp((*iter).asDouble(), Address(dest.base, offset));
+  }
+  MOZ_ASSERT(dest.offset - offset ==
+             int32_t(set.gprs().size() * sizeof(intptr_t) +
+                     fpus.getPushSizeInBytes()));
+}
+
+void MacroAssembler::PopRegsInMaskIgnore(LiveRegisterSet set,
+                                         LiveRegisterSet ignore) {
+  FloatRegisterSet fpus(set.fpus().reduceSetForPush());
+  int32_t diff =
+      int32_t(set.gprs().size() * sizeof(intptr_t) + fpus.getPushSizeInBytes());
+  const int32_t reserved = diff;
+  for (GeneralRegisterBackwardIterator iter(set.gprs()); iter.more(); ++iter) {
+    diff -= sizeof(intptr_t);
+    if (!ignore.has(*iter)) {
+      loadPtr(Address(StackPointer, diff), *iter);
+    }
+  }
+  for (FloatRegisterBackwardIterator iter(fpus); iter.more(); ++iter) {
+    diff -= sizeof(double);
+    if (!ignore.has(*iter)) {
+      ma_loadFp(Address(StackPointer, diff), (*iter).asDouble());
+    }
+  }
+  MOZ_ASSERT(diff == 0);
+  freeStack(reserved);
+}
+
+void MacroAssembler::Push(Register reg) {
+  push(reg);
+  adjustFrame(sizeof(intptr_t));
+}
+
+void MacroAssembler::Push(const Imm32 imm) {
+  push(imm);
+  adjustFrame(sizeof(intptr_t));
+}
+
+void MacroAssembler::Push(const ImmWord imm) {
+  push(imm);
+  adjustFrame(sizeof(intptr_t));
+}
+
+void MacroAssembler::Push(const ImmPtr imm) {
+  push(ImmWord(uintptr_t(imm.value)));
+  adjustFrame(sizeof(intptr_t));
+}
+
+void MacroAssembler::Push(const ImmGCPtr ptr) {
+  push(ptr);
+  adjustFrame(sizeof(intptr_t));
+}
+
+void MacroAssembler::Push(FloatRegister reg) {
+  push(reg);
+  adjustFrame(sizeof(double));
+}
+
+void MacroAssembler::PushBoxed(FloatRegister reg) { Push(reg); }
+
+void MacroAssembler::Pop(Register reg) {
+  pop(reg);
+  implicitPop(sizeof(intptr_t));
+}
+
+void MacroAssembler::Pop(FloatRegister reg) {
+  pop(reg);
+  implicitPop(sizeof(double));
+}
+
+void MacroAssembler::PopStackPtr() {
+  loadPtr(Address(StackPointer, 0), StackPointer);
+  adjustFrame(-int32_t(sizeof(intptr_t)));
+}
+
+void MacroAssembler::enterFakeExitFrameForWasm(Register cxreg, Register scratch,
+                                               ExitFrameType type) {
+  enterFakeExitFrame(cxreg, scratch, type);
+}
+
+void MacroAssembler::Pop(const ValueOperand& val) {
+  popValue(val);
+  implicitPop(sizeof(Value));
+}
+
+// ===========================================================================
+// MacroAssembler: calls.
+//
+// IA-64 puts the return address in b0, but the JIT's frame layout, its inline
+// caches and its VM wrappers are all written for a platform that keeps the
+// return address on the memory stack, so a JIT call does both: it pushes the
+// address of the instruction after the call and then branches with br.call.
+// ret() and retn() take the address back off the stack rather than using b0,
+// because a callee that itself calls has long since overwritten b0.
+//
+// The C ABI does not want the extra word, so callWithABIPre()/callWithABIPost()
+// leave room for it and drop it again on return.
+
+CodeOffset MacroAssembler::call(Register reg) {
+  // Consume |reg| first: materialising the return address clobbers ScratchReg,
+  // which is where call(Address) and call(ImmPtr) put their target.
+  emitI(ia64::MovToBr(6, reg.encoding()));
+  CodeLabel retLabel;
+  mov(&retLabel, ScratchReg);
+  push(ScratchReg);
+  emitB(ia64::BrCall(0, 6));
+  bind(&retLabel);
+  addCodeLabel(retLabel);
+  return CodeOffset(currentOffset());
+}
+
+static ia64::Insn BrCallRelB0(int32_t bundleDisp, uint32_t qp) {
+  return ia64::BrCallRel(0, bundleDisp, qp);
+}
+
+CodeOffset MacroAssembler::call(Label* label) {
+  CodeLabel retLabel;
+  mov(&retLabel, ScratchReg);
+  push(ScratchReg);
+  emitBranchToLabel(&BrCallRelB0, 0, label);
+  bind(&retLabel);
+  addCodeLabel(retLabel);
+  return CodeOffset(currentOffset());
+}
+
+CodeOffset MacroAssembler::call(const Address& addr) {
+  loadPtr(addr, ScratchReg);
+  return call(ScratchReg);
+}
+
+void MacroAssembler::call(ImmWord imm) {
+  movePtr(imm, ScratchReg);
+  call(ScratchReg);
+}
+
+void MacroAssembler::call(ImmPtr imm) { call(ImmWord(uintptr_t(imm.value))); }
+
+CodeOffset MacroAssembler::call(wasm::SymbolicAddress imm) {
+  MOZ_CRASH("ia64: wasm is not supported");
+}
+
+void MacroAssembler::call(JitCode* c) {
+  writeJumpRelocation();
+  emitMovl(ScratchReg.encoding(), uint64_t(uintptr_t(c->raw())));
+  call(ScratchReg);
+}
+
+CodeOffset MacroAssembler::callWithPatch() {
+  emitB(BrCallRelB0(0, 0));
+  return CodeOffset(currentOffset());
+}
+
+void MacroAssembler::patchCall(uint32_t callerOffset, uint32_t calleeOffset) {
+  // callerOffset is the return address, i.e. just past the br.call bundle.
+  BufferOffset site(callerOffset - sizeof(ia64::Bundle));
+  int32_t disp = BundleIndex(BufferOffset(calleeOffset)) - BundleIndex(site);
+  MOZ_RELEASE_ASSERT(ia64::BranchDispInRange(disp));
+  ia64::PatchBranchDisp(bundleAt(site), disp);
+}
+
+void MacroAssembler::callAndPushReturnAddress(Register reg) { call(reg); }
+
+void MacroAssembler::callAndPushReturnAddress(Label* label) { call(label); }
+
+// A br.call writes both b0 and ar.pfs, and neither is a general register, so
+// SavedNonVolatileRegisters cannot carry them. Code that is entered from C,
+// calls, and then returns with abiret() has to spill both here: br.ret reads
+// the return address from b0 and restores the caller's frame marker from
+// ar.pfs, so leaving either clobbered corrupts the C caller.
+void MacroAssembler::pushReturnAddress() {
+  emitI(ia64::MovFromBr(ScratchReg.encoding(), 0));
+  push(ScratchReg);
+  emitI(ia64::MovFromPfs(ScratchReg.encoding()));
+  push(ScratchReg);
+}
+
+void MacroAssembler::popReturnAddress() {
+  pop(ScratchReg);
+  emitI(ia64::MovToPfs(ScratchReg.encoding()));
+  pop(ScratchReg);
+  emitI(ia64::MovToBr(0, ScratchReg.encoding()));
+}
+
+uint32_t MacroAssembler::pushFakeReturnAddress(Register scratch) {
+  CodeLabel retLabel;
+  mov(&retLabel, scratch);
+  Push(scratch);
+  bind(&retLabel);
+  uint32_t retAddr = currentOffset();
+  addCodeLabel(retLabel);
+  return retAddr;
+}
+
+// A movl holding the absolute target, moved into b6 and branched through. The
+// returned offset is that of the movl bundle, which is what patchFarJump()
+// rewrites.
+CodeOffset MacroAssembler::farJumpWithPatch() {
+  CodeOffset offset(currentOffset());
+  emitMovl(ScratchReg.encoding(), 0);
+  emitI(ia64::MovToBr(6, ScratchReg.encoding()));
+  emitB(ia64::BrCond(6));
+  return offset;
+}
+
+void MacroAssembler::patchFarJump(CodeOffset farJump, uint32_t targetOffset) {
+  MOZ_CRASH("ia64: an in-buffer far jump has no address to patch in yet");
+}
+
+// static
+void MacroAssembler::patchFarJump(uint8_t* farJump, uint8_t* target) {
+  WriteMovlImm(farJump, uint64_t(uintptr_t(target)));
+  FlushICache(farJump, sizeof(ia64::Bundle));
+}
+
+// A patchable call site: enough bundles for
+//   movl r2 = target ; movl r3 = returnAddress ; adds sp ; st8 ; mov b6 ; br.call
+static const uint32_t kPatchableCallBundles = 6;
+
+CodeOffset MacroAssembler::nopPatchableToCall() {
+  for (uint32_t i = 0; i < kPatchableCallBundles; i++) {
+    emitM(ia64::NopM());
+  }
+  return CodeOffset(currentOffset());
+}
+
+void MacroAssembler::patchNopToCall(uint8_t* callsite, uint8_t* target) {
+  ia64::Bundle* b = reinterpret_cast<ia64::Bundle*>(
+      callsite - kPatchableCallBundles * sizeof(ia64::Bundle));
+  b[0] = ia64::MovlBundle(Registers::r2, uint64_t(uintptr_t(target)));
+  b[1] = ia64::MovlBundle(Registers::r3, uint64_t(uintptr_t(callsite)));
+  b[2] = ia64::BundleM(
+      ia64::Adds(Registers::sp, -int64_t(sizeof(uintptr_t)), Registers::sp));
+  b[3] = ia64::BundleM(ia64::St8(Registers::sp, Registers::r3));
+  b[4] = ia64::BundleI(ia64::MovToBr(6, Registers::r2));
+  b[5] = ia64::BundleB(ia64::BrCall(0, 6));
+  FlushICache(b, kPatchableCallBundles * sizeof(ia64::Bundle));
+}
+
+void MacroAssembler::patchCallToNop(uint8_t* callsite) {
+  ia64::Bundle* b = reinterpret_cast<ia64::Bundle*>(
+      callsite - kPatchableCallBundles * sizeof(ia64::Bundle));
+  for (uint32_t i = 0; i < kPatchableCallBundles; i++) {
+    b[i] = ia64::BundleM(ia64::NopM());
+  }
+  FlushICache(b, kPatchableCallBundles * sizeof(ia64::Bundle));
+}
+
+CodeOffset MacroAssembler::moveNearAddressWithPatch(Register dest) {
+  CodeOffset offset(currentOffset());
+  emitMovl(dest.encoding(), 0);
+  return offset;
+}
+
+void MacroAssembler::patchNearAddressMove(CodeLocationLabel loc,
+                                          CodeLocationLabel target) {
+  WriteMovlImm(loc.raw(), uint64_t(uintptr_t(target.raw())));
+  FlushICache(loc.raw(), sizeof(ia64::Bundle));
+}
+
+// ===========================================================================
+// MacroAssembler: the C ABI.
+
+void MacroAssembler::setupUnalignedABICall(Register scratch) {
+  MOZ_ASSERT(!IsCompilingWasm(), "wasm should only use aligned ABI calls");
+  setupNativeABICall();
+  dynamicAlignment_ = true;
+
+  movePtr(StackPointer, scratch);
+  subPtr(Imm32(sizeof(uintptr_t)), StackPointer);
+  andPtr(Imm32(~(ABIStackAlignment - 1)), StackPointer);
+  storePtr(scratch, Address(StackPointer, 0));
+}
+
+void MacroAssembler::callWithABIPre(uint32_t* stackAdjust, bool callFromWasm) {
+  MOZ_ASSERT(inCall_);
+  uint32_t stackForCall = abiArgs_.stackBytesConsumedSoFar();
+
+  // Room for the saved return-branch register.
+  stackForCall += sizeof(intptr_t);
+
+
+  // call() pushes a return address the C callee neither expects nor pops, so
+  // it counts towards the alignment the callee sees and is dropped again in
+  // callWithABIPost().
+  const uint32_t retAddrWord = sizeof(intptr_t);
+
+  if (dynamicAlignment_) {
+    stackForCall +=
+        ComputeByteAlignment(stackForCall + retAddrWord, ABIStackAlignment);
+  } else {
+    uint32_t alignmentAtPrologue = callFromWasm ? sizeof(wasm::Frame) : 0;
+    stackForCall += ComputeByteAlignment(stackForCall + retAddrWord +
+                                             framePushed() + alignmentAtPrologue,
+                                         ABIStackAlignment);
+  }
+
+  *stackAdjust = stackForCall;
+  reserveStack(stackForCall);
+
+  // br.call overwrites b0, so stash it for callWithABIPost. It has to go
+  // through SecondScratchReg: storePtr() to an Address computes the address in
+  // ScratchReg and would overwrite the value before storing it.
+  emitI(ia64::MovFromBr(SecondScratchReg.encoding(), 0));
+  storePtr(SecondScratchReg,
+           Address(StackPointer, stackForCall - sizeof(intptr_t)));
+
+  {
+    enoughMemory_ &= moveResolver_.resolve();
+    if (!enoughMemory_) {
+      return;
+    }
+    MoveEmitter emitter(*this);
+    emitter.emit(moveResolver_);
+    emitter.finish();
+  }
+}
+
+void MacroAssembler::callWithABIPost(uint32_t stackAdjust, ABIType result) {
+  // Drop the return address call() pushed; the C callee returned through b0.
+  emitM(ia64::Adds(StackPointer.encoding(), sizeof(intptr_t),
+                   StackPointer.encoding()));
+  loadPtr(Address(StackPointer, stackAdjust - sizeof(intptr_t)), ScratchReg);
+  emitI(ia64::MovToBr(0, ScratchReg.encoding()));
+
+  if (dynamicAlignment_) {
+    loadPtr(Address(StackPointer, stackAdjust), StackPointer);
+    adjustFrame(-int32_t(stackAdjust));
+  } else {
+    freeStack(stackAdjust);
+  }
+
+#ifdef DEBUG
+  MOZ_ASSERT(inCall_);
+  inCall_ = false;
+#endif
+}
+
+CodeOffset MacroAssemblerIa64::callABIDescriptor(Register desc) {
+  MOZ_ASSERT(desc != ScratchReg);
+  emitM(ia64::Ld8(ScratchReg.encoding(), desc.encoding()));
+  emitM(ia64::Adds(desc.encoding(), sizeof(uintptr_t), desc.encoding()));
+  emitM(ia64::Ld8(Registers::gp, desc.encoding()));
+  return asMasm().call(ScratchReg);
+}
+
+void MacroAssembler::callWithABINoProfiler(Register fun, ABIType result) {
+  // Move the callee somewhere the argument setup below cannot clobber.
+  movePtr(fun, CallTempReg5);
+
+  uint32_t stackAdjust;
+  callWithABIPre(&stackAdjust);
+  callABIDescriptor(CallTempReg5);
+  callWithABIPost(stackAdjust, result);
+}
+
+void MacroAssembler::callWithABINoProfiler(const Address& fun, ABIType result) {
+  loadPtr(fun, CallTempReg5);
+
+  uint32_t stackAdjust;
+  callWithABIPre(&stackAdjust);
+  callABIDescriptor(CallTempReg5);
+  callWithABIPost(stackAdjust, result);
+}
+
+// Generated code is a bare entry point, never a {entry, gp} descriptor, so it
+// is branched to directly. It keeps the caller's gp, which is what it needs:
+// it loads gp from the descriptor of each C function it calls itself.
+void MacroAssembler::callWithABIJitCode(Register fun, ABIType result) {
+  AutoProfilerCallInstrumentation profiler(*this);
+  movePtr(fun, CallTempReg5);
+
+  uint32_t stackAdjust;
+  callWithABIPre(&stackAdjust);
+  call(CallTempReg5);
+  callWithABIPost(stackAdjust, result);
+}
+
+// ===========================================================================
+// MacroAssembler: GC support.
+
+void MacroAssembler::branchPtrInNurseryChunk(Condition cond, Register ptr,
+                                             Register temp, Label* label) {
+  MOZ_ASSERT(cond == Assembler::Equal || cond == Assembler::NotEqual);
+  MOZ_ASSERT(ptr != temp);
+  MOZ_ASSERT(temp != InvalidReg);
+
+  movePtr(ptr, temp);
+  andPtr(Imm32(int32_t(~gc::ChunkMask)), temp);
+  branchPtr(cond == Assembler::Equal ? Assembler::NotEqual : Assembler::Equal,
+            Address(temp, gc::ChunkStoreBufferOffset), ImmWord(0), label);
+}
+
+void MacroAssembler::branchValueIsNurseryCell(Condition cond,
+                                              const Address& address,
+                                              Register temp, Label* label) {
+  branchValueIsNurseryCellImpl(cond, address, temp, label);
+}
+
+void MacroAssembler::branchValueIsNurseryCell(Condition cond,
+                                              ValueOperand value, Register temp,
+                                              Label* label) {
+  branchValueIsNurseryCellImpl(cond, value, temp, label);
+}
+
+template <typename T>
+void MacroAssembler::branchValueIsNurseryCellImpl(Condition cond,
+                                                  const T& value, Register temp,
+                                                  Label* label) {
+  MOZ_ASSERT(cond == Assembler::Equal || cond == Assembler::NotEqual);
+  MOZ_ASSERT(temp != InvalidReg);
+  Label done;
+  branchTestGCThing(Assembler::NotEqual, value,
+                    cond == Assembler::Equal ? &done : label);
+
+  unboxGCThingForGCBarrier(value, temp);
+  andPtr(Imm32(int32_t(~gc::ChunkMask)), temp);
+  loadPtr(Address(temp, gc::ChunkStoreBufferOffset), temp);
+  branchPtr(cond == Assembler::Equal ? Assembler::NotEqual : Assembler::Equal,
+            temp, ImmWord(0), label);
+
+  bind(&done);
+}
+
+void MacroAssembler::branchTestValue(Condition cond, const ValueOperand& lhs,
+                                     const Value& rhs, Label* label) {
+  MOZ_ASSERT(cond == Equal || cond == NotEqual);
+  if (!rhs.isGCThing()) {
+    branchPtr(cond, lhs.valueReg(), ImmWord(rhs.asRawBits()), label);
+    return;
+  }
+  MOZ_ASSERT(lhs.valueReg() != SecondScratchReg);
+  moveValue(rhs, ValueOperand(SecondScratchReg));
+  branchPtr(cond, lhs.valueReg(), SecondScratchReg, label);
+}
+
+void MacroAssembler::shiftIndex32AndAdd(Register indexTemp32, int shift,
+                                        Register pointer) {
+  if (IsShiftInScaleRange(shift)) {
+    computeEffectiveAddress(
+        BaseIndex(pointer, indexTemp32, ShiftToScale(shift)), pointer);
+    return;
+  }
+  lshift32(Imm32(shift), indexTemp32);
+  addPtr(indexTemp32, pointer);
+}
+
+// ===========================================================================
+// MacroAssembler: operations that still need encodings.
+//
+// Integer divide is a software sequence on IA-64 and every floating-point
+// operation needs the F-unit encodings; SupportsFloatingPoint() returns false,
+// so the floating-point paths should not be reachable.
+
+void MacroAssembler::flexibleDivMod32(Register lhs, Register rhs,
+                                      Register divOutput, Register remOutput,
+                                      bool isUnsigned, const LiveRegisterSet&) {
+  ma_divmod(divOutput, remOutput, lhs, rhs, isUnsigned, 32);
+}
+
+void MacroAssembler::flexibleQuotient32(Register lhs, Register rhs,
+                                        Register dest, bool isUnsigned,
+                                        const LiveRegisterSet&) {
+  ma_divmod(dest, InvalidReg, lhs, rhs, isUnsigned, 32);
+}
+
+void MacroAssembler::flexibleRemainder32(Register lhs, Register rhs,
+                                         Register dest, bool isUnsigned,
+                                         const LiveRegisterSet&) {
+  ma_divmod(InvalidReg, dest, lhs, rhs, isUnsigned, 32);
+}
+
+CodeOffset MacroAssembler::move32WithPatch(Register dest) {
+  CodeOffset offset(currentOffset());
+  emitMovl(dest.encoding(), 0);
+  return offset;
+}
+
+void MacroAssembler::patchMove32(CodeOffset offset, Imm32 n) {
+  WriteMovlImm(
+      reinterpret_cast<uint8_t*>(bundleAt(BufferOffset(offset.offset()))),
+      uint64_t(uint32_t(n.value)));
+}
+
+CodeOffset MacroAssembler::sub32FromMemAndBranchIfNegativeWithPatch(
+    Address address, Label* label) {
+  computeAddress(address, SecondScratchReg);
+  emitM(ia64::Ld4(ScratchReg.encoding(), SecondScratchReg.encoding()));
+  // The "adds" below carries the immediate; it is emitted as a no-op add and
+  // rewritten by patchSub32FromMemAndBranchIfNegative().
+  CodeOffset patchPoint(currentOffset());
+  emitM(ia64::Adds(ScratchReg.encoding(), 0, ScratchReg.encoding()));
+  emitM(ia64::St4(SecondScratchReg.encoding(), ScratchReg.encoding()));
+  emitI(ia64::Sxt4(ScratchReg.encoding(), ScratchReg.encoding()));
+  emitI(ia64::CmpLt(kP, kQ, ScratchReg.encoding(), Registers::zero));
+  emitBranchToLabel(&ia64::BrCondRel, kP, label);
+  return patchPoint;
+}
+
+void MacroAssembler::patchSub32FromMemAndBranchIfNegative(CodeOffset offset,
+                                                          Imm32 imm) {
+  MOZ_RELEASE_ASSERT(imm.value >= 1 && imm.value <= 127);
+  WriteAddsImm14(bundleAt(BufferOffset(offset.offset())), -int64_t(imm.value));
+}
