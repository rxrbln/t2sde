+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#include "jit/ia64/Architecture-ia64.h"
+
+#include "jit/RegisterSets.h"
+
+namespace js {
+namespace jit {
+
+// Singles and doubles share one architectural register on ia64, so a set that
+// mentions both kinds of the same register only needs one slot pushed.
+TypedRegisterSet<FloatRegister> FloatRegister::ReduceSetForPush(
+    const TypedRegisterSet<FloatRegister>& s) {
+  SetType bits = s.bits();
+  return TypedRegisterSet<FloatRegister>(bits);
+}
+
+uint32_t FloatRegister::GetPushSizeInBytes(
+    const TypedRegisterSet<FloatRegister>& s) {
+  // Spill slots are uniformly 8 bytes; ia64's 82-bit extended format is only
+  // used inside the register file, values in memory are IEEE doubles.
+  return s.size() * sizeof(double);
+}
+
+uint32_t FloatRegister::getRegisterDumpOffsetInBytes() {
+  return code_ * sizeof(double);
+}
+
+}  // namespace jit
+}  // namespace js
