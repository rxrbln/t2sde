diff -aurpN -x '*.orig' -x '*.rej' -x __pycache__ -x '*.pyc' -x .deps /tmp/claude-0/-srv-t2-src-firefox-ia64-desktop-260731-192730-583159/2ec03345-b130-4ed1-a35a-8809b1a7caca/scratchpad/refjit/firefox-153.0.1/js/src/jit/FlushICache.h /srv/t2/src-firefox.ia64-desktop.260731.192730.583159/firefox-153.0.1/js/src/jit/FlushICache.h
--- firefox-153.0.1/js/src/jit/FlushICache.h.vanilla
+++ firefox-153.0.1/js/src/jit/FlushICache.h
@@ -29,6 +29,35 @@ inline void FlushICache(void* code, size
 // `FlushExecutionContext` below.
 extern void FlushICache(void* code, size_t size);
 
+#elif defined(JS_CODEGEN_IA64)
+
+// IA-64 caches are not coherent with the instruction stream, and newly written
+// instructions are not visible to the fetch engine until the line is flushed
+// and the fetch stream serialised.
+//
+// Do NOT use __builtin___clear_cache here: on ia64 GCC expands it to nothing at
+// all (verified: the function body is just nop.m/nop.i/br.ret), so it silently
+// leaves stale lines in the instruction cache. That is invisible under qemu,
+// which invalidates its translation blocks whenever a page holding translated
+// code is written, but on real hardware it faults with an Illegal Operation on
+// whatever stale bytes the fetch engine still holds.
+//
+// The architected sequence is: flush each line of the range, then sync.i to
+// make the flushes visible to the fetch engine, then srlz.i to serialise it.
+// 32 bytes is the smallest instruction-cache line on any Itanium, so stepping
+// by 32 is always safe (at worst it flushes a line more than once).
+inline void FlushICache(void* code, size_t size) {
+  if (size == 0) {
+    return;
+  }
+  uintptr_t start = reinterpret_cast<uintptr_t>(code) & ~uintptr_t(31);
+  uintptr_t end = reinterpret_cast<uintptr_t>(code) + size;
+  for (uintptr_t addr = start; addr < end; addr += 32) {
+    asm volatile("fc %0" ::"r"(addr) : "memory");
+  }
+  asm volatile(";;\n\tsync.i\n\t;;\n\tsrlz.i\n\t;;" ::: "memory");
+}
+
 #elif defined(JS_CODEGEN_NONE) || defined(JS_CODEGEN_WASM32)
 
 inline void FlushICache(void* code, size_t size) { MOZ_CRASH(); }
@@ -80,6 +109,14 @@ extern bool CanFlushExecutionContextForA
 // else this will crash.
 extern void FlushExecutionContextForAllThreads();
 
+#elif defined(JS_CODEGEN_IA64)
+
+// FlushICache already serialises the issuing core via srlz.i, and ia64 offers
+// no syscall to do so for other threads.
+inline void FlushExecutionContext() {}
+inline bool CanFlushExecutionContextForAllThreads() { return false; }
+inline void FlushExecutionContextForAllThreads() { MOZ_CRASH(); }
+
 #else
 #  error "Unknown architecture!"
 #endif
diff -aurpN -x '*.orig' -x '*.rej' -x __pycache__ -x '*.pyc' -x .deps /tmp/claude-0/-srv-t2-src-firefox-ia64-desktop-260731-192730-583159/2ec03345-b130-4ed1-a35a-8809b1a7caca/scratchpad/refjit/firefox-153.0.1/js/src/jit/JitCommon.h /srv/t2/src-firefox.ia64-desktop.260731.192730.583159/firefox-153.0.1/js/src/jit/JitCommon.h
--- firefox-153.0.1/js/src/jit/JitCommon.h.vanilla
+++ firefox-153.0.1/js/src/jit/JitCommon.h
@@ -35,6 +35,45 @@
                                          3, intptr_t(p0), intptr_t(p1),        \
                                          intptr_t(p2)))
 
+#elif defined(JS_CODEGEN_IA64)
+
+// An ia64 function pointer is the address of a two-word {entry, gp}
+// descriptor, but generated code is just an entry point, so build a descriptor
+// for it. The gp handed over is this module's, which generated code only ever
+// overwrites: it loads gp from the descriptor of each C function it calls.
+namespace js {
+namespace jit {
+
+template <typename Fn, typename... Args>
+inline auto CallGeneratedIa64(void* entry, Args... args) {
+  struct Descriptor {
+    void* entry;
+    void* gp;
+  } desc;
+  desc.entry = entry;
+  __asm__ volatile("mov %0 = r1" : "=r"(desc.gp));
+  return reinterpret_cast<Fn>(&desc)(args...);
+}
+
+}  // namespace jit
+}  // namespace js
+
+#  define CALL_GENERATED_CODE(entry, p0, p1, p2, p3, p4, p5, p6, p7)     \
+    js::jit::CallGeneratedIa64<decltype(entry)>(                         \
+        JS_FUNC_TO_DATA_PTR(void*, entry), p0, p1, p2, p3, p4, p5, p6, p7)
+
+#  define CALL_GENERATED_0(entry) \
+    js::jit::CallGeneratedIa64<decltype(entry)>(JS_FUNC_TO_DATA_PTR(void*, entry))
+#  define CALL_GENERATED_1(entry, p0)            \
+    js::jit::CallGeneratedIa64<decltype(entry)>( \
+        JS_FUNC_TO_DATA_PTR(void*, entry), p0)
+#  define CALL_GENERATED_2(entry, p0, p1)        \
+    js::jit::CallGeneratedIa64<decltype(entry)>( \
+        JS_FUNC_TO_DATA_PTR(void*, entry), p0, p1)
+#  define CALL_GENERATED_3(entry, p0, p1, p2)    \
+    js::jit::CallGeneratedIa64<decltype(entry)>( \
+        JS_FUNC_TO_DATA_PTR(void*, entry), p0, p1, p2)
+
 #else
 
 // Call into jitted code by following the ABI of the native architecture.
