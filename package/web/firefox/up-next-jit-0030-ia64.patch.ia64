+  void computeEffectiveAddress(T, Register) {
+    MOZ_CRASH();
+  }
+
+  void splitTagForTest(const ValueOperand& value, ScratchTagScope& tag) {
+    emitTagOf(value, Register(tag));
+  }
+
+  void boxDouble(FloatRegister src, ValueOperand dest);
+  // The scratch FloatRegister argument is only used by architectures that
+  // lack a direct FR-to-GR transfer (none here; setf.d/getf.d do it in one
+  // instruction).
+  void boxDouble(FloatRegister src, ValueOperand dest, FloatRegister) {
+    boxDouble(src, dest);
+  }
