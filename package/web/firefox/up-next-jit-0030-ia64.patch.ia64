+
+#include "jit/ia64/MoveEmitter-ia64.h"
+
+#include "jit/MacroAssembler-inl.h"
+
+using namespace js;
+using namespace js::jit;
+
+// Memory-to-memory floating point moves need a staging register. Use the
+// canonical f6 scratch (ScratchDoubleReg/ScratchFloat32Reg from
+// Assembler-ia64.h) rather than f2-f5, which are reserved as internal
+// temporaries for the multi-step divide/sqrt/multiply sequences in
+// MacroAssembler-ia64.cpp.
+static constexpr FloatRegister Ia64ScratchDouble = ScratchDoubleReg;
+static constexpr FloatRegister Ia64ScratchFloat32 = ScratchFloat32Reg;
+
+void MoveEmitterIa64::breakCycle(const MoveOperand& from, const MoveOperand& to,
+                                 MoveOp::Type type, uint32_t slotId) {
+  // There is some pattern:
+  //   (A -> B)
+  //   (B -> A)
+  //
+  // This case handles (A -> B), which we reach first. We save B, then allow
+  // the original move to continue.
+  switch (type) {
+    case MoveOp::FLOAT32:
+      if (to.isMemory()) {
+        masm.loadFloat32(getAdjustedAddress(to), Ia64ScratchFloat32);
+        masm.storeFloat32(Ia64ScratchFloat32, cycleSlot(slotId));
+      } else {
+        masm.storeFloat32(to.floatReg(), cycleSlot(slotId));
+      }
+      break;
+    case MoveOp::DOUBLE:
+      if (to.isMemory()) {
+        masm.loadDouble(getAdjustedAddress(to), Ia64ScratchDouble);
+        masm.storeDouble(Ia64ScratchDouble, cycleSlot(slotId));
+      } else {
+        masm.storeDouble(to.floatReg(), cycleSlot(slotId));
+      }
+      break;
+    case MoveOp::INT32:
+      if (to.isMemory()) {
+        SecondScratchRegisterScope temp(masm);
+      Register scratch2 = temp;
+        masm.load32(getAdjustedAddress(to), scratch2);
+        masm.store32(scratch2, cycleSlot(0));
+      } else {
+        masm.store32(to.reg(), cycleSlot(0));
+      }
+      break;
+    case MoveOp::GENERAL:
+      if (to.isMemory()) {
+        SecondScratchRegisterScope temp(masm);
+      Register scratch2 = temp;
+        masm.loadPtr(getAdjustedAddress(to), scratch2);
+        masm.storePtr(scratch2, cycleSlot(0));
+      } else {
+        masm.storePtr(to.reg(), cycleSlot(0));
+      }
+      break;
+    default:
+      MOZ_CRASH("Unexpected move type");
+  }
+}
+
+void MoveEmitterIa64::completeCycle(const MoveOperand& from,
+                                    const MoveOperand& to, MoveOp::Type type,
+                                    uint32_t slotId) {
+  // This case handles (B -> A), which we reach last. We emit a move from the
+  // saved value of B, to A.
+  switch (type) {
+    case MoveOp::FLOAT32:
+      if (to.isMemory()) {
+        masm.loadFloat32(cycleSlot(slotId), Ia64ScratchFloat32);
+        masm.storeFloat32(Ia64ScratchFloat32, getAdjustedAddress(to));
+      } else {
+        masm.loadFloat32(cycleSlot(slotId), to.floatReg());
+      }
+      break;
+    case MoveOp::DOUBLE:
+      if (to.isMemory()) {
+        masm.loadDouble(cycleSlot(slotId), Ia64ScratchDouble);
+        masm.storeDouble(Ia64ScratchDouble, getAdjustedAddress(to));
+      } else {
+        masm.loadDouble(cycleSlot(slotId), to.floatReg());
+      }
+      break;
+    case MoveOp::INT32:
+      MOZ_ASSERT(slotId == 0);
+      if (to.isMemory()) {
+        SecondScratchRegisterScope temp(masm);
+      Register scratch2 = temp;
+        masm.load32(cycleSlot(0), scratch2);
+        masm.store32(scratch2, getAdjustedAddress(to));
+      } else {
+        masm.load32(cycleSlot(0), to.reg());
+      }
+      break;
+    case MoveOp::GENERAL:
+      MOZ_ASSERT(slotId == 0);
+      if (to.isMemory()) {
+        SecondScratchRegisterScope temp(masm);
+      Register scratch2 = temp;
+        masm.loadPtr(cycleSlot(0), scratch2);
+        masm.storePtr(scratch2, getAdjustedAddress(to));
+      } else {
+        masm.loadPtr(cycleSlot(0), to.reg());
+      }
+      break;
+    default:
+      MOZ_CRASH("Unexpected move type");
+  }
+}
+
+void MoveEmitterIa64::emit(const MoveResolver& moves) {
+  if (moves.numCycles()) {
+    masm.reserveStack(moves.numCycles() * sizeof(double));
+    pushedAtCycle_ = masm.framePushed();
+  }
+
+  for (size_t i = 0; i < moves.numMoves(); i++) {
+    emit(moves.getMove(i));
+  }
+}
+
+void MoveEmitterIa64::emit(const MoveOp& move) {
+  const MoveOperand& from = move.from();
+  const MoveOperand& to = move.to();
+
+  if (move.isCycleEnd() && move.isCycleBegin()) {
+    // A cycle can end exactly where another begins.
+    breakCycle(from, to, move.endCycleType(), move.cycleBeginSlot());
+    completeCycle(from, to, move.type(), move.cycleEndSlot());
+    return;
+  }
+
+  if (move.isCycleEnd()) {
+    MOZ_ASSERT(inCycle_);
+    completeCycle(from, to, move.type(), move.cycleEndSlot());
+    MOZ_ASSERT(inCycle_ > 0);
+    inCycle_--;
+    return;
+  }
+
+  if (move.isCycleBegin()) {
+    breakCycle(from, to, move.endCycleType(), move.cycleBeginSlot());
+    inCycle_++;
+  }
+
+  switch (move.type()) {
+    case MoveOp::FLOAT32:
+      emitFloat32Move(from, to);
+      break;
+    case MoveOp::DOUBLE:
+      emitDoubleMove(from, to);
+      break;
+    case MoveOp::INT32:
+      emitInt32Move(from, to);
+      break;
+    case MoveOp::GENERAL:
+      emitMove(from, to);
+      break;
+    default:
+      MOZ_CRASH("Unexpected move type");
+  }
+}
+
+void MoveEmitterIa64::emitMove(const MoveOperand& from, const MoveOperand& to) {
+  if (from.isGeneralReg()) {
+    if (to.isGeneralReg()) {
+      masm.movePtr(from.reg(), to.reg());
+    } else if (to.isMemory()) {
+      masm.storePtr(from.reg(), getAdjustedAddress(to));
+    } else {
+      MOZ_CRASH("Invalid emitMove arguments.");
+    }
+  } else if (from.isMemory()) {
+    if (to.isGeneralReg()) {
+      masm.loadPtr(getAdjustedAddress(from), to.reg());
+    } else if (to.isMemory()) {
+      SecondScratchRegisterScope temp(masm);
+      Register scratch2 = temp;
+      masm.loadPtr(getAdjustedAddress(from), scratch2);
+      masm.storePtr(scratch2, getAdjustedAddress(to));
+    } else {
+      MOZ_CRASH("Invalid emitMove arguments.");
+    }
+  } else if (from.isEffectiveAddress()) {
+    if (to.isGeneralReg()) {
+      masm.computeEffectiveAddress(getAdjustedAddress(from), to.reg());
+    } else if (to.isMemory()) {
+      SecondScratchRegisterScope temp(masm);
+      Register scratch2 = temp;
+      masm.computeEffectiveAddress(getAdjustedAddress(from), scratch2);
+      masm.storePtr(scratch2, getAdjustedAddress(to));
+    } else {
+      MOZ_CRASH("Invalid emitMove arguments.");
+    }
+  } else {
+    MOZ_CRASH("Invalid emitMove arguments.");
+  }
+}
+
+void MoveEmitterIa64::emitInt32Move(const MoveOperand& from,
+                                    const MoveOperand& to) {
+  if (from.isGeneralReg()) {
+    if (to.isGeneralReg()) {
+      masm.move32(from.reg(), to.reg());
+    } else if (to.isMemory()) {
+      masm.store32(from.reg(), getAdjustedAddress(to));
+    } else {
+      MOZ_CRASH("Invalid emitInt32Move arguments.");
+    }
+  } else if (from.isMemory()) {
+    if (to.isGeneralReg()) {
+      masm.load32(getAdjustedAddress(from), to.reg());
+    } else if (to.isMemory()) {
+      SecondScratchRegisterScope temp(masm);
+      Register scratch2 = temp;
+      masm.load32(getAdjustedAddress(from), scratch2);
+      masm.store32(scratch2, getAdjustedAddress(to));
+    } else {
+      MOZ_CRASH("Invalid emitInt32Move arguments.");
+    }
+  } else if (from.isEffectiveAddress()) {
+    if (to.isGeneralReg()) {
+      masm.computeEffectiveAddress(getAdjustedAddress(from), to.reg());
+    } else if (to.isMemory()) {
+      SecondScratchRegisterScope temp(masm);
+      Register scratch2 = temp;
+      masm.computeEffectiveAddress(getAdjustedAddress(from), scratch2);
+      masm.store32(scratch2, getAdjustedAddress(to));
+    } else {
+      MOZ_CRASH("Invalid emitInt32Move arguments.");
+    }
+  } else {
+    MOZ_CRASH("Invalid emitInt32Move arguments.");
+  }
+}
+
+// The IA-64 psABI passes floating point arguments in f8-f15 and integers in the
+// r32-r39 window, so a float never has to be shuffled into a general register
+// the way it does on the soft-float and register-pair ABIs.
+
+void MoveEmitterIa64::emitFloat32Move(const MoveOperand& from,
+                                      const MoveOperand& to) {
+  if (from.isFloatReg()) {
+    if (to.isFloatReg()) {
+      masm.moveFloat32(from.floatReg(), to.floatReg());
+    } else {
+      MOZ_ASSERT(to.isMemory());
+      masm.storeFloat32(from.floatReg(), getAdjustedAddress(to));
+    }
+  } else if (to.isFloatReg()) {
+    MOZ_ASSERT(from.isMemory());
+    masm.loadFloat32(getAdjustedAddress(from), to.floatReg());
+  } else {
+    MOZ_ASSERT(from.isMemory());
+    MOZ_ASSERT(to.isMemory());
+    masm.loadFloat32(getAdjustedAddress(from), Ia64ScratchFloat32);
+    masm.storeFloat32(Ia64ScratchFloat32, getAdjustedAddress(to));
+  }
+}
+
+void MoveEmitterIa64::emitDoubleMove(const MoveOperand& from,
+                                     const MoveOperand& to) {
+  if (from.isFloatReg()) {
+    if (to.isFloatReg()) {
+      masm.moveDouble(from.floatReg(), to.floatReg());
+    } else {
+      MOZ_ASSERT(to.isMemory());
+      masm.storeDouble(from.floatReg(), getAdjustedAddress(to));
+    }
+  } else if (to.isFloatReg()) {
+    MOZ_ASSERT(from.isMemory());
+    masm.loadDouble(getAdjustedAddress(from), to.floatReg());
+  } else {
+    MOZ_ASSERT(from.isMemory());
+    MOZ_ASSERT(to.isMemory());
+    masm.loadDouble(getAdjustedAddress(from), Ia64ScratchDouble);
+    masm.storeDouble(Ia64ScratchDouble, getAdjustedAddress(to));
+  }
+}
+
+Address MoveEmitterIa64::cycleSlot(uint32_t slot, uint32_t subslot) const {
+  int32_t offset = masm.framePushed() - pushedAtCycle_;
+  return Address(StackPointer, offset + slot * sizeof(double) + subslot);
+}
+
+int32_t MoveEmitterIa64::getAdjustedOffset(const MoveOperand& operand) {
+  MOZ_ASSERT(operand.isMemoryOrEffectiveAddress());
+  if (operand.base() != StackPointer) {
+    return operand.disp();
+  }
+
+  // Adjust the offset if the stack pointer has moved since construction.
+  return operand.disp() + masm.framePushed() - pushedAtStart_;
+}
+
+Address MoveEmitterIa64::getAdjustedAddress(const MoveOperand& operand) {
+  return Address(operand.base(), getAdjustedOffset(operand));
+}
+
+void MoveEmitterIa64::assertDone() { MOZ_ASSERT(inCycle_ == 0); }
+
+void MoveEmitterIa64::finish() {
+  assertDone();
+
+  masm.freeStack(masm.framePushed() - pushedAtStart_);
+}
diff --git a/b/js/src/jit/ia64/MoveEmitter-ia64.h b/js/src/jit/ia64/MoveEmitter-ia64.h
new file mode 100644
--- /dev/null
+++ b/js/src/jit/ia64/MoveEmitter-ia64.h
@@ -0,0 +1,68 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#ifndef jit_ia64_MoveEmitter_ia64_h
+#define jit_ia64_MoveEmitter_ia64_h
+
+#include "jit/MacroAssembler.h"
+#include "jit/MoveResolver.h"
+
+namespace js {
+namespace jit {
+
+class MoveEmitterIa64 {
+  void emitDoubleMove(const MoveOperand& from, const MoveOperand& to);
+  void breakCycle(const MoveOperand& from, const MoveOperand& to,
+                  MoveOp::Type type, uint32_t slot);
+  void completeCycle(const MoveOperand& from, const MoveOperand& to,
+                     MoveOp::Type type, uint32_t slot);
+
+ protected:
+  uint32_t inCycle_;
+  MacroAssembler& masm;
+
+  // Stack depth at construction, used to rebase sp-relative operands after
+  // stack space has been reserved for cycle temporaries.
+  uint32_t pushedAtStart_;
+
+  // Stack depth at which the cycle spill slots were allocated, or -1 if no
+  // cycle slots were needed.
+  int32_t pushedAtCycle_;
+
+  void assertDone();
+  Address cycleSlot(uint32_t slot, uint32_t subslot = 0) const;
+  int32_t getAdjustedOffset(const MoveOperand& operand);
+  Address getAdjustedAddress(const MoveOperand& operand);
+
+  void emitMove(const MoveOperand& from, const MoveOperand& to);
+  void emitInt32Move(const MoveOperand& from, const MoveOperand& to);
+  void emitFloat32Move(const MoveOperand& from, const MoveOperand& to);
+  void emit(const MoveOp& move);
+
+ public:
+  explicit MoveEmitterIa64(MacroAssembler& masm)
+      : inCycle_(0),
+        masm(masm),
+        pushedAtStart_(masm.framePushed()),
+        pushedAtCycle_(-1) {}
+
+  ~MoveEmitterIa64() { assertDone(); }
+
+  void emit(const MoveResolver& moves);
+  void finish();
+
+  // Part of the cross-architecture MoveEmitter interface; ia64 always takes its
+  // temporary from the reserved assembler scratch registers, so there is
+  // nothing to configure.
+  void setScratchRegister(Register reg) {}
+};
+
+using MoveEmitter = MoveEmitterIa64;
+
+}  // namespace jit
+}  // namespace js
+
+#endif /* jit_ia64_MoveEmitter_ia64_h */
diff --git a/b/js/src/jit/ia64/Pipeliner-ia64.h b/js/src/jit/ia64/Pipeliner-ia64.h
new file mode 100644
--- /dev/null
+++ b/js/src/jit/ia64/Pipeliner-ia64.h
@@ -0,0 +1,1676 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef jit_ia64_Pipeliner_ia64_h
+#define jit_ia64_Pipeliner_ia64_h
+
+#include "mozilla/Assertions.h"
+
+#include <stdint.h>
+#include <string.h>
+
+#include "jit/ia64/AssemblerCore-ia64.h"
+
+// [SMDOC] IA-64 software pipelining
+//
+// An innermost Ion loop is emitted as usual -- the *plain copy*, with all its
+// labels, bailouts and out-of-line paths -- while the assembler records one
+// iteration's instructions.  This file plans a modulo-scheduled *kernel* for
+// those instructions; Assembler-ia64.h emits it in front of the plain copy.
+//
+// Exits.  Every branch of the iteration other than the back edge (guards, the
+// loop test, the interrupt check) and every chk.a of a speculated load is an
+// exit.  An exit taken in the kernel goes to a stub that puts the header
+// values of its iteration into the plain copy's registers and jumps to the
+// plain copy's header; the plain copy then runs that iteration again and
+// meets the guard, the loop exit or the interrupt itself.  That is correct
+// only if, when iteration k leaves:
+//   * every older iteration is complete: each instruction of an iteration
+//     issues before the next iteration's first exit;
+//   * iteration k has done nothing visible: its stores follow all of its
+//     exits (so do the younger iterations', which follow k's exits);
+//   * the registers the plain copy reads at its header hold their values at
+//     the start of iteration k: the last write to each register in the
+//     iteration (scratch registers aside) stays readable until the next
+//     iteration's last exit, and the stub copies it back.
+//
+// Speculation.  Loads (other than from the stack frame) become ld.sa: they may
+// run above the exits that guard them (a failed speculative load defers) and
+// above stores they might alias (the ALAT records the address, a store to it
+// clears the entry).  A chk.a.clr at the load's place in program order, an
+// exit like the others, catches both; compares, stores and branches fed by
+// the load wait for it, since a NaT compare clears both its predicates.
+// Linux clears the ALAT on every kernel entry, so a check fails now and then
+// for nothing: the iteration simply runs in the plain copy
+// (results/spec-probe-montecito.md).
+//
+// Schedule.  Iterative modulo scheduling (Rau) from MII = max(resMII, recMII),
+// in height order and in earliest-start order, the better kept.  A kernel
+// cycle is accepted only if its instructions fit one bundle, or two that
+// issue together, under Montecito's dispersal rules
+// (results/disp-probe-montecito.md).  The model this was sized with is
+// tools/loop-report/src/modulo.rs (results/pipelining-model.md).
+//
+// Registers.  Every value written in the loop gets a block of rotating
+// registers, one per kernel boundary its lifetime crosses plus one, from
+// r32/f32/p(16 + stages) up; the stage predicates are p16 up.  Static
+// registers are only read in the kernel.
+
+namespace js {
+namespace jit {
+namespace ia64 {
+
+class Pipeliner {
+ public:
+  static const size_t MaxOps = 192;
+  // Including the checks of speculated loads.
+  static const size_t MaxNodes = 2 * MaxOps;
+  static const size_t MaxEdges = 8192;
+  static const int MaxII = 64;
+  static const int MaxStages = 8;
+
+  // Rotating registers available: r32-r127 (the frame's outgoing registers
+  // are not live in a loop without calls), f32-f127, p16-p63.
+  static const int RotGr = 96;
+  static const int RotFr = 96;
+  static const int RotPr = 48;
+
+  // Gate: a virtual node, no slot, never emitted (see buildEdges()).
+  enum class Kind : uint8_t { Plain, Exit, Check, Gate };
+
+  struct Node {
+    Op op;
+    Kind kind;
+    // Exit: the assembler's id for the branch; Check: the load it checks.
+    uint32_t ref;
+    int cycle;      // issue cycle in the flat schedule
+  };
+
+  // A value: the result of one def of one node.
+  struct Value {
+    uint16_t node;
+    uint8_t def;      // index into the node's defs
+    uint8_t cls;      // 0 general, 1 FP, 2 predicate
+    int16_t base;     // rotating register (within the class's region)
+    int16_t count;    // registers in its block
+    int16_t pad;      // registers below base for initial values in transit
+    int last;         // last cycle it must stay readable
+    bool restore;     // the plain copy reads it at the header
+  };
+
+  // Data speculation: loads above stores they may alias, as ld.sa checked
+  // by chk.a.  Without it loads stay after those stores and only move above
+  // exits, as ld.s checked by chk.s.
+  void setAdvanced(bool on) { advanced_ = on; }
+
+  int ii() const { return ii_; }
+  int stages() const { return stages_; }
+  int resMII() const { return resMII_; }
+  int recMII() const { return recMII_; }
+  const char* why() const { return why_; }
+  // Loads proven apart from every store, and loads left to the ALAT.
+  int provenLoads() const { return nProven_; }
+  int advancedLoads() const { return nAdvanced_; }
+
+  // Plans a kernel for |n| recorded instructions, |exitId[i]| nonzero for an
+  // exit branch.  Returns false, with why(), if the loop is not pipelined.
+  bool plan(const Op* ops, const uint32_t* exitId, size_t n) {
+    n_ = 0;
+    nEdges_ = 0;
+    why_ = nullptr;
+    if (n > MaxOps) {
+      return fail("too many instructions");
+    }
+    for (size_t i = 0; i < n; i++) {
+      if (!admit(ops[i], exitId[i] != 0)) {
+        return false;
+      }
+      Node& nd = nodes_[n_++];
+      nd.op = ops[i];
+      nd.kind = exitId[i] ? Kind::Exit : Kind::Plain;
+      nd.ref = exitId[i];
+      nd.cycle = -1;
+    }
+    if (!addChecks() || !buildEdges()) {
+      return false;
+    }
+    if (!bounds()) {
+      return false;
+    }
+    for (int ii = mii_; ii <= MaxII && ii <= acyclic_ - 2; ii++) {
+      for (int order = 0; order < 2; order++) {
+        if (!schedule(ii, order == 1)) {
+          continue;
+        }
+        if (allocate()) {
+          return true;
+        }
+      }
+    }
+    return fail(why_ ? why_ : "no schedule shorter than the loop as is");
+  }
+
+  // ---- accessors for the emitter -----------------------------------------
+  size_t numNodes() const { return n_; }
+  const Node& node(size_t i) const { return nodes_[i]; }
+  size_t numValues() const { return nValues_; }
+  const Value& value(size_t i) const { return values_[i]; }
+
+ private:
+  struct Edge {
+    uint16_t from, to;
+    int16_t lat;
+    uint8_t dist;
+  };
+
+  bool fail(const char* why) {
+    if (!why_) {
+      why_ = why;
+    }
+    return false;
+  }
+
+  static int ClassOf(uint16_t r) {
+    switch (r >> 8) {
+      case ResGr: return 0;
+      case ResFr: return 1;
+      case ResPr: return 2;
+      default: return -1;
+    }
+  }
+
+  static bool IsLoad(const Op& op) {
+    if (!(op.flags & OpMemory)) {
+      return false;
+    }
+    for (uint32_t d = 0; d < op.nDef; d++) {
+      int c = ClassOf(op.def[d]);
+      if (c == 0 || c == 1) {
+        return true;
+      }
+    }
+    return false;
+  }
+  static bool IsStore(const Op& op) { return (op.flags & OpMemory) && !IsLoad(op); }
+
+  // The address register of a load or store: its r3 field.
+  static int AddressReg(const Op& op) {
+    for (uint32_t u = 0; u < op.nUse; u++) {
+      if (op.usePos[u] == 20 && (op.use[u] >> 8) == ResGr) {
+        return op.use[u] & 0xff;
+      }
+    }
+    return -1;
+  }
+  static bool FrameAccess(const Op& op) {
+    int a = AddressReg(op);
+    return a == 12 || a == 4;
+  }
+
+  // What the kernel can hold: OpSched instructions whose registers are all
+  // in renamable fields, and exit branches.
+  bool admit(const Op& op, bool exit) {
+    if (exit) {
+      return (op.flags & OpBranch) ? true : fail("exit is not a branch");
+    }
+    if (!(op.flags & OpSched)) {
+      return fail("an instruction that cannot move");
+    }
+    if (op.unit == UnitLX) {
+      return true;  // movl: r1 at bit 6 in the X slot
+    }
+    for (uint32_t d = 0; d < op.nDef; d++) {
+      if (ClassOf(op.def[d]) < 0 || op.defPos[d] >= 64) {
+        return fail("a def without a field");
+      }
+      uint32_t r = op.def[d] & 0xff;
+      if (ClassOf(op.def[d]) == 0 && (r == 1 || r == 4 || r == 12 || r == 13)) {
+        return fail("writes gp, the frame pointer, sp or tp");
+      }
+      for (uint32_t u = 0; u < op.nUse; u++) {
+        if (op.usePos[u] == op.defPos[d] && ClassOf(op.use[u]) >= 0) {
+          return fail("a post-increment");
+        }
+      }
+    }
+    for (uint32_t u = 0; u < op.nUse; u++) {
+      if (ClassOf(op.use[u]) < 0) {
+        return fail("an implicit use");
+      }
+      if (op.usePos[u] == kFixedField) {
+        continue;  // renamed only if its producer is outside the loop
+      }
+      if (op.usePos[u] >= 64) {
+        return fail("a use without a field");
+      }
+    }
+    return true;
+  }
+
+  // A chk.a for each load that is not from the frame, at the load's place
+  // in program order.  Nodes are kept in program order: checks are inserted
+  // right after their load.
+  bool addChecks() {
+    size_t loads = 0;
+    for (size_t i = 0; i < n_; i++) {
+      loads += IsLoad(nodes_[i].op) && !FrameAccess(nodes_[i].op);
+    }
+    if (n_ + loads > MaxNodes) {
+      return fail("too many instructions");
+    }
+    for (size_t i = n_; i-- > 0;) {
+      if (!IsLoad(nodes_[i].op) || FrameAccess(nodes_[i].op)) {
+        continue;
+      }
+      memmove(&nodes_[i + 2], &nodes_[i + 1], (n_ - i - 1) * sizeof(Node));
+      Node& c = nodes_[i + 1];
+      c.op = Op{};
+      c.op.unit = UnitM;
+      c.op.flags = 0;
+      c.kind = Kind::Check;
+      c.ref = 0;  // set below, once positions are final
+      c.cycle = -1;
+      n_++;
+    }
+    // a load no store of the loop can alias is only control speculative
+    nProven_ = nAdvanced_ = 0;
+    for (size_t i = 0; i < n_; i++) {
+      if (nodes_[i].kind == Kind::Check) {
+        bool proven = noStoreAliases(i - 1);
+        nProven_ += proven;
+        nAdvanced_ += advanced_ && !proven;
+        nodes_[i].ref = uint32_t(i - 1) | (advanced_ && !proven ? 0 : kSpecCheck);
+      }
+    }
+    return true;
+  }
+
+  // ---- memory disambiguation ----------------------------------------------
+  //
+  // An address as base + (ext(index) << shift) + offset: |base| a loop
+  // invariant register, |index| the low 32 bits of a loop-carried register
+  // |iv| at the start of the iteration plus a constant, ext sxt4 or zxt4.
+  // Everything is exact modulo 2^32: an index that wraps is still told apart.
+  // An invariant address has no iv.
+  struct Affine {
+    uint16_t base;
+    uint16_t iv;  // kNoIv: an invariant address
+    uint8_t shift;
+    uint8_t ext;  // 1 sxt4, 2 zxt4
+    int64_t index;
+    int64_t offset;
+  };
+  static const uint16_t kNoIv = 0xffff;
+
+  // |op| is the instruction |tmpl| builds, whatever its register fields
+  // (r1, r2, r3, qp) and the bits in |also|.
+  static bool Is(const Op& op, const Op& tmpl, Insn also = 0) {
+    const Insn regs = (Insn(0x7f) << 6) | (Insn(0x7f) << 13) | (Insn(0x7f) << 20) | 0x3f | also;
+    return op.unit == tmpl.unit && (op.bits & ~regs) == (tmpl.bits & ~regs);
+  }
+  static int64_t AddsImm(const Op& op) {
+    int64_t v = int64_t((op.bits >> 13) & 0x7f) | (int64_t((op.bits >> 27) & 0x3f) << 7) |
+                (int64_t((op.bits >> 36) & 1) << 13);
+    return v & (1 << 13) ? v - (1 << 14) : v;
+  }
+  static uint32_t R1(const Op& op) { return uint32_t(op.bits >> 6) & 0x7f; }
+  static uint32_t R2(const Op& op) { return uint32_t(op.bits >> 13) & 0x7f; }
+  static uint32_t R3(const Op& op) { return uint32_t(op.bits >> 20) & 0x7f; }
+  static const Insn kImm14Bits = (Insn(0x7f) << 13) | (Insn(0x3f) << 27) | (Insn(1) << 36);
+
+  // The node writing |reg| for node |j| in this iteration, unpredicated; false
+  // for a value from before the iteration (|*carried|) or one it cannot use.
+  bool localProducer(size_t j, uint16_t reg, size_t* p, bool* carried) const {
+    int dist;
+    *carried = false;
+    if (!producer(j, reg, p, &dist)) {
+      return false;
+    }
+    if (dist != 0) {
+      *carried = true;
+      return false;
+    }
+    return !hasQp(*p);
+  }
+  // A constant with its low 32 bits clear (a NaN-box tag): dep.z imm8 at a
+  // position of 32 or more.
+  bool highConstant(size_t j, uint16_t reg) const {
+    size_t p;
+    bool carried;
+    if (!localProducer(j, reg, &p, &carried)) {
+      return false;
+    }
+    const Op& op = nodes_[p].op;
+    const Insn fields = (Insn(1) << 36) | (Insn(0x3f) << 27) | (Insn(0x3f) << 20) | (Insn(0x7f) << 13);
+    if (!Is(op, DepZImm(0, 0, 0, 1), fields)) {
+      return false;
+    }
+    uint32_t pos = 63 - (uint32_t(op.bits >> 20) & 0x3f);
+    return pos >= 32;
+  }
+  // The low 32 bits of |reg| as node |j| reads it: low32(*iv at the start of
+  // the iteration) + *add; with |full|, all 64 bits (adds and moves only).
+  bool low32(size_t j, uint16_t reg, uint16_t* iv, int64_t* add, bool full = false,
+             int depth = 0) const {
+    size_t p;
+    bool carried;
+    if (depth > 16 || ClassOf(reg) != 0) {
+      return false;
+    }
+    if (!localProducer(j, reg, &p, &carried)) {
+      if (carried) {
+        *iv = reg;
+        *add = 0;
+        return true;
+      }
+      return false;
+    }
+    const Op& op = nodes_[p].op;
+    if (Is(op, Adds(0, 0, 0), kImm14Bits)) {
+      if (!low32(p, Rsrc(ResGr, R3(op)), iv, add, full, depth + 1)) {
+        return false;
+      }
+      *add += AddsImm(op);
+      return true;
+    }
+    if (!full && (Is(op, Sxt4(0, 0)) || Is(op, Zxt4(0, 0)))) {
+      return low32(p, Rsrc(ResGr, R3(op)), iv, add, full, depth + 1);
+    }
+    if (Is(op, Add(0, 0, 0)) || Is(op, Or(0, 0, 0))) {
+      // a move (r0 + x) or a tag or-ed above the low 32 bits
+      uint16_t a = Rsrc(ResGr, R2(op)), b = Rsrc(ResGr, R3(op));
+      bool isOr = !full && Is(op, Or(0, 0, 0));
+      if (R2(op) == 0 || (isOr && highConstant(p, a))) {
+        return low32(p, b, iv, add, full, depth + 1);
+      }
+      if (R3(op) == 0 || (isOr && highConstant(p, b))) {
+        return low32(p, a, iv, add, full, depth + 1);
+      }
+    }
+    return false;
+  }
+  // How much (the low 32 bits of) loop-carried |iv| grows per iteration.
+  bool ivStep(uint16_t iv, bool full, int64_t* step) const {
+    uint16_t from;
+    size_t p;
+    int dist;
+    if (!producer(n_, iv, &p, &dist)) {
+      return false;
+    }
+    return low32(n_, iv, &from, step, full) && from == iv;
+  }
+  bool affine(size_t j, Affine* a) const {
+    int reg = AddressReg(nodes_[j].op);
+    if (reg < 0) {
+      return false;
+    }
+    uint16_t r = Rsrc(ResGr, uint32_t(reg));
+    a->offset = 0;
+    for (int depth = 0; depth < 8; depth++) {
+      size_t p;
+      bool carried;
+      if (!localProducer(j, r, &p, &carried)) {
+        if (carried) {
+          return false;  // a pointer carried around the loop
+        }
+        *a = Affine{r, kNoIv, 0, 0, 0, a->offset};
+        return true;
+      }
+      const Op& op = nodes_[p].op;
+      if (Is(op, Adds(0, 0, 0), kImm14Bits)) {
+        a->offset += AddsImm(op);
+        r = Rsrc(ResGr, R3(op));
+        j = p;
+        continue;
+      }
+      // shladd r1 = r2, count, r3: r3 the base, r2 an extended index
+      if (!Is(op, Shladd(0, 0, 1, 0), Insn(3) << 27)) {
+        return false;
+      }
+      size_t q;
+      uint16_t base = Rsrc(ResGr, R3(op)), idx = Rsrc(ResGr, R2(op));
+      if (localProducer(p, base, &q, &carried) || carried) {
+        return false;  // the base varies
+      }
+      if (!localProducer(p, idx, &q, &carried)) {
+        q = p;  // a raw 64-bit index straight from the iteration's start
+      }
+      const Op& ext = nodes_[q].op;
+      a->ext = Is(ext, Sxt4(0, 0)) ? 1 : Is(ext, Zxt4(0, 0)) ? 2 : 0;
+      if (a->ext ? !low32(q, Rsrc(ResGr, R3(ext)), &a->iv, &a->index)
+                 : !low32(p, idx, &a->iv, &a->index, true)) {
+        return false;
+      }
+      a->base = base;
+      a->shift = uint8_t(((op.bits >> 27) & 3) + 1);
+      return true;
+    }
+    return false;
+  }
+  // Bytes a load or store accesses; 16 when unsure.
+  static int AccessSize(const Op& op) {
+    uint32_t major = uint32_t(op.bits >> 37) & 0xf, x6 = uint32_t(op.bits >> 30) & 0x3f;
+    if ((op.bits >> 27) & 1) {
+      return 16;  // ld16, ldfp, ...
+    }
+    if (major == 4) {
+      return 1 << (x6 & 3);
+    }
+    if (major == 6 || major == 7) {
+      static const int fp[4] = {16, 8, 4, 8};  // ldfe/stfe, ldf8, ldfs, ldfd
+      return fp[x6 & 3];
+    }
+    return 16;
+  }
+  // No execution of store |s| overlaps load |l| of the same or a later
+  // iteration within the kernel's reach.
+  bool disjoint(size_t s, size_t l) const {
+    Affine as, al;
+    if (!affine(s, &as) || !affine(l, &al) || as.base != al.base || as.iv != al.iv) {
+      return false;
+    }
+    int64_t sizeS = AccessSize(nodes_[s].op), sizeL = AccessSize(nodes_[l].op);
+    auto overlaps = [&](int64_t d) { return -sizeL < d && d < sizeS; };
+    if (as.iv == kNoIv) {
+      return !overlaps(al.offset - as.offset);
+    }
+    int64_t step;
+    if (as.shift != al.shift || as.ext != al.ext || !ivStep(as.iv, as.ext == 0, &step) ||
+        step < -(1 << 20) || step > (1 << 20)) {
+      return false;
+    }
+    for (int d = s < l ? 0 : 1; d <= MaxStages; d++) {
+      // extended indexes differ by e or e - 2^32, a raw one by exactly e
+      int64_t exact = al.index + d * step - as.index;
+      uint64_t e = uint64_t(exact) & 0xffffffffu;
+      int64_t ms[2] = {int64_t(e), int64_t(e) - (int64_t(1) << 32)};
+      if (as.ext == 0) {
+        ms[0] = ms[1] = exact;
+      }
+      for (int64_t m : ms) {
+        if (overlaps(m * (int64_t(1) << as.shift) + al.offset - as.offset)) {
+          return false;
+        }
+      }
+    }
+    return true;
+  }
+  bool noStoreAliases(size_t l) const {
+    if (FrameAccess(nodes_[l].op)) {
+      return true;
+    }
+    for (size_t s = 0; s < n_; s++) {
+      if (nodes_[s].kind == Kind::Plain && IsStore(nodes_[s].op) && !FrameAccess(nodes_[s].op) &&
+          !disjoint(s, l)) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  static int Latency(const Op& a) {
+    bool defGr = false, defFr = false, useFr = false;
+    for (uint32_t i = 0; i < a.nDef; i++) {
+      defGr |= ClassOf(a.def[i]) == 0;
+      defFr |= ClassOf(a.def[i]) == 1;
+    }
+    for (uint32_t i = 0; i < a.nUse; i++) {
+      useFr |= ClassOf(a.use[i]) == 1;
+    }
+    if (a.unit == UnitF) {
+      return 4;
+    }
+    if (a.flags & OpMemory) {
+      return defFr ? 6 : 1;
+    }
+    if (a.unit == UnitM && defFr) {
+      return 6;  // setf
+    }
+    if (a.unit == UnitM && defGr && useFr) {
+      return 6;  // getf (5 measured in isolation; 6 in a kernel)
+    }
+    return 1;
+  }
+
+  bool edge(size_t from, size_t to, int lat, int dist) {
+    if (nEdges_ == MaxEdges) {
+      return fail("too many dependences");
+    }
+    // In one cycle the slot order is the program order, and a branch sits
+    // in the last bundle's B slots: what must follow an exit branch and is
+    // not a branch itself goes to a later cycle.
+    if (nodes_[from].kind == Kind::Exit && nodes_[to].kind != Kind::Exit && lat < 1) {
+      lat = 1;
+    }
+    // A check is an exit in an M slot: in its cycle, whatever sits in a later
+    // slot does not execute when it fires, and an older iteration's
+    // instruction can land there (an F or I slot after the M slots).  What
+    // must precede a check from another iteration goes to an earlier cycle.
+    if (nodes_[to].kind == Kind::Check && dist >= 1 && lat < 1) {
+      lat = 1;
+    }
+    edges_[nEdges_++] = Edge{uint16_t(from), uint16_t(to), int16_t(lat), uint8_t(dist)};
+    return true;
+  }
+
+  // The node and distance that produce |reg| for a use in node |j|, or false
+  // for a loop invariant.
+  bool producer(size_t j, uint16_t reg, size_t* p, int* dist) const {
+    for (size_t i = j; i-- > 0;) {
+      if (writes(i, reg)) {
+        *p = i;
+        *dist = 0;
+        return true;
+      }
+    }
+    for (size_t i = n_; i-- > j;) {
+      if (writes(i, reg)) {
+        *p = i;
+        *dist = 1;
+        return true;
+      }
+    }
+    return false;
+  }
+  bool writes(size_t i, uint16_t reg) const {
+    const Op& op = nodes_[i].op;
+    for (uint32_t d = 0; d < op.nDef; d++) {
+      if (op.def[d] == reg) {
+        return true;
+      }
+    }
+    return false;
+  }
+  // An instruction with a qp of its own (not a branch: there it is the
+  // condition).  It keeps it, renamed, in the kernel.
+  bool hasQp(size_t i) const {
+    return nodes_[i].kind == Kind::Plain && (nodes_[i].op.bits & 0x3f) != 0;
+  }
+  static bool IsCompare(const Op& op) {
+    uint32_t major = uint32_t(op.bits >> 37) & 0xf;
+    return (op.unit == UnitA && major >= 0xc && major <= 0xe) ||
+           (op.unit == UnitI && major == 5) || (op.unit == UnitF && major == 4);
+  }
+  // A write that may not happen: a qp, unless it is a .unc compare, which
+  // clears both targets when the qp is false.
+  bool predicated(size_t i) const {
+    return hasQp(i) && !(IsCompare(nodes_[i].op) && (nodes_[i].op.bits >> 12 & 1));
+  }
+  // The writer of |reg| before node |i| in the iteration, or SIZE_MAX.
+  size_t prevWriter(size_t i, uint16_t reg) const {
+    for (size_t k = i; k-- > 0;) {
+      if (writes(k, reg)) {
+        return k;
+      }
+    }
+    return SIZE_MAX;
+  }
+  // A register written under a predicate shares its value with the writes
+  // of it before, back to an unpredicated one: one rotating register, what
+  // a reader sees is whichever wrote last.  The first writer of the chain
+  // ending at |p|.
+  size_t chainStart(size_t p, uint16_t reg) const {
+    while (predicated(p)) {
+      size_t q = prevWriter(p, reg);
+      if (q == SIZE_MAX) {
+        return guardedReaders(p, reg) ? p : SIZE_MAX;
+      }
+      p = q;
+    }
+    return p;
+  }
+
+  // A register written only under a predicate: fine if everything that
+  // reads that write is under the same predicate (the same register from the
+  // same compare), so nothing reads it when it was not written.
+  bool guardedReaders(size_t p, uint16_t reg) const {
+    uint16_t qp = Rsrc(ResPr, uint32_t(nodes_[p].op.bits & 0x3f));
+    size_t qprod;
+    int qdist;
+    if (!producer(p, qp, &qprod, &qdist)) {
+      return false;
+    }
+    for (size_t j = 0; j < n_; j++) {
+      size_t w;
+      int dist;
+      if (!reads(j, reg) || !producer(j, reg, &w, &dist) || w != p) {
+        continue;
+      }
+      size_t jprod;
+      int jdist;
+      if (!hasQp(j) || Rsrc(ResPr, uint32_t(nodes_[j].op.bits & 0x3f)) != qp ||
+          !producer(j, qp, &jprod, &jdist) || jprod != qprod || dist != 0) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  // The register a check reads: its load's result.
+  uint16_t checked(size_t c) const { return nodes_[nodes_[c].ref & ~kSpecCheck].op.def[0]; }
+  bool reads(size_t j, uint16_t reg) const {
+    if (nodes_[j].kind == Kind::Check) {
+      return checked(j) == reg;
+    }
+    const Op& op = nodes_[j].op;
+    for (uint32_t u = 0; u < op.nUse; u++) {
+      if (op.use[u] == reg) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  bool buildEdges() {
+    // registers: true dependences only
+    for (size_t j = 0; j < n_; j++) {
+      const Op& b = nodes_[j].op;
+      size_t nu = nodes_[j].kind == Kind::Check ? 1 : b.nUse;
+      for (size_t u = 0; u < nu; u++) {
+        uint16_t reg = nodes_[j].kind == Kind::Check ? checked(j) : b.use[u];
+        size_t p;
+        int dist;
+        if (!producer(j, reg, &p, &dist)) {
+          if (nodes_[j].kind != Kind::Check && b.usePos[u] == 0 && hasQp(j)) {
+            return fail("predicated by a predicate from before the loop");
+          }
+          continue;
+        }
+        if (nodes_[j].kind != Kind::Check && b.usePos[u] == kFixedField) {
+          return fail("a fixed field reads a loop value");
+        }
+        size_t first = chainStart(p, reg);
+        if (first == SIZE_MAX) {
+          return fail("a register written only under a predicate");
+        }
+        if (nodes_[j].kind != Kind::Check && b.usePos[u] == 0 && dist != 0) {
+          return fail("predicated by a predicate from before the loop");
+        }
+        // every write of the chain can be the one the reader sees
+        for (size_t m = p;; m = prevWriter(m, reg)) {
+          const Op& a = nodes_[m].op;
+          int lat = Latency(a);
+          if ((b.flags & OpBranch) && (reg >> 8) == ResPr && !(a.flags & OpFpu)) {
+            lat = 0;
+          } else if (IsLoad(a) && ClassOf(a.def[0]) == 0 && (b.flags & OpMemory) &&
+                     AddressReg(b) == (reg & 0xff)) {
+            lat = 2;
+          }
+          if (!edge(m, j, lat, dist)) {
+            return false;
+          }
+          if (m == first) {
+            break;
+          }
+        }
+      }
+    }
+    // the writes of a chain stay in order, in separate cycles
+    for (size_t w = 0; w < n_; w++) {
+      if (!predicated(w)) {
+        continue;
+      }
+      const Op& op = nodes_[w].op;
+      for (uint32_t d = 0; d < op.nDef; d++) {
+        size_t q = prevWriter(w, op.def[d]);
+        if (q == SIZE_MAX) {
+          if (!guardedReaders(w, op.def[d])) {
+            return fail("a register written only under a predicate");
+          }
+          continue;
+        }
+        if (!edge(q, w, 1, 0)) {
+          return false;
+        }
+      }
+    }
+    // memory: program order inside an iteration, except loads checked by a
+    // chk.a; frame accesses also against the next iteration (spilled phis)
+    for (size_t i = 0; i < n_; i++) {
+      const Op& a = nodes_[i].op;
+      if (!(a.flags & OpMemory)) {
+        continue;
+      }
+      for (size_t j = 0; j < n_; j++) {
+        const Op& b = nodes_[j].op;
+        if (i == j || !(b.flags & OpMemory) || (IsLoad(a) && IsLoad(b))) {
+          continue;
+        }
+        bool frame = FrameAccess(a) && FrameAccess(b);
+        if (FrameAccess(a) != FrameAccess(b)) {
+          continue;  // the stack never aliases the heap
+        }
+        if (IsStore(a) && IsLoad(b) && !frame && (advanced_ || disjoint(i, j))) {
+          continue;  // ld.sa + chk.a, or never the same address
+        }
+        int lat = IsStore(a) && IsLoad(b) ? 1 : 0;
+        if (i < j && !edge(i, j, lat, 0)) {
+          return false;
+        }
+        // without data speculation a load also follows the previous
+        // iteration's stores
+        if (!advanced_ && IsStore(a) && IsLoad(b) && !frame && !edge(i, j, 1, 1)) {
+          return false;
+        }
+        if (frame && !edge(i, j, IsStore(a) && IsLoad(b) ? 7 : 0, 1)) {
+          return false;
+        }
+      }
+    }
+    // Exits.  Their order inside an iteration does not matter: they all
+    // resume the plain copy at that iteration.  What matters is between
+    // iterations and against stores, through two virtual gates:
+    //   A: every instruction of an iteration issues before any exit of the
+    //      next one (x -> A at distance 1, A -> each exit);
+    //   B: every store follows all of its iteration's exits (each exit -> B,
+    //      B -> each store).
+    bool anyExit = false;
+    for (size_t j = 0; j < n_; j++) {
+      anyExit |= nodes_[j].kind != Kind::Plain;
+    }
+    if (!anyExit) {
+      return fail("no exit");
+    }
+    if (n_ + 2 > MaxNodes) {
+      return fail("too many instructions");
+    }
+    const size_t gateA = n_, gateB = n_ + 1;
+    for (size_t g : {gateA, gateB}) {
+      nodes_[g].op = Op{};
+      nodes_[g].kind = Kind::Gate;
+      nodes_[g].ref = 0;
+      nodes_[g].cycle = -1;
+    }
+    n_ += 2;
+    for (size_t j = 0; j < gateA; j++) {
+      if (!edge(j, gateA, 0, 1)) {
+        return false;
+      }
+      if (nodes_[j].kind == Kind::Exit || nodes_[j].kind == Kind::Check) {
+        if (!edge(gateA, j, 0, 0) || !edge(j, gateB, 1, 0)) {
+          return false;
+        }
+      }
+      if (IsStore(nodes_[j].op) && !edge(gateB, j, 0, 0)) {
+        return false;
+      }
+      // a check follows the stores before its load
+      if (nodes_[j].kind == Kind::Check) {
+        for (size_t st = 0; st < j; st++) {
+          if (IsStore(nodes_[st].op) && !FrameAccess(nodes_[st].op) && !edge(st, j, 0, 0)) {
+            return false;
+          }
+        }
+      }
+    }
+    // compares, stores and branches fed (transitively) by a speculated load
+    // wait for its check
+    for (size_t c = 0; c < n_; c++) {
+      if (nodes_[c].kind != Kind::Check) {
+        continue;
+      }
+      bool tainted[MaxNodes] = {};
+      tainted[nodes_[c].ref & ~kSpecCheck] = true;
+      for (size_t j = (nodes_[c].ref & ~kSpecCheck) + 1; j < n_; j++) {
+        if (nodes_[j].kind == Kind::Check) {
+          continue;
+        }
+        const Op& b = nodes_[j].op;
+        for (uint32_t u = 0; u < b.nUse && !tainted[j]; u++) {
+          size_t p;
+          int dist;
+          if (producer(j, b.use[u], &p, &dist) && dist == 0 && tainted[p]) {
+            tainted[j] = true;
+          }
+        }
+        if (!tainted[j]) {
+          continue;
+        }
+        bool defsPr = false;
+        for (uint32_t d = 0; d < b.nDef; d++) {
+          defsPr |= ClassOf(b.def[d]) == 2;
+        }
+        if ((IsStore(b) || (b.flags & OpBranch) || defsPr) && !edge(c, j, 0, 0)) {
+          return false;
+        }
+      }
+    }
+    return true;
+  }
+
+  // Longest path at |ii|, or false if a dependence cycle is longer than ii
+  // allows.
+  bool longest(int ii, int* d) const {
+    for (size_t i = 0; i < n_; i++) {
+      d[i] = 0;
+    }
+    for (size_t round = 0; round <= n_; round++) {
+      bool changed = false;
+      for (size_t e = 0; e < nEdges_; e++) {
+        const Edge& x = edges_[e];
+        int v = d[x.from] + x.lat - ii * x.dist;
+        if (v > d[x.to]) {
+          d[x.to] = v;
+          changed = true;
+        }
+      }
+      if (!changed) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  bool bounds() {
+    // resources: slots, load ports, store ports, M ports, I ports, F, B
+    int slots = 1, ld = 0, st = 0, m = 0, iu = 0, f = 0, b = 1;  // + br.ctop
+    for (size_t i = 0; i < n_; i++) {
+      if (nodes_[i].kind == Kind::Gate) continue;
+      const Op& op = nodes_[i].op;
+      slots += op.unit == UnitLX ? 2 : 1;
+      switch (op.unit) {
+        case UnitM: m++; ld += IsLoad(op) || nodes_[i].kind == Kind::Check; st += IsStore(op); break;
+        case UnitI: case UnitLX: iu++; break;
+        case UnitF: f++; break;
+        case UnitB: b++; break;
+        default: break;
+      }
+    }
+    int res = (slots + 5) / 6;
+    int lim[] = {(ld + 1) / 2, (st + 1) / 2, (m + 3) / 4, (iu + 1) / 2, (f + 1) / 2, (b + 1) / 2};
+    for (int x : lim) {
+      res = x > res ? x : res;
+    }
+    resMII_ = res < 1 ? 1 : res;
+    int d[MaxNodes];
+    int lo = 1, hi = MaxII;
+    if (!longest(hi, d)) {
+      return fail("a recurrence longer than MaxII");
+    }
+    while (lo < hi) {
+      int mid = (lo + hi) / 2;
+      if (longest(mid, d)) {
+        hi = mid;
+      } else {
+        lo = mid + 1;
+      }
+    }
+    recMII_ = lo;
+    mii_ = resMII_ > recMII_ ? resMII_ : recMII_;
+    // the acyclic length: what the loop costs unpipelined, roughly
+    int acyc[MaxNodes];
+    longest(1 << 20, acyc);  // distance-1 edges vanish
+    acyclic_ = 0;
+    for (size_t i = 0; i < n_; i++) {
+      acyclic_ = acyc[i] + Latency(nodes_[i].op) > acyclic_ ? acyc[i] + Latency(nodes_[i].op) : acyclic_;
+    }
+    // What the loop costs today, roughly: Ion's loop bodies issue about an
+    // instruction per cycle (lin_solve: 117 in ~119), so no less than half
+    // their length; a kernel must beat that by a margin.
+    int real = 0;
+    for (size_t i = 0; i < n_; i++) {
+      real += nodes_[i].kind != Kind::Gate && nodes_[i].kind != Kind::Check;
+    }
+    if (acyclic_ < real / 2) {
+      acyclic_ = real / 2;
+    }
+    return true;
+  }
+
+  // ---- one kernel cycle: does it fit two bundles that issue together? ----
+
+  enum Port : uint8_t { PM, PML, PMS, PM2, PI, PA, PF, PB, PL };
+  static Port PortOf(const Node& nd) {
+    const Op& op = nd.op;
+    if (nd.kind == Kind::Check) {
+      return nd.ref & kSpecCheck ? PMS : PML;  // chk.s: M2/M3, chk.a: M0/M1
+    }
+    switch (op.unit) {
+      case UnitM: {
+        if (IsLoad(op)) return PML;
+        if (IsStore(op)) return PMS;
+        bool defGr = false, defFr = false, useFr = false;
+        for (uint32_t i = 0; i < op.nDef; i++) {
+          defGr |= ClassOf(op.def[i]) == 0;
+          defFr |= ClassOf(op.def[i]) == 1;
+        }
+        for (uint32_t i = 0; i < op.nUse; i++) useFr |= ClassOf(op.use[i]) == 1;
+        if (defGr && useFr) return PM2;  // getf: M2 only
+        if (defFr) return PMS;           // setf: M2/M3, like a store
+        return PM;
+      }
+      case UnitI: return PI;
+      case UnitF: return PF;
+      case UnitB: return PB;
+      case UnitLX: return PL;
+      default: return PA;
+    }
+  }
+
+  // Slot kinds of the templates a kernel cycle may use.
+  static const char* TemplateName(int t) {
+    static const char* const T[] = {"MMI", "MII", "MFI", "MMF", "MMB", "MIB", "MFB", "MBB", "BBB", "MLX"};
+    return T[t];
+  }
+  static const int NumTemplates = 10;
+
+  // Counts per port class of a cycle's instructions.
+  struct Mix {
+    uint8_t n[9];
+  };
+
+  // Whether |mix| (plus the loop branch when |branch|) fits templates t1
+  // [t2] issued in one cycle.
+  static bool FitsPair(const Mix& mix, int t1, int t2) {
+    int ms = 0, is = 0, fs = 0, bs = 0, ls = 0, bsLast = 0;
+    for (int k = 0; k < (t2 < 0 ? 1 : 2); k++) {
+      const char* t = TemplateName(k == 0 ? t1 : t2);
+      bool last = k == (t2 < 0 ? 0 : 1);
+      for (int s = 0; s < 3; s++) {
+        switch (t[s]) {
+          case 'M': ms++; break;
+          case 'I': is++; break;
+          case 'F': fs++; break;
+          case 'B': bs++; bsLast += last; break;
+          case 'L': ls++; break;
+          case 'X': break;
+        }
+      }
+    }
+    if (t2 >= 0) {
+      const char* a = TemplateName(t1);
+      const char* b = TemplateName(t2);
+      if (!strcmp(a, "MBB") || !strcmp(a, "BBB")) return false;
+      if (!strcmp(a, "MII") && !strcmp(b, "MLX")) return false;
+    }
+    int mOps = mix.n[PM] + mix.n[PML] + mix.n[PMS] + mix.n[PM2];
+    // an MLX only for a movl: its L+X slots have no plain nop
+    if (mix.n[PL] != ls) return false;
+    if (mix.n[PF] > fs || mix.n[PB] > bsLast || bs > 3) return false;
+    if (mix.n[PML] > 2 || mix.n[PMS] + mix.n[PM2] > 2 || mix.n[PM2] > 1) return false;
+    // M2/M3 go in order: a store or setf ahead of a getf takes M2 and splits
+    // issue, a getf ahead of one holds the next group ~5 cycles
+    // (results/disp-probe-montecito.md): no getf with either
+    if (mix.n[PM2] && mix.n[PMS]) return false;
+    if (mOps > ms || ms > 4 || mix.n[PI] > 2 || mix.n[PI] > is) return false;
+    // A-type instructions go to M or I slots.  The first two I slots take
+    // the two I ports whatever they hold (a nop.i too); each later one must
+    // hold an A-type instruction, which then takes an M port.
+    int a = mix.n[PA];
+    for (int aI = 0; aI <= a; aI++) {
+      int aM = a - aI;
+      if (aM > ms - mOps || mix.n[PI] + aI > is) continue;
+      if (is > 2) {
+        int beyond = is - 2;
+        // I-type ones first, then A-types: slots 3.. hold A-types only if
+        // the I slots are full and enough of them are A-types
+        if (mix.n[PI] + aI < is || aI < beyond || ms + beyond > 4) continue;
+      }
+      return true;
+    }
+    return false;
+  }
+
+  static bool MixFits(const Mix& mix) {
+    for (int t1 = 0; t1 < NumTemplates; t1++) {
+      if (FitsPair(mix, t1, -1)) return true;
+    }
+    for (int t1 = 0; t1 < NumTemplates; t1++) {
+      for (int t2 = 0; t2 < NumTemplates; t2++) {
+        if (FitsPair(mix, t1, t2)) return true;
+      }
+    }
+    return false;
+  }
+
+  bool rowFits(const int* rowOf, int row, int extra, int ii) const {
+    Mix mix = {};
+    int count = 0;
+    for (size_t i = 0; i < n_; i++) {
+      if (nodes_[i].kind == Kind::Gate) continue;
+      if ((rowOf[i] == row) || int(i) == extra) {
+        mix.n[PortOf(nodes_[i])]++;
+        count += nodes_[i].op.unit == UnitLX ? 2 : 1;
+      }
+    }
+    if (row == ii - 1) {
+      mix.n[PB]++;  // br.ctop
+      count++;
+    }
+    return count <= 6 && MixFits(mix);
+  }
+
+  // ---- iterative modulo scheduling ---------------------------------------
+
+  bool schedule(int ii, bool asap) {
+    int h[MaxNodes], early[MaxNodes];
+    if (!longest(ii, early)) {
+      return false;
+    }
+    for (size_t i = 0; i < n_; i++) {
+      h[i] = 0;
+    }
+    for (size_t round = 0; round <= n_; round++) {
+      bool changed = false;
+      for (size_t e = 0; e < nEdges_; e++) {
+        const Edge& x = edges_[e];
+        int v = h[x.to] + x.lat - ii * x.dist;
+        if (v > h[x.from]) {
+          h[x.from] = v;
+          changed = true;
+        }
+      }
+      if (!changed) break;
+    }
+    int sigma[MaxNodes], last[MaxNodes], rowOf[MaxNodes];
+    for (size_t i = 0; i < n_; i++) {
+      sigma[i] = last[i] = rowOf[i] = -1;
+    }
+    long budget = 8 * long(n_) + 50;
+    while (budget-- > 0) {
+      int op = -1;
+      for (size_t i = 0; i < n_; i++) {
+        if (sigma[i] >= 0) continue;
+        if (op < 0) { op = int(i); continue; }
+        bool better = asap ? (early[i] < early[op] || (early[i] == early[op] && h[i] > h[op]))
+                           : h[i] > h[op];
+        if (better) op = int(i);
+      }
+      if (op < 0) {
+        for (size_t i = 0; i < n_; i++) {
+          nodes_[i].cycle = sigma[i];
+        }
+        ii_ = ii;
+        int maxc = 0;
+        for (size_t i = 0; i < n_; i++) maxc = sigma[i] > maxc ? sigma[i] : maxc;
+        stages_ = maxc / ii + 1;
+        return stages_ <= MaxStages;
+      }
+      int estart = 0;
+      for (size_t e = 0; e < nEdges_; e++) {
+        const Edge& x = edges_[e];
+        if (int(x.to) == op && sigma[x.from] >= 0) {
+          int v = sigma[x.from] + x.lat - ii * x.dist;
+          estart = v > estart ? v : estart;
+        }
+      }
+      int t = -1;
+      for (int c = estart; c < estart + ii; c++) {
+        if (rowFits(rowOf, c % ii, op, ii)) { t = c; break; }
+      }
+      if (t < 0) {
+        t = (last[op] >= 0 && estart <= last[op]) ? last[op] + 1 : estart;
+        int r = t % ii;
+        // evict from the row, lowest height first, until it fits
+        while (!rowFits(rowOf, r, op, ii)) {
+          int victim = -1;
+          for (size_t i = 0; i < n_; i++) {
+            if (rowOf[i] == r && (victim < 0 || h[i] < h[victim])) victim = int(i);
+          }
+          if (victim < 0) return false;
+          sigma[victim] = rowOf[victim] = -1;
+        }
+      }
+      sigma[op] = t;
+      rowOf[op] = t % ii;
+      last[op] = t;
+      for (size_t e = 0; e < nEdges_; e++) {
+        const Edge& x = edges_[e];
+        if (int(x.from) == op && int(x.to) != op && sigma[x.to] >= 0 &&
+            sigma[x.to] < t + x.lat - ii * x.dist) {
+          sigma[x.to] = rowOf[x.to] = -1;
+        }
+        if (int(x.to) == op && int(x.from) != op && sigma[x.from] >= 0 &&
+            t < sigma[x.from] + x.lat - ii * x.dist) {
+          sigma[x.from] = rowOf[x.from] = -1;
+        }
+      }
+    }
+    return false;
+  }
+
+  // ---- rotating registers ------------------------------------------------
+
+  static bool Scratch(uint16_t reg) {
+    uint32_t n = reg & 0xff;
+    switch (reg >> 8) {
+      case ResGr: return n == 2 || n == 3 || n == 10 || n == 11;
+      case ResFr: return n >= 2 && n <= 7;
+      case ResPr: return true;  // never live across an LIR instruction
+      default: return true;
+    }
+  }
+
+  bool allocate() {
+    nValues_ = 0;
+    int lastExit = 0;
+    for (size_t i = 0; i < n_; i++) {
+      if (nodes_[i].kind == Kind::Exit || nodes_[i].kind == Kind::Check) {
+        lastExit = nodes_[i].cycle > lastExit ? nodes_[i].cycle : lastExit;
+      }
+    }
+    int next[3] = {0, 0, stages_};
+    for (size_t p = 0; p < n_; p++) {
+      const Op& op = nodes_[p].op;
+      if (nodes_[p].kind == Kind::Check || nodes_[p].kind == Kind::Gate) continue;
+      for (uint32_t d = 0; d < op.nDef; d++) {
+        int cls = ClassOf(op.def[d]);
+        if (cls < 0) continue;
+        uint16_t reg = op.def[d];
+        // a predicated write joins the value of the chain it continues
+        if (predicated(p) && chainStart(p, reg) != p) continue;
+        Value& v = values_[nValues_];
+        v.node = uint16_t(p);
+        v.def = uint8_t(d);
+        v.cls = uint8_t(cls);
+        v.last = nodes_[p].cycle;
+        v.restore = false;
+        bool carried = false;
+        for (size_t j = 0; j < n_; j++) {
+          if (!reads(j, reg)) continue;
+          size_t q;
+          int dist;
+          if (!producer(j, reg, &q, &dist) || chainStart(q, reg) != p) continue;
+          int t = nodes_[j].cycle + ii_ * dist;
+          v.last = t > v.last ? t : v.last;
+          carried |= dist == 1;
+        }
+        // the last write of a register the plain copy may read at its header
+        // (the chain's: its later writes are predicated members)
+        bool lastWrite = true;
+        for (size_t q = p + 1; q < n_; q++) {
+          if (writes(q, reg) && !(predicated(q) && chainStart(q, reg) == p)) {
+            lastWrite = false;
+          }
+        }
+        if (lastWrite && !Scratch(reg)) {
+          v.restore = true;
+          int t = lastExit + ii_;
+          v.last = t > v.last ? t : v.last;
+        }
+        int defStage = nodes_[p].cycle / ii_;
+        v.count = int16_t(v.last / ii_ - defStage + 1);
+        // an initial value read in iteration 0 travels from its place at
+        // entry up to the block: keep that stretch free
+        v.pad = int16_t((carried || v.restore) && defStage > 1 ? defStage - 1 : 0);
+        v.base = int16_t(next[cls] + v.pad);
+        next[cls] += v.pad + v.count;
+        nValues_++;
+        if (nValues_ == MaxNodes * 2) return fail("too many values");
+      }
+    }
+    if (next[0] > RotGr || next[1] > RotFr || next[2] > RotPr) {
+      return fail("not enough rotating registers");
+    }
+    rotUsed_[0] = next[0];
+    rotUsed_[1] = next[1];
+    rotUsed_[2] = next[2];
+    return true;
+  }
+
+ public:
+  // Rotating registers used per class (the size of the rotating regions).
+  int rotUsed(int cls) const { return rotUsed_[cls]; }
+
+  // ---- code --------------------------------------------------------------
+  //
+  // The kernel as bundles, laid out as
+  //
+  //   entry:  save ar.lc, pr, ar.ec in r10, r11, r2; alloc a rotating frame;
+  //           ar.lc = -1 (exits end the loop, never the count); ar.ec;
+  //           pr.rot = p16 only; the initial values into their rotating
+  //           registers
+  //   kernel: II cycles, one or two bundles each, br.ctop at the end
+  //   stubs:  one per stage that has exits: the header values of the
+  //           iteration that left back into their registers, clrrrb, the
+  //           Ion frame (alloc 0, 0, 8, 0), ar.lc, ar.ec, pr, and a branch
+  //           to the plain copy's header
+  //
+  // |at| is the bundle index the first bundle goes to, |header| that of the
+  // plain copy's header.  Returns the number of bundles, 0 if |cap| is too
+  // small or a displacement does not fit.
+  size_t emit(Bundle* out, size_t cap, int64_t at, int64_t header,
+              int64_t reentryHeader = -1) {
+    if (reentryHeader < 0) {
+      reentryHeader = header;
+    }
+    cap_ = cap;
+    out_ = out;
+    nOut_ = 0;
+    ok_ = true;
+    const int rot = (rotUsed_[0] + 7) / 8 * 8 < 8 ? 8 : (rotUsed_[0] + 7) / 8 * 8;
+
+    // entry
+    put(MakeBundle(tMII_, Raw(Alloc(0, 0, rot, 0, rot).bits, 6, 7, 3),
+                   MovFromArBits(10, 65), MovFromPrBits(11)));
+    put(MakeBundle(tMII_, AddsBits(32, -1, 0), MovFromArBits(2, 66), NopBits(0)));
+    put(MakeBundle(tMII_, NopBits(0), MovToArBits(65, 32), MovToArImmBits(66, stages_)));
+    put(MakeBundle(tMII_, NopBits(0), Insn(0x00400000040) /* mov pr.rot = 1 << 16 */, NopBits(0)));
+    // initial values: the static register into the rotating one where
+    // iteration 0 (or a stub for it) will look
+    {
+      Insn gr[3];
+      int ngr = 0;
+      for (size_t i = 0; i < nValues_; i++) {
+        const Value& v = values_[i];
+        if (!needsInitial(v)) continue;
+        uint16_t reg = nodes_[v.node].op.def[v.def];
+        int idx = v.base - nodes_[v.node].cycle / ii_ + 1;
+        if (v.cls == 0) {
+          gr[ngr++] = AddsBits(32 + idx, 0, reg & 0xff);
+          if (ngr == 3) {
+            put(MakeBundle(tMII_, gr[0], gr[1], gr[2]));
+            ngr = 0;
+          }
+        } else if (v.cls == 1) {
+          put(MakeBundle(tMFI_, NopBits(0), FmergeSBits(32 + idx, reg & 0xff), NopBits(0)));
+        } else {
+          ok_ = false;  // a predicate carried across iterations
+        }
+      }
+      if (ngr) {
+        put(MakeBundle(tMII_, gr[0], ngr > 1 ? gr[1] : NopBits(0), ngr > 2 ? gr[2] : NopBits(0)));
+      }
+    }
+
+    // the kernel; stubs go after it, at positions known once its size is
+    const size_t kernelAt = nOut_;
+    kernelStart_ = kernelAt;
+    for (int s = 0; s < MaxStages; s++) {
+      stubAt_[s] = -1;
+    }
+    for (int pass = 0; pass < 2 && ok_; pass++) {
+      nOut_ = kernelAt;
+      for (int r = 0; r < ii_; r++) {
+        emitRow(r, at, kernelAt);
+      }
+      // stubs
+      stubEnd_ = nOut_;
+      for (int s = 0; s < stages_; s++) {
+        bool any = false;
+        for (size_t i = 0; i < n_; i++) {
+          any |= (nodes_[i].kind == Kind::Exit || nodes_[i].kind == Kind::Check) &&
+                 nodes_[i].cycle / ii_ == s;
+        }
+        if (!any) continue;
+        stubAt_[s] = at + int64_t(nOut_);
+        emitStub(s, at, header);
+      }
+      // the plain copy's back edge comes here: back into the kernel unless
+      // it left without progress, which stays so (each stub sets p15 anew)
+      // and keeps the rest of this run of the loop in the plain copy.
+      // Clearing p15 to come back after one plain iteration measured
+      // NavierStokes -29%, Crypto -12% (results/alat-kernels.md): a kernel
+      // that leaves early once mostly does again.
+      reentryAt_ = at + int64_t(nOut_);
+      put(MakeBundle(tMBB_, NopBits(0),
+                     BranchBits(reentryHeader - reentryAt_, 15, 0, BranchHint::Dpnt),
+                     BranchBits(at - reentryAt_, 0, 0, BranchHint::Sptk)));
+    }
+    return ok_ ? nOut_ : 0;
+  }
+
+  // Where the plain copy's back edge has to go once the kernel is in place.
+  int64_t reentryAt() const { return reentryAt_; }
+  // Bundles [kernelStart(), kernelEnd()) of the last emit() are the kernel.
+  size_t kernelStart() const { return kernelStart_; }
+  size_t kernelEnd() const { return size_t(stubEnd_); }
+
+ private:
+  // ---- encoding helpers (fields written directly: the kernel names
+  // registers beyond Ion's r0-r39) ----
+
+  static Insn Field(Insn bits, int pos, int width, uint32_t v) {
+    Insn mask = ((Insn(1) << width) - 1) << pos;
+    return (bits & ~mask) | ((Insn(v) & ((Insn(1) << width) - 1)) << pos);
+  }
+  static Insn Raw(Insn bits, int pos, int width, uint32_t v) { return Field(bits, pos, width, v); }
+  // adds r1 = imm14, r3
+  static Insn AddsBits(uint32_t r1, int64_t imm, uint32_t r3) {
+    Insn b = Adds(0, imm, 0).bits;
+    return Field(Field(b, 6, 7, r1), 20, 7, r3);
+  }
+  static Insn FmergeSBits(uint32_t f1, uint32_t f2) {
+    Insn b = FmergeS(0, 0, 0).bits;
+    return Field(Field(Field(b, 6, 7, f1), 13, 7, f2), 20, 7, f2);
+  }
+  // mov r1 = ar (I28), mov ar = r2 (I26), mov ar = imm8 (I27)
+  static Insn MovFromArBits(uint32_t r1, uint32_t ar) {
+    return (Insn(0x32) << 27) | (Insn(ar) << 20) | (Insn(r1) << 6);
+  }
+  static Insn MovToArBits(uint32_t ar, uint32_t r2) {
+    return (Insn(0x2a) << 27) | (Insn(ar) << 20) | (Insn(r2) << 13);
+  }
+  static Insn MovToArImmBits(uint32_t ar, int imm) {
+    return (Insn(0x0a) << 27) | (Insn(ar) << 20) | (Insn(imm & 0x7f) << 13) |
+           (Insn(imm < 0) << 36);
+  }
+  // mov r1 = pr (I25); mov pr = r2, -1 (I23)
+  static Insn MovFromPrBits(uint32_t r1) { return (Insn(0x001980000c0) & ~(Insn(0x7f) << 6)) | (Insn(r1) << 6); }
+  // mov pr = r2, mask17: all predicates, or all but p15 (|keepP15|)
+  static Insn MovToPrBits(uint32_t r2, bool keepP15 = false) {
+    Insn b = Insn(0x016ff001fc0) | (Insn(r2) << 13);
+    if (keepP15) {
+      // mask17: bits 1-7 in mask7a (6-12), 8-15 in mask8c (24-31), 16 in s
+      b &= ~(Insn(1) << (24 + 15 - 8));
+    }
+    return b;
+  }
+  static Insn ClrrrbBits() { return Insn(0x00020000000); }
+  // chk.a.clr r1/f1, target (M22/M23)
+  static Insn ChkABits(bool fp, uint32_t reg, uint32_t qp, int64_t disp) {
+    uint64_t d = uint64_t(disp);
+    return (Insn(fp ? 7 : 5) << 33) | (Insn((d >> 20) & 1) << 36) |
+           (Insn(d & 0xfffff) << 13) | (Insn(reg & 0x7f) << 6) | Insn(qp & 0x3f);
+  }
+  // chk.s.m r2 / chk.s f2, target (M20/M21)
+  static Insn ChkSBits(bool fp, uint32_t reg, uint32_t qp, int64_t disp) {
+    uint64_t d = uint64_t(disp);
+    return (Insn(1) << 37) | (Insn(fp ? 3 : 1) << 33) | (Insn((d >> 20) & 1) << 36) |
+           (Insn((d >> 7) & 0x1fff) << 20) | (Insn(reg & 0x7f) << 13) |
+           (Insn(d & 0x7f) << 6) | Insn(qp & 0x3f);
+  }
+  static Insn BranchBits(int64_t disp, uint32_t qp, uint32_t btype, BranchHint hint) {
+    Insn b = BrCondRel(int32_t(disp), qp, hint).bits;
+    return Field(b, 6, 3, btype);
+  }
+
+  void put(const Bundle& b) {
+    if (nOut_ == cap_) {
+      ok_ = false;
+      return;
+    }
+    out_[nOut_++] = b;
+  }
+
+  bool needsInitial(const Value& v) const {
+    if (v.restore) return true;
+    uint16_t reg = nodes_[v.node].op.def[v.def];
+    for (size_t j = 0; j < n_; j++) {
+      size_t q;
+      int dist;
+      if (reads(j, reg) && producer(j, reg, &q, &dist) && chainStart(q, reg) == v.node &&
+          dist == 1) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  const Value* valueOf(size_t node, uint16_t reg) const {
+    if (predicated(node) && writes(node, reg)) {
+      node = chainStart(node, reg);
+    }
+    for (size_t i = 0; i < nValues_; i++) {
+      const Value& v = values_[i];
+      if (v.node == node && nodes_[node].op.def[v.def] == reg) return &v;
+    }
+    return nullptr;
+  }
+
+  // The architectural register a node reads |reg| from, at its own cycle.
+  uint32_t useReg(size_t j, uint16_t reg) const {
+    size_t q;
+    int dist;
+    if (!producer(j, reg, &q, &dist)) {
+      return reg & 0xff;  // a static register
+    }
+    const Value* v = valueOf(q, reg);
+    MOZ_ASSERT(v);
+    int idx = v->base + nodes_[j].cycle / ii_ - nodes_[v->node].cycle / ii_ + dist;
+    return uint32_t((v->cls == 2 ? 16 : 32) + idx);
+  }
+
+  // One instruction of the kernel, renamed and predicated by its stage.
+  Insn encode(size_t j, int64_t here, int64_t kernelAt) {
+    const Node& nd = nodes_[j];
+    int stage = nd.cycle / ii_;
+    if (nd.kind == Kind::Check) {
+      const Node& ld = nodes_[nd.ref & ~kSpecCheck];
+      bool fp = ClassOf(ld.op.def[0]) == 1;
+      if (nd.ref & kSpecCheck) {
+        return ChkSBits(fp, useReg(j, ld.op.def[0]), 16 + stage, stubDisp(stage, here));
+      }
+      return ChkABits(fp, useReg(j, ld.op.def[0]), 16 + stage, stubDisp(stage, here));
+    }
+    const Op& op = nd.op;
+    Insn b = op.bits;
+    for (uint32_t d = 0; d < op.nDef; d++) {
+      const Value* v = valueOf(j, op.def[d]);
+      int cls = ClassOf(op.def[d]);
+      // a chain member writes the head's physical register: its name moves
+      // up with the stages between them
+      int idx = v->base + stage - nodes_[v->node].cycle / ii_;
+      b = Field(b, op.defPos[d], cls == 2 ? 6 : 7, uint32_t((cls == 2 ? 16 : 32) + idx));
+    }
+    for (uint32_t u = 0; u < op.nUse; u++) {
+      if (op.usePos[u] >= 64) continue;
+      int cls = ClassOf(op.use[u]);
+      b = Field(b, op.usePos[u], cls == 2 ? 6 : 7, useReg(j, op.use[u]));
+    }
+    if (nd.kind == Kind::Exit) {
+      // the condition's predicate is renamed above (qp); the target is the
+      // stub of this stage
+      uint32_t qp = uint32_t(b & 0x3f);
+      return BranchBits(stubDisp(stage, here), qp, 0, BranchHint::Dpnt);
+    }
+    if (!hasQp(j)) {
+      b = Field(b, 0, 6, 16 + stage);  // a predicated one keeps its (renamed) qp
+    }
+    uint32_t major = uint32_t(b >> 37) & 0xf;
+    bool defsPr = false;
+    for (uint32_t d = 0; d < op.nDef; d++) defsPr |= ClassOf(op.def[d]) == 2;
+    if (defsPr) {
+      (void)major;
+      if (!IsCompare(op)) {
+        ok_ = false;  // a predicate from something that has no .unc form
+      }
+      b |= Insn(1) << 12;  // .unc: both predicates cleared when off
+    }
+    if (IsLoad(op) && !FrameAccess(op)) {
+      bool adv = j + 1 < n_ && nodes_[j + 1].kind == Kind::Check && !(nodes_[j + 1].ref & kSpecCheck);
+      b |= Insn(adv ? 0x0c : 0x04) << 30;  // ld.sa / ld.s
+    }
+    return b;
+  }
+
+  int64_t stubDisp(int stage, int64_t here) const {
+    // the first pass lays the kernel out before the stubs exist: any
+    // in-range displacement does, the second pass has the real one
+    return stubAt_[stage] < 0 ? 0 : stubAt_[stage] - here;
+  }
+
+  // Lays out row |r| in one or two bundles that issue together.
+  void emitRow(int r, int64_t at, size_t kernelAt) {
+    int ids[8];
+    int n = 0;
+    for (size_t i = 0; i < n_; i++) {
+      if (nodes_[i].kind == Kind::Gate) continue;
+      if (nodes_[i].cycle % ii_ == r) {
+        if (n == 7) { ok_ = false; return; }
+        ids[n++] = int(i);
+      }
+    }
+    // slot order: older iterations (higher stages) first, then program order
+    for (int a = 1; a < n; a++) {
+      for (int b = a; b > 0; b--) {
+        int x = ids[b - 1], y = ids[b];
+        int sx = nodes_[x].cycle / ii_, sy = nodes_[y].cycle / ii_;
+        if (sy > sx || (sy == sx && y < x)) { ids[b - 1] = y; ids[b] = x; }
+      }
+    }
+    bool ctop = r == ii_ - 1;
+    Mix mix = {};
+    for (int k = 0; k < n; k++) mix.n[PortOf(nodes_[ids[k]])]++;
+    if (ctop) mix.n[PB]++;
+    int t1 = -1, t2 = -1;
+    for (int a = 0; a < NumTemplates && t1 < 0; a++) {
+      if (FitsPair(mix, a, -1)) { t1 = a; }
+    }
+    for (int a = 0; a < NumTemplates && t1 < 0; a++) {
+      for (int b = 0; b < NumTemplates && t1 < 0; b++) {
+        if (FitsPair(mix, a, b)) { t1 = a; t2 = b; }
+      }
+    }
+    if (t1 < 0) { ok_ = false; return; }
+    // slots of the bundles in order, filled class by class in slot order
+    const char* tm[2] = {TemplateName(t1), t2 < 0 ? nullptr : TemplateName(t2)};
+    int nb = t2 < 0 ? 1 : 2;
+    Insn slot[2][3];
+    bool used[2][3] = {};
+    for (int b = 0; b < nb; b++) {
+      for (int s = 0; s < 3; s++) {
+        char k = tm[b][s];
+        slot[b][s] = k == 'B' ? NopBBits(0) : NopBits(0);
+        // an MLX is only chosen for a movl, which fills its L and X slots
+      }
+    }
+    int64_t base = at + int64_t(nOut_);
+    // the first free slot of |kind| (in the last bundle only, for branches)
+    auto take = [&](char kind, bool lastOnly, int* bb, int* ss) {
+      for (int b = lastOnly ? nb - 1 : 0; b < nb; b++) {
+        for (int s = 0; s < 3; s++) {
+          if (tm[b][s] == kind && !used[b][s]) {
+            used[b][s] = true;
+            *bb = b;
+            *ss = s;
+            return true;
+          }
+        }
+      }
+      return false;
+    };
+    // A-types: to I slots when the I slots beyond the second must be filled
+    // or the M slots are full, else to M slots
+    int aToI = 0;
+    {
+      int is = 0, ms = 0;
+      for (int b = 0; b < nb; b++)
+        for (int s = 0; s < 3; s++) { is += tm[b][s] == 'I'; ms += tm[b][s] == 'M'; }
+      int mOps = mix.n[PM] + mix.n[PML] + mix.n[PMS] + mix.n[PM2];
+      aToI = mix.n[PA] - (ms - mOps);
+      if (is > 2 && is - mix.n[PI] > aToI) aToI = is - mix.n[PI];
+      if (aToI < 0) aToI = 0;
+      if (aToI > mix.n[PA]) aToI = mix.n[PA];
+    }
+    int aSeen = 0;
+    for (int k = 0; k < n; k++) {
+      const Node& nd = nodes_[ids[k]];
+      Port p = PortOf(nd);
+      if (p == PL) {
+        // movl: the L slot holds the immediate, the X slot the rest
+        int b, sl, bx, sx;
+        if (!take('L', false, &b, &sl) || !take('X', false, &bx, &sx) || bx != b) {
+          ok_ = false;
+          return;
+        }
+        slot[b][sl] = nodes_[ids[k]].op.bitsL;
+        slot[bx][sx] = encode(size_t(ids[k]), base + b, int64_t(kernelAt));
+        continue;
+      }
+      char kind = p == PB ? 'B' : p == PF ? 'F' : p == PI ? 'I' : 'M';
+      if (p == PA) {
+        kind = ++aSeen > mix.n[PA] - aToI ? 'I' : 'M';
+      }
+      int b, sl;
+      if (!take(kind, kind == 'B', &b, &sl)) { ok_ = false; return; }
+      slot[b][sl] = encode(size_t(ids[k]), base + b, int64_t(kernelAt));
+    }
+    if (ctop) {
+      int b, sl;
+      if (!take('B', true, &b, &sl)) { ok_ = false; return; }
+      slot[b][sl] = BranchBits(int64_t(kernelAt) + at - (base + b), 0, 7, BranchHint::Sptk);
+    }
+    for (int b = 0; b < nb; b++) {
+      Template t = TemplateCode(tm[b], b == nb - 1);
+      put(MakeBundle(t, slot[b][0], slot[b][1], slot[b][2]));
+    }
+  }
+
+  static Template TemplateCode(const char* name, bool stop) {
+    struct { const char* n; Template t, ts; } T[] = {
+        {"MII", tMII, tMII_}, {"MMI", tMMI, tMMI_}, {"MFI", tMFI, tMFI_},
+        {"MMF", tMMF, tMMF_}, {"MIB", tMIB, tMIB_}, {"MMB", tMMB, tMMB_},
+        {"MFB", tMFB, tMFB_}, {"MBB", tMBB, tMBB_}, {"BBB", tBBB, tBBB_},
+        {"MLX", tMLX, tMLX_}};
+    for (auto& x : T) {
+      if (!strcmp(x.n, name)) return stop ? x.ts : x.t;
+    }
+    MOZ_CRASH("template");
+  }
+
+  // The stub for exits in stage |s|: iteration k (in stage s) leaves; the
+  // registers get their values at the start of iteration k, the last writes
+  // of iteration k - 1, which is s + 1 stages in.
+  void emitStub(int s, int64_t at, int64_t header) {
+    Insn gr[3];
+    int ngr = 0;
+    for (size_t i = 0; i < nValues_; i++) {
+      const Value& v = values_[i];
+      if (!v.restore) continue;
+      uint16_t reg = nodes_[v.node].op.def[v.def];
+      int idx = v.base + s + 1 - nodes_[v.node].cycle / ii_;
+      if (idx < v.base - v.pad || idx >= v.base + v.count) {
+        ok_ = false;
+        return;
+      }
+      if (v.cls == 0) {
+        gr[ngr++] = AddsBits(reg & 0xff, 0, 32 + idx);
+        if (ngr == 3) {
+          put(MakeBundle(tMII, gr[0], gr[1], gr[2]));
+          ngr = 0;
+        }
+      } else if (v.cls == 1) {
+        put(MakeBundle(tMFI, NopBits(0), FmergeSBits(reg & 0xff, 32 + idx), NopBits(0)));
+      }
+    }
+    // r3 = ar.lc: -1 less the passes since the kernel was entered
+    put(MakeBundle(tMII, ngr > 0 ? gr[0] : NopBits(0), ngr > 1 ? gr[1] : NopBits(0),
+                   MovFromArBits(3, 65)));
+    if (ngr > 2) {
+      ok_ = false;
+      return;
+    }
+    put(MakeBundle(tMIB_, NopBits(0), NopBits(0), ClrrrbBits()));
+    // p15: the kernel made no progress (fewer passes than it has stages,
+    // plus two), so the plain copy should not come back to it this time
+    put(MakeBundle(tMII_, CmpLtImm(15, 0, -(stages_ + 2) - 1, 3).bits, MovToArBits(65, 10),
+                   MovToArBits(66, 2)));
+    put(MakeBundle(tMII_, Raw(Alloc(0, 0, 0, 8, 0).bits, 6, 7, 2), MovToPrBits(11, true),
+                   NopBits(0)));
+    int64_t where = at + int64_t(nOut_);
+    put(MakeBundle(tMIB_, NopBits(0), NopBits(0),
+                   BranchBits(header - where, 0, 0, BranchHint::Sptk)));
+  }
+
+  Bundle* out_ = nullptr;
+  size_t cap_ = 0, nOut_ = 0, stubEnd_ = 0;
+  int64_t stubAt_[MaxStages] = {};
+  int64_t reentryAt_ = 0;
+  size_t kernelStart_ = 0;
+  bool ok_ = true;
+
+ public:
+
+ private:
+  Node nodes_[MaxNodes];
+  size_t n_ = 0;
+  Edge edges_[MaxEdges];
+  size_t nEdges_ = 0;
+  Value values_[MaxNodes * 2];
+  size_t nValues_ = 0;
+  int rotUsed_[3] = {};
+  int resMII_ = 0, recMII_ = 0, mii_ = 0, acyclic_ = 0, stages_ = 0;
+  int ii_ = 1;
+  const char* why_ = nullptr;
+  bool advanced_ = false;
+  int nProven_ = 0, nAdvanced_ = 0;
+  static const uint32_t kSpecCheck = 1u << 31;
+};
+
+}  // namespace ia64
+}  // namespace jit
+}  // namespace js
+
+#endif /* jit_ia64_Pipeliner_ia64_h */
diff --git a/b/js/src/jit/ia64/Scheduler-ia64.h b/js/src/jit/ia64/Scheduler-ia64.h
new file mode 100644
--- /dev/null
+++ b/js/src/jit/ia64/Scheduler-ia64.h
@@ -0,0 +1,419 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef jit_ia64_Scheduler_ia64_h
+#define jit_ia64_Scheduler_ia64_h
+
+#include "mozilla/Assertions.h"
+
+#include <stdint.h>
+
+#include "jit/ia64/AssemblerCore-ia64.h"
+
+// [SMDOC] IA-64 instruction scheduling
+//
+// The bundler (Bundler-ia64.h) packs instructions in the order they are
+// emitted and inserts a stop wherever the next one depends on the current
+// instruction group. Emitted in source order, almost every dependent step of
+// a macro-assembler sequence becomes its own group, and independent work from
+// the next sequence cannot overlap it. This file reorders the instructions of
+// a short window before they reach the bundler:
+//
+//   * The window holds only instructions whose encoders mark them OpSched:
+//     plain ALU, compare, shift/extend, movl, ordinary loads and stores,
+//     getf/setf and FP arithmetic -- instructions whose every architectural
+//     effect is in their def/use lists (OpMemory for memory). Anything else
+//     (other branches, alloc, ar moves, atomics, acquire/release accesses,
+//     fences, raw bundles) and every request for a code offset ends the
+//     window first, so nothing ever moves across them, and no offset is ever
+//     handed out for an instruction that may still move.
+//
+//   * Dependences: register RAW (with latency), WAW and WAR (order only; the
+//     bundler then decides the stop), and memory: stores stay in order with
+//     every other memory access, loads may pass loads.
+//
+//   * Conditional branches to labels not bound yet enter the window too
+//     (addBranch(); the assembler links them when the window drains). Such a
+//     branch is a full barrier unless it is a guard: a branch to a bailout,
+//     whose taken path reads only the registers of its snapshot. The
+//     assembler hands those over (setLive()), and an instruction may then
+//     cross the guard:
+//       - upwards (after it in program order, before it in the schedule) if
+//         it writes no live register and is not a store, and not a load
+//         either unless it addresses the stack or the frame: a load moved
+//         above its bounds or type check could fault;
+//       - downwards if it writes no live register and is not a store.
+//     The live set always holds sp, the frame pointer and the pinned
+//     registers. Branches keep their order among themselves. A value the
+//     bailout reads then has the same writer at the guard as in program
+//     order, memory is the same, and nothing on the fall-through path changes
+//     (docs/guard-aware-scheduling.md, phase 2).
+//
+//   * Greedy list scheduling, cycle by cycle, against the Montecito issue
+//     model (6 slots per cycle, movl = 2; 2 loads, 2 stores, 4 M; 2 I; 2 F)
+//     with measured latencies (tools/ia64-lat-probe): ALU 1, integer load 1,
+//     FP load 6, setf 6, getf 5, FP op 4. Ties go to the instruction on the
+//     longest path to the end of the window, then to program order.
+//
+// The output order is a permutation that respects every dependence, so the
+// bundler's own dependency tracking still decides every stop bit; this only
+// changes which instructions get the chance to share a group.
+
+namespace js {
+namespace jit {
+namespace ia64 {
+
+class Scheduler {
+ public:
+  static const size_t Capacity = 48;
+
+  bool empty() const { return n_ == 0; }
+  bool full() const { return n_ == Capacity; }
+
+  size_t size() const { return n_; }
+
+  void add(const Op& op) {
+    MOZ_ASSERT(!full());
+    kind_[n_] = KindPlain;
+    ops_[n_++] = op;
+  }
+
+  // A conditional branch, a full barrier until setLive() makes it a guard.
+  void addBranch(const Op& op) {
+    MOZ_ASSERT(op.flags & OpBranch);
+    add(op);
+    kind_[n_ - 1] = KindBarrier;
+  }
+
+  // The registers the taken path of the branch at |k| reads: bit n of |gr|
+  // for rn, of |fr| for fn.
+  void setLive(size_t k, uint64_t gr, uint64_t fr) {
+    MOZ_ASSERT(k < n_ && kind_[k] != KindPlain);
+    kind_[k] = KindGuard;
+    liveGr_[k] = gr;
+    liveFr_[k] = fr;
+  }
+
+  // Schedule the window and hand the instructions to |emit| in the new order,
+  // each with its position in the window.
+  template <typename F>
+  void drain(F&& emit) {
+    if (n_ <= 1) {
+      if (n_) {
+        emit(ops_[0], size_t(0));
+      }
+      n_ = 0;
+      return;
+    }
+    computeDeps();
+    computePriority();
+    schedule();
+    for (size_t k = 0; k < n_; k++) {
+      emit(ops_[order_[k]], size_t(order_[k]));
+    }
+    n_ = 0;
+  }
+
+ private:
+  enum Kind : uint8_t { KindPlain, KindBarrier, KindGuard };
+
+  struct Edge {
+    uint8_t from;
+    uint8_t latency;  // cycles between the issue of |from| and of this one
+  };
+  // Every earlier instruction of the window can be a predecessor.
+  static const size_t MaxPreds = Capacity;
+
+  static int Latency(const Op& op) {
+    bool defGr = false, defFr = false, useFr = false;
+    for (uint32_t i = 0; i < op.nDef; i++) {
+      defGr |= (op.def[i] >> 8) == ResGr;
+      defFr |= (op.def[i] >> 8) == ResFr;
+    }
+    for (uint32_t i = 0; i < op.nUse; i++) {
+      useFr |= (op.use[i] >> 8) == ResFr;
+    }
+    if (op.unit == UnitF) {
+      return 4;
+    }
+    if (op.flags & OpMemory) {
+      return defFr ? 6 : 1;
+    }
+    if (op.unit == UnitM && defFr) {
+      return 6;  // setf
+    }
+    if (op.unit == UnitM && defGr && useFr) {
+      return 5;  // getf
+    }
+    return 1;
+  }
+
+  void addPred(size_t j, size_t i, int latency) {
+    // computeDeps() visits each earlier instruction once, so there is at most
+    // one edge per pair and never more than Capacity - 1 per instruction.
+    MOZ_ASSERT(nPred_[j] < MaxPreds);
+    preds_[j][nPred_[j]++] = Edge{uint8_t(i), uint8_t(latency)};
+    succs_[i][nSucc_[i]++] = Edge{uint8_t(j), uint8_t(latency)};
+  }
+
+  void computeDeps() {
+    for (size_t j = 0; j < n_; j++) {
+      nSucc_[j] = 0;
+    }
+    for (size_t j = 0; j < n_; j++) {
+      nPred_[j] = 0;
+      const Op& b = ops_[j];
+      for (size_t i = 0; i < j; i++) {
+        const Op& a = ops_[i];
+        int lat = -1;
+        // RAW: b reads what a writes. A branch sees a predicate written in
+        // its own instruction group, except by an F-unit instruction.
+        for (uint32_t d = 0; d < a.nDef && lat < 0; d++) {
+          for (uint32_t u = 0; u < b.nUse; u++) {
+            if (a.def[d] == b.use[u]) {
+              bool sameGroup = (b.flags & OpBranch) && !(a.flags & OpFpu) &&
+                               (a.def[d] >> 8) == ResPr;
+              lat = sameGroup ? 0 : Latency(a);
+              break;
+            }
+          }
+        }
+        // WAW, WAR: order only. The bundler places the stop.
+        for (uint32_t d = 0; d < b.nDef && lat < 0; d++) {
+          for (uint32_t e = 0; e < a.nDef; e++) {
+            if (a.def[e] == b.def[d]) {
+              lat = 1;  // two writes of a register need separate groups
+              break;
+            }
+          }
+          for (uint32_t u = 0; u < a.nUse && lat < 0; u++) {
+            if (a.use[u] == b.def[d]) {
+              lat = 0;
+              break;
+            }
+          }
+        }
+        // Memory: stores are ordered with every access, loads with stores.
+        if (lat < 0 && (a.flags & OpMemory) && (b.flags & OpMemory) &&
+            (IsStore(a) || IsStore(b))) {
+          lat = 0;
+        }
+        if (lat < 0 && (kind_[i] != KindPlain || kind_[j] != KindPlain) &&
+            !mayCross(i, j)) {
+          lat = 0;
+        }
+        if (lat >= 0) {
+          addPred(j, i, lat);
+        }
+      }
+    }
+  }
+
+  // Whether instructions |i| < |j|, one of them a branch and otherwise
+  // independent, may swap. See the SMDOC.
+  bool mayCross(size_t i, size_t j) const {
+    if (kind_[i] != KindPlain && kind_[j] != KindPlain) {
+      return false;
+    }
+    if (kind_[i] == KindBarrier || kind_[j] == KindBarrier) {
+      return false;
+    }
+    const size_t g = kind_[i] == KindGuard ? i : j;
+    const Op& x = ops_[g == i ? j : i];
+    if (x.flags & OpMemory) {
+      if (IsStore(x)) {
+        return false;
+      }
+      if (g == i && !FrameBased(x)) {
+        return false;  // a load moving above the guard
+      }
+    }
+    for (uint32_t d = 0; d < x.nDef; d++) {
+      uint32_t c = x.def[d] >> 8, n = x.def[d] & 0xff;
+      if (n < 64 && ((c == ResGr && (liveGr_[g] >> n) & 1) ||
+                     (c == ResFr && (liveFr_[g] >> n) & 1))) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  // A load addressing the stack or the frame, which cannot fault.
+  static bool FrameBased(const Op& op) {
+    bool any = false;
+    for (uint32_t u = 0; u < op.nUse; u++) {
+      if ((op.use[u] >> 8) == ResGr) {
+        uint32_t n = op.use[u] & 0xff;
+        if (n != 12 && n != 4) {
+          return false;
+        }
+        any = true;
+      }
+    }
+    return any;
+  }
+
+  static bool IsStore(const Op& op) {
+    // A memory instruction with no register result is a store.
+    for (uint32_t d = 0; d < op.nDef; d++) {
+      ResClass c = ResClass(op.def[d] >> 8);
+      if (c == ResGr || c == ResFr) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  void computePriority() {
+    // Longest latency-weighted path from each instruction to the window end.
+    for (size_t j = n_; j-- > 0;) {
+      prio_[j] = Latency(ops_[j]);
+    }
+    for (size_t j = n_; j-- > 0;) {
+      for (uint32_t k = 0; k < nPred_[j]; k++) {
+        const Edge& e = preds_[j][k];
+        int p = prio_[j] + e.latency;
+        if (p > prio_[e.from]) {
+          prio_[e.from] = p;
+        }
+      }
+    }
+  }
+
+  // Cycle by cycle, the ready instruction with the highest priority that
+  // fits, then the next, until none fits; ties go to program order. An
+  // instruction is ready once all its predecessors are placed and the
+  // latencies from them have elapsed. Kept as a ready list with successor
+  // edges, so a window costs about edges + instructions x ready-list length
+  // rather than a rescan of every instruction and its predecessors per slot.
+  void schedule() {
+    uint32_t waiting[Capacity];  // predecessors not yet placed
+    int earliest[Capacity];      // first cycle the placed ones allow
+    uint8_t ready[Capacity];     // all predecessors placed
+    size_t nReady = 0;
+    for (size_t j = 0; j < n_; j++) {
+      waiting[j] = nPred_[j];
+      earliest[j] = 0;
+      if (waiting[j] == 0) {
+        ready[nReady++] = uint8_t(j);
+      }
+    }
+    size_t placed = 0;
+    for (int cycle = 0; placed < n_;) {
+      int slots = 0, ld = 0, st = 0, m = 0, iu = 0, f = 0;
+      for (;;) {
+        int best = -1;
+        size_t bestAt = 0;
+        for (size_t r = 0; r < nReady; r++) {
+          const size_t j = ready[r];
+          if (earliest[j] > cycle || !fits(ops_[j], slots, ld, st, m, iu, f)) {
+            continue;
+          }
+          if (best < 0 || prio_[j] > prio_[best] ||
+              (prio_[j] == prio_[best] && j < size_t(best))) {
+            best = int(j);
+            bestAt = r;
+          }
+        }
+        if (best < 0) {
+          break;
+        }
+        take(ops_[best], slots, ld, st, m, iu, f);
+        order_[placed++] = uint8_t(best);
+        // A branch ends issue for the cycle (taken or not, the hardware
+        // issues nothing after it in the same cycle).
+        const bool endsCycle = ops_[best].flags & OpBranch;
+        ready[bestAt] = ready[--nReady];
+        for (uint32_t k = 0; k < nSucc_[best]; k++) {
+          const Edge& e = succs_[best][k];
+          const int at = cycle + e.latency;
+          if (at > earliest[e.from]) {
+            earliest[e.from] = at;
+          }
+          if (--waiting[e.from] == 0) {
+            ready[nReady++] = e.from;
+          }
+        }
+        if (endsCycle) {
+          break;
+        }
+      }
+      // Nothing more fits this cycle: on to the next one in which some ready
+      // instruction's latencies have elapsed. Cycles skipped here would
+      // place nothing, so the order is the same as stepping one at a time.
+      int next = cycle + 1;
+      if (nReady > 0) {
+        int first = earliest[ready[0]];
+        for (size_t r = 1; r < nReady; r++) {
+          first = earliest[ready[r]] < first ? earliest[ready[r]] : first;
+        }
+        next = first > next ? first : next;
+      }
+      cycle = next;
+    }
+  }
+
+  static bool fits(const Op& op, int slots, int ld, int st, int m, int iu,
+                   int f) {
+    int w = op.unit == UnitLX ? 2 : 1;
+    if (slots + w > 6) {
+      return false;
+    }
+    switch (op.unit) {
+      case UnitM:
+        if (op.flags & OpMemory) {
+          return m < 4 && (IsStore(op) ? st < 2 : ld < 2);
+        }
+        return m < 4;
+      case UnitI:
+      case UnitLX:
+        return iu < 2;
+      case UnitF:
+        return f < 2;
+      default:
+        return true;  // A: M or I, checked through the slot count
+    }
+  }
+
+  static void take(const Op& op, int& slots, int& ld, int& st, int& m, int& iu,
+                   int& f) {
+    slots += op.unit == UnitLX ? 2 : 1;
+    switch (op.unit) {
+      case UnitM:
+        m++;
+        if (op.flags & OpMemory) {
+          (IsStore(op) ? st : ld)++;
+        }
+        break;
+      case UnitI:
+      case UnitLX:
+        iu++;
+        break;
+      case UnitF:
+        f++;
+        break;
+      default:
+        break;
+    }
+  }
+
+  Op ops_[Capacity];
+  Kind kind_[Capacity];
+  uint64_t liveGr_[Capacity];
+  uint64_t liveFr_[Capacity];
+  uint8_t order_[Capacity];
+  int prio_[Capacity];
+  Edge preds_[Capacity][MaxPreds];
+  uint32_t nPred_[Capacity];
+  // The same edges from the other end (Edge::from is the successor here).
+  Edge succs_[Capacity][Capacity];
+  uint32_t nSucc_[Capacity];
+  size_t n_ = 0;
+};
+
+}  // namespace ia64
+}  // namespace jit
+}  // namespace js
+
+#endif /* jit_ia64_Scheduler_ia64_h */
diff --git a/b/js/src/jit/ia64/SharedICHelpers-ia64-inl.h b/js/src/jit/ia64/SharedICHelpers-ia64-inl.h
new file mode 100644
--- /dev/null
+++ b/js/src/jit/ia64/SharedICHelpers-ia64-inl.h
@@ -0,0 +1,74 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#ifndef jit_ia64_SharedICHelpers_ia64_inl_h
+#define jit_ia64_SharedICHelpers_ia64_inl_h
+
+#include "jit/BaselineFrame.h"
+#include "jit/SharedICHelpers.h"
+
+#include "jit/MacroAssembler-inl.h"
+
+namespace js {
+namespace jit {
+
+inline void EmitBaselineTailCallVM(TrampolinePtr target, MacroAssembler& masm,
+                                   uint32_t argSize) {
+#ifdef DEBUG
+  // The return address is in b0, not on the stack, so the frame size is
+  // simply FramePointer - StackPointer, minus the VMFunction arguments.
+  Register scratch = R2.scratchReg();
+  masm.movePtr(FramePointer, scratch);
+  masm.subPtr(StackPointer, scratch);
+  masm.subPtr(Imm32(argSize), scratch);
+
+  Address frameSizeAddr(FramePointer,
+                        BaselineFrame::reverseOffsetOfDebugFrameSize());
+  masm.store32(scratch, frameSizeAddr);
+#endif
+
+  // Push the frame descriptor and perform the tail call. The return address
+  // is in b0; the VM wrapper spills it with pushReturnAddress().
+  masm.push(FrameDescriptor(FrameType::BaselineJS));
+  masm.jump(target);
+}
+
+inline void EmitBaselineCallVM(TrampolinePtr target, MacroAssembler& masm) {
+  masm.push(FrameDescriptor(FrameType::BaselineStub));
+  masm.call(target);
+}
+
+inline void EmitBaselineEnterStubFrame(MacroAssembler& masm, Register scratch) {
+  MOZ_ASSERT(scratch != ICTailCallReg);
+
+#ifdef DEBUG
+  // The return address is in b0, not on the stack, so the frame size is
+  // simply FramePointer - StackPointer.
+  masm.movePtr(FramePointer, scratch);
+  masm.subPtr(StackPointer, scratch);
+
+  Address frameSizeAddr(FramePointer,
+                        BaselineFrame::reverseOffsetOfDebugFrameSize());
+  masm.store32(scratch, frameSizeAddr);
+#endif
+
+  // Push the frame descriptor, then spill b0 on top of it.
+  masm.Push(FrameDescriptor(FrameType::BaselineJS));
+  masm.pushReturnAddress();
+
+  // Save old frame pointer, stack pointer and stub reg.
+  masm.Push(FramePointer);
+  masm.movePtr(StackPointer, FramePointer);
+  masm.Push(ICStubReg);
+
+  // Stack should remain aligned.
+  masm.assertStackAlignment(sizeof(Value), 0);
+}
+
+}  // namespace jit
+}  // namespace js
+
+#endif /* jit_ia64_SharedICHelpers_ia64_inl_h */
diff --git a/b/js/src/jit/ia64/SharedICHelpers-ia64.h b/js/src/jit/ia64/SharedICHelpers-ia64.h
new file mode 100644
--- /dev/null
+++ b/js/src/jit/ia64/SharedICHelpers-ia64.h
@@ -0,0 +1,77 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#ifndef jit_ia64_SharedICHelpers_ia64_h
+#define jit_ia64_SharedICHelpers_ia64_h
+
+#include "jit/BaselineIC.h"
+#include "jit/JitFrames.h"
+#include "jit/MacroAssembler.h"
+#include "jit/SharedICRegisters.h"
+
+namespace js {
+namespace jit {
+
+// IA-64 is a JS_USE_LINK_REGISTER platform: br.call leaves the return address
+// in b0, and the callee spills it with pushReturnAddress(). Nothing pushes a
+// return address caller-side, so there is none on the stack below an IC stub.
+
+// Distance from the stack top to the top Value inside an IC stub (no return
+// address on the stack on ia64).
+static const size_t ICStackValueOffset = 0;
+
+inline void EmitRestoreTailCallReg(MacroAssembler& masm) {
+  // No-op: b0 still holds the return address.
+}
+
+inline void EmitRepushTailCallReg(MacroAssembler& masm) {
+  // No-op: b0 still holds the return address.
+}
+
+inline void EmitCallIC(MacroAssembler& masm, CodeOffset* callOffset) {
+  // The stub pointer must already be in ICStubReg.
+  *callOffset = masm.callICEntry(Address(ICStubReg, ICStub::offsetOfStubCode()));
+}
+
+inline void EmitReturnFromIC(MacroAssembler& masm) {
+  // Return through b0, still holding the return address left by EmitCallIC.
+  masm.abiret();
+}
+
+inline void EmitBaselineLeaveStubFrame(MacroAssembler& masm) {
+  Address stubAddr(FramePointer, BaselineStubFrameLayout::ICStubOffsetFromFP);
+  masm.loadPtr(stubAddr, ICStubReg);
+
+  masm.movePtr(FramePointer, StackPointer);
+  masm.Pop(FramePointer);
+
+  // The return address is on top of the stack, followed by the frame
+  // descriptor. Restore it to b0 and discard the descriptor.
+  masm.popReturnAddress();
+  masm.freeStack(sizeof(uintptr_t));
+}
+
+template <typename AddrType>
+inline void EmitPreBarrier(MacroAssembler& masm, const AddrType& addr,
+                           MIRType type) {
+  // b0 is clobbered by the call inside guardedCallPreBarrier. Save it first.
+  masm.pushReturnAddress();
+  masm.guardedCallPreBarrier(addr, type);
+  masm.popReturnAddress();
+}
+
+inline void EmitStubGuardFailure(MacroAssembler& masm) {
+  // Load next stub into ICStubReg.
+  masm.loadPtr(Address(ICStubReg, ICCacheIRStub::offsetOfNext()), ICStubReg);
+
+  // The return address is still in b0; just jump to the next stub code.
+  masm.jump(Address(ICStubReg, ICStub::offsetOfStubCode()));
+}
+
+}  // namespace jit
+}  // namespace js
+
+#endif /* jit_ia64_SharedICHelpers_ia64_h */
diff --git a/b/js/src/jit/ia64/SharedICRegisters-ia64.h b/js/src/jit/ia64/SharedICRegisters-ia64.h
new file mode 100644
--- /dev/null
+++ b/js/src/jit/ia64/SharedICRegisters-ia64.h
@@ -0,0 +1,60 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#ifndef jit_ia64_SharedICRegisters_ia64_h
+#define jit_ia64_SharedICRegisters_ia64_h
+
+#include "jit/ia64/MacroAssembler-ia64.h"
+#include "jit/Registers.h"
+#include "jit/RegisterSets.h"
+
+namespace js {
+namespace jit {
+
+// All of these come from the static register file r0-r31; the register-stack
+// window r32-r39 is reserved for outgoing ABI arguments and is never handed to
+// the register allocator (see [SMDOC] in Architecture-ia64.h).
+//
+// Already spoken for by Assembler-ia64.h: r0-r3 (zero/gp/scratch), r4
+// (FramePointer), r7 (ObjectTagReg), r6 (InstanceReg), r8 (ReturnReg), r12 (sp), r13 (tp), r15
+// (OsrFrameReg), r16 (PreBarrierReg), r17 (InterpreterPCReg), r18-r23
+// (CallTempReg0-5).
+
+// ValueOperands R0, R1 and R2. On PUNBOX64 a Value is a single 64-bit
+// register. Shared IC code static_asserts R0 == JSReturnOperand, so R0 is
+// defined in terms of it rather than picked here; Assembler-ia64.h still needs
+// to give JSReturnReg a real register (r24 is free). R1 is callee-saved so its
+// value survives calls; R2 is the volatile scratch pair.
+static constexpr ValueOperand R0 = JSReturnOperand;
+static constexpr ValueOperand R1(Register{Registers::r5});
+static constexpr ValueOperand R2(Register{Registers::r26});
+
+// ICTailCallReg and ICStubReg use volatile static registers. Unlike the
+// register-based ABIs, an IA-64 C call takes its arguments in the r32-r39
+// window, so no ABI call can clobber these by argument passing; they are only
+// at risk across a call, and the stub frame spills them there.
+//
+// The JIT return address itself lives in branch register b0 (written by
+// br.call), not in ICTailCallReg; b0 is not a general register, so
+// ICTailCallReg is the GPR used to shuffle it to and from the stack. See
+// SharedICHelpers-ia64.h.
+static constexpr Register ICTailCallReg{Registers::r31};
+static constexpr Register ICStubReg{Registers::r30};
+
+// FloatReg0 must be equal to ReturnDoubleReg.
+static constexpr FloatRegister FloatReg0 = {FloatRegisters::f8,
+                                            FloatRegister::Double};
+static constexpr FloatRegister FloatReg1 = {FloatRegisters::f9,
+                                            FloatRegister::Double};
+static constexpr FloatRegister FloatReg2 = {FloatRegisters::f10,
+                                            FloatRegister::Double};
+static constexpr FloatRegister FloatReg3 = {FloatRegisters::f11,
+                                            FloatRegister::Double};
+
+}  // namespace jit
+}  // namespace js
+
+#endif /* jit_ia64_SharedICRegisters_ia64_h */
diff --git a/b/js/src/jit/ia64/Trampoline-ia64.cpp b/js/src/jit/ia64/Trampoline-ia64.cpp
new file mode 100644
--- /dev/null
+++ b/js/src/jit/ia64/Trampoline-ia64.cpp
@@ -0,0 +1,567 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#include "jit/Bailouts.h"
+#include "jit/BaselineFrame.h"
+#include "jit/BaselineIC.h"
+#include "jit/CalleeToken.h"
+#include "jit/ia64/SharedICRegisters-ia64.h"
+#include "jit/JitFrames.h"
+#include "jit/JitRuntime.h"
+#include "jit/PerfSpewer.h"
+#include "jit/VMFunctions.h"
+#include "vm/JitActivation.h"
+#include "vm/JSContext.h"
+#include "vm/Realm.h"
+
+#include "jit/MacroAssembler-inl.h"
+
+using namespace js;
+using namespace js::jit;
+
+static_assert(sizeof(uintptr_t) == sizeof(uint64_t), "Not 64-bit clean.");
+
+// The register dump covers every architecturally visible register, including
+// the r32-r39 outgoing window, because RegisterDump is indexed by register
+// code. IA-64 has no packed SIMD in the FP file, so there is no separate
+// vector set to worry about.
+static const LiveRegisterSet AllRegs =
+    LiveRegisterSet(GeneralRegisterSet(Registers::AllMask),
+                    FloatRegisterSet(FloatRegisters::AllMask));
+
+// Restrict the wrapper and volatile sets to registers the JIT may actually
+// touch: Registers::VolatileMask nominally contains r0 (zero), gp, the two
+// assembler scratches, sp and tp, none of which may be spilled or handed out.
+static constexpr Registers::SetType SafeVolatileMask =
+    Registers::VolatileMask & Registers::AllocatableMask;
+static constexpr FloatRegisters::SetType SafeFloatVolatileMask =
+    FloatRegisters::VolatileMask & FloatRegisters::AllocatableMask;
+
+// Registers holding EnterJitCode's arguments once they have been copied out of
+// the incoming register-stack window, plus the two temporaries the prologue
+// needs for ar.pfs and b0. All are static (r0-r31) registers, so `alloc` does
+// not disturb them.
+static constexpr Register reg_code{Registers::r14};
+static constexpr Register reg_argc{Registers::r24};
+static constexpr Register reg_argv{Registers::r25};
+static constexpr Register reg_token{Registers::r26};
+static constexpr Register reg_chain{Registers::r27};
+static constexpr Register reg_values{Registers::r28};
+static constexpr Register reg_vp{Registers::r29};
+static constexpr Register reg_pfs{Registers::r30};
+static constexpr Register reg_b0{Registers::r31};
+
+static constexpr Register Reg5{Registers::r5};
+static constexpr Register Reg6{Registers::r6};
+static constexpr Register Reg7{Registers::r7};
+
+static FloatRegister Fp(uint32_t code) {
+  return FloatRegister(FloatRegisters::Code(code), FloatRegister::Double);
+}
+
+// Callee-saved state saved by the C entry trampoline. f2-f5 and f16-f31 are
+// preserved by the psABI; f2/f3 are additionally the JIT's floating point
+// scratch, so they have to be saved here as well. alignas(16) keeps sizeof a
+// multiple of 16, which is what keeps sp 16-byte aligned after reserveStack.
+struct alignas(16) EnterJITRegs {
+  double f31;
+  double f30;
+  double f29;
+  double f28;
+  double f27;
+  double f26;
+  double f25;
+  double f24;
+  double f23;
+  double f22;
+  double f21;
+  double f20;
+  double f19;
+  double f18;
+  double f17;
+  double f16;
+  double f5;
+  double f4;
+  double f3;
+  double f2;
+
+  uint64_t r7;
+  uint64_t r6;
+  uint64_t r5;
+  uint64_t r4;   // FramePointer
+  uint64_t gp;   // r1
+  uint64_t pfs;  // ar.pfs, as saved by the prologue's alloc
+  uint64_t b0;   // return branch register
+  uint64_t vp;   // EnterJitCode's |vp|, needed again after the JIT call
+};
+
+static_assert((sizeof(EnterJITRegs) % 16) == 0,
+              "EnterJITRegs must keep sp 16-byte aligned");
+
+static void GeneratePrologue(MacroAssembler& masm) {
+  // EnterJitCode's eight arguments arrive in the caller's outgoing register
+  // window, which this procedure sees as r32-r39 (IntArgReg0-7) until it runs
+  // its own `alloc`. That alloc redefines r32-r39 as *this* frame's outgoing
+  // window and discards the incoming values, so copy them into static
+  // registers first.
+  masm.movePtr(IntArgReg0, reg_code);
+  masm.movePtr(IntArgReg1, reg_argc);
+  masm.movePtr(IntArgReg2, reg_argv);
+  masm.movePtr(IntArgReg3, OsrFrameReg);
+  masm.movePtr(IntArgReg4, reg_token);
+  masm.movePtr(IntArgReg5, reg_chain);
+  masm.movePtr(IntArgReg6, reg_values);
+  masm.movePtr(IntArgReg7, reg_vp);
+
+  // Create the outgoing-argument window out0-out7 used for every C call made
+  // from JIT code, and capture the caller's frame marker. ins = locals = 0, so
+  // a later br.call leaves CFM unchanged (new sof = sof - sol = 8) and the
+  // window stays valid across nested calls.
+  masm.emitM(ia64::Alloc(reg_pfs.encoding(), 0, 0, 8, 0));
+
+  // b0 holds the return address written by the caller's br.call; it is not a
+  // general register, so move it before it can be spilled.
+  masm.emitI(ia64::MovFromBr(reg_b0.encoding(), 0));
+
+  masm.reserveStack(sizeof(EnterJITRegs));
+
+  masm.storePtr(reg_pfs, Address(StackPointer, offsetof(EnterJITRegs, pfs)));
+  masm.storePtr(reg_b0, Address(StackPointer, offsetof(EnterJITRegs, b0)));
+  masm.storePtr(GpReg, Address(StackPointer, offsetof(EnterJITRegs, gp)));
+  masm.storePtr(FramePointer, Address(StackPointer, offsetof(EnterJITRegs, r4)));
+  masm.storePtr(Reg5, Address(StackPointer, offsetof(EnterJITRegs, r5)));
+  masm.storePtr(Reg6, Address(StackPointer, offsetof(EnterJITRegs, r6)));
+  masm.storePtr(Reg7, Address(StackPointer, offsetof(EnterJITRegs, r7)));
+  // Not emitLoadImm(): that reads ObjectTagReg for this very constant.
+  masm.emitMovl(ObjectTagReg.encoding(), JSVAL_SHIFTED_TAG_OBJECT);
+  masm.storePtr(reg_vp, Address(StackPointer, offsetof(EnterJITRegs, vp)));
+
+  masm.storeDouble(Fp(FloatRegisters::f2),
+                   Address(StackPointer, offsetof(EnterJITRegs, f2)));
+  masm.storeDouble(Fp(FloatRegisters::f3),
+                   Address(StackPointer, offsetof(EnterJITRegs, f3)));
+  masm.storeDouble(Fp(FloatRegisters::f4),
+                   Address(StackPointer, offsetof(EnterJITRegs, f4)));
+  masm.storeDouble(Fp(FloatRegisters::f5),
+                   Address(StackPointer, offsetof(EnterJITRegs, f5)));
+  for (uint32_t i = 0; i < 16; i++) {
+    size_t offset = offsetof(EnterJITRegs, f16) - i * sizeof(double);
+    masm.storeDouble(Fp(FloatRegisters::f16 + i),
+                     Address(StackPointer, offset));
+  }
+}
+
+static void GenerateReturn(MacroAssembler& masm) {
+  MOZ_ASSERT(masm.framePushed() == sizeof(EnterJITRegs));
+
+  masm.loadPtr(Address(StackPointer, offsetof(EnterJITRegs, gp)), GpReg);
+  masm.loadPtr(Address(StackPointer, offsetof(EnterJITRegs, r4)), FramePointer);
+  masm.loadPtr(Address(StackPointer, offsetof(EnterJITRegs, r5)), Reg5);
+  masm.loadPtr(Address(StackPointer, offsetof(EnterJITRegs, r6)), Reg6);
+  masm.loadPtr(Address(StackPointer, offsetof(EnterJITRegs, r7)), Reg7);
+
+  masm.loadDouble(Address(StackPointer, offsetof(EnterJITRegs, f2)),
+                  Fp(FloatRegisters::f2));
+  masm.loadDouble(Address(StackPointer, offsetof(EnterJITRegs, f3)),
+                  Fp(FloatRegisters::f3));
+  masm.loadDouble(Address(StackPointer, offsetof(EnterJITRegs, f4)),
+                  Fp(FloatRegisters::f4));
+  masm.loadDouble(Address(StackPointer, offsetof(EnterJITRegs, f5)),
+                  Fp(FloatRegisters::f5));
+  for (uint32_t i = 0; i < 16; i++) {
+    size_t offset = offsetof(EnterJITRegs, f16) - i * sizeof(double);
+    masm.loadDouble(Address(StackPointer, offset), Fp(FloatRegisters::f16 + i));
+  }
+
+  masm.loadPtr(Address(StackPointer, offsetof(EnterJITRegs, pfs)), reg_pfs);
+  masm.loadPtr(Address(StackPointer, offsetof(EnterJITRegs, b0)), reg_b0);
+
+  masm.freeStack(sizeof(EnterJITRegs));
+
+  // br.ret restores CFM from ar.pfs, so ar.pfs has to be back in place first;
+  // that is what unwinds this frame's register-stack window.
+  masm.emitI(ia64::MovToPfs(reg_pfs.encoding()));
+  masm.emitI(ia64::MovToBr(0, reg_b0.encoding()));
+  masm.emitB(ia64::BrRet(0));
+}
+
+void JitRuntime::generateEnterJIT(JSContext* cx, MacroAssembler& masm,
+                                  EnterJitMode mode) {
+  AutoCreatedBy acb(masm, "JitRuntime::generateEnterJIT");
+
+  if (mode == EnterJitMode::GeneratorResume) {
+    enterJITGeneratorResumeOffset_ = startTrampolineCode(masm);
+  } else {
+    enterJITOffset_ = startTrampolineCode(masm);
+  }
+
+  // The IA-64 return address is in b0, not on the stack, so sp is already
+  // fully aligned on entry.
+  masm.assertStackAlignment(ABIStackAlignment, 0);
+
+  GeneratePrologue(masm);
+
+  // The saved-register block doubles as this trampoline's frame.
+  masm.movePtr(StackPointer, FramePointer);
+
+  if (mode == EnterJitMode::GeneratorResume) {
+    generateEnterJitResumeShared(masm, reg_argv, reg_token, CallTempReg0,
+                                 CallTempReg1);
+  } else {
+    generateEnterJitShared(masm, reg_argc, reg_argv, reg_token, CallTempReg0,
+                           CallTempReg1, CallTempReg2);
+
+    // Push the descriptor.
+    masm.unboxInt32(Address(reg_vp, 0), reg_argc);
+    masm.pushFrameDescriptorForJitCall(FrameType::CppToJSJit, reg_argc,
+                                       reg_argc);
+  }
+
+  CodeLabel returnLabel;
+  Label oomReturnLabel;
+  if (mode != EnterJitMode::GeneratorResume) {
+    // Handle Interpreter -> Baseline OSR.
+    AllocatableGeneralRegisterSet regs(GeneralRegisterSet::All());
+    regs.takeUnchecked(FramePointer);
+    regs.takeUnchecked(OsrFrameReg);
+    regs.takeUnchecked(reg_code);
+
+    Label notOsr;
+    masm.branchTestPtr(Assembler::Zero, OsrFrameReg, OsrFrameReg, &notOsr);
+
+    Register numStackValues = reg_values;
+    regs.takeUnchecked(numStackValues);
+    Register scratch = regs.takeAny();
+
+    // Push the return address, then the previous frame pointer.
+    masm.subPtr(Imm32(sizeof(uintptr_t)), StackPointer);
+    masm.mov(&returnLabel, scratch);
+    masm.storePtr(scratch, Address(StackPointer, 0));
+
+    masm.subPtr(Imm32(sizeof(uintptr_t)), StackPointer);
+    masm.storePtr(FramePointer, Address(StackPointer, 0));
+
+    // Reserve the BaselineFrame.
+    Register framePtr = FramePointer;
+    masm.movePtr(StackPointer, framePtr);
+    masm.subPtr(Imm32(BaselineFrame::Size()), StackPointer);
+
+    Register framePtrScratch = regs.takeAny();
+    masm.movePtr(StackPointer, framePtrScratch);
+
+    // Reserve space for locals and stack values.
+    masm.movePtr(numStackValues, scratch);
+    masm.lshiftPtr(Imm32(3), scratch);
+    masm.subPtr(scratch, StackPointer);
+
+    // Enter the exit frame: descriptor, fake return address, frame pointer.
+    masm.reserveStack(3 * sizeof(uintptr_t));
+    masm.storePtr(ImmWord(MakeFrameDescriptor(FrameType::BaselineJS)),
+                  Address(StackPointer, 2 * sizeof(uintptr_t)));
+    masm.storePtr(ImmPtr(nullptr), Address(StackPointer, sizeof(uintptr_t)));
+    masm.storePtr(FramePointer, Address(StackPointer, 0));
+
+    // No GC things to mark, push a bare token.
+    masm.loadJSContext(scratch);
+    masm.enterFakeExitFrame(scratch, scratch, ExitFrameType::Bare);
+
+    masm.reserveStack(2 * sizeof(uintptr_t));
+    masm.storePtr(framePtr, Address(StackPointer, sizeof(uintptr_t)));
+    masm.storePtr(reg_code, Address(StackPointer, 0));
+
+    using Fn = void (*)(BaselineFrame* frame, InterpreterFrame* interpFrame,
+                        uint32_t numStackValues);
+    masm.setupUnalignedABICall(scratch);
+    masm.passABIArg(framePtrScratch);
+    masm.passABIArg(OsrFrameReg);
+    masm.passABIArg(numStackValues);
+    masm.callWithABI<Fn, jit::InitBaselineFrameForOsr>(
+        ABIType::General, CheckUnsafeCallWithABI::DontCheckHasExitFrame);
+
+    regs.add(OsrFrameReg);
+    Register jitcode = regs.takeAny();
+    masm.loadPtr(Address(StackPointer, 0), jitcode);
+    masm.loadPtr(Address(StackPointer, sizeof(uintptr_t)), framePtr);
+    masm.freeStack(2 * sizeof(uintptr_t));
+
+    masm.freeStack(ExitFrameLayout::SizeWithFooter());
+
+    {
+      Label skipProfilingInstrumentation;
+      AbsoluteAddress addressOfEnabled(
+          cx->runtime()->geckoProfiler().addressOfEnabled());
+      masm.branch32(Assembler::Equal, addressOfEnabled, Imm32(0),
+                    &skipProfilingInstrumentation);
+      masm.profilerEnterFrame(framePtr, scratch);
+      masm.bind(&skipProfilingInstrumentation);
+    }
+
+    masm.jump(jitcode);
+
+    masm.bind(&notOsr);
+    MOZ_ASSERT(R1.scratchReg() != reg_code);
+    masm.movePtr(reg_chain, R1.scratchReg());
+  }
+
+  // The call pushes the return address and the frame pointer, so check that
+  // the stack will be aligned once the call is complete.
+  masm.assertStackAlignment(JitStackAlignment, 2 * sizeof(uintptr_t));
+
+  masm.callJitNoProfiler(reg_code);
+
+  if (mode != EnterJitMode::GeneratorResume) {
+    // Interpreter -> Baseline OSR returns here.
+    masm.bind(&returnLabel);
+    masm.addCodeLabel(returnLabel);
+    masm.bind(&oomReturnLabel);
+  }
+
+  // Discard arguments and padding; sp goes back to the EnterJITRegs block.
+  masm.movePtr(FramePointer, StackPointer);
+  masm.setFramePushed(sizeof(EnterJITRegs));
+
+  // Store the returned value into vp.
+  masm.loadPtr(Address(StackPointer, offsetof(EnterJITRegs, vp)), reg_vp);
+  masm.storeValue(JSReturnOperand, Address(reg_vp, 0));
+
+  GenerateReturn(masm);
+}
+
+// static
+mozilla::Maybe<::JS::ProfilingFrameIterator::RegisterState>
+JitRuntime::getCppEntryRegisters(JitFrameLayout* frameStackAddress) {
+  // The C entry state lives partly in the register stack backing store, which
+  // the profiler has no way to walk; report nothing rather than something
+  // wrong.
+  return mozilla::Nothing{};
+}
+
+void JitRuntime::generateInvalidator(MacroAssembler& masm, Label* bailoutTail) {
+  AutoCreatedBy acb(masm, "JitRuntime::generateInvalidator");
+
+  invalidatorOffset_ = startTrampolineCode(masm);
+
+  // Push all registers so they can be accessed as [base + code].
+  masm.PushRegsInMask(AllRegs);
+
+  masm.movePtr(StackPointer, CallTempReg0);
+
+  // Make space for InvalidationBailout's bailoutInfo outparam.
+  masm.reserveStack(sizeof(void*));
+  masm.movePtr(StackPointer, CallTempReg1);
+
+  using Fn = bool (*)(InvalidationBailoutStack* sp, BaselineBailoutInfo** info);
+  masm.setupUnalignedABICall(CallTempReg2);
+  masm.passABIArg(CallTempReg0);
+  masm.passABIArg(CallTempReg1);
+  masm.callWithABI<Fn, InvalidationBailout>(
+      ABIType::General, CheckUnsafeCallWithABI::DontCheckOther);
+
+  masm.pop(CallTempReg1);
+
+  // Pop the machine state and the dead frame.
+  masm.moveToStackPtr(FramePointer);
+
+  masm.jump(bailoutTail);
+}
+
+static void GenerateBailoutThunk(MacroAssembler& masm, Label* bailoutTail) {
+  masm.PushRegsInMask(AllRegs);
+  masm.movePtr(StackPointer, CallTempReg0);
+
+  // Make space for Bailout's bailoutInfo outparam.
+  masm.reserveStack(sizeof(void*));
+  masm.movePtr(StackPointer, CallTempReg1);
+
+  using Fn = bool (*)(BailoutStack* sp, BaselineBailoutInfo** info);
+  masm.setupUnalignedABICall(CallTempReg2);
+  masm.passABIArg(CallTempReg0);
+  masm.passABIArg(CallTempReg1);
+  masm.callWithABI<Fn, Bailout>(ABIType::General,
+                                CheckUnsafeCallWithABI::DontCheckOther);
+
+  masm.pop(CallTempReg1);
+
+  // Remove both the bailout frame and the topmost Ion frame's stack.
+  masm.moveToStackPtr(FramePointer);
+
+  masm.jump(bailoutTail);
+}
+
+void JitRuntime::generateBailoutHandler(MacroAssembler& masm,
+                                        Label* bailoutTail) {
+  AutoCreatedBy acb(masm, "JitRuntime::generateBailoutHandler");
+
+  bailoutHandlerOffset_ = startTrampolineCode(masm);
+
+  GenerateBailoutThunk(masm, bailoutTail);
+}
+
+bool JitRuntime::generateVMWrapper(JSContext* cx, MacroAssembler& masm,
+                                   VMFunctionId id, const VMFunctionData& f,
+                                   DynFn nativeFun, uint32_t* wrapperOffset) {
+  AutoCreatedBy acb(masm, "JitRuntime::generateVMWrapper");
+
+  *wrapperOffset = startTrampolineCode(masm);
+
+  AllocatableGeneralRegisterSet regs(Register::Codes::WrapperMask &
+                                     Register::Codes::AllocatableMask);
+
+  static_assert(
+      (Register::Codes::VolatileMask & ~Register::Codes::WrapperMask) == 0,
+      "Wrapper register set must be a superset of Volatile register set");
+
+  // The context is the first argument. IntArgReg0 lives in the outgoing
+  // window, which is not part of the allocatable set.
+  Register cxreg = IntArgReg0;
+  regs.takeUnchecked(cxreg);
+
+  // On entry b0 holds the return address and the stack is:
+  //    ... frame ...
+  //  +8  [args]
+  //  +0  descriptor
+  //
+  // Spill b0 so the stack matches the exit-frame layout:
+  //  +16 [args] / +8 descriptor / +0 returnAddress
+  masm.pushReturnAddress();
+
+  // Push the frame pointer to finish the exit frame, then link it up.
+  masm.Push(FramePointer);
+  masm.moveStackPtrTo(FramePointer);
+  masm.loadJSContext(cxreg);
+  masm.enterExitFrame(cxreg, regs.getAny(), id);
+
+  // Reserve space for the outparameter.
+  masm.reserveVMFunctionOutParamSpace(f);
+
+  masm.setupUnalignedABICallDontSaveRestoreSP();
+  masm.passABIArg(cxreg);
+
+  size_t argDisp = ExitFrameLayout::Size();
+
+  for (uint32_t explicitArg = 0; explicitArg < f.explicitArgs; explicitArg++) {
+    switch (f.argProperties(explicitArg)) {
+      case VMFunctionData::WordByValue:
+        if (f.argPassedInFloatReg(explicitArg)) {
+          masm.passABIArg(MoveOperand(FramePointer, argDisp), ABIType::Float64);
+        } else {
+          masm.passABIArg(MoveOperand(FramePointer, argDisp), ABIType::General);
+        }
+        argDisp += sizeof(void*);
+        break;
+      case VMFunctionData::WordByRef:
+        masm.passABIArg(MoveOperand(FramePointer, argDisp,
+                                    MoveOperand::Kind::EffectiveAddress),
+                        ABIType::General);
+        argDisp += sizeof(void*);
+        break;
+      case VMFunctionData::DoubleByValue:
+      case VMFunctionData::DoubleByRef:
+        MOZ_CRASH("NYI: ia64 callVM should not be used with 128bit values.");
+    }
+  }
+
+  // Copy the implicit outparam, if any.
+  const int32_t outParamOffset =
+      -int32_t(ExitFooterFrame::Size()) - f.sizeOfOutParamStackSlot();
+  if (f.outParam != Type_Void) {
+    masm.passABIArg(MoveOperand(FramePointer, outParamOffset,
+                                MoveOperand::Kind::EffectiveAddress),
+                    ABIType::General);
+  }
+
+  masm.callWithABI(nativeFun, ABIType::General,
+                   CheckUnsafeCallWithABI::DontCheckHasExitFrame);
+
+  switch (f.failType()) {
+    case Type_Cell:
+      masm.branchTestPtr(Assembler::Zero, ReturnReg, ReturnReg,
+                         masm.failureLabel());
+      break;
+    case Type_Bool:
+      masm.branchIfFalseBool(ReturnReg, masm.failureLabel());
+      break;
+    case Type_Void:
+      break;
+    default:
+      MOZ_CRASH("unknown failure kind");
+  }
+
+  masm.loadVMFunctionOutParam(f, Address(FramePointer, outParamOffset));
+
+  // Pop the frame and restore the frame pointer.
+  masm.moveToStackPtr(FramePointer);
+  masm.pop(FramePointer);
+
+  // Return, subtracting sizeof(void*) for the frame pointer.
+  masm.retn(Imm32(sizeof(ExitFrameLayout) - sizeof(void*) +
+                  f.explicitStackSlots() * sizeof(void*) +
+                  f.extraValuesToPop * sizeof(Value)));
+
+  return true;
+}
+
+uint32_t JitRuntime::generatePreBarrier(JSContext* cx, MacroAssembler& masm,
+                                        MIRType type) {
+  AutoCreatedBy acb(masm, "JitRuntime::generatePreBarrier");
+
+  uint32_t offset = startTrampolineCode(masm);
+
+  Register temp1 = CallTempReg0;
+  Register temp2 = CallTempReg1;
+  Register temp3 = CallTempReg2;
+
+  // b0 is clobbered by the callWithABI below, so spill it on entry; both exit
+  // paths restore it before branching.
+  masm.pushReturnAddress();
+  masm.push(temp1);
+  masm.push(temp2);
+  masm.push(temp3);
+
+  Label noBarrier;
+  masm.emitPreBarrierFastPath(type, temp1, temp2, temp3, &noBarrier);
+
+  // Call into C++ to mark this GC thing.
+  masm.pop(temp3);
+  masm.pop(temp2);
+  masm.pop(temp1);
+
+  LiveRegisterSet save =
+      LiveRegisterSet(GeneralRegisterSet(SafeVolatileMask),
+                      FloatRegisterSet(SafeFloatVolatileMask));
+  masm.PushRegsInMask(save);
+
+  masm.movePtr(ImmPtr(cx->runtime()), CallTempReg3);
+
+  masm.setupUnalignedABICall(CallTempReg4);
+  masm.passABIArg(CallTempReg3);
+  masm.passABIArg(PreBarrierReg);
+  masm.callWithABI(JitPreWriteBarrier(type));
+
+  masm.PopRegsInMask(save);
+  masm.popReturnAddress();
+  masm.abiret();
+
+  masm.bind(&noBarrier);
+  masm.pop(temp3);
+  masm.pop(temp2);
+  masm.pop(temp1);
+  masm.popReturnAddress();
+  masm.abiret();
+
+  return offset;
+}
+
+void JitRuntime::generateBailoutTailStub(MacroAssembler& masm,
+                                         Label* bailoutTail) {
+  AutoCreatedBy acb(masm, "JitRuntime::generateBailoutTailStub");
+
+  masm.bind(bailoutTail);
+  // generateBailoutTail() pins BailoutStubHandlerReg, which is CallTempReg0,
+  // and uses its scratch for everything else: hand it a different temp, and
+  // keep CallTempReg1 with the BaselineBailoutInfo* the thunks leave there.
+  masm.generateBailoutTail(CallTempReg3, CallTempReg1);
+}
