 #if defined(JS_CODEGEN_ARM) || defined(JS_CODEGEN_ARM64) ||      \
     defined(JS_CODEGEN_MIPS64) || defined(JS_CODEGEN_LOONG64) || \
-    defined(JS_CODEGEN_WASM32) || defined(JS_CODEGEN_RISCV64)
-// Push return addresses callee-side.
+    defined(JS_CODEGEN_WASM32) || defined(JS_CODEGEN_RISCV64) || \
+    defined(JS_CODEGEN_IA64)
+// Push return addresses callee-side. IA-64's br.call/br.ret convention
+// leaves the return address in b0 exactly like a link register, so it
+// belongs in this group rather than the stack-based x86/x64 style.
 #  define JS_USE_LINK_REGISTER
