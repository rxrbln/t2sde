@@ -1222,8 +1222,19 @@ void MacroAssembler::branchIfNotStringCh
                             : sizeof(char16_t);
   size_t byteLength = StringCharsByteLength(str);
 
+  // Targets that trap on unaligned access cannot use the multi-character
+  // strides: string characters are only guaranteed to be aligned to their own
+  // size, and the overlapping trailing comparison below deliberately reads at
+  // an unaligned offset (e.g. "exam" then "mple" for "example"). Restrict the
+  // stride to the character size there; the strings handled here are at most
+  // ByteLengthCompareCutoff bytes, so the cost is bounded.
+  size_t maxStride = SupportsUnalignedAccesses() ? 8 : encodingSize;
+
   size_t pos = 0;
   for (size_t stride : {8, 4, 2, 1}) {
+    if (stride > maxStride) {
+      continue;
+    }
     while (byteLength >= stride) {
       Address addr(stringChars, pos * encodingSize);
       switch (stride) {
@@ -1259,7 +1270,7 @@ void MacroAssembler::branchIfNotStringCh
     // For example when comparing against the string "example", emit two
     // four-byte comparisons against "exam" and "mple" instead of doing
     // three comparisons against "exam", "pl", and finally "e".
-    if (pos > 0 && byteLength > stride / 2) {
+    if (stride <= maxStride && pos > 0 && byteLength > stride / 2) {
       MOZ_ASSERT(stride == 8 || stride == 4);
 
       size_t prev = pos - (stride - byteLength) / encodingSize;
@@ -5253,6 +5264,11 @@ void MacroAssembler::callWithABINoProfil
   // rather than jumping to the descriptor as code (which call(ImmPtr) would do).
   movePtr(ImmPtr(fun), SecondScratchReg);
   callABIDescriptorELFv1(SecondScratchReg);
+#elif defined(JS_CODEGEN_IA64)
+  // Likewise on ia64, where a C function pointer is the address of a two-word
+  // {entry, gp} descriptor.
+  movePtr(ImmPtr(fun), SecondScratchReg);
+  callABIDescriptor(SecondScratchReg);
 #else
   call(ImmPtr(fun));
 #endif
@@ -9946,10 +9962,13 @@ void MacroAssembler::iteratorMore(Regist
   loadPtr(propAddr, temp);
 
   // Increase the cursor.
-#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+#if (defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__) || \
+    defined(JS_CODEGEN_IA64)
   // propertyCursor_ is a uint32_t. A pointer-sized increment would target the
   // high word of the 64-bit access on big-endian (i.e. the adjacent field),
-  // leaving the cursor unchanged so the iterator never advances.
+  // leaving the cursor unchanged so the iterator never advances. On IA-64 the
+  // field is only 4-byte aligned, so the 64-bit access traps and has to be
+  // emulated by the kernel.
   add32(Imm32(1), cursorAddr);
 #else
   addPtr(Imm32(1), cursorAddr);
