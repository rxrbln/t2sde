+FaultingCodeOffset MacroAssembler::storeDouble(FloatRegister src,
+                                               const Address& dest) {
+  return ma_storeFp(src.asDouble(), dest);
+}
+FaultingCodeOffset MacroAssembler::storeDouble(FloatRegister src,
+                                               const BaseIndex& dest) {
+  return ma_storeFp(src.asDouble(), dest);
+}
