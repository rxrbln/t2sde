+  // PatchDataWithValueCheck() rewrites.
+  CodeOffset pushWithPatch(ImmWord imm) {
+    CodeOffset offset(currentOffset());
+    emitMovl(ScratchReg.encoding(), imm.value);
+    push(ScratchReg);
+    return offset;
+  }
