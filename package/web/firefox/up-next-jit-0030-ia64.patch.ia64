diff --git a/js/src/jit/Assembler.h b/js/src/jit/Assembler.h
--- a/js/src/jit/Assembler.h
+++ b/js/src/jit/Assembler.h
@@ -19,6 +19,8 @@
 #  include "jit/loong64/Assembler-loong64.h"
 #elif defined(JS_CODEGEN_RISCV64)
 #  include "jit/riscv64/Assembler-riscv64.h"
+#elif defined(JS_CODEGEN_IA64)
+#  include "jit/ia64/Assembler-ia64.h"
 #elif defined(JS_CODEGEN_WASM32)
 #  include "jit/wasm32/Assembler-wasm32.h"
 #elif defined(JS_CODEGEN_NONE)
diff --git a/js/src/jit/BacktrackingAllocator.cpp b/js/src/jit/BacktrackingAllocator.cpp
--- a/js/src/jit/BacktrackingAllocator.cpp
+++ b/js/src/jit/BacktrackingAllocator.cpp
@@ -3376,7 +3376,11 @@ bool BacktrackingAllocator::chooseBundleSplit(LiveBundle* bundle, bool hasCall,
     return true;
   }
 
-  // Split at all register uses.
+  // Split at all register uses.  A bundle without a definition and with a
+  // single register use (a phi- or block-live value used once) becomes a
+  // minimal bundle around that use plus a spill bundle: strictly smaller
+  // unless the bundle was minimal already, which processBundle() handles
+  // before getting here.
   SplitPositionVector emptyPositions;
   return splitAt(bundle, emptyPositions);
 }
@@ -3791,6 +3795,16 @@ bool BacktrackingAllocator::processBundle(const MIRGenerator* mir,
     }
   }
 
+  // A minimal bundle cannot be split any further. If we still can't allocate
+  // it after all attempts, the register pressure is too high for this
+  // function. Abort the compilation and fall back to Baseline.
+  if (minimalBundle(bundle)) {
+    JitSpew(JitSpew_RegAlloc,
+            "Aborting because minimal bundle %s cannot be allocated",
+            bundle->toString().get());
+    return false;
+  }
+
   // A minimal bundle cannot be split any further. If we try to split it
   // it at this point we will just end up with the same bundle and will
   // enter an infinite loop. Weights and the initial live ranges must
diff --git a/js/src/jit/BaselineCacheIRCompiler.cpp b/js/src/jit/BaselineCacheIRCompiler.cpp
--- a/js/src/jit/BaselineCacheIRCompiler.cpp
+++ b/js/src/jit/BaselineCacheIRCompiler.cpp
@@ -2014,6 +2014,9 @@ static void ResetEnteredCounts(const ICEntry* icEntry) {
     if (stub->isFallback()) {
       return;
     }
+#ifdef JS_CODEGEN_IA64
+    stub->toCacheIRStub()->resetGCValueStores();
+#endif
     stub = stub->toCacheIRStub()->next();
   }
 }
diff --git a/js/src/jit/BaselineCodeGen.cpp b/js/src/jit/BaselineCodeGen.cpp
--- a/js/src/jit/BaselineCodeGen.cpp
+++ b/js/src/jit/BaselineCodeGen.cpp
@@ -114,6 +114,12 @@ BaselineCompiler::BaselineCompiler(TempAllocator& alloc,
 #ifdef JS_CODEGEN_NONE
   MOZ_CRASH();
 #endif
+#ifdef JS_CODEGEN_IA64
+  // Baseline compiles on the main thread, where scheduling costs more than it
+  // gains (Assembler::scheduling_). The Baseline Interpreter, generated once,
+  // keeps it.
+  masm.disableScheduling();
+#endif
 }
 
 BaselineInterpreterGenerator::BaselineInterpreterGenerator(JSContext* cx,
@@ -7347,6 +7353,15 @@ bool BaselineInterpreterGenerator::emitInterpreterLoop() {
     masm.addCodeLabel(cl);
   }
 
+#ifdef JS_CODEGEN_IA64
+  // Each entry is a bare pointer, which is half an ia64 bundle. JSOP_LIMIT is
+  // odd, so the table leaves the buffer 8 bytes out of bundle alignment -- and
+  // the epilogue generated next derives branch displacements from
+  // offset / sizeof(Bundle), which then names the wrong bundle and makes
+  // Assembler::bind() walk a label chain built out of misaligned reads.
+  masm.alignToBundle();
+#endif
+
   return true;
 }
 
diff --git a/js/src/jit/BaselineIC.h b/js/src/jit/BaselineIC.h
--- a/js/src/jit/BaselineIC.h
+++ b/js/src/jit/BaselineIC.h
@@ -279,6 +279,15 @@ class ICCacheIRStub final : public ICStub {
   uintptr_t padding_ = 0;
 #endif
 
+#ifdef JS_CODEGEN_IA64
+  // The Value post-barrier profile: how many of this stub's entries (since
+  // enteredCount_ was last reset) stored a GC thing
+  // (CacheIRCompiler::emitPostBarrierShared()).  WarpOracle passes the
+  // share on to Ion, which chooses the barrier's shape by it
+  // (CodeGenerator::emitPostWriteBarrierCrossableIA64()).
+  uint32_t gcValueStores_ = 0;
+#endif
+
  public:
   ICCacheIRStub(JitCode* stubCode, const CacheIRStubInfo* stubInfo)
       : ICStub(stubCode ? stubCode->raw() : nullptr, /* isFallback = */ false),
@@ -310,12 +319,23 @@ class ICCacheIRStub final : public ICStub {
     return offsetof(ICCacheIRStub, next_);
   }
 
+#ifdef JS_CODEGEN_IA64
+  uint32_t gcValueStores() const { return gcValueStores_; }
+  void resetGCValueStores() { gcValueStores_ = 0; }
+  static constexpr size_t offsetOfGCValueStores() {
+    return offsetof(ICCacheIRStub, gcValueStores_);
+  }
+#endif
+
   void setTypeData(TypeData data) { typeData_ = data; }
   TypeData typeData() const { return typeData_; }
 };
 
 // Assert stub size is what we expect to catch regressions.
-#ifdef JS_64BIT
+#if defined(JS_64BIT) && defined(JS_CODEGEN_IA64)
+static_assert(sizeof(ICFallbackStub) == 3 * sizeof(uintptr_t));
+static_assert(sizeof(ICCacheIRStub) == 5 * sizeof(uintptr_t));
+#elif defined(JS_64BIT)
 static_assert(sizeof(ICFallbackStub) == 3 * sizeof(uintptr_t));
 static_assert(sizeof(ICCacheIRStub) == 4 * sizeof(uintptr_t));
 #else
diff --git a/js/src/jit/CacheIRCompiler.cpp b/js/src/jit/CacheIRCompiler.cpp
--- a/js/src/jit/CacheIRCompiler.cpp
+++ b/js/src/jit/CacheIRCompiler.cpp
@@ -9209,6 +9209,15 @@ void CacheIRCompiler::emitPostBarrierShared(Register obj,
 
   Label skipBarrier;
   if (reg.hasValue()) {
+#ifdef JS_CODEGEN_IA64
+    // The Value post-barrier profile (ICCacheIRStub::gcValueStores_): ICStubReg
+    // holds the stub throughout Baseline stub code.
+    if (isBaseline()) {
+      masm.branchTestGCThing(Assembler::NotEqual, reg.valueReg(), &skipBarrier);
+      masm.add32(Imm32(1),
+                 Address(ICStubReg, ICCacheIRStub::offsetOfGCValueStores()));
+    }
+#endif
     masm.branchValueIsNurseryCell(Assembler::NotEqual, reg.valueReg(), scratch,
                                   &skipBarrier);
   } else {
@@ -10338,6 +10347,11 @@ bool CacheIRCompiler::emitConcatStringsResult(StringOperandId lhsId,
     liveRegs.add(ICTailCallReg);
 #endif
     liveRegs.takeUnchecked(output.valueReg());
+#ifdef JS_CODEGEN_IA64
+    // On IA-64 the return address lives in branch register b0, which
+    // ICTailCallReg does not shadow, and the inner br.call clobbers it.
+    masm.pushReturnAddress();
+#endif
     masm.PushRegsInMask(liveRegs);
 
     // The stub expects lhs in CallTempReg0 and rhs in CallTempReg1.
@@ -10358,11 +10372,17 @@ bool CacheIRCompiler::emitConcatStringsResult(StringOperandId lhsId,
     masm.branchTestPtr(Assembler::Zero, CallTempReg5, CallTempReg5, &vmCall);
     masm.tagValue(JSVAL_TYPE_STRING, CallTempReg5, output.valueReg());
     masm.PopRegsInMask(liveRegs);
+#ifdef JS_CODEGEN_IA64
+    masm.popReturnAddress();
+#endif
     masm.jump(&done);
 
     masm.bind(&vmCall);
     masm.setFramePushed(framePushed);
     masm.PopRegsInMask(liveRegs);
+#ifdef JS_CODEGEN_IA64
+    masm.popReturnAddress();
+#endif
   }
 
   {
diff --git a/js/src/jit/CodeGenerator.cpp b/js/src/jit/CodeGenerator.cpp
--- a/js/src/jit/CodeGenerator.cpp
+++ b/js/src/jit/CodeGenerator.cpp
@@ -23,6 +23,11 @@
 #include <limits>
 #include <type_traits>
 #include <utility>
+#ifdef JS_CODEGEN_IA64
+#  include <fcntl.h>
+#  include <string.h>
+#  include <unistd.h>
+#endif
 
 #include "builtin/MapObject.h"
 #include "builtin/Math.h"
@@ -610,7 +615,12 @@ void CodeGeneratorShared::addIC(LInstruction* lir, size_t cacheIndex) {
 
   Register temp = cache->scratchRegisterForEntryJump();
   icInfo_.back().icOffsetForJump = masm.movWithPatch(ImmWord(-1), temp);
+#ifdef JS_CODEGEN_IA64
+  // A branch register of its own: see MacroAssemblerIa64::ICEntryBr.
+  masm.jumpToICEntry(Address(temp, 0));
+#else
