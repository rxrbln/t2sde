+FaultingCodeRange MacroAssemblerIa64::store8(Imm32 imm,
+                                              const BaseIndex& dest) {
+  computeAddress(dest, ScratchReg);
+  move32(imm, SecondScratchReg);
+  FaultingCodeRange fco(emitFaulting(ia64::St1(ScratchReg.encoding(), SecondScratchReg.encoding())).getOffset());
+  return fco;
