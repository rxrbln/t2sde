diff --git a/js/src/jit/DiamondMerge.cpp b/js/src/jit/DiamondMerge.cpp
new file mode 100644
--- /dev/null
+++ b/js/src/jit/DiamondMerge.cpp
@@ -0,0 +1,724 @@
+/* -*- Mode: C++; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * vim: set ts=8 sts=2 et sw=2 tw=80:
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "jit/DiamondMerge.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "jit/MIR.h"
+#include "jit/MIRGenerator.h"
+#include "jit/MIRGraph.h"
+#include "vm/JSScript.h"
+
+using namespace js;
+using namespace js::jit;
+
+// Hoisting
+// --------
+//
+// B ends in MTest(c, T, F) and T and F have B as their only predecessor.  The
+// first instructions of T and F are compared in lockstep (constants that have
+// no partner are stepped over: they cannot fail and guard nothing).  A pair of
+// congruent, movable, non-effectful instructions is replaced by one instance
+// moved before B's MTest.  Both sides executed it before any effect, so the
+// hoisted instruction runs on the same paths as before, only earlier; if it
+// bails out it uses B's last resume point, which re-executes the branch.
+//
+// Sinking
+// -------
+//
+// T and F both end in MGoto(J), J's predecessors are exactly T and F.  The last
+// instructions of T and F are compared in lockstep (from the end, constants
+// stepped over again); a pair is sunk when it is the same operation (for pure
+// instructions: congruent once one differing operand is substituted; for the
+// stores below: same opcode and flags) and differs in at most one operand,
+// which becomes a new phi in J.  An instruction may only be used by phis of J
+// whose other input is its partner, which are then replaced by the sunk
+// instruction, or by the instructions sunk after it.
+//
+// Bailouts: a sunk instruction that fails in J must resume before the side ran
+// (J's entry resume point describes the state after it).  So sinking requires
+// that every effectful instruction of both sides is in the sunk suffix: then
+// nothing effectful runs between B's last resume point and the sunk code, and
+// J's entry resume point is replaced by a copy of B's.  A sunk store gets a
+// copy of J's original entry resume point as its resume point (ResumeAt J's
+// pc: the state after the side, which is complete once the store is done).
+
+namespace diamondmerge {
+
+const char* OpName(const MDefinition* def) {
+  static const char* const names[] = {
+#define NAME(x) #x,
+      MIR_OPCODE_LIST(NAME)
+#undef NAME
+  };
+  return names[unsigned(def->op())];
+}
+
+bool LogEnabled() {
+  static const bool enabled = getenv("JS_ION_DIAMOND_MERGE_LOG") != nullptr;
+  return enabled;
+}
+
+MResumePoint* LastResumePoint(MBasicBlock* block) {
+  for (MInstructionReverseIterator it = block->rbegin(); it != block->rend();
+       ++it) {
+    if (it->resumePoint()) {
+      return it->resumePoint();
+    }
+  }
+  return block->entryResumePoint();
+}
+
+bool PhiType(MIRType type) {
+  switch (type) {
+    case MIRType::Int32:
+    case MIRType::Double:
+    case MIRType::Float32:
+    case MIRType::Boolean:
+    case MIRType::Value:
+    case MIRType::Object:
+    case MIRType::String:
+    case MIRType::Symbol:
+    case MIRType::BigInt:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// Two operands are the same when they are the same definition or equal
+// constants (each side has its own MConstant for a literal).
+bool SameOperand(MDefinition* a, MDefinition* b) {
+  return a == b || (a->isConstant() && b->isConstant() && a->congruentTo(b));
+}
+
+// Effectful instructions that may be sunk: stores whose flags are all known.
+bool SameStore(MInstruction* a, MInstruction* b) {
+  if (a->op() != b->op()) {
+    return false;
+  }
+  switch (a->op()) {
+    case MDefinition::Opcode::StoreElement: {
+      MStoreElement* x = a->toStoreElement();
+      MStoreElement* y = b->toStoreElement();
+      return x->needsHoleCheck() == y->needsHoleCheck() &&
+             x->needsPreBarrier() == y->needsPreBarrier() &&
+             x->canUseElementPostBarrier() == y->canUseElementPostBarrier();
+    }
+    case MDefinition::Opcode::StoreUnboxedScalar: {
+      MStoreUnboxedScalar* x = a->toStoreUnboxedScalar();
+      MStoreUnboxedScalar* y = b->toStoreUnboxedScalar();
+      return x->writeType() == y->writeType() &&
+             x->requiresMemoryBarrier() == y->requiresMemoryBarrier();
+    }
+    case MDefinition::Opcode::StoreFixedSlot: {
+      MStoreFixedSlot* x = a->toStoreFixedSlot();
+      MStoreFixedSlot* y = b->toStoreFixedSlot();
+      return x->slot() == y->slot() &&
+             x->needsPreBarrier() == y->needsPreBarrier() &&
+             x->needsPostBarrier() == y->needsPostBarrier();
+    }
+    case MDefinition::Opcode::StoreDynamicSlot: {
+      MStoreDynamicSlot* x = a->toStoreDynamicSlot();
+      MStoreDynamicSlot* y = b->toStoreDynamicSlot();
+      return x->slot() == y->slot() &&
+             x->needsPreBarrier() == y->needsPreBarrier() &&
+             x->needsPostBarrier() == y->needsPostBarrier();
+    }
+    default:
+      return false;
+  }
+}
+
+// Non-effectful guards without a congruentTo that are safe to merge.
+bool SameBarrier(MInstruction* a, MInstruction* b) {
+  return a->op() == b->op() &&
+         (a->isPostWriteBarrier() || a->isPostWriteElementBarrier());
+}
+
+struct Pair {
+  MInstruction* a;  // in T: kept and moved
+  MInstruction* b;  // in F: discarded
+  int diff;         // operand index that gets a phi, or -1
+};
+
+using PairVector = Vector<Pair, 8, JitAllocPolicy>;
+
+class DiamondMerger {
+  const MIRGenerator* mir_;
+  MIRGraph& graph_;
+  TempAllocator& alloc_;
+
+  // survey counters
+  uint32_t candidates_ = 0, hoisted_ = 0, reused_ = 0, sunk_ = 0, phis_ = 0;
+  // where sink planning stopped, for the log
+  char stop_[160] = "";
+  // pairs that would sink if an effect could stay in a side (estimate)
+  size_t potential_ = 0;
+  void noteStop(const char* why, MDefinition* a, MDefinition* b) {
+    if (LogEnabled()) {
+      size_t len = strlen(stop_);
+      snprintf(stop_ + len, sizeof(stop_) - len, "%s%s (%s%u / %s%u)",
+               len ? "; " : "", why, OpName(a), a->id(),
+               b ? OpName(b) : "-", b ? b->id() : 0);
+    }
+  }
+
+  size_t hoist(MBasicBlock* pred, MBasicBlock* t, MBasicBlock* f,
+               Vector<MInstruction*, 16, JitAllocPolicy>& hoisted);
+  size_t reuseHoisted(MBasicBlock* side,
+                      Vector<MInstruction*, 16, JitAllocPolicy>& hoisted);
+  bool planSink(MBasicBlock* t, MBasicBlock* f, MBasicBlock* join,
+                PairVector& plan, const char** why);
+  bool applySink(MBasicBlock* pred, MBasicBlock* t, MBasicBlock* f,
+                 MBasicBlock* join, PairVector& plan);
+  void log(MBasicBlock* pred, const char* what, size_t sizeT, size_t sizeF,
+           size_t hoisted, size_t sunk, const char* why);
+
+ public:
+  DiamondMerger(const MIRGenerator* mir, MIRGraph& graph)
+      : mir_(mir), graph_(graph), alloc_(graph.alloc()) {}
+  bool run();
+};
+
+size_t CountInstructions(MBasicBlock* block) {
+  size_t n = 0;
+  for (MInstructionIterator it = block->begin(); it != block->end(); ++it) {
+    if (!it->isControlInstruction()) {
+      n++;
+    }
+  }
+  return n;
+}
+
+void DiamondMerger::log(MBasicBlock* pred, const char* what, size_t sizeT,
+                        size_t sizeF, size_t hoisted, size_t sunk,
+                        const char* why) {
+  if (!LogEnabled()) {
+    return;
+  }
+  const char* file = "?";
+  unsigned line = 0, fnLine = 0, fnColumn = 0;
+  const BytecodeSite* site = pred->lastIns()->trackedSite();
+  if (site && site->script() && site->pc()) {
+    file = site->script()->filename();
+    line = PCToLineNumber(site->script(), site->pc());
+    fnLine = site->script()->lineno();
+    fnColumn = site->script()->column().oneOriginValue();
+  }
+  size_t calls = 0;
+  for (size_t i = 0; i < 2; i++) {
+    MBasicBlock* side = pred->getSuccessor(i);
+    for (MInstructionIterator it = side->begin(); it != side->end(); ++it) {
+      calls += it->possiblyCalls();
+    }
+  }
+  fprintf(stderr,
+          "ion diamond merge: %s:%u %s sides %zu+%zu hoisted %zu sunk %zu "
+          "[potential %zu depth %u calls %zu fn %u:%u]%s%s\n",
+          file, line, what, sizeT, sizeF, hoisted, sunk, potential_,
+          pred->loopDepth(), calls, fnLine, fnColumn, why ? ": " : "",
+          why ? why : "");
+  static const bool verbose = getenv("JS_ION_DIAMOND_MERGE_LOG")[0] == '2';
+  if (verbose) {
+    for (size_t i = 0; i < 2; i++) {
+      MBasicBlock* side = pred->getSuccessor(i);
+      fprintf(stderr, "  side %zu:", i);
+      for (MInstructionIterator it = side->begin(); it != side->end(); ++it) {
+        fprintf(stderr, " %s%u", OpName(*it), it->id());
+        for (size_t k = 0; k < it->numOperands(); k++) {
+          fprintf(stderr, "%c%u", k ? ',' : '(', it->getOperand(k)->id());
+        }
+        if (it->numOperands()) {
+          fprintf(stderr, ")");
+        }
+      }
+      fprintf(stderr, "\n");
+    }
+  }
+}
+
+size_t DiamondMerger::hoist(MBasicBlock* pred, MBasicBlock* t,
+                            MBasicBlock* f,
+                            Vector<MInstruction*, 16, JitAllocPolicy>& hoisted) {
+  MInstruction* at = pred->lastIns();
+  MInstructionIterator ia = t->begin(), ib = f->begin();
+  size_t n = 0;
+  static const size_t MaxSkipped = 16;
+  size_t skipped = 0;
+  while (true) {
+    MInstruction* a = *ia;
+    MInstruction* b = *ib;
+    if (a->isControlInstruction() || b->isControlInstruction()) {
+      break;
+    }
+    bool pair = a->congruentTo(b);
+    // Step over what differs, as long as it can be reordered with what is
+    // hoisted past it: pure, movable and not a guard (only guards protect
+    // other instructions; a fallible one bails to a state before any effect
+    // wherever it runs).
+    auto skippable = [](MInstruction* x) {
+      return x->isConstant() ||
+             (!x->isEffectful() && !x->isGuard() && x->isMovable() &&
+              !x->resumePoint() && !x->isControlInstruction());
+    };
+    // Whether |x| has a partner ahead of |it| in the other side, within the
+    // instructions that could be stepped over to reach it.
+    auto partnerAhead = [&](MInstruction* x, MInstructionIterator it) {
+      for (size_t i = 0; i < MaxSkipped; i++, ++it) {
+        if (it->isControlInstruction()) {
+          return false;
+        }
+        if (x->congruentTo(*it)) {
+          return true;
+        }
+        if (!skippable(*it)) {
+          return false;
+        }
+      }
+      return false;
+    };
+    if (!pair && skipped < MaxSkipped) {
+      bool skipA = skippable(a), skipB = skippable(b);
+      if (skipA && skipB) {
+        // keep the one the other side will reach
+        if (partnerAhead(a, ib) && !partnerAhead(b, ia)) {
+          skipA = false;
+        }
+      }
+      if (skipA) {
+        ++ia;
+        skipped++;
+        continue;
+      }
+      if (skipB) {
+        ++ib;
+        skipped++;
+        continue;
+      }
+    }
+    if (!pair || a->isEffectful() || a->resumePoint() || b->resumePoint() ||
+        !a->isMovable() || !b->isMovable() || a->isRecoveredOnBailout() ||
+        b->isRecoveredOnBailout()) {
+      break;
+    }
+    // a is congruent to b, so its operands are b's: defined neither in T nor
+    // in F (a skipped instruction is in one side only), so before the branch.
+    ++ia;
+    ++ib;
+    t->moveBefore(at, a);
+    b->justReplaceAllUsesWith(a);
+    f->discard(b);
+    if (LogEnabled() && getenv("JS_ION_DIAMOND_MERGE_LOG")[0] == '3') {
+      fprintf(stderr, "ion diamond merge: hoisted %s\n", OpName(a));
+    }
+    if (!hoisted.append(a)) {
+      return n;  // only a missed optimization
+    }
+    n++;
+  }
+  return n;
+}
+
+// A side recomputes what was just hoisted (a store's own MElements,
+// MInitializedLength, MBoundsCheck after the load's were hoisted): before the
+// side's first effect, an instruction congruent to a hoisted one is that one
+// (the hoisted instruction dominates it, nothing in between writes memory).
+size_t DiamondMerger::reuseHoisted(
+    MBasicBlock* side, Vector<MInstruction*, 16, JitAllocPolicy>& hoisted) {
+  size_t n = 0;
+  for (MInstructionIterator it = side->begin(); it != side->end();) {
+    MInstruction* x = *it++;
+    if (x->isEffectful() || x->isControlInstruction()) {
+      break;
+    }
+    if (x->resumePoint() || !x->isMovable() || x->isRecoveredOnBailout()) {
+      continue;
+    }
+    for (MInstruction* h : hoisted) {
+      if (x->congruentTo(h)) {
+        x->justReplaceAllUsesWith(h);
+        side->discard(x);
+        n++;
+        break;
+      }
+    }
+  }
+  return n;
+}
+
+bool DiamondMerger::planSink(MBasicBlock* t, MBasicBlock* f, MBasicBlock* join,
+                             PairVector& plan, const char** why) {
+  size_t indexT = join->getPredecessorIndex(t);
+  size_t indexF = join->getPredecessorIndex(f);
+
+  auto planned = [&](MDefinition* def) -> const Pair* {
+    for (const Pair& p : plan) {
+      if (p.a == def || p.b == def) {
+        return &p;
+      }
+    }
+    return nullptr;
+  };
+
+  // Every use of |def| (from side |self|, partner |other|) must be its own
+  // resume point, a phi of J taking |other| from the other side, or an
+  // instruction planned to sink whose partner uses |other| at that index.
+  auto usesOk = [&](MInstruction* def, MInstruction* other, bool sideT,
+                    bool* feedsPhi) {
+    for (MUseIterator u(def->usesBegin()), e(def->usesEnd()); u != e; ++u) {
+      MNode* consumer = u->consumer();
+      if (consumer->isResumePoint()) {
+        // its own, or that of a planned store: both are replaced
+        MResumePoint* rp = consumer->toResumePoint();
+        if (rp != def->resumePoint() &&
+            !(rp->instruction() && planned(rp->instruction()))) {
+          return false;
+        }
+        continue;
+      }
+      MDefinition* user = consumer->toDefinition();
+      if (user->isPhi()) {
+        if (user->block() != join) {
+          return false;
+        }
+        MDefinition* in = user->getOperand(sideT ? indexF : indexT);
+        if (in != other) {
+          return false;
+        }
+        *feedsPhi = true;
+        continue;
+      }
+      const Pair* p = planned(user);
+      if (!p) {
+        return false;
+      }
+      size_t k = consumer->indexOf(*u);
+      MInstruction* partner = sideT ? p->b : p->a;
+      if (partner->getOperand(k) != other) {
+        return false;
+      }
+    }
+    return true;
+  };
+
+  // A sunk store's resume point is J's entry resume point, which may capture
+  // the phis that sunk values replace: those must be defined before the store.
+  bool laterFeedsPhi = false;
+
+  MInstructionReverseIterator ia = ++t->rbegin(), ib = ++f->rbegin();
+  while (ia != t->rend() && ib != f->rend()) {
+    MInstruction* a = *ia;
+    MInstruction* b = *ib;
+    if (a->isConstant()) {
+      ++ia;
+      continue;
+    }
+    if (b->isConstant()) {
+      ++ib;
+      continue;
+    }
+    if (a->op() != b->op() || a->type() != b->type() ||
+        a->numOperands() != b->numOperands() || a->isRecoveredOnBailout() ||
+        b->isRecoveredOnBailout()) {
+      *why = "different operations";
+      noteStop(*why, a, b);
+      break;
+    }
+
+    int diff = -1;
+    bool tooMany = false;
+    for (size_t k = 0; k < a->numOperands(); k++) {
+      MDefinition* x = a->getOperand(k);
+      MDefinition* y = b->getOperand(k);
+      if (SameOperand(x, y)) {
+        continue;
+      }
+      if (diff >= 0) {
+        tooMany = true;
+        break;
+      }
+      diff = int(k);
+    }
+    if (tooMany) {
+      *why = "more than one operand differs";
+      noteStop(*why, a, b);
+      break;
+    }
+    if (diff >= 0) {
+      MDefinition* x = a->getOperand(diff);
+      MDefinition* y = b->getOperand(diff);
+      if (x->type() != y->type() || !PhiType(x->type())) {
+        *why = "operands of different or unmergeable types";
+        noteStop(*why, a, b);
+      break;
+      }
+    }
+
+    bool same;
+    if (a->isEffectful()) {
+      same = a->resumePoint() && b->resumePoint() && SameStore(a, b);
+    } else if (a->resumePoint() || b->resumePoint()) {
+      same = false;
+    } else if (SameBarrier(a, b)) {
+      same = true;
+    } else {
+      // Compare as if the differing operand and equal constants were the
+      // same definition.
+      MDefinition* saved[4];
+      size_t n = a->numOperands();
+      if (n > 4) {
+        *why = "too many operands";
+        break;
+      }
+      for (size_t k = 0; k < n; k++) {
+        saved[k] = b->getOperand(k);
+        if (saved[k] != a->getOperand(k)) {
+          b->replaceOperand(k, a->getOperand(k));
+        }
+      }
+      same = a->congruentTo(b);
+      for (size_t k = 0; k < n; k++) {
+        if (b->getOperand(k) != saved[k]) {
+          b->replaceOperand(k, saved[k]);
+        }
+      }
+    }
+    if (!same) {
+      *why = a->isEffectful() ? "effectful, not a known store"
+                              : "not the same operation";
+      noteStop(*why, a, b);
+      break;
+    }
+    bool feedsPhi = false;
+    if (!usesOk(a, b, true, &feedsPhi) || !usesOk(b, a, false, &feedsPhi)) {
+      *why = "used outside the join's phis";
+      noteStop(*why, a, b);
+      break;
+    }
+    if (a->isEffectful() && laterFeedsPhi) {
+      *why = "a store before a merged value";
+      noteStop(*why, a, b);
+      break;
+    }
+    // A sunk store resumes at J's pc: after it, nothing may fail or have
+    // effects.  So one store, and after it only post-write barriers.
+    if (a->isEffectful()) {
+      bool ok = true;
+      for (const Pair& p : plan) {
+        if (!SameBarrier(p.a, p.b)) {
+          ok = false;
+        }
+      }
+      if (!ok) {
+        *why = "a store before other sunk code";
+        noteStop(*why, a, b);
+        break;
+      }
+    }
+    laterFeedsPhi |= feedsPhi;
+    if (!plan.append(Pair{a, b, diff})) {
+      return false;
+    }
+    ++ia;
+    ++ib;
+  }
+
+  // Everything effectful must be sunk: see the comment at the top.
+  for (MInstructionIterator it = t->begin(); it != t->end(); ++it) {
+    if (it->isEffectful() && !planned(*it)) {
+      potential_ = plan.length();
+      plan.clear();
+      *why = "an effect stays in a side";
+      noteStop(*why, *it, nullptr);
+      return true;
+    }
+  }
+  for (MInstructionIterator it = f->begin(); it != f->end(); ++it) {
+    if (it->isEffectful() && !planned(*it)) {
+      potential_ = plan.length();
+      plan.clear();
+      *why = "an effect stays in a side";
+      noteStop(*why, *it, nullptr);
+      return true;
+    }
+  }
+  return true;
+}
+
+bool DiamondMerger::applySink(MBasicBlock* pred, MBasicBlock* t,
+                              MBasicBlock* f, MBasicBlock* join,
+                              PairVector& plan) {
+  size_t indexT = join->getPredecessorIndex(t);
+  MResumePoint* before = LastResumePoint(pred);
+  MResumePoint* after = join->entryResumePoint();
+
+  MInstruction* at = join->safeInsertTop();
+  for (Pair& p : plan) {
+    MInstruction* a = p.a;
+    MInstruction* b = p.b;
+
+    // Equal constants of the two sides: a copy in J.
+    for (size_t k = 0; k < a->numOperands(); k++) {
+      if (int(k) == p.diff || a->getOperand(k) == b->getOperand(k)) {
+        continue;
+      }
+      MConstant* c = a->getOperand(k)->toConstant();
+      MDefinitionVector none(alloc_);
+      MInstruction* copy = c->clone(alloc_, none);
+      if (!copy) {
+        return false;
+      }
+      join->insertBefore(at, copy);
+      a->replaceOperand(k, copy);
+    }
+
+    if (p.diff >= 0) {
+      MDefinition* x = a->getOperand(p.diff);
+      MDefinition* y = b->getOperand(p.diff);
+      MPhi* phi = MPhi::New(alloc_, x->type());
+      if (!phi->reserveLength(2)) {
+        return false;
+      }
+      if (indexT == 0) {
+        phi->addInput(x);
+        phi->addInput(y);
+      } else {
+        phi->addInput(y);
+        phi->addInput(x);
+      }
+      join->addPhi(phi);
+      a->replaceOperand(p.diff, phi);
+      phis_++;
+    }
+
+    if (a->resumePoint()) {
+      a->clearResumePoint();
+    }
+    if (b->resumePoint()) {
+      b->clearResumePoint();
+    }
+    t->moveBefore(at, a);
+
+    // The phis of J that merge a and b become a.
+    for (MPhiIterator it = join->phisBegin(); it != join->phisEnd();) {
+      MPhi* phi = *it++;
+      if (phi->numOperands() == 2 &&
+          (phi->getOperand(0) == a || phi->getOperand(1) == a)) {
+        phi->justReplaceAllUsesWith(a);
+        join->discardPhi(phi);
+      }
+    }
+    MOZ_ASSERT(!b->hasUses());
+    f->discard(b);
+
+    if (a->isEffectful()) {
+      MResumePoint* rp = after->cloneInto(alloc_, join);
+      if (!rp) {
+        return false;
+      }
+      a->setResumePoint(rp);
+    }
+    at = a;
+    sunk_++;
+  }
+
+  // Bailouts in J before its first effect resume before the branch.
+  MResumePoint* entry = before->cloneInto(alloc_, join);
+  if (!entry) {
+    return false;
+  }
+  join->clearEntryResumePoint();
+  join->setEntryResumePoint(entry);
+
+  if (!join->phisEmpty()) {
+    if (!t->successorWithPhis()) {
+      t->setSuccessorWithPhis(join, join->getPredecessorIndex(t));
+    }
+    if (!f->successorWithPhis()) {
+      f->setSuccessorWithPhis(join, join->getPredecessorIndex(f));
+    }
+  }
+  return true;
+}
+
+bool DiamondMerger::run() {
+  for (ReversePostorderIterator block(graph_.rpoBegin());
+       block != graph_.rpoEnd(); ++block) {
+    if (mir_->shouldCancel("Diamond Merge")) {
+      return false;
+    }
+    MBasicBlock* pred = *block;
+    if (!pred->lastIns()->isTest()) {
+      continue;
+    }
+    MBasicBlock* t = pred->getSuccessor(0);
+    MBasicBlock* f = pred->getSuccessor(1);
+    if (t == f || t->numPredecessors() != 1 || f->numPredecessors() != 1 ||
+        t->isLoopHeader() || f->isLoopHeader() || !t->phisEmpty() ||
+        !f->phisEmpty()) {
+      continue;
+    }
+    candidates_++;
+    size_t sizeT = CountInstructions(t), sizeF = CountInstructions(f);
+
+    Vector<MInstruction*, 16, JitAllocPolicy> hoistedIns(alloc_);
+    size_t hoisted = hoist(pred, t, f, hoistedIns);
+    hoisted_ += hoisted;
+    if (hoisted) {
+      reused_ += reuseHoisted(t, hoistedIns) + reuseHoisted(f, hoistedIns);
+    }
+
+    // A diamond: both sides go straight to the same join.
+    MBasicBlock* join = nullptr;
+    if (t->lastIns()->isGoto() && f->lastIns()->isGoto() &&
+        t->getSuccessor(0) == f->getSuccessor(0)) {
+      join = t->getSuccessor(0);
+    }
+    if (!join || join->numPredecessors() != 2 || join->isLoopHeader()) {
+      if (hoisted) {
+        log(pred, "branch", sizeT, sizeF, hoisted, 0, nullptr);
+      }
+      continue;
+    }
+
+    const char* why = nullptr;
+    stop_[0] = 0;
+    potential_ = 0;
+    PairVector plan(alloc_);
+    MResumePoint* before = LastResumePoint(pred);
+    if (!before || !join->entryResumePoint() ||
+        (before->mode() != ResumeMode::ResumeAt &&
+         before->mode() != ResumeMode::ResumeAfter) ||
+        pred->callerResumePoint() != join->callerResumePoint()) {
+      why = "no usable resume point";
+    } else if (!planSink(t, f, join, plan, &why)) {
+      return false;
+    }
+    if (!plan.empty() && !applySink(pred, t, f, join, plan)) {
+      return false;
+    }
+    log(pred, "diamond", sizeT, sizeF, hoisted, plan.length(),
+        stop_[0] ? stop_ : why);
+  }
+  if (LogEnabled() && (hoisted_ || sunk_)) {
+    fprintf(stderr,
+            "ion diamond merge: graph: %u branches, %u hoisted, %u reused, %u "
+            "sunk, %u phis\n",
+            candidates_, hoisted_, reused_, sunk_, phis_);
+  }
+  return true;
+}
+
+}  // namespace diamondmerge
+
+bool js::jit::MergeDiamonds(const MIRGenerator* mir, MIRGraph& graph) {
+  diamondmerge::DiamondMerger merger(mir, graph);
+  return merger.run();
+}
diff --git a/js/src/jit/DiamondMerge.h b/js/src/jit/DiamondMerge.h
new file mode 100644
--- /dev/null
+++ b/js/src/jit/DiamondMerge.h
@@ -0,0 +1,29 @@
+/* -*- Mode: C++; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * vim: set ts=8 sts=2 et sw=2 tw=80:
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef jit_DiamondMerge_h
+#define jit_DiamondMerge_h
+
+namespace js {
+namespace jit {
+
+class MIRGenerator;
+class MIRGraph;
+
+// Merges the instructions that both sides of a two-way branch have in common:
+// identical instructions at the start of both successors are hoisted into the
+// branching block, and instructions at the end of both sides of a diamond that
+// differ at most in one operand are sunk into the join, with a phi for the
+// operand that differs.  (LLVM: SimplifyCFG's hoistCommonCodeFromSuccessors
+// and sinkCommonCodeFromPredecessors.)
+//
+// Runs after type application and before alias analysis.
+[[nodiscard]] bool MergeDiamonds(const MIRGenerator* mir, MIRGraph& graph);
+
+}  // namespace jit
+}  // namespace js
+
+#endif /* jit_DiamondMerge_h */
diff --git a/js/src/jit/EffectiveAddressAnalysis.cpp b/js/src/jit/EffectiveAddressAnalysis.cpp
--- a/js/src/jit/EffectiveAddressAnalysis.cpp
+++ b/js/src/jit/EffectiveAddressAnalysis.cpp
@@ -62,6 +62,9 @@ static bool OffsetIsSmallEnough(int32_t imm) {
 #elif defined(JS_CODEGEN_RISCV64) || defined(JS_CODEGEN_LOONG64) || \
     defined(JS_CODEGEN_MIPS64)
   return imm >= -0xFFF && imm <= 0xFFF;
+#elif defined(JS_CODEGEN_IA64)
+  // "adds" carries a signed 14-bit immediate; anything wider needs a movl.
+  return imm >= -8192 && imm <= 8191;
 #elif defined(JS_CODEGEN_WASM32) || defined(JS_CODEGEN_NONE)
   return true;
 #else
diff --git a/js/src/jit/FlushICache.cpp b/js/src/jit/FlushICache.cpp
--- a/js/src/jit/FlushICache.cpp
+++ b/js/src/jit/FlushICache.cpp
@@ -152,3 +152,53 @@ void FlushExecutionContextForAllThreads() {
 }  // namespace js
 
 #endif
+
+#ifdef JS_CODEGEN_IA64
+
+#  include <stdio.h>
+#  include <string.h>
+
+namespace js {
+namespace jit {
+
+uint32_t ICacheFlushStride = 32;
+
+// The kernel's get_cache_info(): the smallest PAL flush stride of the
+// instruction and unified caches.  User mode cannot call PAL, but palinfo
+// prints the same PAL_CACHE_CONFIG_INFO fields, one block per cache:
+//
+//   Instruction Cache level 1:
+//   	...
+//   	Stride         : 128 bytes
+//
+// No file, no such cache or an odd value leave the architected 32.
+void InitICacheFlushStride() {
+  FILE* f = fopen("/proc/pal/cpu0/cache_info", "r");
+  if (!f) {
+    return;
+  }
+  char line[128];
+  bool icache = false;
+  uint32_t best = 0;
+  while (fgets(line, sizeof(line), f)) {
+    if (strstr(line, "Cache level")) {
+      icache = !strncmp(line, "Instruction ", 12) ||
+               !strncmp(line, "Data/Instruction ", 17);
+      continue;
+    }
+    unsigned stride;
+    if (icache && sscanf(line, " Stride : %u bytes", &stride) == 1 &&
+        (best == 0 || stride < best)) {
+      best = stride;
+    }
+  }
+  fclose(f);
+  if (best >= 32 && best <= 4096 && (best & (best - 1)) == 0) {
+    ICacheFlushStride = best;
+  }
+}
+
+}  // namespace jit
+}  // namespace js
+
+#endif  // JS_CODEGEN_IA64
diff --git a/js/src/jit/FlushICache.h b/js/src/jit/FlushICache.h
--- a/js/src/jit/FlushICache.h
+++ b/js/src/jit/FlushICache.h
@@ -10,6 +10,7 @@
 #include "mozilla/Assertions.h"  // MOZ_CRASH
 
 #include <stddef.h>  // size_t
+#include <stdint.h>  // uint32_t
 
 namespace js {
 namespace jit {
@@ -29,6 +30,49 @@ inline void FlushICache(void* code, size_t size) {
 // `FlushExecutionContext` below.
 extern void FlushICache(void* code, size_t size);
 
+#elif defined(JS_CODEGEN_IA64)
+
+// IA-64 caches are not coherent with the instruction stream, so newly written
+// code must be flushed before it can be fetched. __builtin___clear_cache() is
+// not usable here: GCC has no clear_cache pattern for ia64 and expands it to
+// nothing at all, so this has to be the architected sequence written out by
+// hand, as in the kernel's flush_icache_range(): `fc` over the range, then
+// sync.i to make the flushes visible to instruction fetch, then srlz.i to
+// serialise this core. Plain `fc` rather than `fc.i` because the latter is only
+// architected from revision 2.1 onwards (on Montecito the two cost the same).
+//
+// One `fc` per ICacheFlushStride bytes: the smallest flush stride PAL reports
+// for the instruction and unified caches, which the kernel uses too (128 bytes
+// on Montecito, 4x fewer flushes than the architected 32-byte minimum).
+// InitICacheFlushStride() reads it at InitializeJit(); 32 if it cannot.
+extern uint32_t ICacheFlushStride;
+void InitICacheFlushStride();
+
+inline void FlushICache(void* code, size_t size) {
+  if (size == 0) {
+    return;
+  }
+  uintptr_t stride = ICacheFlushStride;
+  uintptr_t addr = reinterpret_cast<uintptr_t>(code) & ~(stride - 1);
+  uintptr_t end = reinterpret_cast<uintptr_t>(code) + size;
+  asm volatile(
+      "1:\n\t"
+      "fc %0\n\t"
+      "add %0 = %2, %0\n\t"
+      ";;\n\t"
+      "cmp.ltu p6, p7 = %0, %1\n\t"
+      ";;\n\t"
+      "(p6) br.cond.sptk.few 1b\n\t"
+      ";;\n\t"
+      "sync.i\n\t"
+      ";;\n\t"
+      "srlz.i\n\t"
+      ";;\n"
+      : "+r"(addr)
+      : "r"(end), "r"(stride)
+      : "p6", "p7", "memory");
+}
+
 #elif defined(JS_CODEGEN_NONE) || defined(JS_CODEGEN_WASM32)
 
 inline void FlushICache(void* code, size_t size) { MOZ_CRASH(); }
@@ -79,6 +123,18 @@ extern bool CanFlushExecutionContextForAllThreads();
 // else this will crash.
 extern void FlushExecutionContextForAllThreads();
 
+#elif defined(JS_CODEGEN_IA64)
+
+// FlushICache issues fc.i (which invalidates the line in every processor's
+// instruction cache of the coherence domain), sync.i (waits for that to
+// complete) and srlz.i on the issuing core; the other cores refetch from the
+// coherent memory system, as Linux's own flush_icache_range() relies on. There
+// is no separate per-thread execution-context flush on ia64, so tiering (code
+// published to other threads without a synchronisation point) is allowed.
+inline void FlushExecutionContext() {}
+inline bool CanFlushExecutionContextForAllThreads() { return true; }
+inline void FlushExecutionContextForAllThreads() {}
+
 #else
 #  error "Unknown architecture!"
 #endif
