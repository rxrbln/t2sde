+  // RayTrace -2.8% (wiki/out-of-line-pairs.html).  But a site stores either
+  // numbers or GC things nearly always, so a Value barrier is a pair where
+  // its Baseline IC stub stored GC things in more than half of its entries
+  // (ICCacheIRStub::gcValueStores_, MDefinition::StoresGCThingsIA64):
+  // Richards +1.3 to +3.7%.  JS_IA64_NO_PBVPROFILE makes no Value barrier a
+  // full pair.
+  //
+  // The other Value barriers (number sites) are pairs of another shape: the
+  // inline branch tests only for a GC thing (movl, cmp, a brl that numbers
+  // do not take), the nursery and object tests are out of line
+  // (EmitPostBarrierTestsIA64()).  As many instructions for a number as the
+  // shared shape, but the window goes on across the branch.
+  // JS_IA64_NO_PBVTAGPAIR keeps them in the shared shape.
+  static const bool noProfile = !ia64::Flags().pbvProfile;
+  static const bool noTagPairs = !ia64::Flags().pbvTagPair;
+  const bool tagOnly =
+      boxed && (noProfile || !lir->mir()->isStoresGCThingsIA64());
+  if (tagOnly && noTagPairs) {
+    return false;
+  }
+  addOutOfLineCode(ool, lir->mir());
+  const LiveRegisterSet live = liveVolatileRegs(lir);
+  const uint64_t liveGr = live.gprs().bits();
+  const uint64_t liveFr = live.fpus().bits();
+  MacroAssemblerIa64::SlowPathEffects fx =
+      MacroAssemblerIa64::SlowPathEffects::CCall();
+  fx.clobbersGr((uint64_t(1) << temp.code()) |
+                (uint64_t(Registers::VolatileMask & Registers::AllocatableMask) &
+                 ~liveGr))
+      .clobbersFr(uint64_t(0xff00) & ~liveFr);
+  if (!lir->object()->isConstant()) {
+    fx.readsGr(uint64_t(1) << ToRegister(lir->object()).code());
+  }
+  if (index != InvalidReg) {
+    fx.readsGr(uint64_t(1) << index.code());  // an element barrier's index
+  }
+  if (tagOnly) {
+    fx.readsGr(uint64_t(1) << value.code());  // tested out of line
+  }
