+  // element load before the loop with arithmetic on it inside (NavierStokes'
+  // lastX): a Value phi boxes the double at every back edge and unboxes it at
+  // every use, getf.d + setf.d, 11 cycles on ia64 and usually on the loop's
+  // recurrence.  Speculate Double instead: adjustPhiInputs() unboxes the
+  // Value input fallibly (int32 converts, anything else bails out), and after
+  // such a bailout the recompile stops speculating, as for Float32 above.
+  if (hasValueInput) {
+    if (type == MIRType::Double && phi->block()->isLoopHeader() &&
+        !mir->outerInfo().hadSpeculativePhiBailout()) {
+      return MIRType::Double;
+    }
