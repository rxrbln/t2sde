+      }
+      uint32_t id = mb->id();
+      if (gr != ia64LiveInGr_[id] || fr != ia64LiveInFr_[id]) {
+        ia64LiveInGr_[id] = gr;
+        ia64LiveInFr_[id] = fr;
+        changed = true;
+      }
+    }
+  }
+  return true;
+}
+
+// A block label nothing can jump to: binding it needs no offset, so the
+// scheduling window may run on through it (Assembler::skipFallThroughBindIA64,
+// wiki/superblock-scheduling.html).  The block is entered only by falling
+// through from the block emitted just before it: its single predecessor,
+// which ends in a branch or goto without out-of-line code (an out-of-line
+// path can jump to a successor's label after it is bound), and it is not a
+// loop header.  Jumps to trivial blocks are redirected to their successor,
+// and visitGoto() redirects jumps past a block of only MoveGroups and a
+// Goto, so the predecessor must be neither.  generate() still checks every
+// such label unused once all code exists (JS_IA64_FTDEBUG=1 says which).
+bool CodeGenerator::isFallThroughOnlyIA64(LBlock* block) const {
+  if (!ia64PrevEmitted_ || block->isOutOfLine()) {
+    return false;
+  }
+  MBasicBlock* mir = block->mir();
+  if (mir->isLoopHeader() || mir->numPredecessors() != 1 ||
+      mir == graph.mir().osrBlock() || mir == graph.mir().entryBlock()) {
+    return false;
+  }
+  // A block an InterruptCheck restarts (interruptRestartOsiIA64()) is a
+  // jump target.
+  if ((*block->begin())->isInterruptCheck()) {
+    return false;
+  }
+  MBasicBlock* pred = mir->getPredecessor(0);
+  if (pred->lir() != ia64PrevEmitted_ || pred->lir()->isTrivial()) {
+    return false;
+  }
+  // A copy of the predecessor, emitted earlier, branches here (tail
+  // duplication, emitTailDuplicateIA64()).
+  for (LBlock* b : ia64TailDupTargets_) {
+    if (b == block) {
+      return false;
+    }
+  }
+  // visitGoto() shorts out a block of nothing but MoveGroups and a Goto:
+  // every jump to the predecessor may then come straight here.
+  if (pred->lir()->isMoveGroupsThenGoto()) {
+    return false;
+  }
+  LInstruction* last = *pred->lir()->rbegin();
+  switch (last->op()) {
+    case LNode::Opcode::Goto:
+    case LNode::Opcode::CompareAndBranch:
+    case LNode::Opcode::CompareDAndBranch:
+    case LNode::Opcode::CompareFAndBranch:
+    case LNode::Opcode::TestIAndBranch:
+    case LNode::Opcode::TestIPtrAndBranch:
+    case LNode::Opcode::TestDAndBranch:
+    case LNode::Opcode::TestFAndBranch:
+    case LNode::Opcode::BitAndAndBranch:
+      return true;
+    default:
+      return false;
+  }
+}
+#endif
