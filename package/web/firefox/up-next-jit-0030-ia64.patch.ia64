 #elif defined(JS_CODEGEN_NONE)
@@ -54,6 +57,37 @@ class CodeGenerator final : public CodeGeneratorSpecific {
   // Warp snapshot. This is nullptr for Wasm compilations.
   const WarpSnapshot* snapshot_ = nullptr;
   IonScriptCounts* counts_ = nullptr;
+#ifdef JS_CODEGEN_IA64
+  // JS_IA64_WINDOWLOG: this body's block entry counters (Assembler-ia64.h).
+  uint64_t* ia64BlockCounts_ = nullptr;
+  // JS_IA64_PBVLOG: per Value post-barrier site, executions, GC things
+  // stored and nursery cells stored (countValueBarrierIA64()).
+  ia64::PbvSiteVector ia64PbvSites_;
+  void countValueBarrierIA64(LInstruction* lir, MDefinition* value,
+                             ValueOperand v, Register temp, bool element);
+  // Fall-through-only block labels (isFallThroughOnlyIA64()): left unbound,
+  // so that binding them does not end the scheduling window; checked unused
+  // once all code is generated.
+  LBlock* ia64PrevEmitted_ = nullptr;
+  bool ia64FallThroughNext_ = false;
+  js::Vector<LBlock*, 0, SystemAllocPolicy> ia64FallThroughLabels_;
+  bool isFallThroughOnlyIA64(LBlock* block) const;
+  // Tail duplication (CodeGenerator.cpp).
+  bool ia64InTailDup_ = false;
+  bool isTailDupCandidateIA64(MBasicBlock* mb) const;
+  js::Vector<LBlock*, 0, SystemAllocPolicy> ia64TailDupTargets_;
