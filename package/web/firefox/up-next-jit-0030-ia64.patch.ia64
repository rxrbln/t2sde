diff --git a/js/src/vm/ArrayBufferObject.cpp b/js/src/vm/ArrayBufferObject.cpp
--- a/js/src/vm/ArrayBufferObject.cpp
+++ b/js/src/vm/ArrayBufferObject.cpp
@@ -139,7 +139,21 @@ static const uint64_t WasmReservedBytesStartSyncFullGC =
     WasmReservedBytesMax - 100 * wasm::HugeMappedSize;
 static const uint64_t WasmReservedBytesPerTrigger = 100 * wasm::HugeMappedSize;
 
-#else  // 32-bit (and weird 64-bit platforms without huge memory)
+#elif defined(JS_64BIT)
+
+// 64-bit platforms without huge memory (ia64): a memory maps its maximum
+// (up to ByteLengthLimit, 16 GiB) and the address space is not scarce, so the
+// 32-bit totals below would refuse any single memory of 2 GiB or more
+// (qemu-wasm asks for a 2.4 GB shared memory up front).
+static const uint64_t GiB = 1024 * 1024 * 1024;
+
+static const uint64_t WasmReservedBytesMax = (64 * GiB) / WasmMemAsanOverhead;
+static const uint64_t WasmReservedBytesStartTriggering = 16 * GiB;
+static const uint64_t WasmReservedBytesStartSyncFullGC =
+    WasmReservedBytesMax - 16 * GiB;
+static const uint64_t WasmReservedBytesPerTrigger = 16 * GiB;
+
+#else  // 32-bit
 
 static const uint64_t GiB = 1024 * 1024 * 1024;
 
