+  EnterJitCode makeEnterJitDescriptor(EnterJitDescriptor& desc,
+                                      uint32_t offset) const {
+    // A raw JIT entry called as a C function pointer would have its
+    // prologue bytes misread as {entry, GP}; build a synthetic descriptor
+    // pointing at the trampoline instead, capturing libmozjs's GP (r1) so
+    // the trampoline can call back into libmozjs C++ with GP valid.
