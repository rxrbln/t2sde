+// Register liveness at every block's entry, from the allocated LIR: a
+// backward dataflow over physical registers.  Uses: every register operand,
+// every MoveGroup source, every register a snapshot names (a bailout reads
+// them) and a safepoint's live registers.  Defs: outputs, temps, MoveGroup
+// destinations.  Phis are implemented by the MoveGroups at the end of the
+// predecessors and are skipped.  Only the allocatable registers are
+// tracked; the block guards treat everything else as live (the JSContext
+// pin r11 and the frame registers are read without an operand), except the
+// temporaries and the rename pool, which nothing holds across an LIR
+// instruction.  For any register allocator (the simple one too).
+bool CodeGenerator::computeBlockLiveInIA64() {
+  const size_t n = graph.numBlocks();
+  if (!ia64LiveInGr_.appendN(0, n) || !ia64LiveInFr_.appendN(0, n)) {
+    return false;
+  }
+  for (size_t b = 0; b < n; b++) {
+    MBasicBlock* mb = graph.getBlock(b)->mir();
+    bool dense = mb->id() < n;
+    for (size_t s = 0; dense && s < mb->numSuccessors(); s++) {
+      dense = mb->getSuccessor(s)->id() < n;
+    }
+    if (!dense) {
+      // Not the block numbering this assumes: every register stays live.
+      ia64LiveInGr_.clear();
+      ia64LiveInFr_.clear();
