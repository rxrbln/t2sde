+++ firefox-153.0.1/js/moz.configure
@@ -245,6 +245,7 @@ def jit_default(target, enable_portable_
         "loongarch64",
         "ppc64",
         "riscv64",
+        "ia64",
     ):
         return True
     return False
@@ -323,6 +324,8 @@ def jit_codegen(jit_enabled, simulator,
         return namespace(ppc64=True)
     elif target.cpu == "riscv64":
         return namespace(riscv64=True)
+    elif target.cpu == "ia64":
+        return namespace(ia64=True)
 
     return namespace(**{str(target.cpu): True})
 
@@ -334,6 +337,7 @@ set_config("JS_CODEGEN_MIPS64", jit_code
 set_config("JS_CODEGEN_LOONG64", jit_codegen.loong64)
 set_config("JS_CODEGEN_PPC64", jit_codegen.ppc64)
