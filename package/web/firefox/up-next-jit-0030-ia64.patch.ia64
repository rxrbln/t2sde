+#include "vm/JitActivation.h"  // js::jit::JitActivation
+#include "wasm/WasmBuiltins.h"  // js::wasm::NeedsBuiltinThunk
+#include "wasm/WasmFrame.h"     // js::wasm::Frame
+#include "wasm/WasmInstance.h"  // js::wasm::Instance::offsetOfCx
+#include "wasm/WasmStubs.h"    // js::wasm::GenerateJumpToCatchHandler
