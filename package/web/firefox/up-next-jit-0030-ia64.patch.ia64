+  // Byte-wise store of a register; anything else (immediates) still goes
+  // through the natural-width store.
+  template <typename T, typename S>
+  void storeUnalignedImpl(const T& value, const S& addr, unsigned bytes) {
+    if constexpr (std::is_same_v<T, Register64>) {
+      storeUnalignedImpl(value.reg, addr, bytes);
+    } else if constexpr (!std::is_base_of_v<Register, T>) {
+      MOZ_CRASH("ia64: unaligned store of a non-register value");
+    } else if constexpr (std::is_base_of_v<BaseIndex, S>) {
+      ma_storeUnaligned(value, static_cast<const BaseIndex&>(addr), bytes);
+    } else if constexpr (std::is_base_of_v<Address, S>) {
+      ma_storeUnaligned(value, static_cast<const Address&>(addr), bytes);
+    } else {
+      MOZ_CRASH("ia64: unsupported operand type");
+    }
+  }
