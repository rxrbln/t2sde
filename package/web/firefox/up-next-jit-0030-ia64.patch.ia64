+// registers, which Ion cannot pin call operands to (they are not allocatable),
+// so even the intrinsics that need no activation exit are called through a
+// thunk with the wasm ABI.
+#  define VISIT_BUILTIN_FUNC(op, export, sa_name, sa_type, needs_thunk, ...) \
+    case SymbolicAddress::sa_name:                                           \
+      return true;
+#else
+#  define VISIT_BUILTIN_FUNC(op, export, sa_name, sa_type, needs_thunk, ...) \
+    case SymbolicAddress::sa_name:                                           \
+      return needs_thunk;
+#endif
