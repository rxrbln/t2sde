diff --git a/js/moz.configure b/js/moz.configure
--- a/js/moz.configure
+++ b/js/moz.configure
@@ -220,6 +220,7 @@ def jit_default(target, enable_portable_baseline_interp):
         "mips64",
         "loongarch64",
         "riscv64",
+        "ia64",
     ):
         return True
     return False
@@ -294,6 +295,8 @@ def jit_codegen(jit_enabled, simulator, target):
         return namespace(loong64=True)
     elif target.cpu == "riscv64":
         return namespace(riscv64=True)
+    elif target.cpu == "ia64":
+        return namespace(ia64=True)
 
     return namespace(**{str(target.cpu): True})
 
@@ -304,6 +307,7 @@ set_config("JS_CODEGEN_ARM64", jit_codegen.arm64)
 set_config("JS_CODEGEN_MIPS64", jit_codegen.mips64)
 set_config("JS_CODEGEN_LOONG64", jit_codegen.loong64)
 set_config("JS_CODEGEN_RISCV64", jit_codegen.riscv64)
+set_config("JS_CODEGEN_IA64", jit_codegen.ia64)
 set_config("JS_CODEGEN_X86", jit_codegen.x86)
 set_config("JS_CODEGEN_X64", jit_codegen.x64)
 set_config("JS_CODEGEN_WASM32", jit_codegen.wasm32)
@@ -314,6 +318,7 @@ set_define("JS_CODEGEN_ARM64", jit_codegen.arm64)
 set_define("JS_CODEGEN_MIPS64", jit_codegen.mips64)
 set_define("JS_CODEGEN_LOONG64", jit_codegen.loong64)
 set_define("JS_CODEGEN_RISCV64", jit_codegen.riscv64)
+set_define("JS_CODEGEN_IA64", jit_codegen.ia64)
 set_define("JS_CODEGEN_X86", jit_codegen.x86)
 set_define("JS_CODEGEN_X64", jit_codegen.x64)
 set_define("JS_CODEGEN_WASM32", jit_codegen.wasm32)
@@ -1393,7 +1398,10 @@ set_config(
 
 @depends("--enable-simulator", target)
 def wasm_has_heapreg(simulator, target):
-    if target.cpu != "x86":
+    # ia64 has too few statically preserved registers for a pinned heap base
+    # next to InstanceReg and the object tag: it loads the memory base from the
+    # instance, like x86-32.
+    if target.cpu not in ("x86", "ia64"):
         return True
 
     if simulator and simulator[0] == "arm":
diff --git a/js/src/builtin/TestingFunctions.cpp b/js/src/builtin/TestingFunctions.cpp
--- a/js/src/builtin/TestingFunctions.cpp
+++ b/js/src/builtin/TestingFunctions.cpp
@@ -466,6 +466,15 @@ static bool GetBuildConfiguration(JSContext* cx, unsigned argc, Value* vp) {
     return false;
   }
 
+#ifdef JS_CODEGEN_IA64
+  value = BooleanValue(true);
+#else
+  value = BooleanValue(false);
+#endif
+  if (!JS_SetProperty(cx, info, "ia64", value)) {
+    return false;
+  }
+
 #ifdef JS_CODEGEN_RISCV64
   value = BooleanValue(true);
 #else
diff --git a/js/src/irregexp/RegExpAPI.cpp b/js/src/irregexp/RegExpAPI.cpp
--- a/js/src/irregexp/RegExpAPI.cpp
+++ b/js/src/irregexp/RegExpAPI.cpp
@@ -886,7 +886,15 @@ RegExpRunStatus ExecuteRaw(jit::JitCode* code, Handle<JSLinearString*> input,
                 v8::internal::RegExp::kInternalRegExpFailure);
 
   using RegExpCodeSignature = int (*)(InputOutputData*);
+#if defined(JS_CODEGEN_IA64)
+  // IA-64: |code->raw()| is a raw JIT entry, not a {entry, GP} descriptor.
+  // The descriptor is per-call, so it lives on the stack. See MakeIA64Call.
+  js::jit::IA64FunctionDescriptor desc;
+  auto function =
+      js::jit::MakeIA64Call<RegExpCodeSignature>(code->raw(), &desc);
+#else
   auto function = reinterpret_cast<RegExpCodeSignature>(code->raw());
+#endif
   return (RegExpRunStatus)CALL_GENERATED_1(function, &data);
 }
 
diff --git a/js/src/irregexp/RegExpNativeMacroAssembler.cpp b/js/src/irregexp/RegExpNativeMacroAssembler.cpp
--- a/js/src/irregexp/RegExpNativeMacroAssembler.cpp
+++ b/js/src/irregexp/RegExpNativeMacroAssembler.cpp
@@ -1170,6 +1170,18 @@ void SMRegExpMacroAssembler::createStackFrame() {
   masm_.initPseudoStackPtr();
 #endif
 
+#ifdef JS_CODEGEN_IA64
+  // This code is entered directly from C++, not through the EnterJIT
+  // trampoline, so it must do the trampoline's job itself: establish the
+  // standard register-stack frame (out0-out7 and the rename pool), and preserve the
+  // caller's ar.pfs and b0, both of which the br.call issued by
+  // CheckBacktrackStackLimit() clobbers. br.ret restores the caller's CFM
+  // from ar.pfs, so losing it unwinds the wrong register-stack frame.
+  masm_.emitM(js::jit::ia64::Alloc(js::jit::ScratchReg.encoding(), 0, 0, js::jit::ia64::kFrameOuts, 0));
+  masm_.push(js::jit::ScratchReg);
+  masm_.pushReturnAddress();
+#endif
+
   masm_.Push(js::jit::FramePointer);
   masm_.moveStackPtrTo(js::jit::FramePointer);
 
@@ -1179,6 +1191,15 @@ void SMRegExpMacroAssembler::createStackFrame() {
     masm_.Push(*iter);
   }
 
+#ifdef JS_CODEGEN_IA64
+  // Entered from C++, so the pinned object tag is not set up (r7 itself is in
+  // savedRegisters_ and restored on exit). See ia64's ObjectTagReg.
+  MOZ_ASSERT(savedRegisters_.has(js::jit::ObjectTagReg));
+  masm_.emitMovl(js::jit::ObjectTagReg.encoding(), JSVAL_SHIFTED_TAG_OBJECT);
+  // ContextPinReg is volatile: nothing to save.
+  masm_.loadContextPin();
+#endif
+
   // The pointer to InputOutputData is passed as the first argument.
   // On x86 we have to load it off the stack into temp0_.
   // On other platforms it is already in a register.
@@ -1436,6 +1457,11 @@ void SMRegExpMacroAssembler::exitHandler() {
   // Perform a plain Ret(), as abiret() will move SP <- PSP and that is wrong.
   masm_.Ret(vixl::lr);
 #else
+#  ifdef JS_CODEGEN_IA64
+  masm_.popReturnAddress();
+  masm_.pop(js::jit::ScratchReg);
+  masm_.emitI(js::jit::ia64::MovToPfs(js::jit::ScratchReg.encoding()));
+#  endif
   masm_.abiret();
 #endif
 
diff --git a/js/src/jit-test/etc/wasm/generate-spectests/wast2js/src/harness.js b/js/src/jit-test/etc/wasm/generate-spectests/wast2js/src/harness.js
--- a/js/src/jit-test/etc/wasm/generate-spectests/wast2js/src/harness.js
+++ b/js/src/jit-test/etc/wasm/generate-spectests/wast2js/src/harness.js
@@ -23,7 +23,10 @@ function partialOobWriteMayWritePartialData() {
   let arm_native = getBuildConfiguration("arm") && !getBuildConfiguration("arm-simulator");
   let arm64_native = getBuildConfiguration("arm64") && !getBuildConfiguration("arm64-simulator");
   let riscv64_native = getBuildConfiguration("riscv64") && !getBuildConfiguration("riscv64-simulator");
-  return arm_native || arm64_native || riscv64_native;
+  // ia64: the kernel's unaligned-access fixup stores bytes up to the guard
+  // page before it faults.
+  let ia64_native = getBuildConfiguration("ia64");
+  return arm_native || arm64_native || riscv64_native || ia64_native;
 }
 
 function bytes(type, bytes) {
diff --git a/js/src/jit-test/tests/wasm/excessive-inlining.js b/js/src/jit-test/tests/wasm/excessive-inlining.js
--- a/js/src/jit-test/tests/wasm/excessive-inlining.js
+++ b/js/src/jit-test/tests/wasm/excessive-inlining.js
@@ -74,7 +74,10 @@ assertEq(tier2codeBytesUsed > 2000, true);
 
 // But not an excessive amount.  This is the assertion that checks that
 // the inlining-budget cutoff mechanism is working.
-assertEq(tier2codeBytesUsed < 15000, true);
+// ia64 code is about five times larger than x64 code (16-byte bundles padded
+// with nops); the unbudgeted size is correspondingly ~270000 there.
+assertEq(tier2codeBytesUsed < (getBuildConfiguration("ia64") ? 75000 : 15000),
+         true);
 
 // The thresholds above are based on the following measurements.
 //
diff --git a/js/src/jit-test/tests/wasm/memory-partial-oob-store.js b/js/src/jit-test/tests/wasm/memory-partial-oob-store.js
--- a/js/src/jit-test/tests/wasm/memory-partial-oob-store.js
