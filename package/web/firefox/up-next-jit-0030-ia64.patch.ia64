+
+// fcvt.fx rounds with the status field's mode, which is round-to-nearest-even
+// in sf0. NaN and out-of-range inputs land on the integer indefinite value, so
+// the two extremes are decided from the input rather than from the converted
+// integer: for a non-negative input any negative integer result can only be a
+// positive overflow, while negative inputs and NaN are recognised with float
+// compares (an unordered compare leaves fcmp.lt false, hence the explicit
+// fcmp.unord).
+void MacroAssembler::clampDoubleToUint8(FloatRegister input, Register output) {
+  emitF(ia64::FcvtFx(kFpT0, input.encoding()));
+  emitM(ia64::GetfSig(output.encoding(), kFpT0));
+
+  uint32_t p = emitCompare(Assembler::GreaterThan, output, Imm32(255));
+  emitM(ia64::Adds(output.encoding(), 255, Registers::zero, p));
+  p = emitCompare(Assembler::LessThan, output, Imm32(0));
+  emitM(ia64::Adds(output.encoding(), 255, Registers::zero, p));
+
+  emitF(ia64::FcmpLt(kFpP, kFpQ, input.encoding(), FloatRegisters::f0));
+  emitM(ia64::MovReg(output.encoding(), Registers::zero, kFpP));
+  emitF(ia64::FcmpUnord(kFpP, kFpQ, input.encoding(), input.encoding()));
+  emitM(ia64::MovReg(output.encoding(), Registers::zero, kFpP));
+}
