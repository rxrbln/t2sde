+
+// ===========================================================================
+
+void MacroAssembler::loadStoreBuffer(Register ptr, Register buffer) {
+  movePtr(ptr, buffer);
+  andPtr(Imm32(int32_t(~gc::ChunkMask)), buffer);
+  loadPtr(Address(buffer, gc::ChunkStoreBufferOffset), buffer);
+}
+
+void MacroAssembler::widenInt32(Register r) { ma_sxt(r, r, 4); }
+
+// IA-64 orders memory through stop bits and the mf instruction; there is no
+// separate speculation barrier, and no pause hint, so both are a nop.
+void MacroAssembler::speculationBarrier() { nop(); }
+
+void MacroAssembler::atomicPause() { nop(); }
+
+template <typename T>
+void MacroAssembler::storeUnboxedValue(const ConstantOrRegister& value,
+                                       MIRType valueType, const T& dest) {
+  MOZ_ASSERT(valueType < MIRType::Value);
+
+  if (value.constant()) {
+    storeValue(value.value(), dest);
+  } else if (valueType == MIRType::Double) {
+    boxDouble(value.reg().typedReg().fpu(), dest);
+  } else {
+    storeValue(ValueTypeFromMIRType(valueType), value.reg().typedReg().gpr(),
+               dest);
+  }
+}
+
+template void MacroAssembler::storeUnboxedValue(const ConstantOrRegister& value,
+                                                MIRType valueType,
+                                                const Address& dest);
+template void MacroAssembler::storeUnboxedValue(
+    const ConstantOrRegister& value, MIRType valueType,
+    const BaseObjectElementIndex& dest);
+
+void MacroAssembler::branchTestNaNValue(Condition cond, const ValueOperand& val,
+                                        Register temp, Label* label) {
+  MOZ_ASSERT(cond == Equal || cond == NotEqual);
+  // A NaN Value is stored as the canonical NaN, whose sign bit is clear.
+  static_assert(JS::detail::CanonicalizedNaNSignBit == 0);
+  emitMovl(ScratchReg.encoding(), ~mozilla::FloatingPoint<double>::kSignBit);
+  emitM(ia64::And(ScratchReg.encoding(), val.valueReg().encoding(),
+                  ScratchReg.encoding()));
+  emitMovl(temp.encoding(), JS::detail::CanonicalizedNaNBits);
+  uint32_t p = emitCompare(cond, ScratchReg, temp);
+  emitBranchToLabel(&ia64::BrCondRel, p, label);
+}
+
+void MacroAssembler::floorFloat32ToInt32(FloatRegister src, Register dest,
+                                         Label* fail) {
+  ma_fpRound(src, dest, RoundFloor, fail);
+}
+void MacroAssembler::floorDoubleToInt32(FloatRegister src, Register dest,
+                                        Label* fail) {
+  ma_fpRound(src, dest, RoundFloor, fail);
+}
+void MacroAssembler::ceilFloat32ToInt32(FloatRegister src, Register dest,
+                                        Label* fail) {
+  ma_fpRound(src, dest, RoundCeil, fail);
+}
+void MacroAssembler::ceilDoubleToInt32(FloatRegister src, Register dest,
+                                       Label* fail) {
+  ma_fpRound(src, dest, RoundCeil, fail);
+}
+void MacroAssembler::truncFloat32ToInt32(FloatRegister src, Register dest,
+                                         Label* fail) {
+  ma_fpRound(src, dest, RoundTrunc, fail);
+}
+void MacroAssembler::truncDoubleToInt32(FloatRegister src, Register dest,
+                                        Label* fail) {
+  ma_fpRound(src, dest, RoundTrunc, fail);
+}
+
+// Math.round is floor(x + 0.5), except that adding 0.5 outright would round
+// the value just below 0.5 up, and that inputs in [-0.5, 0) round to -0 and so
+// cannot produce an int32 result.
+static void RoundToInt32(MacroAssembler& masm, FloatRegister src, Register dest,
+                         FloatRegister temp, Label* fail, bool isDouble) {
+  Label negative, end, performRound;
+  ScratchDoubleScope fpscratch(masm);
+  FloatRegister scratch = isDouble ? fpscratch.asDouble() : fpscratch.asSingle();
+
+  if (isDouble) {
+    masm.loadConstantDouble(0.0, scratch);
+  } else {
+    masm.loadConstantFloat32(0.0f, scratch);
+  }
+  masm.branchDouble(Assembler::DoubleLessThan, src, scratch, &negative);
+
+  masm.branchDouble(Assembler::DoubleNotEqual, src, scratch, &performRound);
+  {
+    // Only +0.0 rounds to zero; -0.0 and NaN bail.
+    masm.ma_fpBits(src, ScratchReg);
+    uint32_t p = masm.emitCompare(Assembler::NotEqual, ScratchReg,
+                                  Register{Registers::zero});
+    masm.emitBranchToLabel(&ia64::BrCondRel, p, fail);
+    masm.move32(Imm32(0), dest);
+    masm.jump(&end);
+  }
+
+  masm.bind(&negative);
+  {
+    if (isDouble) {
+      masm.loadConstantDouble(-0.5, scratch);
+    } else {
+      masm.loadConstantFloat32(-0.5f, scratch);
+    }
+    masm.branchDouble(Assembler::DoubleGreaterThanOrEqual, src, scratch, fail);
+  }
+
+  masm.bind(&performRound);
+  {
+    if (isDouble) {
+      masm.loadConstantDouble(GetBiggestNumberLessThan(0.5), temp);
+      masm.emitF(
+          ia64::FaddD(scratch.encoding(), src.encoding(), temp.encoding()));
+    } else {
+      masm.loadConstantFloat32(GetBiggestNumberLessThan(0.5f), temp);
+      masm.emitF(ia64::FmaS(scratch.encoding(), src.encoding(), ia64::fpOne,
+                            temp.encoding()));
+    }
+    masm.ma_fpRound(scratch, dest, MacroAssemblerIa64::RoundFloor, fail);
+  }
+  masm.bind(&end);
+}
+
+void MacroAssembler::roundFloat32ToInt32(FloatRegister src, Register dest,
+                                         FloatRegister temp, Label* fail) {
+  RoundToInt32(*this, src, dest, temp, fail, false);
+}
+void MacroAssembler::roundDoubleToInt32(FloatRegister src, Register dest,
+                                        FloatRegister temp, Label* fail) {
+  RoundToInt32(*this, src, dest, temp, fail, true);
+}
+
+void MacroAssembler::copySignDouble(FloatRegister lhs, FloatRegister rhs,
+                                    FloatRegister output) {
+  emitF(ia64::FmergeS(output.encoding(), rhs.encoding(), lhs.encoding()));
+}
+void MacroAssembler::copySignFloat32(FloatRegister lhs, FloatRegister rhs,
+                                     FloatRegister output) {
+  emitF(ia64::FmergeS(output.encoding(), rhs.encoding(), lhs.encoding()));
+}
+void MacroAssembler::wasmBoundsCheck32(Condition, Register, Address, Label*) {
+  MOZ_CRASH("ia64: wasm is not supported");
+}
+void MacroAssembler::wasmBoundsCheck64(Condition, Register64, Register64,
+                                       Label*) {
+  MOZ_CRASH("ia64: wasm is not supported");
+}
+void MacroAssembler::wasmBoundsCheck64(Condition, Register64, Address, Label*) {
+  MOZ_CRASH("ia64: wasm is not supported");
+}
