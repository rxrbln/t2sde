+  // st8.spill: a NaT register stored without faulting (the bailout thunk,
+  // see Scheduler-ia64.h on speculative loads).
+  void storePtrSpill(Register src, const Address& dest) {
+    emitM(ia64::St8Spill(addressOf(dest, ScratchReg).encoding(), src.encoding()));
+  }
+  void nop() { emitM(ia64::NopM()); }
+  void breakpoint() { emitM(ia64::NopM()); }
+  void abiret() { emitB(ia64::BrRet(0)); }
+
+  // b0 is not a GPR: wasm's tail-call frame collapse has to put the return
+  // address it loaded from the old frame back into the link register.
+  void moveToLinkRegisterIA64(Register r) {
+    emitI(ia64::MovToBr(0, r.encoding()));
+  }
+
+  // Emit a possibly-faulting access and return the offset of the bundle it
+  // landed in. Under wasm codegen the access gets a bundle of its own (and
+  // everything queued before it is emitted first), so the offset is exact and
+  // the trap site, the signal's sc_ip and the resume point all agree. In JS
+  // code it is scheduled normally; the offset is then only informational.
+  BufferOffset emitFaulting(const ia64::Op& op) {
+    if (!wasmCodegen()) {
+      return emitM(op);
+    }
+    AutoUnbundled noBundle(this);
+    return emitM(op);
+  }
+
+  // Like every other link-register backend, ret() pops the return address off
+  // the stack into the link register first; abiret() is the variant that
+  // returns through b0 as it stands.
+  BufferOffset ret() {
+    pop(ScratchReg);
+    emitI(ia64::MovToBr(0, ScratchReg.encoding()));
+    return emitB(ia64::BrRet(0));
+  }
+
+  // Read b0 into a GPR without touching the stack -- mirrors ppc64's
+  // xs_mflr(), used by generic test code that needs the return address in a
+  // normal register right after a call().
+  void moveFromLinkRegister(Register dest) {
+    emitI(ia64::MovFromBr(dest.encoding(), 0));
+  }
+
+  // A branch (or, once toggled off, an inert nop.b carrying the same target
+  // bits -- see ia64::ToggleSlot2Op) to a same-buffer label. Deliberately the
+  // short B-unit form rather than a brl: the toggle works by flipping the major
+  // opcode in place, which no X-unit encoding survives with its displacement
+  // intact. See Assembler::emitShortBranchToLabel().
+  // The returned offset is that of the bundle holding the branch, which is
+  // what ToggleToJmp()/ToggleToCmp() rewrite in place -- they patch slot 2 at
+  // label.raw() with no back-up, exactly like ppc64's pairing. (It used to
+  // return currentOffset() *after* the branch, which named the following
+  // bundle; nothing noticed because both the profiler and debugger
+  // instrumentation that toggle these are off by default.)
+  //
+  // Bundling is safe here: only instructions emitted *before* the branch can
+  // share its bundle, and they occupy slots 0 and 1, so they still run ahead of
+  // it whether it is toggled on or off.
+  CodeOffset toggledJump(Label* label) {
+    return CodeOffset(emitShortBranchToLabel(0, label).getOffset());
+  }
+  // A fixed 3-bundle movl/MovToBr/BrCall sequence, matching call(Register)
+  // and PatchWrite_NearCallSize exactly. The disabled state must still carry
+  // BrCall's own b1/pa/whc bits (not a generic nop's), since ToggleCall only
+  // flips the 4-bit op field and leaves everything else alone -- toggling a
+  // bare nop.b back on would branch through garbage instead of b6.
+  CodeOffset toggledCall(JitCode* target, bool enabled) {
+    // ToggledCallSize() promises exactly three bundles at a known layout, so
+    // this sequence opts out of bundling.
+    AutoUnbundled noBundle(this);
+    BufferOffset start =
+        emitMovl(ScratchReg.encoding(), uint64_t(uintptr_t(target->raw())));
+    writeJumpRelocationAt(start);
+    emitI(ia64::MovToBr(6, ScratchReg.encoding()));
+    BufferOffset callSite = emitB(ia64::BrCall(0, 6));
+    if (!enabled) {
+      ia64::ToggleSlot2Op(bundleAt(callSite), 2);
+    }
+    return CodeOffset(start.getOffset());
+  }
+  static size_t ToggledCallSize(uint8_t*) { return 3 * sizeof(ia64::Bundle); }
+
+  // Nothing is buffered outside the code buffer -- the open bundle is written
+  // out as it fills -- but closing it here keeps the last bundle's stop bit
+  // from depending on whether anyone called currentOffset() afterwards.
+  void finish() {
+    emitRecoveryCode();
+    flush();
+  }
