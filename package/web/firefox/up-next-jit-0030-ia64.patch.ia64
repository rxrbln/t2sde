diff --git a/js/src/jit/ProcessExecutableMemory.cpp b/js/src/jit/ProcessExecutableMemory.cpp
--- a/js/src/jit/ProcessExecutableMemory.cpp
+++ b/js/src/jit/ProcessExecutableMemory.cpp
@@ -440,7 +440,16 @@ static void* ComputeRandomAllocationAddress() {
 #  else
   uint64_t rand = js::GenerateRandomSeed();
 
-#    ifdef HAVE_64BIT_BUILD
+#    if defined(__ia64__)
+  // ia64 splits the address space into eight regions selected by bits 63-61,
+  // and only the low RGN_MAP_LIMIT bytes of a region can ever be mapped. That
+  // limit is 2^(4*PAGE_SHIFT-12), which is as little as 2^36 with 4K pages,
+  // and unlike other kernels ia64's mmap() rejects an out-of-range hint with
+  // EINVAL rather than ignoring it and picking its own address. Right shift by
+  // 30 to leave 34 bits, so that the hint plus MaxCodeBytesPerProcess stays
+  // inside the region limit for every supported page size.
+  rand >>= 30;
+#    elif defined(HAVE_64BIT_BUILD)
   // x64 CPUs have a 48-bit address space and on some platforms the OS will
   // give us access to 47 bits, so to be safe we right shift by 18 to leave
   // 46 bits.
