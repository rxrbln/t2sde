+// path ran (each a VM call and a restart of the block), printed at exit.
+// Design instrumentation, opt-in.
+static uint64_t* InterruptRestartCounterIA64() {
+  static uint64_t* counter = []() -> uint64_t* {
+    if (!ia64::Flags().intRestartCount) {
+      return nullptr;
+    }
+    static uint64_t count = 0;
+    atexit([] {
+      fprintf(stderr, "ia64 interrupt restarts: %llu\n",
+              (unsigned long long)count);
+    });
+    return &count;
+  }();
+  return counter;
+}
+
+LOsiPoint* CodeGenerator::interruptRestartOsiIA64(LInterruptCheck* lir) {
+  static const bool disabled = !ia64::Flags().intRestart;
+  // In a loop the pipeliner records too: the header label is the plain
+  // copy's, which a kernel exit's stub also jumps to, so the restart is the
+  // same move.
+  if (disabled || gen->compilingWasm() || !lir->safepoint() ||
+      *current->begin() != lir || !current->label()->bound()) {
+    return nullptr;
+  }
+  LInstructionIterator next = current->begin(lir);
+  next++;
+  if (next == current->end() || !next->isOsiPoint()) {
+    return nullptr;
+  }
+  LOsiPoint* osi = next->toOsiPoint();
+  if (osi->associatedSafepoint() != lir->safepoint()) {
+    return nullptr;
+  }
+  return osi;
+}
+#endif
+
 void CodeGenerator::visitInterruptCheck(LInterruptCheck* lir) {
   using Fn = bool (*)(JSContext*);
   OutOfLineCode* ool =
       oolCallVM<Fn, InterruptCheck>(lir, ArgList(), StoreNothing());
 
   const void* interruptAddr = gen->runtime->addressOfInterruptBits();
+#ifdef JS_CODEGEN_IA64
+  if (LOsiPoint* osi = interruptRestartOsiIA64(lir)) {
+    Label* restart = current->label();
+    masm.branch32(Assembler::NotEqual, AbsoluteAddress(interruptAddr),
+                  Imm32(0), ool->entry());
+    // Every callee-saved register too: a NaT that an ld.s hoisted above the
+    // branch left in r4-r7 would cross the VM call, and the interrupt
+    // callback's JS re-enters through EnterJIT, which saves r4-r7 with plain
+    // st8 -- a NaT consumption fault (SIGILL; ion/bug1942881.js under
+    // JS_IA64_SPECLD_FAILALL).  Bailout guards never see this: their thunk
+    // stores with st8.spill.
+    uint64_t gr = uint64_t(Registers::NonVolatileMask);
+    uint64_t fr = uint64_t(FloatRegisters::NonVolatileMask);
+    const LiveRegisterSet& live = lir->safepoint()->liveRegs();
+    for (GeneralRegisterIterator it(live.gprs()); it.more(); ++it) {
+      gr |= uint64_t(1) << (*it).encoding();
+    }
+    for (FloatRegisterIterator it(live.fpus()); it.more(); ++it) {
+      fr |= uint64_t(1) << (*it).encoding();
+    }
+    masm.setGuardLive(ool->entry(), gr, fr);
+    ia64DeferredOsi_ = osi;
+    auto* back = new (alloc()) LambdaOutOfLineCode(
+        [=, this](OutOfLineCode&) {
+          masm.bind(ool->rejoin());
+          uint32_t at = markOsiPoint(osi);
+          LSafepoint* sp = osi->associatedSafepoint();
+          MOZ_ASSERT(!sp->osiCallPointOffset());
+          sp->setOsiCallPointOffset(at);
+          if (uint64_t* counter = InterruptRestartCounterIA64()) {
+            masm.inc64(AbsoluteAddress(counter));
+          }
+          masm.jump(restart);
+          // An invalidation patches a call over the bytes at |at|; keep
+          // them this path's own, not the next out-of-line path's.
+          while (masm.currentOffset() - at <
+                 Assembler::PatchWrite_NearCallSize()) {
+            masm.nop();
+          }
+        });
+    addOutOfLineCode(back, lir->mir());
+    return;
+  }
+#endif
   masm.branch32(Assembler::NotEqual, AbsoluteAddress(interruptAddr), Imm32(0),
                 ool->entry());
   masm.bind(ool->rejoin());
diff --git a/js/src/jit/CodeGenerator.h b/js/src/jit/CodeGenerator.h
