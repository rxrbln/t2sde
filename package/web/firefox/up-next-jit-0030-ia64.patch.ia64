+  // On JS_PUNBOX64 a boxed double is just its bit pattern in the value
+  // register, which getf.d produces directly.
+  void boxDouble(FloatRegister src, ValueOperand dest, FloatRegister) {
+    emitM(ia64::GetfD(dest.valueReg().encoding(), src.encoding()));
+  }
+  void boxNonDouble(JSValueType type, Register src, ValueOperand dest) {
+    tagValue(type, src, dest);
+  }
+  // A boxed value is (JSVAL_TYPE_TO_TAG(type) << JSVAL_TAG_SHIFT) | payload.
+  void boxNonDouble(Register type, Register src, const ValueOperand& dest) {
+    Register out = dest.valueReg();
+    MOZ_ASSERT(src != out);
+    emitMovl(ScratchReg.encoding(), JSVAL_TAG_MAX_DOUBLE);
+    emitM(ia64::Or(out.encoding(), type.encoding(), ScratchReg.encoding()));
+    emitI(ia64::ShlImm(out.encoding(), out.encoding(), JSVAL_TAG_SHIFT));
+    // Only the int32, boolean, magic, null and undefined types reach here, and
+    // this backend holds an int32 sign-extended across the whole register, so
+    // the payload has to be narrowed to 32 bits or it smears into the tag.
+    emitI(ia64::Zxt4(ScratchReg.encoding(), src.encoding()));
+    emitM(ia64::Or(out.encoding(), out.encoding(), ScratchReg.encoding()));
+  }
+  void boxDouble(FloatRegister src, const Address& dest) {
+    ma_storeFp(src.asDouble(), dest);
+  }
+  void boxDouble(FloatRegister src, const BaseIndex& dest) {
+    ma_storeFp(src.asDouble(), dest);
+  }
+  template <typename T>
+  void boxDouble(FloatRegister src, const T& dest) {
+    IA64_MEM_DISPATCH2(boxDouble, src, dest);
+  }
