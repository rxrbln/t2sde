diff --git a/js/src/wasm/WasmGC.cpp b/js/src/wasm/WasmGC.cpp
--- a/js/src/wasm/WasmGC.cpp
+++ b/js/src/wasm/WasmGC.cpp
@@ -491,6 +491,29 @@ bool wasm::IsPlausibleStackMapKey(const uint8_t* base,
     return true;
   }
 
+#  elif defined(JS_CODEGEN_IA64)
+  // nextPC is the bundle following the call: br.call leaves the address of the
+  // next bundle in the link register, and a call always ends its own bundle.
+  // Recognise the two B-unit forms (br.call indirect, br.call ip-relative) and
+  // the X-unit long form (brl.call) in any slot.  Slot n of a bundle occupies
+  // bits 5 + 41n .. 45 + 41n of the 128-bit value.
+  if ((uintptr_t(nextPC) & 15) != 0) {
+    return false;  // misaligned
+  }
+  const uint64_t* w = (const uint64_t*)(nextPC - 16);
+  const uint64_t kSlotMask = (uint64_t(1) << 41) - 1;
+  const uint64_t slots[3] = {
+      (w[0] >> 5) & kSlotMask,
+      ((w[0] >> 46) | (w[1] << 18)) & kSlotMask,
+      (w[1] >> 23) & kSlotMask,
+  };
+  for (uint64_t slot : slots) {
+    uint32_t majorOp = uint32_t((slot >> 37) & 0xf);
+    if (majorOp == 1 || majorOp == 5 || majorOp == 0xd) {
+      return true;
+    }
