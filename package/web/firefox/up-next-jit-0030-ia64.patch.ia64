diff --git a/js/src/jit/JitRuntime.h b/js/src/jit/JitRuntime.h
--- a/js/src/jit/JitRuntime.h
+++ b/js/src/jit/JitRuntime.h
@@ -141,6 +141,32 @@ class JitRuntime {
   // Trampoline for resuming a suspended generator/async function.
   WriteOnceData<uint32_t> enterJITGeneratorResumeOffset_{0};
 
+#if defined(JS_CODEGEN_IA64)
+  // IA-64 psABI: a function pointer is a pointer to a 2-word descriptor
+  // {entry IP, GP}, not a raw code address; see enterJit().
+  struct alignas(16) EnterJitDescriptor {
+    void* entry = nullptr;
+    void* gp = nullptr;
+  };
+  mutable EnterJitDescriptor enterJitDesc_;
+  mutable EnterJitDescriptor enterJitGeneratorResumeDesc_;
+
+  EnterJitCode makeEnterJitDescriptor(EnterJitDescriptor& desc,
+                                      uint32_t offset) const {
+    // A raw JIT entry called as a C function pointer would have its
+    // prologue bytes misread as {entry, GP}; build a synthetic descriptor
+    // pointing at the trampoline instead, capturing libmozjs's GP (r1) so
+    // the trampoline can call back into libmozjs C++ with GP valid.
+    if (!desc.entry) {
+      void* gp;
+      asm volatile("mov %0 = gp" : "=r"(gp));
+      desc.gp = gp;
+      desc.entry = trampolineCode(offset).value;
+    }
+    return reinterpret_cast<EnterJitCode>(&desc);
+  }
+#endif
+
   // Generic bailout table; used if the bailout table overflows.
   WriteOnceData<uint32_t> bailoutHandlerOffset_{0};
 
@@ -410,12 +436,21 @@ class JitRuntime {
   }
 
   EnterJitCode enterJit() const {
+#if defined(JS_CODEGEN_IA64)
+    return makeEnterJitDescriptor(enterJitDesc_, enterJITOffset_);
+#else
     return JS_DATA_TO_FUNC_PTR(EnterJitCode,
                                trampolineCode(enterJITOffset_).value);
+#endif
   }
   EnterJitCode enterJitGeneratorResume() const {
+#if defined(JS_CODEGEN_IA64)
+    return makeEnterJitDescriptor(enterJitGeneratorResumeDesc_,
+                                  enterJITGeneratorResumeOffset_);
+#else
     return JS_DATA_TO_FUNC_PTR(
         EnterJitCode, trampolineCode(enterJITGeneratorResumeOffset_).value);
+#endif
   }
 
   // Return the registers from the native caller frame of the given JIT frame.
diff --git a/js/src/jit/LIR.h b/js/src/jit/LIR.h
--- a/js/src/jit/LIR.h
+++ b/js/src/jit/LIR.h
@@ -616,6 +616,20 @@ class LDefinition {
   Type type() const { return (Type)((bits_ >> TYPE_SHIFT) & TYPE_MASK); }
 
   static bool isFloatRegCompatible(Type type, FloatRegister reg) {
+#if defined(JS_CODEGEN_IA64)
+    // Single- and double-precision values share one register file (and one
+    // code space) on ia64, and FloatRegister::FromCode() cannot recover the
+    // kind, so the allocator's physical-register table is Double-tagged. Both
+    // kinds fit either MIR type here; the .s/.d operation choice comes from
+    // the LIR/instruction, not from the register tag.  Snapshots record a
+    // Float32 in a register as a double (CodeGeneratorShared::encodeAllocation)
+    // so that bailouts read the 8-byte register dump as one.  Restricting this
+    // to wasm made every JS compilation with a Float32 value fail in the
+    // allocator and fall back to Baseline (wiki/ion-backend-failures.html).
+    if (type == FLOAT32 || type == DOUBLE) {
+      return true;
+    }
+#endif
     if (type == FLOAT32) {
       return reg.isSingle();
     }
@@ -2303,6 +2317,8 @@ AnyRegister LAllocation::toAnyRegister() const {
 #  include "jit/loong64/LIR-loong64.h"
 #elif defined(JS_CODEGEN_RISCV64)
 #  include "jit/riscv64/LIR-riscv64.h"
