+// ===========================================================================
+// Atomics, wasm memory access and the remaining floating-point conversions all
+// need encodings that AssemblerCore-ia64.h does not provide yet.
+
+void MacroAssembler::flexibleRemainderPtr(Register lhs, Register rhs, Register dest, bool isUnsigned, const LiveRegisterSet& volatileLiveRegs) {
+  ma_divmod(InvalidReg, dest, lhs, rhs, isUnsigned, 64);
+}
