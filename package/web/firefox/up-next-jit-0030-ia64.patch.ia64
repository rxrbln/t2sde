diff --git a/js/src/wasm/WasmSummarizeInsn.cpp b/js/src/wasm/WasmSummarizeInsn.cpp
--- a/js/src/wasm/WasmSummarizeInsn.cpp
+++ b/js/src/wasm/WasmSummarizeInsn.cpp
@@ -2208,6 +2208,117 @@ SummarizeResult SummarizeTrapInstruction(const InstructionBytes& insn) {
   return SummarizeResult();
 }
 
+// ================================================================== ia64 ====
+
+#elif defined(JS_CODEGEN_IA64)
+
+// The "instruction" is a whole 16-byte bundle, which is the unit a trap can name
+// (sc_ip carries the slot, but trap sites and resumption are per bundle).  Every
+// trapping instruction wasm generates is emitted alone in its bundle, with nops
+// around it, so the first memory access or break found in a slot is the one.
+// Field layout and opcodes: Intel IA-64 Architecture Software Developer's
+// Manual, volume 3, sections 4.4 (M-unit encodings) and 4.5 (B/I-unit break).
+
+static SummarizeResult SummarizeSlot(char unit, uint64_t s) {
+  unsigned op = unsigned((s >> 37) & 0xf);
+  unsigned x = unsigned((s >> 27) & 1);
+  unsigned x6 = unsigned((s >> 30) & 0x3f);
+  if (unit == 'B') {
+    // break.b: major op 0, x6 (bits 32:27) 0.
+    if (op == 0 && ((s >> 27) & 0x3f) == 0) {
+      return SummarizeResult(TrapMachineInsn::OfficialUD, 16);
+    }
+    return SummarizeResult();
+  }
+  if (unit == 'I') {
+    // break.i: op 0, x3 (35:33) 0, x6 (32:27) 0.
+    if (op == 0 && ((s >> 27) & 0x1ffULL) == 0) {
+      return SummarizeResult(TrapMachineInsn::OfficialUD, 16);
+    }
+    return SummarizeResult();
+  }
+  if (unit != 'M') {
+    return SummarizeResult();
+  }
+  static const TrapMachineInsn loads[4] = {
+      TrapMachineInsn::Load8, TrapMachineInsn::Load16, TrapMachineInsn::Load32,
+      TrapMachineInsn::Load64};
+  static const TrapMachineInsn stores[4] = {
+      TrapMachineInsn::Store8, TrapMachineInsn::Store16,
+      TrapMachineInsn::Store32, TrapMachineInsn::Store64};
+  switch (op) {
+    case 0:
+      // break.m: x3 (35:33) 0, x2 (32:31) 0, x4 (30:27) 0.
+      if (((s >> 27) & 0x1ffULL) == 0) {
+        return SummarizeResult(TrapMachineInsn::OfficialUD, 16);
+      }
+      return SummarizeResult();
+    case 4:
+    case 5:
+      if (op == 4 && x == 1) {
+        // Semaphores (M16): cmpxchg{1,2,4,8}.{acq,rel} 0x00-0x07,
+        // xchg{1,2,4,8} 0x08-0x0b, fetchadd{4,8}.{acq,rel} 0x12-0x17.
+        if (x6 <= 0x0b || (x6 >= 0x12 && x6 <= 0x17)) {
+          return SummarizeResult(TrapMachineInsn::Atomic, 16);
+        }
+        return SummarizeResult();
+      }
+      // Integer loads: ld{1,2,4,8} with the .s/.a/.sa/.bias/.acq/.c flavours,
+      // 0x00-0x17 and 0x20-0x2b but not ld8.fill (0x1b); stores M4/M5.
+      if (x6 <= 0x2b && x6 != 0x1b && (x6 <= 0x17 || x6 >= 0x20)) {
+        return SummarizeResult(loads[x6 & 3], 16);
+      }
+      if (x6 >= 0x30 && x6 <= 0x37) {
+        return SummarizeResult(stores[x6 & 3], 16);
+      }
+      return SummarizeResult();
+    case 6:
+    case 7:
+      if (x == 0) {
+        // FP loads ldf8/ldfs/ldfd (the low two bits of x6 are 1/2/3) and the
+        // matching stores 0x31-0x33.
+        if (x6 <= 0x2b && x6 != 0x1b && (x6 & 3) != 0) {
+          return SummarizeResult((x6 & 3) == 2 ? TrapMachineInsn::Load32
+                                               : TrapMachineInsn::Load64,
+                                 16);
+        }
+        if (x6 >= 0x31 && x6 <= 0x33) {
+          return SummarizeResult((x6 & 3) == 2 ? TrapMachineInsn::Store32
+                                               : TrapMachineInsn::Store64,
+                                 16);
+        }
+      }
+      return SummarizeResult();
+    default:
+      return SummarizeResult();
+  }
+}
+
+SummarizeResult SummarizeTrapInstruction(const InstructionBytes& insn) {
+  uint64_t lo = 0, hi = 0;
+  for (unsigned i = 0; i < 8; i++) {
+    lo |= uint64_t(insn.get(i)) << (8 * i);
+    hi |= uint64_t(insn.get(8 + i)) << (8 * i);
+  }
+  constexpr uint64_t mask41 = (uint64_t(1) << 41) - 1;
+  uint64_t slots[3] = {(lo >> 5) & mask41, ((lo >> 46) | (hi << 18)) & mask41,
+                       (hi >> 23) & mask41};
+  // Unit of each slot by template>>1; '?' is reserved, 'L'/'X' the two halves
+  // of a movl, which never traps.
+  static const char* const kUnits[16] = {"MII", "MII", "MLX", "???",
+                                         "MMI", "MMI", "MFI", "MMF",
+                                         "MIB", "MBB", "???", "BBB",
+                                         "MMB", "???", "MFB", "???"};
+  const char* units = kUnits[(lo & 0x1f) >> 1];
+  for (unsigned i = 0; i < 3; i++) {
+    SummarizeResult r = SummarizeSlot(units[i], slots[i]);
+    if (r.identified()) {
+      return r;
+    }
+  }
+  return SummarizeResult();
+}
+
 // ================================================================== none ====
 
 #elif defined(JS_CODEGEN_NONE)
