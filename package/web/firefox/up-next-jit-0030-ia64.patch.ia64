+
+void MacroAssembler::clampIntToUint8(Register reg) {
+  // 0 if negative, 255 if above 255, unchanged otherwise.
+  uint32_t p = emitCompare(LessThan, reg, Imm32(0));
+  emitM(ia64::MovReg(reg.encoding(), Registers::zero, p));
+  p = emitCompare(GreaterThan, reg, Imm32(255));
+  emitM(ia64::Adds(reg.encoding(), 255, Registers::zero, p));
+}
