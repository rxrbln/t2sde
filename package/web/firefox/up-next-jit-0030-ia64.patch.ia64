   return !gen->needsOverrecursedCheck();
 }
 
+#ifdef JS_CODEGEN_IA64
+// Ion's guarded pre-barriers with the call out of line: the barrier is
+// needed only while the zone is being marked, and the inline form's likely
+// path is a taken forward brl over the call, which the ETB flags
+// mispredicted 20-37% of the time in the object-heavy suites
+// (wiki/superblock-scheduling.html). Out of line it is a not-taken branch.
+// Barriers emitted by out-of-line code (current == nullptr) stay inline.
+
+// The address's registers: what the slow path reads besides the fixed ones.
+static uint64_t PreBarrierAddressRegs(const Address& a) {
+  return uint64_t(1) << a.base.code();
+}
+static uint64_t PreBarrierAddressRegs(const BaseObjectElementIndex& a) {
+  return (uint64_t(1) << a.base.code()) | (uint64_t(1) << a.index.code());
+}
+static bool PreBarrierOffStack(const Address& a) {
+  return a.base != StackPointer;
+}
+static bool PreBarrierOffStack(const BaseObjectElementIndex& a) {
+  return a.base != StackPointer;
+}
+
+template <typename T>
+void CodeGeneratorShared::emitPreBarrierOutOfLine(const T& address) {
+  auto* ool = new (alloc()) LambdaOutOfLineCode([=, this](OutOfLineCode& ool) {
+    // An out-of-line pair (Assembler::nextBranchIsCrossableIA64()): no renaming
+    // in here, the code around the pair may hold the pool across it; with
+    // JS_IA64_PAIRCHECK, the registers it must not change are compared on
+    // the way back.
+    Assembler::AutoNoRenameIA64 noRename(masm);
+    {
+      const bool check =
+          MacroAssemblerIa64::CrossCheckEnabled() && PreBarrierOffStack(address);
+      MacroAssemblerIa64::AutoCrossCheckIA64 crossCheck(
+          masm, check ? MacroAssemblerIa64::CrossCheckMask(
+                            ia64::Scheduler::CrossableEffectsOf(
+                                ia64::Scheduler::CrossablePreBarrier).gr)
+                      : 0);
+      masm.unguardedCallPreBarrier(address, MIRType::Value);
+    }
+    masm.jump(ool.rejoin());
+  });
+  addOutOfLineCode(ool, current->mir()->trackedSite());
+  // Read by the slow path: the address, gp, the frame pointer, the pinned
+  // ObjectTagReg and context pin, sp, tp and PreBarrierReg (pushed, set,
+  // popped).
+  const uint64_t fixed =
+      ia64::kGrSlowPathReads | (uint64_t(1) << PreBarrierReg.code());
+  masm.crossableBranchIA64(
+      fixed | PreBarrierAddressRegs(address),
+      ia64::Scheduler::CrossableEffectsOf(ia64::Scheduler::CrossablePreBarrier),
+      ool->rejoin(), [&] {
+        masm.branchTestNeedsMarkingBarrier(Assembler::NonZero, ool->entry());
+      });
+}
+#endif
+
 void CodeGeneratorShared::emitPreBarrier(Address address) {
+#ifdef JS_CODEGEN_IA64
+  if (current) {
+    emitPreBarrierOutOfLine(address);
+    return;
+  }
+#endif
   masm.guardedCallPreBarrier(address, MIRType::Value);
 }
 
 void CodeGeneratorShared::emitPreBarrier(BaseObjectElementIndex address) {
+#ifdef JS_CODEGEN_IA64
+  if (current) {
+    emitPreBarrierOutOfLine(address);
+    return;
+  }
+#endif
   masm.guardedCallPreBarrier(address, MIRType::Value);
 }
 
