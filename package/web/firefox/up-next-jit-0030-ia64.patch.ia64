+  // Register-to-register moves are "adds dest = 0, src"; immediates go through
+  // movl, which carries a full 64-bit value in one MLX bundle.
+  void movePtr(Register src, Register dest) {
+    if (src != dest) {
+      emitM(ia64::MovReg(dest.encoding(), src.encoding()));
+    }
+  }
+  void movePtr(ImmWord imm, Register dest) {
+    emitMovl(dest.encoding(), imm.value);
+  }
+  void movePtr(ImmPtr imm, Register dest) {
+    movePtr(ImmWord(uintptr_t(imm.value)), dest);
+  }
+  void movePtr(wasm::SymbolicAddress, Register) { MOZ_CRASH(); }
+  // int32 values live sign-extended in a 64-bit register, and move32's callers
+  // include storeCallInt32Result(), whose source is a C return value that the
+  // compiler is free to leave zero-extended. Canonicalise here, as the other
+  // 64-bit backends with this convention do.
+  void move32(Register src, Register dest) { ma_sxt(dest, src, 4); }
+  void move32(Imm32 imm, Register dest) {
+    emitMovl(dest.encoding(), uint64_t(int64_t(imm.value)));
+  }
+  void mov(Register src, Register dest) { movePtr(src, dest); }
+  void mov(ImmWord imm, Register dest) { movePtr(imm, dest); }
+  void mov(ImmPtr imm, Register dest) { movePtr(imm, dest); }
+  void mov(Imm32 imm, Register dest) { move32(imm, dest); }
+  void mov(CodeLabel* label, Register dest);
+
+  // An embedded GC pointer needs a data relocation so the GC can trace and
+  // update it; the relocation records the offset of the movl bundle.
+  void movePtr(ImmGCPtr imm, Register dest);
