+  // schedulable.  Patchable constants go through the *WithPatch functions.
+  void movePtr(ImmWord imm, Register dest) {
+    emitLoadImm(dest.encoding(), imm.value);
+  }
+  void movePtr(ImmPtr imm, Register dest) {
