+  void unboxBoolean(const Address& src, Register dest);
+  void unboxBoolean(const BaseIndex& src, Register dest);
+  template <typename T>
+  void unboxBoolean(const T& src, Register dest) {
+    IA64_MEM_DISPATCH(unboxBoolean, src, dest);
+  }
+  void unboxString(const ValueOperand& src, Register dest);
+  void unboxString(const Address& src, Register dest);
+  template <typename T>
+  void unboxString(const T& src, Register dest) {
+    IA64_MEM_DISPATCH(unboxString, src, dest);
+  }
+  void unboxSymbol(const ValueOperand& src, Register dest);
+  void unboxSymbol(const Address& src, Register dest);
+  template <typename T>
+  void unboxSymbol(const T& src, Register dest) {
+    IA64_MEM_DISPATCH(unboxSymbol, src, dest);
+  }
+  void unboxBigInt(const ValueOperand& src, Register dest);
+  void unboxBigInt(const Address& src, Register dest);
+  template <typename T>
+  void unboxBigInt(const T& src, Register dest) {
+    IA64_MEM_DISPATCH(unboxBigInt, src, dest);
+  }
+  void unboxObject(const ValueOperand& src, Register dest);
+  void unboxObject(const Address& src, Register dest);
+  void unboxObject(const BaseIndex& src, Register dest);
+  template <typename T>
+  void unboxObject(const T& src, Register dest) {
+    IA64_MEM_DISPATCH(unboxObject, src, dest);
+  }
+  void unboxDouble(const ValueOperand& src, FloatRegister dest) {
+    emitM(ia64::SetfD(dest.encoding(), src.valueReg().encoding()));
+  }
+  void unboxDouble(const Address& src, FloatRegister dest) {
+    ma_loadFp(src, dest.asDouble());
+  }
+  void unboxDouble(const BaseIndex& src, FloatRegister dest) {
+    ma_loadFp(src, dest.asDouble());
+  }
+  template <typename T>
+  void unboxDouble(const T& src, FloatRegister dest) {
+    IA64_MEM_DISPATCH(unboxDouble, src, dest);
+  }
+  void unboxValue(const ValueOperand& src, AnyRegister dest, JSValueType type);
+  void unboxNonDouble(const ValueOperand& src, Register dest, JSValueType type);
+  void unboxNonDouble(const Address& src, Register dest, JSValueType type);
+  void unboxNonDouble(const BaseIndex& src, Register dest, JSValueType type);
+  void unboxGCThingForGCBarrier(const ValueOperand& src, Register dest);
+  void unboxGCThingForGCBarrier(const Address& src, Register dest);
+  template <typename T>
+  void unboxGCThingForGCBarrier(const T& src, Register dest) {
+    IA64_MEM_DISPATCH(unboxGCThingForGCBarrier, src, dest);
+  }
+
+  void unboxWasmAnyRefGCThingForGCBarrier(const Address& src, Register dest) {
+    emitMovl(dest.encoding(), wasm::AnyRef::GCThingMask);
+    loadPtr(src, SecondScratchReg);
+    emitM(ia64::And(dest.encoding(), dest.encoding(),
+                    SecondScratchReg.encoding()));
+  }
+  template <typename T>
+  void unboxWasmAnyRefGCThingForGCBarrier(const T& src, Register dest) {
+    IA64_MEM_DISPATCH(unboxWasmAnyRefGCThingForGCBarrier, src, dest);
+  }
+
+  void getWasmAnyRefGCThingChunk(Register src, Register dest) {
+    MOZ_ASSERT(src != dest);
+    emitMovl(dest.encoding(), wasm::AnyRef::GCThingChunkMask);
+    emitM(ia64::And(dest.encoding(), src.encoding(), dest.encoding()));
+  }
+
+  void notBoolean(ValueOperand val) {
+    emitMovl(ScratchReg.encoding(), 1);
+    emitM(ia64::Xor(val.valueReg().encoding(), val.valueReg().encoding(),
+                    ScratchReg.encoding()));
+  }
+  [[nodiscard]] Register extractObject(const Address& addr, Register scratch) {
+    unboxObject(addr, scratch);
+    return scratch;
+  }
+  [[nodiscard]] Register extractObject(const ValueOperand& val,
+                                       Register scratch) {
+    unboxObject(val, scratch);
+    return scratch;
+  }
+  [[nodiscard]] Register extractSymbol(const ValueOperand& val,
+                                       Register scratch) {
+    unboxSymbol(val, scratch);
+    return scratch;
+  }
+  [[nodiscard]] Register extractInt32(const ValueOperand& val,
+                                      Register scratch) {
+    unboxInt32(val, scratch);
+    return scratch;
+  }
+  [[nodiscard]] Register extractBoolean(const ValueOperand& val,
+                                        Register scratch) {
+    unboxBoolean(val, scratch);
+    return scratch;
+  }
+  [[nodiscard]] Register extractTag(const ValueOperand& val, Register scratch) {
+    emitTagOf(val, scratch);
+    return scratch;
+  }
+  [[nodiscard]] Register extractTag(const Address& addr, Register scratch) {
+    emitTagOf(addr, scratch);
+    return scratch;
+  }
+  [[nodiscard]] Register extractTag(const BaseIndex& addr, Register scratch) {
+    emitTagOf(addr, scratch);
+    return scratch;
+  }
+  template <typename T>
+  [[nodiscard]] Register extractTag(const T& addr, Register scratch) {
+    emitTagOf(addr, scratch);
+    return scratch;
+  }
+
+  void convertFloat32ToInt32(FloatRegister src, Register dest, Label* fail,
+                             bool negativeZeroCheck = true) {
+    ma_fpToInt(src, dest, 32, true, negativeZeroCheck, fail);
+  }
+  void convertDoubleToInt32(FloatRegister src, Register dest, Label* fail,
+                            bool negativeZeroCheck = true) {
+    ma_fpToInt(src, dest, 32, true, negativeZeroCheck, fail);
+  }
+  void convertDoubleToPtr(FloatRegister src, Register dest, Label* fail,
+                          bool negativeZeroCheck = true) {
+    ma_fpToInt(src, dest, 64, true, negativeZeroCheck, fail);
+  }
+  void convertBoolToInt32(Register src, Register dest) {
+    ma_zxt(dest, src, 1);
+  }
+
+  // Precision is a property of the instruction on IA-64, so a "conversion"
+  // between the two formats is just a rounding step (or none at all, since
+  // every single-precision value is exactly representable as a double).
+  void convertDoubleToFloat32(FloatRegister src, FloatRegister dest) {
+    emitF(ia64::FmaS(dest.encoding(), src.encoding(), ia64::fpOne,
+                     ia64::fpZero));
+  }
+  void convertFloat32ToDouble(FloatRegister src, FloatRegister dest) {
+    if (src.code() != dest.code()) {
+      emitF(ia64::Fmov(dest.encoding(), src.encoding()));
+    }
+  }
+
+  // int -> float: place the integer in the significand and let fcvt.xf
+  // normalise it. |width| bits of |src| are used, sign- or zero-extended.
+  void ma_intToFp(Register src, FloatRegister dest, unsigned width,
+                  bool isUnsigned, bool isDouble);
+
+  void convertInt32ToFloat32(Register src, FloatRegister dest) {
+    ma_intToFp(src, dest, 32, false, false);
+  }
+  void convertInt32ToDouble(Register src, FloatRegister dest) {
+    ma_intToFp(src, dest, 32, false, true);
+  }
+  void convertInt32ToDouble(const Address& src, FloatRegister dest) {
+    load32(src, SecondScratchReg);
+    ma_intToFp(SecondScratchReg, dest, 32, false, true);
+  }
+  void convertInt32ToDouble(const BaseIndex& src, FloatRegister dest) {
+    load32(src, SecondScratchReg);
+    ma_intToFp(SecondScratchReg, dest, 32, false, true);
+  }
+  template <typename T>
+  void convertInt32ToDouble(T, FloatRegister) {
+    MOZ_CRASH();
+  }
+
+  void convertDoubleToFloat16(FloatRegister, FloatRegister) { MOZ_CRASH(); }
+  void convertFloat16ToDouble(FloatRegister, FloatRegister) { MOZ_CRASH(); }
+  void convertFloat32ToFloat16(FloatRegister, FloatRegister) { MOZ_CRASH(); }
+  void convertFloat16ToFloat32(FloatRegister, FloatRegister) { MOZ_CRASH(); }
+  void convertInt32ToFloat16(Register, FloatRegister) { MOZ_CRASH(); }
+
+  void loadConstantDouble(double d, FloatRegister dest) {
+    uint64_t bits;
+    memcpy(&bits, &d, sizeof(bits));
+    emitMovl(ScratchReg.encoding(), bits);
+    emitM(ia64::SetfD(dest.encoding(), ScratchReg.encoding()));
+  }
+  void loadConstantFloat32(float f, FloatRegister dest) {
+    uint32_t bits;
+    memcpy(&bits, &f, sizeof(bits));
+    emitMovl(ScratchReg.encoding(), bits);
+    emitM(ia64::SetfS(dest.encoding(), ScratchReg.encoding()));
+  }
+  Condition testInt32Truthy(bool, const ValueOperand&);
+  Condition testStringTruthy(bool, const ValueOperand&);
+  Condition testBigIntTruthy(bool, const ValueOperand&);
+
+  void loadUnboxedValue(const Address& src, MIRType type, AnyRegister dest) {
+    loadUnboxedValueImpl(src, type, dest);
+  }
+  void loadUnboxedValue(const BaseIndex& src, MIRType type, AnyRegister dest) {
+    loadUnboxedValueImpl(src, type, dest);
+  }
+  template <typename T>
+  void loadUnboxedValue(T, MIRType, AnyRegister) {
+    MOZ_CRASH();
+  }
+  template <typename T>
+  void storeUnboxedValue(const ConstantOrRegister&, MIRType, T) {
+    MOZ_CRASH();
+  }
+
+  void convertUInt32ToDouble(Register src, FloatRegister dest) {
+    ma_intToFp(src, dest, 32, true, true);
+  }
+  void convertUInt32ToFloat32(Register src, FloatRegister dest) {
+    ma_intToFp(src, dest, 32, true, false);
+  }
+  void incrementInt32Value(const Address& addr);
+  void handleFailureWithHandlerTail(Label* profilerExitTail, Label* bailoutTail,
+                                    uint32_t* returnValueCheckOffset);
+
+  bool buildOOLFakeExitFrame(void* fakeReturnAddr);
+
+  void setPrinter(Sprinter*) {}
+  Operand ToPayload(Operand base) { MOZ_CRASH(); }
+  Address ToPayload(Address addr) { return addr; }
+
+  Register getStackPointer() const { return StackPointer; }
+
+  // Instrumentation for entering and leaving the profiler.
+  void profilerEnterFrame(Register framePtr, Register scratch);
+  void profilerExitFrame();
+
+#ifdef JS_NUNBOX32
+  Address ToType(Address) { MOZ_CRASH(); }
+#endif
+
+ protected:
+  MacroAssembler& asMasm();
+  const MacroAssembler& asMasm() const;
+
+  template <typename T>
+  void loadUnboxedValueImpl(const T& src, MIRType type, AnyRegister dest);
+};
+
+using MacroAssemblerSpecific = MacroAssemblerIa64;
+
+static inline bool GetTempRegForIntArg(uint32_t usedIntArgs, uint32_t,
+                                       Register* out) {
+  if (usedIntArgs >= NumCallTempNonArgRegs) {
+    return false;
+  }
+  *out = CallTempNonArgRegs[usedIntArgs];
+  return true;
+}
+
+}  // namespace jit
+}  // namespace js
+
+#endif /* jit_ia64_MacroAssembler_ia64_h */
