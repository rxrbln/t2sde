+// ===========================================================================
+// Floating point. See the [SMDOC] block in MacroAssembler-ia64.cpp for how the
+// register format, the missing divide and the missing square root are handled.
+
+static constexpr FloatRegister FpZeroReg = {FloatRegisters::f0,
+                                            FloatRegister::Double};
+
+void MacroAssembler::addFloat32(FloatRegister src, FloatRegister dest) {
+  emitF(ia64::FmaS(dest.encoding(), src.encoding(), ia64::fpOne,
+                   dest.encoding()));
+}
+void MacroAssembler::subFloat32(FloatRegister src, FloatRegister dest) {
+  emitF(ia64::FmsS(dest.encoding(), dest.encoding(), ia64::fpOne,
+                   src.encoding()));
+}
+void MacroAssembler::mulFloat32(FloatRegister src, FloatRegister dest) {
+  emitF(ia64::FmaS(dest.encoding(), dest.encoding(), src.encoding(),
+                   ia64::fpZero));
+}
+void MacroAssembler::divFloat32(FloatRegister src, FloatRegister dest) {
+  ma_fdiv(dest, src, dest, false);
+}
+void MacroAssembler::addDouble(FloatRegister src, FloatRegister dest) {
+  emitF(ia64::FaddD(dest.encoding(), src.encoding(), dest.encoding()));
+}
+void MacroAssembler::subDouble(FloatRegister src, FloatRegister dest) {
+  emitF(ia64::FsubD(dest.encoding(), dest.encoding(), src.encoding()));
+}
+void MacroAssembler::mulDouble(FloatRegister src, FloatRegister dest) {
+  emitF(ia64::FmpyD(dest.encoding(), dest.encoding(), src.encoding()));
+}
+void MacroAssembler::divDouble(FloatRegister src, FloatRegister dest) {
+  ma_fdiv(dest, src, dest, true);
+}
+void MacroAssembler::absDouble(FloatRegister src, FloatRegister dest) {
+  emitF(ia64::Fabs(dest.encoding(), src.encoding()));
+}
+void MacroAssembler::absFloat32(FloatRegister src, FloatRegister dest) {
+  emitF(ia64::Fabs(dest.encoding(), src.encoding()));
+}
+void MacroAssembler::negateDouble(FloatRegister reg) {
+  emitF(ia64::Fneg(reg.encoding(), reg.encoding()));
+}
+void MacroAssembler::negateFloat(FloatRegister reg) {
+  emitF(ia64::Fneg(reg.encoding(), reg.encoding()));
+}
+void MacroAssembler::sqrtDouble(FloatRegister src, FloatRegister dest) {
+  ma_fsqrt(src, dest, true);
+}
+void MacroAssembler::sqrtFloat32(FloatRegister src, FloatRegister dest) {
+  ma_fsqrt(src, dest, false);
+}
+void MacroAssembler::minDouble(FloatRegister other, FloatRegister srcDest,
+                               bool handleNaN) {
+  ma_minmax(other, srcDest, false, handleNaN);
+}
+void MacroAssembler::maxDouble(FloatRegister other, FloatRegister srcDest,
+                               bool handleNaN) {
+  ma_minmax(other, srcDest, true, handleNaN);
+}
+void MacroAssembler::minFloat32(FloatRegister other, FloatRegister srcDest,
+                                bool handleNaN) {
+  ma_minmax(other, srcDest, false, handleNaN);
+}
+void MacroAssembler::maxFloat32(FloatRegister other, FloatRegister srcDest,
+                                bool handleNaN) {
