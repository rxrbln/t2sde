+  void notBoolean(ValueOperand val) {
+    emitMovl(ScratchReg.encoding(), 1);
+    emitM(ia64::Xor(val.valueReg().encoding(), val.valueReg().encoding(),
+                    ScratchReg.encoding()));
+  }
+  [[nodiscard]] Register extractObject(const Address& addr, Register scratch) {
+    unboxObject(addr, scratch);
+    return scratch;
+  }
+  [[nodiscard]] Register extractObject(const ValueOperand& val,
+                                       Register scratch) {
+    unboxObject(val, scratch);
+    return scratch;
