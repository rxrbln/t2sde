@@ -516,6 +516,15 @@ static void* ReserveProcessExecutableMem
   void* p = MozTaggedAnonymousMmap(randomAddr, bytes, protection, flags, -1, 0,
                                    "js-executable-memory");
   if (p == MAP_FAILED) {
+    // The comment above assumes an unavailable hint merely makes the kernel
+    // pick another address. That does not hold on ia64, where an address
+    // outside the implemented range of a region is rejected with EINVAL rather
+    // than relocated, so a randomly chosen hint fails outright. Retry without
+    // randomization, mirroring what the Windows path above already does.
+    p = MozTaggedAnonymousMmap(nullptr, bytes, protection, flags, -1, 0,
+                               "js-executable-memory");
+  }
+  if (p == MAP_FAILED) {
     return nullptr;
   }
