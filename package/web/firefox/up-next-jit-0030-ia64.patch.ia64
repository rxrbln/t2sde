+
+#ifndef jit_ia64_MacroAssembler_ia64_h
+#define jit_ia64_MacroAssembler_ia64_h
+
+#include <type_traits>
+
+#include "jit/CompactBuffer.h"
+#include "jit/ia64/Assembler-ia64.h"
+#include "jit/MoveResolver.h"
+#include "jit/shared/IonAssemblerBuffer.h"
+#include "wasm/WasmAnyRef.h"
+#include "wasm/WasmCodegenTypes.h"
+#include "wasm/WasmTypeDecls.h"
+
+using js::wasm::FaultingCodeOffset;
+using js::wasm::FaultingCodeOffsetPair;
+
+namespace js {
+namespace jit {
+
+class CompactBufferReader;
+class MacroAssembler;
+
+// On JS_PUNBOX64 a Value is a single 64-bit register. IA-64 has no cheap way to
+// shift the tag down to bit 0, so the "tag register" used by the testXxx()
+// helpers below holds the value with its payload bits masked off instead:
+//
+//   tag = value & ~JS::detail::ValueGCThingPayloadMask
+//
+// Every tag test then becomes a comparison against the corresponding
+// JSVAL_SHIFTED_TAG_* constant, which needs no shift at all.
+static const uint64_t ValueTagMask = ~JS::detail::ValueGCThingPayloadMask;
+
+class ScratchTagScope {
+  Register reg_;
+
+ public:
+  ScratchTagScope(MacroAssembler&, const ValueOperand) : reg_(SecondScratchReg) {}
+  operator Register() { return reg_; }
+  void release() {}
+  void reacquire() {}
+};
+
+class ScratchTagScopeRelease {
+ public:
+  explicit ScratchTagScopeRelease(ScratchTagScope*) {}
+};
+
+// BaseValueIndex, BaseObjectElementIndex and BaseObjectSlotIndex all derive
+// from BaseIndex, and overload resolution prefers an exact template match over
+// the derived-to-base conversion the real overloads need. These route such a
+// type to its base and leave everything else at the MOZ_CRASH stub.
+#define IA64_MEM_DISPATCH(Name, Addr, Dest)                       \
+  if constexpr (std::is_base_of_v<BaseIndex, T>) {                \
+    Name(static_cast<const BaseIndex&>(Addr), Dest);              \
+  } else if constexpr (std::is_base_of_v<Address, T>) {           \
+    Name(static_cast<const Address&>(Addr), Dest);                \
+  } else {                                                        \
+    MOZ_CRASH("ia64: unsupported operand type");                  \
+  }
+
+#define IA64_MEM_DISPATCH_R(Name, Addr, Dest)                     \
+  if constexpr (std::is_base_of_v<BaseIndex, T>) {                \
+    return Name(static_cast<const BaseIndex&>(Addr), Dest);       \
+  } else if constexpr (std::is_base_of_v<Address, T>) {           \
+    return Name(static_cast<const Address&>(Addr), Dest);         \
+  } else {                                                        \
+    MOZ_CRASH("ia64: unsupported operand type");                  \
+  }
+
+#define IA64_MEM_DISPATCH2(Name, Src, Addr)                       \
+  if constexpr (std::is_base_of_v<BaseIndex, T>) {                \
+    Name(Src, static_cast<const BaseIndex&>(Addr));               \
+  } else if constexpr (std::is_base_of_v<Address, T>) {           \
+    Name(Src, static_cast<const Address&>(Addr));                 \
+  } else {                                                        \
+    MOZ_CRASH("ia64: unsupported operand type");                  \
+  }
+
+#define IA64_MEM_DISPATCH_S(Name, Value, Addr)                    \
+  if constexpr (std::is_base_of_v<BaseIndex, S>) {                \
+    Name(Value, static_cast<const BaseIndex&>(Addr));             \
+  } else if constexpr (std::is_base_of_v<Address, S>) {           \
+    Name(Value, static_cast<const Address&>(Addr));               \
+  } else {                                                        \
+    MOZ_CRASH("ia64: unsupported operand type");                  \
+  }
+
+#define IA64_MEM_DISPATCH_S_R(Name, Value, Addr)                  \
+  if constexpr (std::is_base_of_v<BaseIndex, S>) {                \
+    return Name(Value, static_cast<const BaseIndex&>(Addr));      \
+  } else if constexpr (std::is_base_of_v<Address, S>) {           \
+    return Name(Value, static_cast<const Address&>(Addr));        \
+  } else {                                                        \
+    MOZ_CRASH("ia64: unsupported operand type");                  \
+  }
+
+class MacroAssemblerIa64 : public Assembler {
+ public:
+  // Emit a compare for |cond| and return the predicate register to branch on.
+  uint32_t emitCompare(Assembler::Condition cond, Register lhs, Register rhs);
+  uint32_t emitCompare(Assembler::Condition cond, Register lhs, Imm32 rhs);
+  uint32_t emitCompare(Assembler::Condition cond, Register lhs, ImmWord rhs);
+  uint32_t emitCompare(Assembler::Condition cond, Register lhs, ImmPtr rhs) {
+    return emitCompare(cond, lhs, ImmWord(uintptr_t(rhs.value)));
+  }
+  uint32_t emitCompare(Assembler::Condition cond, Register lhs, ImmGCPtr rhs) {
+    movePtr(rhs, ScratchReg);
+    return emitCompare(cond, lhs, ScratchReg);
+  }
+  // Address operands for the cmp32Set()/cmpPtrSet() templates. The load width
+  // must follow the width of the COMPARISON, not the type of the right-hand
+  // side: with a Register rhs the two are indistinguishable, and guessing
+  // pointer width loads 8 bytes from what may be a 4-byte Int32 stack slot.
+  // Those slots are only 4-byte aligned, so on ia64 that traps; the kernel
+  // fixes it up transparently at roughly a thousand times the cost of an
+  // aligned load, which is invisible in test results but ruinous for
+  // performance. |width| is the comparison width in bits.
+  template <typename T>
+  uint32_t emitCompareWidth(Assembler::Condition cond, Register lhs, T rhs,
+                            unsigned width) {
+    return emitCompare(cond, lhs, rhs);
+  }
+  template <typename T>
+  uint32_t emitCompareWidth(Assembler::Condition cond, const Address& lhs,
+                            T rhs, unsigned width) {
+    if (width <= 32) {
+      load32(lhs, SecondScratchReg);
+    } else {
+      loadPtr(lhs, SecondScratchReg);
+    }
+    return emitCompare(cond, SecondScratchReg, rhs);
+  }
+
+  // Emit the "and, then compare against zero" sequence shared by every test.
+  // |width| is the operand width in bits: a Signed test has to look at bit 31
+  // for test32, and a 32-bit result is not always sign-extended into the
+  // register (rshift32 by a variable count leaves it zero-extended).
+  uint32_t emitTest(Assembler::Condition cond, Register lhs, Register rhs,
+                    unsigned width = 64);
+  uint32_t emitTest(Assembler::Condition cond, Register lhs, Imm32 rhs,
+                    unsigned width = 64);
+
+  // IA-64 loads and stores have no displacement field, so an Address must be
+  // materialised into a register first. |out| receives base + offset.
+  void computeAddress(const Address& addr, Register out);
+  void computeAddress(const BaseIndex& addr, Register out);
+  void computeAddress(const AbsoluteAddress& addr, Register out);
+
+  // IA-64 faults on a memory reference that is not naturally aligned, so data
+  // with no alignment guarantee (bytecode operands, DataView accesses) has to
+  // be assembled from single-byte accesses. |bytes| is 2, 4 or 8.
+  template <typename T>
+  void ma_loadUnaligned(const T& src, Register dest, unsigned bytes,
+                        bool signExtend);
+  template <typename T>
+  void ma_storeUnaligned(Register src, const T& dest, unsigned bytes);
+
+  // Shifts, extends and multiplies. IA-64 provides these on the I and F units;
+  // they are funnelled through these helpers so that the rest of the backend
+  // needs no knowledge of which encodings exist yet.
+  void ma_lsl(Register dest, Register src, Imm32 shift);
+  void ma_lsr(Register dest, Register src, Imm32 shift);
+  void ma_asr(Register dest, Register src, Imm32 shift);
+  void ma_lsl(Register dest, Register src, Register shift);
+  void ma_lsr(Register dest, Register src, Register shift);
+  void ma_asr(Register dest, Register src, Register shift);
+  void ma_rol(Register dest, Register src, Imm32 count, unsigned width);
+  void ma_ror(Register dest, Register src, Imm32 count, unsigned width);
+  void ma_sxt(Register dest, Register src, unsigned bytes);
+  void ma_zxt(Register dest, Register src, unsigned bytes);
+  void ma_mul(Register dest, Register lhs, Register rhs);
+
+  // Software divide; |width| is 32 or 64. Either output may be InvalidReg, but
+  // not both, and the two must not be the same register.
+  void ma_divmod(Register divOutput, Register remOutput, Register lhs,
+                 Register rhs, bool isUnsigned, unsigned width);
+
+  // Materialise |imm| into |dest|, using the short "adds" form where possible.
+  void ma_li(Register dest, int64_t imm);
+
+  // An IA-64 C function pointer is the address of a two-word descriptor
+  // holding the entry point and the callee's gp. |desc| is clobbered.
+  CodeOffset callABIDescriptor(Register desc);
+
+  // Materialise a Register/Imm operand into a register for the sequences that
+  // need both operands live after the operation.
+  Register ma_operand(Register r, Register) { return r; }
+  Register ma_operand(Imm32 imm, Register scratch) {
+    move32(imm, scratch);
+    return scratch;
+  }
+  Register ma_operand(ImmWord imm, Register scratch) {
+    movePtr(imm, scratch);
+    return scratch;
+  }
+
+  // Conditional register move: dest = cond ? src : dest.
+  void ma_cmov(Assembler::Condition cond, Register src, Register dest);
+
+  // tag = value & ValueTagMask
+  void emitTagOf(const ValueOperand& value, Register tag);
+  void emitTagOf(const Address& value, Register tag);
+  void emitTagOf(const BaseIndex& value, Register tag);
+
+  // Tag tests. Each takes the masked tag produced by emitTagOf() and leaves a
+  // comparison result in the predicate pair; the returned predicate is the one
+  // to branch on.
+  uint32_t testTagEqual(Assembler::Condition cond, Register tag, uint64_t tagBits);
+  uint32_t testTagRange(Assembler::Condition cond, Register tag, uint64_t bound,
+                        bool inclusiveBelow);
+
+  // ---- floating point ----------------------------------------------------
+  //
+  // Predicates p8-p11 are the floating-point scratch set, kept apart from the
+  // p6/p7 pair the integer compares use so that a floating-point compare can
+  // be emitted between an integer compare and the branch that consumes it.
+  static constexpr uint32_t kFpP = 8;
+  static constexpr uint32_t kFpQ = 9;
+  static constexpr uint32_t kFpR = 10;
+  static constexpr uint32_t kFpS = 11;
+
+  // f2-f5, held back from the allocator, are the scratch pool. f2 and f3 are
+  // also ScratchDoubleReg/ScratchFloat32Reg.
+  static constexpr uint32_t kFpT0 = FloatRegisters::f2;
+  static constexpr uint32_t kFpT1 = FloatRegisters::f3;
+  static constexpr uint32_t kFpT2 = FloatRegisters::f4;
+  static constexpr uint32_t kFpT3 = FloatRegisters::f5;
+  static constexpr uint32_t kFpT4 = FloatRegisters::f6;
+  static constexpr uint32_t kFpT5 = FloatRegisters::f7;
+
+  // Emit a floating-point compare for |cond| and return the predicate to
+  // branch on.
+  uint32_t emitFpCompare(Assembler::DoubleCondition cond, FloatRegister lhs,
+                         FloatRegister rhs);
+
+  // dest = lhs / rhs and dest = sqrt(src): frcpa/frsqrta plus Newton-Raphson.
+  void ma_fdiv(FloatRegister lhs, FloatRegister rhs, FloatRegister dest,
+               bool isDouble);
+  void ma_fsqrt(FloatRegister src, FloatRegister dest, bool isDouble);
+
+  // The Newton-Raphson bodies, shared between the direct and the rescaled
+  // paths. |round| selects the final .d/.s rounding step; without it the
+  // 82-bit result is left in place for the caller to scale.
+  void emitDivRefine(uint32_t a, uint32_t b, uint32_t dest, bool isDouble,
+                     bool round);
+  void emitSqrtRefine(uint32_t a, uint32_t dest, bool isDouble, bool round);
+
+  // srcDest = min/max(srcDest, other), with JS semantics for NaN and for the
+  // two zeroes.
+  void ma_minmax(FloatRegister other, FloatRegister srcDest, bool isMax,
+                 bool handleNaN);
+
+  // Truncate |src| toward zero into |dest|, branching to |fail| when the
+  // result is not a |width|-bit signed integer. With |exact| the value must
+  // also have been integral to begin with, and with |negativeZeroCheck| a
+  // result of zero from a negative input fails too.
+  void ma_fpToInt(FloatRegister src, Register dest, unsigned width, bool exact,
+                  bool negativeZeroCheck, Label* fail);
+
+  // Round |src| to an integer in |dest| the way Math.floor/ceil/trunc do,
+  // branching to |fail| for anything that is not an int32 result.
+  enum FpRound { RoundFloor, RoundCeil, RoundTrunc };
+  void ma_fpRound(FloatRegister src, Register dest, FpRound mode, Label* fail);
+
+  // dest = the IEEE bit pattern of |src|, sign-extended for a single.
+  void ma_fpBits(FloatRegister src, Register dest);
+
+  FaultingCodeOffset ma_loadFp(const Address& addr, FloatRegister dest);
+  FaultingCodeOffset ma_loadFp(const BaseIndex& addr, FloatRegister dest);
+  FaultingCodeOffset ma_storeFp(FloatRegister src, const Address& addr);
+  FaultingCodeOffset ma_storeFp(FloatRegister src, const BaseIndex& addr);
+
+ public:
+  MacroAssemblerIa64() = default;
+
+  MoveResolver moveResolver_;
+
+  CompactBufferWriter dataRelocations_;
+  CompactBufferWriter jumpRelocations_;
+
+  // Record that the movl about to be emitted embeds a GC pointer, so that the
+  // GC can trace and update it.
+  void writeDataRelocation(ImmGCPtr ptr);
+  void writeJumpRelocation();
+
+  size_t size() const { return m_buffer.size(); }
+  size_t bytesNeeded() const {
+    return size() + jumpRelocationTableBytes() + dataRelocationTableBytes();
+  }
+  size_t jumpRelocationTableBytes() const { return jumpRelocations_.length(); }
+  size_t dataRelocationTableBytes() const { return dataRelocations_.length(); }
+  size_t preBarrierTableBytes() const { return 0; }
+
+  // Offsets of the code labels that were emitted as a movl immediate; the
+  // rest are raw pointer slots written by writeCodePointer().
+  mozilla::Vector<uint32_t, 4, SystemAllocPolicy> movlCodeLabels_;
+
+  size_t numCodeLabels() const { return codeLabels_.length(); }
+  CodeLabel codeLabel(size_t i) { return codeLabels_[i]; }
+
+  bool reserve(size_t size) { return !oom(); }
+  bool appendRawCode(const uint8_t* code, size_t numBytes) { MOZ_CRASH(); }
+  bool swapBuffer(wasm::Bytes& bytes) { MOZ_CRASH(); }
+
+  void assertNoGCThings() const {
+    MOZ_ASSERT(dataRelocations_.length() == 0);
+  }
+
+  static void TraceJumpRelocations(JSTracer*, JitCode*, CompactBufferReader&);
+  static void TraceDataRelocations(JSTracer*, JitCode*, CompactBufferReader&);
+
+  static bool SupportsFloatingPoint() { return true; }
+  static bool SupportsUnalignedAccesses() { return false; }
+  static bool SupportsFastUnalignedFPAccesses() { return false; }
+  static bool SupportsFloat64To16() { return false; }
+  static bool SupportsFloat32To16() { return false; }
+
+  void executableCopy(void* buffer, bool = true) {
+    memcpy(buffer, m_buffer.data(), m_buffer.size());
+  }
+  void copyJumpRelocationTable(uint8_t* dest) {
+    if (jumpRelocations_.length()) {
+      memcpy(dest, jumpRelocations_.buffer(), jumpRelocations_.length());
+    }
+  }
+  void copyDataRelocationTable(uint8_t* dest) {
+    if (dataRelocations_.length()) {
+      memcpy(dest, dataRelocations_.buffer(), dataRelocations_.length());
+    }
+  }
+  void copyPreBarrierTable(uint8_t*) {}
+  void processCodeLabels(uint8_t* rawCode);
+
+  void flushBuffer() {}
+
+  void bind(Label* label) { Assembler::bind(label); }
+  void bind(CodeLabel* label) { label->target()->bind(currentOffset()); }
+  template <typename T>
+  void bind(T label) {
+    if constexpr (std::is_convertible_v<T, Label*>) {
+      Assembler::bind(static_cast<Label*>(label));
+    } else {
+      MOZ_CRASH("ia64: unsupported label type");
+    }
+  }
+  template <typename T>
+  void j(Condition, T) {
+    MOZ_CRASH();
+  }
+
+  void jump(Label* label);
+  void jump(Register reg);
+  void jump(ImmPtr ptr);
+  void jump(TrampolinePtr code);
+  void jump(JitCode* code);
+  void jump(const Address& addr);
+  template <typename T>
+  void jump(T label) {
+    if constexpr (std::is_convertible_v<T, Label*>) {
+      jump(static_cast<Label*>(label));
+    } else {
+      MOZ_CRASH("ia64: unsupported jump target");
+    }
+  }
+
+  // A raw eight-byte pointer slot, patched by processCodeLabels(). Dispatch
+  // tables need their entries exactly pointer-sized, so this is the one thing
+  // the buffer holds that is not a bundle. Callers must alignToBundle() once
+  // the table is complete, otherwise every following instruction offset is
+  // off by eight and label chains and branch displacements go wrong.
+  void writeCodePointer(CodeLabel* label) {
+    label->patchAt()->bind(currentOffset());
+    uint64_t zero = 0;
+    m_buffer.putBytes(sizeof(zero), &zero);
+  }
+  void alignToBundle() {
+    uint64_t zero = 0;
+    while (!oom() && currentOffset() % sizeof(ia64::Bundle) != 0) {
+      m_buffer.putBytes(sizeof(zero), &zero);
+    }
+  }
+  void haltingAlign(size_t) { alignToBundle(); }
+  void nopAlign(size_t) { alignToBundle(); }
+  void checkStackAlignment() {}
+  uint32_t currentOffset() { return m_buffer.nextOffset().getOffset(); }
+
+  void nop() { emitM(ia64::NopM()); }
+  void breakpoint() { emitM(ia64::NopM()); }
+  // abiret() returns to a C caller through b0; ret() returns to a JIT caller,
+  // whose return address call() left on the stack. Stubs that shared code ends
+  // with abiret() but that JIT code enters with call() have to use ret() here,
+  // otherwise the pushed return address is left behind on every call.
+  void abiret() { emitB(ia64::BrRet(0)); }
+  BufferOffset ret() {
+    pop(ScratchReg);
+    emitI(ia64::MovToBr(6, ScratchReg.encoding()));
+    return emitB(ia64::BrCond(6));
+  }
+
+  CodeOffset toggledJump(Label* label);
+  CodeOffset toggledCall(JitCode* target, bool enabled);
+  static size_t ToggledCallSize(uint8_t*) {
+    return Assembler::kToggledCallBundles * sizeof(ia64::Bundle);
+  }
+
+  void finish() {}
