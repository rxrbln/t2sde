+  // ---- Raw stack pushes/pops --------------------------------------------
+  //
+  // The JIT's stack discipline moves the stack pointer one 8-byte slot at a
+  // time. IA-64 hardware only requires natural alignment for each access, so an
+  // 8-byte-aligned sp is fine inside JIT code; the 16-byte ABI alignment is
+  // re-established at ABI call boundaries by setupUnalignedABICall().
+
+  void push(Register reg);
+  void push(Imm32 imm);
+  void push(ImmWord imm);
+  void push(ImmPtr imm);
+  void push(ImmGCPtr imm);
+  void push(const Address& addr);
+  void push(FloatRegister src);
+  // CacheIR hands the assembler a lot of Auto* register handles. They only
+  // match an overload through their conversion operator, and template deduction
+  // beats a user-defined conversion, so convert to the real register type
+  // first or the catch-all below would swallow the call and crash at runtime.
+  template <typename T>
+  void push(const T& reg) {
+    if constexpr (std::is_convertible_v<T, Register>) {
+      push(static_cast<Register>(reg));
+    } else if constexpr (std::is_convertible_v<T, FloatRegister>) {
+      push(static_cast<FloatRegister>(reg));
+    } else {
+      MOZ_CRASH();
+    }
+  }
+
+  void pop(Register reg);
+  void pop(const ValueOperand& val);
+  void pop(FloatRegister dest);
+  template <typename T>
+  void pop(const T& reg) {
+    if constexpr (std::is_convertible_v<T, Register>) {
+      pop(static_cast<Register>(reg));
+    } else if constexpr (std::is_convertible_v<T, ValueOperand>) {
+      pop(static_cast<ValueOperand>(reg));
+    } else if constexpr (std::is_convertible_v<T, FloatRegister>) {
+      pop(static_cast<FloatRegister>(reg));
+    } else {
+      MOZ_CRASH();
+    }
+  }
+
+  // Called by the shared PushRegs()/PopRegs() wrappers, which forward their
+  // arguments untouched, so this also has to deal with Auto* register handles.
+  template <typename... Regs>
+  void pushRegs(const Regs&... regs) {
+    static_assert((std::is_convertible_v<Regs, Register> && ...));
+    static_assert(sizeof...(Regs) > 0);
+    (pushRegOrLink(regs), ...);
+  }
+
+  template <typename... Regs>
+  void popRegs(const Regs&... regs) {
+    static_assert((std::is_convertible_v<Regs, Register> && ...));
+    static_assert(sizeof...(Regs) > 0);
+    (popRegOrLink(regs), ...);
+  }
+
+  template <typename Reg>
+  void pushRegOrLink(const Reg& reg) {
+    Register r = static_cast<Register>(reg);
+    if (r == LinkRegister) {
+      emitI(ia64::MovFromBr(ScratchReg.encoding(), 0));
+      push(ScratchReg);
+      return;
+    }
+    push(r);
+  }
+
+  template <typename Reg>
+  void popRegOrLink(const Reg& reg) {
+    Register r = static_cast<Register>(reg);
+    if (r == LinkRegister) {
+      pop(ScratchReg);
+      emitI(ia64::MovToBr(0, ScratchReg.encoding()));
+      return;
+    }
+    pop(r);
+  }
+
+  template <typename T>
+  void Push(T) {
