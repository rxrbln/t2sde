+  // users of call(ImmPtr) (call(TrampolinePtr) and the blinterp entry
+  // trampoline) really do pass a raw code address, so this cannot be folded
+  // into call(ImmPtr) itself.
+  movePtr(ImmPtr(fun), CallTempReg5);
+  callABIDescriptorIA64(CallTempReg5);
+#else
   call(ImmPtr(fun));
+#endif
 
   callWithABIPost(stackAdjust, result);
 
