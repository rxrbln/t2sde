+                                                      !std::is_base_of_v<
+                                                          Label,
+                                                          std::remove_pointer_t<T>>>>
+  void jump(T) {
+    MOZ_CRASH();
+  }
+
+  // Exactly one pointer, because jump tables are indexed with ScalePointer and
+  // Assembler::Bind patches each site with a single 8-byte store. That is half
+  // a bundle, so a table with an odd number of entries leaves the buffer out of
+  // step: call alignToBundle() once the table is complete.
+  void writeCodePointer(CodeLabel* label) {
+    // Raw data, not an instruction: close the open bundle first so the pointer
+    // does not land on top of it.
+    flush();
+    label->patchAt()->bind(currentOffset());
+    label->setLinkMode(CodeLabel::RawPointer);
+    uint64_t zero = 0;
+    m_buffer.putBytes(sizeof(zero), &zero);
+  }
+
+  // Restore bundle alignment after a run of writeCodePointer()s. Bundles must
+  // start on a 16-byte boundary -- the low 4 bits of an instruction address are
+  // the slot number, so the hardware simply cannot fetch a bundle from a
+  // half-aligned address -- and BundleIndex() derives every branch displacement
+  // from offset / sizeof(Bundle), so anything emitted past an odd-length table
+  // would otherwise be both unfetchable and mis-targeted.
+  void alignToBundle() {
+    flush();
+    while (m_buffer.nextOffset().getOffset() % sizeof(ia64::Bundle) != 0) {
+      uint64_t zero = 0;
+      m_buffer.putBytes(sizeof(zero), &zero);
+    }
+  }
+  void haltingAlign(size_t) {}
+  void nopAlign(size_t) {}
+  void checkStackAlignment() {}
+  // Closes the open bundle: every caller either wants a real bundle boundary
+  // (a return address, a label, a code pointer) or is about to compare offsets,
+  // and neither survives a bundle that is still filling. Code that wants the
+  // address of the instruction it is *about* to emit must take emit()'s return
+  // value instead -- sampling this first would close the bundle and lose the
+  // packing, and in a fixed-layout sequence it would name the wrong bundle.
+  //
+  // The instruction group is left running (softFlush, not flush). This is by
+  // far the hottest boundary in the backend -- every FaultingCodeRange, every
+  // patch site and every CodeOffset in Baseline and CacheIR passes through
+  // here -- and needing a byte offset says nothing about the dependencies of
+  // the code that follows.
+  uint32_t currentOffset() {
+    whyIfOther(WhyOffset);
+    softFlush();
+    return m_buffer.nextOffset().getOffset();
+  }
