diff --git a/js/src/jit/shared/CodeGenerator-shared.cpp b/js/src/jit/shared/CodeGenerator-shared.cpp
--- a/js/src/jit/shared/CodeGenerator-shared.cpp
+++ b/js/src/jit/shared/CodeGenerator-shared.cpp
@@ -241,6 +241,22 @@ void CodeGeneratorShared::bailoutFrom(Label* label, LSnapshot* snapshot) {
   addOutOfLineCode(ool,
                    new (alloc()) BytecodeSite(tree, tree->script()->code()));
 
+#ifdef JS_CODEGEN_IA64
+  // The bailout reads only the snapshot's registers: the branches to |label|
+  // still waiting in the scheduling window may have code moved across them
+  // (Scheduler-ia64.h).
+  uint64_t gr = 0, fr = 0;
+  for (size_t i = 0; i < snapshot->numEntries(); i++) {
+    const LAllocation* a = snapshot->getEntry(i);
+    if (a->isGeneralReg()) {
+      gr |= uint64_t(1) << a->toGeneralReg()->reg().encoding();
+    } else if (a->isFloatReg()) {
+      fr |= uint64_t(1) << a->toFloatReg()->reg().encoding();
+    }
+  }
+  masm.setGuardLive(label, gr, fr);
+#endif
+
   masm.retarget(label, ool->entry());
 }
 
