+  // One FR code space: FloatRegister::FromCode() (and so ABIArg::fpu()) always
+  // yields a Double-tagged register, so take the register, not its tag.
+  explicit RegF32(FloatRegister reg) : FloatRegister(reg.asSingle()) {}
