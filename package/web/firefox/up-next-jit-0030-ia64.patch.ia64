+namespace js {
+namespace jit {
+
+class MacroAssembler;
+
+static constexpr Register StackPointer{Registers::sp};
+static constexpr Register FramePointer{Registers::r4};
+static constexpr Register ReturnReg{Registers::r8};
+// b0 holds the return address and no spill can encode it as a GPR, so
+// LinkRegister is a tag only: pushRegs()/popRegs() map it onto the
+// b0 <-> ScratchReg pair, as pushReturnAddress() does.
+static constexpr Register LinkRegister{Registers::invalid_reg2};
+static constexpr FloatRegister ReturnFloat32Reg = {FloatRegisters::f8,
+                                                    FloatRegister::Single};
+static constexpr FloatRegister ReturnDoubleReg = {FloatRegisters::f8,
+                                                   FloatRegister::Double};
+static constexpr FloatRegister ReturnSimd128Reg = {FloatRegisters::invalid_reg};
+static constexpr FloatRegister ScratchSimd128Reg = {
+    FloatRegisters::invalid_reg};
+static constexpr FloatRegister InvalidFloatReg = {FloatRegisters::invalid_reg};
+
+// f6/f7 back the two FP scratch scopes, mirroring the GPR ScratchReg/
+// SecondScratchReg split below; f2-f5 are reserved separately as internal
+// temporaries for the multi-step divide/sqrt/multiply sequences in
+// MacroAssembler-ia64.cpp and are never handed out via a scope.
+static constexpr FloatRegister ScratchFloat32Reg = {FloatRegisters::f6,
+                                                     FloatRegister::Single};
+static constexpr FloatRegister ScratchDoubleReg = {FloatRegisters::f6,
+                                                    FloatRegister::Double};
+static constexpr FloatRegister SecondScratchFloat32Reg = {
+    FloatRegisters::f7, FloatRegister::Single};
+static constexpr FloatRegister SecondScratchDoubleReg = {
+    FloatRegisters::f7, FloatRegister::Double};
+
+struct ScratchFloat32Scope : public AutoFloatRegisterScope {
+  explicit ScratchFloat32Scope(MacroAssembler& masm)
+      : AutoFloatRegisterScope(masm, ScratchFloat32Reg) {}
+};
+
+struct ScratchDoubleScope : public AutoFloatRegisterScope {
+  explicit ScratchDoubleScope(MacroAssembler& masm)
+      : AutoFloatRegisterScope(masm, ScratchDoubleReg) {}
+};
+
+struct SecondScratchFloat32Scope : public AutoFloatRegisterScope {
+  explicit SecondScratchFloat32Scope(MacroAssembler& masm)
+      : AutoFloatRegisterScope(masm, SecondScratchFloat32Reg) {}
+};
+
+struct SecondScratchDoubleScope : public AutoFloatRegisterScope {
+  explicit SecondScratchDoubleScope(MacroAssembler& masm)
+      : AutoFloatRegisterScope(masm, SecondScratchDoubleReg) {}
+};
+
+static constexpr Register OsrFrameReg{Registers::r15};
+static constexpr Register PreBarrierReg{Registers::r16};
+static constexpr Register InterpreterPCReg{Registers::r17};
+static constexpr Register CallTempReg0{Registers::r18};
+static constexpr Register CallTempReg1{Registers::r19};
+static constexpr Register CallTempReg2{Registers::r20};
+static constexpr Register CallTempReg3{Registers::r21};
+static constexpr Register CallTempReg4{Registers::r22};
+static constexpr Register CallTempReg5{Registers::r23};
+static constexpr Register BailoutStubHandlerReg = CallTempReg0;
+static constexpr Register InvalidReg{Registers::invalid_reg};
+
+// r2 and r3 are reserved by Architecture-ia64.h as assembler temporaries for
+// materialising large immediates and synthesising addressing modes.
+static constexpr Register ScratchReg{Registers::r3};
+static constexpr Register SecondScratchReg{Registers::r2};
+// A few sequences (variable rotate, the atomic CAS retry loops) need one or two
+// registers beyond those two.  r11 doubles as ContextPinReg (below): JS code
+// that writes it has to call loadContextPin() afterwards. They are reserved rather than taken from the
+// allocatable set, because the register allocator has no way to know a masm
+// helper clobbered one.
+static constexpr Register ThirdScratchReg{Registers::r10};
+static constexpr Register FourthScratchReg{Registers::r11};
+static constexpr Register GpReg{Registers::gp};
+
+struct ScratchRegisterScope : public AutoRegisterScope {
+  explicit ScratchRegisterScope(MacroAssembler& masm)
+      : AutoRegisterScope(masm, ScratchReg) {}
+};
+
+struct SecondScratchRegisterScope : public AutoRegisterScope {
+  explicit SecondScratchRegisterScope(MacroAssembler& masm)
+      : AutoRegisterScope(masm, SecondScratchReg) {}
+};
+static constexpr Register CallTempNonArgRegs[] = {
+    CallTempReg0, CallTempReg1, CallTempReg2,
+    CallTempReg3, CallTempReg4, CallTempReg5};
+static const uint32_t NumCallTempNonArgRegs = std::size(CallTempNonArgRegs);
+
+static constexpr Register IntArgReg0{Registers::out0};
+static constexpr Register IntArgReg1{Registers::out1};
+static constexpr Register IntArgReg2{Registers::out2};
+static constexpr Register IntArgReg3{Registers::out3};
+static constexpr Register IntArgReg4{Registers::out4};
+static constexpr Register IntArgReg5{Registers::out5};
+static constexpr Register IntArgReg6{Registers::out6};
+static constexpr Register IntArgReg7{Registers::out7};
+
+// The IA-64 psABI passes the first eight integer arguments in out0-out7 and the
+// first eight FP arguments in f8-f15.
+static constexpr uint32_t NumIntArgRegs = 8;
+static constexpr uint32_t NumFloatArgRegs = 8;
+static constexpr Register IntArgRegs[NumIntArgRegs] = {
+    IntArgReg0, IntArgReg1, IntArgReg2, IntArgReg3,
+    IntArgReg4, IntArgReg5, IntArgReg6, IntArgReg7};
+
+// The wasm ABI cannot use out0-out7: Ion pins arguments and call operands to
+// fixed registers, and the register allocator only honours fixed registers it
+// can allocate, which the out window never is.  Wasm integer arguments go in
+// allocatable caller-saved registers instead (r25-r31 and r9): disjoint from
+// the ABINonArgReg/Wasm* roles (r14-r17), the baseline compiler's scratch
+// (CallTempReg2, r20), ReturnReg (r8), JSReturnReg (r24), InstanceReg (r6)
+// and every assembler scratch.  FP arguments use f8-f15 under both ABIs.
+static constexpr uint32_t NumWasmIntArgRegs = 8;
+static constexpr Register WasmIntArgRegs[NumWasmIntArgRegs] = {
+    Register{Registers::r25}, Register{Registers::r26},
+    Register{Registers::r27}, Register{Registers::r28},
+    Register{Registers::r29}, Register{Registers::r30},
+    Register{Registers::r31}, Register{Registers::r9}};
+// wasm has no HeapReg on ia64 (WASM_HAS_HEAPREG is not defined, js/moz.configure):
+// the statically preserved registers are r4 (FramePointer), r5, r6 and r7, and
+// wasm needs InstanceReg, a callee-saved ABINonVolatileReg and a pinned memory
+// base, one more than are left once r7 is the object tag.  The memory base is
+// loaded from the instance instead, as on x86-32.  The constant exists only so
+// the (dead) HeapReg branches of the shared lowering code compile.
+static constexpr Register HeapReg{Registers::invalid_reg};
+
+// JS code keeps the object tag (JSVAL_SHIFTED_TAG_OBJECT, the commonest NaN-box
+// constant by far) in r7: callee-saved, so C++ preserves it, loaded by every
+// entry from C++ (EnterJIT and the irregexp prologue, which also save and
+// restore it), and never written by JIT code otherwise. Object boxing, unboxing
+// and tests read it instead of building the constant.
+static constexpr Register ObjectTagReg{Registers::r7};
+
+// JS code keeps the address of the JSContext's interrupt flag
+// (CompileRuntime::addressOfInterruptBits()) in r11, so that the interrupt
+// check at every loop header is `ld4 [r11]` and the fields next to the flag
+// (the stack limit, 0x14 above it) one adds away, instead of a movl each
+// (wiki/codegen.html).  r11 is FourthScratchReg, already outside the
+// allocatable set, so the pin costs the register allocator nothing (r9, taken
+// from the allocatable set, cost zlib 1.3%).  JS code that borrows r11 as a
+// scratch sets it again right after (BorrowScratch's users, the wide-offset
+// computeAddress()); the pipeliner keeps pr elsewhere.  r11 is volatile: no
+// JIT code writes it except to set it, so JIT-to-JIT calls keep it, and every
+// way back into JS code from C or from wasm sets it again: EnterJIT and the
+// irregexp prologue, callWithABIPost() in code compiled for a runtime (a
+// constant), the wasm JIT exit and JIT entry (from Instance::cx_; wasm code is
+// shared between threads and uses r11 as a scratch), Ion's direct calls into
+// wasm and the exception tail.  Only code compiled for a runtime reads it
+// (JitContext::runtime; nullptr for wasm).
+static constexpr Register ContextPinReg{Registers::r11};
+
+static constexpr Register RegExpMatcherRegExpReg{Registers::r25};
+static constexpr Register RegExpMatcherStringReg{Registers::r27};
+static constexpr Register RegExpMatcherLastIndexReg{Registers::r28};
+
+static constexpr Register RegExpExecTestRegExpReg{Registers::r25};
+static constexpr Register RegExpExecTestStringReg{Registers::r27};
+
+static constexpr Register RegExpSearcherRegExpReg{Registers::r25};
+static constexpr Register RegExpSearcherStringReg{Registers::r27};
+static constexpr Register RegExpSearcherLastIndexReg{Registers::r28};
+
+static constexpr Register JSReturnReg_Type{Registers::r24};
+static constexpr Register JSReturnReg_Data{Registers::r24};
+static constexpr Register JSReturnReg{Registers::r24};
+
+#if defined(JS_NUNBOX32)
+static constexpr ValueOperand JSReturnOperand(JSReturnReg_Type,
+                                              JSReturnReg_Data);
+static constexpr Register64 ReturnReg64(ReturnReg, ReturnReg);
+#elif defined(JS_PUNBOX64)
+static constexpr ValueOperand JSReturnOperand(JSReturnReg);
+static constexpr Register64 ReturnReg64(ReturnReg);
+#else
+#  error "Bad architecture"
+#endif
+
+static constexpr Register ABINonArgReg0{Registers::r14};
+static constexpr Register ABINonArgReg1{Registers::r15};
+static constexpr Register ABINonArgReg2{Registers::r16};
+static constexpr Register ABINonArgReg3{Registers::r17};
+static constexpr Register ABINonArgReturnReg0{Registers::r14};
+static constexpr Register ABINonArgReturnReg1{Registers::r15};
+static constexpr Register ABINonVolatileReg{Registers::r5};
+// CallTempReg1: volatile, not an argument or return register.
+static constexpr Register ABINonArgReturnVolatileReg{Registers::r19};
+
+// f3: not an argument (f8-f15) or return (f8) register, and not one of the
+// scratch scopes (f6/f7): conversions such as convertDoubleToInt32 use
+// SecondScratchDouble (f7) for their own temporaries and would destroy a source
+// held there.  f3 is saved by the wasm entry stubs.
+static constexpr FloatRegister ABINonArgDoubleReg = {FloatRegisters::f3,
+                                                     FloatRegister::Double};
+
+// wasm registers.  InstanceReg is r6: the only statically preserved register
+// left besides ABINonVolatileReg (r5), so that it survives C calls and the
+// JS-visible EnterJIT/irregexp entries save and restore it.  The remaining
+// roles are filled from ABINonArgReg0-3 (r14-r17) like the other 64-bit ports;
+// each group below is never live at the same time as another, and none overlaps
+// ReturnReg (r8), JSReturnReg (r24), InstanceReg or the argument registers.
+static constexpr Register InstanceReg{Registers::r6};
+static constexpr Register WasmTableCallScratchReg0 = ABINonArgReg0;
+static constexpr Register WasmTableCallScratchReg1 = ABINonArgReg1;
+static constexpr Register WasmTableCallSigReg = ABINonArgReg2;
+static constexpr Register WasmTableCallIndexReg = ABINonArgReg3;
+static constexpr Register WasmJitEntryReturnScratch = ABINonArgReg1;
+static constexpr Register WasmCallRefCallScratchReg0 = ABINonArgReg0;
+static constexpr Register WasmCallRefCallScratchReg1 = ABINonArgReg1;
+static constexpr Register WasmCallRefCallScratchReg2 = ABINonArgReg2;
+static constexpr Register WasmCallRefReg = ABINonArgReg3;
+static constexpr Register WasmTailCallInstanceScratchReg = ABINonArgReg1;
+// The return address lives in b0, which is not a general register: the tail
+// call sequences move it through this one.
+// They must not alias the registers live across the frame collapse: the
+// signature id (WasmTableCallSigReg) and the callee (WasmCallRefReg), so they
+// come from the call temps (r21, r22), which no wasm argument or role uses.
+static constexpr Register WasmTailCallRAScratchReg = CallTempReg3;
+static constexpr Register WasmTailCallFPScratchReg = CallTempReg4;
+
+// ABIStackAlignment, CodeAlignment, JitStackAlignment and
+// JitStackValueAlignment are defined in Architecture-ia64.h; ia64 requires
+// 16-byte stack alignment throughout.
+
+static const Scale ScalePointer = TimesEight;
+
+class Assembler : public AssemblerShared {
+ public:
+  enum Condition {
+    Equal,
+    NotEqual,
+    Above,
+    AboveOrEqual,
+    Below,
+    BelowOrEqual,
+    GreaterThan,
+    GreaterThanOrEqual,
+    LessThan,
+    LessThanOrEqual,
+    Overflow,
+    CarrySet,
+    CarryClear,
+    Signed,
+    NotSigned,
+    Zero,
+    NonZero,
+    Always,
+  };
+
+  enum DoubleCondition {
+    DoubleOrdered,
+    DoubleEqual,
+    DoubleNotEqual,
+    DoubleGreaterThan,
+    DoubleGreaterThanOrEqual,
+    DoubleLessThan,
+    DoubleLessThanOrEqual,
+    DoubleUnordered,
+    DoubleEqualOrUnordered,
+    DoubleNotEqualOrUnordered,
+    DoubleGreaterThanOrUnordered,
+    DoubleGreaterThanOrEqualOrUnordered,
+    DoubleLessThanOrUnordered,
+    DoubleLessThanOrEqualOrUnordered
+  };
+
+  // ---- code emission -----------------------------------------------------
+  //
+  // IA-64 code is a sequence of 16-byte bundles, so the buffer's instruction
+  // unit is a whole bundle and every offset is bundle-aligned by construction.
+  //
+  // Instructions are handed to emit() one at a time and packed into bundles by
+  // Bundler-ia64.h. Two invariants make that safe for everything downstream:
+  //
+  //   * A bundle's *address* is fixed the moment it opens, before anything
+  //     knows what will share it, so the BufferOffset emit() returns is final
+  //     even though the bundle's contents are not. Callers that record a site
+  //     to patch later -- relocations, farJumpWithPatch, toggledJump -- must
+  //     take that returned offset rather than sampling currentOffset() before
+  //     the emit, which would name whichever bundle happens to be open.
+  //
+  //   * The open bundle is written into the buffer immediately and rewritten
+  //     in place as it fills, always with its end-of-bundle stop bit *set*.
+  //     The buffer is therefore always in a correct, merely conservative,
+  //     state -- size() and oom() need no flushing, and the only thing closing
+  //     a bundle can do is clear that stop bit. Reading the buffer is
+  //     consequently safe at any point; *writing* into the open bundle is not,
+  //     since the next emit() rebuilds it, which is why bundleAt() flushes.
+ protected:
+  struct BundleUnit {
+    ia64::Bundle b;
+  };
+  AssemblerBuffer<BundleUnit> m_buffer;
+
+  // The sink BundleStream writes through.
+  class BufferSink {
+   public:
+    explicit BufferSink(AssemblerBuffer<BundleUnit>* buf) : buf_(buf) {}
+    uint32_t offset() const { return buf_->nextOffset().getOffset(); }
+    bool failed() const { return buf_->oom(); }
+    void append(const ia64::Bundle& b) {
+      // Bundles must start on a 16-byte boundary: the low 4 bits of an
+      // instruction address are the slot number, so the hardware cannot fetch
+      // one from anywhere else. Anything that writes raw bytes into the buffer
+      // -- writeCodePointer() and the jump tables built from it -- has to leave
+      // it bundle-aligned again with alignToBundle().
+      MOZ_ASSERT(offset() % sizeof(ia64::Bundle) == 0);
+      uint32_t off = offset();
+      buf_->putBytes(sizeof(b), nullptr);
+      if (MOZ_LIKELY(!buf_->oom())) {
+        ia64::StoreBundle(buf_->data() + off, b);
+      }
+    }
+    void reserve() { buf_->putBytes(sizeof(ia64::Bundle), nullptr); }
+    void rewrite(uint32_t off, const ia64::Bundle& b) {
+      MOZ_ASSERT(off + sizeof(ia64::Bundle) <= buf_->size());
+      ia64::StoreBundle(buf_->data() + off, b);
+    }
+    // Notification that a bundle is final, carrying its slot assignment. Only
+    // the offline verifier (which reconstructs program order from a
+    // disassembly) uses it; here it costs nothing.
+    void closed(uint32_t, const ia64::OpenBundle&, uint32_t) {}
+
+   private:
+    AssemblerBuffer<BundleUnit>* buf_;
+  };
+
+  BufferSink sink_{&m_buffer};
+  ia64::BundleStream<BufferSink> bundler_{&sink_};
+
+  // The scheduling window in front of the bundler; JS_IA64_NO_SCHED set
+  // turns it off. With whole basic blocks as windows it is Octane +2.2%,
+  // Crypto +17% (wiki/scheduler.html).
+  static bool SchedulingEnabled() {
+    return ia64::Flags().sched;
+  }
+
+  // Off for the Baseline compiler (disableScheduling()). In a browser it
+  // compiles on the main thread, and there the scheduler and the bundler under
+  // it cost 15 times what the Baseline compiler's own code does: on a Reddit
+  // load the scheduler alone took 4.5% of the content process's main thread
+  // (wiki/browser.html).
+  bool scheduling_ = true;
+  bool scheduling() const { return scheduling_ && SchedulingEnabled(); }
+
+ public:
+  // From here on, emit in program order. Drains what is already queued.
+  void disableScheduling() {
+    drainSched();
+    scheduling_ = false;
+  }
+
+ protected:
+
+  // Straight-line instructions waiting to be reordered (Scheduler-ia64.h).
+  // Only OpSched instructions enter it, and it is drained into the bundler
+  // before anything else is emitted and before anything asks for an offset:
+  // flush(), softFlush() -- and with them bind(), currentOffset() and every
+  // raw write into the buffer -- branches and their probes, and unbundled
+  // regions. Nothing ever moves across one of those.
+  ia64::Scheduler sched_;
+
+  // ---- pending branches ---------------------------------------------------
+  //
+  // A conditional branch to a label that is not bound and has no branches in
+  // the buffer yet is queued in the window rather than draining it, so that
+  // a guard can be scheduled with what is around it (Scheduler-ia64.h). Its
+  // place, and so its link in the label's chain, is known only when the
+  // window drains.
+  //
+  // Such a label holds no offset meanwhile but an odd value, (id << 1) | 1
+  // -- never a bundle-aligned offset -- naming pendingHeads_[id], where its
+  // chain head is kept as the window drains. Labels are moved around by
+  // value (CacheIR keeps them in vectors), so nothing here holds a Label*.
+  // Everything that reads a label's chain calls materialize() first, which
+  // drains the window and puts the real head back into the label: bind(),
+  // retarget(), and the branch emitters when they do not queue.
+  js::Vector<int64_t, 0, SystemAllocPolicy> pendingHeads_;
+  // Per window position: 1 + the pendingHeads_ index of a queued branch, or
+  // 0 for any other instruction.
+  uint32_t pendingId_[ia64::Scheduler::Capacity] = {};
+  // Per window position: a movl of a GC pointer, whose data relocation is
+  // written when it drains (emitMovlGCPtr()).
+  bool gcMovl_[ia64::Scheduler::Capacity] = {};
+  // emitMovlGCPtr(): the recorder has its own copy of the next emit()'s op.
+  bool skipRecordIA64_ = false;
+
+  // Offsets of the movl bundles holding GC pointers (TraceDataRelocations()).
+  // Here rather than in MacroAssemblerIa64 so that a drained window can add
+  // to it.
+  CompactBufferWriter dataRelocations_;
+
+  static bool IsPending(const Label* label) {
+    return label->used() && (label->offset() & 1);
+  }
+  static uint32_t PendingId(const Label* label) {
+    return uint32_t(label->offset()) >> 1;
+  }
+
+  void materialize(Label* label) {
+    if (!IsPending(label)) {
+      return;
+    }
+    whyIfOther(WhyLabelRead);
+    drainSched();
+    int64_t head = pendingHeads_[PendingId(label)];
+    MOZ_ASSERT(head != kEndOfChain);
+    label->reset();
+    label->use(int32_t(head) * int32_t(sizeof(ia64::Bundle)));
+  }
+
+  // Queue a conditional br.cond to |label| if it can be; see above.
+  bool queueBranch(const ia64::BranchForm& form, uint32_t qp, Label* label,
+                   ia64::BranchHint hint) {
+    if (form.shortForm != &ia64::BrCondRel || qp == 0 || label->bound() ||
+        (label->used() && !IsPending(label)) || !scheduling() ||
+        bundler_.unbundled()) {
+      whyDrain_ = qp == 0 ? WhyJump : label->bound() ? WhyBackBranch : WhyOtherBranch;
+      return false;
+    }
+    uint32_t id;
+    if (label->used()) {
+      id = PendingId(label);
+    } else {
+      id = uint32_t(pendingHeads_.length());
+      if (id >= (uint32_t(1) << 29) || !pendingHeads_.append(kEndOfChain)) {
+        return false;
+      }
+      label->use(int32_t((id << 1) | 1));
+    }
+    if (sched_.full()) {
+      drainSched();
+    }
+    pendingId_[sched_.size()] = id + 1;
+    sched_.addBranch(ia64::BrCondRel(0, qp, hint));
+    loopRec_.recordExit(ia64::BrCondRel(0, qp, hint), true, id);
+    if (crossableNext_) {
+      crossableNext_ = false;
+      if (CrossableEnabled() && !PoolCanaries()) {
+        sched_.setCrossable(sched_.size() - 1, crossableUseGr_, crossableEffects_);
+      }
+    }
+    return true;
+  }
+
+  // ---- out-of-line pairs (Scheduler::setCrossable()) ---------------------------
+  //
+  // CodeGenerator announces the branch into an out-of-line path whose slow
+  // path rejoins right after it (nextBranchIsCrossableIA64()), then binds the
+  // rejoin label with bindRejoinIA64() instead of bind().  If the branch was
+  // queued as a pair and nothing came after it, the label is not bound now
+  // (bind() would drain the window) but when the window drains: at the bundle
+  // after the brl's, which a brl (L+X, slots 1-2) always ends.  Whatever the
+  // scheduler put after the brl then runs on both paths, as everything after
+  // the label did in program order.  Anything else binds as usual, the pair
+  // turned back into a plain barrier first.  The brl is last in its bundle
+  // and its group, and PairOut::branch() binds the label at the bundle after
+  // it.  Also while
+  // the pipeliner records a loop: the branch is recorded as an exit when
+  // emitted, and the rejoin label is not jumped to yet when it is bound.
+  // JS_IA64_NO_OOLPAIRS turns it off.
+  // JS_IA64_POOLCHECK writes canaries into the pool around the pre-barrier's
+  // C call (MacroAssemblerIa64::PoolCheckMode()), which a pair may hold
+  // values in: it turns pairs off.  JS_IA64_PAIRCHECK checks the pool with
+  // pairs on.
+  static bool PoolCanaries() {
+    return ia64::Flags().poolCheck != 0;
+  }
+  static bool CrossableEnabled() {
+    return ia64::Flags().crossable;
+  }
+  bool crossableNext_ = false;
+  uint64_t crossableUseGr_ = 0;
+  ia64::Scheduler::CrossableEffects crossableEffects_ = {};
+  // Per window position: the rejoin label bound after that pair's brl.
+  // Ion's out-of-line code keeps its labels in place, unlike CacheIR.
+  Label* crossRejoin_[ia64::Scheduler::Capacity] = {};
+
+ public:
+  // Code that runs inside an out-of-line pair's slow path -- the
+  // out-of-line code and the trampolines it calls -- must not write the
+  // rename pool, which the code around the pair may hold across it: no
+  // renaming in there.
+  uint32_t noRename_ = 0;
+  class AutoNoRenameIA64 {
+    Assembler& a_;
+   public:
+    explicit AutoNoRenameIA64(Assembler& a) : a_(a) {
+      a_.whyIfOther(WhyNoRename);
+      a_.drainSched();
+      a_.noRename_++;
+    }
+    ~AutoNoRenameIA64() {
+      a_.whyIfOther(WhyNoRename);
+      a_.drainSched();
+      a_.noRename_--;
+    }
+  };
+  void nextBranchIsCrossableIA64(uint64_t useGr,
+                            const ia64::Scheduler::CrossableEffects& effects) {
+    crossableNext_ = true;
+    crossableUseGr_ = useGr;
+    crossableEffects_ = effects;
+  }
+  void bindRejoinIA64(Label* label) {
+    crossableNext_ = false;
+    const size_t n = sched_.size();
+    if (n && sched_.isCrossable(n - 1) && !oom()) {
+      MOZ_ASSERT(!label->used() && !label->bound());
+      crossRejoin_[n - 1] = label;
+      if (MOZ_UNLIKELY(ia64::Scheduler::PairStatsOn())) {
+        ia64::Scheduler::PairStatCounts().deferred++;
+      }
+      return;
+    }
+    // Not queued as a pair: if its branch is still in the window but is not
+    // the last instruction, it cannot be one.
+    for (size_t k = 0; k < n; k++) {
+      if (sched_.isCrossable(k) && !crossRejoin_[k]) {
+        sched_.unsetCrossable(k);
+        if (MOZ_UNLIKELY(ia64::Scheduler::PairStatsOn())) {
+          ia64::Scheduler::PairStatCounts().fallback++;
+        }
+      }
+    }
+    bind(label);
+  }
+
+ protected:
+
+  // Post-increment folding in the window (Scheduler-ia64.h); never for wasm,
+  // whose trap sites are per access. JS_IA64_NO_POSTINC turns it off.
+  static bool PostIncEnabled() {
+    return ia64::Flags().postInc;
+  }
+
+  // A queued instruction handed to the bundler from a schedule window: a
+  // queued branch is linked in front of its label's chain. Its hint is the
+  // one of a conditional branch to an unbound label; the long form, since a
+  // queued branch's target is still unknown and a short branch could not
+  // reach a label bound >16 MiB later.
+  void emitDrained(const ia64::Op& op, size_t k) {
+    if (MOZ_UNLIKELY(op.flags & ia64::OpCheck)) {
+      addCheck(op, bundler_.emit(op));
+      return;
+    }
+    if (!pendingId_[k]) {
+      noteMovl(k, bundler_.emit(op));
+      return;
+    }
+    const ia64::Op br = queuedBranch(k, op);
+    linkQueuedBranch(k, bundler_.emit(br));
+  }
+  // The brl that replaces the branch queued at window position |k|: it
+  // points at its label's chain head, and becomes the head once placed.
+  ia64::Op queuedBranch(size_t k, const ia64::Op& op) const {
+    MOZ_ASSERT(pendingId_[k] != 0);
+    return ia64::BrlCondRel(pendingHeads_[pendingId_[k] - 1], op.qp(),
+                            ia64::BranchHint::Dpnt);
+  }
+  // That brl landed in the bundle at |off|: it is its label's chain head
+  // now, and a crossable branch's slow path rejoins at the next bundle (a
+  // brl fills slots 1-2 of an MLX and ends its group).
+  void linkQueuedBranch(size_t k, uint32_t off) {
+    MOZ_ASSERT(pendingId_[k] != 0);
+    pendingHeads_[pendingId_[k] - 1] = BundleIndex(BufferOffset(int32_t(off)));
+    pendingId_[k] = 0;
+    if (MOZ_UNLIKELY(crossRejoin_[k])) {
+      crossRejoin_[k]->bind(int32_t(off + sizeof(ia64::Bundle)));
+      crossRejoin_[k] = nullptr;
+    }
+  }
+  // The instruction added at window position |k| landed at |off|: a
+  // GC-pointer movl (slots 1-2 of an MLX) gets its data relocation.
+  void noteMovl(size_t k, uint32_t off) {
+    if (MOZ_UNLIKELY(gcMovl_[k])) {
+      gcMovl_[k] = false;
+      dataRelocations_.writeUnsigned(off);
+    }
+  }
+
+  // Scheduler::drain()'s output.
+  struct PairOut {
+    Assembler* a;
+    uint32_t offset() const { return a->sink_.offset(); }
+    void append(const ia64::Bundle& b) { a->sink_.append(b); }
+    // A queued branch, placed in the bundle at |off|: link it in front of its
+    // label's chain, as emitDrained() does.
+    ia64::Op branch(size_t k, const ia64::Op& op, uint32_t off) {
+      const ia64::Op br = a->queuedBranch(k, op);
+      a->linkQueuedBranch(k, off);
+      return br;
+    }
+    void bundle(const ia64::Op& op, size_t k) { a->emitDrained(op, k); }
+    // The movl added at window position k is in slots 1-2 of the MLX at
+    // |off|: a GC pointer's data relocation, as emitDrained() records it.
+    void check(const ia64::Op& op, uint32_t off) { a->addCheck(op, off); }
+    void movl(size_t k, uint32_t off) { a->noteMovl(k, off); }
+    void flushBundler() { a->bundler_.flush(); }
+    // The bundler's open bundle, handed over (BundleStream::takeOpen()),
+    // and the bundle written into its place later.
+    uint8_t takeOpen(ia64::Op* ops, uint32_t* off) {
+      return a->bundler_.takeOpen(ops, off);
+    }
+    void rewrite(uint32_t off, const ia64::Bundle& b) { a->sink_.rewrite(off, b); }
+    void noteGroup(const ia64::Op& op) { a->bundler_.noteGroup(op); }
+    bool groupConflicts(const ia64::Op& op) const {
+      return a->bundler_.groupConflicts(op);
+    }
+  };
+
+  // Addresses chained through another register's post-increment
+  // (Scheduler::chainInto()); only where post-increments are folded at all
+  // (not wasm).  JS_IA64_NO_SLOTCHAIN turns it off.
+  static bool SlotChainEnabled() {
+    return ia64::Flags().slotChain;
+  }
+
+  // Values that die inside the window renamed into the pool r40-r55
+  // (Scheduler::renameDead()); never for wasm, whose trap handler sees the
+  // registers of a faulting access.  JS_IA64_NO_RENAME turns it off.
+  static bool RenameEnabled() {
+    return ia64::Flags().rename;
+  }
+
+  // Memory disambiguation in the window (Scheduler::computeAddrs()); never
+  // for wasm. JS_IA64_NO_MEMDISAMBIG turns it off.
+  static bool MemDisambigEnabled() {
+    return ia64::Flags().memDisambig;
+  }
+
+  // Why a scheduling window ended, for the window statistics and log
+  // (WindowObserver-ia64.h).
+  enum WhyDrain : uint8_t {
+    WhyOther, WhyFull, WhyB, WhyLX, WhyM, WhyI, WhyAF, WhyBindBlock,
+    WhyBindInternal, WhyFlush, WhyJump, WhyBackBranch, WhyOtherBranch,
+    WhyOffset, WhyLabelRead, WhyNoRename, WhyUnbundled, WhyBundleAt,
+    WhyShortBranch, WhyPlainBranch, WhyCount
+  };
+  uint8_t whyDrain_ = WhyOther;
+  bool bindBlock_ = false;
+  int lirOp_ = -1;
+  void whyIfOther(WhyDrain why) {
+    if (whyDrain_ == WhyOther) {
+      whyDrain_ = why;
+    }
+  }
+  static_assert(WhyCount == ia64::kWhyCount, "WindowObserver's names");
+  // Whether the window about to drain is one of an Ion body's own (the ones
+  // both the statistics and the log describe).
+  bool countedWindow() const { return !isWasm_ && lirOp_ >= 0 && !sched_.empty(); }
+  void noteDrain() {
+    if (!ia64::WindowObserver::StatsOrNull() || !countedWindow()) {
+      return;
+    }
+    int kind;
+    switch (whyDrain_) {
+      case WhyBindInternal: kind = 0; break;
+      case WhyJump: kind = 1; break;
+      case WhyBackBranch: case WhyOtherBranch: case WhyShortBranch:
+      case WhyPlainBranch: kind = 2; break;
+      case WhyBindBlock: kind = -1; break;
+      default: kind = 3; break;
+    }
+    ia64::WindowObserver::Count(whyDrain_, lirOp_, sched_.size(), kind);
+  }
+
+ public:
+  // CodeGenerator: the LIR instruction being emitted (-1: none of an Ion
+  // body's own), and that the next bind is a block's label.
+  void setLirOpIA64(int op, const char* name) {
+    lirOp_ = op;
+    ia64::WindowObserver::NoteLirOp(op, name);
+  }
+
+  // The window log (JS_IA64_WINDOWLOG, WindowObserver-ia64.h).
+  static bool WindowLogEnabled() { return ia64::WindowObserver::LogEnabled(); }
+  // CodeGenerator::generateBody(): the block counters of this body.
+  uint64_t* allocBlockCountsIA64(uint32_t nblocks) {
+    blockCounts_ = static_cast<uint64_t*>(calloc(nblocks ? nblocks : 1, sizeof(uint64_t)));
+    nBlocks_ = blockCounts_ ? nblocks : 0;
+    return blockCounts_;
+  }
+  void setBlockIA64(uint32_t block) { block_ = block; }
+  // CodeGenerator::link(), with the final code: write this compilation's
+  // windows.  One write() per compilation (O_APPEND).  Link runs on the main
+  // thread only, so the id counter and the list need no lock.
+  void writeWindowLogIA64(const uint8_t* code, uint32_t size) {
+    ia64::WindowObserver::WriteLog(code, size, windowLog_, blockCounts_,
+                                   nBlocks_);
+  }
+  void nextBindIsBlockIA64() { bindBlock_ = true; }
+  // CodeGenerator: a block label nothing jumps to (isFallThroughOnlyIA64())
+  // is left unbound, so the window runs on.  Also while the pipeliner
+  // records a loop: it reads the block structure only from binds of labels
+  // something jumps to (checkLoopBind()); the fall-through label after a
+  // loop test ended 4.7e7 of NavierStokes's windows while recording.
+  bool skipFallThroughBindIA64() {
+    bindBlock_ = false;
+    return true;
+  }
+
+ protected:
+  using WindowRec = ia64::WindowRec;
+  ia64::WindowRecVector windowLog_;
+  uint64_t* blockCounts_ = nullptr;
+  uint32_t nBlocks_ = 0;
+  uint32_t block_ = 0;
+
+  void drainSched() {
+    if (MOZ_UNLIKELY(ia64::WindowObserver::StatsOrNull())) {
+      noteDrain();
+    }
+    if (MOZ_UNLIKELY(ia64::WindowObserver::LogEnabled()) && countedWindow()) {
+      WindowRec rec{uint32_t(m_buffer.nextOffset().getOffset()), 0, block_,
+                    ia64::WindowObserver::LogOp(lirOp_),
+                    whyDrain_};
+      drainSchedNow();
+      rec.end = uint32_t(m_buffer.nextOffset().getOffset());
+      (void)windowLog_.append(rec);
+      return;
+    }
+    drainSchedNow();
+  }
+  void drainSchedNow() {
+    whyDrain_ = WhyOther;
+    sched_.setDisambiguate(!isWasm_ && MemDisambigEnabled());
+    sched_.setRename(!isWasm_ && RenameEnabled() && !noRename_);
+    sched_.setChain(SlotChainEnabled());
+    // The window is written as dispersal-checked instruction groups, one per
+    // schedule cycle (bundle-template-aware scheduling, wiki/pair-scheduler.html).
+    if (!sched_.empty()) {
+      PairOut out{this};
+      sched_.drain(out, !isWasm_ && PostIncEnabled(), true,
+                   !isWasm_ && SpecLoadsEnabled());
+    }
+  }
+
+  // ---- control speculation (Scheduler-ia64.h) ------------------------------
+  //
+  // Loads moved above guards as ld.s, each with a chk.s where it was
+  // (wiki/object-shape-speculation.html); JS_IA64_NO_SPECLD turns it off.  Only
+  // Ion's guards (setGuardLive()) can be crossed, so Baseline, the stubs and
+  // wasm never get one.
+  static bool SpecLoadsEnabled() {
+    return ia64::Flags().specLoads;
+  }
+  // A chk.s in the buffer, waiting for its recovery code: the bundle it is
+  // in, its register, and the instructions to redo (plain forms, program
+  // order) with their units: the checked one, or a chain check's whole group
+  // (Scheduler::chainRedo()).
+  struct PendingCheck {
+    uint32_t at;
+    uint32_t reg;
+    uint8_t n;
+    ia64::Insn redo[6];
+    ia64::Unit unit[6];
+  };
+  js::Vector<PendingCheck, 0, SystemAllocPolicy> checks_;
+  void addCheck(const ia64::Op& op, uint32_t off) {
+    PendingCheck c;
+    c.at = off;
+    c.reg = ia64::ResNum(op.use[0]);
+    c.n = uint8_t(sched_.chainRedo(op, c.redo, c.unit));
+    if (c.n == 0) {
+      c.n = 1;
+      c.redo[0] = ia64::CheckedBits(op);
+      c.unit[0] = ia64::CheckedUnit(op);
+    }
+    if (!checks_.append(c)) {
+      m_buffer.fail_oom();
+    }
+  }
+
+ public:
+  // The recovery code of every chk.s, after all other code (finish()).  A
+  // failing chk.s branches as a taken branch does (SDM 3:35): what precedes
+  // it in its bundle has run, the slots after it and the rest of its
+  // instruction group have not.  A branch can only land on a bundle, so the
+  // recovery code is
+  //
+  //   the checked instruction redone, non-speculatively ;;
+  //     (a chain check: each instruction of its group, in program order,
+  //     a bundle each ;;)
+  //   a copy of the check's bundle, the check and the slots before it nops
+  //     (a check in the copy points at its own recovery code) ;;
+  //   br to the bundle after the check's
+  //
+  // with the copy left out when nothing follows the check in its bundle,
+  // the branch then sharing the first bundle.  The rest of the group goes
+  // on in the next bundle as a group of its own: nothing in a group reads
+  // what the group writes (RAW), so splitting it changes nothing.  The
+  // bundler keeps what may not be replayed out of the slots after a check,
+  // and readers of its register and stores in program order after it out of
+  // the slots before it (OpenBundle::tryAdd(), MustFollow()); the scheduler
+  // keeps writers of the redone instruction's operands after the check.
+  void emitRecoveryCode() {
+    flush();
+    const size_t n = checks_.length();
+    struct CopiedCheck {
+      uint32_t at;   // the copy
+      int slot;
+      size_t check;  // index in checks_
+    };
+    js::Vector<uint32_t, 0, SystemAllocPolicy> start;
+    js::Vector<CopiedCheck, 0, SystemAllocPolicy> copied;
+    if (!start.resize(n)) {
+      m_buffer.fail_oom();
+      checks_.clear();
+      return;
+    }
+    const int64_t kB = int64_t(sizeof(ia64::Bundle));
+    auto nopFor = [](uint32_t tmpl, int k) {
+      return ((ia64::kBSlots[tmpl] >> k) & 1) ? ia64::NopBBits(0)
+                                               : ia64::NopBits(0);
+    };
+    for (size_t i = 0; i < n && !oom(); i++) {
+      const PendingCheck& c = checks_[i];
+      const ia64::Bundle orig = *bundleAt(BufferOffset(int32_t(c.at)));
+      const int slot = ia64::FindCheckSlot(&orig, c.reg);
+      MOZ_RELEASE_ASSERT(slot >= 0);
+      const uint32_t tmpl = uint32_t((orig.lo >> 1) & 0xf);
+      ia64::Insn s[3];
+      ia64::BundleSlots(&orig, s);
+      bool replay = false;
+      for (int k = slot + 1; k < 3; k++) {
+        replay |= s[k] != nopFor(tmpl, k);
+      }
+
+      const uint32_t r1 = uint32_t(m_buffer.nextOffset().getOffset());
+      start[i] = r1;
+      if ((int64_t(r1) - int64_t(c.at)) / kB + 3 + c.n >= (int64_t(1) << 20)) {
+        // Beyond chk.s's reach (16 MiB): fail the compilation.
+        m_buffer.fail_oom();
+        break;
+      }
+      const int64_t back = int64_t(c.at) + kB;
+      auto brBack = [&]() {
+        const int64_t here = int64_t(m_buffer.nextOffset().getOffset());
+        return ia64::BrCondRel(int32_t((back - here) / kB)).bits;
+      };
+      // All but the last of a group's instructions, a group each.
+      for (uint8_t k = 0; k + 1 < c.n; k++) {
+        const bool iu = c.unit[k] == ia64::UnitI;
+        emitBundle(ia64::MakeBundle(
+            ia64::Template(ia64::tMII_), iu ? ia64::NopM().bits : c.redo[k],
+            iu ? c.redo[k] : ia64::NopI().bits, ia64::NopI().bits));
+      }
+      const bool iUnit = c.unit[c.n - 1] == ia64::UnitI;
+      const ia64::Insn redoM = iUnit ? ia64::NopM().bits : c.redo[c.n - 1];
+      const ia64::Insn redoI = iUnit ? c.redo[c.n - 1] : ia64::NopI().bits;
+      if (!replay) {
+        emitBundle(ia64::MakeBundle(ia64::tMIB_, redoM, redoI, brBack()));
+      } else {
+        emitBundle(ia64::MakeBundle(ia64::tMIB_, redoM, redoI,
+                                    ia64::NopBBits(0)));
+        const uint32_t copyAt = uint32_t(m_buffer.nextOffset().getOffset());
+        for (int k = 0; k < 3; k++) {
+          uint32_t r;
+          if (k <= slot) {
+            s[k] = nopFor(tmpl, k);
+          } else if (ia64::IsCheckSlot(&orig, k, &r)) {
+            size_t j = 0;
+            while (j < n && !(checks_[j].at == c.at && checks_[j].reg == r)) {
+              j++;
+            }
+            MOZ_RELEASE_ASSERT(j < n);
+            if (!copied.append(CopiedCheck{copyAt, k, j})) {
+              m_buffer.fail_oom();
+            }
+          }
+        }
+        emitBundle(ia64::MakeBundle(ia64::Template((orig.lo & 0x1f) | 1),
+                                    s[0], s[1], s[2]));
+        emitBundle(ia64::MakeBundle(ia64::tMIB_, ia64::NopM().bits,
+                                    ia64::NopI().bits, brBack()));
+      }
+      if (oom()) {
+        break;
+      }
+      ia64::PatchCheckDisp(bundleAt(BufferOffset(int32_t(c.at))), slot,
+                           (int64_t(r1) - int64_t(c.at)) / kB);
+    }
+    if (!oom()) {
+      for (const CopiedCheck& cc : copied) {
+        ia64::PatchCheckDisp(bundleAt(BufferOffset(int32_t(cc.at))), cc.slot,
+                             (int64_t(start[cc.check]) - int64_t(cc.at)) / kB);
+      }
+    }
+    checks_.clear();
+  }
+
+ protected:
+
+
+ public:
+  // The registers the bailout behind |label| reads, its snapshot's: makes the
+  // branches to it still in the window guards that instructions may cross.
+  void setGuardLive(Label* label, uint64_t gr, uint64_t fr,
+                    bool noLoads = false, bool natSafeOnly = false) {
+    if (!IsPending(label)) {
+      return;
+    }
+    // sp, the frame pointer, gp, tp and the pinned ObjectTagReg and
+    // ContextPinReg.
+    const uint64_t always = ia64::kGrGuardAlways;
+    uint32_t id = PendingId(label);
+    for (size_t k = 0; k < sched_.size(); k++) {
+      if (pendingId_[k] == id + 1) {
+        sched_.setLive(k, gr | always, fr, noLoads, natSafeOnly);
+      }
+    }
+  }
+
+ public:
+  // Append a fully formed bundle. Used for the raw data a jump table is made of
+  // and for the fixed-layout patch sequences; it always starts a fresh bundle.
+  BufferOffset emitBundle(ia64::Bundle b) {
+    flush();
+    BufferOffset off = m_buffer.nextOffset();
+    // Anything that writes raw bytes into the buffer (writeCodePointer(), and
+    // the jump tables built out of it) has to leave it bundle-aligned again.
+    MOZ_ASSERT(off.getOffset() % sizeof(ia64::Bundle) == 0);
+    sink_.append(b);
+    return off;
+  }
+
+  // Emit one instruction, returning the offset of the bundle it landed in.
+  //
+  // An OpSched instruction is only queued, so where it lands is not known yet
+  // and the offset returned for it is just the current end of the buffer.
+  // Nothing that patches or records a site uses one: movl patch sites come from
+  // emitMovl(), and the FaultingCodeRanges of loads and stores are wasm's.
+  BufferOffset emit(const ia64::Op& op) {
+    if (trackCanon32(op)) {
+      return m_buffer.nextOffset();
+    }
+    if (MOZ_UNLIKELY(loopRec_.active()) && !skipRecordIA64_) {
+      loopRec_.record(op);
+    }
+    if ((op.flags & ia64::OpSched) && scheduling() &&
+        !bundler_.unbundled()) {
+      if (sched_.full()) {
+        whyDrain_ = WhyFull;
+        drainSched();
+      }
+      sched_.add(op);
+      return m_buffer.nextOffset();
+    }
+    if (whyDrain_ == WhyOther) {
+      whyDrain_ = op.unit == ia64::UnitLX ? WhyLX
+                  : op.unit == ia64::UnitB ? WhyB
+                  : op.unit == ia64::UnitM ? WhyM
+                  : op.unit == ia64::UnitI ? WhyI
+                                           : WhyAF;
+    }
+    drainSched();
+    return BufferOffset(int32_t(bundler_.emit(op)));
+  }
+
+  // Close the open bundle and end its instruction group. For raw bytes going
+  // into the buffer and for fixed-layout patch regions -- anything the bundler
+  // cannot model, and so cannot make a dependency claim about.
+  void flush() {
+    canon32_ = 0;
+    loopRec_.abort("raw bytes or a patch region");
+    if (whyDrain_ == WhyOther) {
+      whyDrain_ = WhyFlush;
+    }
+    drainSched();
+    bundler_.flush();
+  }
+
+  // Close the open bundle but let the instruction group run on into the next
+  // one. For callers that only need a stable byte offset: a label bind, or a
+  // query for the current offset. See BundleStream::softFlush().
+  void softFlush() {
+    canon32_ = 0;
+    drainSched();
+    bundler_.softFlush();
+  }
+
+  // Set while compiling wasm code (see WasmMacroAssembler). Wasm trap sites are
+  // per bundle -- the signal handler masks sc_ip to the bundle address and the
+  // resume point is the next bundle -- so a faulting access must be the only
+  // instruction in its bundle, which also makes emit()'s returned offset the
+  // bundle the access really landed in. JS code keeps scheduling such accesses
+  // normally; its faults are not wasm traps.
+  void setWasmCodegen(bool wasm = true) { isWasm_ = wasm; }
+  bool wasmCodegen() const { return isWasm_; }
+
+  // ---- canonical int32 values ---------------------------------------------
+  //
+  // Bit n of canon32_: rn holds an int32 sign-extended to 64 bits, by what
+  // was emitted since the last point anything could have entered from
+  // elsewhere.  Every softFlush() and flush() forgets it all -- so does every
+  // label bind, offset request (return addresses, OSI points), raw bundle --
+  // as do calls, alloc and unbundled (patchable) regions.  An sxt4 r = r of
+  // a register known canonical is then dropped: the int32 rule (canonical in
+  // registers) has the arithmetic, the loads and the moves extend again what
+  // often already is.
+  uint64_t canon32_ = 0;
+
+  // See setWasmCodegen().
+  bool isWasm_ = false;
+
+  // ---- software pipelining (LoopRecorder-ia64.h) --------------------------
+  LoopRecorder loopRec_{*this};
+  friend class LoopRecorder;
+
+  // CodeGenerator, in front of every loop header (LoopRecorder::begin()).
+  void beginLoop() { loopRec_.begin(); }
+
+ public:
+  // Returns true when |op| is an sxt4 to drop.
+  bool trackCanon32(const ia64::Op& op) {
+    uint32_t src;
+    ia64::Canon32 c = ia64::ClassifyCanon32(op, &src);
+    uint32_t qp = op.qp();
+    bool srcCanon = src < 64 && ((canon32_ >> src) & 1);
+    if (c == ia64::Canon32::Sxt4 && qp == 0 && srcCanon &&
+        uint32_t((op.bits >> 6) & 0x7f) == src) {
+      return true;
+    }
+    if ((op.flags & ia64::OpAlloc) || ((op.flags & ia64::OpBranch) && op.nDef)) {
+      canon32_ = 0;
+      return false;
+    }
+    bool canon = c == ia64::Canon32::Yes || c == ia64::Canon32::Sxt4 ||
+                 (c == ia64::Canon32::Inherit && srcCanon);
+    for (uint32_t i = 0; i < op.nDef; i++) {
+      if (ia64::ResClassOf(op.def[i]) != ia64::ResGr || ia64::ResNum(op.def[i]) >= 64) {
+        continue;
+      }
+      uint64_t bit = uint64_t(1) << ia64::ResNum(op.def[i]);
+      // a predicated write leaves either value: canonical only if both are
+      bool now = canon && (qp == 0 || (canon32_ & bit));
+      canon32_ = now ? (canon32_ | bit) : (canon32_ & ~bit);
+    }
+    return false;
+  }
+
+  // Convenience wrappers. The unit an instruction issues to comes from the
+  // instruction itself, so these are all the same function; they survive only
+  // so that several hundred call sites did not have to be rewritten, and so
+  // that the intended unit still reads at the call site.
+  BufferOffset emitM(const ia64::Op& i) { return emit(i); }
+  BufferOffset emitI(const ia64::Op& i) { return emit(i); }
+  BufferOffset emitB(const ia64::Op& i) { return emit(i); }
+  BufferOffset emitF(const ia64::Op& i) { return emit(i); }
+  BufferOffset emitMovl(uint32_t r1, uint64_t imm, uint32_t qp = 0) {
+    return emit(ia64::Movl(r1, imm, qp));
+  }
+
+  // movl r1 = a GC pointer, with its data relocation.  A patch site, but one
+  // only the relocation table names: queued in the scheduling window like
+  // any constant, the relocation written at the bundle it drains into
+  // (emitDrained(); a bundle's address is fixed when it opens, and a movl
+  // fills slots 1-2 of an MLX).  While the pipeliner records a loop the
+  // recorder is handed an unmovable copy, so the recording ends or drops it
+  // as before (a kernel copy would need a relocation of its own: kernels
+  // that hold GC pointers lost Octane 0.3%, results/patches/
+  // pipe-gcptr-kernels.diff), and the plain copy schedules it: in place it
+  // ended a window there, 27% of Box2D's executed window ends with the
+  // pipeliner on (wiki/pipeliner.html).  In place, as before, where
+  // unbundled.
+  void emitMovlGCPtr(uint32_t r1, uint64_t imm) {
+    const ia64::Op op = ia64::Movl(r1, imm).fl(ia64::OpSched);
+    if (scheduling() && !bundler_.unbundled()) {
+      if (MOZ_UNLIKELY(loopRec_.active())) {
+        loopRec_.record(ia64::Movl(r1, imm));  // not OpSched: cannot move
+        skipRecordIA64_ = true;
+        emit(op);
+        skipRecordIA64_ = false;
+      } else {
+        emit(op);
+      }
+      MOZ_ASSERT(!sched_.empty());
+      gcMovl_[sched_.size() - 1] = true;
+      return;
+    }
+    BufferOffset at = emitMovl(r1, imm);
+    dataRelocations_.writeUnsigned(at.getOffset());
+  }
+
+  // A constant into r1 in the cheapest encoding: adds (imm14) or addl
+  // (imm22), one A slot; dep.z for a sign-extended imm8 field at any
+  // position, one I slot (every NaN-box tag and the tag mask); movl, two
+  // slots of an MLX bundle, only for the rest.  Not for patch sites,
+  // relocations or anything ReadMovlImm() reads back: those need emitMovl().
+  BufferOffset emitLoadImm(uint32_t r1, uint64_t imm, uint32_t qp = 0) {
+    int64_t s = int64_t(imm);
+    if (s >= -8192 && s <= 8191) {
+      return emit(ia64::Adds(r1, s, 0, qp));
+    }
+    if (imm == JSVAL_SHIFTED_TAG_OBJECT) {
+      return emit(ia64::Adds(r1, 0, ObjectTagReg.encoding(), qp));
+    }
+    if (ia64::FitsImm22(s)) {
+      return emit(ia64::Addl(r1, s, 0, qp));
+    }
+    int64_t imm8;
+    uint32_t pos, len;
+    if (ia64::DepZImmFor(imm, &imm8, &pos, &len)) {
+      return emit(ia64::DepZImm(r1, imm8, pos, len, qp));
+    }
+    // Not a patch site, so unlike emitMovl()'s it may be scheduled.
+    return emit(ia64::Movl(r1, imm, qp).fl(ia64::OpSched));
+  }
+
+  // Opt a region out of bundling: one instruction per bundle, each its own
+  // instruction group, exactly as the backend emitted everything before. The
+  // fixed-layout sequences need this because their patchers address individual
+  // bundles by index or assume a particular slot --
+  // toggledCall()/ToggledCallSize(), PatchWrite_NearCall()/
+  // PatchWrite_NearCallSize(), nopPatchableToCall()/patchNopToCall(), and the
+  // patchable "adds" that WriteAddsImm14() rewrites in slot 0.
+  class MOZ_RAII AutoUnbundled {
+   public:
+    explicit AutoUnbundled(Assembler* a) : a_(a) {
+      a_->loopRec_.abort("an unbundled region");
+      a_->whyIfOther(WhyUnbundled);
+      a_->drainSched();
+      a_->canon32_ = 0;
+      a_->bundler_.enterUnbundled();
+    }
+    ~AutoUnbundled() {
+      // the region may be patched into a call later
+      a_->canon32_ = 0;
+      a_->bundler_.leaveUnbundled();
+    }
+
+   private:
+    Assembler* a_;
+  };
+
+ public:
+  size_t size() const { return m_buffer.size(); }
+  // The number of bytes of the buffer that getByteAtOffset() may read.
+  size_t readableSize() const { return m_buffer.size(); }
+  bool oom() const { return m_buffer.oom(); }
+
+  // Bundle index of an offset, which is what IP-relative displacements count.
+  static int32_t BundleIndex(BufferOffset off) {
+    MOZ_ASSERT(off.getOffset() % sizeof(ia64::Bundle) == 0);
+    return int32_t(off.getOffset() / sizeof(ia64::Bundle));
+  }
+
+  // ---- label binding -----------------------------------------------------
+  //
+  // Forward branches are emitted with their displacement field holding the
+  // offset of the previous branch that targets the same label, forming a chain
+  // whose head is Label::offset(). bind() walks that chain and rewrites each
+  // displacement to point at the bind site. This is the standard SpiderMonkey
+  // scheme; on ia64 the "displacement field" is the branch immediate that
+  // PatchBranchDisp() rewrites, and every offset is bundle-aligned so the
+  // chain link is stored as a bundle index.
+  //
+  // An ordinary pending branch is always the brl (long) form, whose 60-bit
+  // immediate holds any bundle index this buffer can produce. A short 21-bit
+  // forward branch cannot be widened once emitted, and a function's code can
+  // exceed its +/-16 MiB range (the YouTube main script does), so bind() must
+  // not have to fail the compilation. Only toggledJump()'s branch, which is
+  // known to be short, stays a short pending branch; PatchBranchDisp() reads
+  // the form from the bundle.
+
+ public:
+  // Writable pointer to an already-emitted bundle. The patchable-immediate
+  // sequences (movl, adds) rewrite their immediate through this.
+  //
+  // The open bundle is rewritten from the bundler's own copy of its
+  // instructions every time it grows or closes, so a patch written straight
+  // into it would be silently undone; that bundle has to be closed first.
+  //
+  // Only *that* bundle, though. Almost every caller is patching a bundle that
+  // is long closed -- bind()'s chain walk comes through here for every pending
+  // branch site -- and closing there would end the instruction group at every
+  // label, which is exactly what bind()'s softFlush() is trying to avoid.
+  ia64::Bundle* bundleAt(BufferOffset off) {
+    MOZ_ASSERT(off.getOffset() % sizeof(ia64::Bundle) == 0);
+    whyIfOther(WhyBundleAt);
+    drainSched();
+    if (MOZ_UNLIKELY(bundler_.isOpenAt(uint32_t(off.getOffset())))) {
+      flush();
+    }
+    return reinterpret_cast<ia64::Bundle*>(m_buffer.data() + off.getOffset());
+  }
+
+ private:
+
+  // Read back the raw branch immediate, which for an unbound branch is the
+  // chain link rather than a real displacement.
+  int64_t readChainLink(BufferOffset off) {
+    return ia64::ReadBranchDisp(bundleAt(off));
+  }
+
+  // Offset of a chain link, which is a bundle index and so always fits an int.
+  static BufferOffset chainSite(int64_t link) {
+    return BufferOffset(int32_t(link) * int32_t(sizeof(ia64::Bundle)));
+  }
+
+ public:
+  // Emit a branch to |label|, returning its offset.
+  //
+  // The cheap 21-bit B-unit form whenever it can work: one slot instead of the
+  // L+X pair, a template that can still hold two more instructions of any
+  // unit, and no forced stop after it (a brl must be followed by one, so every
+  // brl guard ended an instruction group). See ia64::BranchForm. A backward
+  // branch takes it when the target is within +/-16 MiB; a forward one has no
+  // displacement yet and stays brl (see the label-binding note).
+  BufferOffset emitBranchToLabel(const ia64::BranchForm& form, uint32_t qp,
+                                 Label* label) {
+    ia64::BranchHint hint = BranchHintFor(qp, label);
+    if (MOZ_UNLIKELY(LoopRecorder::PipeLoopCount()) &&
+        loopRec_.countsIterationAt(qp, form.shortForm == &ia64::BrCondRel, label)) {
+      // the iteration counter, outside the recording (r2/r3: assembler
+      // temporaries, never live across a branch)
+      const bool rec = loopRec_.suspend();
+      drainSched();
+      emit(ia64::Movl(2, loopRec_.iterationCounterAddress()));
+      emit(ia64::Ld8(3, 2));
+      emit(ia64::Adds(3, 1, 3));
+      emit(ia64::St8(2, 3));
+      drainSched();
+      loopRec_.resume(rec);
+    }
+    if (queueBranch(form, qp, label, hint)) {
+      return m_buffer.nextOffset();
+    }
+    // The probe below has to see every instruction before the branch.
+    whyIfOther(WhyPlainBranch);
+    materialize(label);
+    drainSched();
+    if (label->bound()) {
+      // The displacement is measured from the bundle the branch lands in, and
+      // that is not m_buffer.nextOffset(): the branch may join the bundle that
+      // is already open, one bundle below the end of the buffer.
+      //
+      // The probe has to use the form that will actually be emitted. A brl is
+      // an L+X pair and a br.cond is a single B-unit slot, so the two do not
+      // land in the same place -- and the choice depends on a displacement
+      // measured from that very place. Probe with the short form first; if it
+      // is out of range, the long form's own probe decides.
+      BufferOffset here(
+          int32_t(bundler_.probeOffset(form.shortForm(0, qp, hint))));
+      int64_t disp = int64_t(BundleIndex(BufferOffset(label->offset()))) -
+                     BundleIndex(here);
+      if (MOZ_LIKELY(disp == int64_t(int32_t(disp)) &&
+                     ia64::BranchDispInRange(int32_t(disp)))) {
+        // the recorded loop's back edge ends the recording
+        bool backEdge = loopRec_.isBackEdge(
+            qp, form.shortForm == &ia64::BrCondRel, label);
+        if (backEdge) {
+          loopRec_.stop();
+        }
+        BufferOffset off = emit(form.shortForm(int32_t(disp), qp, hint));
+        MOZ_RELEASE_ASSERT(off == here);
+        if (backEdge) {
+          loopRec_.end(off);
+        }
+        return off;
+      }
+      here = BufferOffset(
+          int32_t(bundler_.probeOffset(form.longForm(0, qp, hint))));
+      disp = int64_t(BundleIndex(BufferOffset(label->offset()))) -
+             BundleIndex(here);
+      MOZ_ASSERT(ia64::LongBranchDispInRange(disp));
+      BufferOffset off = emit(form.longForm(disp, qp, hint));
+      // probeOffset() and emit() cannot disagree -- a branch's unit, flags and
+      // operands do not depend on its displacement, so both take the same path
+      // through the bundler -- but a disagreement would put the branch one
+      // bundle away from where its displacement was measured, i.e. a wild jump
+      // out of JIT code. Cheap enough to check for real.
+      MOZ_RELEASE_ASSERT(off == here);
+      return off;
+    }
+    // Unbound: link into the chain, storing the previous head as the raw field.
+    int64_t prev = label->used() ? BundleIndex(BufferOffset(label->offset()))
+                                 : kEndOfChain;
+    const LoopRecorder::ForwardBranch fwd =
+        loopRec_.beginForward(qp, form.shortForm == &ia64::BrCondRel);
+    // Always the long form: the eventual displacement is unknown, and only
+    // the 60-bit field is guaranteed to hold both it and the chain link.
+    BufferOffset off = emit(form.longForm(prev, qp, hint));
+    loopRec_.endForward(fwd, off);
+    label->use(off.getOffset());
+    return off;
+  }
+
+  // toggledJump()'s branch has to stay a B-unit br.cond in an MIB bundle:
+  // ToggleToJmp()/ToggleToCmp() switch it on and off by flipping just the 4-bit
+  // major opcode, and the X unit has no nop that would preserve a brl's
+  // displacement bits across the round trip. As on every other backend,
+  // toggledJump() is only ever used for short forward jumps whose label carries
+  // no other branch, so the link it stores is always kEndOfChain;
+  // PatchShortBranchDisp() asserts that rather than trusting it.
+  BufferOffset emitShortBranchToLabel(uint32_t qp, Label* label) {
+    whyIfOther(WhyShortBranch);
+    materialize(label);
+    drainSched();
+    ia64::BranchHint hint = BranchHintFor(qp, label);
+    if (label->bound()) {
+      BufferOffset here(
+          int32_t(bundler_.probeOffset(ia64::BrCondRel(0, qp, hint))));
+      int32_t disp = BundleIndex(BufferOffset(label->offset())) -
+                     BundleIndex(here);
+      MOZ_RELEASE_ASSERT(ia64::BranchDispInRange(disp));
+      BufferOffset off = emit(ia64::BrCondRel(disp, qp, hint));
+      // probeOffset() and emit() cannot disagree -- a branch's unit, flags and
+      // operands do not depend on its displacement, so both take the same path
+      // through the bundler -- but a disagreement would put the branch one
+      // bundle away from where its displacement was measured, i.e. a wild jump
+      // out of JIT code. Cheap enough to check for real.
+      MOZ_RELEASE_ASSERT(off == here);
+      return off;
+    }
+    int32_t prev = label->used() ? BundleIndex(BufferOffset(label->offset()))
+                                 : kEndOfChain;
+    MOZ_RELEASE_ASSERT(ia64::BranchDispInRange(prev));
+    BufferOffset off = emit(ia64::BrCondRel(prev, qp, hint));
+    label->use(off.getOffset());
+    return off;
+  }
+
+  void bind(Label* label) {
+    // Once the buffer has failed, emit() still hands out advancing offsets but
+    // appends nothing, so a chain recorded after that point walks -- and
+    // PatchBranchDisp() writes -- past the end of the buffer.
+    if (oom()) {
+      return;
+    }
+    loopRec_.checkBind(label);
+    whyDrain_ = bindBlock_ ? WhyBindBlock : WhyBindInternal;
+    bindBlock_ = false;
+    materialize(label);
+    // A branch target has to be bundle-aligned, so the open bundle is closed.
+    // Its stop bit is *not* set: anything arriving via the branch starts a
+    // fresh group anyway, because a taken branch ends the group
+    // architecturally, so the only path that sees the boundary is the
+    // fall-through -- and for that path the group should simply run on.
+    softFlush();
+    BufferOffset here = m_buffer.nextOffset();
+    if (label->used()) {
+      BufferOffset site(label->offset());
+      for (;;) {
+        int64_t link = readChainLink(site);
+        int64_t disp = int64_t(BundleIndex(here)) - BundleIndex(site);
+        if (!patchChainSite(site, disp)) {
+          return;
+        }
+        if (link == kEndOfChain) {
+          break;
+        }
+        site = chainSite(link);
+      }
+    }
+    label->bind(here.getOffset());
+    loopRec_.boundAt(here);
+  }
+
+
+  // Fold |label|'s pending branch chain into |target|: either patch every site
+  // to a bound target, or splice the chain onto target's own pending chain.
+  void retarget(Label* label, Label* target) {
+    if (oom() || !label->used()) {
+      return;
+    }
+    // Branches still queued: |target| takes over their chain as it stands.
+    if (IsPending(label) && !target->bound() && !target->used()) {
+      target->use(label->offset());
+      label->reset();
+      return;
+    }
+    materialize(label);
+    materialize(target);
+    softFlush();
+
+    BufferOffset site(label->offset());
+    if (target->bound()) {
+      BufferOffset dest(target->offset());
+      for (;;) {
+        int64_t link = readChainLink(site);
+        int64_t disp = int64_t(BundleIndex(dest)) - BundleIndex(site);
+        if (!patchChainSite(site, disp)) {
+          return;
+        }
+        if (link == kEndOfChain) {
+          break;
+        }
+        site = chainSite(link);
+      }
+      label->reset();
+      return;
+    }
+
+    for (;;) {
+      int64_t link = readChainLink(site);
+      if (link == kEndOfChain) {
+        break;
+      }
+      site = chainSite(link);
+    }
+    int64_t head = target->used()
+                       ? BundleIndex(BufferOffset(target->offset()))
+                       : kEndOfChain;
+    if (!patchChainSite(site, head)) {
+      return;
+    }
+    target->use(label->offset());
+    label->reset();
+  }
+
+  static constexpr int32_t kEndOfChain = -1;
+
+  // Resolve one pending branch. The only short branches that still enter a
+  // chain are toggledJump()'s, which the caller guarantees are short; keep the
+  // check so a violation fails the compilation instead of writing a truncated
+  // displacement (which once hung bind() past 16 MiB).
+  [[nodiscard]] bool patchChainSite(BufferOffset site, int64_t disp) {
+    ia64::Bundle* b = bundleAt(site);
+    if (!ia64::IsLongBranchBundle(b) &&
+        (disp < ia64::MinBranchBundleDisp || disp > ia64::MaxBranchBundleDisp)) {
+      m_buffer.fail_oom();
+      return false;
+    }
+    ia64::PatchBranchDisp(b, disp);
+    return true;
+  }
+
+  // The hint a branch gets:
+  //
+  //   unconditional (qp 0)       .sptk  always taken; anything else would
+  //                                     mispredict it whenever cold
+  //   conditional, backward      .dptk  loop back-edges and retry loops
+  //   conditional, forward       .dpnt  guards, bailouts, slow paths, and
+  //                                     if/else whose direction is a guess
+  //
+  // Backward-taken/forward-not-taken, and always dynamic: on Montecito a
+  // static hint is followed ~98% of the time when the predictor has no state
+  // for the branch, a dynamic one ~50%, and only dynamic branches use the
+  // history predictor once warm. Static hints were measured on Octane and
+  // lost: static BTFN +0.7%, this +2.5%, and even .spnt on Ion's out-of-line
+  // paths (which only run when a guard fails) was no better than .dpnt --
+  // see wiki/hw-branches.html.
+  static ia64::BranchHint BranchHintFor(uint32_t qp, const Label* label) {
+    if (qp == 0) {
+      return ia64::BranchHint::Sptk;
+    }
+    return label->bound() ? ia64::BranchHint::Dptk : ia64::BranchHint::Dpnt;
+  }
+
+  static Condition InvertCondition(Condition cond) {
+    switch (cond) {
+      case Equal:
+        return NotEqual;
+      case NotEqual:
+        return Equal;
+      case Above:
+        return BelowOrEqual;
+      case AboveOrEqual:
+        return Below;
+      case Below:
+        return AboveOrEqual;
+      case BelowOrEqual:
+        return Above;
+      case GreaterThan:
+        return LessThanOrEqual;
+      case GreaterThanOrEqual:
+        return LessThan;
+      case LessThan:
+        return GreaterThanOrEqual;
+      case LessThanOrEqual:
+        return GreaterThan;
+      case Signed:
+        return NotSigned;
+      case NotSigned:
+        return Signed;
+      case Zero:
+        return NonZero;
+      case NonZero:
+        return Zero;
+      default:
+        MOZ_CRASH("unsupported condition to invert");
+    }
+  }
+
+  static DoubleCondition InvertCondition(DoubleCondition cond) {
+    switch (cond) {
+      case DoubleOrdered:
+        return DoubleUnordered;
+      case DoubleEqual:
+        return DoubleNotEqualOrUnordered;
+      case DoubleNotEqual:
+        return DoubleEqualOrUnordered;
+      case DoubleGreaterThan:
+        return DoubleLessThanOrEqualOrUnordered;
+      case DoubleGreaterThanOrEqual:
+        return DoubleLessThanOrUnordered;
+      case DoubleLessThan:
+        return DoubleGreaterThanOrEqualOrUnordered;
+      case DoubleLessThanOrEqual:
+        return DoubleGreaterThanOrUnordered;
+      case DoubleUnordered:
+        return DoubleOrdered;
+      case DoubleEqualOrUnordered:
+        return DoubleNotEqual;
+      case DoubleNotEqualOrUnordered:
+        return DoubleEqual;
+      case DoubleGreaterThanOrUnordered:
+        return DoubleLessThanOrEqual;
+      case DoubleGreaterThanOrEqualOrUnordered:
+        return DoubleLessThan;
+      case DoubleLessThanOrUnordered:
+        return DoubleGreaterThanOrEqual;
+      case DoubleLessThanOrEqualOrUnordered:
+        return DoubleGreaterThan;
+      default:
+        MOZ_CRASH("unsupported double condition to invert");
+    }
+  }
+
+  // The patch site is always a movl bundle (see pushWithPatch, movePtr, and
+  // the relocation table code), so this round-trips through
+  // ReadMovlImm/WriteMovlImm exactly like TraceDataRelocations does.
+  static void PatchDataWithValueCheck(CodeLocationLabel label, ImmPtr newValue,
+                                      ImmPtr expectedValue) {
+    PatchDataWithValueCheck(label, ImmWord(uintptr_t(newValue.value)),
+                            ImmWord(uintptr_t(expectedValue.value)));
+  }
+  static void PatchDataWithValueCheck(CodeLocationLabel label,
+                                      ImmWord newValue, ImmWord expectedValue);
+  static void PatchDataWithValueCheck(CodeLocationLabel label,
+                                      PatchedImmPtr newValue,
+                                      PatchedImmPtr expectedValue) {
+    PatchDataWithValueCheck(label, ImmWord(uintptr_t(newValue.value)),
+                            ImmWord(uintptr_t(expectedValue.value)));
+  }
+  template <typename T, typename S>
+  static void PatchDataWithValueCheck(CodeLocationLabel, T, S) {
+    MOZ_CRASH();
+  }
+
+  // Overwrites the 4 bytes immediately before |label|, matching x86/loong64:
+  // used only for Ion invalidation's safepoint delta, which claims those
+  // bytes as raw data storage in code already being invalidated, so there is
+  // no instruction encoding to preserve.
+  static void PatchWrite_Imm32(CodeLocationLabel label, Imm32 imm) {
+    *(reinterpret_cast<uint32_t*>(label.raw()) - 1) = uint32_t(imm.value);
+  }
+
+  // A near call is movl(ScratchReg, target) + MovToBr(6, ScratchReg) +
+  // BrCall(0, 6): 3 bundles, matching call(Register) exactly. All three are
+  // written from scratch, because the patch site holds unrelated code.
+  static void PatchWrite_NearCall(CodeLocationLabel start,
+                                  CodeLocationLabel toCall);
+  static uint32_t PatchWrite_NearCallSize() { return 3 * sizeof(ia64::Bundle); }
+
+  // Every patch below rewrites live instruction memory, so it has to flush the
+  // bundle itself: the IA-64 I-cache is not coherent with stores, and not all
+  // callers hold an AutoWritableJitCode (whose destructor would flush). On the
+  // architectures this code is shared with, either the I-cache is coherent
+  // (x86) or the patch target is a literal-pool data word (arm64), so the
+  // generic callers have never needed one.
+  static void ToggleToJmp(CodeLocationLabel label) {
+    ia64::ToggleSlot2Op(reinterpret_cast<ia64::Bundle*>(label.raw()), 4);
+    FlushICache(label.raw(), sizeof(ia64::Bundle));
+  }
+  static void ToggleToCmp(CodeLocationLabel label) {
+    ia64::ToggleSlot2Op(reinterpret_cast<ia64::Bundle*>(label.raw()), 2);
+    FlushICache(label.raw(), sizeof(ia64::Bundle));
+  }
+  static void ToggleCall(CodeLocationLabel label, bool enabled) {
+    ia64::ToggleSlot2Op(reinterpret_cast<ia64::Bundle*>(label.raw()),
+                        enabled ? 5 : 2);
+    FlushICache(label.raw(), sizeof(ia64::Bundle));
+  }
+
+  // Patches one CodeLabel once the code is at |rawCode|: a movl placeholder
+  // gets the bit-scattering writer, a jump table entry a plain pointer store.
+  // (MacroAssemblerIa64::Bind is the same for JS code; wasm's linker calls
+  // this one.)
+  static void Bind(uint8_t* rawCode, const CodeLabel& label);
+
+  // Reads back the immediate embedded by a movl bundle (see
+  // MacroAssembler-ia64.h's ReadMovlImm), e.g. JSJitFrameIter reading an
+  // IonScript pointer materialised by movePtr(ImmPtr).
+  static uintptr_t GetPointer(uint8_t* addr);
+
+  static bool HasRoundInstruction(RoundingMode) { return false; }
+
+  void verifyHeapAccessDisassembly(uint32_t begin, uint32_t end,
+                                   const Disassembler::HeapAccess& heapAccess) {
+    MOZ_CRASH();
+  }
+
+  // The module-level wasm assembler holds a whole code block.
+  void setUnlimitedBuffer() { m_buffer.setUnlimited(); }
+};
+
+class Operand {
+ public:
+  explicit Operand(const Address&) { MOZ_CRASH(); }
+  explicit Operand(const Register) { MOZ_CRASH(); }
+  explicit Operand(const FloatRegister) { MOZ_CRASH(); }
+  explicit Operand(Register, Imm32) { MOZ_CRASH(); }
+  explicit Operand(Register, int32_t) { MOZ_CRASH(); }
+};
+
+// ABIKind::System: the Itanium psABI as GCC implements it (checked against its
+// output for mixed int/double calls, wiki/wasm.html): every argument
+// occupies one positional slot, and only the first eight slots are passed in
+// registers.  Integer arguments take the GR of their slot (slot N -> out(N));
+// FP arguments take the *next free FR*, not the one of their slot: the FR index
+// counts the FP arguments before it (f(int, double) receives the double in f8,
+// not f9).  An argument in slot 8 or higher, of either kind, goes on the stack.
+//
+// ABIKind::Wasm: integer arguments take the next of WasmIntArgRegs, FP
+// arguments the next of f8-f15, independently; the rest go on the stack.  Stack
+// arguments start above the wasm frame's shadow stack area and instance fields
+// (FrameWithInstances::sizeOfInstanceFieldsAndShadowStack(), 32 bytes): the
+// caller reserves that whole area and writes the callee and caller instance
+// slots into it, right above the psABI scratch area.  System calls need only
+// the scratch area.
+class ABIArgGenerator {
+  ABIKind kind_;
+  unsigned argIndex_ = 0;  // System: positional slot of the next argument
+  unsigned intIndex_ = 0;  // Wasm: integer registers used so far
+  unsigned fpIndex_ = 0;   // FP arguments passed in registers so far
+  // The psABI reserves the low 16 bytes of the frame as the callee's scratch
+  // area: the callee may write there without moving SP, and GCC does, e.g.
+  // "mov r16 = r12; adds r12 = -N, r12; ... stf.spill [r16] = f2" to spill an
+  // FP register. So outgoing stack arguments start above it, and the saved
+  // GP/b0 pair that callWithABIPre() puts at the top of the frame stays clear
+  // of it even when there are no stack arguments at all.
+  static const uint32_t ScratchAreaSize = 16;
+  // ShadowStackSpace (16) + the two instance fields (2 * sizeof(void*)).  Kept
+  // in sync with wasm::FrameWithInstances::sizeOfInstanceFieldsAndShadowStack()
+  // by that class's static_assert that there are exactly two fields.
+  static const uint32_t WasmArgAreaBase =
+      ShadowStackSpace + 2 * sizeof(void*);
+  uint32_t stackOffset_;
+  ABIArg current_;
+
+  static const unsigned NumArgRegs = 8;
+
+ public:
+  explicit ABIArgGenerator(ABIKind kind)
+      : kind_(kind),
+        stackOffset_(kind == ABIKind::Wasm ? WasmArgAreaBase
+                                           : ScratchAreaSize) {}
+  ABIArg next(MIRType type) {
+    switch (type) {
+      case MIRType::Int32:
+      case MIRType::Int64:
+      case MIRType::Pointer:
+      case MIRType::StackResults:
+      case MIRType::WasmAnyRef:
+      case MIRType::WasmArrayData:
+        if (kind_ == ABIKind::Wasm) {
+          if (intIndex_ < NumWasmIntArgRegs) {
+            current_ = ABIArg(WasmIntArgRegs[intIndex_++]);
+          } else {
+            current_ = ABIArg(stackOffset_);
+            stackOffset_ += sizeof(uintptr_t);
+          }
+        } else if (argIndex_ < NumArgRegs) {
+          current_ = ABIArg(Register::FromCode(Registers::out0 + argIndex_));
+        } else {
+          current_ = ABIArg(stackOffset_);
+          stackOffset_ += sizeof(uintptr_t);
+        }
+        break;
+      case MIRType::Float32:
+      case MIRType::Double:
+        if (fpIndex_ < NumFloatArgRegs &&
+            (kind_ == ABIKind::Wasm || argIndex_ < NumArgRegs)) {
+          current_ = ABIArg(FloatRegister(
+              FloatRegisters::Encoding(FloatRegisters::f8 + fpIndex_),
+              type == MIRType::Double ? FloatRegister::Double
+                                      : FloatRegister::Single));
+          fpIndex_++;
+        } else {
+          current_ = ABIArg(stackOffset_);
+          stackOffset_ += sizeof(double);
+        }
+        break;
+      default:
+        MOZ_CRASH("unexpected argument type for ia64 ABI");
+    }
+    argIndex_++;
+    return current_;
+  }
+  ABIArg& current() { return current_; }
+  uint32_t stackBytesConsumedSoFar() const { return stackOffset_; }
+};
+
+}  // namespace jit
+}  // namespace js
+
+#include "jit/ia64/LoopRecorder-ia64-inl.h"
+
+#endif /* jit_ia64_Assembler_ia64_h */
diff --git a/js/src/jit/ia64/AssemblerCore-ia64.h b/js/src/jit/ia64/AssemblerCore-ia64.h
new file mode 100644
--- /dev/null
+++ b/js/src/jit/ia64/AssemblerCore-ia64.h
@@ -0,0 +1,2389 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#ifndef jit_ia64_AssemblerCore_ia64_h
+#define jit_ia64_AssemblerCore_ia64_h
+
+#include "mozilla/Assertions.h"
+#include "mozilla/Likely.h"
+
+#include <stdint.h>
+#include <string.h>
+
+// [SMDOC] IA-64 instruction and bundle encoding
+//
+// IA-64 does not have a linear instruction stream: instructions are packed
+// three at a time into 128-bit (16-byte) *bundles*:
+//
+//   bits   4:0    template
+//   bits  45:5    slot 0   (41 bits)
+//   bits  86:46   slot 1   (41 bits)
+//   bits 127:87   slot 2   (41 bits)
+//
+// The 5-bit template selects, for each slot, which execution unit the
+// instruction in it must belong to (M = memory, I = integer/shift, F = float,
+// B = branch, L+X = the two-slot long-immediate form), and where the *stop
+// bits* fall. A stop bit terminates an instruction group: instructions within a
+// group must have no register dependencies, because the hardware issues them in
+// parallel with no interlocks.
+//
+// This file is only the encoder: it turns operands into the 41 bits of one
+// instruction and hands out an |Op| carrying those bits together with the
+// execution unit the instruction may issue to and the architectural resources
+// it reads and writes. Bundler-ia64.h packs a stream of |Op|s into bundles and
+// decides where the stop bits go. (This backend used to emit one instruction
+// per bundle with a stop after every one -- correct by construction, and 16
+// bytes per instruction.)
+//
+// All bit positions below are taken from the binutils IA-64 opcode tables
+// (opcodes/ia64-opc-*.c), which are the authoritative encoding description, and
+// from the instruction pages of Volume 3 of the Itanium SDM. The encoder is
+// verified byte-for-byte against GNU as: the bundler's output is disassembled
+// with objdump, reassembled from that disassembly and compared, which also puts
+// binutils' own dependency-violation checker over the stop bits.
+
+namespace js {
+namespace jit {
+namespace ia64 {
+
+using Insn = uint64_t;  // a 41-bit instruction, right-aligned
+
+struct Bundle {
+  uint64_t lo;
+  uint64_t hi;
+};
+
+// Template encodings. The trailing underscore marks a stop bit at the end of
+// the bundle; "_" inside the name marks an internal stop.
+enum Template : uint8_t {
+  tMII = 0x00,
+  tMII_ = 0x01,
+  tMI_I = 0x02,
+  tMI_I_ = 0x03,
+  tMLX = 0x04,
+  tMLX_ = 0x05,
+  tMMI = 0x08,
+  tMMI_ = 0x09,
+  tM_MI = 0x0a,
+  tM_MI_ = 0x0b,
+  tMFI = 0x0c,
+  tMFI_ = 0x0d,
+  tMMF = 0x0e,
+  tMMF_ = 0x0f,
+  tMIB = 0x10,
+  tMIB_ = 0x11,
+  tMBB = 0x12,
+  tMBB_ = 0x13,
+  tBBB = 0x16,
+  tBBB_ = 0x17,
+  tMMB = 0x18,
+  tMMB_ = 0x19,
+  tMFB = 0x1c,
+  tMFB_ = 0x1d,
+};
+
+// Pack three 41-bit slots and a template into a 16-byte bundle.
+inline Bundle MakeBundle(Template tmpl, Insn s0, Insn s1, Insn s2) {
+  const uint64_t kSlotMask = (uint64_t(1) << 41) - 1;
+  s0 &= kSlotMask;
+  s1 &= kSlotMask;
+  s2 &= kSlotMask;
+
+  Bundle b;
+  // lo = template | slot0 << 5 | low 18 bits of slot1 << 46
+  b.lo = uint64_t(tmpl & 0x1f) | (s0 << 5) | (s1 << 46);
+  // hi = high 23 bits of slot1 | slot2 << 23
+  b.hi = (s1 >> 18) | (s2 << 23);
+  return b;
+}
+
+// Store a bundle into the code buffer. A plain memcpy of 16 bytes to a
+// uint8_t* is a call to libc on ia64 -- the compiler cannot prove the
+// destination aligned, and unaligned 8-byte stores trap -- and the bundler
+// does one for every instruction emitted. Bundles sit at 16-byte offsets in
+// buffer storage that is in practice 8-byte aligned; the check keeps the
+// memcpy only for when it is not.
+#define JIT_IA64_HAS_STORE_BUNDLE 1
+inline void StoreBundle(uint8_t* p, const Bundle& b) {
+  if (MOZ_LIKELY((uintptr_t(p) & 7) == 0)) {
+    uint64_t* q = static_cast<uint64_t*>(__builtin_assume_aligned(p, 8));
+    q[0] = b.lo;
+    q[1] = b.hi;
+  } else {
+    memcpy(p, &b, sizeof(b));
+  }
+}
+
+// ---------------------------------------------------------------------------
+// [SMDOC] IA-64 instruction descriptors
+//
+// The bundler (Bundler-ia64.h) has to answer two questions about every
+// instruction it is handed: which execution unit can issue it, and which
+// architectural resources it reads and writes. Neither is recoverable cheaply
+// from the 41 raw bits, so the encoders below hand both out alongside the
+// encoding, in an |Op|.
+//
+// The information is attached in the *format* constructors (A1, A6, M1, M4,
+// I7, F1, ...), not in the individual mnemonics. Every instruction sharing a
+// format has the same operand roles in the same bit positions, which is the
+// whole reason the IA-64 encoding is organised that way, so annotating the
+// ~40 formats covers all ~200 mnemonics exactly and without duplication.
+//
+// Registers that read as constants -- GR r0, FR f0/f1, PR p0 -- are dropped on
+// the way in. That matters more than it looks: an unpredicated instruction has
+// qp == 0, and recording that as a read of p0 would make every instruction in
+// the buffer appear to depend on every compare.
+// ---------------------------------------------------------------------------
+
+// The execution unit an instruction may issue to. A-type instructions -- the
+// integer ALU group (major opcode 8) and the A6 compares -- are the only ones
+// with a choice: the hardware routes them to either an M or an I port. That
+// flexibility is what lets the bundler fill whichever slot a template happens
+// to offer, and it is why the unit belongs to the instruction rather than to
+// the emit call site.
+enum Unit : uint8_t {
+  UnitM,   // M port only
+  UnitI,   // I port only
+  UnitA,   // A-type: M or I
+  UnitF,   // F port only
+  UnitB,   // B port only
+  UnitLX,  // two-slot L+X: movl and brl
+};
+
+// Resource classes tracked for instruction-group dependency checking
+// (SDM Volume 1, section 3.4).
+enum ResClass : uint8_t {
+  ResGr,   // general register
+  ResFr,   // floating-point register
+  ResPr,   // predicate register
+  ResBr,   // branch register
+  ResAr,   // application register: only PFS and CCV are reachable here
+  ResCfm,  // current frame marker, written by alloc and by br.call/br.ret
+};
+
+// AR numbers, as they appear in the instruction encoding.
+static const uint32_t ArCcv = 32;
+static const uint32_t ArPfs = 64;
+
+inline constexpr uint16_t Rsrc(ResClass c, uint32_t n) {
+  return uint16_t((uint32_t(c) << 8) | (n & 0xff));
+}
+// The two halves of a resource id (Op::def, Op::use).
+inline constexpr ResClass ResClassOf(uint16_t r) { return ResClass(r >> 8); }
+inline constexpr uint32_t ResNum(uint16_t r) { return r & 0xff; }
+
+enum OpFlags : uint8_t {
+  // A B-unit branch. Branches get the RAW special cases of SDM 1:3.4.1: a BR,
+  // AR[PFS] or CFM written earlier in the same instruction group by a
+  // non-branch is visible to them, as is a predicate written by a non-FP
+  // instruction.
+  OpBranch = 1 << 0,
+  // alloc, which the architecture requires to be the first instruction in its
+  // instruction group.
+  OpAlloc = 1 << 1,
+  // An F-unit instruction. A predicate written by one of these is *not*
+  // visible to a branch in the same group, which is the one place where the
+  // branch RAW exception does not apply.
+  OpFpu = 1 << 2,
+  // break.b, which ends the instruction group outright.
+  OpEndsGroup = 1 << 3,
+  // A memory reference. Memory RAW/WAW/WAR inside an instruction group are
+  // architecturally allowed and well defined, so this is recorded for the
+  // trap-site bookkeeping's benefit rather than for dependency checking.
+  OpMemory = 1 << 4,
+  // Safe to reorder within a straight-line window (Scheduler-ia64.h): every
+  // architectural effect is in the def/use lists, or is an ordinary memory
+  // access marked OpMemory. Set only by the encoders of plain ALU, compare,
+  // shift/extend, ordinary loads and stores, getf/setf and FP arithmetic --
+  // never acquire/release or atomic accesses, AR or BR moves, branches or
+  // anything whose result depends on where it lands (movl patch sites).
+  OpSched = 1 << 5,
+  // A load of a VM word the JIT's own stores never write (the zone's marking
+  // barrier flag): the pipeliner takes it for disjoint from every store.
+  OpNoAlias = 1 << 6,
+  // chk.s (unit A: chk.s.i in an I slot, chk.s.m in an M slot): branches to
+  // recovery code when its register holds a NaT, skipping the slots after
+  // it in its bundle and the rest of its instruction group, as a taken
+  // branch does (SDM 3:35).  Its recovery code redoes the checked
+  // instruction, replays those slots and branches to the next bundle
+  // (Assembler::emitRecoveryCode()), so only replayable instructions may
+  // follow it in its bundle (OpenBundle::tryAdd()).  Scheduler-ia64.h,
+  // speculative loads.
+  OpCheck = 1 << 7,
+};
+
+static const size_t MaxOpDefs = 4;
+static const size_t MaxOpUses = 6;
+
+// Where a def or use sits in the instruction: the low bit of its field, for
+// the pipeliner to rename it (Pipeliner-ia64.h).  General and FP register
+// fields are 7 bits wide, predicate fields 6.
+static const uint8_t kNoField = 0xff;     // implicit: no field (ar.ccv, ...)
+static const uint8_t kFixedField = 0xfe;  // a field that cannot name every
+                                          // register (addl's 2-bit r3)
+
+struct Op {
+  Insn bits;    // the 41-bit instruction, or the X slot of an L+X pair
+  Insn bitsL;   // the L slot, for UnitLX only
+  uint8_t unit;
+  uint8_t flags;
+  uint8_t nDef;
+  uint8_t nUse;
+  uint16_t def[MaxOpDefs];
+  uint16_t use[MaxOpUses];
+  uint8_t defPos[MaxOpDefs];
+  uint8_t usePos[MaxOpUses];
+  // defsGr(), defsFr() and usesFr(), kept by d() and u(): the scheduler
+  // and the pipeliner ask them per instruction per schedule (latency, port
+  // class).  A pass that rewrites def or use lists itself calls recount();
+  // renaming a register within its class needs nothing.
+  uint8_t cls;
+  enum : uint8_t { ClsDefGr = 1, ClsDefFr = 2, ClsUseFr = 4 };
+
+  // Record a written resource and, when it is encoded in a field, where.
+  // Constant registers are dropped: they cannot carry a dependency.
+  Op& d(ResClass c, uint32_t n, uint8_t pos = kNoField) {
+    if (IsConstantReg(c, n)) {
+      return *this;
+    }
+    MOZ_ASSERT(nDef < MaxOpDefs);
+    defPos[nDef] = pos;
+    def[nDef++] = Rsrc(c, n);
+    cls |= c == ResGr ? ClsDefGr : c == ResFr ? ClsDefFr : 0;
+    return *this;
+  }
+  Op& u(ResClass c, uint32_t n, uint8_t pos = kNoField) {
+    if (IsConstantReg(c, n)) {
+      return *this;
+    }
+    MOZ_ASSERT(nUse < MaxOpUses);
+    usePos[nUse] = pos;
+    use[nUse++] = Rsrc(c, n);
+    cls |= c == ResFr ? ClsUseFr : 0;
+    return *this;
+  }
+  // cls from the lists, after a pass rewrote them.
+  void recount() {
+    cls = uint8_t((Defs(ResGr) ? ClsDefGr : 0) | (Defs(ResFr) ? ClsDefFr : 0) |
+                  (Uses(ResFr) ? ClsUseFr : 0));
+  }
+  Op& fl(uint8_t f) {
+    flags |= f;
+    return *this;
+  }
+
+  // Fields every instruction has: the qualifying predicate (0: always) and
+  // the major opcode.
+  uint32_t qp() const { return uint32_t(bits & 0x3f); }
+  uint32_t major() const { return uint32_t(bits >> 37) & 0xf; }
+
+  // br.call (B unit, opcode 5) and its indirect form (opcode 1), brl.call
+  // (L+X, opcode 0xd).
+  bool isCall() const {
+    const uint32_t m = major();
+    return (unit == UnitB && (m == 5 || m == 1)) || (unit == UnitLX && m == 0xd);
+  }
+
+  // What the def and use lists name (constant registers are not listed).
+  bool defsGr() const {
+    MOZ_ASSERT(bool(cls & ClsDefGr) == Defs(ResGr));
+    return cls & ClsDefGr;
+  }
+  bool defsFr() const {
+    MOZ_ASSERT(bool(cls & ClsDefFr) == Defs(ResFr));
+    return cls & ClsDefFr;
+  }
+  bool usesFr() const {
+    MOZ_ASSERT(bool(cls & ClsUseFr) == Uses(ResFr));
+    return cls & ClsUseFr;
+  }
+  bool Uses(ResClass c) const {
+    for (uint32_t i = 0; i < nUse; i++) {
+      if (ResClassOf(use[i]) == c) {
+        return true;
+      }
+    }
+    return false;
+  }
+  bool Defs(ResClass c) const {
+    for (uint32_t i = 0; i < nDef; i++) {
+      if (ResClassOf(def[i]) == c) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  static bool IsConstantReg(ResClass c, uint32_t n) {
+    switch (c) {
+      case ResGr:
+        return n == 0;         // r0 reads as 0, writes are illegal
+      case ResFr:
+        return n == 0 || n == 1;  // f0 is +0.0, f1 is +1.0
+      case ResPr:
+        return n == 0;         // p0 reads as 1, writes are ignored
+      default:
+        return false;
+    }
+  }
+};
+
+inline Op MakeOp(Insn bits, Unit unit) {
+  Op o = {};
+  o.bits = bits;
+  o.unit = uint8_t(unit);
+  return o;
+}
+
+// A two-slot L+X instruction: |x| is the X slot (which carries the opcode),
+// |l| the L slot (which is pure immediate).
+inline Op MakeOpLX(Insn x, Insn l) {
+  Op o = {};
+  o.bits = x;
+  o.bitsL = l;
+  o.unit = uint8_t(UnitLX);
+  return o;
+}
+
+// Cycles from the issue of |op| to the use of its result.  The scheduler and
+// the pipeliner differ in one number, deliberately: getf is 5 cycles measured
+// in isolation (Scheduler), 6 inside a kernel (Pipeliner).
+inline int OpLatency(const Op& op, int getfLatency) {
+  if (op.unit == UnitF) {
+    return 4;
+  }
+  const bool defFr = op.defsFr();
+  if (op.flags & OpMemory) {
+    return defFr ? 6 : 1;
+  }
+  if (op.unit == UnitM && defFr) {
+    return 6;  // setf
+  }
+  if (op.unit == UnitM && op.defsGr() && op.usesFr()) {
+    return getfLatency;  // getf
+  }
+  return 1;
+}
+
+// ---------------------------------------------------------------------------
+// Instruction field helpers. Positions per binutils opcodes/ia64-opc-*.c.
+// ---------------------------------------------------------------------------
+
+inline Insn fOp(uint32_t x) { return Insn(x & 0xf) << 37; }
+inline Insn fQp(uint32_t x) { return Insn(x & 0x3f); }
+// The register-stack frame all JIT code shares (EnterJIT, the wasm interpreter
+// entry, irregexp's prologue and the pipeliner's kernel exits create it):
+//
+//     alloc rN = ar.pfs, 0, 0, kFrameOuts, 0
+//
+// r32-r39 are out0-out7, the C argument registers of the register model;
+// r40-r55 are the rename pool: output registers the window scheduler moves
+// values into that die inside its window (Scheduler::renameDead()), never
+// Register objects, never live across a window's end, so across nothing the
+// pool's owner cannot see: a call (the callee's frame starts at out0 and
+// takes them over), a branch, a bailout or the pipeliner's rotating frame,
+// which reuses the whole register stack inside a kernel.  sol stays 0, so
+// br.call still leaves CFM alone and a C call makes the RSE save nothing of
+// the frame.
+static const uint32_t kPoolBase = 40;
+static const uint32_t kPoolSize = 16;
+static const uint32_t kFrameOuts = 8 + kPoolSize;
+
+// Only r0-r63 exist in this backend: r0-r31 static, r32-r39 out0-out7,
+// r40-r55 the rename pool, r56-r63 only inside a C call that keeps the pool. Encoding anything else -- in particular
+// Registers::invalid_reg, which is 40 in the register model, outside any
+// renamer -- names a stacked register outside the current frame, and IA-64
+// raises an Illegal Operation fault (SIGILL/ILL_ILLOPC) rather than faulting
+// at the point of the mistake.
+// A C call that keeps the pool (MacroAssemblerIa64::AutoKeepPoolIA64) grows
+// the frame by r56 (the saved ar.pfs) and up to seven outputs, r57-r63.
+inline void AssertGpr(uint32_t x) {
+  MOZ_ASSERT(x < 64, "invalid GR encoding");
+}
+
+inline Insn fR1(uint32_t x) {
+  AssertGpr(x);
+  return Insn(x & 0x7f) << 6;
+}
+inline Insn fR2(uint32_t x) {
+  AssertGpr(x);
+  return Insn(x & 0x7f) << 13;
+}
+inline Insn fR3(uint32_t x) {
+  AssertGpr(x);
+  return Insn(x & 0x7f) << 20;
+}
+inline Insn fX2a(uint32_t x) { return Insn(x & 0x3) << 34; }
+inline Insn fX2b(uint32_t x) { return Insn(x & 0x3) << 27; }
+inline Insn fX4(uint32_t x) { return Insn(x & 0xf) << 29; }
+inline Insn fVe(uint32_t x) { return Insn(x & 0x1) << 33; }
+
+// imm14, as used by A4 (adds): imm[6:0] -> 19:13, imm[12:7] -> 32:27,
+// imm[13] (sign) -> 36.
+inline Insn fImm14(int64_t v) {
+  uint64_t u = uint64_t(v);
+  return (Insn((u >> 0) & 0x7f) << 13) | (Insn((u >> 7) & 0x3f) << 27) |
+         (Insn((u >> 13) & 0x1) << 36);
+}
+
+// ---------------------------------------------------------------------------
+// A-type (ALU) instructions, major opcode 8.
+// ---------------------------------------------------------------------------
+
+// A1: r1 = r2 <op> r3
+inline Op A1(uint32_t x4, uint32_t x2b, uint32_t r1, uint32_t r2,
+               uint32_t r3, uint32_t qp = 0) {
+  return MakeOp(fOp(8) | fX2a(0) | fVe(0) | fX4(x4) | fX2b(x2b) | fR3(r3) |
+                    fR2(r2) | fR1(r1) | fQp(qp),
+                UnitA)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r2, 13)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+
+inline Op Add(uint32_t r1, uint32_t r2, uint32_t r3, uint32_t qp = 0) {
+  return A1(0, 0, r1, r2, r3, qp);
+}
+inline Op Sub(uint32_t r1, uint32_t r2, uint32_t r3, uint32_t qp = 0) {
+  return A1(1, 1, r1, r2, r3, qp);
+}
+inline Op And(uint32_t r1, uint32_t r2, uint32_t r3, uint32_t qp = 0) {
+  return A1(3, 0, r1, r2, r3, qp);
+}
+inline Op Andcm(uint32_t r1, uint32_t r2, uint32_t r3, uint32_t qp = 0) {
+  return A1(3, 1, r1, r2, r3, qp);
+}
+
+// A3: and r1 = imm8, r3. sign -> bit 36, imm7b -> bits 19:13 (the same split
+// as fImm14 minus its extra 6 immediate bits).
+inline Insn fImm8(int64_t v) {
+  return (Insn(v & 0x7f) << 13) | (Insn((v >> 7) & 1) << 36);
+}
+inline Op AndImm(uint32_t r1, int64_t imm8, uint32_t r3, uint32_t qp = 0) {
+  return MakeOp(fOp(8) | fX2a(0) | fVe(0) | fX4(0xb) | fX2b(0) | fImm8(imm8) |
+                    fR3(r3) | fR1(r1) | fQp(qp),
+                UnitA)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+// The other A3 logical immediates: x2b 2 is or, 3 is xor.
+inline Op OrImm(uint32_t r1, int64_t imm8, uint32_t r3, uint32_t qp = 0) {
+  return MakeOp(fOp(8) | fX2a(0) | fVe(0) | fX4(0xb) | fX2b(2) | fImm8(imm8) |
+                    fR3(r3) | fR1(r1) | fQp(qp),
+                UnitA)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+inline Op XorImm(uint32_t r1, int64_t imm8, uint32_t r3, uint32_t qp = 0) {
+  return MakeOp(fOp(8) | fX2a(0) | fVe(0) | fX4(0xb) | fX2b(3) | fImm8(imm8) |
+                    fR3(r3) | fR1(r1) | fQp(qp),
+                UnitA)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+inline Op Or(uint32_t r1, uint32_t r2, uint32_t r3, uint32_t qp = 0) {
+  return A1(3, 2, r1, r2, r3, qp);
+}
+inline Op Xor(uint32_t r1, uint32_t r2, uint32_t r3, uint32_t qp = 0) {
+  return A1(3, 3, r1, r2, r3, qp);
+}
+
+// A4: r1 = imm14 + r3  ("adds"). Also the canonical register move when
+// imm == 0, which is how "mov r1 = r3" is encoded.
+inline Op Adds(uint32_t r1, int64_t imm14, uint32_t r3, uint32_t qp = 0) {
+  return MakeOp(
+             fOp(8) | fX2a(2) | fVe(0) | fImm14(imm14) | fR3(r3) | fR1(r1) |
+                 fQp(qp),
+             UnitA)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+
+inline Op MovReg(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return Adds(r1, 0, r3, qp);
+}
+
+// The fields of an unpredicated adds (MovReg included); false for anything
+// else.
+inline bool DecodeAdds(const Op& op, uint32_t* r1, uint32_t* r3,
+                       int64_t* imm) {
+  const Insn b = op.bits;
+  if (op.unit != UnitA || ((b >> 37) & 0xf) != 8 || ((b >> 34) & 3) != 2 ||
+      ((b >> 33) & 1) != 0 || (b & 0x3f) != 0) {
+    return false;
+  }
+  uint64_t u = ((b >> 13) & 0x7f) | (((b >> 27) & 0x3f) << 7) |
+               (((b >> 36) & 1) << 13);
+  *imm = int64_t(u << 50) >> 50;  // sign-extend 14 bits
+  *r1 = uint32_t(b >> 6) & 0x7f;
+  *r3 = uint32_t(b >> 20) & 0x7f;
+  return true;
+}
+
+// An unpredicated add (shift 0) or shladd: r1 = (r2 << *shift) + r3.
+inline bool DecodeShladd(const Op& op, uint32_t* r1, uint32_t* r2,
+                         uint32_t* shift, uint32_t* r3) {
+  const Insn b = op.bits;
+  if (op.unit != UnitA || ((b >> 37) & 0xf) != 8 || ((b >> 34) & 3) != 0 ||
+      ((b >> 33) & 1) != 0 || (b & 0x3f) != 0) {
+    return false;
+  }
+  const uint32_t x4 = uint32_t(b >> 29) & 0xf, x2b = uint32_t(b >> 27) & 3;
+  if (x4 == 0 && x2b == 0) {
+    *shift = 0;  // add
+  } else if (x4 == 4) {
+    *shift = x2b + 1;  // shladd
+  } else {
+    return false;
+  }
+  *r1 = uint32_t(b >> 6) & 0x7f;
+  *r2 = uint32_t(b >> 13) & 0x7f;
+  *r3 = uint32_t(b >> 20) & 0x7f;
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// A6: compare two registers and write a pair of predicates.
+//   cmp.rel p1, p2 = r2, r3
+//   tb -> bit 36   x2 -> bits 35:34   ta -> bit 33
+//   p2 -> bits 32:27   r3 -> 26:20   r2 -> 19:13   c -> bit 12   p1 -> 11:6
+// Predicates are 6 bits (p0-p63), so p1 does not reach bit 12.
+// ---------------------------------------------------------------------------
+
+inline Insn fP1(uint32_t x) { return Insn(x & 0x3f) << 6; }
+inline Insn fP2(uint32_t x) { return Insn(x & 0x3f) << 27; }
+inline Insn fTa(uint32_t x) { return Insn(x & 0x1) << 33; }
+inline Insn fTb(uint32_t x) { return Insn(x & 0x1) << 36; }
+inline Insn fC(uint32_t x) { return Insn(x & 0x1) << 12; }
+inline Insn fX2(uint32_t x) { return Insn(x & 0x3) << 34; }
+
+inline Op CmpA6(uint32_t op, uint32_t p1, uint32_t p2, uint32_t r2,
+                  uint32_t r3, uint32_t qp = 0) {
+  return MakeOp(fOp(op) | fTb(0) | fX2(0) | fTa(0) | fP2(p2) | fR3(r3) |
+                    fR2(r2) | fC(0) | fP1(p1) | fQp(qp),
+                UnitA)
+      .d(ResPr, p1, 6)
+      .d(ResPr, p2, 27)
+      .u(ResGr, r2, 13)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+
+inline Op CmpEq(uint32_t p1, uint32_t p2, uint32_t r2, uint32_t r3,
+                  uint32_t qp = 0) {
+  return CmpA6(0xe, p1, p2, r2, r3, qp);
+}
+// cmp.ne is cmp.eq with the two predicate destinations exchanged.
+inline Op CmpNe(uint32_t p1, uint32_t p2, uint32_t r2, uint32_t r3,
+                  uint32_t qp = 0) {
+  return CmpA6(0xe, p2, p1, r2, r3, qp);
+}
+inline Op CmpLt(uint32_t p1, uint32_t p2, uint32_t r2, uint32_t r3,
+                  uint32_t qp = 0) {
+  return CmpA6(0xc, p1, p2, r2, r3, qp);
+}
+inline Op CmpLtu(uint32_t p1, uint32_t p2, uint32_t r2, uint32_t r3,
+                   uint32_t qp = 0) {
+  return CmpA6(0xd, p1, p2, r2, r3, qp);
+}
+
+// ---------------------------------------------------------------------------
+// M-type (memory) instructions, major opcode 4.
+//   m    -> bit 36    x   -> bit 27
+//   x6a  -> bits 35:30  hint -> bits 29:28
+// ---------------------------------------------------------------------------
+
+inline Insn fM(uint32_t x) { return Insn(x & 0x1) << 36; }
+inline Insn fXm(uint32_t x) { return Insn(x & 0x1) << 27; }
+inline Insn fX6a(uint32_t x) { return Insn(x & 0x3f) << 30; }
+inline Insn fHint(uint32_t x) { return Insn(x & 0x3) << 28; }
+
+// M1: r1 = [r3]
+inline Op LoadM1(uint32_t x6a, uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return MakeOp(fOp(4) | fM(0) | fXm(0) | fX6a(x6a) | fHint(0) | fR3(r3) |
+                    fR1(r1) | fQp(qp),
+                UnitM)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpMemory);
+}
+
+// M4: [r3] = r2
+inline Op StoreM4(uint32_t x6a, uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return MakeOp(fOp(4) | fM(0) | fXm(0) | fX6a(x6a) | fHint(0) | fR3(r3) |
+                    fR2(r2) | fQp(qp),
+                UnitM)
+      .u(ResGr, r3, 20)
+      .u(ResGr, r2, 13)
+      .u(ResPr, qp, 0)
+      .fl(OpMemory);
+}
+
+inline Op Ld1(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return LoadM1(0x00, r1, r3, qp).fl(OpSched);
+}
+inline Op Ld2(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return LoadM1(0x01, r1, r3, qp).fl(OpSched);
+}
+inline Op Ld4(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return LoadM1(0x02, r1, r3, qp).fl(OpSched);
+}
+inline Op Ld8(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return LoadM1(0x03, r1, r3, qp).fl(OpSched);
+}
+
+inline Op St1(uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return StoreM4(0x30, r3, r2, qp).fl(OpSched);
+}
+inline Op St2(uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return StoreM4(0x31, r3, r2, qp).fl(OpSched);
+}
+inline Op St4(uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return StoreM4(0x32, r3, r2, qp).fl(OpSched);
+}
+inline Op St8(uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return StoreM4(0x33, r3, r2, qp).fl(OpSched);
+}
+
+// M6/M9: floating-point loads and stores. Same M1/M4 shape but with major
+// opcode 6 instead of 4, and f1/f2 in place of the integer register fields
+// (they share the same 7-bit slot).
+// f1/f2 share the r1/r2 bit position (6:12 and 13:19 respectively), so the
+// generic fR1/fR2 helpers double as the FP register fields here.
+inline Op LoadF6(uint32_t x6a, uint32_t f1, uint32_t r3, uint32_t qp = 0) {
+  return MakeOp(fOp(6) | fM(0) | fXm(0) | fX6a(x6a) | fHint(0) | fR3(r3) |
+                    fR1(f1) | fQp(qp),
+                UnitM)
+      .d(ResFr, f1, 6)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpMemory);
+}
+inline Op StoreF9(uint32_t x6a, uint32_t r3, uint32_t f2, uint32_t qp = 0) {
+  return MakeOp(fOp(6) | fM(0) | fXm(0) | fX6a(x6a) | fHint(0) | fR3(r3) |
+                    fR2(f2) | fQp(qp),
+                UnitM)
+      .u(ResGr, r3, 20)
+      .u(ResFr, f2, 13)
+      .u(ResPr, qp, 0)
+      .fl(OpMemory);
+}
+inline Op Ldfs(uint32_t f1, uint32_t r3, uint32_t qp = 0) {
+  return LoadF6(0x02, f1, r3, qp).fl(OpSched);
+}
+inline Op Ldfd(uint32_t f1, uint32_t r3, uint32_t qp = 0) {
+  return LoadF6(0x03, f1, r3, qp).fl(OpSched);
+}
+inline Op Stfs(uint32_t r3, uint32_t f2, uint32_t qp = 0) {
+  return StoreF9(0x32, r3, f2, qp).fl(OpSched);
+}
+inline Op Stfd(uint32_t r3, uint32_t f2, uint32_t qp = 0) {
+  return StoreF9(0x33, r3, f2, qp).fl(OpSched);
+}
+
+// Post-increment forms: M3 "ld r1 = [r3], imm9", M5 "st [r3] = r2, imm9",
+// M8/M10 the same for ldf/stf. The major opcode is one more than the plain
+// form's (4 -> 5, 6 -> 7); bits 36 (m) and 27 (x), zero in the plain form,
+// become the immediate's sign and bit 7, and its low seven bits go to the
+// r2 field of a load (19:13) or the r1 field of a store (12:6). r3 is written
+// with r3 + imm9 after the access; its def sits at the r3 field (bit 20),
+// which tells it from a load's result (bit 6).
+static const uint8_t kBaseUpdateField = 20;
+
+inline bool FitsImm9(int64_t imm) { return imm >= -256 && imm <= 255; }
+
+// Whether |op| is one of the plain ld1-8/st1-8/ldfs/ldfd/stfs/stfd above, or
+// st8.spill: no base update, no acquire/release, no speculation or hint.
+inline bool IsPlainAccess(const Op& op) {
+  if (!(op.flags & OpMemory) || !(op.flags & OpSched) || op.unit != UnitM) {
+    return false;
+  }
+  uint32_t major = op.major();
+  uint32_t x6 = uint32_t(op.bits >> 30) & 0x3f;
+  if ((op.bits >> 36) & 1 || (op.bits >> 27) & 1 || (op.bits >> 28) & 3) {
+    return false;
+  }
+  if (major == 4) {
+    return x6 <= 0x03 || (x6 >= 0x30 && x6 <= 0x33) || x6 == 0x3b;
+  }
+  if (major == 6) {
+    return x6 == 0x02 || x6 == 0x03 || x6 == 0x32 || x6 == 0x33;
+  }
+  return false;
+}
+
+// Whether a memory op writes a value register (a load), as opposed to only
+// updating its base (a post-increment store).
+inline bool HasMemResult(const Op& op) {
+  for (uint32_t d = 0; d < op.nDef; d++) {
+    ResClass c = ResClassOf(op.def[d]);
+    if ((c == ResGr || c == ResFr) && op.defPos[d] != kBaseUpdateField) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// |op|, an IsPlainAccess() access, as its post-increment form.
+inline Op WithPostIncrement(const Op& op, int64_t imm9) {
+  MOZ_ASSERT(IsPlainAccess(op) && FitsImm9(imm9));
+  const uint32_t r3 = uint32_t(op.bits >> 20) & 0x7f;
+  const uint32_t major = op.major();
+  const uint64_t imm = uint64_t(imm9) & 0x1ff;
+  Op out = op;
+  Insn bits = (op.bits & ~(Insn(0xf) << 37)) | fOp(major + 1);
+  bits |= Insn((imm >> 8) & 1) << 36;
+  bits |= Insn((imm >> 7) & 1) << 27;
+  if (HasMemResult(op)) {
+    bits |= Insn(imm & 0x7f) << 13;  // M3/M8: imm7b
+  } else {
+    bits |= Insn(imm & 0x7f) << 6;  // M5/M10: imm7a
+  }
+  out.bits = bits;
+  return out.d(ResGr, r3, kBaseUpdateField);
+}
+
+// ---- control speculation (Scheduler-ia64.h) --------------------------------
+//
+// An integer load that may move above a guard: a plain ld1-8 (no base
+// update, acquire or hint) whose result is not its own address.
+inline bool SpeculableLoad(const Op& op) {
+  if (!IsPlainAccess(op) || !HasMemResult(op) || op.qp() != 0) {
+    return false;
+  }
+  if (op.major() != 4) {
+    return false;  // ldfs/ldfd: a NaTVal would fault in the bailout's stfd
+  }
+  return ((op.bits >> 6) & 0x7f) != ((op.bits >> 20) & 0x7f);
+}
+
+// ld1-8 -> ld1-8.s (x6 bit 2): a fault is deferred into the target's NaT bit.
+inline Insn AsSpeculativeLoad(Insn bits) { return bits | (Insn(0x04) << 30); }
+
+// chk.s r2, target25 (SDM 3:35): I20 chk.s.i (major 0, x3 1) or M20
+// chk.s.m (major 1, x3 1), the same fields otherwise.  The op is unit A and
+// carries the I20 form; the bundler switches the major opcode when it lands
+// in an M slot (OpenBundle::build()).  chk.s.m issues on M2/M3 only, the
+// store ports (Itanium 2 reference manual, table 3-3).  The displacement is
+// filled in with the recovery code (PatchCheckDisp()).  The register's
+// instruction (the one to redo in the recovery code) rides along in bitsL,
+// its unit in bitsL's top bits: chk.s itself has no L slot.
+inline Op ChkS(uint32_t r2, const Op& checked) {
+  Op op = MakeOp(fOp(0) | (Insn(1) << 33) | (Insn(r2 & 0x7f) << 13), UnitA)
+              .u(ResGr, r2, 13)
+              .fl(OpCheck);
+  op.bitsL = checked.bits | (Insn(checked.unit) << 56);
+  return op;
+}
+inline Insn CheckedBits(const Op& chk) { return chk.bitsL & ((Insn(1) << 41) - 1); }
+inline Unit CheckedUnit(const Op& chk) { return Unit((chk.bitsL >> 56) & 0xff); }
+// The chk.s.m form of a check's bits.
+inline Insn AsChkSM(Insn bits) {
+  return (bits & ~(Insn(0xf) << 37)) | (Insn(1) << 37);
+}
+
+// The three slots of |b|, and a bundle of template |t| holding them.
+inline void BundleSlots(const Bundle* b, Insn s[3]) {
+  const uint64_t kSlotMask = (uint64_t(1) << 41) - 1;
+  s[0] = (b->lo >> 5) & kSlotMask;
+  s[1] = ((b->lo >> 46) | (b->hi << 18)) & kSlotMask;
+  s[2] = (b->hi >> 23) & kSlotMask;
+}
+
+// Slot kinds per template (bits 4:1): bit i set when slot i is an M (I, B)
+// slot.  See the Template enum.
+static const uint8_t kMSlots[16] = {
+    /* MII */ 1, /* MI_I */ 1, /* MLX */ 1, /* - */ 0,
+    /* MMI */ 3, /* M_MI */ 3, /* MFI */ 1, /* MMF */ 3,
+    /* MIB */ 1, /* MBB */ 1, /* - */ 0, /* BBB */ 0,
+    /* MMB */ 3, /* - */ 0, /* MFB */ 1, /* - */ 0};
+static const uint8_t kISlots[16] = {
+    /* MII */ 6, /* MI_I */ 6, /* MLX */ 0, /* - */ 0,
+    /* MMI */ 4, /* M_MI */ 4, /* MFI */ 4, /* MMF */ 0,
+    /* MIB */ 2, /* MBB */ 0, /* - */ 0, /* BBB */ 0,
+    /* MMB */ 0, /* - */ 0, /* MFB */ 0, /* - */ 0};
+static const uint8_t kBSlots[16] = {
+    /* MII */ 0, /* MI_I */ 0, /* MLX */ 0, /* - */ 0,
+    /* MMI */ 0, /* M_MI */ 0, /* MFI */ 0, /* MMF */ 0,
+    /* MIB */ 4, /* MBB */ 6, /* - */ 0, /* BBB */ 7,
+    /* MMB */ 4, /* - */ 0, /* MFB */ 4, /* - */ 0};
+
+// Is slot |i| of |b| a chk.s on a GR (chk.s.i in an I slot, chk.s.m in an M
+// slot)?  Its register in |*r2|.
+inline bool IsCheckSlot(const Bundle* b, int i, uint32_t* r2 = nullptr) {
+  Insn s[3];
+  BundleSlots(b, s);
+  const uint32_t t = uint32_t((b->lo >> 1) & 0xf);
+  const uint32_t major = uint32_t((s[i] >> 37) & 0xf);
+  const bool chk = ((s[i] >> 33) & 7) == 1 &&
+                   ((((kISlots[t] >> i) & 1) && major == 0) ||
+                    (((kMSlots[t] >> i) & 1) && major == 1));
+  if (chk && r2) {
+    *r2 = uint32_t((s[i] >> 13) & 0x7f);
+  }
+  return chk;
+}
+
+// The slot of |b| holding the chk.s of register |r2|, or -1.  A bundle holds
+// at most one check per register: a second candidate writing it would need
+// a group between the two checks and a stop on each side of itself.
+inline int FindCheckSlot(const Bundle* b, uint32_t r2) {
+  for (int i = 0; i < 3; i++) {
+    uint32_t r;
+    if (IsCheckSlot(b, i, &r) && r == r2) {
+      return i;
+    }
+  }
+  return -1;
+}
+
+// Point the chk.s in slot |i| of |b| at |bundleDisp| bundles from |b|.
+inline void PatchCheckDisp(Bundle* b, int i, int64_t bundleDisp) {
+  MOZ_RELEASE_ASSERT(i >= 0 && IsCheckSlot(b, i));
+  MOZ_RELEASE_ASSERT(bundleDisp >= -(int64_t(1) << 20) &&
+                     bundleDisp < (int64_t(1) << 20));
+  const uint64_t d = uint64_t(bundleDisp);
+  Insn x[3];
+  BundleSlots(b, x);
+  // imm7a (6:12) = disp 6:0, imm13c (20:32) = disp 19:7, s (36) = disp 20
+  x[i] &= ~((Insn(0x7f) << 6) | (Insn(0x1fff) << 20) | (Insn(1) << 36));
+  x[i] |= (Insn(d & 0x7f) << 6) | (Insn((d >> 7) & 0x1fff) << 20) |
+          (Insn((d >> 20) & 1) << 36);
+  *b = MakeBundle(Template(b->lo & 0x1f), x[0], x[1], x[2]);
+}
+
+// M4 st8.spill [r3] = r2 (x6 0x3b): stores a NaT register without faulting,
+// its NaT bit going to ar.unat{bits 8:3 of the address}. Every register save
+// area uses it (MacroAssembler::PushRegsInMask(), the bailout thunk, the
+// pre-barrier trampoline): a register the code after a guard never reads
+// may hold the NaT of a load the scheduler moved above the guard as ld.s.
+// The restores are plain ld8: a live register is never an unchecked NaT
+// where registers are saved, so the NaT bits are not needed back, and
+// nested save areas cannot clobber each other's ar.unat bits.  ar.unat is
+// preserved for C++ by the JIT entries (EnterJIT, the wasm interp entry).
+// Scheduled like st8 (IsPlainAccess()): the hardware orders the ar.unat
+// bit writes against mov ar.unat itself (SDM 3:2.3, "impliedF").
+inline Op St8Spill(uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return StoreM4(0x3b, r3, r2, qp).fl(OpSched);
+}
+
+// M-type atomics and semaphores. The acquire/release loads and stores are
+// ordinary M1/M4 with a different x6a; the read-modify-write forms set x
+// (bit 27).
+inline Op Ld8Acq(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return LoadM1(0x17, r1, r3, qp);
+}
+inline Op Ld4Acq(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return LoadM1(0x16, r1, r3, qp);
+}
+inline Op St8Rel(uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return StoreM4(0x37, r3, r2, qp);
+}
+inline Op St4Rel(uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return StoreM4(0x36, r3, r2, qp);
+}
+
+// M29: mov ar = r2. Used to load ar.ccv (AR 32) with the compare value before
+// a cmpxchg -- the hardware compares against ar.ccv's *exact* bit pattern
+// (see [[ia64-llvm-cmpxchg-ccv-missing-zext]]: a real LLVM backend bug came
+// from feeding it a non-zero-extended comparand for a narrow cmpxchg), so
+// callers must zero-extend to the access width first.
+inline Op MovToAr(uint32_t x6b, uint32_t ar, uint32_t r2, uint32_t qp = 0) {
+  return MakeOp(
+             fOp(1) | fM(0) | (Insn(x6b & 0x3f) << 27) | fR3(ar) | fR2(r2) |
+                 fQp(qp),
+             UnitM)
+      .d(ResAr, ar, 20)
+      .u(ResGr, r2, 13)
+      .u(ResPr, qp, 0);
+}
+inline Op MovToArCcv(uint32_t r2, uint32_t qp = 0) {
+  return MovToAr(0x2a, 32, r2, qp);
+}
+
+// M31: mov r1 = ar3 (an M-unit AR: ar.ccv, ar.unat, ...).  x6 0x22.
+static const uint32_t ArUnat = 36;
+inline Op MovFromAr(uint32_t r1, uint32_t ar, uint32_t qp = 0) {
+  return MakeOp(fOp(1) | fM(0) | (Insn(0x22) << 27) | fR3(ar) | fR1(r1) |
+                    fQp(qp),
+                UnitM)
+      .d(ResGr, r1, 6)
+      .u(ResAr, ar)
+      .u(ResPr, qp, 0);
+}
+
+// M16: r1 = cmpxchg[r3], r2, ar.ccv -- the comparand comes from ar.ccv, which
+// the caller must have loaded beforehand.
+inline Op CmpxchgM16(uint32_t x6a, uint32_t r1, uint32_t r3, uint32_t r2,
+                       uint32_t qp = 0) {
+  return MakeOp(fOp(4) | fM(0) | fXm(1) | fX6a(x6a) | fHint(0) | fR3(r3) |
+                    fR2(r2) | fR1(r1) | fQp(qp),
+                UnitM)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r3, 20)
+      .u(ResGr, r2, 13)
+      .u(ResAr, ArCcv)
+      .u(ResPr, qp, 0)
+      .fl(OpMemory);
+}
+
+inline Op Cmpxchg8Acq(uint32_t r1, uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return CmpxchgM16(0x03, r1, r3, r2, qp);
+}
+inline Op Cmpxchg8Rel(uint32_t r1, uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return CmpxchgM16(0x07, r1, r3, r2, qp);
+}
+inline Op Cmpxchg4Acq(uint32_t r1, uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return CmpxchgM16(0x02, r1, r3, r2, qp);
+}
+inline Op Cmpxchg4Rel(uint32_t r1, uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return CmpxchgM16(0x06, r1, r3, r2, qp);
+}
+inline Op Xchg8(uint32_t r1, uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return CmpxchgM16(0x0b, r1, r3, r2, qp);
+}
+inline Op Xchg4(uint32_t r1, uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return CmpxchgM16(0x0a, r1, r3, r2, qp);
+}
+inline Op Xchg2(uint32_t r1, uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return CmpxchgM16(0x09, r1, r3, r2, qp);
+}
+inline Op Xchg1(uint32_t r1, uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return CmpxchgM16(0x08, r1, r3, r2, qp);
+}
+inline Op Cmpxchg2Acq(uint32_t r1, uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return CmpxchgM16(0x01, r1, r3, r2, qp);
+}
+inline Op Cmpxchg2Rel(uint32_t r1, uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return CmpxchgM16(0x05, r1, r3, r2, qp);
+}
+inline Op Cmpxchg1Acq(uint32_t r1, uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return CmpxchgM16(0x00, r1, r3, r2, qp);
+}
+inline Op Cmpxchg1Rel(uint32_t r1, uint32_t r3, uint32_t r2, uint32_t qp = 0) {
+  return CmpxchgM16(0x04, r1, r3, r2, qp);
+}
+
+// M17: fetchadd. The increment is not a plain immediate: bits 14:13 select a
+// magnitude from {16, 8, 4, 1} and bit 15 is the sign. Derived from GNU as by
+// assembling every legal increment.
+inline Insn fInc3(int32_t inc) {
+  uint32_t mag = uint32_t(inc < 0 ? -inc : inc);
+  uint32_t code = mag == 16 ? 0 : mag == 8 ? 1 : mag == 4 ? 2 : 3;
+  return (Insn(code) << 13) | (Insn(inc < 0 ? 1 : 0) << 15);
+}
+
+inline Op FetchaddM17(uint32_t x6a, uint32_t r1, uint32_t r3, int32_t inc,
+                        uint32_t qp = 0) {
+  return MakeOp(fOp(4) | fM(0) | fXm(1) | fX6a(x6a) | fHint(0) | fR3(r3) |
+                    fInc3(inc) | fR1(r1) | fQp(qp),
+                UnitM)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpMemory);
+}
+
+inline Op Fetchadd8Acq(uint32_t r1, uint32_t r3, int32_t inc,
+                         uint32_t qp = 0) {
+  return FetchaddM17(0x13, r1, r3, inc, qp);
+}
+inline Op Fetchadd8Rel(uint32_t r1, uint32_t r3, int32_t inc,
+                         uint32_t qp = 0) {
+  return FetchaddM17(0x17, r1, r3, inc, qp);
+}
+inline Op Fetchadd4Acq(uint32_t r1, uint32_t r3, int32_t inc,
+                         uint32_t qp = 0) {
+  return FetchaddM17(0x12, r1, r3, inc, qp);
+}
+inline Op Fetchadd4Rel(uint32_t r1, uint32_t r3, int32_t inc,
+                         uint32_t qp = 0) {
+  return FetchaddM17(0x16, r1, r3, inc, qp);
+}
+
+// M18/M19: move between a general register and a floating-point register.
+// getf is major op 4, setf major op 6; both set x (bit 27).
+inline Op GetfM19(uint32_t x6a, uint32_t r1, uint32_t f2, uint32_t qp = 0) {
+  return MakeOp(fOp(4) | fM(0) | fXm(1) | fX6a(x6a) | fR1(r1) |
+                    (Insn(f2 & 0x7f) << 13) | fQp(qp),
+                UnitM)
+      .d(ResGr, r1, 6)
+      .u(ResFr, f2, 13)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+inline Op SetfM18(uint32_t x6a, uint32_t f1, uint32_t r2, uint32_t qp = 0) {
+  return MakeOp(fOp(6) | fM(0) | fXm(1) | fX6a(x6a) | (Insn(f1 & 0x7f) << 6) |
+                    fR2(r2) | fQp(qp),
+                UnitM)
+      .d(ResFr, f1, 6)
+      .u(ResGr, r2, 13)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+
+inline Op GetfSig(uint32_t r1, uint32_t f2, uint32_t qp = 0) {
+  return GetfM19(0x1c, r1, f2, qp);
+}
+inline Op GetfExp(uint32_t r1, uint32_t f2, uint32_t qp = 0) {
+  return GetfM19(0x1d, r1, f2, qp);
+}
+inline Op GetfS(uint32_t r1, uint32_t f2, uint32_t qp = 0) {
+  return GetfM19(0x1e, r1, f2, qp);
+}
+inline Op GetfD(uint32_t r1, uint32_t f2, uint32_t qp = 0) {
+  return GetfM19(0x1f, r1, f2, qp);
+}
+inline Op SetfSig(uint32_t f1, uint32_t r2, uint32_t qp = 0) {
+  return SetfM18(0x1c, f1, r2, qp);
+}
+inline Op SetfExp(uint32_t f1, uint32_t r2, uint32_t qp = 0) {
+  return SetfM18(0x1d, f1, r2, qp);
+}
+inline Op SetfS(uint32_t f1, uint32_t r2, uint32_t qp = 0) {
+  return SetfM18(0x1e, f1, r2, qp);
+}
+inline Op SetfD(uint32_t f1, uint32_t r2, uint32_t qp = 0) {
+  return SetfM18(0x1f, f1, r2, qp);
+}
+
+// ---------------------------------------------------------------------------
+// M34: alloc r1 = ar.pfs, ins, locals, outs, rot
+//
+// Establishes this procedure's register-stack frame and saves the previous
+// frame marker into r1. Every JIT entry uses
+//     alloc rN = ar.pfs, 0, 0, kFrameOuts, 0
+// to obtain out0-out7 (r32-r39) for calling C functions and the rename pool.
+//
+// Field layout derived from GNU as by varying each operand:
+//   sof = ins + locals + outs -> bits 19:13
+//   sol = ins + locals        -> bits 26:20
+//   sor = rot / 8             -> bits 30:27
+//   op = 1, x3 = 6 (bits 35:33), r1 -> bits 12:6
+// alloc cannot be predicated, so qp is always 0.
+// ---------------------------------------------------------------------------
+
+inline Insn fX3(uint32_t x) { return Insn(x & 0x7) << 33; }
+
+inline Op Alloc(uint32_t r1, uint32_t ins, uint32_t locals, uint32_t outs,
+                  uint32_t rot = 0) {
+  uint32_t sof = ins + locals + outs;
+  uint32_t sol = ins + locals;
+  uint32_t sor = rot / 8;
+  return MakeOp(fOp(1) | fX3(6) | (Insn(sor & 0xf) << 27) |
+                    (Insn(sol & 0x7f) << 20) | (Insn(sof & 0x7f) << 13) |
+                    fR1(r1),
+                UnitM)
+      .d(ResGr, r1, 6)
+      .d(ResCfm, 0)
+      .u(ResAr, ArPfs)
+      .fl(OpAlloc);
+}
+
+// ---------------------------------------------------------------------------
+// B-type (branch) instructions.
+//   btype -> bits 8:6     pa  -> bit 12      b1 -> bits 8:6
+//   b2    -> bits 15:13   wha -> bits 34:33  whc -> bits 34:32
+//   x6    -> bits 32:27   d   -> bit 35
+// ---------------------------------------------------------------------------
+
+inline Insn fBtype(uint32_t x) { return Insn(x & 0x7) << 6; }
+inline Insn fB1(uint32_t x) { return Insn(x & 0x7) << 6; }
+inline Insn fB2(uint32_t x) { return Insn(x & 0x7) << 13; }
+inline Insn fPa(uint32_t x) { return Insn(x & 0x1) << 12; }
+inline Insn fWha(uint32_t x) { return Insn(x & 0x3) << 33; }
+inline Insn fWhc(uint32_t x) { return Insn(x & 0x7) << 32; }
+inline Insn fD(uint32_t x) { return Insn(x & 0x1) << 35; }
+inline Insn fX6b(uint32_t x) { return Insn(x & 0x3f) << 27; }
+
+// B4: br.cond.sptk b2 -- indirect branch through a branch register.
+inline Op BrCond(uint32_t b2, uint32_t qp = 0) {
+  return MakeOp(fOp(0) | fX6b(0x20) | fBtype(0) | fPa(0) | fWha(0) | fD(0) |
+                    fB2(b2) | fQp(qp),
+                UnitB)
+      .u(ResBr, b2, 13)
+      .u(ResPr, qp, 0)
+      .fl(OpBranch);
+}
+
+// B4: br.ret.sptk.many b2
+inline Op BrRet(uint32_t b2, uint32_t qp = 0) {
+  return MakeOp(fOp(0) | fX6b(0x21) | fBtype(4) | fPa(1) | fWha(0) | fD(0) |
+                    fB2(b2) | fQp(qp),
+                UnitB)
+      .d(ResCfm, 0)
+      .u(ResBr, b2, 13)
+      .u(ResAr, ArPfs)
+      .u(ResPr, qp, 0)
+      .fl(OpBranch);
+}
+
+// B5: br.call.sptk.many b1 = b2 -- indirect call, return address into b1.
+inline Op BrCall(uint32_t b1, uint32_t b2, uint32_t qp = 0) {
+  return MakeOp(
+             fOp(1) | fPa(1) | fWhc(1) | fD(0) | fB1(b1) | fB2(b2) | fQp(qp),
+             UnitB)
+      .d(ResBr, b1, 6)
+      .d(ResAr, ArPfs)
+      .d(ResCfm, 0)
+      .u(ResBr, b2, 13)
+      .u(ResPr, qp, 0)
+      .fl(OpBranch);
+}
+
+// IP-relative displacements (TGT25c) are measured in whole 16-byte bundles and
+// encoded as a signed 21-bit value: imm20 in bits 32:13 and the sign in bit 36.
+// That gives +/-2^20 bundles, i.e. +/-16 MiB. Layout confirmed against GNU as by
+// assembling branches over varying distances in both directions.
+//
+// This short form is used by toggledJump() and by backward branches to a bound
+// Label, whose displacement is known at emit time and can be range-checked
+// there. Anything still pending -- a forward branch, which stores a chain link
+// in this field until bind() -- must use the long form (BrlCondRel/BrlCallRel
+// below), whose 60-bit displacement cannot overflow. See the long-branch
+// section for why, and BranchForm for the choice.
+static const int32_t MaxBranchBundleDisp = (1 << 20) - 1;
+static const int32_t MinBranchBundleDisp = -(1 << 20);
+
+inline bool BranchDispInRange(int32_t bundleDisp) {
+  return bundleDisp >= MinBranchBundleDisp && bundleDisp <= MaxBranchBundleDisp;
+}
+
+inline Insn fTgt25c(int32_t bundleDisp) {
+  uint32_t u = uint32_t(bundleDisp);
+  return (Insn(u & 0xfffff) << 13) | (Insn((u >> 20) & 0x1) << 36);
+}
+
+// The whether-hint completer of an IP-relative conditional branch (B1, X3):
+// the wh field, bits 34:33 of the branch slot (checked against GNU as).
+//
+// Measured on Montecito with tools/ia64-branch-probe (see
+// wiki/hw-branches.html): while the predictor holds state for a branch,
+// every hint learns a biased branch's direction, and only the dynamic hints
+// learn patterns (alternating, 3-of-4). Once that state is gone -- code far
+// beyond the predictor's reach, which a JIT heap is -- the hint *is* the
+// prediction: a wrong static hint mispredicts ~98% of the time, a wrong
+// dynamic one ~50%, a right one never.
+enum class BranchHint : uint32_t { Sptk = 0, Spnt = 1, Dptk = 2, Dpnt = 3 };
+
+// B1: br.cond.<hint> <ip-relative target>
+inline Op BrCondRel(int32_t bundleDisp, uint32_t qp = 0,
+                    BranchHint hint = BranchHint::Sptk) {
+  return MakeOp(fOp(4) | fBtype(0) | fPa(0) | fWha(uint32_t(hint)) | fD(0) |
+                    fTgt25c(bundleDisp) | fQp(qp),
+                UnitB)
+      .u(ResPr, qp, 0)
+      .fl(OpBranch);
+}
+
+// ---- Encoders of the software pipeliner's kernels (Pipeliner-ia64.h) ------
+// The kernel names registers beyond Ion's r0-r39 and fields no other code
+// writes by hand, so each of these used to be a literal in the pipeliner.
+// tools/encoder-test.cpp compares them with the literals they replaced.
+
+// |bits| with the |width| bits at |pos| set to |v|.
+inline Insn WithField(Insn bits, int pos, int width, uint32_t v) {
+  const Insn mask = (Insn(1) << width) - 1;
+  return (bits & ~(mask << pos)) | ((Insn(v) & mask) << pos);
+}
+
+// I28: mov r1 = ar3 (an I-unit AR: ar.lc, ar.ec, ar.itc, ...).
+inline Op MovFromArI(uint32_t r1, uint32_t ar, uint32_t qp = 0) {
+  return MakeOp((Insn(0x32) << 27) | (Insn(ar) << 20) | (Insn(r1) << 6) |
+                    Insn(qp & 0x3f),
+                UnitI)
+      .d(ResGr, r1, 6)
+      .u(ResAr, ar)
+      .u(ResPr, qp, 0);
+}
+// I26: mov ar3 = r2.
+inline Op MovToArI(uint32_t ar, uint32_t r2, uint32_t qp = 0) {
+  return MakeOp((Insn(0x2a) << 27) | (Insn(ar) << 20) | (Insn(r2) << 13) |
+                    Insn(qp & 0x3f),
+                UnitI)
+      .d(ResAr, ar, 20)
+      .u(ResGr, r2, 13)
+      .u(ResPr, qp, 0);
+}
+// I27: mov ar3 = imm8.
+inline Op MovToArImm(uint32_t ar, int imm, uint32_t qp = 0) {
+  return MakeOp((Insn(0x0a) << 27) | (Insn(ar) << 20) | (Insn(imm & 0x7f) << 13) |
+                    (Insn(imm < 0) << 36) | Insn(qp & 0x3f),
+                UnitI)
+      .d(ResAr, ar, 20)
+      .u(ResPr, qp, 0);
+}
+// I25: mov r1 = pr.
+inline Op MovFromPr(uint32_t r1) {
+  return MakeOp((Insn(0x001980000c0) & ~(Insn(0x7f) << 6)) | (Insn(r1) << 6),
+                UnitI)
+      .d(ResGr, r1, 6);
+}
+// I23: mov pr = r2, mask17: every predicate, or all but p15 (|keepP15|).
+// (mask17: bits 1-7 in mask7a (6-12), 8-15 in mask8c (24-31), 16 in s.)
+inline Op MovToPr(uint32_t r2, bool keepP15 = false) {
+  Insn b = Insn(0x016ff001fc0) | (Insn(r2) << 13);
+  if (keepP15) {
+    b &= ~(Insn(1) << (24 + 15 - 8));
+  }
+  return MakeOp(b, UnitI).u(ResGr, r2, 13);
+}
+// B8: clrrrb (clear the register rename bases).
+inline Op Clrrrb() { return MakeOp(Insn(0x00020000000), UnitB); }
+// M22/M23: chk.a.clr r1/f1, target (|disp| in bundles).
+inline Op ChkA(bool fp, uint32_t reg, uint32_t qp, int64_t disp) {
+  const uint64_t d = uint64_t(disp);
+  return MakeOp((Insn(fp ? 7 : 5) << 33) | (Insn((d >> 20) & 1) << 36) |
+                    (Insn(d & 0xfffff) << 13) | (Insn(reg & 0x7f) << 6) |
+                    Insn(qp & 0x3f),
+                UnitM)
+      .u(ResPr, qp, 0)
+      .fl(OpBranch);
+}
+// M20/M21: chk.s.m r2 / chk.s f2, target (|disp| in bundles).
+inline Op ChkSDisp(bool fp, uint32_t reg, uint32_t qp, int64_t disp) {
+  const uint64_t d = uint64_t(disp);
+  return MakeOp((Insn(1) << 37) | (Insn(fp ? 3 : 1) << 33) |
+                    (Insn((d >> 20) & 1) << 36) | (Insn((d >> 7) & 0x1fff) << 20) |
+                    (Insn(reg & 0x7f) << 13) | (Insn(d & 0x7f) << 6) |
+                    Insn(qp & 0x3f),
+                UnitM)
+      .u(ResPr, qp, 0)
+      .fl(OpBranch);
+}
+// B1 with another branch type: 0 cond, 7 ctop (the kernel's loop branch).
+inline Op BrRelType(int64_t bundleDisp, uint32_t qp, uint32_t btype,
+                    BranchHint hint) {
+  Op op = BrCondRel(int32_t(bundleDisp), qp, hint);
+  op.bits = WithField(op.bits, 6, 3, btype);
+  return op;
+}
+// M31: mov r1 = ar.itc (ar 44), for JS_IA64_PIPE_ITC.
+inline Op MovFromItc(uint32_t r1) { return MovFromAr(r1, 44); }
+
+// B3: br.call.sptk.many b1 = <ip-relative target>
+inline Op BrCallRel(uint32_t b1, int32_t bundleDisp, uint32_t qp = 0) {
+  return MakeOp(fOp(5) | fPa(1) | fWha(0) | fD(0) | fB1(b1) |
+                    fTgt25c(bundleDisp) | fQp(qp),
+                UnitB)
+      .d(ResBr, b1, 6)
+      .d(ResAr, ArPfs)
+      .d(ResCfm, 0)
+      .u(ResPr, qp, 0)
+      .fl(OpBranch);
+}
+
+// The b0 forms, as plain function pointers for BranchForm below.
+// A call is always taken: the hint is accepted for BranchForm and ignored.
+inline Op BrCallRelB0(int32_t bundleDisp, uint32_t qp,
+                      BranchHint = BranchHint::Sptk) {
+  return BrCallRel(0, bundleDisp, qp);
+}
+
+// B9: break.b. Major opcode 0; the 21-bit immediate is spread the same way
+// as the M/I/F/B nops below (low 20 bits at 25:6, top bit at 36).
+inline Op BreakB(uint32_t imm21, uint32_t qp = 0) {
+  return MakeOp(fOp(0) | (Insn(imm21 & 0xfffff) << 6) |
+                    (Insn((imm21 >> 20) & 1) << 36) | fQp(qp),
+                UnitB)
+      .u(ResPr, qp, 0)
+      .fl(OpBranch | OpEndsGroup);
+}
+
+// Rewrite the IP-relative displacement of a short branch already emitted into
+// slot 2 of |b|, leaving every other field alone. PatchBranchDisp() below
+// dispatches here for B-unit bundles.
+inline void PatchShortBranchDisp(Bundle* b, int64_t disp) {
+  // A displacement -- or, for a still-unbound branch, a chain link -- too wide
+  // for the 21-bit field would be silently truncated and read back as a bogus
+  // negative offset, which is exactly what sends bind() walking off the end of
+  // the buffer. Only toggledJump() reaches this path and its jumps are short,
+  // so make a violation a crash rather than a hang. Checked before narrowing,
+  // so an out-of-range value cannot slip through the cast.
+  MOZ_RELEASE_ASSERT(disp >= MinBranchBundleDisp && disp <= MaxBranchBundleDisp);
+  int32_t bundleDisp = int32_t(disp);
+  const uint64_t kSlotMask = (uint64_t(1) << 41) - 1;
+  // slot 2 occupies bundle bits 127:87, i.e. hi bits 63:23.
+  Insn slot2 = (b->hi >> 23) & kSlotMask;
+  Insn clearMask = (Insn(0xfffff) << 13) | (Insn(1) << 36);
+  slot2 = (slot2 & ~clearMask) | fTgt25c(bundleDisp);
+  b->hi = (b->hi & ((uint64_t(1) << 23) - 1)) | (slot2 << 23);
+}
+
+// Toggle a lone B-slot bundle (BundleB) between a real branch/call (op 4/5)
+// and a nop (op 2), in place, without disturbing anything else in the slot
+// -- op sits in the same 4 high bits (37:40) for all three, well clear of
+// the tgt25c/imm21 payload and qp, so flipping just those bits round-trips
+// cleanly and preserves whatever displacement a br.cond/br.call form had.
+inline void ToggleSlot2Op(Bundle* b, uint32_t op) {
+  const uint64_t kSlotMask = (uint64_t(1) << 41) - 1;
+  Insn slot2 = (b->hi >> 23) & kSlotMask;
+  slot2 = (slot2 & ~(Insn(0xf) << 37)) | fOp(op);
+  b->hi = (b->hi & ((uint64_t(1) << 23) - 1)) | (slot2 << 23);
+}
+
+// ---------------------------------------------------------------------------
+// Moves to and from branch registers and ar.pfs. An indirect call needs its
+// target in a branch register, and a JIT frame must save/restore b0 (the return
+// pointer) and ar.pfs (the previous frame marker written by alloc).
+//
+// The binutils macros for these overlap ambiguously (tag13 and x3 both claim
+// bit 33), so the base patterns below were taken from GNU as directly and the
+// operand field positions confirmed by varying each operand:
+//   mov bN = rM      b -> bits 8:6    r2 -> bits 19:13
+//   mov rN = bM      r1 -> bits 12:6  b2 -> bits 15:13
+//   mov rN = ar.pfs  r1 -> bits 12:6
+//   mov ar.pfs = rN  r2 -> bits 19:13
+// ---------------------------------------------------------------------------
+
+inline Insn fBr(uint32_t x) { return Insn(x & 0x7) << 6; }
+
+// mov b1 = r2
+inline Op MovToBr(uint32_t b1, uint32_t r2, uint32_t qp = 0) {
+  return MakeOp(Insn(0x0e00100000ull) | fBr(b1) | fR2(r2) | fQp(qp), UnitI)
+      .d(ResBr, b1)
+      .u(ResGr, r2, 13)
+      .u(ResPr, qp, 0);
+}
+
+// mov r1 = b2
+inline Op MovFromBr(uint32_t r1, uint32_t b2, uint32_t qp = 0) {
+  return MakeOp(
+             Insn(0x0188000000ull) | fR1(r1) | (Insn(b2 & 0x7) << 13) | fQp(qp),
+             UnitI)
+      .d(ResGr, r1, 6)
+      .u(ResBr, b2)
+      .u(ResPr, qp, 0);
+}
+
+// mov r1 = ar.pfs
+inline Op MovFromPfs(uint32_t r1, uint32_t qp = 0) {
+  return MakeOp(Insn(0x0194000000ull) | fR1(r1) | fQp(qp), UnitI)
+      .d(ResGr, r1, 6)
+      .u(ResAr, ArPfs)
+      .u(ResPr, qp, 0);
+}
+
+// mov ar.pfs = r2
+inline Op MovToPfs(uint32_t r2, uint32_t qp = 0) {
+  return MakeOp(Insn(0x0154000000ull) | fR2(r2) | fQp(qp), UnitI)
+      .d(ResAr, ArPfs)
+      .u(ResGr, r2, 13)
+      .u(ResPr, qp, 0);
+}
+
+// ---------------------------------------------------------------------------
+// I-type shifts, extracts and deposits.
+//
+// The register-variable shifts (I5/I7, major opcode 7) are the multimedia
+// shift group restricted to a full 64-bit element by za/zb:
+//   za -> bit 36   zb -> bit 33   ve -> bit 32
+//   x2a -> 35:34   x2c -> 31:30   x2b -> 29:28
+// Note the I-unit ve and x2b sit at different positions than the A-unit ones.
+//
+// The immediate forms (I11/I12, major opcode 5) are really extr/dep.z:
+//   shr  r1 = r3, n  ==  extr   r1 = r3, n, 64-n
+//   shl  r1 = r2, n  ==  dep.z  r1 = r2, n, 64-n
+//   x2 -> 35:34   x -> bit 33   ya -> bit 13   yb -> bit 26
+//   pos6 -> 19:14   len6 -> 32:27 (len - 1)   cpos6a -> 25:20 (63 - pos)
+// ---------------------------------------------------------------------------
+
+inline Insn fZa(uint32_t x) { return Insn(x & 0x1) << 36; }
+inline Insn fZb(uint32_t x) { return Insn(x & 0x1) << 33; }
+inline Insn fVeI(uint32_t x) { return Insn(x & 0x1) << 32; }
+inline Insn fX2bI(uint32_t x) { return Insn(x & 0x3) << 28; }
+inline Insn fX2c(uint32_t x) { return Insn(x & 0x3) << 30; }
+inline Insn fXi(uint32_t x) { return Insn(x & 0x1) << 33; }
+inline Insn fYa(uint32_t x) { return Insn(x & 0x1) << 13; }
+inline Insn fYb(uint32_t x) { return Insn(x & 0x1) << 26; }
+inline Insn fPos6(uint32_t x) { return Insn(x & 0x3f) << 14; }
+inline Insn fLen6(uint32_t len) { return Insn((len - 1) & 0x3f) << 27; }
+inline Insn fCpos6a(uint32_t x) { return Insn((63 - x) & 0x3f) << 20; }
+
+inline Op ShiftVar(uint32_t x2b, uint32_t x2c, uint32_t r1, uint32_t r2,
+                     uint32_t r3, uint32_t qp = 0) {
+  return MakeOp(fOp(7) | fZa(1) | fZb(1) | fVeI(0) | fX2a(0) | fX2c(x2c) |
+                    fX2bI(x2b) | fR3(r3) | fR2(r2) | fR1(r1) | fQp(qp),
+                UnitI)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r2, 13)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+
+// shl r1 = value, count -- the count is r3 here, but r2 for the shift-rights.
+inline Op Shl(uint32_t r1, uint32_t value, uint32_t count, uint32_t qp = 0) {
+  return ShiftVar(0, 1, r1, value, count, qp);
+}
+inline Op Shr(uint32_t r1, uint32_t value, uint32_t count, uint32_t qp = 0) {
+  return ShiftVar(2, 0, r1, count, value, qp);
+}
+inline Op ShrU(uint32_t r1, uint32_t value, uint32_t count, uint32_t qp = 0) {
+  return ShiftVar(0, 0, r1, count, value, qp);
+}
+
+// I11: extr / extr.u r1 = r3, pos, len
+inline Op Extr(uint32_t r1, uint32_t r3, uint32_t pos, uint32_t len,
+                 uint32_t qp = 0) {
+  return MakeOp(fOp(5) | fX2(1) | fXi(0) | fYa(1) | fLen6(len) | fR3(r3) |
+                    fPos6(pos) | fR1(r1) | fQp(qp),
+                UnitI)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+inline Op ExtrU(uint32_t r1, uint32_t r3, uint32_t pos, uint32_t len,
+                  uint32_t qp = 0) {
+  return MakeOp(fOp(5) | fX2(1) | fXi(0) | fYa(0) | fLen6(len) | fR3(r3) |
+                    fPos6(pos) | fR1(r1) | fQp(qp),
+                UnitI)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+
+// I12: dep.z r1 = r2, pos, len
+inline Op DepZ(uint32_t r1, uint32_t r2, uint32_t pos, uint32_t len,
+                 uint32_t qp = 0) {
+  return MakeOp(fOp(5) | fX2(1) | fXi(1) | fYb(0) | fLen6(len) | fCpos6a(pos) |
+                    fR2(r2) | fR1(r1) | fQp(qp),
+                UnitI)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r2, 13)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+
+inline Op ShlImm(uint32_t r1, uint32_t r2, uint32_t count, uint32_t qp = 0) {
+  return DepZ(r1, r2, count, 64 - count, qp);
+}
+inline Op ShrImm(uint32_t r1, uint32_t r3, uint32_t count, uint32_t qp = 0) {
+  return Extr(r1, r3, count, 64 - count, qp);
+}
+inline Op ShrUImm(uint32_t r1, uint32_t r3, uint32_t count, uint32_t qp = 0) {
+  return ExtrU(r1, r3, count, 64 - count, qp);
+}
+
+// I29: sign/zero extend. Major opcode 0, x3 = 0, x6 selects the width.
+inline Op ExtendI29(uint32_t x6, uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return MakeOp(fOp(0) | fX3(0) | fX6b(x6) | fR3(r3) | fR1(r1) | fQp(qp),
+                UnitI)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+
+inline Op Zxt1(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return ExtendI29(0x10, r1, r3, qp);
+}
+inline Op Zxt2(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return ExtendI29(0x11, r1, r3, qp);
+}
+inline Op Zxt4(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return ExtendI29(0x12, r1, r3, qp);
+}
+inline Op Sxt1(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return ExtendI29(0x14, r1, r3, qp);
+}
+inline Op Sxt2(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return ExtendI29(0x15, r1, r3, qp);
+}
+inline Op Sxt4(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return ExtendI29(0x16, r1, r3, qp);
+}
+
+// What an instruction leaves in its general-register result, for the
+// assembler's tracking of canonical int32 values (sign-extended from bit 31),
+// which lets it drop an sxt4 of a register that already holds one.
+enum class Canon32 {
+  Unknown,  // anything not listed: the result is not known to be canonical
+  Yes,      // always canonical: sxt1/2/4, zxt1/2, ld1/ld2, extr len <= 32,
+            // extr.u len <= 31
+  Inherit,  // canonical if *src is: mov (adds r1 = 0, r3), shr by an immediate
+  Sxt4,     // sxt4 r1 = *src
+};
+
+inline Canon32 ClassifyCanon32(const Op& op, uint32_t* src) {
+  const Insn R1 = Insn(0x7f) << 6, R3 = Insn(0x7f) << 20, QP = 0x3f;
+  const Insn POS = Insn(0x3f) << 14, LEN = Insn(0x3f) << 27, HINT = Insn(3) << 28;
+  *src = uint32_t((op.bits >> 20) & 0x7f);
+  auto is = [&](const Op& t, Insn ignore) {
+    return op.unit == t.unit && (op.bits & ~ignore) == (t.bits & ~ignore);
+  };
+  if (is(Sxt4(0, 0), R1 | R3 | QP)) {
+    return Canon32::Sxt4;
+  }
+  if (is(Sxt1(0, 0), R1 | R3 | QP) || is(Sxt2(0, 0), R1 | R3 | QP) ||
+      is(Zxt1(0, 0), R1 | R3 | QP) || is(Zxt2(0, 0), R1 | R3 | QP) ||
+      is(Ld1(0, 0), R1 | R3 | QP | HINT) || is(Ld2(0, 0), R1 | R3 | QP | HINT)) {
+    return Canon32::Yes;
+  }
+  if (is(MovReg(0, 0), R1 | R3 | QP)) {
+    return Canon32::Inherit;
+  }
+  uint32_t pos = uint32_t((op.bits >> 14) & 0x3f);
+  uint32_t len = uint32_t((op.bits >> 27) & 0x3f) + 1;
+  if (is(Extr(0, 0, 0, 1), R1 | R3 | QP | POS | LEN)) {
+    if (len <= 32) {
+      return Canon32::Yes;
+    }
+    // shr by an immediate (pos + len == 64) keeps a canonical value canonical
+    return pos + len == 64 ? Canon32::Inherit : Canon32::Unknown;
+  }
+  if (is(ExtrU(0, 0, 0, 1), R1 | R3 | QP | POS | LEN) && len <= 31) {
+    return Canon32::Yes;
+  }
+  return Canon32::Unknown;
+}
+
+// I29: czx (count trailing/leading zero bytes), same shape as sxt/zxt.
+inline Op Czx1L(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return ExtendI29(0x18, r1, r3, qp);
+}
+inline Op Czx2L(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return ExtendI29(0x19, r1, r3, qp);
+}
+inline Op Czx1R(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return ExtendI29(0x1c, r1, r3, qp);
+}
+inline Op Czx2R(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return ExtendI29(0x1d, r1, r3, qp);
+}
+
+// I3: mux1. Shares the za/zb/ve/x2a/x2b/x2c field layout with ShiftVar/pmin2
+// et al (major opcode 7), but with a different fixed field combination and a
+// third register operand carrying the permute-type immediate (MBTYPE4)
+// instead of a register.
+inline Op Mux1(uint32_t r1, uint32_t r2, uint32_t mbtype4, uint32_t qp = 0) {
+  return MakeOp(fOp(7) | fZa(0) | fZb(0) | fVeI(0) | fX2a(3) | fX2bI(2) |
+                    fX2c(2) | fR3(mbtype4) | fR2(r2) | fR1(r1) | fQp(qp),
+                UnitI)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r2, 13)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+static const uint32_t kMux1Rev = 0xb;
+
+// I9: popcnt.
+inline Op Popcnt(uint32_t r1, uint32_t r3, uint32_t qp = 0) {
+  return MakeOp(fOp(7) | fZa(0) | fZb(1) | fVeI(0) | fX2a(1) | fX2bI(1) |
+                    fX2c(2) | fR3(r3) | fR1(r1) | fQp(qp),
+                UnitI)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+
+// I10: shrp. Major opcode 5, x2 (bits 35:34) = 3, x (bit 33) = 0; the shift
+// count reuses the 6-bit field at 32:27 that fX6b already models.
+inline Op Shrp(uint32_t r1, uint32_t r2, uint32_t r3, uint32_t count,
+                 uint32_t qp = 0) {
+  return MakeOp(
+             fOp(5) | fX2(3) | fX6b(count) | fR3(r3) | fR2(r2) | fR1(r1) |
+                 fQp(qp),
+             UnitI)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r2, 13)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+
+// ---------------------------------------------------------------------------
+// F-type (floating point).
+//
+// IA-64 has no plain fadd/fmul: everything is the fused multiply-add
+//   fma.pc.sf f1 = f3, f4, f2   ->   f1 = f3 * f4 + f2
+// with f0 (0.0) and f1 (1.0) used as identity operands. fadd is fma with
+// f4 = 1, fmpy is fma with f2 = 0, and fnorm is fma with f4 = 1, f2 = 0.
+//
+//   f1 -> 12:6   f2 -> 19:13   f3 -> 26:20   f4 -> 33:27
+//   sf -> 35:34  x (opcode extension) -> bit 36
+//
+// The .d suffix rounds to IEEE double, which is what the JS engine wants;
+// the unsuffixed form keeps the 82-bit register format.
+// ---------------------------------------------------------------------------
+
+inline Insn fF1(uint32_t x) { return Insn(x & 0x7f) << 6; }
+inline Insn fF2(uint32_t x) { return Insn(x & 0x7f) << 13; }
+inline Insn fF3(uint32_t x) { return Insn(x & 0x7f) << 20; }
+inline Insn fF4(uint32_t x) { return Insn(x & 0x7f) << 27; }
+inline Insn fSf(uint32_t x) { return Insn(x & 0x3) << 34; }
+inline Insn fXa(uint32_t x) { return Insn(x & 0x1) << 36; }
+
+// Status field: sf0 is the architected default the JIT uses throughout.
+enum FpSf : uint32_t { sf0 = 0, sf1 = 1, sf2 = 2, sf3 = 3 };
+
+// F1: f1 = f3 * f4 (+/-) f2
+inline Op FmaF1(uint32_t op, uint32_t xa, uint32_t f1, uint32_t f3,
+                  uint32_t f4, uint32_t f2, uint32_t sf, uint32_t qp) {
+  return MakeOp(fOp(op) | fXa(xa) | fSf(sf) | fF4(f4) | fF3(f3) | fF2(f2) |
+                    fF1(f1) | fQp(qp),
+                UnitF)
+      .d(ResFr, f1, 6)
+      .u(ResFr, f3, 20)
+      .u(ResFr, f4, 27)
+      .u(ResFr, f2, 13)
+      .u(ResPr, qp, 0)
+      .fl(OpFpu)
+      .fl(OpSched);
+}
+
+inline Op Fma(uint32_t f1, uint32_t f3, uint32_t f4, uint32_t f2,
+                uint32_t sf = sf0, uint32_t qp = 0) {
+  return FmaF1(0x8, 0, f1, f3, f4, f2, sf, qp);
+}
+inline Op FmaS(uint32_t f1, uint32_t f3, uint32_t f4, uint32_t f2,
+                 uint32_t sf = sf0, uint32_t qp = 0) {
+  return FmaF1(0x8, 1, f1, f3, f4, f2, sf, qp);
+}
+inline Op FmaD(uint32_t f1, uint32_t f3, uint32_t f4, uint32_t f2,
+                 uint32_t sf = sf0, uint32_t qp = 0) {
+  return FmaF1(0x9, 0, f1, f3, f4, f2, sf, qp);
+}
+inline Op Fms(uint32_t f1, uint32_t f3, uint32_t f4, uint32_t f2,
+                uint32_t sf = sf0, uint32_t qp = 0) {
+  return FmaF1(0xa, 0, f1, f3, f4, f2, sf, qp);
+}
+inline Op FmsS(uint32_t f1, uint32_t f3, uint32_t f4, uint32_t f2,
+                 uint32_t sf = sf0, uint32_t qp = 0) {
+  return FmaF1(0xa, 1, f1, f3, f4, f2, sf, qp);
+}
+inline Op FmsD(uint32_t f1, uint32_t f3, uint32_t f4, uint32_t f2,
+                 uint32_t sf = sf0, uint32_t qp = 0) {
+  return FmaF1(0xb, 0, f1, f3, f4, f2, sf, qp);
+}
+inline Op Fnma(uint32_t f1, uint32_t f3, uint32_t f4, uint32_t f2,
+                 uint32_t sf = sf0, uint32_t qp = 0) {
+  return FmaF1(0xc, 0, f1, f3, f4, f2, sf, qp);
+}
+inline Op FnmaS(uint32_t f1, uint32_t f3, uint32_t f4, uint32_t f2,
+                  uint32_t sf = sf0, uint32_t qp = 0) {
+  return FmaF1(0xc, 1, f1, f3, f4, f2, sf, qp);
+}
+inline Op FnmaD(uint32_t f1, uint32_t f3, uint32_t f4, uint32_t f2,
+                  uint32_t sf = sf0, uint32_t qp = 0) {
+  return FmaF1(0xd, 0, f1, f3, f4, f2, sf, qp);
+}
+
+// Register f0 reads as +0.0 and f1 as +1.0, which is what makes the pseudo-ops
+// below assemble to a bare fma.
+static const uint32_t fpZero = 0;
+static const uint32_t fpOne = 1;
+
+inline Op FaddD(uint32_t f1, uint32_t f3, uint32_t f2, uint32_t sf = sf0,
+                  uint32_t qp = 0) {
+  return FmaD(f1, f3, fpOne, f2, sf, qp);
+}
+inline Op FsubD(uint32_t f1, uint32_t f3, uint32_t f2, uint32_t sf = sf0,
+                  uint32_t qp = 0) {
+  return FmsD(f1, f3, fpOne, f2, sf, qp);
+}
+inline Op FmpyD(uint32_t f1, uint32_t f3, uint32_t f4, uint32_t sf = sf0,
+                  uint32_t qp = 0) {
+  return FmaD(f1, f3, f4, fpZero, sf, qp);
+}
+inline Op FnormD(uint32_t f1, uint32_t f3, uint32_t sf = sf0,
+                   uint32_t qp = 0) {
+  return FmaD(f1, f3, fpOne, fpZero, sf, qp);
+}
+// The .s forms round to IEEE single: every float32 result must be rounded in
+// the register, since stfs/getf.s only truncate (wiki/wasm.html).
+inline Op FaddS(uint32_t f1, uint32_t f3, uint32_t f2, uint32_t sf = sf0,
+                  uint32_t qp = 0) {
+  return FmaS(f1, f3, fpOne, f2, sf, qp);
+}
+inline Op FsubS(uint32_t f1, uint32_t f3, uint32_t f2, uint32_t sf = sf0,
+                  uint32_t qp = 0) {
+  return FmsS(f1, f3, fpOne, f2, sf, qp);
+}
+inline Op FmpyS(uint32_t f1, uint32_t f3, uint32_t f4, uint32_t sf = sf0,
+                  uint32_t qp = 0) {
+  return FmaS(f1, f3, f4, fpZero, sf, qp);
+}
+inline Op FnormS(uint32_t f1, uint32_t f3, uint32_t sf = sf0,
+                   uint32_t qp = 0) {
+  return FmaS(f1, f3, fpOne, fpZero, sf, qp);
+}
+inline Op Fnorm(uint32_t f1, uint32_t f3, uint32_t sf = sf0,
+                  uint32_t qp = 0) {
+  return Fma(f1, f3, fpOne, fpZero, sf, qp);
+}
+inline Op FmovD(uint32_t f1, uint32_t f3, uint32_t qp = 0) {
+  return FnormD(f1, f3, sf0, qp);
+}
+
+// F6/F11: conversions. Major opcode 0, xb (bit 33) = 0, x6 -> 32:27.
+inline Op FcvtF11(uint32_t x6, uint32_t f1, uint32_t f2, uint32_t sf,
+                    uint32_t qp) {
+  return MakeOp(
+             fOp(0) | fZb(0) | fX6b(x6) | fSf(sf) | fF2(f2) | fF1(f1) | fQp(qp),
+             UnitF)
+      .d(ResFr, f1, 6)
+      .u(ResFr, f2, 13)
+      .u(ResPr, qp, 0)
+      .fl(OpFpu)
+      .fl(OpSched);
+}
+
+inline Op FcvtFx(uint32_t f1, uint32_t f2, uint32_t sf = sf0,
+                   uint32_t qp = 0) {
+  return FcvtF11(0x18, f1, f2, sf, qp);
+}
+inline Op FcvtFxu(uint32_t f1, uint32_t f2, uint32_t sf = sf0,
+                    uint32_t qp = 0) {
+  return FcvtF11(0x19, f1, f2, sf, qp);
+}
+inline Op FcvtFxTrunc(uint32_t f1, uint32_t f2, uint32_t sf = sf0,
+                        uint32_t qp = 0) {
+  return FcvtF11(0x1a, f1, f2, sf, qp);
+}
+inline Op FcvtFxuTrunc(uint32_t f1, uint32_t f2, uint32_t sf = sf0,
+                         uint32_t qp = 0) {
+  return FcvtF11(0x1b, f1, f2, sf, qp);
+}
+// fcvt.xf has no status field.
+inline Op FcvtXf(uint32_t f1, uint32_t f2, uint32_t qp = 0) {
+  return FcvtF11(0x1c, f1, f2, 0, qp);
+}
+
+// F4: fcmp.rel.sf p1, p2 = f2, f3
+//   ra -> bit 33   rb -> bit 36   ta -> bit 12
+inline Insn fRa(uint32_t x) { return Insn(x & 0x1) << 33; }
+inline Insn fRb(uint32_t x) { return Insn(x & 0x1) << 36; }
+
+// fccTa (bit 12) selects the .unc completer: when qp is false, p1/p2 are
+// simply left at 0 rather than holding the relation, which lets a second
+// fcmp be chained off the first predicate to build "ordered AND rel" in one
+// extra instruction (see emitCompareDouble in MacroAssembler-ia64.cpp). This
+// is a different field from the A-type compare's fTa (also bit 33, unlike
+// this one) despite the similar name in the manual.
+inline Insn fFccTa(uint32_t x) { return Insn(x & 0x1) << 12; }
+
+inline Op FcmpF4(uint32_t ra, uint32_t rb, uint32_t p1, uint32_t p2,
+                   uint32_t f2, uint32_t f3, uint32_t sf, uint32_t qp,
+                   uint32_t ta = 0) {
+  return MakeOp(fOp(4) | fRb(rb) | fSf(sf) | fRa(ra) | fP2(p2) | fF3(f3) |
+                    fF2(f2) | fFccTa(ta) | fP1(p1) | fQp(qp),
+                UnitF)
+      .d(ResPr, p1, 6)
+      .d(ResPr, p2, 27)
+      .u(ResFr, f2, 13)
+      .u(ResFr, f3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpFpu)
+      .fl(OpSched);
+}
+
+inline Op FcmpEq(uint32_t p1, uint32_t p2, uint32_t f2, uint32_t f3,
+                   uint32_t sf = sf0, uint32_t qp = 0) {
+  return FcmpF4(0, 0, p1, p2, f2, f3, sf, qp);
+}
+inline Op FcmpLt(uint32_t p1, uint32_t p2, uint32_t f2, uint32_t f3,
+                   uint32_t sf = sf0, uint32_t qp = 0) {
+  return FcmpF4(0, 1, p1, p2, f2, f3, sf, qp);
+}
+inline Op FcmpLe(uint32_t p1, uint32_t p2, uint32_t f2, uint32_t f3,
+                   uint32_t sf = sf0, uint32_t qp = 0) {
+  return FcmpF4(1, 0, p1, p2, f2, f3, sf, qp);
+}
+inline Op FcmpUnord(uint32_t p1, uint32_t p2, uint32_t f2, uint32_t f3,
+                      uint32_t sf = sf0, uint32_t qp = 0) {
+  return FcmpF4(1, 1, p1, p2, f2, f3, sf, qp);
+}
+inline Op FcmpEqUnc(uint32_t p1, uint32_t p2, uint32_t f2, uint32_t f3,
+                      uint32_t sf, uint32_t qp) {
+  return FcmpF4(0, 0, p1, p2, f2, f3, sf, qp, 1);
+}
+inline Op FcmpLtUnc(uint32_t p1, uint32_t p2, uint32_t f2, uint32_t f3,
+                      uint32_t sf, uint32_t qp) {
+  return FcmpF4(0, 1, p1, p2, f2, f3, sf, qp, 1);
+}
+inline Op FcmpLeUnc(uint32_t p1, uint32_t p2, uint32_t f2, uint32_t f3,
+                      uint32_t sf, uint32_t qp) {
+  return FcmpF4(1, 0, p1, p2, f2, f3, sf, qp, 1);
+}
+
+// F6: frcpa/frsqrta. Major opcode 0, xb (bit 33) selects the pair, q (bit 36)
+// selects frcpa (0) vs frsqrta (1). Both write a status predicate p2 in
+// addition to f1.
+inline Insn fXb(uint32_t x) { return Insn(x & 0x1) << 33; }
+inline Insn fQ(uint32_t x) { return Insn(x & 0x1) << 36; }
+
+inline Op Frcpa(uint32_t f1, uint32_t p2, uint32_t f2, uint32_t f3,
+                  uint32_t sf = sf0, uint32_t qp = 0) {
+  return MakeOp(fOp(0) | fQ(0) | fXb(1) | fSf(sf) | fF3(f3) | fF2(f2) |
+                    fP2(p2) | fF1(f1) | fQp(qp),
+                UnitF)
+      .d(ResFr, f1, 6)
+      .d(ResPr, p2, 27)
+      .u(ResFr, f2, 13)
+      .u(ResFr, f3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpFpu)
+      .fl(OpSched);
+}
+inline Op Frsqrta(uint32_t f1, uint32_t p2, uint32_t f3, uint32_t sf = sf0,
+                    uint32_t qp = 0) {
+  return MakeOp(fOp(0) | fQ(1) | fXb(1) | fSf(sf) | fF3(f3) | fP2(p2) |
+                    fF1(f1) | fQp(qp),
+                UnitF)
+      .d(ResFr, f1, 6)
+      .d(ResPr, p2, 27)
+      .u(ResFr, f3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpFpu)
+      .fl(OpSched);
+}
+
+// F2: xma. Fused 64x64 integer multiply-add via the significand path. xa is
+// bit 36, x2 is bits 35:34.
+inline Op XmaF2(uint32_t x2, uint32_t f1, uint32_t f3, uint32_t f4,
+                  uint32_t f2, uint32_t qp) {
+  return MakeOp(fOp(0xe) | fXa(1) | fX2(x2) | fF4(f4) | fF3(f3) | fF2(f2) |
+                    fF1(f1) | fQp(qp),
+                UnitF)
+      .d(ResFr, f1, 6)
+      .u(ResFr, f3, 20)
+      .u(ResFr, f4, 27)
+      .u(ResFr, f2, 13)
+      .u(ResPr, qp, 0)
+      .fl(OpFpu)
+      .fl(OpSched);
+}
+inline Op XmaL(uint32_t f1, uint32_t f3, uint32_t f4, uint32_t f2,
+                 uint32_t qp = 0) {
+  return XmaF2(0, f1, f3, f4, f2, qp);
+}
+inline Op XmaH(uint32_t f1, uint32_t f3, uint32_t f4, uint32_t f2,
+                 uint32_t qp = 0) {
+  return XmaF2(3, f1, f3, f4, f2, qp);
+}
+inline Op XmaHu(uint32_t f1, uint32_t f3, uint32_t f4, uint32_t f2,
+                  uint32_t qp = 0) {
+  return XmaF2(2, f1, f3, f4, f2, qp);
+}
+
+// F9: fmerge. Major opcode 0, xb=0, x6 -> bits 32:27.
+inline Op FmergeF9(uint32_t x6, uint32_t f1, uint32_t f2, uint32_t f3,
+                     uint32_t qp) {
+  return MakeOp(fOp(0) | fZb(0) | fX6b(x6) | fF3(f3) | fF2(f2) | fF1(f1) |
+                    fQp(qp),
+                UnitF)
+      .d(ResFr, f1, 6)
+      .u(ResFr, f2, 13)
+      .u(ResFr, f3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpFpu)
+      .fl(OpSched);
+}
+inline Op FmergeS(uint32_t f1, uint32_t f2, uint32_t f3, uint32_t qp = 0) {
+  return FmergeF9(0x10, f1, f2, f3, qp);
+}
+inline Op FmergeNs(uint32_t f1, uint32_t f2, uint32_t f3, uint32_t qp = 0) {
+  return FmergeF9(0x11, f1, f2, f3, qp);
+}
+inline Op FmergeSe(uint32_t f1, uint32_t f2, uint32_t f3, uint32_t qp = 0) {
+  return FmergeF9(0x12, f1, f2, f3, qp);
+}
+
+// F5: fclass. Major opcode 5, ta (bit 12) = 0 for the non-.unc form. The
+// class-test immediate is split across two fields: a 7-bit "magnitude" mask
+// at bits 26:20 (zero/unorm/norm/inf/snan/qnan/nat, one bit each, matching
+// the low-to-high order of the FclassMask constants below) and a 2-bit sign
+// selector at bits 34:33 (bit 33 = test positive, bit 34 = test negative).
+// GNU as sets both sign bits automatically for the sign-independent magnitude
+// classes (zero/unorm/norm/inf); the NaN/NaT classes carry no sign bits.
+enum FclassMask : uint32_t {
+  FclassZero = 1u << 0,
+  FclassUnorm = 1u << 1,
+  FclassNorm = 1u << 2,
+  FclassInf = 1u << 3,
+  FclassSNaN = 1u << 4,
+  FclassQNaN = 1u << 5,
+  FclassNat = 1u << 6,
+  // The two hardware sign-select bits (bits 33:34), settable independently.
+  FclassSignPos = 1u << 7,
+  FclassSignNeg = 1u << 8,
+  FclassSignBoth = FclassSignPos | FclassSignNeg,
+};
+static const uint32_t FclassNaN = FclassSNaN | FclassQNaN;
+static const uint32_t FclassAnySignZero = FclassZero | FclassSignBoth;
+static const uint32_t FclassAnySignInf = FclassInf | FclassSignBoth;
+static const uint32_t FclassPosInf = FclassInf | FclassSignPos;
+
+// unc: with a false qp both predicates are cleared instead of left alone (ta,
+// bit 12).
+inline Op Fclass(uint32_t p1, uint32_t p2, uint32_t f2, uint32_t mask,
+                   uint32_t qp = 0, bool unc = false) {
+  return MakeOp(fOp(5) | (unc ? (Insn(1) << 12) : Insn(0)) | (Insn((mask >> 7) & 0x3) << 33) |
+                    (Insn(mask & 0x7f) << 20) | fF2(f2) | fP2(p2) | fP1(p1) |
+                    fQp(qp),
+                UnitF)
+      .d(ResPr, p1, 6)
+      .d(ResPr, p2, 27)
+      .u(ResFr, f2, 13)
+      .u(ResPr, qp, 0)
+      .fl(OpFpu)
+      .fl(OpSched);
+}
+
+// ---------------------------------------------------------------------------
+// Nops. The nop encoding is the same 41-bit pattern in every unit; only the
+// slot it occupies determines which unit executes it.
+//   M-unit nop: major op 0, x3=0, x6=1
+//   I-unit nop: major op 0, x3=0, x6=1
+//   B-unit nop: major op 2, x6=0
+//   F-unit nop: major op 0, x=0, x6=1
+// ---------------------------------------------------------------------------
+
+inline Insn NopBits(uint32_t imm21) {
+  return fOp(0) | (Insn(1) << 27) | (Insn(imm21 & 0xfffff) << 6) |
+         (Insn((imm21 >> 20) & 1) << 36);
+}
+inline Insn NopBBits(uint32_t imm21) {
+  return fOp(2) | (Insn(imm21 & 0xfffff) << 6) |
+         (Insn((imm21 >> 20) & 1) << 36);
+}
+
+// A nop reads and writes nothing, so it never constrains an instruction group;
+// only the slot it lands in decides which unit retires it.
+inline Op NopM(uint32_t imm21 = 0) { return MakeOp(NopBits(imm21), UnitM); }
+
+// M24: mf, the memory fence (op 0, x3 0, x4 2, x2 2; encoding checked against
+// gas on epic-t2).  Deliberately no OpSched: nothing may be moved across it.
+inline Op Mf() { return MakeOp(Insn(0x110000000ULL), UnitM); }
+inline Op NopI(uint32_t imm21 = 0) { return MakeOp(NopBits(imm21), UnitI); }
+inline Op NopF(uint32_t imm21 = 0) { return MakeOp(NopBits(imm21), UnitF); }
+inline Op NopB(uint32_t imm21 = 0) { return MakeOp(NopBBits(imm21), UnitB); }
+
+// A2: shladd r1 = r2, count, r3  -- r1 = (r2 << count) + r3, count 1..4.
+inline Op Shladd(uint32_t r1, uint32_t r2, uint32_t count, uint32_t r3,
+                 uint32_t qp = 0) {
+  MOZ_ASSERT(count >= 1 && count <= 4);
+  return MakeOp(fOp(8) | fX2a(0) | fVe(0) | fX4(4) |
+                    (Insn((count - 1) & 0x3) << 27) | fR3(r3) | fR2(r2) |
+                    fR1(r1) | fQp(qp),
+                UnitA)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r2, 13)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+
+// A5: addl r1 = imm22, r3  -- r3 is one of r0-r3 (a 2-bit field). With r0 it
+// is the one-slot way to load any constant in [-2^21, 2^21).
+//   s 36   imm9d 35:27   imm5c 26:22   r3 21:20   imm7b 19:13   r1 12:6
+inline bool FitsImm22(int64_t v) { return v >= -(int64_t(1) << 21) && v < (int64_t(1) << 21); }
+inline Op Addl(uint32_t r1, int64_t imm22, uint32_t r3 = 0, uint32_t qp = 0) {
+  MOZ_ASSERT(FitsImm22(imm22) && r3 <= 3);
+  uint64_t u = uint64_t(imm22);
+  return MakeOp(fOp(9) | (Insn((u >> 21) & 1) << 36) |
+                    (Insn((u >> 7) & 0x1ff) << 27) |
+                    (Insn((u >> 16) & 0x1f) << 22) | (Insn(r3 & 3) << 20) |
+                    (Insn(u & 0x7f) << 13) | fR1(r1) | fQp(qp),
+                UnitA)
+      .d(ResGr, r1, 6)
+      .u(ResGr, r3, kFixedField)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+
+// A6 with x2 = 1: the 32-bit compares, which look only at the low 32 bits of
+// both registers -- no sign- or zero-extension needed first.
+inline Op Cmp4A6(uint32_t op, uint32_t p1, uint32_t p2, uint32_t r2,
+                 uint32_t r3, uint32_t qp = 0) {
+  return MakeOp(fOp(op) | fTb(0) | fX2(1) | fTa(0) | fP2(p2) | fR3(r3) |
+                    fR2(r2) | fC(0) | fP1(p1) | fQp(qp),
+                UnitA)
+      .d(ResPr, p1, 6)
+      .d(ResPr, p2, 27)
+      .u(ResGr, r2, 13)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+inline Op Cmp4Eq(uint32_t p1, uint32_t p2, uint32_t r2, uint32_t r3, uint32_t qp = 0) {
+  return Cmp4A6(0xe, p1, p2, r2, r3, qp);
+}
+inline Op Cmp4Lt(uint32_t p1, uint32_t p2, uint32_t r2, uint32_t r3, uint32_t qp = 0) {
+  return Cmp4A6(0xc, p1, p2, r2, r3, qp);
+}
+inline Op Cmp4Ltu(uint32_t p1, uint32_t p2, uint32_t r2, uint32_t r3, uint32_t qp = 0) {
+  return Cmp4A6(0xd, p1, p2, r2, r3, qp);
+}
+
+// A8: cmp.crel / cmp4.crel p1, p2 = imm8, r3  -- note the immediate is the
+// *first* operand: p1 = (imm8 crel r3).  x2 = 2 for cmp, 3 for cmp4.
+//   s 36   x2 35:34   ta 33   p2 32:27   r3 26:20   imm7b 19:13   c 12   p1 11:6
+inline bool FitsImm8(int64_t v) { return v >= -128 && v < 128; }
+inline Op CmpA8(uint32_t op, uint32_t x2, uint32_t p1, uint32_t p2,
+                int64_t imm8, uint32_t r3, uint32_t qp = 0) {
+  MOZ_ASSERT(FitsImm8(imm8));
+  return MakeOp(fOp(op) | fX2(x2) | fTa(0) | fP2(p2) | fR3(r3) | fImm8(imm8) |
+                    fC(0) | fP1(p1) | fQp(qp),
+                UnitA)
+      .d(ResPr, p1, 6)
+      .d(ResPr, p2, 27)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+inline Op CmpEqImm(uint32_t p1, uint32_t p2, int64_t imm8, uint32_t r3, uint32_t qp = 0) {
+  return CmpA8(0xe, 2, p1, p2, imm8, r3, qp);
+}
+inline Op CmpLtImm(uint32_t p1, uint32_t p2, int64_t imm8, uint32_t r3, uint32_t qp = 0) {
+  return CmpA8(0xc, 2, p1, p2, imm8, r3, qp);
+}
+inline Op CmpLtuImm(uint32_t p1, uint32_t p2, int64_t imm8, uint32_t r3, uint32_t qp = 0) {
+  return CmpA8(0xd, 2, p1, p2, imm8, r3, qp);
+}
+inline Op Cmp4EqImm(uint32_t p1, uint32_t p2, int64_t imm8, uint32_t r3, uint32_t qp = 0) {
+  return CmpA8(0xe, 3, p1, p2, imm8, r3, qp);
+}
+inline Op Cmp4LtImm(uint32_t p1, uint32_t p2, int64_t imm8, uint32_t r3, uint32_t qp = 0) {
+  return CmpA8(0xc, 3, p1, p2, imm8, r3, qp);
+}
+inline Op Cmp4LtuImm(uint32_t p1, uint32_t p2, int64_t imm8, uint32_t r3, uint32_t qp = 0) {
+  return CmpA8(0xd, 3, p1, p2, imm8, r3, qp);
+}
+
+// I13: dep.z r1 = imm8, pos, len  -- imm8 sign-extended to len bits, placed
+// at pos, zeros elsewhere.  One I-unit slot for every NaN-box tag constant
+// (dep.z r = -15, 47, 17 is JSVAL_SHIFTED_TAG_INT32) instead of a movl.
+//   s 36   x2 35:34 = 1   x 33 = 1   len6d 32:27   y 26 = 1   cpos6c 25:20
+//   imm7b 19:13   r1 12:6
+inline Op DepZImm(uint32_t r1, int64_t imm8, uint32_t pos, uint32_t len,
+                  uint32_t qp = 0) {
+  MOZ_ASSERT(FitsImm8(imm8) && len >= 1 && pos + len <= 64);
+  return MakeOp(fOp(5) | (Insn((uint64_t(imm8) >> 7) & 1) << 36) | fX2(1) |
+                    fXi(1) | fLen6(len) | fYb(1) | fCpos6a(pos) |
+                    (Insn(uint64_t(imm8) & 0x7f) << 13) | fR1(r1) | fQp(qp),
+                UnitI)
+      .d(ResGr, r1, 6)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+
+// I16: tbit.z p1, p2 = r3, pos6  -- p1 = (bit pos of r3 is 0), p2 = not p1.
+// One I-slot instead of and + cmp for a one-bit test (tbit.nz is the same
+// with p1 and p2 swapped).  Checked against gas.
+//   tb 36 = 0   x2 35:34 = 0   ta 33 = 0   p2 32:27   r3 26:20   pos6 19:14
+//   y 13 = 0   c 12 = 0   p1 11:6
+inline Op TbitZ(uint32_t p1, uint32_t p2, uint32_t r3, uint32_t pos,
+                uint32_t qp = 0) {
+  MOZ_ASSERT(pos < 64);
+  return MakeOp(fOp(5) | fP2(p2) | fR3(r3) | (Insn(pos & 0x3f) << 14) |
+                    fP1(p1) | fQp(qp),
+                UnitI)
+      .d(ResPr, p1, 6)
+      .d(ResPr, p2, 27)
+      .u(ResGr, r3, 20)
+      .u(ResPr, qp, 0)
+      .fl(OpSched);
+}
+
+// A constant dep.z can build: (sext(imm8) truncated to len bits) << pos.
+// The field is the constant shifted down to its lowest set bit, read either
+// as a negative number (its own top bit the sign) or a positive one (one zero
+// bit more); false if neither fits imm8.
+inline bool DepZImmFor(uint64_t v, int64_t* imm8, uint32_t* pos,
+                       uint32_t* len) {
+  if (!v) {
+    return false;
+  }
+  uint32_t p = uint32_t(__builtin_ctzll(v));
+  uint64_t f = v >> p;
+  uint32_t bits = 64 - uint32_t(__builtin_clzll(f));
+  for (uint32_t l : {bits, bits + 1}) {
+    if (p + l > 64) {
+      continue;
+    }
+    int64_t s = l == 64 ? int64_t(f) : int64_t(f << (64 - l)) >> (64 - l);
+    if (FitsImm8(s)) {
+      *imm8 = s;
+      *pos = p;
+      *len = l;
+      return true;
+    }
+  }
+  return false;
+}
+
+// ---------------------------------------------------------------------------
+// Long branches (brl). A brl is an X-unit instruction: it occupies the L and X
+// slots of an MLX bundle and carries a signed 60-bit bundle displacement, so it
+// reaches the entire address space instead of the +/-16 MiB a B-unit branch
+// manages. It is the fallback form for branches to a Label: the B-unit form is
+// preferred wherever its range can be guaranteed (ia64::BranchForm below).
+//
+// That also fixes label binding. An unbound forward branch stores the chain
+// link to the previous branch in its own displacement field; when that field
+// was 21 bits, a code buffer past 2^20 bundles (16 MiB) made a legitimate
+// bundle index set bit 20, which read back sign-extended as a large negative
+// number. bind() then walked outside the buffer and never found kEndOfChain --
+// an infinite loop compiling large scripts. 60 bits cannot overflow.
+//
+// Field layout, SDM Volume 3 formats X3 (brl.cond) and X4 (brl.call), verified
+// byte-for-byte against GNU as:
+//
+//   X slot: op 40:37 (0xc brl.cond, 0xd brl.call)   i (imm60 sign) 36
+//           d 35   wh 34:33   imm20b 32:13   p 12
+//           btype 8:6 (brl.cond, always 0) / b1 8:6 (brl.call)   qp 5:0
+//   L slot: imm39 40:2, bits 1:0 ignored
+//
+//   imm60 = (i << 59) | (imm39 << 20) | imm20b, and target = IP + (imm60 << 4)
+//
+// The X-slot immediate fields sit in exactly the positions fTgt25c() uses, so
+// the two forms differ only by the L slot. brl must be followed by a stop or
+// its behaviour is undefined (SDM 3:30), hence tMLX_ rather than tMLX.
+//
+// brl is not implemented on first-generation Itanium (Merced), which faults and
+// leaves the kernel to emulate it. Every target this backend builds for is
+// Itanium 2 or later, where CPUID advertises it as the "branchlong" feature.
+// ---------------------------------------------------------------------------
+
+static const int64_t MaxLongBranchBundleDisp = (int64_t(1) << 59) - 1;
+static const int64_t MinLongBranchBundleDisp = -(int64_t(1) << 59);
+
+inline bool LongBranchDispInRange(int64_t bundleDisp) {
+  return bundleDisp >= MinLongBranchBundleDisp &&
+         bundleDisp <= MaxLongBranchBundleDisp;
+}
+
+// The X-slot half of imm60: low 20 bits and the sign.
+inline Insn fTgt64x(int64_t bundleDisp) {
+  uint64_t u = uint64_t(bundleDisp);
+  return (Insn(u & 0xfffff) << 13) | (Insn((u >> 59) & 0x1) << 36);
+}
+
+// The L-slot half: imm39, shifted past the two ignored low bits.
+inline Insn fTgt64l(int64_t bundleDisp) {
+  uint64_t u = uint64_t(bundleDisp);
+  return Insn((u >> 20) & 0x7fffffffffULL) << 2;
+}
+
+// X3: (qp) brl.cond.<hint>.few <ip-relative target>
+inline Op BrlCondRel(int64_t bundleDisp, uint32_t qp = 0,
+                     BranchHint hint = BranchHint::Sptk) {
+  Insn x = fOp(0xc) | fBtype(0) | fPa(0) | fWha(uint32_t(hint)) | fD(0) |
+           fTgt64x(bundleDisp) | fQp(qp);
+  return MakeOpLX(x, fTgt64l(bundleDisp)).u(ResPr, qp, 0).fl(OpBranch);
+}
+
+// X4: (qp) brl.call.sptk.many b1 = <ip-relative target>
+inline Op BrlCallRel(uint32_t b1, int64_t bundleDisp, uint32_t qp = 0) {
+  Insn x = fOp(0xd) | fPa(1) | fWha(0) | fD(0) | fB1(b1) |
+           fTgt64x(bundleDisp) | fQp(qp);
+  return MakeOpLX(x, fTgt64l(bundleDisp))
+      .d(ResBr, b1, 6)
+      .d(ResAr, ArPfs)
+      .d(ResCfm, 0)
+      .u(ResPr, qp, 0)
+      .fl(OpBranch);
+}
+
+inline Op BrlCallRelB0(int64_t bundleDisp, uint32_t qp,
+                       BranchHint = BranchHint::Sptk) {
+  return BrlCallRel(0, bundleDisp, qp);
+}
+
+// ---------------------------------------------------------------------------
+// A branch to a Label, in both of its encodings.
+//
+// The two forms are not equally good. brl is an L+X pair: it takes slots 1 and
+// 2, so MLX is the only template that can hold it and the only company it can
+// keep is one M instruction in slot 0 -- and SDM 3:30 requires a stop after it,
+// so the group ends there whether the branch is taken or not. The 21-bit B-unit
+// form takes a single slot in MIB/MMB/MFB, leaves two slots for instructions of
+// any unit, and forces no stop: on the not-taken path of a guard the group runs
+// straight on into the next bundle.
+//
+// The short form only reaches +/-16 MiB, though, and a forward branch's
+// displacement is not known until bind() -- by which point the bundle is
+// written and cannot be grown. So the choice is made per branch: a backward
+// branch takes the short form when its target is in range; everything else
+// stays brl, whose 60-bit displacement can reach any label.
+// ---------------------------------------------------------------------------
+struct BranchForm {
+  Op (*shortForm)(int32_t bundleDisp, uint32_t qp, BranchHint hint);
+  Op (*longForm)(int64_t bundleDisp, uint32_t qp, BranchHint hint);
+};
+
+inline constexpr BranchForm kBrCond = {&BrCondRel, &BrlCondRel};
+inline constexpr BranchForm kBrCallB0 = {&BrCallRelB0, &BrlCallRelB0};
+
+inline bool IsLongBranchBundle(const Bundle* b) {
+  uint8_t tmpl = uint8_t(b->lo & 0x1f);
+  return tmpl == tMLX || tmpl == tMLX_;
+}
+
+// Read back a branch's displacement, which for a still-unbound forward branch
+// is the chain link rather than a real target. Handles either branch form, so
+// a label chain may mix them (toggledJump's short br.cond and ordinary brls).
+inline int64_t ReadBranchDisp(const Bundle* b) {
+  const uint64_t kSlotMask = (uint64_t(1) << 41) - 1;
+  Insn x = (b->hi >> 23) & kSlotMask;
+  uint32_t imm20 = uint32_t((x >> 13) & 0xfffff);
+  uint32_t sign = uint32_t((x >> 36) & 0x1);
+
+  if (!IsLongBranchBundle(b)) {
+    int32_t v = int32_t(imm20 | (sign << 20));
+    if (v & (1 << 20)) {
+      v |= ~((1 << 21) - 1);
+    }
+    return v;
+  }
+
+  Insn l = ((b->lo >> 46) | ((b->hi & 0x7fffff) << 18)) & kSlotMask;
+  uint64_t v = uint64_t(imm20) | (((l >> 2) & 0x7fffffffffULL) << 20) |
+               (uint64_t(sign) << 59);
+  if (v & (uint64_t(1) << 59)) {
+    v |= ~((uint64_t(1) << 60) - 1);
+  }
+  return int64_t(v);
+}
+
+// Rewrite a brl's displacement in place. The L slot straddles both halves of
+// the bundle (18 bits at lo 63:46, 23 bits at hi 22:0), so both are rebuilt.
+inline void PatchLongBranchDisp(Bundle* b, int64_t bundleDisp) {
+  MOZ_RELEASE_ASSERT(LongBranchDispInRange(bundleDisp));
+  const uint64_t kSlotMask = (uint64_t(1) << 41) - 1;
+  Insn x = (b->hi >> 23) & kSlotMask;
+  Insn clearMask = (Insn(0xfffff) << 13) | (Insn(1) << 36);
+  x = (x & ~clearMask) | fTgt64x(bundleDisp);
+  Insn l = fTgt64l(bundleDisp);
+  b->lo = (b->lo & ((uint64_t(1) << 46) - 1)) | (l << 46);
+  b->hi = (l >> 18) | (x << 23);
+}
+
+// Resolve a forward branch of either form. This is what label binding uses.
+inline void PatchBranchDisp(Bundle* b, int64_t bundleDisp) {
+  if (IsLongBranchBundle(b)) {
+    PatchLongBranchDisp(b, bundleDisp);
+  } else {
+    PatchShortBranchDisp(b, bundleDisp);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// movl: load a full 64-bit immediate. This is the only two-slot instruction:
+// it occupies the L and X slots of an MLX bundle, with the immediate scattered
+// across both. The layout below was derived from GNU as by assembling movl
+// with one immediate bit set at a time and observing which bundle bit moved:
+//
+//   imm[6:0]   -> X slot 19:13 (imm7b)
+//   imm[15:7]  -> X slot 35:27 (imm9d)
+//   imm[20:16] -> X slot 26:22 (imm5c)
+//   imm[21]    -> X slot 21    (ic)
+//   imm[62:22] -> the whole L slot
+//   imm[63]    -> X slot 36    (i, the sign bit)
+//
+// vc (X slot bit 20) is 0 for movl.
+// ---------------------------------------------------------------------------
+
+inline Op Movl(uint32_t r1, uint64_t imm, uint32_t qp = 0) {
+  Insn l = Insn((imm >> 22) & ((uint64_t(1) << 41) - 1));
+
+  Insn x = fOp(6) | fR1(r1) | fQp(qp);
+  x |= Insn((imm >> 0) & 0x7f) << 13;    // imm7b
+  x |= Insn((imm >> 7) & 0x1ff) << 27;   // imm9d
+  x |= Insn((imm >> 16) & 0x1f) << 22;   // imm5c
+  x |= Insn((imm >> 21) & 0x1) << 21;    // ic
+  x |= Insn((imm >> 63) & 0x1) << 36;    // i
+
+  return MakeOpLX(x, l).d(ResGr, r1, 6).u(ResPr, qp, 0);
+}
+
+// ---------------------------------------------------------------------------
+// One-instruction-per-bundle emission helpers.
+//
+// These are what the whole backend used to emit through, and they are still
+// how the *fixed-layout* sequences are built: the three-bundle
+// movl/mov-to-br/br.call that toggledCall(), PatchWrite_NearCall() and
+// patchNopToCall() rewrite in place all depend on knowing exactly which
+// bundle holds which instruction, so those sequences opt out of bundling
+// entirely (see Assembler::AutoUnbundled).
+// ---------------------------------------------------------------------------
+
+// An M-unit instruction alone in a bundle: MII with nops and a trailing stop.
+inline Bundle BundleM(const Op& m) {
+  return MakeBundle(tMII_, m.bits, NopBits(0), NopBits(0));
+}
+
+// An I-unit instruction alone in a bundle: the first slot of MII must be an
+// M-unit slot, so pad it with an M nop.
+inline Bundle BundleI(const Op& i) {
+  return MakeBundle(tMII_, NopBits(0), i.bits, NopBits(0));
+}
+
+// A B-unit instruction alone in a bundle.
+inline Bundle BundleB(const Op& b) {
+  return MakeBundle(tMIB_, NopBits(0), NopBits(0), b.bits);
+}
+
+// An F-unit instruction alone in a bundle.
+inline Bundle BundleF(const Op& f) {
+  return MakeBundle(tMFI_, NopBits(0), f.bits, NopBits(0));
+}
+
+// A two-slot L+X instruction alone in a bundle (movl, brl). tMLX_ rather than
+// tMLX because a brl must be followed by a stop (SDM 3:30).
+inline Bundle BundleLX(const Op& x) {
+  return MakeBundle(tMLX_, NopBits(0), x.bitsL, x.bits);
+}
+
+// Any single instruction alone in its own bundle, dispatching on its unit.
+inline Bundle LoneBundle(const Op& op) {
+  switch (Unit(op.unit)) {
+    case UnitM:
+    case UnitA:
+      if (op.flags & OpCheck) {
+        return BundleI(op);  // carries the chk.s.i form
+      }
+      return BundleM(op);
+    case UnitI:
+      return BundleI(op);
+    case UnitF:
+      return BundleF(op);
+    case UnitB:
+      return BundleB(op);
+    case UnitLX:
+      return BundleLX(op);
+  }
+  MOZ_CRASH("bad unit");
+}
+
+// The old name for the movl bundle, kept because the fixed three-bundle call
+// sequences build one directly into raw memory.
+inline Bundle MovlBundle(uint32_t r1, uint64_t imm, uint32_t qp = 0) {
+  return BundleLX(Movl(r1, imm, qp));
+}
+
+}  // namespace ia64
+}  // namespace jit
+}  // namespace js
+
+#endif /* jit_ia64_AssemblerCore_ia64_h */
diff --git a/js/src/jit/ia64/Bundler-ia64.h b/js/src/jit/ia64/Bundler-ia64.h
new file mode 100644
--- /dev/null
+++ b/js/src/jit/ia64/Bundler-ia64.h
@@ -0,0 +1,1118 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef jit_ia64_Bundler_ia64_h
+#define jit_ia64_Bundler_ia64_h
+
+#include "mozilla/Assertions.h"
+
+#include "jit/ia64/AssemblerCore-ia64.h"
+
+// [SMDOC] IA-64 bundle formation
+//
+// IA-64 has no linear instruction stream. Instructions are packed three at a
+// time into 128-bit bundles, and a 5-bit template says which execution unit
+// each of the three slots feeds and where the *stop bits* fall. A stop ends an
+// instruction group; within a group the hardware issues in parallel with no
+// interlocks, so the instructions in a group must be free of RAW and WAW
+// dependencies on each other (SDM Volume 1, section 3.4).
+//
+// This file turns a stream of |Op|s into bundles. Two pieces do that:
+//
+//   OpenBundle   picks templates and slots. This is the "DFA": each state is
+//                the set of template prefixes still consistent with what has
+//                been placed, and each instruction is a transition. It is
+//                exact rather than heuristic -- it searches all twelve
+//                architectural templates -- which is cheap because a bundle
+//                holds at most three instructions.
+//
+//   GroupDeps    tracks the resources written so far in the current
+//                instruction group, and answers whether a stop bit has to
+//                precede the next instruction.
+//
+// Two properties make this safe to do at emit time, which is what the rest of
+// the backend requires (labels, relocations and patch sites all name byte
+// offsets that must be final the moment emit() returns):
+//
+//   * A bundle's address is fixed when the bundle *opens*, before we know what
+//     will end up in it. The contents are rewritten in place afterwards, so
+//     packing never moves anything that has already been handed out.
+//
+//   * Instructions inside one instruction group have no RAW or WAW register
+//     dependence on each other, so assigning them to slots in another order
+//     than program order is architecturally equivalent -- *unless* one reads a
+//     register a later one writes (WAR is allowed in a group, but only in slot
+//     order: swapped, the reader sees the new value), or two memory accesses
+//     to one address include a store (a load sees the most recent prior store
+//     in slot order). Such a bundle is assigned in program order (see
+//     OpenBundle::ordered_); any other may be permuted, which is what lets,
+//     say, an I-only shl and an independent M-only ld8 share a bundle even
+//     though the shl was emitted first and no template starts with an I slot.
+//     Nothing ever moves across a stop bit; this is slot assignment, not
+//     scheduling.
+//
+// What is deliberately left out: no instruction reordering of any kind, no
+// second branch per bundle (MBB/BBB -- PatchBranchDisp() reads slot 2, so only
+// one branch per bundle stays patchable), and no speculation.
+
+namespace js {
+namespace jit {
+namespace ia64 {
+
+// The kind of instruction a template slot accepts.
+enum SlotKind : uint8_t { SlotM, SlotI, SlotF, SlotB, SlotL, SlotX };
+
+// The twelve architectural bundle templates, without their stop bit. |gb| is
+// the group boundary: 0 for none, otherwise the slot index the internal stop
+// precedes (so 1 means "stop between slots 0 and 1"). Taken from the binutils
+// opcode tables (opcodes/ia64-opc.c, ia64_templ_desc), which index by the
+// template field with its low bit -- the end-of-bundle stop -- stripped.
+struct TemplDesc {
+  uint8_t enc;
+  uint8_t gb;
+  SlotKind slot[3];
+};
+
+constexpr TemplDesc kTemplates[] = {
+    {0x00, 0, {SlotM, SlotI, SlotI}},  // MII
+    {0x02, 2, {SlotM, SlotI, SlotI}},  // MI_I
+    {0x04, 0, {SlotM, SlotL, SlotX}},  // MLX
+    {0x08, 0, {SlotM, SlotM, SlotI}},  // MMI
+    {0x0a, 1, {SlotM, SlotM, SlotI}},  // M_MI
+    {0x0c, 0, {SlotM, SlotF, SlotI}},  // MFI
+    {0x0e, 0, {SlotM, SlotM, SlotF}},  // MMF
+    {0x10, 0, {SlotM, SlotI, SlotB}},  // MIB
+    {0x12, 0, {SlotM, SlotB, SlotB}},  // MBB
+    {0x16, 0, {SlotB, SlotB, SlotB}},  // BBB
+    {0x18, 0, {SlotM, SlotM, SlotB}},  // MMB
+    {0x1c, 0, {SlotM, SlotF, SlotB}},  // MFB
+};
+constexpr size_t kNumTemplates = sizeof(kTemplates) / sizeof(kTemplates[0]);
+
+// Can |unit| issue from a slot of kind |k|? A-type instructions are the only
+// ones with a choice; L and X are never matched here because an L+X pair is
+// placed by the caller rather than by the slot search.
+inline bool UnitFitsSlot(Unit unit, SlotKind k) {
+  switch (unit) {
+    case UnitM:
+      return k == SlotM;
+    case UnitI:
+      return k == SlotI;
+    case UnitA:
+      return k == SlotM || k == SlotI;
+    case UnitF:
+      return k == SlotF;
+    case UnitB:
+      return k == SlotB;
+    case UnitLX:
+      return false;
+  }
+  return false;
+}
+
+// The nop that pads an unfilled slot. Every unit has one; only the B unit's
+// differs in encoding.
+inline Insn NopForSlot(SlotKind k) {
+  return k == SlotB ? NopBBits(0) : NopBits(0);
+}
+
+// ---------------------------------------------------------------------------
+// The template/slot search, precomputed.
+//
+// The search depends on strictly less than the bundle's contents: only on each
+// instruction's *slot class* and on where the internal stop falls. Two bundles
+// agreeing on those have the same set of legal templates whatever their actual
+// opcodes and operands are, so the whole search collapses into a lookup on an
+// 11-bit key -- three 3-bit classes plus a 2-bit stop position.
+//
+// Worth doing because the search runs on every single instruction emitted, and
+// running it is pure compile-time overhead: it makes the code denser but never
+// changes what the JIT decides to emit. CodeLoad was the one Octane benchmark
+// that regressed when bundling landed (0.98x), and it is exactly the workload
+// that pays for the search without executing the result often enough to be
+// repaid by it.
+//
+// The table is built by constexpr evaluation, so it costs no run-time
+// initialisation, no thread-safe-statics guard, and lives in .rodata.
+// ---------------------------------------------------------------------------
+
+// What the slot search actually distinguishes. |ScB| is a B-unit instruction
+// that is not a branch (nop.b); |ScBr| is one that is, and is pinned to slot 2.
+// Order matters only in that |ScNone| must be the last value: it is the "no
+// instruction here" marker, and the key packs three of these into 9 bits.
+enum SlotClass : uint8_t { ScM, ScI, ScA, ScF, ScB, ScBr, ScLX, ScNone };
+
+constexpr SlotClass ClassOf(uint8_t unit, uint8_t flags) {
+  // brl is a branch *and* an L+X pair; the L+X placement rule wins, exactly as
+  // it does in the search itself, so this test comes first.
+  if (unit == UnitLX) {
+    return ScLX;
+  }
+  if (flags & OpBranch) {
+    return ScBr;
+  }
+  switch (Unit(unit)) {
+    case UnitM:
+      return ScM;
+    case UnitI:
+      return ScI;
+    case UnitA:
+      return ScA;
+    case UnitF:
+      return ScF;
+    case UnitB:
+      return ScB;
+    default:
+      return ScNone;
+  }
+}
+
+// ClassOf() as a 16-entry table on (unit, OpBranch): the bundler classifies
+// every instruction it is offered, and the switch compiles to an indirect
+// branch.
+struct ClassTable {
+  SlotClass c[16];
+  constexpr ClassTable() : c() {
+    for (uint8_t i = 0; i < 16; i++) {
+      c[i] = ClassOf(uint8_t(i >> 1), uint8_t(i & 1) ? uint8_t(OpBranch) : 0);
+    }
+  }
+};
+inline constexpr ClassTable kClassTable{};
+static_assert(OpBranch == 1, "kClassTable indexes by the OpBranch bit");
+
+inline SlotClass ClassOfOp(const Op& op) {
+  return kClassTable.c[((op.unit & 7) << 1) | (op.flags & OpBranch)];
+}
+
+constexpr uint16_t SolveKey(const SlotClass (&c)[3], uint8_t n, int8_t stop) {
+  uint16_t k = 0;
+  for (uint8_t i = 0; i < 3; i++) {
+    k = uint16_t(k | (uint16_t(i < n ? c[i] : ScNone) << (3 * i)));
+  }
+  return uint16_t(k | (uint16_t(stop + 1) << 9));
+}
+
+constexpr size_t kSolveKeys = size_t(1) << 11;
+
+// Result encoding: bit 15 marks a solution, bits 0:3 the template index, and
+// bits 4:5, 6:7, 8:9 the slot each of the three instructions takes. Zero means
+// "no template fits" (and also covers the keys that describe no real bundle).
+constexpr uint16_t kSolved = 0x8000;
+
+constexpr bool ClassFitsSlot(SlotClass c, SlotKind k) {
+  switch (c) {
+    case ScM:
+      return k == SlotM;
+    case ScI:
+      return k == SlotI;
+    case ScA:
+      return k == SlotM || k == SlotI;
+    case ScF:
+      return k == SlotF;
+    case ScB:
+      return k == SlotB;
+    default:
+      return false;
+  }
+}
+
+constexpr bool ClassSlotLegal(const TemplDesc& t, uint8_t i, uint8_t sl,
+                              int8_t stop) {
+  if (stop >= 0) {
+    const bool afterStop = i >= uint8_t(stop);
+    if (afterStop ? (sl < t.gb) : (sl >= t.gb)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// The same backtracking search OpenBundle::assign() used to run, over classes
+// instead of over instructions. First-fit is not complete here -- two A-type
+// ops followed by an M-only op is solvable under MMI only if the second A
+// takes the I slot -- so this has to backtrack.
+//
+// |inOrder| restricts the assignment to slots that increase with program
+// order (|after| is the slot of the previous instruction, -1 for none).
+constexpr bool ClassAssignFrom(const TemplDesc& t, const SlotClass (&c)[3],
+                               uint8_t n, int8_t stop, uint8_t (&out)[3],
+                               uint8_t i, uint8_t used, bool inOrder,
+                               int8_t after) {
+  if (i == n) {
+    return true;
+  }
+  if (c[i] == ScLX) {
+    if (t.slot[1] != SlotL || t.slot[2] != SlotX || (used & 0x6) ||
+        !ClassSlotLegal(t, i, 1, stop) || (inOrder && after >= 1)) {
+      return false;
+    }
+    out[i] = 1;
+    return ClassAssignFrom(t, c, n, stop, out, uint8_t(i + 1),
+                           uint8_t(used | 0x6), inOrder, 2);
+  }
+  if (c[i] == ScBr) {
+    if (t.slot[2] != SlotB || (used & 0x4) || !ClassSlotLegal(t, i, 2, stop) ||
+        (inOrder && after >= 2)) {
+      return false;
+    }
+    out[i] = 2;
+    return ClassAssignFrom(t, c, n, stop, out, uint8_t(i + 1),
+                           uint8_t(used | 0x4), inOrder, 2);
+  }
+  for (uint8_t sl = 0; sl < 3; sl++) {
+    if (used & (1 << sl)) {
+      continue;
+    }
+    if (!ClassFitsSlot(c[i], t.slot[sl]) || !ClassSlotLegal(t, i, sl, stop) ||
+        (inOrder && int8_t(sl) <= after)) {
+      continue;
+    }
+    out[i] = sl;
+    if (ClassAssignFrom(t, c, n, stop, out, uint8_t(i + 1),
+                        uint8_t(used | (1 << sl)), inOrder, int8_t(sl))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The order the search tries the templates in: M-slot templates first
+// (MMI, M_MI, MMF, MMB, MFI, MFB, MLX, then MII, MI_I, MIB, MBB, BBB), so
+// that A-type instructions and the padding take M slots -- four M ports
+// issue together, two I ports -- instead of crowding the I ports. A third
+// I-type instruction in a two-bundle issue window splits issue; nop.i is one.
+// See wiki/hw-dispersal.html; T2's binutils carries the same
+// preference (gas-prefer-M-unit-slots.patch).
+constexpr uint8_t kSearchOrder[kNumTemplates] = {3, 4, 6, 10, 5, 11,
+                                                 2, 0, 1, 7, 8, 9};
+
+constexpr uint16_t SolveOne(uint16_t key, const uint8_t (&order)[kNumTemplates],
+                            bool inOrder) {
+  SlotClass c[3] = {ScNone, ScNone, ScNone};
+  uint8_t n = 0;
+  for (uint8_t i = 0; i < 3; i++) {
+    const SlotClass k = SlotClass((key >> (3 * i)) & 7);
+    if (k == ScNone) {
+      break;
+    }
+    c[i] = k;
+    n++;
+  }
+  // Keys with a hole in them (an absent instruction followed by a present one)
+  // describe no reachable bundle.
+  for (uint8_t i = n; i < 3; i++) {
+    if (SlotClass((key >> (3 * i)) & 7) != ScNone) {
+      return 0;
+    }
+  }
+  const int8_t stop = int8_t(int((key >> 9) & 3) - 1);
+  if (n == 0 || stop >= int8_t(n)) {
+    return 0;
+  }
+  for (size_t oi = 0; oi < kNumTemplates; oi++) {
+    const size_t ti = order[oi];
+    const TemplDesc& t = kTemplates[ti];
+    // The template's internal stop must be exactly the one asked for. An extra
+    // stop would only cost performance, but a missing one is a correctness
+    // bug, and a gratuitous one makes the output unpredictable.
+    if (stop < 0 ? (t.gb != 0) : (t.gb == 0)) {
+      continue;
+    }
+    uint8_t out[3] = {0, 0, 0};
+    if (ClassAssignFrom(t, c, n, stop, out, 0, 0, inOrder, -1)) {
+      return uint16_t(kSolved | uint16_t(ti) | uint16_t(out[0] << 4) |
+                      uint16_t(out[1] << 6) | uint16_t(out[2] << 8));
+    }
+  }
+  return 0;
+}
+
+struct SolveTable {
+  uint16_t e[kSolveKeys];
+  constexpr SolveTable(const uint8_t (&order)[kNumTemplates], bool inOrder)
+      : e() {
+    for (size_t k = 0; k < kSolveKeys; k++) {
+      e[k] = SolveOne(uint16_t(k), order, inOrder);
+    }
+  }
+};
+
+inline constexpr SolveTable kSolveTable{kSearchOrder, false};
+// Slot order = program order, for bundles that must not be permuted.
+inline constexpr SolveTable kSolveTableInOrder{kSearchOrder, true};
+
+// Must |b| (later in program order, same instruction group) stay in a later
+// slot than |a|? When b writes something a reads (WAR), or both may access
+// memory and they are not both plain loads.
+inline bool MustFollow(const Op& a, const Op& b) {
+  for (uint8_t i = 0; i < b.nDef; i++) {
+    for (uint8_t j = 0; j < a.nUse; j++) {
+      if (b.def[i] == a.use[j]) {
+        return true;
+      }
+    }
+  }
+  // A post-increment store writes its base, which does not make it a load.
+  auto plainLoad = [](const Op& op) {
+    return (op.flags & OpMemory) && HasMemResult(op);
+  };
+  if (a.flags & OpCheck) {
+    // Executed ahead of a failing check, a reader of its register would see
+    // the NaT and a store would change the memory the recovery's load reads;
+    // after it they are replayed (Assembler::emitRecoveryCode()).  Other
+    // checks: a chained check's recovery needs its input's check first (it
+    // reads the register).
+    if ((b.flags & OpMemory) && !HasMemResult(b)) {
+      return true;
+    }
+    // A chain check (Scheduler::insertChainChecks()) covers the results of
+    // its whole group: they are its first uses, their number in bitsL.
+    uint32_t nd = uint32_t((a.bitsL >> 44) & 0xf);
+    nd = nd ? nd : 1;
+    for (uint8_t j = 0; j < b.nUse; j++) {
+      for (uint32_t k = 0; k < nd && k < a.nUse; k++) {
+        if (b.use[j] == a.use[k]) {
+          return true;
+        }
+      }
+    }
+  }
+  return a.unit == UnitM && b.unit == UnitM && !(plainLoad(a) && plainLoad(b));
+}
+
+// May |op| sit in a slot after a chk.s in its bundle?  A failing check skips
+// those slots and its recovery code replays them from a copy of the bundle
+// elsewhere, so they must not depend on where they are: no branch (taken, it
+// would leave the copy; its displacement and patch chain are the
+// original's), no L+X pair (movl patch sites), nothing that is not a plain
+// schedulable instruction (OpSched: no IP reads, no patch sites) -- or
+// another check, whose copy gets its own displacement.
+inline bool Replayable(const Op& op) {
+  return (op.flags & OpCheck) ||
+         ((op.flags & OpSched) && !(op.flags & OpBranch) && op.unit != UnitLX);
+}
+
+// ---------------------------------------------------------------------------
+// OpenBundle: the bundle currently being filled.
+// ---------------------------------------------------------------------------
+
+class OpenBundle {
+ public:
+  OpenBundle() { reset(); }
+
+  void reset() {
+    nOps_ = 0;
+    stopBeforeOp_ = -1;
+    tmpl_ = 0;
+    ordered_ = false;
+    key_ = kEmptyKey;
+    lastBranch_ = false;
+    lastLX_ = false;
+    hasCheck_ = false;
+  }
+
+  bool empty() const { return nOps_ == 0; }
+  uint8_t numOps() const { return nOps_; }
+  const Op& op(uint8_t i) const {
+    MOZ_ASSERT(i < nOps_);
+    return ops_[i];
+  }
+
+  // Whether a group may continue this bundle after a stop behind its
+  // instructions, as an M_MI (one in slot 0) or MI_I (slots 0 and 1, the
+  // second an I slot); the pair scheduler takes such bundles over.
+  bool continuableAfterStop() const {
+    if (stopBeforeOp_ >= 0 || lastBranch_ || lastLX_ || nOps_ == 0 ||
+        nOps_ > 2 || slotOf_[0] != 0) {
+      return false;
+    }
+    return nOps_ == 1 ||
+           (slotOf_[1] == 1 && UnitFitsSlot(Unit(ops_[1].unit), SlotI));
+  }
+
+  // True once the bundle holds a branch. Nothing may follow one: the branch
+  // must be the last thing executed in the bundle (a taken branch skips the
+  // remaining slots, and a call returns to the *next* bundle), and
+  // PatchBranchDisp() finds a branch only in slot 2.
+  bool closedByBranch() const { return lastBranch_; }
+
+  // Try to append |op|. |needStop| requires a stop bit between everything
+  // already here and |op|. Returns false, leaving the bundle untouched, if no
+  // template can hold the result -- the caller then closes this bundle and
+  // opens a new one.
+  bool add(const Op& op, bool needStop) { return tryAdd(op, needStop, true); }
+
+  // Would add() succeed? Used to find out which bundle an instruction will land
+  // in before building it, which an IP-relative branch to an already-bound
+  // label has to know in order to compute its own displacement.
+  bool canAdd(const Op& op, bool needStop) {
+    return tryAdd(op, needStop, false);
+  }
+
+ private:
+  bool tryAdd(const Op& op, bool needStop, bool commit) {
+    if (nOps_ >= 3 || closedByBranch()) {
+      return false;
+    }
+    // An L+X instruction takes two slots and only MLX has them, so it can only
+    // ever share a bundle with one M-or-A instruction ahead of it. MLX carries
+    // no internal stop, so a dependent movl/brl has to start a new bundle.
+    if (op.unit == UnitLX) {
+      if (nOps_ > 1 || needStop) {
+        return false;
+      }
+      if (nOps_ == 1 && !UnitFitsSlot(Unit(ops_[0].unit), SlotM)) {
+        return false;
+      }
+    }
+    if (lastLX_) {
+      return false;  // nothing may follow the X slot
+    }
+    // Only one internal stop fits in a bundle.
+    if (needStop && stopBeforeOp_ >= 0) {
+      return false;
+    }
+
+    // The bundle with |op| appended is worked out in locals and only a
+    // successful add writes it back: ops_[0..nOps_) never change, so a probe
+    // or a failed add leaves nothing to restore.
+    //
+    // The template/slot search is a lookup: see SolveTable above. Every state
+    // reachable here is described by (the slot class of each op placed so
+    // far, where the internal stop falls), and kSolveTable holds the answer
+    // for all 2048 of them; key_ is the classes part of that key, kept as ops
+    // are added. Recomputing the assignment from scratch each time -- rather
+    // than extending the previous one -- is what keeps a placement from being
+    // wedged by an earlier greedy template choice.
+    const int8_t stop = needStop ? int8_t(nOps_) : stopBeforeOp_;
+    // The ops already here that share op's instruction group: all of them,
+    // or those after the internal stop when op is too.
+    // Whatever lands after a chk.s in its bundle is replayed by its recovery
+    // code (OpCheck): after a check only replayable instructions, and one
+    // keeps the others in program order, before it.
+    if (hasCheck_ && !Replayable(op)) {
+      return false;
+    }
+    bool ordered = ordered_;
+    for (uint8_t i = 0; !ordered && (op.flags & OpCheck) && i < nOps_; i++) {
+      ordered = !Replayable(ops_[i]);
+    }
+    for (uint8_t i = stop >= 0 ? uint8_t(stop) : 0; !ordered && i < nOps_;
+         i++) {
+      ordered = MustFollow(ops_[i], op);
+    }
+
+    const uint16_t key = uint16_t((key_ & ~(7u << (3 * nOps_))) |
+                                  (uint16_t(ClassOfOp(op)) << (3 * nOps_)));
+    const SolveTable& table = ordered ? kSolveTableInOrder : kSolveTable;
+    const uint16_t r = table.e[key | (uint16_t(stop + 1) << 9)];
+    if (!(r & kSolved)) {
+      return false;
+    }
+    if (commit) {
+      ops_[nOps_] = op;
+      key_ = key;
+      lastBranch_ = (op.flags & OpBranch) != 0;
+      hasCheck_ = hasCheck_ || (op.flags & OpCheck);
+      lastLX_ = op.unit == UnitLX;
+      nOps_++;
+      stopBeforeOp_ = stop;
+      ordered_ = ordered;
+      tmpl_ = uint8_t(r & 0xf);
+      for (uint8_t i = 0; i < nOps_; i++) {
+        slotOf_[i] = uint8_t((r >> (4 + 2 * i)) & 3);
+      }
+    }
+    return true;
+  }
+
+ public:
+
+  // Materialise the bundle. |terminalStop| sets the end-of-bundle stop bit,
+  // which the caller decides only once it knows what comes next.
+  Bundle build(bool terminalStop) const {
+    MOZ_ASSERT(nOps_ > 0);
+    // "This instruction must be immediately followed by a stop; otherwise its
+    // behavior is undefined" -- SDM Volume 3, brl, page 3:30. GNU as does not
+    // check this one, so it has to be enforced here. movl carries no such rule.
+    for (uint8_t i = 0; i < nOps_; i++) {
+      if (ops_[i].unit == UnitLX && (ops_[i].flags & OpBranch)) {
+        terminalStop = true;
+      }
+    }
+    const TemplDesc& t = kTemplates[tmpl_];
+    Insn s[3] = {NopForSlot(t.slot[0]), NopForSlot(t.slot[1]),
+                 NopForSlot(t.slot[2])};
+    for (uint8_t i = 0; i < nOps_; i++) {
+      // "This instruction must be the first instruction in an instruction group
+      // and must either be in instruction slot 0 or in instruction slot 1 of a
+      // template having a stop after slot 0" -- SDM Volume 3, alloc, page 3:34.
+      // GroupDeps forces a stop before an alloc, so it always starts a group;
+      // the M unit only exists in slots 0 and 1, and a group can only start at
+      // slot 1 under a gb == 1 template. This holds by construction, but it is
+      // undefined behaviour rather than a fault if it ever stops holding.
+      MOZ_ASSERT_IF(ops_[i].flags & OpAlloc,
+                    slotOf_[i] == 0 || (slotOf_[i] == 1 && t.gb == 1));
+      if (ops_[i].unit == UnitLX) {
+        MOZ_ASSERT(slotOf_[i] == 1);
+        s[1] = ops_[i].bitsL;
+        s[2] = ops_[i].bits;
+      } else if ((ops_[i].flags & OpCheck) && t.slot[slotOf_[i]] == SlotM) {
+        s[slotOf_[i]] = AsChkSM(ops_[i].bits);  // chk.s.m: M20
+      } else {
+        s[slotOf_[i]] = ops_[i].bits;
+      }
+    }
+    uint8_t enc = uint8_t(t.enc | (terminalStop ? 1 : 0));
+    return MakeBundle(Template(enc), s[0], s[1], s[2]);
+  }
+
+  // Byte offset, within the bundle, of the slot |op| landed in. Only used for
+  // assertions and for the trap-site bookkeeping.
+  uint8_t slotOfLast() const {
+    MOZ_ASSERT(nOps_ > 0);
+    return slotOf_[nOps_ - 1];
+  }
+
+  // Where the i'th instruction *emitted* into this bundle ended up. Used by
+  // the offline verifier to reconstruct program order from a disassembly:
+  // instructions inside one group may be assigned to slots in any order, so
+  // the disassembly alone does not say which came first.
+  uint8_t slotOf(uint8_t i) const {
+    MOZ_ASSERT(i < nOps_);
+    return slotOf_[i];
+  }
+
+ private:
+  // SolveKey() of no instruction: ScNone in all three class fields.
+  static const uint16_t kEmptyKey = uint16_t(ScNone | (ScNone << 3) | (ScNone << 6));
+
+  Op ops_[3];
+  uint8_t slotOf_[3];
+  uint16_t key_;      // SolveKey() of ops_, without the stop field
+  bool lastBranch_;   // the last op is a branch: closedByBranch()
+  bool hasCheck_;     // a chk.s is here: only Replayable() ops may follow
+  bool lastLX_;       // the last op is an L+X pair: nothing may follow
+  uint8_t nOps_;
+  int8_t stopBeforeOp_;  // -1, or the index of the op the internal stop precedes
+  uint8_t tmpl_;         // index into kTemplates
+  bool ordered_;         // some pair in one group must keep its slot order
+};
+
+
+// ---------------------------------------------------------------------------
+// GroupDeps: the resources written so far in the current instruction group.
+//
+// Within an instruction group RAW and WAW register dependencies are not
+// allowed and WAR dependencies are (SDM 1:3.4), so only writes need tracking.
+// Memory is deliberately absent: memory and ALAT RAW/WAW/WAR *are* allowed
+// inside a group and are fully defined -- a load sees the most recent prior
+// store -- so two accesses to the same address may share a bundle.
+//
+// The exceptions modelled here come from Table 5-2 (RAW) and Table 5-3 (WAW)
+// of SDM Volume 3 chapter 5, which are the authoritative form of the prose in
+// Volume 1 section 3.4.1 -- and are stricter than it in one place:
+//
+//   * BR%:   mov-to-BR -> indirect-brs        none      (no stop)
+//            mov-to-BR -> mov-from-BR         impliedF  (stop)
+//            br.call   -> indirect-brs        impliedF  (stop)
+//     So "mov b6=r14; br.call b6" packs into one bundle, but only because the
+//     *writer* is a non-branch. Volume 1 words the exception as a property of
+//     the reader alone; Volume 3 qualifies it with the writer, and that
+//     qualifier is tracked below.
+//
+//   * AR[PFS]: mov-to-AR-PFS -> br.ret        none
+//              mov-to-AR-PFS -> alloc,
+//                               mov-from-AR-PFS   impliedF
+//              br.call       -> br.ret, alloc,
+//                               mov-from-AR-PFS   impliedF
+//     (LLVM's ia64 backend declares AR_PFS as a use of its RET purely to force
+//     a stop there; per this table that stop is not required, so this bundler
+//     does not emit one.)
+//
+//   * PR%:   pr-writers-int -> pr-readers-br  none
+//            pr-writers-fp  -> pr-readers-br  impliedF
+//            pr-writers     -> everything else impliedF
+//     So "cmp p6,p7=...; (p6) br.cond" packs, but "fcmp p6,p7=...; (p6) br"
+//     does not. PR0 is excluded outright: every WAW and RAW on it is "none".
+//
+//   * CFM:   alloc -> cfm-readers             none
+//            br.call, brl.call, br.ret,
+//            clrrrb, cover, rfi -> cfm-readers  impliedF
+//     Every instruction touching a stacked register is a cfm-reader, so rather
+//     than enumerate them a CFM write by anything other than alloc just forces
+//     a stop before whatever comes next.
+//
+//   * alloc must be the first instruction in its instruction group.
+//
+//   * memory: RAW, WAW and WAR are all "none" -- a load sees the most recent
+//     prior store in its own group -- which is why memory is not tracked.
+// ---------------------------------------------------------------------------
+
+class GroupDeps {
+ public:
+  GroupDeps() { clear(); }
+
+  void clear() {
+    gr_ = 0;
+    fr_[0] = fr_[1] = 0;
+    pr_ = 0;
+    prFromFpu_ = 0;
+    br_ = 0;
+    brByBranch_ = 0;
+    ar_ = 0;
+    arByBranch_ = 0;
+    cfm_ = false;
+    hasAlloc_ = false;
+    forceStop_ = false;
+    empty_ = true;
+  }
+
+  bool empty() const { return empty_; }
+
+  // Does a stop bit have to precede |op|?
+  bool conflicts(const Op& op) const {
+    if (empty_) {
+      return false;
+    }
+    if (forceStop_) {
+      return true;
+    }
+    // alloc has to start its instruction group.
+    if (op.flags & OpAlloc) {
+      return true;
+    }
+    // ...and br.call/br.ret/cover/loadrs and friends must not share a group
+    // with one, whatever CFM says.
+    if (hasAlloc_ && (op.flags & OpBranch)) {
+      return true;
+    }
+
+    const bool isBranch = (op.flags & OpBranch) != 0;
+
+    // The classes are tested in order of frequency, GRs first, rather than
+    // switched on: a switch compiles to a jump table, an indirect branch per
+    // operand of every instruction.
+    for (uint8_t i = 0; i < op.nUse; i++) {
+      uint16_t r = op.use[i];
+      uint32_t n = r & 0xff;
+      const ResClass c = ResClass(r >> 8);
+      if (c == ResGr) {
+        if (grWritten(n)) {
+          return true;
+        }
+        continue;
+      }
+      if (c == ResPr) {
+        // A predicate written by a non-FP instruction is visible to a
+        // branch in the same group; one written by an F-unit instruction
+        // is not.
+        if (prWritten(n) &&
+            (!isBranch || (prFromFpu_ & (uint64_t(1) << (n & 63))))) {
+          return true;
+        }
+        continue;
+      }
+      if (c == ResFr) {
+        if (frWritten(n)) {
+          return true;
+        }
+        continue;
+      }
+      switch (c) {
+        case ResBr:
+          // A branch may read a BR written earlier in its group, but only if
+          // the writer was a non-branch: br.call -> indirect-brs is impliedF.
+          if ((br_ & (1u << (n & 7))) &&
+              (!isBranch || (brByBranch_ & (1u << (n & 7))))) {
+            return true;
+          }
+          break;
+        case ResAr:
+          if (n == ArPfs) {
+            // Same qualifier: mov-to-AR-PFS -> br.ret is none, but
+            // br.call -> br.ret is impliedF.
+            if ((ar_ & kArPfsBit) && (!isBranch || (arByBranch_ & kArPfsBit))) {
+              return true;
+            }
+          } else if (n == ArCcv) {
+            if (ar_ & kArCcvBit) {
+              return true;
+            }
+          } else if (ar_ & kArOtherBit) {
+            return true;
+          }
+          break;
+        case ResCfm:
+          if (cfm_ && !hasAlloc_) {
+            return true;
+          }
+          break;
+        default:
+          break;
+      }
+    }
+
+    // WAW. The architecture permits it for compare-type instructions writing
+    // the same predicate with matching .and/.or completers, and for the FPSR
+    // and PSR bits every FP instruction touches (which are not modelled at
+    // all); neither is worth exploiting here, so every other WAW takes a stop.
+    for (uint8_t i = 0; i < op.nDef; i++) {
+      uint16_t r = op.def[i];
+      uint32_t n = r & 0xff;
+      const ResClass c = ResClass(r >> 8);
+      if (c == ResGr) {
+        if (grWritten(n)) {
+          return true;
+        }
+        continue;
+      }
+      if (c == ResPr) {
+        if (prWritten(n)) {
+          return true;
+        }
+        continue;
+      }
+      if (c == ResFr) {
+        if (frWritten(n)) {
+          return true;
+        }
+        continue;
+      }
+      switch (c) {
+        case ResBr:
+          if (br_ & (1u << (n & 7))) {
+            return true;
+          }
+          break;
+        case ResAr:
+          if (ar_ & arBit(n)) {
+            return true;
+          }
+          break;
+        case ResCfm:
+          if (cfm_) {
+            return true;
+          }
+          break;
+        default:
+          break;
+      }
+    }
+    return false;
+  }
+
+  // Fold |op|'s writes into the group.
+  void add(const Op& op) {
+    empty_ = false;
+    const bool isFpu = (op.flags & OpFpu) != 0;
+    const bool isBranch = (op.flags & OpBranch) != 0;
+    for (uint8_t i = 0; i < op.nDef; i++) {
+      uint16_t r = op.def[i];
+      uint32_t n = r & 0xff;
+      const ResClass c = ResClass(r >> 8);
+      if (c == ResGr) {
+        gr_ |= uint64_t(1) << (n & 63);
+        continue;
+      }
+      if (c == ResPr) {
+        pr_ |= uint64_t(1) << (n & 63);
+        if (isFpu) {
+          prFromFpu_ |= uint64_t(1) << (n & 63);
+        }
+        continue;
+      }
+      if (c == ResFr) {
+        fr_[(n >> 6) & 1] |= uint64_t(1) << (n & 63);
+        continue;
+      }
+      switch (c) {
+        case ResBr:
+          br_ |= uint8_t(1u << (n & 7));
+          if (isBranch) {
+            brByBranch_ |= uint8_t(1u << (n & 7));
+          }
+          break;
+        case ResAr:
+          ar_ |= arBit(n);
+          if (isBranch) {
+            arByBranch_ |= arBit(n);
+          }
+          break;
+        case ResCfm:
+          cfm_ = true;
+          break;
+        default:
+          break;
+      }
+    }
+    if (op.flags & OpAlloc) {
+      hasAlloc_ = true;
+      // Cheap belt and braces: alloc happens once per trampoline, so ending
+      // its group costs nothing and keeps the "not allowed after alloc" list
+      // (flushrs, loadrs, mov from AR[BSPSTORE]/AR[RNAT], br.*, cover, rfi)
+      // out of reach without enumerating it.
+      forceStop_ = true;
+    }
+    // A CFM write from a *predicated* br.call would otherwise be invisible to
+    // the stacked-register readers that follow it in the same group. An
+    // unconditional one ends the group anyway.
+    if (cfm_ && !hasAlloc_) {
+      forceStop_ = true;
+    }
+  }
+
+ private:
+  static const uint32_t kArPfsBit = 1u << 0;
+  static const uint32_t kArCcvBit = 1u << 1;
+  static const uint32_t kArOtherBit = 1u << 2;
+
+  static uint32_t arBit(uint32_t n) {
+    return n == ArPfs ? kArPfsBit : n == ArCcv ? kArCcvBit : kArOtherBit;
+  }
+  bool grWritten(uint32_t n) const {
+    return (gr_ & (uint64_t(1) << (n & 63))) != 0;
+  }
+  bool frWritten(uint32_t n) const {
+    return (fr_[(n >> 6) & 1] & (uint64_t(1) << (n & 63))) != 0;
+  }
+  bool prWritten(uint32_t n) const {
+    return (pr_ & (uint64_t(1) << (n & 63))) != 0;
+  }
+
+  uint64_t gr_;
+  uint64_t fr_[2];
+  uint64_t pr_;
+  uint64_t prFromFpu_;
+  uint8_t br_;
+  uint8_t brByBranch_;  // subset of br_ whose writer was a branch
+  uint32_t ar_;
+  uint32_t arByBranch_;  // ditto for the ARs
+  bool cfm_;
+  bool hasAlloc_;
+  bool forceStop_;
+  bool empty_;
+};
+
+
+// ---------------------------------------------------------------------------
+// BundleStream: the instruction-to-bundle state machine.
+//
+// |Sink| supplies the buffer:
+//   uint32_t offset() const           end of the buffer, in bytes
+//   void reserve()                    append 16 bytes, contents unspecified
+//   void append(const Bundle&)        append 16 bytes
+//   void rewrite(uint32_t, const Bundle&)   overwrite an earlier bundle
+//   bool failed() const               the buffer is out of memory
+//
+// The open bundle's 16 bytes are reserved when it opens -- its offset is
+// final from then on -- but written only when it closes, or when syncOpen()
+// asks: building and storing it after every instruction added was a fifth of
+// the bundler's time.  Until then those bytes are not code.  Everything that
+// reads the buffer back goes through Assembler::bundleAt(), which closes the
+// open bundle first if that is the one asked for, or calls syncOpen()
+// (executableCopy()).
+// ---------------------------------------------------------------------------
+
+template <class Sink>
+class BundleStream {
+ public:
+  explicit BundleStream(Sink* sink) : sink_(sink) {}
+
+  // Emit one instruction; returns the byte offset of the bundle it landed in.
+  uint32_t emit(const Op& op) {
+    emitIdx_++;
+    if (noBundleDepth_ != 0) {
+      flush();
+      uint32_t off = sink_->offset();
+      sink_->append(LoneBundle(op));
+      return off;
+    }
+
+    const bool needStop = deps_.conflicts(op);
+
+    if (haveOpen_ && !sealed_ && open_.add(op, needStop)) {
+      if (needStop) {
+        deps_.clear();
+      }
+      deps_.add(op);
+    } else {
+      // Does not fit. Closing the bundle is where its end-of-bundle stop bit
+      // is finally decided: it is needed exactly when this instruction has a
+      // dependency on the group that ends there.
+      closeOpen(needStop);
+      if (needStop) {
+        deps_.clear();
+      }
+      openOff_ = sink_->offset();
+      firstEmitIdx_ = emitIdx_;
+      open_.reset();
+      MOZ_ALWAYS_TRUE(open_.add(op, false));
+      deps_.add(op);
+      haveOpen_ = true;
+      sink_->reserve();
+    }
+
+    const uint32_t landed = openOff_;
+
+    // An unconditionally taken branch ends the instruction group on its own, as
+    // does break.b, so nothing after it can depend on anything before it and
+    // the group state is dropped. The stop bit is set anyway: the group has
+    // already ended by the time it would matter, so it is free, and without it
+    // the emitted code relies on the "taken branch ends the group" rule in a
+    // way no external checker -- GNU as included -- can see.
+    //
+    // A *conditional* branch is left alone. On the not-taken path the group
+    // runs on into the next bundle, and the ordinary machinery gets that right;
+    // that is worth real cycles, since almost every guard in Ion and Baseline
+    // is a not-taken conditional branch.
+    if (op.flags & (OpBranch | OpEndsGroup)) {
+      if (op.qp() == 0 || (op.flags & OpEndsGroup)) {
+        closeOpen(/* terminalStop = */ true);
+        deps_.clear();
+      }
+    }
+    return landed;
+  }
+
+  // Byte offset of the bundle |op| will land in if emitted next. An
+  // IP-relative branch to an already-bound label needs this before it can be
+  // built: with bundling the branch may join the bundle that is already open,
+  // which sits one bundle below the end of the buffer. The probe and the
+  // subsequent emit agree because a branch's unit, flags and operands do not
+  // depend on its displacement -- only its immediate bits do.
+  uint32_t probeOffset(const Op& op) {
+    if (noBundleDepth_ == 0 && haveOpen_ && !sealed_ &&
+        open_.canAdd(op, deps_.conflicts(op))) {
+      return openOff_;
+    }
+    return sink_->offset();
+  }
+
+  // Seal the open bundle against further instructions, but leave its stop bit
+  // undecided and |deps_| intact: the instruction group runs on into the next
+  // bundle, and the ordinary machinery still inserts a stop there if one turns
+  // out to be needed.
+  //
+  // This is what every caller that only wants a stable byte offset should use
+  // -- bind(), currentOffset(). Bundles and instruction groups are independent:
+  // the group is delimited by stop bits and freely spans bundles, so sealing
+  // one costs only its unused slots, while ending the group as well costs a
+  // pipeline split the caller never asked for.
+  //
+  // Nothing is written here. The open bundle is already in the buffer with its
+  // stop bit set (the conservative state), and closeOpen() will clear it later
+  // if the next instruction turns out not to depend on this group -- so the
+  // buffer stays correct at every point, exactly as before.
+  //
+  // Carrying |deps_| across a bind() is correct, not merely optimistic. A
+  // label has two predecessors: control arriving via the branch starts a fresh
+  // group regardless (a taken branch ends the group architecturally), so it
+  // contributes no pending writes, and control arriving by fall-through is
+  // exactly what |deps_| already describes. The union is therefore just the
+  // fall-through state. Dropping the stop *without* carrying the state would
+  // miss real RAW hazards -- which is precisely where the LLVM ia64 bundling
+  // pass had two of its bugs.
+  void softFlush() { sealed_ = true; }
+
+  // True if |off| names the bundle still being assembled. Patching that bundle
+  // in place is unsafe -- closeOpen() rebuilds it from |open_| and would undo
+  // the patch -- so bundleAt() uses this to decide whether it has to close.
+  bool isOpenAt(uint32_t off) const { return haveOpen_ && off == openOff_; }
+
+  // Write the open bundle into its place, with its end-of-bundle stop set --
+  // the conservative state -- without closing it: for a caller that copies the
+  // buffer out while a bundle may still be open.
+  void syncOpen() {
+    if (haveOpen_) {
+      rewriteOpen(/* terminalStop = */ true);
+    }
+  }
+
+  void flush() {
+    if (haveOpen_) {
+      closeOpen(/* terminalStop = */ true);
+    }
+    deps_.clear();
+  }
+
+  bool unbundled() const { return noBundleDepth_ != 0; }
+
+  // Scheduler::drain(): hands the open bundle over to a
+  // caller that continues it after a mid-bundle stop
+  // (OpenBundle::continuableAfterStop()). Returns the number of its
+  // instructions, copied to |ops| (0: none handed over, nothing changed),
+  // and in |off| the offset reserved for it, where the caller writes the
+  // bundle. The instruction group ends there.
+  uint8_t takeOpen(Op* ops, uint32_t* off) {
+    if (noBundleDepth_ != 0 || !haveOpen_ || sealed_ ||
+        !open_.continuableAfterStop()) {
+      return 0;
+    }
+    const uint8_t n = open_.numOps();
+    for (uint8_t i = 0; i < n; i++) {
+      ops[i] = open_.op(i);
+    }
+    *off = openOff_;
+    haveOpen_ = false;
+    open_.reset();
+    deps_.clear();
+    return n;
+  }
+
+  // The current instruction group also holds |op|, written elsewhere: the
+  // next instructions emitted get a stop before them if they depend on it.
+  void noteGroup(const Op& op) { deps_.add(op); }
+
+  // Whether |op| emitted next would need a stop before it: it depends on
+  // the instruction group still open.
+  bool groupConflicts(const Op& op) const {
+    return noBundleDepth_ == 0 && deps_.conflicts(op);
+  }
+
+  void enterUnbundled() {
+    flush();
+    noBundleDepth_++;
+  }
+  void leaveUnbundled() {
+    MOZ_ASSERT(noBundleDepth_ > 0);
+    noBundleDepth_--;
+    flush();
+  }
+
+ private:
+  void rewriteOpen(bool terminalStop) {
+    if (sink_->failed()) {
+      return;
+    }
+    sink_->rewrite(openOff_, open_.build(terminalStop));
+  }
+
+  void closeOpen(bool terminalStop) {
+    if (haveOpen_) {
+      rewriteOpen(terminalStop);
+      sink_->closed(openOff_, open_, firstEmitIdx_);
+      haveOpen_ = false;
+      sealed_ = false;
+      open_.reset();
+    }
+  }
+
+  Sink* sink_;
+  OpenBundle open_;
+  GroupDeps deps_;
+  uint32_t openOff_ = 0;
+  uint32_t emitIdx_ = 0;      // instructions emitted so far, 1-based
+  uint32_t firstEmitIdx_ = 0; // emitIdx_ of the open bundle's first instruction
+  bool haveOpen_ = false;
+  bool sealed_ = false;        // open_ is final in content, not yet in stop bit
+  uint32_t noBundleDepth_ = 0;
+};
+
+}  // namespace ia64
+}  // namespace jit
+}  // namespace js
+
+#endif /* jit_ia64_Bundler_ia64_h */
diff --git a/js/src/jit/ia64/CodeGenerator-ia64.cpp b/js/src/jit/ia64/CodeGenerator-ia64.cpp
new file mode 100644
--- /dev/null
+++ b/js/src/jit/ia64/CodeGenerator-ia64.cpp
@@ -0,0 +1,2308 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#include "jit/ia64/CodeGenerator-ia64.h"
+
+#include "mozilla/MathAlgorithms.h"
+
+#include "jit/CodeGenerator.h"
+#include "jit/InlineScriptTree.h"
+#include "jit/JitRuntime.h"
+#include "jit/MIR-wasm.h"
+#include "jit/MIR.h"
+#include "jit/MIRGraph.h"
+
+#include "jit/shared/CodeGenerator-shared-inl.h"
+
+using namespace js;
+using namespace js::jit;
+
+using JS::GenericNaN;
+using mozilla::NegativeInfinity;
+
+// r0 is hardwired to zero and f0 to +0.0, so neither needs materialising.
+static constexpr Register Zero{Registers::zero};
+static constexpr FloatRegister FPZero{FloatRegisters::f0, FloatRegister::Double};
+static constexpr FloatRegister FPZeroSingle{FloatRegisters::f0,
+                                            FloatRegister::Single};
+
+// IA-64 is a three-address machine, so the arithmetic below is emitted through
+// the instruction encoders rather than the two-address MacroAssembler forms:
+// that avoids having to shuffle registers when the output aliases an input.
+//
+// There used to be a second Emit3() for the variable shifts, because they are
+// I-unit only and putting one in slot 0 of an MII bundle makes the hardware
+// decode it as an M-unit memory op instead (shl r14=r14,r2 reads as
+// ldf8.a f14=[r2]). The encoders now carry their own unit and the bundler
+// places them accordingly, so the distinction has moved to where it belongs
+// and one entry point covers both.
+static void Emit3(MacroAssembler& masm,
+                  ia64::Op (*make)(uint32_t, uint32_t, uint32_t, uint32_t),
+                  Register d, Register a, Register b) {
+  masm.emit(make(d.encoding(), a.encoding(), b.encoding(), 0));
+}
+
+// dest = src + imm in one adds when the constant fits imm14: IA-64 is
+// three-address, so copying src into dest first only adds a dependent step.
+static bool AddImm3(MacroAssembler& masm, Register dest, Register src,
+                    int64_t imm) {
+  if (imm < -8192 || imm > 8191) {
+    return false;
+  }
+  masm.emitM(ia64::Adds(dest.encoding(), imm, src.encoding()));
+  return true;
+}
+
+static void SignExtend32(MacroAssembler& masm, Register dest, Register src) {
+  masm.emitI(ia64::Sxt4(dest.encoding(), src.encoding()));
+}
+
+static void ZeroExtend32(MacroAssembler& masm, Register dest, Register src) {
+  masm.emitI(ia64::Zxt4(dest.encoding(), src.encoding()));
+}
+
+CodeGeneratorIa64::CodeGeneratorIa64(MIRGenerator* gen, LIRGraph* graph,
+                                     MacroAssembler* masm,
+                                     const wasm::CodeMetadata* wasmCodeMeta)
+    : CodeGeneratorShared(gen, graph, masm, wasmCodeMeta) {}
+
+void CodeGeneratorIa64::branchToBlock(FloatFormat fmt, FloatRegister lhs,
+                                      FloatRegister rhs, MBasicBlock* mir,
+                                      Assembler::DoubleCondition cond) {
+  Label* label = skipTrivialBlocks(mir)->lir()->label();
+  if (fmt == DoubleFloat) {
+    masm.branchDouble(cond, lhs, rhs, label);
+  } else {
+    masm.branchFloat(cond, lhs, rhs, label);
+  }
+}
+
+MoveOperand CodeGeneratorIa64::toMoveOperand(LAllocation a) const {
+  if (a.isGeneralReg()) {
+    return MoveOperand(ToRegister(a));
+  }
+  if (a.isFloatReg()) {
+    return MoveOperand(ToFloatRegister(a));
+  }
+  MoveOperand::Kind kind = a.isStackArea() ? MoveOperand::Kind::EffectiveAddress
+                                           : MoveOperand::Kind::Memory;
+  return MoveOperand(ToAddress(a), kind);
+}
+
+bool CodeGeneratorIa64::generateOutOfLineCode() {
+  if (!CodeGeneratorShared::generateOutOfLineCode()) {
+    return false;
+  }
+
+  if (needsDeoptLabel()) {
+    // All non-table-based bailouts land here.
+    masm.bind(&deoptLabel_);
+
+    // Push the frame size so the handler can recover the IonScript.
+    masm.push(Imm32(frameSize()));
+
+    TrampolinePtr handler = gen->jitRuntime()->getGenericBailoutHandler();
+    masm.jump(handler);
+  }
+
+  return !masm.oom();
+}
+
+class js::jit::OutOfLineTableSwitch
+    : public OutOfLineCodeBase<CodeGeneratorIa64> {
+  MTableSwitch* mir_;
+  CodeLabel jumpLabel_;
+
+  void accept(CodeGeneratorIa64* codegen) {
+    codegen->visitOutOfLineTableSwitch(this);
+  }
+
+ public:
+  explicit OutOfLineTableSwitch(MTableSwitch* mir) : mir_(mir) {}
+
+  MTableSwitch* mir() const { return mir_; }
+
+  CodeLabel* jumpLabel() { return &jumpLabel_; }
+};
+
+void CodeGeneratorIa64::emitTableSwitchDispatch(MTableSwitch* mir,
+                                                Register index,
+                                                Register base) {
+  Label* defaultcase = skipTrivialBlocks(mir->getDefault())->lir()->label();
+
+  if (mir->low() != 0) {
+    masm.sub32(Imm32(mir->low()), index);
+  }
+
+  int32_t cases = mir->numCases();
+  masm.branch32(Assembler::AboveOrEqual, index, Imm32(cases), defaultcase);
+
+  // The case entries do not exist yet, so the table is emitted out of line and
+  // its address patched in afterwards.
+  OutOfLineTableSwitch* ool = new (alloc()) OutOfLineTableSwitch(mir);
+  addOutOfLineCode(ool, mir);
+
+  masm.mov(ool->jumpLabel(), base);
+  BaseIndex pointer(base, index, ScalePointer);
+  masm.branchToComputedAddress(pointer);
+}
+
+void CodeGeneratorIa64::generateInvalidateEpilogue() {
+  // Leave room for the OsiPoint patching so it cannot overwrite the epilogue.
+  // One IA-64 bundle is 16 bytes, comfortably more than a pointer.
+  masm.nop();
+
+  masm.bind(&invalidate_);
+
+  // InvalidationBailoutStack ends in {ionScript_, osiPointReturnAddress_}, so
+  // the return address of the patched-in call has to be spilled here: it is in
+  // b0 rather than already on the stack the way a x86 call leaves it.
+  masm.pushReturnAddress();
+
+  invalidateEpilogueData_ = masm.pushWithPatch(ImmWord(uintptr_t(-1)));
+
+  TrampolinePtr thunk = gen->jitRuntime()->getInvalidationThunk();
+  masm.jump(thunk);
+}
+
+void CodeGeneratorIa64::visitOutOfLineTableSwitch(OutOfLineTableSwitch* ool) {
+  MTableSwitch* mir = ool->mir();
+
+  masm.haltingAlign(sizeof(void*));
+  masm.bind(ool->jumpLabel());
+  masm.addCodeLabel(*ool->jumpLabel());
+
+  for (size_t i = 0; i < mir->numCases(); i++) {
+    LBlock* caseblock = skipTrivialBlocks(mir->getCase(i))->lir();
+    Label* caseheader = caseblock->label();
+    uint32_t caseoffset = caseheader->offset();
+
+    // Table entries are absolute addresses and must be patched once codegen
+    // has finished.
+    CodeLabel cl;
+    masm.writeCodePointer(&cl);
+    cl.target()->bind(caseoffset);
+    masm.addCodeLabel(cl);
+  }
+
+  masm.alignToBundle();
+}
+
+void CodeGeneratorIa64::visitOutOfLineWasmTruncateCheck(
+    OutOfLineWasmTruncateCheck* ool) {
+  FloatRegister input = ool->input();
+  Register output = ool->output();
+  Register64 output64 = ool->output64();
+  MIRType fromType = ool->fromType();
+  MIRType toType = ool->toType();
+  Label* oolRejoin = ool->rejoin();
+  TruncFlags flags = ool->flags();
+  wasm::TrapSiteDesc off = ool->trapSiteDesc();
+
+  if (fromType == MIRType::Float32) {
+    if (toType == MIRType::Int32) {
+      masm.oolWasmTruncateCheckF32ToI32(input, output, flags, off, oolRejoin,
+                                        nullptr, nullptr);
+    } else if (toType == MIRType::Int64) {
+      masm.oolWasmTruncateCheckF32ToI64(input, output64, flags, off, oolRejoin,
+                                        nullptr, nullptr);
+    } else {
+      MOZ_CRASH("unexpected type");
+    }
+  } else if (fromType == MIRType::Double) {
+    if (toType == MIRType::Int32) {
+      masm.oolWasmTruncateCheckF64ToI32(input, output, flags, off, oolRejoin,
+                                        nullptr, nullptr);
+    } else if (toType == MIRType::Int64) {
+      masm.oolWasmTruncateCheckF64ToI64(input, output64, flags, off, oolRejoin,
+                                        nullptr, nullptr);
+    } else {
+      MOZ_CRASH("unexpected type");
+    }
+  } else {
+    MOZ_CRASH("unexpected type");
+  }
+}
+
+// The flexible*Ptr/32 helpers divide inline (frcpa + Newton) and never call
+// out, so they ignore the volatile set entirely. Passing liveVolatileRegs(ins)
+// instead would dereference ins->safepoint(), which is null on the LIR nodes
+// that reach here.
+void CodeGeneratorIa64::emitBigIntPtrDiv(LBigIntPtrDiv* ins, Register dividend,
+                                         Register divisor, Register output) {
+  masm.flexibleQuotientPtr(dividend, divisor, output, /* isUnsigned = */ false,
+                           LiveRegisterSet());
+}
+
+void CodeGeneratorIa64::emitBigIntPtrMod(LBigIntPtrMod* ins, Register dividend,
+                                         Register divisor, Register output) {
+  masm.flexibleRemainderPtr(dividend, divisor, output, /* isUnsigned = */ false,
+                            LiveRegisterSet());
+}
+
+// ===========================================================================
+// Boxing.
+
+void CodeGenerator::visitBox(LBox* ins) {
+  const LAllocation* in = ins->payload();
+  ValueOperand result = ToOutValue(ins);
+
+  masm.moveValue(TypedOrValueRegister(ins->type(), ToAnyRegister(in)), result);
+}
+
+void CodeGenerator::visitUnbox(LUnbox* ins) {
+  MUnbox* mir = ins->mir();
+
+  Register result = ToRegister(ins->output());
+
+  if (mir->fallible()) {
+    ValueOperand value = ToValue(ins->input());
+    Label bail;
+    switch (mir->type()) {
+      case MIRType::Int32:
+        masm.fallibleUnboxInt32(value, result, &bail);
+        break;
+      case MIRType::Boolean:
+        masm.fallibleUnboxBoolean(value, result, &bail);
+        break;
+      case MIRType::Object:
+        masm.fallibleUnboxObject(value, result, &bail);
+        break;
+      case MIRType::String:
+        masm.fallibleUnboxString(value, result, &bail);
+        break;
+      case MIRType::Symbol:
+        masm.fallibleUnboxSymbol(value, result, &bail);
+        break;
+      case MIRType::BigInt:
+        masm.fallibleUnboxBigInt(value, result, &bail);
+        break;
+      default:
+        MOZ_CRASH("Given MIRType cannot be unboxed.");
+    }
+    bailoutFrom(&bail, ins->snapshot());
+    return;
+  }
+
+  LAllocation* input = ins->getOperand(LUnbox::Input);
+  if (input->isGeneralReg()) {
+    // ValueOperand's Register constructor is explicit; passing the bare
+    // Register instead binds to the catch-all MOZ_CRASH template overload.
+    ValueOperand inputReg = ValueOperand(ToRegister(input));
+    switch (mir->type()) {
+      case MIRType::Int32:
+        masm.unboxInt32(inputReg, result);
+        break;
+      case MIRType::Boolean:
+        masm.unboxBoolean(inputReg, result);
+        break;
+      case MIRType::Object:
+        masm.unboxObject(inputReg, result);
+        break;
+      case MIRType::String:
+        masm.unboxString(inputReg, result);
+        break;
+      case MIRType::Symbol:
+        masm.unboxSymbol(inputReg, result);
+        break;
+      case MIRType::BigInt:
+        masm.unboxBigInt(inputReg, result);
+        break;
+      default:
+        MOZ_CRASH("Given MIRType cannot be unboxed.");
+    }
+    return;
+  }
+
+  Address inputAddr = ToAddress(input);
+  switch (mir->type()) {
+    case MIRType::Int32:
+      masm.unboxInt32(inputAddr, result);
+      break;
+    case MIRType::Boolean:
+      masm.unboxBoolean(inputAddr, result);
+      break;
+    case MIRType::Object:
+      masm.unboxObject(inputAddr, result);
+      break;
+    case MIRType::String:
+      masm.unboxString(inputAddr, result);
+      break;
+    case MIRType::Symbol:
+      masm.unboxSymbol(inputAddr, result);
+      break;
+    case MIRType::BigInt:
+      masm.unboxBigInt(inputAddr, result);
+      break;
+    default:
+      MOZ_CRASH("Given MIRType cannot be unboxed.");
+  }
+}
+
+// ===========================================================================
+// Integer arithmetic.
+
+template <class LIR>
+static void TrapIfDivideByZero(MacroAssembler& masm, LIR* lir, Register rhs) {
+  auto* mir = lir->mir();
+  MOZ_ASSERT(mir->trapOnError());
+
+  if (mir->canBeDivideByZero()) {
+    Label nonZero;
+    masm.branchPtr(Assembler::NotEqual, rhs, Zero, &nonZero);
+    masm.wasmTrap(wasm::Trap::IntegerDivideByZero, mir->trapSiteDesc());
+    masm.bind(&nonZero);
+  }
+}
+
+// A checked int32 add or sub.  The 64-bit result of two canonical
+// (sign-extended) int32 values is exact, so the operation overflowed exactly
+// when truncating it back to 32 bits changes it; when it did not, the exact
+// result already is the canonical one.  So it goes straight into the output,
+// and the sxt4 only feeds the check, off the result's dependence chain.
+//
+// Making the output reuse the lhs register, with an out-of-line undo before
+// the bailout as on x86 (recoversInput), was measured and lost 2%: with a
+// three-address add it only adds copies where the old value stays live.
+void CodeGeneratorIa64::emitCheckedAddSub(LInstruction* ins, bool isAdd) {
+  const LAllocation* rhs = ins->getOperand(1);
+  Register lhs = ToRegister(ins->getOperand(0));
+  Register dest = ToRegister(ins->getDef(0));
+  int64_t imm = rhs->isConstant()
+                    ? (isAdd ? int64_t(ToInt32(rhs)) : -int64_t(ToInt32(rhs)))
+                    : 0;
+
+  SecondScratchRegisterScope scratch(masm);
+  if (rhs->isConstant() && imm >= -8192 && imm <= 8191) {
+    masm.emitM(ia64::Adds(dest.encoding(), imm, lhs.encoding()));
+  } else if (rhs->isConstant()) {
+    masm.movePtr(ImmWord(uint64_t(imm)), scratch);
+    Emit3(masm, ia64::Add, dest, lhs, scratch);
+  } else {
+    Emit3(masm, isAdd ? ia64::Add : ia64::Sub, dest, lhs, ToRegister(rhs));
+  }
+  SignExtend32(masm, scratch, dest);
+  bailoutCmpPtr(Assembler::NotEqual, dest, Register(scratch), ins->snapshot());
+}
+
+void CodeGenerator::visitAddI(LAddI* ins) {
+  const LAllocation* rhs = ins->rhs();
+  Register lhs = ToRegister(ins->lhs());
+  Register dest = ToRegister(ins->output());
+
+  if (!ins->snapshot()) {
+    if (rhs->isConstant() && ToInt32(rhs) >= -8192 && ToInt32(rhs) <= 8191) {
+      masm.emitM(ia64::Adds(dest.encoding(), ToInt32(rhs), lhs.encoding()));
+    } else if (rhs->isConstant()) {
+      masm.move32(lhs, dest);
+      masm.add32(Imm32(ToInt32(rhs)), dest);
+    } else {
+      Emit3(masm, ia64::Add, dest, lhs, ToRegister(rhs));
+    }
+    SignExtend32(masm, dest, dest);
+    return;
+  }
+
+  emitCheckedAddSub(ins, /* isAdd = */ true);
+}
+
+void CodeGenerator::visitAddIntPtr(LAddIntPtr* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  const LAllocation* rhs = ins->rhs();
+  Register dest = ToRegister(ins->output());
+
+  if (rhs->isConstant() && AddImm3(masm, dest, lhs, ToIntPtr(rhs))) {
+    return;
+  }
+  if (rhs->isConstant()) {
+    masm.movePtr(lhs, dest);
+    masm.addPtr(ImmWord(ToIntPtr(rhs)), dest);
+  } else {
+    Emit3(masm, ia64::Add, dest, lhs, ToRegister(rhs));
+  }
+}
+
+void CodeGenerator::visitAddI64(LAddI64* ins) {
+  Register lhs = ToRegister64(ins->lhs()).reg;
+  LInt64Allocation rhs = ins->rhs();
+  Register dest = ToOutRegister64(ins).reg;
+
+  if (IsConstant(rhs) && AddImm3(masm, dest, lhs, ToInt64(rhs))) {
+    return;
+  }
+  if (IsConstant(rhs)) {
+    masm.movePtr(lhs, dest);
+    masm.add64(Imm64(ToInt64(rhs)), Register64(dest));
+  } else {
+    Emit3(masm, ia64::Add, dest, lhs, ToRegister64(rhs).reg);
+  }
+}
+
+void CodeGenerator::visitSubI(LSubI* ins) {
+  const LAllocation* rhs = ins->rhs();
+  Register lhs = ToRegister(ins->lhs());
+  Register dest = ToRegister(ins->output());
+
+  if (!ins->snapshot()) {
+    if (rhs->isConstant() &&
+        AddImm3(masm, dest, lhs, -int64_t(ToInt32(rhs)))) {
+      // done
+    } else if (rhs->isConstant()) {
+      masm.move32(lhs, dest);
+      masm.sub32(Imm32(ToInt32(rhs)), dest);
+    } else {
+      Emit3(masm, ia64::Sub, dest, lhs, ToRegister(rhs));
+    }
+    SignExtend32(masm, dest, dest);
+    return;
+  }
+
+  emitCheckedAddSub(ins, /* isAdd = */ false);
+}
+
+void CodeGenerator::visitSubIntPtr(LSubIntPtr* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  const LAllocation* rhs = ins->rhs();
+  Register dest = ToRegister(ins->output());
+
+  if (rhs->isConstant() && ToIntPtr(rhs) != INTPTR_MIN &&
+      AddImm3(masm, dest, lhs, -ToIntPtr(rhs))) {
+    return;
+  }
+  if (rhs->isConstant()) {
+    masm.movePtr(lhs, dest);
+    masm.subPtr(Imm32(ToIntPtr(rhs)), dest);
+  } else {
+    Emit3(masm, ia64::Sub, dest, lhs, ToRegister(rhs));
+  }
+}
+
+void CodeGenerator::visitSubI64(LSubI64* ins) {
+  Register lhs = ToRegister64(ins->lhs()).reg;
+  LInt64Allocation rhs = ins->rhs();
+  Register dest = ToOutRegister64(ins).reg;
+
+  if (IsConstant(rhs) && ToInt64(rhs) != INT64_MIN &&
+      AddImm3(masm, dest, lhs, -ToInt64(rhs))) {
+    return;
+  }
+  if (IsConstant(rhs)) {
+    masm.movePtr(lhs, dest);
+    masm.sub64(Imm64(ToInt64(rhs)), Register64(dest));
+  } else {
+    Emit3(masm, ia64::Sub, dest, lhs, ToRegister64(rhs).reg);
+  }
+}
+
+void CodeGenerator::visitMulI(LMulI* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  const LAllocation* rhs = ins->rhs();
+  Register dest = ToRegister(ins->output());
+  MMul* mul = ins->mir();
+
+  MOZ_ASSERT_IF(mul->mode() == MMul::Integer,
+                !mul->canBeNegativeZero() && !mul->canOverflow());
+
+  if (rhs->isConstant()) {
+    int32_t constant = ToInt32(rhs);
+
+    // Bailout on -0.0.
+    if (mul->canBeNegativeZero() && constant <= 0) {
+      Assembler::Condition cond =
+          (constant == 0) ? Assembler::LessThan : Assembler::Equal;
+      bailoutCmp32(cond, lhs, Imm32(0), ins->snapshot());
+    }
+
+    if (!mul->canOverflow()) {
+      masm.move32(lhs, dest);
+      masm.mul32(Imm32(constant), dest);
+      SignExtend32(masm, dest, dest);
+      return;
+    }
+
+    switch (constant) {
+      case -1:
+        bailoutCmp32(Assembler::Equal, lhs, Imm32(INT32_MIN), ins->snapshot());
+        Emit3(masm, ia64::Sub, dest, Zero, lhs);
+        SignExtend32(masm, dest, dest);
+        return;
+      case 0:
+        masm.move32(Imm32(0), dest);
+        return;
+      case 1:
+        masm.move32(lhs, dest);
+        return;
+      default:
+        break;
+    }
+
+    Label overflow;
+    masm.move32(lhs, dest);
+    masm.branchMul32(Assembler::Overflow, Imm32(constant), dest, &overflow);
+    bailoutFrom(&overflow, ins->snapshot());
+    SignExtend32(masm, dest, dest);
+    return;
+  }
+
+  Register rhsReg = ToRegister(rhs);
+  if (mul->canOverflow()) {
+    Label overflow;
+    // Multiplication is commutative, so pick the operand ordering that avoids
+    // clobbering an input with the (two-address) accumulator.
+    if (dest == rhsReg) {
+      masm.branchMul32(Assembler::Overflow, lhs, dest, &overflow);
+    } else {
+      masm.move32(lhs, dest);
+      masm.branchMul32(Assembler::Overflow, rhsReg, dest, &overflow);
+    }
+    bailoutFrom(&overflow, ins->snapshot());
+  } else {
+    if (dest == rhsReg) {
+      masm.mul32(lhs, dest);
+    } else {
+      masm.move32(lhs, dest);
+      masm.mul32(rhsReg, dest);
+    }
+  }
+  SignExtend32(masm, dest, dest);
+
+  if (mul->canBeNegativeZero()) {
+    Label done;
+    masm.branch32(Assembler::NotEqual, dest, Imm32(0), &done);
+
+    // A zero result is -0 if either operand was negative, which must be a
+    // double, so bail out.
+    SecondScratchRegisterScope scratch(masm);
+    Emit3(masm, ia64::Or, scratch, lhs, rhsReg);
+    bailoutCmp32(Assembler::LessThan, Register(scratch), Imm32(0),
+                 ins->snapshot());
+
+    masm.bind(&done);
+  }
+}
+
+void CodeGenerator::visitMulIntPtr(LMulIntPtr* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  const LAllocation* rhs = ins->rhs();
+  Register dest = ToRegister(ins->output());
+
+  if (rhs->isConstant()) {
+    masm.movePtr(lhs, dest);
+    masm.mulPtr(ImmWord(ToIntPtr(rhs)), dest);
+    return;
+  }
+
+  Register rhsReg = ToRegister(rhs);
+  if (dest == rhsReg) {
+    masm.mulPtr(lhs, dest);
+  } else {
+    masm.movePtr(lhs, dest);
+    masm.mulPtr(rhsReg, dest);
+  }
+}
+
+void CodeGenerator::visitMulI64(LMulI64* ins) {
+  Register lhs = ToRegister64(ins->lhs()).reg;
+  LInt64Allocation rhs = ins->rhs();
+  Register dest = ToOutRegister64(ins).reg;
+
+  if (IsConstant(rhs)) {
+    masm.movePtr(lhs, dest);
+    masm.mulPtr(ImmWord(ToInt64(rhs)), dest);
+    return;
+  }
+
+  Register rhsReg = ToRegister64(rhs).reg;
+  if (dest == rhsReg) {
+    masm.mulPtr(lhs, dest);
+  } else {
+    masm.movePtr(lhs, dest);
+    masm.mulPtr(rhsReg, dest);
+  }
+}
+
+void CodeGenerator::visitDivI(LDivI* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register rhs = ToRegister(ins->rhs());
+  Register dest = ToRegister(ins->output());
+  Register temp = ToRegister(ins->temp0());
+  MDiv* mir = ins->mir();
+
+  Label done;
+
+  if (mir->canBeDivideByZero()) {
+    if (mir->trapOnError()) {
+      TrapIfDivideByZero(masm, ins, rhs);
+    } else if (mir->canTruncateInfinities()) {
+      // Truncated division by zero is zero (Infinity|0 == 0).
+      Label notzero;
+      masm.branch32(Assembler::NotEqual, rhs, Imm32(0), &notzero);
+      masm.move32(Imm32(0), dest);
+      masm.jump(&done);
+      masm.bind(&notzero);
+    } else {
+      MOZ_ASSERT(mir->fallible());
+      bailoutCmp32(Assembler::Equal, rhs, Imm32(0), ins->snapshot());
+    }
+  }
+
+  // (INT32_MIN / -1) yields INT32_MIN but should be -(double)INT32_MIN.
+  if (mir->canBeNegativeOverflow() &&
+      (mir->trapOnError() || !mir->canTruncateOverflow())) {
+    Label notMinInt;
+    masm.branch32(Assembler::NotEqual, lhs, Imm32(INT32_MIN), &notMinInt);
+
+    if (mir->trapOnError()) {
+      Label ok;
+      masm.branch32(Assembler::NotEqual, rhs, Imm32(-1), &ok);
+      masm.wasmTrap(wasm::Trap::IntegerOverflow, mir->trapSiteDesc());
+      masm.bind(&ok);
+    } else {
+      MOZ_ASSERT(mir->fallible());
+      bailoutCmp32(Assembler::Equal, rhs, Imm32(-1), ins->snapshot());
+    }
+    masm.bind(&notMinInt);
+  }
+
+  // Negative zero: lhs == 0 && rhs < 0.
+  if (!mir->canTruncateNegativeZero() && mir->canBeNegativeZero()) {
+    Label nonzero;
+    masm.branch32(Assembler::NotEqual, lhs, Imm32(0), &nonzero);
+    bailoutCmp32(Assembler::LessThan, rhs, Imm32(0), ins->snapshot());
+    masm.bind(&nonzero);
+  }
+
+  if (mir->canTruncateRemainder()) {
+    masm.flexibleQuotient32(lhs, rhs, dest, /* isUnsigned = */ false,
+                            LiveRegisterSet());
+  } else {
+    MOZ_ASSERT(mir->fallible());
+    masm.flexibleDivMod32(lhs, rhs, dest, temp, /* isUnsigned = */ false,
+                          LiveRegisterSet());
+    // A non-zero remainder means the result is not an integer.
+    bailoutCmp32(Assembler::NotEqual, temp, Imm32(0), ins->snapshot());
+  }
+
+  masm.bind(&done);
+}
+
+void CodeGenerator::visitDivPowTwoI(LDivPowTwoI* ins) {
+  Register lhs = ToRegister(ins->numerator());
+  Register dest = ToRegister(ins->output());
+  int32_t shift = ins->shift();
+  MOZ_ASSERT(0 <= shift && shift <= 31);
+
+  if (shift == 0) {
+    masm.move32(lhs, dest);
+    return;
+  }
+
+  MDiv* mir = ins->mir();
+  SecondScratchRegisterScope scratch(masm);
+
+  if (!mir->isTruncated()) {
+    // A non-zero remainder means the result is a double.
+    // Keep only the low |shift| bits (lhs is a 64-bit sign-extended value).
+    masm.emitI(ia64::ShlImm(scratch.encoding(), lhs.encoding(), 64 - shift));
+    bailoutCmpPtr(Assembler::NotEqual, Register(scratch), Zero,
+                  ins->snapshot());
+  }
+
+  if (!mir->canBeNegativeDividend()) {
+    masm.emitI(ia64::ShrImm(dest.encoding(), lhs.encoding(), shift));
+    return;
+  }
+
+  // Bias a negative numerator so the arithmetic shift rounds toward zero. See
+  // "Signed Division by a Known Power of 2" in Hacker's Delight.
+  // lhs is a sign-extended 64-bit value: the sign mask is bits 63.., and the
+  // bias is its low |shift| bits (2^shift - 1 for a negative numerator).
+  masm.emitI(ia64::ShrImm(scratch.encoding(), lhs.encoding(), 63));
+  masm.emitI(ia64::ShrUImm(scratch.encoding(), scratch.encoding(), 64 - shift));
+  Emit3(masm, ia64::Add, scratch, scratch, lhs);
+  masm.emitI(ia64::ShrImm(dest.encoding(), scratch.encoding(), shift));
+  SignExtend32(masm, dest, dest);
+}
+
+void CodeGenerator::visitModI(LModI* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register rhs = ToRegister(ins->rhs());
+  Register dest = ToRegister(ins->output());
+  MMod* mir = ins->mir();
+  Label done;
+
+  if (mir->canBeDivideByZero()) {
+    if (mir->trapOnError()) {
+      TrapIfDivideByZero(masm, ins, rhs);
+    } else if (mir->isTruncated()) {
+      // Truncated modulo by zero yields integer zero.
+      Label yNonZero;
+      masm.branch32(Assembler::NotEqual, rhs, Imm32(0), &yNonZero);
+      masm.move32(Imm32(0), dest);
+      masm.jump(&done);
+      masm.bind(&yNonZero);
+    } else {
+      MOZ_ASSERT(mir->fallible());
+      bailoutCmp32(Assembler::Equal, rhs, Imm32(0), ins->snapshot());
+    }
+  }
+
+  masm.flexibleRemainder32(lhs, rhs, dest, /* isUnsigned = */ false,
+                           LiveRegisterSet());
+
+  if (mir->canBeNegativeDividend() && !mir->isTruncated()) {
+    MOZ_ASSERT(mir->fallible());
+    // A zero result with a negative dividend is the double -0.0. This also
+    // covers lhs == INT32_MIN with rhs == -1.
+    masm.branch32(Assembler::NotEqual, dest, Imm32(0), &done);
+    bailoutCmp32(Assembler::LessThan, lhs, Imm32(0), ins->snapshot());
+  }
+  masm.bind(&done);
+}
+
+void CodeGenerator::visitModPowTwoI(LModPowTwoI* ins) {
+  Register in = ToRegister(ins->input());
+  Register out = ToRegister(ins->output());
+  MMod* mir = ins->mir();
+  Label negative, done;
+
+  masm.branch32(Assembler::LessThan, in, Imm32(0), &negative);
+  {
+    masm.move32(in, out);
+    masm.and32(Imm32((1 << ins->shift()) - 1), out);
+    masm.jump(&done);
+  }
+  {
+    masm.bind(&negative);
+    Emit3(masm, ia64::Sub, out, Zero, in);
+    masm.and32(Imm32((1 << ins->shift()) - 1), out);
+    Emit3(masm, ia64::Sub, out, Zero, out);
+    SignExtend32(masm, out, out);
+  }
+  if (mir->canBeNegativeDividend() && !mir->isTruncated()) {
+    MOZ_ASSERT(mir->fallible());
+    bailoutCmp32(Assembler::Equal, out, Imm32(0), ins->snapshot());
+  }
+  masm.bind(&done);
+}
+
+void CodeGenerator::visitModMaskI(LModMaskI* ins) {
+  Register src = ToRegister(ins->input());
+  Register dest = ToRegister(ins->output());
+  Register tmp0 = ToRegister(ins->temp0());
+  Register tmp1 = ToRegister(ins->temp1());
+  MMod* mir = ins->mir();
+
+  // x % (2^n - 1) via repeated folding of the digit sum in base 2^n.
+  int32_t shift = ins->shift();
+  MOZ_ASSERT(shift > 0 && shift < 32);
+  int32_t mask = (1 << shift) - 1;
+
+  Label loop, done, negative;
+
+  masm.move32(src, tmp0);
+  masm.move32(Imm32(0), dest);
+
+  masm.branch32(Assembler::GreaterThanOrEqual, tmp0, Imm32(0), &loop);
+  Emit3(masm, ia64::Sub, tmp0, Zero, tmp0);
+  masm.bind(&loop);
+  {
+    Label exit;
+    masm.branch32(Assembler::Equal, tmp0, Imm32(0), &exit);
+    masm.move32(tmp0, tmp1);
+    masm.and32(Imm32(mask), tmp1);
+    masm.add32(tmp1, dest);
+    // Reduce on every digit: the running sum of all the base-2^n digits of a
+    // 32-bit value reaches 11 * mask, so folding it once at the end leaves a
+    // result that is still several multiples of the modulus too large.
+    Label noFold;
+    masm.branch32(Assembler::LessThan, dest, Imm32(mask), &noFold);
+    masm.sub32(Imm32(mask), dest);
+    masm.bind(&noFold);
+    masm.rshift32(Imm32(shift), tmp0);
+    masm.jump(&loop);
+    masm.bind(&exit);
+  }
+
+  masm.branch32(Assembler::GreaterThanOrEqual, src, Imm32(0), &done);
+  masm.bind(&negative);
+  Emit3(masm, ia64::Sub, dest, Zero, dest);
+  SignExtend32(masm, dest, dest);
+  if (!mir->isTruncated() && mir->canBeNegativeDividend()) {
+    MOZ_ASSERT(mir->fallible());
+    bailoutCmp32(Assembler::Equal, dest, Imm32(0), ins->snapshot());
+  }
+  masm.bind(&done);
+}
+
+void CodeGenerator::visitUDiv(LUDiv* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register rhs = ToRegister(ins->rhs());
+  Register output = ToRegister(ins->output());
+  Label done;
+
+  MDiv* mir = ins->mir();
+
+  if (mir->canBeDivideByZero()) {
+    if (mir->trapOnError()) {
+      TrapIfDivideByZero(masm, ins, rhs);
+    } else if (mir->isTruncated()) {
+      // Infinity|0 == 0
+      Label nonZero;
+      masm.branch32(Assembler::NotEqual, rhs, Imm32(0), &nonZero);
+      masm.move32(Imm32(0), output);
+      masm.jump(&done);
+      masm.bind(&nonZero);
+    } else {
+      bailoutCmp32(Assembler::Equal, rhs, Imm32(0), ins->snapshot());
+    }
+  }
+
+  masm.flexibleQuotient32(lhs, rhs, output, /* isUnsigned = */ true,
+                          LiveRegisterSet());
+
+  // An unsigned division can produce a value that is not a signed int32.
+  if (!mir->isTruncated()) {
+    bailoutCmp32(Assembler::LessThan, output, Imm32(0), ins->snapshot());
+  }
+
+  masm.bind(&done);
+}
+
+void CodeGenerator::visitUMod(LUMod* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register rhs = ToRegister(ins->rhs());
+  Register output = ToRegister(ins->output());
+  Label done;
+
+  MMod* mir = ins->mir();
+
+  if (mir->canBeDivideByZero()) {
+    if (mir->trapOnError()) {
+      TrapIfDivideByZero(masm, ins, rhs);
+    } else if (mir->isTruncated()) {
+      // NaN|0 == 0
+      Label nonZero;
+      masm.branch32(Assembler::NotEqual, rhs, Imm32(0), &nonZero);
+      masm.move32(Imm32(0), output);
+      masm.jump(&done);
+      masm.bind(&nonZero);
+    } else {
+      bailoutCmp32(Assembler::Equal, rhs, Imm32(0), ins->snapshot());
+    }
+  }
+
+  masm.flexibleRemainder32(lhs, rhs, output, /* isUnsigned = */ true,
+                           LiveRegisterSet());
+
+  if (!mir->isTruncated()) {
+    bailoutCmp32(Assembler::LessThan, output, Imm32(0), ins->snapshot());
+  }
+
+  masm.bind(&done);
+}
+
+void CodeGenerator::visitDivI64(LDivI64* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register rhs = ToRegister(ins->rhs());
+  Register output = ToRegister(ins->output());
+
+  MDiv* div = ins->mir();
+
+  TrapIfDivideByZero(masm, ins, rhs);
+
+  if (div->canBeNegativeOverflow()) {
+    Label notOverflow;
+    masm.branchPtr(Assembler::NotEqual, lhs, ImmWord(INT64_MIN), &notOverflow);
+    masm.branchPtr(Assembler::NotEqual, rhs, ImmWord(-1), &notOverflow);
+    masm.wasmTrap(wasm::Trap::IntegerOverflow, div->trapSiteDesc());
+    masm.bind(&notOverflow);
+  }
+
+  masm.flexibleQuotientPtr(lhs, rhs, output, /* isUnsigned = */ false,
+                           LiveRegisterSet());
+}
+
+void CodeGenerator::visitModI64(LModI64* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register rhs = ToRegister(ins->rhs());
+  Register output = ToRegister(ins->output());
+
+  TrapIfDivideByZero(masm, ins, rhs);
+
+  masm.flexibleRemainderPtr(lhs, rhs, output, /* isUnsigned = */ false,
+                            LiveRegisterSet());
+}
+
+void CodeGenerator::visitUDivI64(LUDivI64* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register rhs = ToRegister(ins->rhs());
+  Register output = ToRegister(ins->output());
+
+  TrapIfDivideByZero(masm, ins, rhs);
+
+  masm.flexibleQuotientPtr(lhs, rhs, output, /* isUnsigned = */ true,
+                           LiveRegisterSet());
+}
+
+void CodeGenerator::visitUModI64(LUModI64* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register rhs = ToRegister(ins->rhs());
+  Register output = ToRegister(ins->output());
+
+  TrapIfDivideByZero(masm, ins, rhs);
+
+  masm.flexibleRemainderPtr(lhs, rhs, output, /* isUnsigned = */ true,
+                            LiveRegisterSet());
+}
+
+void CodeGenerator::visitNegI(LNegI* ins) {
+  Register input = ToRegister(ins->input());
+  Register output = ToRegister(ins->output());
+
+  Emit3(masm, ia64::Sub, output, Zero, input);
+  SignExtend32(masm, output, output);
+}
+
+void CodeGenerator::visitNegI64(LNegI64* ins) {
+  Register input = ToRegister64(ins->input()).reg;
+  Register output = ToOutRegister64(ins).reg;
+
+  Emit3(masm, ia64::Sub, output, Zero, input);
+}
+
+// ===========================================================================
+// Bitwise operations.
+
+void CodeGenerator::visitBitNotI(LBitNotI* ins) {
+  Register input = ToRegister(ins->input());
+  Register dest = ToRegister(ins->output());
+
+  // ~x == -x - 1
+  Emit3(masm, ia64::Sub, dest, Zero, input);
+  masm.emitM(ia64::Adds(dest.encoding(), -1, dest.encoding()));
+}
+
+void CodeGenerator::visitBitNotI64(LBitNotI64* ins) {
+  Register input = ToRegister64(ins->input()).reg;
+  Register dest = ToOutRegister64(ins).reg;
+
+  Emit3(masm, ia64::Sub, dest, Zero, input);
+  masm.emitM(ia64::Adds(dest.encoding(), -1, dest.encoding()));
+}
+
+void CodeGenerator::visitBitOpI(LBitOpI* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  const LAllocation* rhs = ins->rhs();
+  Register dest = ToRegister(ins->output());
+
+  ia64::Op (*op)(uint32_t, uint32_t, uint32_t, uint32_t) = nullptr;
+  switch (ins->bitop()) {
+    case JSOp::BitOr:
+      op = ia64::Or;
+      break;
+    case JSOp::BitXor:
+      op = ia64::Xor;
+      break;
+    case JSOp::BitAnd:
+      op = ia64::And;
+      break;
+    default:
+      MOZ_CRASH("unexpected binary opcode");
+  }
+
+  if (rhs->isConstant()) {
+    // A sign-extended imm8 combined with a canonical int32 is canonical, and
+    // so is lhs & (2^n - 1) for n <= 31, which is one extr.u.
+    int32_t k = ToInt32(rhs);
+    if (ia64::FitsImm8(k)) {
+      ia64::Op (*opImm)(uint32_t, int64_t, uint32_t, uint32_t) =
+          ins->bitop() == JSOp::BitOr    ? ia64::OrImm
+          : ins->bitop() == JSOp::BitXor ? ia64::XorImm
+                                         : ia64::AndImm;
+      masm.emitM(opImm(dest.encoding(), k, lhs.encoding(), 0));
+      return;
+    }
+    if (ins->bitop() == JSOp::BitAnd && k > 0 && (k & (k + 1)) == 0) {
+      masm.emitI(ia64::ExtrU(dest.encoding(), lhs.encoding(), 0,
+                             uint32_t(std::popcount(uint32_t(k)))));
+      return;
+    }
+    SecondScratchRegisterScope scratch(masm);
+    masm.move32(Imm32(k), scratch);
+    Emit3(masm, op, dest, lhs, scratch);
+  } else {
+    Emit3(masm, op, dest, lhs, ToRegister(rhs));
+  }
+}
+
+void CodeGenerator::visitBitOpI64(LBitOpI64* ins) {
+  Register lhs = ToRegister64(ins->lhs()).reg;
+  LInt64Allocation rhs = ins->rhs();
+  Register dest = ToOutRegister64(ins).reg;
+
+  ia64::Op (*op)(uint32_t, uint32_t, uint32_t, uint32_t) = nullptr;
+  switch (ins->bitop()) {
+    case JSOp::BitOr:
+      op = ia64::Or;
+      break;
+    case JSOp::BitXor:
+      op = ia64::Xor;
+      break;
+    case JSOp::BitAnd:
+      op = ia64::And;
+      break;
+    default:
+      MOZ_CRASH("unexpected binary opcode");
+  }
+
+  if (IsConstant(rhs)) {
+    SecondScratchRegisterScope scratch(masm);
+    masm.movePtr(ImmWord(ToInt64(rhs)), scratch);
+    Emit3(masm, op, dest, lhs, scratch);
+  } else {
+    Emit3(masm, op, dest, lhs, ToRegister64(rhs).reg);
+  }
+}
+
+void CodeGenerator::visitShiftI(LShiftI* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  const LAllocation* rhs = ins->rhs();
+  Register dest = ToRegister(ins->output());
+
+  if (rhs->isConstant()) {
+    int32_t shift = ToInt32(rhs) & 0x1F;
+    switch (ins->bitop()) {
+      case JSOp::Lsh:
+        if (shift) {
+          masm.emitI(ia64::ShlImm(dest.encoding(), lhs.encoding(), shift));
+          SignExtend32(masm, dest, dest);
+        } else {
+          masm.move32(lhs, dest);
+        }
+        break;
+      case JSOp::Rsh:
+        if (shift) {
+          masm.emitI(ia64::ShrImm(dest.encoding(), lhs.encoding(), shift));
+        } else {
+          masm.move32(lhs, dest);
+        }
+        break;
+      case JSOp::Ursh:
+        if (shift) {
+          // Bits shift..31 of the int32, zero-extended: below 2^31, so
+          // already canonical.
+          masm.emitI(ia64::ExtrU(dest.encoding(), lhs.encoding(), shift,
+                                 32 - shift));
+        } else {
+          // x >>> 0 can produce a value outside the int32 range.
+          if (ins->mir()->toUrsh()->fallible()) {
+            bailoutCmp32(Assembler::LessThan, lhs, Imm32(0), ins->snapshot());
+          }
+          masm.move32(lhs, dest);
+        }
+        break;
+      default:
+        MOZ_CRASH("Unexpected shift op");
+    }
+    return;
+  }
+
+  SecondScratchRegisterScope count(masm);
+  masm.move32(Imm32(0x1F), count);
+  Emit3(masm, ia64::And, count, ToRegister(rhs), count);
+
+  switch (ins->bitop()) {
+    case JSOp::Lsh:
+      Emit3(masm, ia64::Shl, dest, lhs, count);
+      SignExtend32(masm, dest, dest);
+      break;
+    case JSOp::Rsh:
+      Emit3(masm, ia64::Shr, dest, lhs, count);
+      break;
+    case JSOp::Ursh:
+      ZeroExtend32(masm, dest, lhs);
+      Emit3(masm, ia64::ShrU, dest, dest, count);
+      SignExtend32(masm, dest, dest);
+      if (ins->mir()->toUrsh()->fallible()) {
+        bailoutCmp32(Assembler::LessThan, dest, Imm32(0), ins->snapshot());
+      }
+      break;
+    default:
+      MOZ_CRASH("Unexpected shift op");
+  }
+}
+
+void CodeGenerator::visitShiftIntPtr(LShiftIntPtr* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  const LAllocation* rhs = ins->rhs();
+  Register dest = ToRegister(ins->output());
+
+  if (rhs->isConstant()) {
+    auto shamt = ToIntPtr(rhs) & 0x3F;
+    if (!shamt) {
+      masm.movePtr(lhs, dest);
+      return;
+    }
+    switch (ins->bitop()) {
+      case JSOp::Lsh:
+        masm.emitI(ia64::ShlImm(dest.encoding(), lhs.encoding(), shamt));
+        break;
+      case JSOp::Rsh:
+        masm.emitI(ia64::ShrImm(dest.encoding(), lhs.encoding(), shamt));
+        break;
+      case JSOp::Ursh:
+        masm.emitI(ia64::ShrUImm(dest.encoding(), lhs.encoding(), shamt));
+        break;
+      default:
+        MOZ_CRASH("Unexpected shift op");
+    }
+    return;
+  }
+
+  SecondScratchRegisterScope count(masm);
+  masm.move32(Imm32(0x3F), count);
+  Emit3(masm, ia64::And, count, ToRegister(rhs), count);
+
+  switch (ins->bitop()) {
+    case JSOp::Lsh:
+      Emit3(masm, ia64::Shl, dest, lhs, count);
+      break;
+    case JSOp::Rsh:
+      Emit3(masm, ia64::Shr, dest, lhs, count);
+      break;
+    case JSOp::Ursh:
+      Emit3(masm, ia64::ShrU, dest, lhs, count);
+      break;
+    default:
+      MOZ_CRASH("Unexpected shift op");
+  }
+}
+
+void CodeGenerator::visitShiftI64(LShiftI64* ins) {
+  Register lhs = ToRegister64(ins->lhs()).reg;
+  const LAllocation* rhs = ins->rhs();
+  Register dest = ToOutRegister64(ins).reg;
+
+  if (rhs->isConstant()) {
+    int32_t shift = int32_t(rhs->toConstant()->toInt64() & 0x3F);
+    if (!shift) {
+      masm.movePtr(lhs, dest);
+      return;
+    }
+    switch (ins->bitop()) {
+      case JSOp::Lsh:
+        masm.emitI(ia64::ShlImm(dest.encoding(), lhs.encoding(), shift));
+        break;
+      case JSOp::Rsh:
+        masm.emitI(ia64::ShrImm(dest.encoding(), lhs.encoding(), shift));
+        break;
+      case JSOp::Ursh:
+        masm.emitI(ia64::ShrUImm(dest.encoding(), lhs.encoding(), shift));
+        break;
+      default:
+        MOZ_CRASH("Unexpected shift op");
+    }
+    return;
+  }
+
+  SecondScratchRegisterScope count(masm);
+  masm.move32(Imm32(0x3F), count);
+  Emit3(masm, ia64::And, count, ToRegister(rhs), count);
+
+  switch (ins->bitop()) {
+    case JSOp::Lsh:
+      Emit3(masm, ia64::Shl, dest, lhs, count);
+      break;
+    case JSOp::Rsh:
+      Emit3(masm, ia64::Shr, dest, lhs, count);
+      break;
+    case JSOp::Ursh:
+      Emit3(masm, ia64::ShrU, dest, lhs, count);
+      break;
+    default:
+      MOZ_CRASH("Unexpected shift op");
+  }
+}
+
+void CodeGenerator::visitUrshD(LUrshD* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register temp = ToRegister(ins->temp0());
+  const LAllocation* rhs = ins->rhs();
+  FloatRegister out = ToFloatRegister(ins->output());
+
+  ZeroExtend32(masm, temp, lhs);
+  if (rhs->isConstant()) {
+    int32_t shift = ToInt32(rhs) & 0x1F;
+    if (shift) {
+      masm.emitI(ia64::ShrUImm(temp.encoding(), temp.encoding(), shift));
+    }
+  } else {
+    SecondScratchRegisterScope count(masm);
+    masm.move32(Imm32(0x1F), count);
+    Emit3(masm, ia64::And, count, ToRegister(rhs), count);
+    Emit3(masm, ia64::ShrU, temp, temp, count);
+  }
+
+  masm.convertUInt32ToDouble(temp, out);
+}
+
+// ===========================================================================
+// Integer/pointer width conversions.
+
+void CodeGenerator::visitExtendInt32ToInt64(LExtendInt32ToInt64* ins) {
+  const LAllocation* input = ins->input();
+  Register output = ToRegister(ins->output());
+
+  if (ins->mir()->isUnsigned()) {
+    ZeroExtend32(masm, output, ToRegister(input));
+  } else {
+    SignExtend32(masm, output, ToRegister(input));
+  }
+}
+
+void CodeGenerator::visitWrapInt64ToInt32(LWrapInt64ToInt32* ins) {
+  LInt64Allocation input = ins->input();
+  Register output = ToRegister(ins->output());
+
+  if (!ins->mir()->bottomHalf()) {
+    // Arithmetic-shifting the full 64-bit value right by 32 both selects the
+    // high word and sign-extends it as an int32 in the one instruction.
+    if (input.value().isMemory()) {
+      masm.loadPtr(ToAddress(input), output);
+    } else {
+      masm.movePtr(ToRegister64(input).reg, output);
+    }
+    masm.emitI(ia64::ShrImm(output.encoding(), output.encoding(), 32));
+    return;
+  }
+
+  if (input.value().isMemory()) {
+    masm.load32(ToAddress(input), output);
+  } else {
+    SignExtend32(masm, output, ToRegister64(input).reg);
+  }
+}
+
+void CodeGenerator::visitSignExtendInt64(LSignExtendInt64* ins) {
+  Register64 input = ToRegister64(ins->input());
+  Register64 output = ToOutRegister64(ins);
+  switch (ins->mir()->mode()) {
+    case MSignExtendInt64::Byte:
+      masm.emitI(ia64::Sxt1(output.reg.encoding(), input.reg.encoding()));
+      break;
+    case MSignExtendInt64::Half:
+      masm.emitI(ia64::Sxt2(output.reg.encoding(), input.reg.encoding()));
+      break;
+    case MSignExtendInt64::Word:
+      SignExtend32(masm, output.reg, input.reg);
+      break;
+  }
+}
+
+void CodeGenerator::visitWasmExtendU32Index(LWasmExtendU32Index* ins) {
+  Register input = ToRegister(ins->input());
+  Register output = ToRegister(ins->output());
+  MOZ_ASSERT(input == output);
+  ZeroExtend32(masm, output, input);
+}
+
+void CodeGenerator::visitWasmWrapU32Index(LWasmWrapU32Index* ins) {
+  Register input = ToRegister(ins->input());
+  Register output = ToRegister(ins->output());
+  MOZ_ASSERT(input == output);
+  ZeroExtend32(masm, output, input);
+}
+
+// ===========================================================================
+// Floating point.
+
+void CodeGenerator::visitMinMaxD(LMinMaxD* ins) {
+  FloatRegister first = ToFloatRegister(ins->first());
+  FloatRegister second = ToFloatRegister(ins->second());
+
+  MOZ_ASSERT(first == ToFloatRegister(ins->output()));
+
+  if (ins->mir()->isMax()) {
+    masm.maxDouble(second, first, true);
+  } else {
+    masm.minDouble(second, first, true);
+  }
+}
+
+void CodeGenerator::visitMinMaxF(LMinMaxF* ins) {
+  FloatRegister first = ToFloatRegister(ins->first());
+  FloatRegister second = ToFloatRegister(ins->second());
+
+  MOZ_ASSERT(first == ToFloatRegister(ins->output()));
+
+  if (ins->mir()->isMax()) {
+    masm.maxFloat32(second, first, true);
+  } else {
+    masm.minFloat32(second, first, true);
+  }
+}
+
+void CodeGenerator::visitNegD(LNegD* ins) {
+  FloatRegister input = ToFloatRegister(ins->input());
+  FloatRegister output = ToFloatRegister(ins->output());
+
+  if (input != output) {
+    masm.moveDouble(input, output);
+  }
+  masm.negateDouble(output);
+}
+
+void CodeGenerator::visitNegF(LNegF* ins) {
+  FloatRegister input = ToFloatRegister(ins->input());
+  FloatRegister output = ToFloatRegister(ins->output());
+
+  if (input != output) {
+    masm.moveFloat32(input, output);
+  }
+  masm.negateFloat(output);
+}
+
+void CodeGenerator::visitMathD(LMathD* ins) {
+  FloatRegister src1 = ToFloatRegister(ins->lhs());
+  FloatRegister src2 = ToFloatRegister(ins->rhs());
+  FloatRegister output = ToFloatRegister(ins->output());
+
+  // lowerForFPU reuses the first input as the output.
+  MOZ_ASSERT(src1 == output);
+
+  switch (ins->jsop()) {
+    case JSOp::Add:
+      masm.addDouble(src2, output);
+      break;
+    case JSOp::Sub:
+      masm.subDouble(src2, output);
+      break;
+    case JSOp::Mul:
+      masm.mulDouble(src2, output);
+      break;
+    case JSOp::Div:
+      masm.divDouble(src2, output);
+      break;
+    default:
+      MOZ_CRASH("unexpected opcode");
+  }
+}
+
+void CodeGenerator::visitMathF(LMathF* ins) {
+  FloatRegister src1 = ToFloatRegister(ins->lhs());
+  FloatRegister src2 = ToFloatRegister(ins->rhs());
+  FloatRegister output = ToFloatRegister(ins->output());
+
+  MOZ_ASSERT(src1 == output);
+
+  switch (ins->jsop()) {
+    case JSOp::Add:
+      masm.addFloat32(src2, output);
+      break;
+    case JSOp::Sub:
+      masm.subFloat32(src2, output);
+      break;
+    case JSOp::Mul:
+      masm.mulFloat32(src2, output);
+      break;
+    case JSOp::Div:
+      masm.divFloat32(src2, output);
+      break;
+    default:
+      MOZ_CRASH("unexpected opcode");
+  }
+}
+
+void CodeGenerator::visitPowHalfD(LPowHalfD* ins) {
+  FloatRegister input = ToFloatRegister(ins->input());
+  FloatRegister output = ToFloatRegister(ins->output());
+
+  Label done, skip;
+
+  // Math.pow(-Infinity, 0.5) == Infinity.  LPowHalfD uses useRegisterAtStart,
+  // so |output| may be the very register holding |input|: the probe constant
+  // has to go somewhere else or it destroys the value being tested.
+  {
+    ScratchDoubleScope scratch(masm);
+    masm.loadConstantDouble(NegativeInfinity<double>(), scratch);
+    masm.branchDouble(Assembler::DoubleNotEqualOrUnordered, input, scratch,
+                      &skip);
+    masm.loadConstantDouble(NegativeInfinity<double>(), output);
+    masm.negateDouble(output);
+    masm.jump(&done);
+  }
+  masm.bind(&skip);
+
+  // Adding +0.0 turns -0 into 0 without disturbing any other value.
+  if (input != output) {
+    masm.moveDouble(input, output);
+  }
+  masm.addDouble(FPZero, output);
+  masm.sqrtDouble(output, output);
+
+  masm.bind(&done);
+}
+
+void CodeGenerator::visitTruncateDToInt32(LTruncateDToInt32* ins) {
+  emitTruncateDouble(ToFloatRegister(ins->input()), ToRegister(ins->output()),
+                     ins->mir());
+}
+
+void CodeGenerator::visitTruncateFToInt32(LTruncateFToInt32* ins) {
+  emitTruncateFloat32(ToFloatRegister(ins->input()), ToRegister(ins->output()),
+                      ins->mir());
+}
+
+void CodeGenerator::visitWasmBuiltinTruncateDToInt32(
+    LWasmBuiltinTruncateDToInt32* ins) {
+  emitTruncateDouble(ToFloatRegister(ins->input()), ToRegister(ins->output()),
+                     ins->mir());
+}
+
+void CodeGenerator::visitWasmBuiltinTruncateFToInt32(
+    LWasmBuiltinTruncateFToInt32* ins) {
+  emitTruncateFloat32(ToFloatRegister(ins->input()), ToRegister(ins->output()),
+                      ins->mir());
+}
+
+void CodeGenerator::visitWasmTruncateToInt32(LWasmTruncateToInt32* ins) {
+  auto input = ToFloatRegister(ins->input());
+  auto output = ToRegister(ins->output());
+
+  MWasmTruncateToInt32* mir = ins->mir();
+  MIRType fromType = mir->input()->type();
+
+  MOZ_ASSERT(fromType == MIRType::Double || fromType == MIRType::Float32);
+
+  bool isSaturating = mir->isSaturating();
+
+  OutOfLineWasmTruncateCheck* ool = nullptr;
+  Label* oolEntry = nullptr;
+  if (!isSaturating) {
+    ool = new (alloc()) OutOfLineWasmTruncateCheck(mir, input, output);
+    addOutOfLineCode(ool, mir);
+    oolEntry = ool->entry();
+  }
+
+  if (fromType == MIRType::Double) {
+    if (mir->isUnsigned()) {
+      masm.wasmTruncateDoubleToUInt32(input, output, isSaturating, oolEntry);
+    } else {
+      masm.wasmTruncateDoubleToInt32(input, output, isSaturating, oolEntry);
+    }
+  } else {
+    if (mir->isUnsigned()) {
+      masm.wasmTruncateFloat32ToUInt32(input, output, isSaturating, oolEntry);
+    } else {
+      masm.wasmTruncateFloat32ToInt32(input, output, isSaturating, oolEntry);
+    }
+  }
+
+  if (ool) {
+    masm.bind(ool->rejoin());
+  }
+}
+
+void CodeGenerator::visitWasmTruncateToInt64(LWasmTruncateToInt64* ins) {
+  FloatRegister input = ToFloatRegister(ins->input());
+  Register64 output = ToOutRegister64(ins);
+
+  MWasmTruncateToInt64* mir = ins->mir();
+  MIRType fromType = mir->input()->type();
+
+  MOZ_ASSERT(fromType == MIRType::Double || fromType == MIRType::Float32);
+
+  bool isSaturating = mir->isSaturating();
+
+  OutOfLineWasmTruncateCheck* ool = nullptr;
+  Label* oolEntry = nullptr;
+  Label* oolRejoin = nullptr;
+  if (!isSaturating) {
+    ool = new (alloc()) OutOfLineWasmTruncateCheck(mir, input, output);
+    addOutOfLineCode(ool, mir);
+
+    oolEntry = ool->entry();
+    oolRejoin = ool->rejoin();
+  }
+
+  if (fromType == MIRType::Double) {
+    if (mir->isUnsigned()) {
+      masm.wasmTruncateDoubleToUInt64(input, output, isSaturating, oolEntry,
+                                      oolRejoin, InvalidFloatReg);
+    } else {
+      masm.wasmTruncateDoubleToInt64(input, output, isSaturating, oolEntry,
+                                     oolRejoin, InvalidFloatReg);
+    }
+  } else {
+    if (mir->isUnsigned()) {
+      masm.wasmTruncateFloat32ToUInt64(input, output, isSaturating, oolEntry,
+                                       oolRejoin, InvalidFloatReg);
+    } else {
+      masm.wasmTruncateFloat32ToInt64(input, output, isSaturating, oolEntry,
+                                      oolRejoin, InvalidFloatReg);
+    }
+  }
+}
+
+void CodeGenerator::visitInt64ToFloatingPoint(LInt64ToFloatingPoint* ins) {
+  Register64 input = ToRegister64(ins->input());
+  FloatRegister output = ToFloatRegister(ins->output());
+
+  MIRType outputType = ins->mir()->type();
+  MOZ_ASSERT(outputType == MIRType::Double || outputType == MIRType::Float32);
+
+  if (outputType == MIRType::Double) {
+    if (ins->mir()->isUnsigned()) {
+      masm.convertUInt64ToDouble(input, output, Register::Invalid());
+    } else {
+      masm.convertInt64ToDouble(input, output);
+    }
+  } else {
+    if (ins->mir()->isUnsigned()) {
+      masm.convertUInt64ToFloat32(input, output, Register::Invalid());
+    } else {
+      masm.convertInt64ToFloat32(input, output);
+    }
+  }
+}
+
+// ===========================================================================
+// Comparisons and branches.
+
+// IA-64 has no condition codes, so a boolean result is produced by branching
+// over the two constants.
+static void EmitSetFromBranch(MacroAssembler& masm, Register dest,
+                              Label* isTrue) {
+  Label done;
+  masm.move32(Imm32(0), dest);
+  masm.jump(&done);
+  masm.bind(isTrue);
+  masm.move32(Imm32(1), dest);
+  masm.bind(&done);
+}
+
+void CodeGenerator::visitCompareD(LCompareD* ins) {
+  FloatRegister lhs = ToFloatRegister(ins->left());
+  FloatRegister rhs = ToFloatRegister(ins->right());
+  Register dest = ToRegister(ins->output());
+
+  Assembler::DoubleCondition cond = JSOpToDoubleCondition(ins->mir()->jsop());
+  Label isTrue;
+  masm.branchDouble(cond, lhs, rhs, &isTrue);
+  EmitSetFromBranch(masm, dest, &isTrue);
+}
+
+void CodeGenerator::visitCompareF(LCompareF* ins) {
+  FloatRegister lhs = ToFloatRegister(ins->left());
+  FloatRegister rhs = ToFloatRegister(ins->right());
+  Register dest = ToRegister(ins->output());
+
+  Assembler::DoubleCondition cond = JSOpToDoubleCondition(ins->mir()->jsop());
+  Label isTrue;
+  masm.branchFloat(cond, lhs, rhs, &isTrue);
+  EmitSetFromBranch(masm, dest, &isTrue);
+}
+
+void CodeGenerator::visitCompareDAndBranch(LCompareDAndBranch* ins) {
+  FloatRegister lhs = ToFloatRegister(ins->left());
+  FloatRegister rhs = ToFloatRegister(ins->right());
+
+  Assembler::DoubleCondition cond =
+      JSOpToDoubleCondition(ins->cmpMir()->jsop());
+  MBasicBlock* ifTrue = ins->ifTrue();
+  MBasicBlock* ifFalse = ins->ifFalse();
+
+  if (isNextBlock(ifFalse->lir())) {
+    branchToBlock(DoubleFloat, lhs, rhs, ifTrue, cond);
+  } else {
+    branchToBlock(DoubleFloat, lhs, rhs, ifFalse,
+                  Assembler::InvertCondition(cond));
+    jumpToBlock(ifTrue);
+  }
+}
+
+void CodeGenerator::visitCompareFAndBranch(LCompareFAndBranch* ins) {
+  FloatRegister lhs = ToFloatRegister(ins->left());
+  FloatRegister rhs = ToFloatRegister(ins->right());
+
+  Assembler::DoubleCondition cond =
+      JSOpToDoubleCondition(ins->cmpMir()->jsop());
+  MBasicBlock* ifTrue = ins->ifTrue();
+  MBasicBlock* ifFalse = ins->ifFalse();
+
+  if (isNextBlock(ifFalse->lir())) {
+    branchToBlock(SingleFloat, lhs, rhs, ifTrue, cond);
+  } else {
+    branchToBlock(SingleFloat, lhs, rhs, ifFalse,
+                  Assembler::InvertCondition(cond));
+    jumpToBlock(ifTrue);
+  }
+}
+
+void CodeGenerator::visitTestDAndBranch(LTestDAndBranch* ins) {
+  FloatRegister input = ToFloatRegister(ins->input());
+
+  MBasicBlock* ifTrue = ins->ifTrue();
+  MBasicBlock* ifFalse = ins->ifFalse();
+
+  // 0, -0 and NaN are all falsey. f0 is hardwired to +0.0.
+  if (isNextBlock(ifFalse->lir())) {
+    branchToBlock(DoubleFloat, input, FPZero, ifTrue,
+                  Assembler::DoubleNotEqual);
+  } else {
+    branchToBlock(DoubleFloat, input, FPZero, ifFalse,
+                  Assembler::DoubleEqualOrUnordered);
+    jumpToBlock(ifTrue);
+  }
+}
+
+void CodeGenerator::visitTestFAndBranch(LTestFAndBranch* ins) {
+  FloatRegister input = ToFloatRegister(ins->input());
+
+  MBasicBlock* ifTrue = ins->ifTrue();
+  MBasicBlock* ifFalse = ins->ifFalse();
+
+  if (isNextBlock(ifFalse->lir())) {
+    branchToBlock(SingleFloat, input, FPZeroSingle, ifTrue,
+                  Assembler::DoubleNotEqual);
+  } else {
+    branchToBlock(SingleFloat, input, FPZeroSingle, ifFalse,
+                  Assembler::DoubleEqualOrUnordered);
+    jumpToBlock(ifTrue);
+  }
+}
+
+void CodeGenerator::visitNotD(LNotD* ins) {
+  FloatRegister in = ToFloatRegister(ins->input());
+  Register dest = ToRegister(ins->output());
+
+  Label isTrue;
+  masm.branchDouble(Assembler::DoubleEqualOrUnordered, in, FPZero, &isTrue);
+  EmitSetFromBranch(masm, dest, &isTrue);
+}
+
+void CodeGenerator::visitNotF(LNotF* ins) {
+  FloatRegister in = ToFloatRegister(ins->input());
+  Register dest = ToRegister(ins->output());
+
+  Label isTrue;
+  masm.branchFloat(Assembler::DoubleEqualOrUnordered, in, FPZeroSingle,
+                   &isTrue);
+  EmitSetFromBranch(masm, dest, &isTrue);
+}
+
+// ===========================================================================
+// Addressing.
+
+void CodeGenerator::visitEffectiveAddress3(LEffectiveAddress3* ins) {
+  const MEffectiveAddress3* mir = ins->mir();
+  Register base = ToRegister(ins->base());
+  Register index = ToRegister(ins->index());
+  Register output = ToRegister(ins->output());
+  uint32_t shift = uint32_t(mir->scale());
+
+  if (shift) {
+    // The scaled index goes via the scratch so |base| survives an output that
+    // aliases it.
+    SecondScratchRegisterScope scratch(masm);
+    masm.emitI(ia64::ShlImm(scratch.encoding(), index.encoding(), shift));
+    Emit3(masm, ia64::Add, output, base, scratch);
+  } else {
+    Emit3(masm, ia64::Add, output, base, index);
+  }
+  if (mir->displacement()) {
+    masm.add32(Imm32(mir->displacement()), output);
+  }
+  SignExtend32(masm, output, output);
+}
+
+void CodeGenerator::visitEffectiveAddress2(LEffectiveAddress2* ins) {
+  const MEffectiveAddress2* mir = ins->mir();
+  Register index = ToRegister(ins->index());
+  Register output = ToRegister(ins->output());
+  uint32_t shift = uint32_t(mir->scale());
+
+  if (shift) {
+    masm.emitI(ia64::ShlImm(output.encoding(), index.encoding(), shift));
+  } else {
+    masm.move32(index, output);
+  }
+  if (mir->displacement()) {
+    masm.add32(Imm32(mir->displacement()), output);
+  }
+  SignExtend32(masm, output, output);
+}
+
+// ===========================================================================
+// Wasm memory.
+
+void CodeGenerator::visitWasmLoad(LWasmLoad* ins) {
+  const MWasmLoad* mir = ins->mir();
+
+  Register memoryBase = ToRegister(ins->memoryBase());
+  Register ptr = ToRegister(ins->ptr());
+
+  if (mir->base()->type() == MIRType::Int32) {
+    // ptr may still be live (and is canonical, i.e. sign-extended): extend a
+    // copy.
+    ZeroExtend32(masm, ThirdScratchReg, ptr);
+    ptr = ThirdScratchReg;
+  }
+  masm.wasmLoad(mir->access(), memoryBase, ptr, ToAnyRegister(ins->output()));
+}
+
+void CodeGenerator::visitWasmLoadI64(LWasmLoadI64* ins) {
+  const MWasmLoad* mir = ins->mir();
+
+  Register memoryBase = ToRegister(ins->memoryBase());
+  Register ptr = ToRegister(ins->ptr());
+
+  if (mir->base()->type() == MIRType::Int32) {
+    // ptr may still be live (and is canonical, i.e. sign-extended): extend a
+    // copy.
+    ZeroExtend32(masm, ThirdScratchReg, ptr);
+    ptr = ThirdScratchReg;
+  }
+  masm.wasmLoadI64(mir->access(), memoryBase, ptr, ToOutRegister64(ins));
+}
+
+void CodeGenerator::visitWasmStore(LWasmStore* ins) {
+  const MWasmStore* mir = ins->mir();
+
+  Register memoryBase = ToRegister(ins->memoryBase());
+  Register ptr = ToRegister(ins->ptr());
+
+  if (mir->base()->type() == MIRType::Int32) {
+    // ptr may still be live (and is canonical, i.e. sign-extended): extend a
+    // copy.
+    ZeroExtend32(masm, ThirdScratchReg, ptr);
+    ptr = ThirdScratchReg;
+  }
+  masm.wasmStore(mir->access(), ToAnyRegister(ins->value()), memoryBase, ptr);
+}
+
+void CodeGenerator::visitWasmStoreI64(LWasmStoreI64* ins) {
+  const MWasmStore* mir = ins->mir();
+
+  Register memoryBase = ToRegister(ins->memoryBase());
+  Register ptr = ToRegister(ins->ptr());
+
+  if (mir->base()->type() == MIRType::Int32) {
+    // ptr may still be live (and is canonical, i.e. sign-extended): extend a
+    // copy.
+    ZeroExtend32(masm, ThirdScratchReg, ptr);
+    ptr = ThirdScratchReg;
+  }
+  masm.wasmStoreI64(mir->access(), ToRegister64(ins->value()), memoryBase, ptr);
+}
+
+void CodeGenerator::visitWasmAddOffset(LWasmAddOffset* ins) {
+  MWasmAddOffset* mir = ins->mir();
+  Register base = ToRegister(ins->base());
+  Register out = ToRegister(ins->output());
+
+  Label ok;
+  masm.move32(base, out);
+  masm.branchAdd32(Assembler::CarryClear, Imm32(mir->offset()), out, &ok);
+  masm.wasmTrap(wasm::Trap::OutOfBounds, mir->trapSiteDesc());
+  masm.bind(&ok);
+}
+
+void CodeGenerator::visitWasmAddOffset64(LWasmAddOffset64* ins) {
+  MWasmAddOffset* mir = ins->mir();
+  Register64 base = ToRegister64(ins->base());
+  Register64 out = ToOutRegister64(ins);
+
+  Label ok;
+  masm.movePtr(base.reg, out.reg);
+  masm.branchAddPtr(Assembler::CarryClear, ImmWord(mir->offset()), out.reg,
+                    &ok);
+  masm.wasmTrap(wasm::Trap::OutOfBounds, mir->trapSiteDesc());
+  masm.bind(&ok);
+}
+
+void CodeGenerator::visitWasmStackArg(LWasmStackArg* ins) {
+  const MWasmStackArg* mir = ins->mir();
+  if (ins->arg()->isConstant()) {
+    masm.storePtr(ImmWord(ToInt32(ins->arg())),
+                  Address(StackPointer, mir->spOffset()));
+  } else if (ins->arg()->isGeneralReg()) {
+    masm.storePtr(ToRegister(ins->arg()),
+                  Address(StackPointer, mir->spOffset()));
+  } else if (mir->input()->type() == MIRType::Double) {
+    masm.storeDouble(ToFloatRegister(ins->arg()),
+                     Address(StackPointer, mir->spOffset()));
+  } else {
+    masm.storeFloat32(ToFloatRegister(ins->arg()),
+                      Address(StackPointer, mir->spOffset()));
+  }
+}
+
+void CodeGenerator::visitWasmStackArgI64(LWasmStackArgI64* ins) {
+  const MWasmStackArg* mir = ins->mir();
+  Address dst(StackPointer, mir->spOffset());
+  if (IsConstant(ins->arg())) {
+    masm.store64(Imm64(ToInt64(ins->arg())), dst);
+  } else {
+    masm.store64(ToRegister64(ins->arg()), dst);
+  }
+}
+
+void CodeGenerator::visitWasmSelect(LWasmSelect* ins) {
+  MIRType mirType = ins->mir()->type();
+
+  Register cond = ToRegister(ins->condExpr());
+  const LAllocation* falseExpr = ins->falseExpr();
+
+  Label done;
+  masm.branchTest32(Assembler::NonZero, cond, cond, &done);
+
+  if (mirType == MIRType::Int32 || mirType == MIRType::WasmAnyRef) {
+    Register out = ToRegister(ins->output());
+    MOZ_ASSERT(ToRegister(ins->trueExpr()) == out,
+               "true expr input is reused for output");
+    if (falseExpr->isGeneralReg()) {
+      masm.movePtr(ToRegister(falseExpr), out);
+    } else {
+      masm.loadPtr(ToAddress(falseExpr), out);
+    }
+    masm.bind(&done);
+    return;
+  }
+
+  FloatRegister out = ToFloatRegister(ins->output());
+  MOZ_ASSERT(ToFloatRegister(ins->trueExpr()) == out,
+             "true expr input is reused for output");
+
+  if (falseExpr->isFloatReg()) {
+    if (mirType == MIRType::Float32) {
+      masm.moveFloat32(ToFloatRegister(falseExpr), out);
+    } else if (mirType == MIRType::Double) {
+      masm.moveDouble(ToFloatRegister(falseExpr), out);
+    } else {
+      MOZ_CRASH("unhandled type in visitWasmSelect!");
+    }
+  } else {
+    if (mirType == MIRType::Float32) {
+      masm.loadFloat32(ToAddress(falseExpr), out);
+    } else if (mirType == MIRType::Double) {
+      masm.loadDouble(ToAddress(falseExpr), out);
+    } else {
+      MOZ_CRASH("unhandled type in visitWasmSelect!");
+    }
+  }
+  masm.bind(&done);
+}
+
+void CodeGenerator::visitWasmSelectI64(LWasmSelectI64* ins) {
+  MOZ_ASSERT(ins->mir()->type() == MIRType::Int64);
+
+  Register cond = ToRegister(ins->condExpr());
+  LInt64Allocation falseExpr = ins->falseExpr();
+
+  Register64 out = ToOutRegister64(ins);
+  MOZ_ASSERT(ToRegister64(ins->trueExpr()) == out,
+             "true expr is reused for input");
+
+  Label done;
+  masm.branchTest32(Assembler::NonZero, cond, cond, &done);
+  if (falseExpr.value().isGeneralReg()) {
+    masm.movePtr(ToRegister(falseExpr.value()), out.reg);
+  } else {
+    masm.loadPtr(ToAddress(falseExpr.value()), out.reg);
+  }
+  masm.bind(&done);
+}
+
+void CodeGenerator::visitWasmCompareAndSelect(LWasmCompareAndSelect* ins) {
+  MOZ_CRASH("ia64 does not specialize compare-and-select");
+}
+
+// ===========================================================================
+// Atomics.
+
+void CodeGenerator::visitCompareExchangeTypedArrayElement(
+    LCompareExchangeTypedArrayElement* lir) {
+  Register elements = ToRegister(lir->elements());
+  AnyRegister output = ToAnyRegister(lir->output());
+  Register temp = ToTempRegisterOrInvalid(lir->temp0());
+
+  Register oldval = ToRegister(lir->oldval());
+  Register newval = ToRegister(lir->newval());
+
+  Scalar::Type arrayType = lir->mir()->arrayType();
+
+  auto dest = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+
+  dest.match([&](const auto& dest) {
+    masm.compareExchangeJS(arrayType, Synchronization::Full(), dest, oldval,
+                           newval, temp, output);
+  });
+}
+
+void CodeGenerator::visitAtomicExchangeTypedArrayElement(
+    LAtomicExchangeTypedArrayElement* lir) {
+  Register elements = ToRegister(lir->elements());
+  AnyRegister output = ToAnyRegister(lir->output());
+  Register temp = ToTempRegisterOrInvalid(lir->temp0());
+
+  Register value = ToRegister(lir->value());
+
+  Scalar::Type arrayType = lir->mir()->arrayType();
+
+  auto dest = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+
+  dest.match([&](const auto& dest) {
+    masm.atomicExchangeJS(arrayType, Synchronization::Full(), dest, value, temp,
+                          output);
+  });
+}
+
+void CodeGenerator::visitAtomicTypedArrayElementBinop(
+    LAtomicTypedArrayElementBinop* lir) {
+  MOZ_ASSERT(!lir->mir()->isForEffect());
+
+  AnyRegister output = ToAnyRegister(lir->output());
+  Register elements = ToRegister(lir->elements());
+  Register temp1 = ToTempRegisterOrInvalid(lir->temp0());
+  Register temp2 = ToTempRegisterOrInvalid(lir->temp1());
+  Register value = ToRegister(lir->value());
+
+  Scalar::Type arrayType = lir->mir()->arrayType();
+  AtomicOp atomicOp = lir->mir()->operation();
+
+  auto mem = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+
+  mem.match([&](const auto& mem) {
+    masm.atomicFetchOpJS(arrayType, Synchronization::Full(), atomicOp, value,
+                         mem, temp1, temp2, output);
+  });
+}
+
+void CodeGenerator::visitAtomicTypedArrayElementBinopForEffect(
+    LAtomicTypedArrayElementBinopForEffect* lir) {
+  MOZ_ASSERT(lir->mir()->isForEffect());
+
+  Register elements = ToRegister(lir->elements());
+  Register value = ToRegister(lir->value());
+
+  Scalar::Type arrayType = lir->mir()->arrayType();
+  AtomicOp atomicOp = lir->mir()->operation();
+
+  auto mem = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+
+  mem.match([&](const auto& mem) {
+    masm.atomicEffectOpJS(arrayType, Synchronization::Full(), atomicOp, value,
+                          mem, ToRegister(lir->temp0()));
+  });
+}
+
+void CodeGenerator::visitCompareExchangeTypedArrayElement64(
+    LCompareExchangeTypedArrayElement64* lir) {
+  Register elements = ToRegister(lir->elements());
+  Register64 oldval = ToRegister64(lir->oldval());
+  Register64 newval = ToRegister64(lir->newval());
+  Register64 out = ToOutRegister64(lir);
+  Scalar::Type arrayType = lir->mir()->arrayType();
+
+  auto dest = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+
+  dest.match([&](const auto& dest) {
+    masm.compareExchange64(Synchronization::Full(), dest, oldval, newval, out);
+  });
+}
+
+void CodeGenerator::visitAtomicExchangeTypedArrayElement64(
+    LAtomicExchangeTypedArrayElement64* lir) {
+  Register elements = ToRegister(lir->elements());
+  Register64 value = ToRegister64(lir->value());
+  Register64 out = ToOutRegister64(lir);
+  Scalar::Type arrayType = lir->mir()->arrayType();
+
+  auto dest = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+
+  dest.match([&](const auto& dest) {
+    masm.atomicExchange64(Synchronization::Full(), dest, value, out);
+  });
+}
+
+void CodeGenerator::visitAtomicTypedArrayElementBinop64(
+    LAtomicTypedArrayElementBinop64* lir) {
+  MOZ_ASSERT(!lir->mir()->isForEffect());
+
+  Register elements = ToRegister(lir->elements());
+  Register64 value = ToRegister64(lir->value());
+  Register64 temp = ToRegister64(lir->temp0());
+  Register64 out = ToOutRegister64(lir);
+
+  Scalar::Type arrayType = lir->mir()->arrayType();
+  AtomicOp atomicOp = lir->mir()->operation();
+
+  auto dest = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+
+  dest.match([&](const auto& dest) {
+    masm.atomicFetchOp64(Synchronization::Full(), atomicOp, value, dest, temp,
+                         out);
+  });
+}
+
+void CodeGenerator::visitAtomicTypedArrayElementBinopForEffect64(
+    LAtomicTypedArrayElementBinopForEffect64* lir) {
+  MOZ_ASSERT(lir->mir()->isForEffect());
+
+  Register elements = ToRegister(lir->elements());
+  Register64 value = ToRegister64(lir->value());
+  Register64 temp = ToRegister64(lir->temp0());
+
+  Scalar::Type arrayType = lir->mir()->arrayType();
+  AtomicOp atomicOp = lir->mir()->operation();
+
+  auto dest = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+
+  dest.match([&](const auto& dest) {
+    masm.atomicEffectOp64(Synchronization::Full(), atomicOp, value, dest, temp);
+  });
+}
+
+void CodeGenerator::visitAtomicLoad64(LAtomicLoad64* lir) {
+  Register elements = ToRegister(lir->elements());
+  Register64 out = ToOutRegister64(lir);
+
+  Scalar::Type storageType = lir->mir()->storageType();
+
+  auto source = ToAddressOrBaseIndex(elements, lir->index(), storageType);
+
+  auto sync = Synchronization::Load();
+  masm.memoryBarrierBefore(sync);
+  source.match([&](const auto& source) { masm.load64(source, out); });
+  masm.memoryBarrierAfter(sync);
+}
+
+void CodeGenerator::visitAtomicStore64(LAtomicStore64* lir) {
+  Register elements = ToRegister(lir->elements());
+  Register64 value = ToRegister64(lir->value());
+
+  Scalar::Type writeType = lir->mir()->writeType();
+
+  auto dest = ToAddressOrBaseIndex(elements, lir->index(), writeType);
+
+  auto sync = Synchronization::Store();
+  masm.memoryBarrierBefore(sync);
+  dest.match([&](const auto& dest) { masm.store64(value, dest); });
+  masm.memoryBarrierAfter(sync);
+}
+
+void CodeGenerator::visitWasmCompareExchangeHeap(
+    LWasmCompareExchangeHeap* ins) {
+  MWasmCompareExchangeHeap* mir = ins->mir();
+  Register memoryBase = ToRegister(ins->memoryBase());
+  Register ptrReg = ToRegister(ins->ptr());
+  if (ins->mir()->base()->type() == MIRType::Int32) {
+    ZeroExtend32(masm, ThirdScratchReg, ptrReg);
+    ptrReg = ThirdScratchReg;
+  }
+  BaseIndex srcAddr(memoryBase, ptrReg, TimesOne, mir->access().offset32());
+
+  Register oldval = ToRegister(ins->oldValue());
+  Register newval = ToRegister(ins->newValue());
+
+  masm.wasmCompareExchange(mir->access(), srcAddr, oldval, newval,
+                           ToRegister(ins->output()));
+}
+
+void CodeGenerator::visitWasmAtomicExchangeHeap(LWasmAtomicExchangeHeap* ins) {
+  MWasmAtomicExchangeHeap* mir = ins->mir();
+  Register memoryBase = ToRegister(ins->memoryBase());
+  Register ptrReg = ToRegister(ins->ptr());
+  if (ins->mir()->base()->type() == MIRType::Int32) {
+    ZeroExtend32(masm, ThirdScratchReg, ptrReg);
+    ptrReg = ThirdScratchReg;
+  }
+  Register value = ToRegister(ins->value());
+  BaseIndex srcAddr(memoryBase, ptrReg, TimesOne, mir->access().offset32());
+
+  masm.wasmAtomicExchange(mir->access(), srcAddr, value,
+                          ToRegister(ins->output()));
+}
+
+void CodeGenerator::visitWasmAtomicBinopHeap(LWasmAtomicBinopHeap* ins) {
+  MOZ_ASSERT(ins->mir()->hasUses());
+
+  MWasmAtomicBinopHeap* mir = ins->mir();
+  Register memoryBase = ToRegister(ins->memoryBase());
+  Register ptrReg = ToRegister(ins->ptr());
+  if (ins->mir()->base()->type() == MIRType::Int32) {
+    ZeroExtend32(masm, ThirdScratchReg, ptrReg);
+    ptrReg = ThirdScratchReg;
+  }
+  Register temp = ToTempRegisterOrInvalid(ins->temp0());
+
+  BaseIndex srcAddr(memoryBase, ptrReg, TimesOne, mir->access().offset32());
+
+  masm.wasmAtomicFetchOp(mir->access(), mir->operation(),
+                         ToRegister(ins->value()), srcAddr, temp,
+                         ToRegister(ins->output()));
+}
+
+void CodeGenerator::visitWasmAtomicBinopHeapForEffect(
+    LWasmAtomicBinopHeapForEffect* ins) {
+  MOZ_ASSERT(!ins->mir()->hasUses());
+
+  MWasmAtomicBinopHeap* mir = ins->mir();
+  Register memoryBase = ToRegister(ins->memoryBase());
+  Register ptrReg = ToRegister(ins->ptr());
+  if (ins->mir()->base()->type() == MIRType::Int32) {
+    ZeroExtend32(masm, ThirdScratchReg, ptrReg);
+    ptrReg = ThirdScratchReg;
+  }
+
+  BaseIndex srcAddr(memoryBase, ptrReg, TimesOne, mir->access().offset32());
+  masm.wasmAtomicEffectOp(mir->access(), mir->operation(),
+                          ToRegister(ins->value()), srcAddr, InvalidReg);
+}
+
+void CodeGenerator::visitWasmCompareExchangeI64(LWasmCompareExchangeI64* ins) {
+  Register memoryBase = ToRegister(ins->memoryBase());
+  Register ptr = ToRegister(ins->ptr());
+  if (ins->mir()->base()->type() == MIRType::Int32) {
+    ZeroExtend32(masm, ThirdScratchReg, ptr);
+    ptr = ThirdScratchReg;
+  }
+  Register64 oldValue = ToRegister64(ins->oldValue());
+  Register64 newValue = ToRegister64(ins->newValue());
+  Register64 output = ToOutRegister64(ins);
+  uint32_t offset = ins->mir()->access().offset32();
+
+  BaseIndex addr(memoryBase, ptr, TimesOne, offset);
+  masm.wasmCompareExchange64(ins->mir()->access(), addr, oldValue, newValue,
+                             output);
+}
+
+void CodeGenerator::visitWasmAtomicExchangeI64(LWasmAtomicExchangeI64* ins) {
+  Register memoryBase = ToRegister(ins->memoryBase());
+  Register ptr = ToRegister(ins->ptr());
+  if (ins->mir()->base()->type() == MIRType::Int32) {
+    ZeroExtend32(masm, ThirdScratchReg, ptr);
+    ptr = ThirdScratchReg;
+  }
+  Register64 value = ToRegister64(ins->value());
+  Register64 output = ToOutRegister64(ins);
+  uint32_t offset = ins->mir()->access().offset32();
+
+  BaseIndex addr(memoryBase, ptr, TimesOne, offset);
+  masm.wasmAtomicExchange64(ins->mir()->access(), addr, value, output);
+}
+
+void CodeGenerator::visitWasmAtomicBinopI64(LWasmAtomicBinopI64* ins) {
+  Register memoryBase = ToRegister(ins->memoryBase());
+  Register ptr = ToRegister(ins->ptr());
+  if (ins->mir()->base()->type() == MIRType::Int32) {
+    ZeroExtend32(masm, ThirdScratchReg, ptr);
+    ptr = ThirdScratchReg;
+  }
+  Register64 value = ToRegister64(ins->value());
+  Register64 output = ToOutRegister64(ins);
+  Register64 temp = ToRegister64(ins->temp0());
+  uint32_t offset = ins->mir()->access().offset32();
+
+  BaseIndex addr(memoryBase, ptr, TimesOne, offset);
+
+  masm.wasmAtomicFetchOp64(ins->mir()->access(), ins->mir()->operation(), value,
+                           addr, temp, output);
+}
+
+void CodeGenerator::visitWasmMulI64WideHI64(LWasmMulI64WideHI64* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register rhs = ToRegister(ins->rhs());
+  Register output = ToRegister(ins->output());
+  MOZ_ASSERT(output != lhs && output != rhs);
+  masm.wasmMulI64WideHI64(lhs, rhs, output, ins->isSigned());
+}
+
+// ===========================================================================
+// SIMD: IA-64 has no packed SIMD in the FP register file.
+
+void CodeGenerator::visitSimd128(LSimd128* ins) { MOZ_CRASH("No SIMD"); }
