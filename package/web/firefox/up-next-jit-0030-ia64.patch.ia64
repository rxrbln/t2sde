diff --git a/js/src/threading/posix/PosixThread.cpp b/js/src/threading/posix/PosixThread.cpp
--- a/js/src/threading/posix/PosixThread.cpp
+++ b/js/src/threading/posix/PosixThread.cpp
@@ -48,7 +48,16 @@ bool Thread::create(void* (*aMain)(void*), void* aArg) {
   int r = pthread_attr_init(&attrs);
   MOZ_RELEASE_ASSERT(!r);
   if (options_.stackSize()) {
-    r = pthread_attr_setstacksize(&attrs, options_.stackSize());
+    size_t stackSize = options_.stackSize();
+#if defined(__ia64__)
+    // glibc on ia64 splits a thread's stack mapping into two equal halves, one
+    // for the register backing store (RSE) and one for the memory stack. The
+    // engine's native stack quota is measured in memory stack, so ask for
+    // twice as much; otherwise the quota overshoots the real stack and deep
+    // recursion crashes instead of throwing "too much recursion".
+    stackSize *= 2;
+#endif
+    r = pthread_attr_setstacksize(&attrs, stackSize);
     MOZ_RELEASE_ASSERT(!r);
   }
 
