@@ -1036,6 +1038,31 @@ void MacroAssembler::fallibleUnboxBigInt(const T& src, Register dest,
 
 void MacroAssembler::ensureDouble(const ValueOperand& source,
                                   FloatRegister dest, Label* failure) {
+#ifdef JS_CODEGEN_IA64
+  // Branch-free: the setf.d always, the int32 conversion under a predicate,
+  // a branch only for neither.  A loop over an array of numbers is then one
+  // trace for the software pipeliner (Pipeliner-ia64.h) whether its
+  // elements are int32 or double, and nothing mispredicts on mixed arrays.
+  {
+    uint32_t v = source.valueReg().encoding();
+    uint32_t mask = ScratchReg.encoding(), tag = SecondScratchReg.encoding();
+    uint32_t d = dest.encoding();
+    emitI(ia64::DepZImm(mask, -1, 47, 17));
+    emitM(ia64::And(tag, v, mask));
+    emitI(ia64::DepZImm(mask, -1, 51, 13));         // the last double tag
+    emitM(ia64::CmpLtu(6, 7, mask, tag));            // p6: not a double
+    emitM(ia64::SetfD(d, v));
+    emitI(ia64::DepZImm(mask, -15, 47, 17));        // the int32 tag
+    ia64::Op isInt = ia64::CmpEq(8, 9, tag, mask, 6);
+    isInt.bits |= ia64::Insn(1) << 12;               // .unc: p8, p9 clear unless p6
+    emitM(isInt);                                    // p8: int32, p9: neither
+    emitBranchToLabel(ia64::kBrCond, 9, failure);
+    emitI(ia64::Sxt4(mask, v, 8));
+    emitM(ia64::SetfSig(d, mask, 8));
+    emitF(ia64::FcvtXf(d, d, 8));
+    return;
+  }
+#endif
   Label isDouble, done;
 
   {
