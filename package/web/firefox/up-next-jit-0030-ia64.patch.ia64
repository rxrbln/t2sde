+  js::Vector<uint64_t, 0, SystemAllocPolicy> ia64LiveInFr_;
+  bool computeBlockLiveInIA64();
+  // The OsiPoint of an InterruptCheck that restarts its block
+  // (interruptRestartOsiIA64()): marked in the out-of-line path instead.
+  LOsiPoint* ia64DeferredOsi_ = nullptr;
+  LOsiPoint* interruptRestartOsiIA64(LInterruptCheck* lir);
