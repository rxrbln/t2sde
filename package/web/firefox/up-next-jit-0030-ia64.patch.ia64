+// Operands live in the bytecode stream at whatever alignment the preceding ops
+// leave them at. Most targets tolerate an unaligned load; IA-64 faults on one,
+// so its reads are assembled byte-wise instead.
+static void LoadBytecodeUint16(MacroAssembler& masm, const Address& src,
+                               Register dest) {
+#ifdef JS_CODEGEN_IA64
+  masm.load16UnalignedZeroExtend(src, dest);
+#else
+  masm.load16ZeroExtend(src, dest);
+#endif
+}
+
+static void LoadBytecodeInt32(MacroAssembler& masm, const Address& src,
+                              Register dest) {
+#ifdef JS_CODEGEN_IA64
+  masm.load32Unaligned(src, dest);
+#else
+  masm.load32(src, dest);
+#endif
+}
+
+static void LoadBytecodeInt32SignExtendToPtr(MacroAssembler& masm,
+                                             const Address& src,
+                                             Register dest) {
+#ifdef JS_CODEGEN_IA64
+  // load32Unaligned sign-extends the 32-bit result to the full register.
+  masm.load32Unaligned(src, dest);
+#else
+  masm.load32SignExtendToPtr(src, dest);
+#endif
+}
+
 static void LoadInt8Operand(MacroAssembler& masm, Register dest) {
   Register pc = LoadBytecodePC(masm, dest);
   masm.load8SignExtend(Address(pc, sizeof(jsbytecode)), dest);
