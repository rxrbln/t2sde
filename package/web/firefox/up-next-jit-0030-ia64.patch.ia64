+#ifdef JS_CODEGEN_IA64
+// The branches to |mb|'s successors still in the window become guards
+// (generateBlock()); also for a tail-duplicated block's copy
+// (emitTailDuplicateIA64()).
+void CodeGenerator::setBlockGuardsIA64(MBasicBlock* mb) {
+  static const bool blockGuards = ia64::Flags().blockGuard;
+  const bool blockGuardLoads = SpecDeferTLBIA64();
+  if (blockGuards) {
+    const uint64_t deadGr = ia64::kGrScratch | ia64::kGrPool;
+    const uint64_t deadFr = ia64::kFrScratch;
+    // With the live-in sets, an allocatable register is live only if the
+    // target block reads it before writing it; every other register stays
+    // as before.  The taken path may reach a stub that saves every volatile
+    // register, live or not (a barrier trampoline); with a plain st8 a NaT
+    // there faulted (collections/Map-iterator-order.js, SIGILL in 22 of 60
+    // runs under JS_IA64_SPECLD_FAILALL), so a value that may be NaT kept to
+    // the temporaries and the rename pool (natSafeOnly).  The save areas
+    // store with st8.spill now (MacroAssemblerIa64::SpillSavesIA64()).
+    const uint64_t allocGr = uint64_t(Registers::AllocatableMask);
+    const uint64_t allocFr = uint64_t(FloatRegisters::AllocatableMask);
+    for (size_t s = 0; s < mb->numSuccessors(); s++) {
+      MBasicBlock* target = skipTrivialBlocks(mb->getSuccessor(s));
+      uint64_t gr = ~deadGr, fr = ~deadFr;
+      if (!ia64LiveInGr_.empty()) {
+        gr = (gr & ~allocGr) | ia64LiveInGr_[target->id()];
+        fr = (fr & ~allocFr) | ia64LiveInFr_[target->id()];
+      }
+      masm.setGuardLive(target->lir()->label(), gr, fr,
+                        /* noLoads = */ !blockGuardLoads,
+                        /* natSafeOnly = */
+                        !MacroAssemblerIa64::SpillSavesIA64());
+    }
+  }
+}
+
+// ---- tail duplication -----------------------------------------------------
+//
+// A block that ends in a Goto to a small join block gets a copy of the join
+// instead of the jump (visitGoto()): the window runs on from the block into
+// the join's code instead of ending at the jump, and the join's branches
+// become the block's own (their guards included, setBlockGuardsIA64()).  The
+// LIR is allocated already, so the copy needs nothing new: the phis' moves
+// are in the predecessor's last MoveGroup, and the copy's own branches find
+// the next block from where they are emitted (isNextBlock()).  Upstream's
+// visitGoto() does this for blocks of MoveGroups only.  A copy's successors
+// are jump targets from then on (ia64TailDupTargets_, not left unbound by
+// isFallThroughOnlyIA64()), and no copy is made when one was left unbound
+// already.  Neutral (Octane -0.0%; Crypto +1.2%), wiki/superblock-scheduling.html;
+// JS_IA64_NO_TAILDUP turns it off.
+static constexpr size_t kTailDupMaxIA64 = 12;  // LIR instructions, MoveGroups too
+
+// A safepoint that only names the live registers, which the slow path saves
+// around its ABI call: no offset is recorded for it, so a copy is fine.
+static bool SafepointForLiveRegsOnlyIA64(LInstruction* ins) {
+  switch (ins->op()) {
+    case LNode::Opcode::PostWriteBarrierO:
+    case LNode::Opcode::PostWriteBarrierS:
+    case LNode::Opcode::PostWriteBarrierBI:
+    case LNode::Opcode::PostWriteBarrierV:
+    case LNode::Opcode::PostWriteElementBarrierO:
+    case LNode::Opcode::PostWriteElementBarrierS:
+    case LNode::Opcode::PostWriteElementBarrierBI:
+    case LNode::Opcode::PostWriteElementBarrierV:
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool CodeGenerator::isTailDupCandidateIA64(MBasicBlock* mb) const {
+  static const bool disabled = !ia64::Flags().tailDup;
+  if (disabled || gen->compilingWasm()) {
+    return false;
+  }
+  LBlock* block = mb->lir();
+  // A loop header begins with its InterruptCheck, which may restart the
+  // block: the hot jumps left (into loop headers) are not taken here.
+  if (block->isOutOfLine() || block->isTrivial() || mb->isLoopHeader() ||
+      mb->numPredecessors() < 2 || mb == graph.mir().osrBlock() ||
+      mb == graph.mir().entryBlock() || block->isMoveGroupsThenGoto()) {
+    return false;
+  }
+  size_t n = 0;
+  for (LInstructionIterator it = block->begin(); it != block->end(); it++) {
+    LInstruction* ins = *it;
+    if (++n > kTailDupMaxIA64) {
+      return false;
+    }
+    // An instruction with a safepoint (calls, ICs, OSI points, VM calls)
+    // records its offset once; an InterruptCheck may restart its block.
+    if ((ins->safepoint() && !SafepointForLiveRegsOnlyIA64(ins)) ||
+        ins->isCall() || ins->isOsiPoint() ||
+        ins->isInterruptCheck() || ins->isTableSwitch() ||
+        ins->isTableSwitchV() || ins->isReturn()) {
+      return false;
+    }
+  }
+  // The successors: no second back edge, and not the block itself.
+  for (size_t s = 0; s < mb->numSuccessors(); s++) {
+    MBasicBlock* succ = mb->getSuccessor(s);
+    while (succ->lir()->isTrivial()) {
+      succ = succ->lir()->rbegin()->toGoto()->getSuccessor(0);
+    }
+    if (succ->isLoopHeader() || succ == mb) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool CodeGenerator::emitTailDuplicateIA64(MBasicBlock* target) {
+  // Also while the pipeliner records a loop: the recorder takes the copy as
+  // straight-line code (with it kept out, -0.3%).
+  bool ok = !ia64InTailDup_ && target->lir() != current &&
+            !isNextBlock(target->lir()) && isTailDupCandidateIA64(target);
+  // A successor left unbound (fall-through-only) cannot take the copy's
+  // branch.
+  for (size_t s = 0; ok && s < target->numSuccessors(); s++) {
+    LBlock* succ = skipTrivialBlocks(target->getSuccessor(s))->lir();
+    for (LBlock* b : ia64FallThroughLabels_) {
+      if (b == succ) {
+        ok = false;
+      }
+    }
+  }
+  if (!ok) {
+    return false;
+  }
+  for (size_t s = 0; s < target->numSuccessors(); s++) {
+    if (!ia64TailDupTargets_.append(
+            skipTrivialBlocks(target->getSuccessor(s))->lir())) {
+      return false;
+    }
+  }
+  ia64InTailDup_ = true;
+  for (LInstructionIterator it = target->lir()->begin();
+       it != target->lir()->end(); it++) {
+    LInstruction* ins = *it;
+    if (!alloc().ensureBallast()) {
+      break;  // masm and the caller see the OOM
+    }
+    perfSpewer().recordInstruction(masm, ins);
+    if (MDefinition* mir = ins->mirRaw()) {
+      if (!addNativeToBytecodeEntry(mir->trackedSite())) {
+        break;
+      }
+    }
+    setElement(ins);
+    masm.setLirOpIA64(int(ins->op()), ins->opName());
+    switch (ins->op()) {
+#  define LIROP(op)             \
+    case LNode::Opcode::op:     \
+      visit##op(ins->to##op()); \
+      break;
+      LIR_OPCODE_LIST(LIROP)
+#  undef LIROP
+      default:
+        MOZ_CRASH("Invalid LIR op");
+    }
+    if (masm.oom()) {
+      break;
+    }
+  }
+  setBlockGuardsIA64(target);
+  ia64InTailDup_ = false;
+  return true;
+}
+#endif
