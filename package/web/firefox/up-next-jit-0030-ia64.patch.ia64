+    IntArgReg0, IntArgReg1, IntArgReg2, IntArgReg3,
+    IntArgReg4, IntArgReg5, IntArgReg6, IntArgReg7};
+static constexpr Register HeapReg{Registers::r7};
+
+static constexpr Register RegExpMatcherRegExpReg{Registers::r25};
+static constexpr Register RegExpMatcherStringReg{Registers::r27};
