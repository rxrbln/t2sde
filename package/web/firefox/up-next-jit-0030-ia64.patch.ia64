+using MacroAssemblerSpecific = MacroAssemblerIa64;
+
+static inline bool GetTempRegForIntArg(uint32_t usedIntArgs, uint32_t,
+                                       Register* out) {
+  if (usedIntArgs >= NumCallTempNonArgRegs) {
+    return false;
+  }
+  *out = CallTempNonArgRegs[usedIntArgs];
+  return true;
+}
