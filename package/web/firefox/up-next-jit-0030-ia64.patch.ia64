+  // dest = the Chunk containing the GC thing src points at.
+  void getWasmAnyRefGCThingChunk(Register src, Register dest) {
+    Register mask = src == dest ? Register(ScratchReg) : dest;
+    emitLoadImm(mask.encoding(), uint64_t(wasm::AnyRef::GCThingChunkMask));
+    emitM(ia64::And(dest.encoding(), src.encoding(), mask.encoding()));
+  }
