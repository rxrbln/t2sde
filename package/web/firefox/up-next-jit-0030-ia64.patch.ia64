diff --git a/js/src/jit/FlushICache.cpp b/js/src/jit/FlushICache.cpp
--- a/js/src/jit/FlushICache.cpp
+++ b/js/src/jit/FlushICache.cpp
@@ -152,3 +152,53 @@ void FlushExecutionContextForAllThreads() {
 }  // namespace js
 
 #endif
+
+#ifdef JS_CODEGEN_IA64
+
+#  include <stdio.h>
+#  include <string.h>
+
+namespace js {
+namespace jit {
+
+uint32_t ICacheFlushStride = 32;
+
+// The kernel's get_cache_info(): the smallest PAL flush stride of the
+// instruction and unified caches.  User mode cannot call PAL, but palinfo
+// prints the same PAL_CACHE_CONFIG_INFO fields, one block per cache:
+//
+//   Instruction Cache level 1:
+//   	...
+//   	Stride         : 128 bytes
+//
+// No file, no such cache or an odd value leave the architected 32.
+void InitICacheFlushStride() {
+  FILE* f = fopen("/proc/pal/cpu0/cache_info", "r");
+  if (!f) {
+    return;
+  }
+  char line[128];
+  bool icache = false;
+  uint32_t best = 0;
+  while (fgets(line, sizeof(line), f)) {
+    if (strstr(line, "Cache level")) {
+      icache = !strncmp(line, "Instruction ", 12) ||
+               !strncmp(line, "Data/Instruction ", 17);
+      continue;
+    }
+    unsigned stride;
+    if (icache && sscanf(line, " Stride : %u bytes", &stride) == 1 &&
+        (best == 0 || stride < best)) {
+      best = stride;
+    }
+  }
+  fclose(f);
+  if (best >= 32 && best <= 4096 && (best & (best - 1)) == 0) {
+    ICacheFlushStride = best;
+  }
+}
+
+}  // namespace jit
+}  // namespace js
+
+#endif  // JS_CODEGEN_IA64
diff --git a/js/src/jit/FlushICache.h b/js/src/jit/FlushICache.h
--- a/js/src/jit/FlushICache.h
+++ b/js/src/jit/FlushICache.h
@@ -10,6 +10,7 @@
 #include "mozilla/Assertions.h"  // MOZ_CRASH
 
 #include <stddef.h>  // size_t
+#include <stdint.h>  // uint32_t
 
 namespace js {
 namespace jit {
@@ -29,6 +30,49 @@ inline void FlushICache(void* code, size_t size) {
 // `FlushExecutionContext` below.
 extern void FlushICache(void* code, size_t size);
 
+#elif defined(JS_CODEGEN_IA64)
+
+// IA-64 caches are not coherent with the instruction stream, so newly written
+// code must be flushed before it can be fetched. __builtin___clear_cache() is
+// not usable here: GCC has no clear_cache pattern for ia64 and expands it to
+// nothing at all, so this has to be the architected sequence written out by
+// hand, as in the kernel's flush_icache_range(): `fc` over the range, then
+// sync.i to make the flushes visible to instruction fetch, then srlz.i to
+// serialise this core. Plain `fc` rather than `fc.i` because the latter is only
+// architected from revision 2.1 onwards (on Montecito the two cost the same).
+//
+// One `fc` per ICacheFlushStride bytes: the smallest flush stride PAL reports
+// for the instruction and unified caches, which the kernel uses too (128 bytes
+// on Montecito, 4x fewer flushes than the architected 32-byte minimum).
+// InitICacheFlushStride() reads it at InitializeJit(); 32 if it cannot.
+extern uint32_t ICacheFlushStride;
+void InitICacheFlushStride();
+
+inline void FlushICache(void* code, size_t size) {
+  if (size == 0) {
+    return;
+  }
+  uintptr_t stride = ICacheFlushStride;
+  uintptr_t addr = reinterpret_cast<uintptr_t>(code) & ~(stride - 1);
+  uintptr_t end = reinterpret_cast<uintptr_t>(code) + size;
+  asm volatile(
+      "1:\n\t"
+      "fc %0\n\t"
+      "add %0 = %2, %0\n\t"
+      ";;\n\t"
+      "cmp.ltu p6, p7 = %0, %1\n\t"
+      ";;\n\t"
+      "(p6) br.cond.sptk.few 1b\n\t"
+      ";;\n\t"
+      "sync.i\n\t"
+      ";;\n\t"
+      "srlz.i\n\t"
+      ";;\n"
+      : "+r"(addr)
+      : "r"(end), "r"(stride)
+      : "p6", "p7", "memory");
+}
+
 #elif defined(JS_CODEGEN_NONE) || defined(JS_CODEGEN_WASM32)
 
 inline void FlushICache(void* code, size_t size) { MOZ_CRASH(); }
@@ -79,6 +123,18 @@ extern bool CanFlushExecutionContextForAllThreads();
 // else this will crash.
 extern void FlushExecutionContextForAllThreads();
 
+#elif defined(JS_CODEGEN_IA64)
+
+// FlushICache issues fc.i (which invalidates the line in every processor's
+// instruction cache of the coherence domain), sync.i (waits for that to
+// complete) and srlz.i on the issuing core; the other cores refetch from the
+// coherent memory system, as Linux's own flush_icache_range() relies on. There
+// is no separate per-thread execution-context flush on ia64, so tiering (code
+// published to other threads without a synchronisation point) is allowed.
+inline void FlushExecutionContext() {}
+inline bool CanFlushExecutionContextForAllThreads() { return true; }
+inline void FlushExecutionContextForAllThreads() {}
+
 #else
 #  error "Unknown architecture!"
 #endif
diff --git a/js/src/jit/Jit.cpp b/js/src/jit/Jit.cpp
--- a/js/src/jit/Jit.cpp
+++ b/js/src/jit/Jit.cpp
@@ -189,7 +189,15 @@ static EnterJitStatus JS_HAZ_JSNATIVE_CALLER EnterJit(JSContext* cx,
 bool js::jit::EnterInterpreterEntryTrampoline(uint8_t* code, JSContext* cx,
                                               RunState* state) {
   using EnterTrampolineCodePtr = bool (*)(JSContext* cx, RunState*);
+#if defined(JS_CODEGEN_IA64)
+  // IA-64: |code| is a raw JIT entry, not a function descriptor. The
+  // descriptor is per-call (the entry differs per script and runtimes run
+  // concurrently), so it lives on the stack. See MakeIA64Call.
+  IA64FunctionDescriptor desc;
+  auto funcPtr = MakeIA64Call<EnterTrampolineCodePtr>(code, &desc);
+#else
   auto funcPtr = JS_DATA_TO_FUNC_PTR(EnterTrampolineCodePtr, code);
+#endif
   return CALL_GENERATED_2(funcPtr, cx, state);
