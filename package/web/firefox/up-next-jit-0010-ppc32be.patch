+BufferOffset Assembler::as_bcctr(uint16_t op, LikelyBit lkb, LinkBit lb) {
+  spew("bcctr%s%s", lb ? "l" : "", lkb ? "+" : "");
+  return writeInst(PPC_bcctr | makeOpMask(op) | lkb << 21 | lb);
+}
