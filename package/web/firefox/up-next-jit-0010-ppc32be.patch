+  SimulatorProcess();
+  ~SimulatorProcess();
+
+ private:
+  static SimulatorProcess* singleton_;
+
+  Mutex cacheLock_;
+  Redirection* redirection_;
+  ICacheMap icache_;
+
+ public:
