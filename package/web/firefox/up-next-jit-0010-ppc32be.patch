+void MacroAssembler::truncSatFloat32x4ToInt32x4(FloatRegister src,
+                                                FloatRegister dest) {
+  // vctsxs saturates and, per the AltiVec definition, yields 0 for a NaN
+  // source, which is exactly the wasm contract.
+  as_vctsxs(dest, src, 0);
+}
+
