+      xs_mr(dest, src);
+    }
+  }
+
+  void movePtr(Register src, Register dest) {
+    if (src != dest) {
+      xs_mr(dest, src);
+    }
+  }
+  void movePtr(ImmWord imm, Register dest) {
+    move32(Imm32(int32_t(uintptr_t(imm.value))), dest);
