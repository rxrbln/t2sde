+// ===============================================================
+// Clamping functions
+
+void MacroAssembler::clampIntToUint8(Register reg) {
+  // Clamp to [0, 255].
+  Label done;
+  as_cmpwi(reg, 255);
+  ma_b(LessThanOrEqual, &done);
+  move32(Imm32(255), reg);
+  bind(&done);
+  Label positive;
+  as_cmpwi(reg, 0);
+  ma_b(GreaterThanOrEqual, &positive);
+  move32(Imm32(0), reg);
+  bind(&positive);
+}
