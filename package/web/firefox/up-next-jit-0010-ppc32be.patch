+  void loadValue(const Address& src, ValueOperand val) {
+    // Do not clobber the base register before it has been used.
+    if (src.base == val.typeReg()) {
+      load32(ToPayload(src), val.payloadReg());
+      load32(ToType(src), val.typeReg());
+    } else {
+      load32(ToType(src), val.typeReg());
+      load32(ToPayload(src), val.payloadReg());
+    }
+  }
