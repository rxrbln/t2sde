+void Simulator::setVRBytes(int vreg, const uint8_t bytes[16]) {
+  MOZ_ASSERT((vreg >= 0) && (vreg < kNumVRRegisters));
+  memcpy(VRregisters_[vreg], bytes, 16);
+}
