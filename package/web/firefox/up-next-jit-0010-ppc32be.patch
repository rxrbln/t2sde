+void MacroAssembler::wasmBoundsCheck32(Condition cond, Register index,
+                                       Address boundsCheckLimit, Label* label) {
+  UseScratchRegisterScope temps(asMasm());
+  Register scratch = temps.Acquire();
+  load32(boundsCheckLimit, scratch);
+  ma_cmp(index, scratch, cond);
+  ma_b(cond, label);
+}
+
+void MacroAssembler::wasmBoundsCheck64(Condition cond, Register64 index,
+                                       Register64 boundsCheckLimit,
+                                       Label* label) {
+  MOZ_ASSERT(cond == Assembler::Below || cond == Assembler::AboveOrEqual);
+  Label done;
+  as_cmplw(index.high, boundsCheckLimit.high);
+  if (cond == Assembler::Below) {
+    ma_b(Assembler::Below, label);
+    ma_b(Assembler::Above, &done);
+  } else {
+    ma_b(Assembler::Above, label);
+    ma_b(Assembler::Below, &done);
+  }
+  as_cmplw(index.low, boundsCheckLimit.low);
+  ma_b(cond, label);
+  bind(&done);
+}
+
+void MacroAssembler::wasmBoundsCheck64(Condition cond, Register64 index,
+                                       Address boundsCheckLimit, Label* label) {
+  MOZ_ASSERT(cond == Assembler::Below || cond == Assembler::AboveOrEqual);
+  UseScratchRegisterScope temps(asMasm());
+  Register scratch = temps.Acquire();
+  Label done;
+  load32(Address(boundsCheckLimit.base, boundsCheckLimit.offset), scratch);
+  as_cmplw(index.high, scratch);
+  if (cond == Assembler::Below) {
+    ma_b(Assembler::Below, label);
+    ma_b(Assembler::Above, &done);
+  } else {
+    ma_b(Assembler::Above, label);
+    ma_b(Assembler::Below, &done);
+  }
+  load32(Address(boundsCheckLimit.base, boundsCheckLimit.offset + 4), scratch);
+  as_cmplw(index.low, scratch);
+  ma_b(cond, label);
+  bind(&done);
+}
