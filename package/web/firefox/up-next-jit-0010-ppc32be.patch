+// ===============================================================
+// Out-of-line fake exit frame
+
+bool MacroAssemblerPPCCompat::buildOOLFakeExitFrame(void* fakeReturnAddr) {
+  asMasm().Push(FrameDescriptor(FrameType::IonJS));
+  asMasm().Push(ImmPtr(fakeReturnAddr));
+  asMasm().Push(FramePointer);
+  return true;
+}
