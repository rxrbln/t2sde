+    case 260: case 261:  // xxland
+    case 276: case 277:  // xxlandc
+    case 292: case 293:  // xxlor
+    case 308: case 309:  // xxlxor
+    case 324: case 325:  // xxlnor
+    case 340: case 341:  // xxlorc
+    case 356: case 357:  // xxlnand
+    case 372: case 373:  // xxleqv
