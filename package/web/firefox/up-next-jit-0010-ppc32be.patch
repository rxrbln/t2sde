+void MacroAssembler::ceilDoubleToInt32(FloatRegister src, Register dest,
+                                       Label* fail) {
+  EmitFPToInt32(*this, src, dest, MacroAssemblerPPC::RoundUp, fail);
+  EmitRejectNegativeZero(*this, src, dest, fail);
+}
