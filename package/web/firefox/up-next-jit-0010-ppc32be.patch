+
+void MacroAssembler::memoryBarrier(MemoryBarrier barrier) {
+  if (barrier.isNone()) {
+    return;
+  }
+  if (barrier.hasStoreLoad() || barrier.hasSync()) {
+    as_sync();
+  } else {
+    as_lwsync();
+  }
+}
