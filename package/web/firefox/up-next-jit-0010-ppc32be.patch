+
+void MacroAssembler::flexibleQuotient32(
+    Register lhs, Register rhs, Register dest, bool isUnsigned,
+    const LiveRegisterSet& volatileLiveRegs) {
+  // divw(INT32_MIN, -1) is undefined; return INT32_MIN to match the other
+  // hardware-divide backends.
+  Label done;
+  if (!isUnsigned) {
+    Label notMinOverflow;
+    branch32(Assembler::NotEqual, lhs, Imm32(INT32_MIN), &notMinOverflow);
+    branch32(Assembler::NotEqual, rhs, Imm32(-1), &notMinOverflow);
+    move32(Imm32(INT32_MIN), dest);
+    jump(&done);
+    bind(&notMinOverflow);
+  }
+  if (isUnsigned) {
+    as_divwu(dest, lhs, rhs);
+  } else {
+    as_divw(dest, lhs, rhs);
+  }
+  bind(&done);
+}
