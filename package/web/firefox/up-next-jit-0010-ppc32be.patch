+void MacroAssembler::lshift32(Register src, Register dest) {
+  UseScratchRegisterScope temps(asMasm());
+  Register masked = temps.Acquire();
+  as_rlwinm(masked, src, 0, 27, 31);
+  as_slw(dest, dest, masked);
+}
+
