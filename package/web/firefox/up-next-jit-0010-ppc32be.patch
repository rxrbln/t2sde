+// There is no mullwo and no signed mulhw here, so the 64-bit product is built
+// from mulhwu plus the two sign corrections and compared against the sign
+// extension of the low word.
+template <typename T>
+void MacroAssembler::branchMul32(Condition cond, T src, Register dest,
+                                 Label* overflow) {
+  MOZ_ASSERT(cond == Overflow);
+  UseScratchRegisterScope temps(asMasm());
+  Register scratch = temps.Acquire();
+  move32(src, scratch);
+  as_mulhwu(SecondScratchReg, dest, scratch);
+  as_srawi(r0, dest, 31);
+  as_and_(r0, r0, scratch);
+  as_subf(SecondScratchReg, r0, SecondScratchReg);
+  as_srawi(r0, scratch, 31);
+  as_and_(r0, r0, dest);
+  as_subf(SecondScratchReg, r0, SecondScratchReg);
+  as_mullw(dest, dest, scratch);
+  as_srawi(r0, dest, 31);
+  as_cmpw(SecondScratchReg, r0);
+  ma_b(NotEqual, overflow);
+}
