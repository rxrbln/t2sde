+
+void MacroAssembler::or32(Imm32 imm, Register dest) {
+  uint32_t uimm = uint32_t(imm.value);
+  uint16_t lo = uimm & 0xFFFF;
+  uint16_t hi = (uimm >> 16) & 0xFFFF;
+  // ori/oris zero-extend their immediates and touch no other bits, so the
+  // pair covers any 32-bit immediate in at most 2 insns with no scratch.
+  if (hi == 0) {
+    as_ori(dest, dest, lo);
+  } else if (lo == 0) {
+    as_oris(dest, dest, hi);
+  } else {
+    as_ori(dest, dest, lo);
+    as_oris(dest, dest, hi);
+  }
+}
