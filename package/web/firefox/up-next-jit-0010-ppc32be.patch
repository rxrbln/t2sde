+  } else {
+    MOZ_ASSERT(ra != r0);
+    spew("addi\t%3s,%3s,%d", rd.name(), ra.name(), im);
+  }
+#endif
+  return writeInst(InstImm(PPC_addi, rd, ra, im).encode());
