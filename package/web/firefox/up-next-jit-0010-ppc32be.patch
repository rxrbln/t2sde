+// ===============================================================
+// Condition materialisation
+
+void MacroAssemblerPPCCompat::ma_cmp_set_dbl(Register dest,
+                                             DoubleCondition cond) {
+  bool hasUnorderedFlag = uint32_t(cond) & DoubleConditionUnordered;
+  uint8_t bit = crBit(cr0, cond);
+  UseScratchRegisterScope temps(*this);
+  Register cr = temps.Acquire();
+
+  as_mfocrf(cr, cr0);
+  as_rlwinm(dest, cr, bit + 1, 31, 31);
+  if ((uint32_t(cond) & BranchOptionMask) != BranchOnSet) {
+    as_xori(dest, dest, 1);
+  }
+  if (hasUnorderedFlag) {
+    // NaN makes the condition true: OR in the SO bit (CR0 bit 3).
+    as_rlwinm(cr, cr, 4, 31, 31);
+    as_or_(dest, dest, cr);
+  } else if ((uint32_t(cond) & BranchOptionMask) != BranchOnSet &&
+             cond != DoubleOrdered) {
+    // An ordered comparison that negates a CR bit reads as true for NaN,
+    // because NaN leaves LT/GT/EQ all clear. Force the result to 0 then.
+    as_rlwinm(cr, cr, 4, 31, 31);
+    as_xori(cr, cr, 1);
+    as_and_(dest, dest, cr);
+  }
+}
