+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+      as_stwbrx(value.low, memoryBase, ptr);
+#else
+      as_stwx(value.low, memoryBase, ptr);
+#endif
+      break;
+    case Scalar::Int64: {
+      UseScratchRegisterScope temps(asMasm());
+      Register hiAddr = temps.Acquire();
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+      as_stwbrx(value.low, memoryBase, ptr);
+      as_addi(hiAddr, ptr, 4);
+      as_stwbrx(value.high, memoryBase, hiAddr);
+#else
+      as_stwx(value.low, memoryBase, ptr);
+      as_addi(hiAddr, ptr, 4);
