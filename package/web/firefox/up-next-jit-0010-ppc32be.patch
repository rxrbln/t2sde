+void Simulator::format(SimInstruction* instr, const char* format) {
+  printf("Simulator found unsupported instruction:\n 0x%016" PRIxPTR
+         ": %08x %s\n",
+         reinterpret_cast<intptr_t>(instr), instr->instructionBits(), format);
+  MOZ_CRASH();
+}
