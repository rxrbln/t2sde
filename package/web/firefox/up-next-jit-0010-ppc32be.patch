+void MacroAssembler::moveDoubleToGPR64(FloatRegister src, Register64 dest) {
+  allocStackScratch();
+  as_stfd(src, StackPointer, StackScratchSlot);
+  // Big endian: the high word is at the lower address.
+  as_lwz(dest.high, StackPointer, StackScratchSlot);
+  as_lwz(dest.low, StackPointer, StackScratchSlot + 4);
+  freeStackScratch();
+}
+
+void MacroAssembler::moveGPR64ToDouble(Register64 src, FloatRegister dest) {
+  allocStackScratch();
+  as_stw(src.high, StackPointer, StackScratchSlot);
+  as_stw(src.low, StackPointer, StackScratchSlot + 4);
+  as_lfd(dest, StackPointer, StackScratchSlot);
+  freeStackScratch();
+}
