+    if (is_intN(src.offset, 16)) {
+      fco = FaultingCodeOffset(as_lbz(dest, scratch, src.offset).getOffset());
+    } else {
+      MOZ_ASSERT(scratch != dest);
+      movePtr(ImmWord(src.offset), dest);
+      fco = FaultingCodeOffset(as_lbzx(dest, scratch, dest).getOffset());
+    }
+    as_extsb(dest, dest);
+    return fco;
+  }
