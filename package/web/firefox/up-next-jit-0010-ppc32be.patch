+void MacroAssembler::truncDoubleToInt32(FloatRegister src, Register dest,
+                                        Label* fail) {
+  EmitFPToInt32(*this, src, dest, MacroAssemblerPPC::RoundZero, fail);
+  EmitRejectNegativeZero(*this, src, dest, fail);
+}
