+void MacroAssembler::zeroExtend8x16To16x8(FloatRegister src,
+                                          FloatRegister dest) {
+  // Unsigned widen low: interleave the low bytes with zero bytes. Order
+  // matters: the merge reads src before dest is written, and dest may alias
+  // src.
+  ScratchSimd128Scope zero(*this);
