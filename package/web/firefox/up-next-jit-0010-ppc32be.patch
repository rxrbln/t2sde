+
+void MacroAssembler::addPtr(Imm32 imm, Register dest) {
+  int32_t val = imm.value;
+  if (is_intN(val, 16)) {
+    as_addi(dest, dest, val);
+    return;
+  }
+  // addis adds the high half; the low half is a signed addi, so bias the
+  // high half by one when the low half is negative.
+  int32_t lo = int16_t(val);
+  int32_t hi = (val - lo) >> 16;
+  as_addis(dest, dest, hi);
+  if (lo != 0) {
+    as_addi(dest, dest, lo);
+  }
+}
+
+void MacroAssembler::addPtr(ImmWord imm, Register dest) {
+  addPtr(Imm32(int32_t(imm.value)), dest);
+}
