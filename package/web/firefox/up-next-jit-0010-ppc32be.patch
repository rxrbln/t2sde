+void MacroAssemblerPPCCompat::incrementInt32Value(const Address& addr) {
+  // Increment the int32 payload, which on big endian is at +4 in the Value.
+  asMasm().add32(Imm32(1), valuePayload(addr));
+}
+
+void MacroAssemblerPPCCompat::retn(Imm32 n) {
+  // Load the return address from [SP,0] before adjusting SP, since it sits at
+  // the current top of stack rather than at SP+n.
+  UseScratchRegisterScope temps(*this);
+  Register scratch = temps.Acquire();
+  as_lwz(scratch, StackPointer, 0);
+  if (n.value != 0) {
+    asMasm().addPtr(Imm32(n.value), StackPointer);
+  }
+  xs_mtlr(scratch);
+  as_blr();
+}
