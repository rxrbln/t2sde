+// Patching / near address operations.
+CodeOffset MacroAssembler::nopPatchableToCall() {
+  m_buffer.enterNoPool(LongBranchInstructions);
+  for (uint32_t i = 0; i < LongBranchInstructions; i++) {
+    writeInst(NopInst);
+  }
+  m_buffer.leaveNoPool();
+  // The returned offset is the return address (just past the stanza).
+  return CodeOffset(currentOffset());
+}
