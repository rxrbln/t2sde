+template <typename T>
+void MacroAssembler::branchTestValue(Condition cond, const T& lhs,
+                                     const ValueOperand& rhs, Label* label) {
+  MOZ_ASSERT(cond == Equal || cond == NotEqual);
+  // Big-endian nunbox32: the type word is at offset 0 and the payload at +4,
+  // which is what valuePayload() encodes.
+  Label notSameValue;
+  UseScratchRegisterScope temps(asMasm());
+  Register scratch = temps.Acquire();
+  load32(lhs, scratch);
+  Condition tagNe = ma_cmp(scratch, rhs.typeReg(), Assembler::NotEqual, true);
+  ma_b(tagNe, (cond == Assembler::Equal) ? &notSameValue : label);
+  load32(valuePayload(lhs), scratch);
+  Condition c = ma_cmp(scratch, rhs.payloadReg(), cond, true);
+  ma_b(c, label);
+  bind(&notSameValue);
+}
