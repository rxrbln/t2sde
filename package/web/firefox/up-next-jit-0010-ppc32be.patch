+void MacroAssembler::laneSelectSimd128(FloatRegister mask, FloatRegister lhs,
+                                       FloatRegister rhs, FloatRegister dest) {
+  // vsel: VRT = (VRA & ~VRC) | (VRB & VRC).
+  // laneSelect: dest = (lhs & mask) | (rhs & ~mask).
+  as_vsel(dest, rhs, lhs, mask);
+}
