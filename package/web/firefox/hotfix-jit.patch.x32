+++ firefox-153.0/js/src/jit/shared/Architecture-shared.h	2026-07-26 19:24:33.303024298 +0200
@@ -5,11 +5,50 @@
 #ifndef jit_shared_Architecture_shared_h
 #define jit_shared_Architecture_shared_h
 
+#include <bit>
+#include <stddef.h>
+#include <stdint.h>
+
 namespace js {
 namespace jit {
 
 enum class RegTypeName { GPR, Float32, Float64, Vector128, Any };
 
+// The unit the machine pushes and pops, and the unit the jit frame layouts are
+// built from. This is the register width, not the pointer width: on x86-64
+// push, pop and call all move eight bytes whatever the ABI, so under the x32
+// ABI a stack slot is twice as wide as a pointer. Everything the jit spills or
+// builds a frame out of must be described in these units rather than in
+// uintptr_t, or the layouts will not match the code that creates them.
+#ifdef JS_PUNBOX64
+using JitStackWord = uint64_t;
+#else
+using JitStackWord = uintptr_t;
+#endif
+
+static constexpr size_t JitStackWordSize = sizeof(JitStackWord);
+static_assert(JitStackWordSize >= sizeof(void*),
+              "a stack slot must be able to hold a pointer");
+
+// Storage for one pushed stack slot holding a T in its low bits.
+template <typename T>
+class JitStackSlot {
+  JitStackWord raw_;
+
+ public:
+  T get() const { return (T)(uintptr_t)raw_; }
+  void set(T value) { raw_ = (JitStackWord)(uintptr_t)value; }
+
+  // Address of the payload inside the slot, for code that roots the slot in
+  // place rather than copying it out. The payload lives in the low bytes, so
+  // this is only meaningful on a little-endian target.
+  T* addr() {
+    static_assert(std::endian::native == std::endian::little,
+                  "the payload occupies the low half of the slot");
+    return reinterpret_cast<T*>(&raw_);
+  }
+};
+
 }  // namespace jit
 }  // namespace js
 
