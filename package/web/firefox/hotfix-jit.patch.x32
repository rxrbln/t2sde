+  // Pointer-width access to memory. Under the x32 ABI a pointer occupies four
+  // bytes, so a pointer load or store must use the 32-bit form: a movq store
+  // would clobber the four bytes belonging to the following field, and a movq
+  // load would pick them up as the high half of the address. Immediates
+  // embedded in the instruction stream keep their 64-bit form, which leaves the
+  // GC data relocation format unchanged.
+#ifdef JS_64BIT
+  void movPtrOp(const Operand& src, Register dest) { movq(src, dest); }
+  void movPtrOp(Register src, const Operand& dest) { movq(src, dest); }
+  void movPtrOp(Imm32 imm, const Operand& dest) { movq(imm, dest); }
+  void cmpPtrOp(const Operand& rhs, Register lhs) { cmpq(rhs, lhs); }
