+JitStackWord MachineState::readRaw(Register reg) const {
+  if (state_.is<BailoutState>()) {
+    return state_.as<BailoutState>().regs[reg.code()].w;
+  }
+  if (state_.is<SafepointState>()) {
+    uintptr_t* addr = state_.as<SafepointState>().addressOfRegister(reg);
+    return *(JitStackWord*)addr;
+  }
+  MOZ_CRASH("Invalid state");
+}
+
+void MachineState::writeRaw(Register reg, JitStackWord value) const {
+  if (state_.is<BailoutState>()) {
+    state_.as<BailoutState>().regs[reg.code()].w = value;
+    return;
+  }
+  if (state_.is<SafepointState>()) {
+    uintptr_t* addr = state_.as<SafepointState>().addressOfRegister(reg);
+    *(JitStackWord*)addr = value;
+    return;
+  }
+  MOZ_CRASH("Invalid state");
+}
