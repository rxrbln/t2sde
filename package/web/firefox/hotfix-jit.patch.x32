+                                            Register lhs, Register rhs,
+                                            js::jit::Label* label) {
+#if defined(JS_CODEGEN_X64) && !defined(JS_64BIT)
+  masm_.branch32(cond, lhs, rhs, label);
+#else
+  masm_.branchPtr(cond, lhs, rhs, label);
+#endif
