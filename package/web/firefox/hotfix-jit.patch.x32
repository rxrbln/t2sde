+  void cmpPtrOp(Imm32 rhs, const Operand& lhs) { cmpq(rhs, lhs); }
+  void testPtrOp(Imm32 rhs, const Operand& lhs) { testq(rhs, lhs); }
+#else
+  void movPtrOp(const Operand& src, Register dest) { movl(src, dest); }
+  void movPtrOp(Register src, const Operand& dest) { movl(src, dest); }
+  void movPtrOp(Imm32 imm, const Operand& dest) { movl(imm, dest); }
+  void cmpPtrOp(const Operand& rhs, Register lhs) { cmpl(rhs, lhs); }
+  void cmpPtrOp(Register rhs, const Operand& lhs) { cmpl(rhs, lhs); }
+  void cmpPtrOp(Imm32 rhs, const Operand& lhs) { cmpl(rhs, lhs); }
+  void testPtrOp(Imm32 rhs, const Operand& lhs) { testl(rhs, lhs); }
+#endif
+
