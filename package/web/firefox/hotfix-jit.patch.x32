--- firefox-153.0/js/moz.configure.vanilla	2026-07-26 19:24:33.291978462 +0200
+++ firefox-153.0/js/moz.configure	2026-07-26 19:24:33.292468595 +0200
@@ -57,8 +57,22 @@ set_config("JS_DISABLE_SHELL", js_disabl
 
 set_define("JS_64BIT", depends(target)(lambda t: t.bitness == 64 or None))
 
-set_define("JS_PUNBOX64", depends(target)(lambda t: t.bitness == 64 or None))
-set_define("JS_NUNBOX32", depends(target)(lambda t: t.bitness == 32 or None))
+
+# The boxing model is independent of the pointer width. On the x32 ABI pointers
+# are 32 bits but the registers, and therefore the whole x64 jit backend, are
+# 64 bits wide, so Value stays punboxed: a 32-bit pointer fits in the payload.
+@depends(target)
+def js_punbox64(t):
+    return t.bitness == 64 or t.cpu == "x86_64" or None
+
+
+@depends(target)
+def js_nunbox32(t):
+    return (t.bitness == 32 and t.cpu != "x86_64") or None
+
+
+set_define("JS_PUNBOX64", js_punbox64)
+set_define("JS_NUNBOX32", js_nunbox32)
 
 
 # SpiderMonkey as a shared library, and how its symbols are exported
--- firefox-153.0/js/src/jit/Registers.h.vanilla	2026-07-26 19:24:33.292815850 +0200
+++ firefox-153.0/js/src/jit/Registers.h	2026-07-26 19:24:33.293228939 +0200
@@ -172,7 +172,18 @@ inline Register::SetType Register::Alloc
   return set;
 }
 
-#if JS_BITS_PER_WORD == 32
+// Whether the general purpose registers are 64 bits wide. This is the register
+// width, not the pointer width: under the x32 ABI pointers are 32 bits while
+// the registers, and hence Register64 and the C call return value, are 64. It
+// tracks the boxing model, which is punboxed exactly on the 64-bit-register
+// targets.
+#ifdef JS_PUNBOX64
+#  define JS_64BIT_REGISTERS 1
+#else
+#  define JS_64BIT_REGISTERS 0
+#endif
+
+#if !JS_64BIT_REGISTERS
 // Note, some platform code depends on INT64LOW_OFFSET being zero.
 static const uint32_t INT64LOW_OFFSET = 0 * sizeof(int32_t);
 static const uint32_t INT64HIGH_OFFSET = 1 * sizeof(int32_t);
@@ -222,7 +233,8 @@ class RegisterDump {
 
  public:
   static size_t offsetOfRegister(Register reg) {
-    return offsetof(RegisterDump, regs_) + reg.code() * sizeof(uintptr_t);
+    return offsetof(RegisterDump, regs_) +
+           reg.code() * sizeof(Registers::RegisterContent);
   }
   static size_t offsetOfRegister(FloatRegister reg) {
     return offsetof(RegisterDump, fpregs_) + reg.getRegisterDumpOffsetInBytes();
