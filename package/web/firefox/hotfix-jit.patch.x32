+// A pointer immediate embedded in the instruction stream is register-width,
+// which under the x32 ABI is wider than a pointer: the x64 backend keeps
+// emitting 64-bit immediates so that the data relocation format is unchanged.
+inline js::jit::JitStackWord GetPointer(const void* where) {
+  js::jit::JitStackWord res;
+  memcpy(&res, (const char*)where - sizeof(res), sizeof(res));
   return res;
 }
 
+inline void SetPointer(void* where, js::jit::JitStackWord value) {
+  memcpy((char*)where - sizeof(value), &value, sizeof(value));
+}
+
 inline void SetPointer(void* where, const void* value) {
-  memcpy((char*)where - sizeof(void*), &value, sizeof(void*));
+  SetPointer(where, js::jit::JitStackWord(uintptr_t(value)));
 }
 
