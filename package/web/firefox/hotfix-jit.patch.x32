+  // 64-bit register, so these use the 32-bit forms: that keeps every pointer
+  // canonically zero-extended, which a 64-bit negq, notq or a subq going
+  // negative would not.
+#ifdef JS_64BIT
+  template <typename... A> void addPtrOp(A&&... a) { addq(std::forward<A>(a)...); }
+  template <typename... A> void subPtrOp(A&&... a) { subq(std::forward<A>(a)...); }
+  template <typename... A> void andPtrOp(A&&... a) { andq(std::forward<A>(a)...); }
