-static const uint32_t INT64_PIECES = sizeof(int64_t) / sizeof(uintptr_t);
+// How many virtual registers an int64 occupies. This follows the register
+// width, not the pointer width: under the x32 ABI a pointer is 4 bytes but an
+// int64 still lives in a single 64-bit register.
+static const uint32_t INT64_PIECES = JS_64BIT_REGISTERS ? 1 : 2;
 
