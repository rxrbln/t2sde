+  // Pointer-width access to memory. Under the x32 ABI a pointer occupies four
+  // bytes, so a pointer load or store must use the 32-bit form: a movq store
+  // would clobber the four bytes belonging to the following field, and a movq
+  // load would pick them up as the high half of the address. Immediates
+  // embedded in the instruction stream keep their 64-bit form, which leaves the
+  // GC data relocation format unchanged.
+#ifdef JS_64BIT
+  void movPtrOp(const Operand& src, Register dest) { movq(src, dest); }
+  void movPtrOp(Register src, const Operand& dest) { movq(src, dest); }
+  void movPtrOp(Imm32 imm, const Operand& dest) { movq(imm, dest); }
+  void cmpPtrOp(const Operand& rhs, Register lhs) { cmpq(rhs, lhs); }
+  void cmpPtrOp(Register rhs, const Operand& lhs) { cmpq(rhs, lhs); }
+  void cmpPtrOp(Imm32 rhs, const Operand& lhs) { cmpq(rhs, lhs); }
+  void testPtrOp(Imm32 rhs, const Operand& lhs) { testq(rhs, lhs); }
+#else
+  void movPtrOp(const Operand& src, Register dest) { movl(src, dest); }
+  void movPtrOp(Register src, const Operand& dest) { movl(src, dest); }
+  void movPtrOp(Imm32 imm, const Operand& dest) { movl(imm, dest); }
+  void cmpPtrOp(const Operand& rhs, Register lhs) { cmpl(rhs, lhs); }
+  void cmpPtrOp(Register rhs, const Operand& lhs) { cmpl(rhs, lhs); }
+  void cmpPtrOp(Imm32 rhs, const Operand& lhs) { cmpl(rhs, lhs); }
+  void testPtrOp(Imm32 rhs, const Operand& lhs) { testl(rhs, lhs); }
+#endif
+
+  // Pointer-width arithmetic. On x32 a pointer is a 32-bit quantity held in a
+  // 64-bit register, so these use the 32-bit forms: that keeps every pointer
+  // canonically zero-extended, which a 64-bit negq, notq or a subq going
+  // negative would not.
+#ifdef JS_64BIT
+  template <typename... A> void addPtrOp(A&&... a) { addq(std::forward<A>(a)...); }
+  template <typename... A> void subPtrOp(A&&... a) { subq(std::forward<A>(a)...); }
+  template <typename... A> void andPtrOp(A&&... a) { andq(std::forward<A>(a)...); }
+  template <typename... A> void orPtrOp(A&&... a) { orq(std::forward<A>(a)...); }
+  template <typename... A> void xorPtrOp(A&&... a) { xorq(std::forward<A>(a)...); }
+  template <typename... A> void notPtrOp(A&&... a) { notq(std::forward<A>(a)...); }
+  template <typename... A> void negPtrOp(A&&... a) { negq(std::forward<A>(a)...); }
+  template <typename... A> void shlPtrOp(A&&... a) { shlq(std::forward<A>(a)...); }
+  template <typename... A> void shrPtrOp(A&&... a) { shrq(std::forward<A>(a)...); }
+  template <typename... A> void imulPtrOp(A&&... a) { imulq(std::forward<A>(a)...); }
+  template <typename... A> void movPtrRegOp(A... a) { movq(a...); }
+#else
+  template <typename... A> void addPtrOp(A&&... a) { addl(std::forward<A>(a)...); }
+  template <typename... A> void subPtrOp(A&&... a) { subl(std::forward<A>(a)...); }
+  template <typename... A> void andPtrOp(A&&... a) { andl(std::forward<A>(a)...); }
+  template <typename... A> void orPtrOp(A&&... a) { orl(std::forward<A>(a)...); }
+  template <typename... A> void xorPtrOp(A&&... a) { xorl(std::forward<A>(a)...); }
+  template <typename... A> void notPtrOp(A&&... a) { notl(std::forward<A>(a)...); }
+  template <typename... A> void negPtrOp(A&&... a) { negl(std::forward<A>(a)...); }
+  template <typename... A> void shlPtrOp(A&&... a) { shll(std::forward<A>(a)...); }
+  template <typename... A> void shrPtrOp(A&&... a) { shrl(std::forward<A>(a)...); }
+  template <typename... A> void imulPtrOp(A&&... a) { imull(std::forward<A>(a)...); }
+  template <typename... A> void movPtrRegOp(A... a) { movl(a...); }
+#endif
