+
+# The boxing model is independent of the pointer width. On the x32 ABI pointers
+# are 32 bits but the registers, and therefore the whole x64 jit backend, are
+# 64 bits wide, so Value stays punboxed: a 32-bit pointer fits in the payload.
+@depends(target)
+def js_punbox64(t):
+    return t.bitness == 64 or t.cpu == "x86_64" or None
+
+
+@depends(target)
+def js_nunbox32(t):
+    return (t.bitness == 32 and t.cpu != "x86_64") or None
+
+
+set_define("JS_PUNBOX64", js_punbox64)
+set_define("JS_NUNBOX32", js_nunbox32)
 
 
