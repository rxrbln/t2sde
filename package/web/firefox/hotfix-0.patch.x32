                       unsigned char *AAD,
-                      unsigned long Alen,
+                      PRUint64 Alen,
                       unsigned char *Tp);
 
 /* Encrypts and hashes the Plaintext.
@@ -63,13 +67,13 @@ void intel_aes_gcmAAD(unsigned char Htbl
