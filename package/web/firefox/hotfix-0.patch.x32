--- firefox-153.0/security/nss/lib/freebl/rijndael.c.vanilla	2026-07-26 17:28:10.377561489 +0200
+++ firefox-153.0/security/nss/lib/freebl/rijndael.c	2026-07-26 17:28:10.377975533 +0200
@@ -878,6 +878,13 @@ FREEBL_CIPHER_WRAP(platform_AES_GCMConte
 
 #if defined(USE_HW_AES)
 #if defined(NSS_X86_OR_X64)
+/* The cbc entry points in intel-aes.S reach AESContext.iv through a hardcoded
+ * IV_OFFSET, which shifts with the width of the worker pointer ahead of it. */
+#ifdef __ILP32__
+PR_STATIC_ASSERT(offsetof(AESContext, iv) == 252);
+#else
+PR_STATIC_ASSERT(offsetof(AESContext, iv) == 256);
+#endif
 FREEBL_CIPHER_WRAP(AESContext, intel_aes_encrypt_ecb_128);
 FREEBL_CIPHER_WRAP(AESContext, intel_aes_decrypt_ecb_128);
 FREEBL_CIPHER_WRAP(AESContext, intel_aes_encrypt_cbc_128);
--- firefox-153.0/third_party/zstd/lib/common/portability_macros.h.vanilla	2026-07-26 17:28:10.378326056 +0200
+++ firefox-153.0/third_party/zstd/lib/common/portability_macros.h	2026-07-26 17:28:10.378664587 +0200
@@ -139,10 +139,13 @@
  * - We are compiling for x86-64 and either:
  *   - DYNAMIC_BMI2 is enabled
  *   - BMI2 is supported at compile time
+ *
+ * The loop reads HUF_DecompressFastArgs with a hardcoded 8-byte stride, so it
+ * is unusable under ILP32 (x32), where the pointer members are 4 bytes wide.
  */
 #if !defined(ZSTD_DISABLE_ASM) &&                                 \
     ZSTD_ASM_SUPPORTED &&                                         \
-    defined(__x86_64__) &&                                        \
+    defined(__x86_64__) && !defined(__ILP32__) &&                 \
     (DYNAMIC_BMI2 || defined(__BMI2__))
 # define ZSTD_ENABLE_ASM_X86_64_BMI2 1
 #else
 #
Fix x32 content process crashes: the glibc struct pthread TID-cache fixup used
the LP64 tcbhead_t size, so MaybeUpdateGlibcTidCache() poked offset 712 instead
of 648 and every fork server child died on the CHECK_EQ (MOZ_CRASH) right away.
On x32 the pointers and longs of tcbhead_t are 4 bytes, shrinking it to 640.

Note SandboxLaunch.cpp compiles namespace_sandbox.inc, not the vendored
sandbox/linux/services/namespace_sandbox.cc, so the .inc needs the fix too.

--- firefox-153.0/security/sandbox/linux/launch/glibc_hack/sandbox/linux/services/namespace_sandbox.cc.vanilla	2026-07-15 22:09:52.000000000 +0200
+++ firefox-153.0/security/sandbox/linux/launch/glibc_hack/sandbox/linux/services/namespace_sandbox.cc	2026-07-26 18:05:35.291851577 +0200
@@ -90,12 +90,15 @@ void TerminationSignalHandler(int sig) {
 // https://sourceware.org/git/?p=glibc.git;a=blob;f=nptl/descr.h;hb=95a73392580761abc62fc9b1386d232cd55878e9#l121
 struct glibc_pthread {
   union {
-#  if defined(ARCH_CPU_X86_64)
+#  if defined(ARCH_CPU_X86_64) && !defined(__ILP32__)
     // On x86_64, sizeof(tcbhead_t) > sizeof(void*)*24.
     // https://sourceware.org/git/?p=glibc.git;a=blob;f=sysdeps/x86_64/nptl/tls.h;hb=95a73392580761abc62fc9b1386d232cd55878e9#l65
     // For all other architectures, sizeof(tcbhead_t) <= sizeof(void*)*24.
     // https://sourceware.org/git/?p=glibc.git&a=search&h=HEAD&st=grep&s=%7D+tcbhead_t
     char header[704];
+#  elif defined(ARCH_CPU_X86_64)
+    // On x32 the pointers and longs of tcbhead_t are 4 bytes, shrinking it to 640.
+    char header[640];
 #  endif
     void* padding[24];
   } header;


--- firefox-153.0/security/sandbox/linux/launch/glibc_hack/namespace_sandbox.inc.vanilla	2026-07-26 18:50:29.827214476 +0200
+++ firefox-153.0/security/sandbox/linux/launch/glibc_hack/namespace_sandbox.inc	2026-07-26 18:50:05.750884929 +0200
@@ -4,12 +4,15 @@
 // https://sourceware.org/git/?p=glibc.git;a=blob;f=nptl/descr.h;hb=95a73392580761abc62fc9b1386d232cd55878e9#l121
 struct glibc_pthread {
   union {
-#if defined(ARCH_CPU_X86_64)
+#if defined(ARCH_CPU_X86_64) && !defined(__ILP32__)
     // On x86_64, sizeof(tcbhead_t) > sizeof(void*)*24.
     // https://sourceware.org/git/?p=glibc.git;a=blob;f=sysdeps/x86_64/nptl/tls.h;hb=95a73392580761abc62fc9b1386d232cd55878e9#l65
     // For all other architectures, sizeof(tcbhead_t) <= sizeof(void*)*24.
     // https://sourceware.org/git/?p=glibc.git&a=search&h=HEAD&st=grep&s=%7D+tcbhead_t
     char header[704];
+#elif defined(ARCH_CPU_X86_64)
+    // On x32 the pointers and longs of tcbhead_t are 4 bytes, shrinking it to 640.
+    char header[640];
 #endif
     void* padding[24];
   } header;
