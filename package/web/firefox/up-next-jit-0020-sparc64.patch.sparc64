 template <class T>
 void MacroAssembler::boxDouble(FloatRegister src, const T& dest) {
+#ifdef JS_CODEGEN_SPARC64
+  // SPARC's hardware NaN is not the canonical one, so raw bits must not reach
+  // a Value slot; go through the canonicalizing register form.
+  UseScratchRegisterScope temps(this);
