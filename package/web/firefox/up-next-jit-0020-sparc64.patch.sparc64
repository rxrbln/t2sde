+
+#ifndef jit_sparc64_Assembler_sparc64_h
+#define jit_sparc64_Assembler_sparc64_h
+
+#include "jit/CompactBuffer.h"
+#include "jit/JitCode.h"
+#include "jit/JitSpewer.h"
