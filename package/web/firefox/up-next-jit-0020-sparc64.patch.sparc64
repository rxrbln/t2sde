+++ firefox-153.0/js/src/jit/sparc64/CodeGenerator-sparc64.cpp	2026-07-30 00:55:40.565971819 +0200
@@ -0,0 +1,2430 @@
+/* -*- Mode: C++; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * vim: set ts=8 sts=2 et sw=2 tw=80:
