+
+void MacroAssembler::loadUnaligned32(const Address& src, Register dest) {
+#ifdef JS_CODEGEN_SPARC64
+  // sparc64's load32 is |ldsw|, so the byte-wise form must sign-extend too.
+  load32Unaligned(src, dest);
+#else
+  load32(src, dest);
+#endif
+}
+
