+void MacroAssembler::branchTestUndefined(Condition cond, Register tag,
+                                         Label* label) {
+  MOZ_ASSERT(cond == Equal || cond == NotEqual);
+  Condition c = ma_cmp(tag, ImmTag(JSVAL_TAG_UNDEFINED), cond);
+  ma_b(c, label);
+}
