+  // Return to the absolute return address the JIT pushed. `call` leaves %o7
+  // pointing at the call instruction itself, so pushReturnAddress stores
+  // %o7 + 8 and every JIT frame therefore holds a real code address.
+  BufferOffset ret() {
+    UseScratchRegisterScope temps(*this);
+    Register scratch = temps.Acquire();
+    ma_load(OP3_LDX, scratch, StackPointer, 0);
+    as_add(StackPointer, StackPointer, 8);
+    return as_jmpl(g0, scratch, 0);
+  }
+
+  void j(Label* dest) { jump(dest); }
+
+  void getWasmAnyRefGCThingChunk(Register anyref, Register dest) {
+    static_assert(js::gc::ChunkShift == 20);
+    as_srlx(dest, anyref, js::gc::ChunkShift);
+    as_sllx(dest, dest, js::gc::ChunkShift);
+  }
+
+  template <typename T>
+  void loadUnboxedValue(const T& address, MIRType type, AnyRegister dest) {
+    if (dest.isFloat()) {
+      loadInt32OrDouble(address, dest.fpu());
+    } else {
+      unboxNonDouble(address, dest.gpr(), ValueTypeFromMIRType(type));
+    }
+  }
+
