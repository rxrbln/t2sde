+              row[clampCoord(int(clamp(x1, min_uv.x, max_uv.x)), width)],
+              row[clampCoord(int(clamp(x2, min_uv.x, max_uv.x)), width)],
+              row[clampCoord(int(clamp(x3, min_uv.x, max_uv.x)), width)]};
+          commit_blend_span<BLEND>(
+              buf, applyColor(bit_cast<PackedRGBA8>(texels), color));
+          x0 += uv_step.x;
+          x1 += uv_step.x;
+          x2 += uv_step.x;
+          x3 += uv_step.x;
