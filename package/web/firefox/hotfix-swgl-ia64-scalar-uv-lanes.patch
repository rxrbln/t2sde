   } else {
+#ifdef __ia64__
+    // A 16-byte Float has no register class on ia64, so the generic loop
+    // below keeps uv in general registers and clamps and converts it a lane at
+    // a time through setf/fcmp/getf, at about 43 cycles per pixel. For a
+    // clamped RGBA8 span whose row does not change, do the same per-lane float
+    // steps as scalars, which stay in FP registers, and hoist the row offset.
+    // Each lane still accumulates uv_step on its own, so the rounding matches.
+    if constexpr (!REPEAT && sizeof(P) == 4) {
+      if (uv_step.y == 0.0f && uv.y.x == uv.y.y && uv.y.x == uv.y.z &&
