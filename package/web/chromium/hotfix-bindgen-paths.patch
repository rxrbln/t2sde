--- chromium-157.0.8103.38/build/rust/gni_impl/libclang_args.gni.vanilla
+++ chromium-157.0.8103.38/build/rust/gni_impl/libclang_args.gni
@@ -28,6 +28,10 @@ if (is_win) {
 # Args that are needed in addition to `{{defines}}`, `{{cflags}}`, etc.
 _libclang_extra_args = []
 
+if (current_toolchain == default_toolchain && t2_bindgen_sysroot != "") {
+  _libclang_extra_args += [ "--sysroot=" + t2_bindgen_sysroot ]
+}
+
 # libclang will run the system `clang` to find the "resource dir" which it
 # places before the directory specified in `-isysroot`.
 # https://github.com/llvm/llvm-project/blob/699e0bed4bfead826e210025bf33e5a1997c018b/clang/lib/Tooling/Tooling.cpp#L499-L510
@@ -36,9 +40,13 @@ _libclang_extra_args = []
 # says the wrong thing. We point it to our clang's resource dir which will
 # make it behave consistently with our other command line flags and allows
 # system headers to be found.
+_t2_clang_resource_dir = clang_base_path + "/lib/clang/" + clang_version
+if (t2_clang_resource_dir != "") {
+  _t2_clang_resource_dir = t2_clang_resource_dir
+}
 _libclang_extra_args += [
   "-resource-dir",
-  rebase_path(clang_base_path + "/lib/clang/" + clang_version, root_build_dir),
+  rebase_path(_t2_clang_resource_dir, root_build_dir),
 ]
 
 if (is_win) {
--- chromium-157.0.8103.38/build/rust/rust_bindgen_generator.gni.vanilla
+++ chromium-157.0.8103.38/build/rust/rust_bindgen_generator.gni
@@ -12,7 +12,7 @@ if (host_os == "win") {
   _bindgen_path = "${_bindgen_path}.exe"
 }
 
-_rustfmt_path = "${rust_bindgen_root}/bin/rustfmt"
+_rustfmt_path = "/bin/true"
 if (!use_chromium_rust_toolchain &&
     (host_cpu == "ppc64" || host_cpu == "s390x")) {
   _rustfmt_path = rust_sysroot_absolute + "/bin/rustfmt"
@@ -32,6 +32,10 @@ if (!use_chromium_rust_toolchain &&
   _libclang_path += "/lib"
 }
 
+if (t2_libclang_path != "") {
+  _libclang_path = t2_libclang_path
+}
+
 # Template to build Rust/C bindings with bindgen.
 #
 # If you're developing first-party code then consider using `rust_bindgen`
