--- chromium-151.0.7922.75/build/config/clang/BUILD.gn.vanilla
+++ chromium-151.0.7922.75/build/config/clang/BUILD.gn
@@ -234,7 +234,23 @@
         assert(false)  # Unhandled target platform
       }

-      _clang_lib_dir = "$clang_base_path/lib/clang/$clang_version/lib"
+      _t2_clang_base_path = clang_base_path
+      if (current_cpu == host_cpu && t2_build_clang_base_path != "") {
+        _t2_clang_base_path = t2_build_clang_base_path
+      }
+
+      _dir = "linux"
+      if (current_cpu == "x64") {
+        _suffix = "-x86_64"
+      } else if (current_cpu == "x86") {
+        _suffix = "-i386"
+      } else if (current_cpu == "arm64") {
+        _suffix = "-aarch64"
+      } else if (current_cpu == "riscv64") {
+        _suffix = "-riscv64"
+      }
+
+      _clang_lib_dir = "$_t2_clang_base_path/lib"
       _lib_file = "${_prefix}clang_rt.${_libname}${_suffix}.${_ext}"
       libs = [ "$_clang_lib_dir/$_dir/$_lib_file" ]
     }
