Install as helpsurfer, surfer is the waveform viewer.

diff -urp a/data/Makefile b/data/Makefile
--- a/data/Makefile	2026-11-25 12:27:28.199505866 +0000
+++ b/data/Makefile	2026-11-25 12:27:28.204956415 +0000
@@ -13,9 +13,9 @@ distclean: clean
 
 install: all
 	$(MKDIR) $(DESTDIR)$(PREFIX)/share/applications
-	$(INSTALL) -m 0644 surfer.desktop $(DESTDIR)$(PREFIX)/share/applications/surfer.desktop
+	$(INSTALL) -m 0644 surfer.desktop $(DESTDIR)$(PREFIX)/share/applications/helpsurfer.desktop
 
 uninstall:
-	$(RM) $(DESTDIR)$(PREFIX)/share/applications/surfer.desktop
+	$(RM) $(DESTDIR)$(PREFIX)/share/applications/helpsurfer.desktop
 
 .PHONY: all clean distclean install uninstall
diff -urp a/data/surfer.desktop b/data/surfer.desktop
--- a/data/surfer.desktop	2026-11-25 12:27:28.200870846 +0000
+++ b/data/surfer.desktop	2026-11-25 12:27:28.206700652 +0000
@@ -1,7 +1,7 @@
 [Desktop Entry]
 Name=Web surfer
 Comment=Navigator to surf web pages
-Exec=surfer
+Exec=helpsurfer
 Icon=stock_internet
 Type=Application
 Categories=Network;GTK;
diff -urp a/src/Makefile b/src/Makefile
--- a/src/Makefile	2026-11-25 12:27:28.198075837 +0000
+++ b/src/Makefile	2026-11-25 12:27:28.202981360 +0000
@@ -55,10 +55,10 @@ install: all
 	$(MKDIR) $(DESTDIR)$(BINDIR)
 	$(INSTALL) -m 0755 download $(DESTDIR)$(BINDIR)/download
 	$(MKDIR) $(DESTDIR)$(BINDIR)
-	$(INSTALL) -m 0755 surfer $(DESTDIR)$(BINDIR)/surfer
+	$(INSTALL) -m 0755 surfer $(DESTDIR)$(BINDIR)/helpsurfer
 
 uninstall:
 	$(RM) $(DESTDIR)$(BINDIR)/download
-	$(RM) $(DESTDIR)$(BINDIR)/surfer
+	$(RM) $(DESTDIR)$(BINDIR)/helpsurfer
 
 .PHONY: all clean distclean install uninstall
