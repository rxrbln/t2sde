[I] WWW capable pager

[T] w3m is a pager with WWW capability. It IS a pager, but it can be
[T] used as a text-mode WWW browser.

[U] https://w3m.sourceforge.net/

[A] Akinori Ito <aito@fw.ipsj.or.jp>
[M] René Rebe <rene@exactco.de>

[C] extra/office
[F] CROSS

[L] Free-to-use
[V] 0.5.6

[D] b89064021c4db891409baab8083c6bc7e4ae5d0ceb1dc7cc1c894e6f w3m-0.5.6.tar.gz !https://git.sr.ht/~rkta/w3m/archive/v0.5.6.tar.gz

var_append confopt ' ' --with-ssl
var_append GCC_WRAPPER_APPEND ' ' -I$root$(pkgprefix includedir imlib2)
var_append GCC_WRAPPER_APPEND ' ' -L$root$(pkgprefix libdir libx11)
var_append GCC_WRAPPER_APPEND ' ' -std=gnu11

# mktable generates sources at build time, build it for the host
w3m_native_mktable() {
	local cflags="-I. -Ilibwc -I$root/TOOLCHAIN/cross/include -DHAVE_CONFIG_H"
	$BUILDCC $cflags -DDUMMY -c -o native-dummy.o entity.c
	$BUILDCC $cflags -o mktable mktable.c native-dummy.o Str.c hash.c myctype.c \
		-L$root/TOOLCHAIN/cross/lib -Wl,-rpath,$root/TOOLCHAIN/cross/lib -lgc
}
if atstage cross; then
	hook_add premake 5 w3m_native_mktable
	var_append makeopt ' ' '-o mktable'
	var_append makeinstopt ' ' '-o mktable'
fi

var_append makeopt ' ' 'mkdir_p="mkdir -p"'
var_append makeinstopt ' ' 'mkdir_p="mkdir -p"'
