diff -urp a/build/moz.configure/init.configure b/build/moz.configure/init.configure
--- a/build/moz.configure/init.configure	2026-11-24 22:31:40.269511674 +0000
+++ b/build/moz.configure/init.configure	2026-11-24 22:31:41.332929155 +0000
@@ -573,7 +573,7 @@ def split_triplet(triplet, allow_wasi=Fa
         canonical_cpu = "mips32"
         endianness = "little" if "el" in cpu else "big"
     elif cpu in ("mips64", "mips64el"):
-        canonical_cpu = "mips64"
+        canonical_cpu = "mips32"
         endianness = "little" if "el" in cpu else "big"
     elif cpu.startswith("aarch64"):
         canonical_cpu = "aarch64"
diff -urp a/python/mozbuild/mozbuild/configure/constants.py b/python/mozbuild/mozbuild/configure/constants.py
--- a/python/mozbuild/mozbuild/configure/constants.py	2026-11-24 22:31:33.175548967 +0000
+++ b/python/mozbuild/mozbuild/configure/constants.py	2026-11-24 22:31:41.340441211 +0000
@@ -124,8 +124,8 @@ CPU_preprocessor_checks = {
     "sparc64": "__sparc__ && __arch64__",
     "sparc": "__sparc__",
     "m68k": "__m68k__",
-    "mips64": "__mips64",
-    "mips32": "__mips__",
+    "mips64": "__mips64 && _ABI64",
+    "mips32": "__mips__ || (__mips64 && _ABIN32)",
     "riscv64": "__riscv && __riscv_xlen == 64",
     "loongarch64": "__loongarch64",
     "sh4": "__sh__",
