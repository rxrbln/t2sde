Only use sccache for the Rust crates with LADYBIRD_ENABLE_CCACHE, T2 has its
own compiler cache support.

--- ladybird.orig/Meta/CMake/rust_crate.cmake
+++ ladybird/Meta/CMake/rust_crate.cmake
@@ -7,7 +7,7 @@ find_program(RUST_RUSTC rustc REQUIRED)
 if (NOT DEFINED RUSTC_WRAPPER)
     set(RUSTC_WRAPPER "$ENV{RUSTC_WRAPPER}" CACHE FILEPATH "Path to a rustc wrapper program, e.g. sccache")
 endif()
-if (NOT RUSTC_WRAPPER)
+if (NOT RUSTC_WRAPPER AND LADYBIRD_ENABLE_CCACHE)
     find_program(SCCACHE_PROGRAM sccache)
     if (SCCACHE_PROGRAM)
         set(RUSTC_WRAPPER "${SCCACHE_PROGRAM}" CACHE FILEPATH "Path to a rustc wrapper program, e.g. sccache" FORCE)
