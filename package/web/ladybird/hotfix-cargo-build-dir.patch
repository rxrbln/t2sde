Find the FFI headers in the build script output of the newer cargo layout.

--- ladybird.orig/Meta/CMake/sync_rust_ffi_header.cmake
+++ ladybird/Meta/CMake/sync_rust_ffi_header.cmake
@@ -12,7 +12,9 @@ if (FFI_HEADER STREQUAL "")
     return()
 endif()
 
-file(GLOB root_output_files "${CARGO_BUILD_SCRIPT_DIR}/${CRATE_NAME}-*/root-output")
+# newer cargo lays out the build script directory as <crate>/<hash>/run
+file(GLOB root_output_files "${CARGO_BUILD_SCRIPT_DIR}/${CRATE_NAME}-*/root-output"
+     "${CARGO_BUILD_SCRIPT_DIR}/${CRATE_NAME}/*/run/root-output")
 
 set(latest_source_header "")
 set(latest_root_output_timestamp "")
