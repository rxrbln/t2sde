[I] A library for high-performance machine learning primitives

[T] MIOpen is AMD's library for high-performance machine learning primitives.

[U] https://github.com/ROCm/MIOpen

[A] Advanced Micro Devices, Inc.
[M] René Rebe <rene@exactco.de>

[F] CROSS
[C] extra/development

[L] MIT
[V] 7.14.0
[P] X -----5---9 300.345

[CV-GROUP] rocm
[D] 24d23babf9a3b973842e5c84e3257b136afdb8e0d7eaeff87cf2c8b5 rocm-libraries-7.14.0.tar.gz https://github.com/ROCm/rocm-libraries/archive/therock-7.14/

rocm_project=miopen
. $base/package/*/*/rocm-conf.in

var_append cmakeopt ' ' -DCMAKE_C_COMPILER=/$prefix/bin/clang
var_append cmakeopt ' ' -DCMAKE_CXX_COMPILER=/$prefix/bin/clang++
var_append cmakeopt ' ' "-DGPU_TARGETS='$SDECFG_PKG_ROCM_ARCHS'"
var_append cmakeopt ' ' "-DBUILD_TESTING=OFF -DMIOPEN_BUILD_DRIVER=OFF"
pkginstalled frugally-deep ||
	var_append cmakeopt ' ' "-DMIOPEN_ENABLE_AI_KERNEL_TUNING=OFF -DMIOPEN_ENABLE_AI_IMMED_MODE_FALLBACK=OFF"
pkginstalled composable_kernel || var_append cmakeopt ' ' -DMIOPEN_USE_COMPOSABLEKERNEL=OFF
