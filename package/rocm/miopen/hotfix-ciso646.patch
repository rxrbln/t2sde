<ciso646> is no standard header since C++20, libstdc++ 16 warns and MIOpen
builds with -Werror. It is empty in C++ anyway.

diff -urp a/projects/miopen/src/include/miopen/serializable.hpp b/projects/miopen/src/include/miopen/serializable.hpp
--- a/projects/miopen/src/include/miopen/serializable.hpp	2026-11-24 19:37:50.718237875 +0000
+++ b/projects/miopen/src/include/miopen/serializable.hpp	2026-11-24 19:37:50.719231569 +0000
@@ -27,7 +27,6 @@
 #ifndef GUARD_MLOPEN_SERIALIZABLE_HPP
 #define GUARD_MLOPEN_SERIALIZABLE_HPP
 
-#include <ciso646>
 #include <miopen/config.h>
 #include <iostream>
 #include <sstream>
