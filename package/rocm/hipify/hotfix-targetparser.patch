hipify-clang uses llvm::Triple, link the TargetParser split out of Support in LLVM 16.

--- HIPIFY-rocm-7.2.4.orig/CMakeLists.txt
+++ HIPIFY-rocm-7.2.4/CMakeLists.txt
@@ -91,6 +91,10 @@ if (NOT HIPIFY_CLANG_TESTS_ONLY)
     list(APPEND HIPIFY_ADDL_LINK_LIBS clangSupport)
   endif()
 
+  if(LLVM_PACKAGE_VERSION VERSION_EQUAL "16.0.0" OR LLVM_PACKAGE_VERSION VERSION_GREATER "16.0.0")
+    list(APPEND LLVM_LINK_COMPONENTS TargetParser)
+  endif()
+
 
   add_llvm_executable(hipify-clang
     ${HIPIFY_SOURCES} ${HIPIFY_HEADERS}
