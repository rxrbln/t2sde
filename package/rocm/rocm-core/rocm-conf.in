[ $prefix_auto = 1 ] && prefix=opt/rocm && set_confopt

# sort rocm prefix 1st to prefer amd llvm/clang & friends
PATH="$bindir:$PATH"

var_append cmakeopt ' ' -DROCM_VERSION=$ver

# rocm-libraries and rocm-systems monorepo components: only extract their
# projects/$rocm_project (and $rocm_extra, both or a path like shared/foo),
# the shared and top-level cmake parts, and configure the project directory
if [ "$rocm_project" ]; then
	rocm_extract() {
		local top=$(tar -tf $1 | head -n 1) x dirs
		top=${top%%/*} dirs=${top%%/*}/shared
		[[ $top = rocm-libraries-* ]] && dirs="$dirs $top/cmake $top/CMakeLists.txt"
		for x in $rocm_project $rocm_extra; do
			[[ $x = */* ]] || x=projects/$x
			[[ $x = shared/* ]] || dirs="$dirs $top/$x"
		done
		echo "Extracting $dirs ..."
		tar -v $taropt $1 $dirs > untar.txt
	}
	custextract=rocm_extract
	if [[ $rocm_project != */* ]]; then
		cmakelists=projects/$rocm_project/CMakeLists.txt
		hook_add preconf 9 "var_append cmakeopt ' ' '\$builddir/\$xsrcdir/projects/$rocm_project/.'"
	fi
fi
