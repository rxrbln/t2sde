The tests and CI mode were forced on "temporarily for CI", make them options
again with the same defaults.

diff -urp a/projects/rocprofiler/CMakeLists.txt b/projects/rocprofiler/CMakeLists.txt
--- a/projects/rocprofiler/CMakeLists.txt	2026-11-24 19:53:58.282952517 +0000
+++ b/projects/rocprofiler/CMakeLists.txt	2026-11-24 19:53:58.290683869 +0000
@@ -198,9 +198,8 @@ endif()
 
 enable_testing()
 
-# Temporarily for CI to work
-set(ROCPROFILER_BUILD_TESTS ON)
-set(ROCPROFILER_BUILD_CI ON)
+option(ROCPROFILER_BUILD_TESTS "Build the tests" ON)
+option(ROCPROFILER_BUILD_CI "Build for CI" ON)
 
 if(ROCPROFILER_BUILD_CI)
     include(CTest)
