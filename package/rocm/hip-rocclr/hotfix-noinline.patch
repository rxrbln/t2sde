Do not define __noinline__ empty for non-HIP compiles, it breaks the
[[__gnu__::__noinline__]] of libstdc++ 16 <format>, <stacktrace> and simd.

--- clr-rocm-7.2.4.orig/hipamd/include/hip/amd_detail/host_defines.h
+++ clr-rocm-7.2.4/hipamd/include/hip/amd_detail/host_defines.h
@@ -250,7 +250,6 @@ typedef __hip_internal::int64_t __hip_in
 
 #define __global__
 
-#define __noinline__
 #define __forceinline__ inline
 
 #define __shared__
