[I] A SPARSE marshalling library

[T] hipSPARSELt is a SPARSE marshalling library, with multiple supported
[T] backends. It sits between the application and a 'worker' SPARSE library,
[T] marshalling inputs into the backend library and marshalling results back to
[T] the application.

[U] https://github.com/ROCm/hipSPARSELt

[A] Advanced Micro Devices, Inc.
[M] René Rebe <rene@exactco.de>

[F] CROSS OBJDIR
[C] extra/development

[L] MIT
[V] 7.14.0
[P] X -----5---9 300.315

[CV-GROUP] rocm
[D] 24d23babf9a3b973842e5c84e3257b136afdb8e0d7eaeff87cf2c8b5 rocm-libraries-7.14.0.tar.gz https://github.com/ROCm/rocm-libraries/archive/therock-7.14/

rocm_project=hipsparselt rocm_extra=hipblaslt
. $base/package/*/*/rocm-conf.in

var_append cmakeopt ' ' -DCMAKE_C_COMPILER=/$prefix/bin/clang
var_append cmakeopt ' ' -DCMAKE_CXX_COMPILER=/$prefix/bin/clang++
var_append cmakeopt ' ' "-DHIP_PLATFORM=amd -DHIP_COMPILER=clang"
gpu_targets=$(echo "$SDECFG_PKG_ROCM_ARCHS" | tr ';' '\n' | grep -E '^gfx(942|950|1250)' | paste -sd ';')
var_append cmakeopt ' ' "-DGPU_TARGETS='$gpu_targets'"
var_append cmakeopt ' ' "-DHIPSPARSELT_BUILD_TESTING=OFF -DHIPSPARSELT_ENABLE_CLIENT=OFF"
pkginstalled roctracer || var_append cmakeopt ' ' -DHIPSPARSELT_ENABLE_MARKER=OFF
var_append cmakeopt ' ' "-DFETCHCONTENT_FULLY_DISCONNECTED=ON -DFETCHCONTENT_SOURCE_DIR_ROCMCMAKEBUILDTOOLS=/$(pkgprefix rocm-cmake)"
var_append cmakeopt ' ' '-Dnanobind_DIR=$(python3 -m nanobind --cmake_dir)'

# the bundled hipblaslt tensilelite needs the hipblaslt fixes
var_append patchfiles ' ' "$(ls $confdir/../hipblaslt/*.patch)"
