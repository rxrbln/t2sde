Do not pass an empty argument to the assembler without debug, clang takes it
as missing input file.

--- rocm-libraries-rocm-7.2.4.orig/projects/hipblaslt/tensilelite/Tensile/Toolchain/Component.py
+++ rocm-libraries-rocm-7.2.4/projects/hipblaslt/tensilelite/Tensile/Toolchain/Component.py
@@ -154,7 +154,7 @@ class Assembler(Component):
             str(component_path),
             "-x", "assembler",
             "--target=amdgcn-amd-amdhsa",
-            "-g" if debug else "",
+            *(["-g"] if debug else []),
             f"-mcode-object-version={co_version}",
             "-c",
         ]
