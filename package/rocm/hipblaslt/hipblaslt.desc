[I] A library that provides general matrix-matrix operations

[T] hipBLASLt is a library that provides general matrix-matrix operations. It
[T] has a flexible API that extends functionalities beyond a traditional BLAS
[T] library, such as adding flexibility to matrix data layouts, input types,
[T] compute types, and algorithmic implementations and heuristics.

[U] https://github.com/ROCm/hipBLASLt

[A] Advanced Micro Devices, Inc.
[M] René Rebe <rene@exactco.de>

[F] CROSS OBJDIR
[C] extra/development

[L] MIT
[V] 7.14.0
[P] X -----5---9 300.190

[CV-GROUP] rocm
[D] 24d23babf9a3b973842e5c84e3257b136afdb8e0d7eaeff87cf2c8b5 rocm-libraries-7.14.0.tar.gz https://github.com/ROCm/rocm-libraries/archive/therock-7.14/

rocm_project=hipblaslt
. $base/package/*/*/rocm-conf.in

var_append cmakeopt ' ' -DCMAKE_C_COMPILER=/$prefix/bin/clang
var_append cmakeopt ' ' -DCMAKE_CXX_COMPILER=/$prefix/bin/clang++
var_append cmakeopt ' ' "-DHIP_PLATFORM=amd -DHIP_COMPILER=clang"
var_append cmakeopt ' ' "-DAMDGPU_TARGETS='$SDECFG_PKG_ROCM_ARCHS'"
gpu_targets=$(echo "$SDECFG_PKG_ROCM_ARCHS" | tr ';' '\n' | grep -v '^gfx10' | paste -sd ';')
[ "$gpu_targets" ] && var_append cmakeopt ' ' "-DGPU_TARGETS='$gpu_targets'"
var_append cmakeopt ' ' "-DHIPBLASLT_ENABLE_CLIENT=OFF -DHIPBLASLT_BUILD_TESTING=OFF -DHIPBLASLT_ENABLE_SAMPLES=OFF"
var_append cmakeopt ' ' "-DFETCHCONTENT_FULLY_DISCONNECTED=ON -DFETCHCONTENT_SOURCE_DIR_ROCMCMAKEBUILDTOOLS=/$(pkgprefix rocm-cmake)"
var_append cmakeopt ' ' '-Dnanobind_DIR=$(python3 -m nanobind --cmake_dir)'
