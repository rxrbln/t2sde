Use the system yaml-cpp, fmt, libdivide and nanobind instead of fetching them.

diff -urp a/projects/hipblaslt/CMakeLists.txt b/projects/hipblaslt/CMakeLists.txt
--- a/projects/hipblaslt/CMakeLists.txt	2026-11-24 13:27:11.306455929 +0000
+++ b/projects/hipblaslt/CMakeLists.txt	2026-11-24 13:27:11.312503124 +0000
@@ -227,7 +227,7 @@ if(HIPBLASLT_ENABLE_ROCROLLER)
             find_package(rocroller REQUIRED)
         else()
             block(SCOPE_FOR VARIABLES)
-                set(ROCROLLER_ENABLE_FETCH ON)
+                set(ROCROLLER_ENABLE_FETCH OFF)
                 set(ROCROLLER_BUILD_TESTING OFF)
                 set(ROCROLLER_ENABLE_CLIENT OFF)
                 option(YAML_CPP_INSTALL "" ON)
diff -urp a/projects/hipblaslt/tensilelite/rocisa/CMakeLists.txt b/projects/hipblaslt/tensilelite/rocisa/CMakeLists.txt
--- a/projects/hipblaslt/tensilelite/rocisa/CMakeLists.txt	2026-11-24 13:27:11.308565863 +0000
+++ b/projects/hipblaslt/tensilelite/rocisa/CMakeLists.txt	2026-11-24 13:27:11.320212347 +0000
@@ -49,13 +49,7 @@ if(HIPBLASLT_BUNDLE_PYTHON_DEPS OR ROCIS
         endif()
         find_package(nanobind REQUIRED CONFIG)
     else()
-        include(FetchContent)
-        FetchContent_Declare(
-          nanobind
-          GIT_REPOSITORY https://github.com/wjakob/nanobind.git
-          GIT_TAG        9b3afa9dbdc23641daf26fadef7743e7127ff92f # v2.6.1
-        )
-        FetchContent_MakeAvailable(nanobind)
+        find_package(nanobind CONFIG REQUIRED)
         if(ROCISA_USE_STABLE_ABI)
             find_package(Python 3.12 COMPONENTS Interpreter Development.Module Development.SABIModule REQUIRED)
         endif()
diff -urp a/shared/rocroller/CMakeLists.txt b/shared/rocroller/CMakeLists.txt
--- a/shared/rocroller/CMakeLists.txt	2026-11-24 13:27:11.311236994 +0000
+++ b/shared/rocroller/CMakeLists.txt	2026-11-24 13:27:11.312657163 +0000
@@ -64,7 +64,7 @@ else()
     unset(CMAKE_CXX_CPPCHECK CACHE)
 endif()
 
-find_package(fmt 11.1.3 QUIET)
+find_package(fmt QUIET)
 if(NOT fmt_FOUND)
     if(ROCROLLER_ENABLE_FETCH)
         set(FMT_SYSTEM_HEADERS ON)
