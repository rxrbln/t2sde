Use the system yaml-cpp, fmt, libdivide and nanobind instead of fetching them.

--- rocm-libraries-rocm-7.2.4.orig/projects/hipblaslt/CMakeLists.txt
+++ rocm-libraries-rocm-7.2.4/projects/hipblaslt/CMakeLists.txt
@@ -185,7 +185,7 @@ if(HIPBLASLT_ENABLE_ROCROLLER)
             find_package(rocroller REQUIRED)
         else()
             block(SCOPE_FOR VARIABLES)
-                set(ROCROLLER_ENABLE_FETCH ON)
+                set(ROCROLLER_ENABLE_FETCH OFF)
                 set(ROCROLLER_BUILD_TESTING OFF)
                 set(ROCROLLER_ENABLE_CLIENT OFF)
                 option(YAML_CPP_INSTALL "" ON)
--- rocm-libraries-rocm-7.2.4.orig/projects/hipblaslt/tensilelite/rocisa/CMakeLists.txt
+++ rocm-libraries-rocm-7.2.4/projects/hipblaslt/tensilelite/rocisa/CMakeLists.txt
@@ -18,12 +18,7 @@ target_include_directories(rocisa-cpp
 
 if(HIPBLASLT_BUNDLE_PYTHON_DEPS)
     include(FetchContent)
-    FetchContent_Declare(
-      nanobind
-      GIT_REPOSITORY https://github.com/wjakob/nanobind.git
-      GIT_TAG        9b3afa9dbdc23641daf26fadef7743e7127ff92f # v2.6.1
-    )
-    FetchContent_MakeAvailable(nanobind)
+    find_package(nanobind CONFIG REQUIRED)
 
     set(ROCISAINST_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/rocisa/src/instruction/instruction.cpp"
                           "${CMAKE_CURRENT_SOURCE_DIR}/rocisa/src/instruction/common.cpp"
--- rocm-libraries-rocm-7.2.4.orig/shared/rocroller/CMakeLists.txt
+++ rocm-libraries-rocm-7.2.4/shared/rocroller/CMakeLists.txt
@@ -72,7 +72,7 @@ else()
     unset(CMAKE_CXX_CPPCHECK CACHE)
 endif()
 
-find_package(fmt 11.1.3 QUIET)
+find_package(fmt QUIET)
 if(NOT fmt_FOUND)
     if(ROCROLLER_ENABLE_FETCH)
         set(FMT_SYSTEM_HEADERS ON)
