--- systemd-262.1/src/basic/architecture.h.vanilla	2026-11-02 14:58:35.726153297 +0100
+++ systemd-262.1/src/basic/architecture.h	2026-11-02 15:01:46.062771284 +0100
@@ -18,6 +18,7 @@
         ARCHITECTURE_ARM64_BE,
         ARCHITECTURE_ARM_BE,
         ARCHITECTURE_CRIS,
+        ARCHITECTURE_I860,
         ARCHITECTURE_IA64,
         ARCHITECTURE_LOONGARCH64,
         ARCHITECTURE_M68K,
@@ -94,6 +95,9 @@
 #    define native_architecture() ARCHITECTURE_PPC_LE
 #    error "Missing LIB_ARCH_TUPLE for PPCLE"
 #  endif
+#elif defined(__i860__)
+#  define native_architecture() ARCHITECTURE_I860
+#  define LIB_ARCH_TUPLE "i860-linux-gnu"
 #elif defined(__ia64__)
 #  define native_architecture() ARCHITECTURE_IA64
 #  define LIB_ARCH_TUPLE "ia64-linux-gnu"
--- systemd-262.1/src/basic/architecture.c.vanilla	2026-11-02 14:54:49.707769485 +0100
+++ systemd-262.1/src/basic/architecture.c	2026-11-02 14:57:00.303920072 +0100
@@ -62,6 +62,9 @@
                 { "i486",       ARCHITECTURE_X86      },
                 { "i386",       ARCHITECTURE_X86      },
 
+#elif defined(__i860__)
+                { "i860",       ARCHITECTURE_I860     },
+
 #elif defined(__ia64__)
                 { "ia64",       ARCHITECTURE_IA64     },
 
@@ -152,6 +155,7 @@
         [ARCHITECTURE_CRIS]        = "cris",
         [ARCHITECTURE_X86_64]      = "x86-64",
         [ARCHITECTURE_X86]         = "x86",
+        [ARCHITECTURE_I860]        = "i860",
         [ARCHITECTURE_IA64]        = "ia64",
         [ARCHITECTURE_LOONGARCH64] = "loongarch64",
         [ARCHITECTURE_M68K]        = "m68k",

