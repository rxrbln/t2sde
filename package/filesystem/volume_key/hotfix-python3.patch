Map the remaining Python 2 string API used by the SWIG typemaps to Python 3.

--- volume_key-volume_key-0.3.12.orig/python/volume_key.i
+++ volume_key-volume_key-0.3.12/python/volume_key.i
@@ -38,10 +38,12 @@
   const char *b = PyUnicode_AsUTF8AndSize(obj, length);
   if (b == NULL)
     return -1;
-  *buffer = b;
+  *buffer = (char *)b;
   return 0;
 }
 #define PyString_FromStringAndSize(u, len) PyUnicode_FromStringAndSize(u, len)
+#define PyString_AsString(o) ((char *)PyUnicode_AsUTF8(o))
+#define PyString_FromString(s) PyUnicode_FromString(s)
 #endif
 
 /* Drop a reference to a Python object. */
