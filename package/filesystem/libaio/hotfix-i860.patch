libaio: io_getevents for 32-bit kernels with 64-bit time only

Signed-off-by: René Rebe <rene@exactco.de>

diff -Nurp a/src/io_getevents.c b/src/io_getevents.c
--- a/src/io_getevents.c	2022-03-28 17:30:33.000000000 +0200
+++ b/src/io_getevents.c	2026-11-02 10:18:34.794130653 +0100
@@ -23,8 +23,16 @@
 #include "syscall.h"
 #include "aio_ring.h"
 
+#ifndef __NR_io_getevents
+/* 32-bit kernels with 64-bit time only have this one */
+static int __io_getevents_0_4(io_context_t ctx, long min_nr, long nr, struct io_event *events,
+			      struct timespec *timeout)
+_body_io_syscall(io_pgetevents_time64, (long)ctx, min_nr, nr, (long)events, (long)timeout, 0L)
+#else
 io_syscall5(int, __io_getevents_0_4, io_getevents, io_context_t, ctx, long, min_nr, long, nr, struct io_event *, events, struct timespec *, timeout)
 
+#endif
+
 int io_getevents_0_4(io_context_t ctx, long min_nr, long nr, struct io_event * events, struct timespec * timeout)
 {
 	if (aio_ring_is_empty(ctx, timeout))
