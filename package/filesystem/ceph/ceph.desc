# tests
var_append cmakeopt ' ' "-DWITH_CATCH2=OFF -DWITH_TESTS=OFF"

var_remove cmakeopt ' ' "-DBUILD_SHARED_LIBS=ON"

var_append cmakeopt ' ' "-DOpenLDAP_INCLUDE_DIR=$(pkgprefix includedir openldap) -DLDAP_LIBRARY=$(pkgprefix libdir openldap) -DLBER_LIBRARY=$(pkgprefix libdir openldap)"

# needs babeltrace v1 we have v2
var_append cmakeopt ' ' -DWITH_BABELTRACE=OFF

var_append cmakeopt ' ' "-DWITH_JAEGER=OFF -DWITH_NVMEOF_GATEWAY_MONITOR_CLIENT=OFF -DWITH_RADOSGW=OFF"
