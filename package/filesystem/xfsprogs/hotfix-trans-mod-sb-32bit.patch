trans.c with long: conflicting types on 32-bit (long != int64_t). Use int64_t.

--- a/libxfs/xfs_platform.h	2026-11-08 19:01:28.364648292 +0100
+++ b/libxfs/xfs_platform.h	2026-11-08 19:01:28.374113755 +0100
@@ -408,7 +408,7 @@
 /* percpu counters in mp are #defined to the superblock sb_ counters */
 #define xfs_reinit_percpu_counters(mp)
 
-void xfs_trans_mod_sb(struct xfs_trans *, uint, long);
+void xfs_trans_mod_sb(struct xfs_trans *, uint, int64_t);
 
 void xfs_verifier_error(struct xfs_buf *bp, int error,
 			xfs_failaddr_t failaddr);
--- a/libxfs/trans.c	2026-11-08 19:01:28.364648292 +0100
+++ b/libxfs/trans.c	2026-11-08 19:01:28.380392398 +0100
@@ -845,7 +845,7 @@
 libxfs_trans_mod_sb(
 	xfs_trans_t		*tp,
 	uint			field,
-	long			delta)
+	int64_t			delta)
 {
 	switch (field) {
 	case XFS_TRANS_SB_RES_FDBLOCKS:
