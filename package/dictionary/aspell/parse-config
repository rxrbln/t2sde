# dictionaries are compiled by the stage 0 aspell, install to the target dict-dir
aspell_dict_cross() {
	var_append makeinstopt ' ' "dictdir=$libdir/aspell-0.60 datadir=$libdir/aspell-0.60"
}
if [[ $pkg = aspell-* ]] && ! atstage native; then
	export ASPELL=$arch_target-aspell PREZIP=$arch_target-prezip-bin
	hook_add premake 5 aspell_dict_cross
fi
