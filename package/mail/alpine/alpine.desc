[I] A program to manage e-mail

[T] Alpine is a rewrite of PINE.

[U] https://alpineapp.email

[A] University of Washington
[M] René Rebe <rene@exactco.de>

[C] extra/network
[F] CROSS NOPARALLEL

[E] opt tcl

[L] APL
[V] 2.29.9

[D] a229fb51682c15bcba4d07b832961afce4a78bb3945679581a4e45f7 alpine-2.29.9.tar.gz git+https://repo.or.cz/alpine.git v2.29.9

alpine_host_gen() {
	$BUILDCC -o pith/help_h_gen pith/help_h_gen.c
	$BUILDCC -o pith/help_c_gen pith/help_c_gen.c
}
if atstage cross; then
	hook_add premake 5 alpine_host_gen
	# no prerequisites, keeps the native helpers, make -o is not passed to sub-makes
	var_append makeopt ' ' 'help_h_gen_OBJECTS= help_c_gen_OBJECTS= help_h_gen_DEPENDENCIES= help_c_gen_DEPENDENCIES='
	var_append makeinstopt ' ' 'help_h_gen_OBJECTS= help_c_gen_OBJECTS= help_h_gen_DEPENDENCIES= help_c_gen_DEPENDENCIES='
fi
