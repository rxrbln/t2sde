With the system Python packages, an installed gyp-next precedes the vendored
gyp the mozbuild gyp reader is written for.

--- a/python/mozbuild/mozbuild/frontend/gyp_reader.py
+++ b/python/mozbuild/mozbuild/frontend/gyp_reader.py
@@ -7,6 +7,15 @@ import sys
 import time
 from collections.abc import Iterable
 
+# the vendored gyp, not an API incompatible system gyp-next
+sys.path.insert(
+    0,
+    os.path.join(
+        os.path.dirname(os.path.abspath(__file__)),
+        *[os.pardir] * 4,
+        "third_party", "python", "gyp", "pylib",
+    ),
+)
 import gyp
 import gyp.msvs_emulation
 import mozpack.path as mozpath
