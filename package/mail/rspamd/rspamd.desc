[I] Fast, free and open-source spam filtering system

[T] Rspamd is an advanced spam filtering system and email processing
[T] framework that allows evaluation of messages by a number of rules
[T] and custom services such as URL black lists. Each message is
[T] analysed by Rspamd and given a verdict that might be used by MTA
[T] for further processing.

[U] https://rspamd.com/

[A] Vsevolod Stakhov <vsevolod@rspamd.com>
[M] René Rebe <rene@exactco.de>

[C] extra/security
[F] CROSS

[L] APL
[V] 4.2.2

[D] 4ff8d839a93daa76daf74a7a79312048fa2372b0f85d0a113510daed rspamd-4.2.2.tar.gz https://github.com/rspamd/rspamd/archive/4.2.2/

pkginstalled luajit || var_append cmakeopt ' ' -DENABLE_LUAJIT=OFF

atstage cross && var_append cmakeopt ' ' '-DHAVE_ATOMIC_BUILTINS_EXITCODE=0 -D_CAN_RUN=1'

# the snowball stemmer compiler runs at build time
rspamd_native_snowball() {
	(cd contrib/snowball && $BUILDCC -O2 -Iinclude -DDISABLE_JS -DDISABLE_GO -DDISABLE_JAVA \
		-DDISABLE_PYTHON -DDISABLE_CSHARP -DDISABLE_PASCAL -DDISABLE_RUST \
		-o $builddir/snowball compiler/space.c compiler/tokeniser.c compiler/analyser.c \
		compiler/generator.c compiler/driver.c) || return 1
	var_append cmakeopt ' ' -DSNOWBALL_EXECUTABLE=$builddir/snowball
}
atstage cross && hook_add preconf 5 rspamd_native_snowball
