--- exim-4.100.1.orig/scripts/exim_install	2026-10-17 22:01:49.665309908 +0200
+++ exim-4.100.1/scripts/exim_install	2026-10-17 22:01:49.673989371 +0200
@@ -224,6 +224,11 @@ while [ $# -gt 0 ]; do
     version=exim-`$exim 2>/dev/null | \
       awk '/Exim version/ { OFS=""; print $3,"-",substr($4,2,length($4)-1) }'`${EXE}
 
+    # a cross compiled exim can not run, use the build version and number
+    if [ "${version}" = "exim-${EXE}" ] && [ -f cnumber.h ] && [ -f version.h ]; then
+      version=exim-`sed -n 's/^#define EXIM_RELEASE_VERSION "\(.*\)"/\1/p' version.h`-`cat cnumber.h`${EXE}
+    fi
+
     if [ "${version}" = "exim-${EXE}" ]; then
       echo $com ""
       echo $com "*** Could not run $exim to find version number ***"
