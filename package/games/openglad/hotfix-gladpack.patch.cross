Pack the data with the build host gladpack.

diff -Nrup a/Makefile.am b/Makefile.am
--- a/Makefile.am	2003-01-09 08:00:33.000000000 +0100
+++ b/Makefile.am	2026-10-22 17:22:42.616520897 +0200
@@ -13,14 +13,14 @@ data_DATA = graphics.001 levels.001 star
 # scen/ and pix/ contents anyway, so best leave this for build time
 ## Make sure the .001 files are really up to date
 #dist-hook:
-#	cd pix; ../util/gladpack p ../@PACKAGE@-@VERSION@/graphics.001 *.pix
-#	cd scen; ../util/gladpack p ../@PACKAGE@-@VERSION@/levels.001 *.fss
+#	cd pix; ../util/gladpack-host p ../@PACKAGE@-@VERSION@/graphics.001 *.pix
+#	cd scen; ../util/gladpack-host p ../@PACKAGE@-@VERSION@/levels.001 *.fss
 
 graphics.001:
-	cd pix; ../util/gladpack p ../graphics.001 *.pix
+	cd pix; ../util/gladpack-host p ../graphics.001 *.pix
 
 levels.001:
-	cd scen; ../util/gladpack p ../levels.001 *.fss
+	cd scen; ../util/gladpack-host p ../levels.001 *.fss
 
 install: install-recursive install-docs
 
diff -Nrup a/Makefile.in b/Makefile.in
--- a/Makefile.in	2003-05-13 09:53:49.000000000 +0200
+++ b/Makefile.in	2026-10-22 17:22:42.616638504 +0200
@@ -397,14 +397,14 @@ uninstall-info: uninstall-info-recursive
 # We could do this, but a full source dist should have
 # scen/ and pix/ contents anyway, so best leave this for build time
 #dist-hook:
-#	cd pix; ../util/gladpack p ../@PACKAGE@-@VERSION@/graphics.001 *.pix
-#	cd scen; ../util/gladpack p ../@PACKAGE@-@VERSION@/levels.001 *.fss
+#	cd pix; ../util/gladpack-host p ../@PACKAGE@-@VERSION@/graphics.001 *.pix
+#	cd scen; ../util/gladpack-host p ../@PACKAGE@-@VERSION@/levels.001 *.fss
 
 graphics.001:
-	cd pix; ../util/gladpack p ../graphics.001 *.pix
+	cd pix; ../util/gladpack-host p ../graphics.001 *.pix
 
 levels.001:
-	cd scen; ../util/gladpack p ../levels.001 *.fss
+	cd scen; ../util/gladpack-host p ../levels.001 *.fss
 
 install: install-recursive install-docs
 
