[I] A 3D racing cars simulator using OpenGL

[T] The goal is to have programmed robots drivers racing against each
[T] others. You can also drive yourself with either a wheel or keyboard
[T] or mouse.

[U] https://torcs.sourceforge.net/

[A] Eric Espiť & Christophe Guionneau <torcs@free.fr>
[M] René Rebe <rene@exactco.de>

[F] CROSS NO-LTO NOPARALLEL
[C] extra/game
#[C] extra/game/racing

[L] GPL
[V] 1.3.10

[D] 41f1baaa30da8b21848249caf852275dd3af62592ed9e898c8551f37 torcs-1.3.10.tar.bz2 https://download.sourceforge.net/project/torcs/all-in-one/1.3.10/

bindir=/$SDECFG_PKG_GAMES_BINDIR
datadir=/$SDECFG_PKG_GAMES_DATADIR

var_append GCC_WRAPPER_APPEND ' ' -L`pkgprefix libdir libx11`
var_append GCC_WRAPPER_APPEND ' ' -I`pkgprefix includedir freeglut`

# delete lingering x86 object files ...
hook_add preconf 3 "find -name '*.o' | xargs rm -fv"
hook_add postmake 5 "eval $MAKE $makeinstopt datainstall"
