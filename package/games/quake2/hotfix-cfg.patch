The shipped config.cfg is a Windows config: vid_ref "gl" names ref_gl.so,
which the Linux build does not have, and gl_driver "opengl32" a Windows DLL,
so Quake II starts in the 320x240 software renderer:

  LoadLibrary("ref_gl.so") failed: No such file or directory
  ------- Loading ref_softx.so -------
  setting mode 0: 320 240

Use ref_glx with libGL.so.1. hand "2" (centred) draws no view weapon, so
right-handed as in the game's default; 22 kHz 16-bit sound instead of
11 kHz 8-bit, the default sensitivity of 3 instead of 9, and no developer's
player name.

Signed-off-by: René Rebe <rene@exactco.de>

--- a/data/baseq2/config.cfg	2026-11-24 12:15:09.874915166 +0100
+++ b/data/baseq2/config.cfg	2026-11-24 12:15:09.884065702 +0100
@@ -85,7 +85,7 @@ set gl_vertex_arrays "0"
 set gl_texturesolidmode "default"
 set gl_texturealphamode "default"
 set gl_texturemode "GL_LINEAR_MIPMAP_NEAREST"
-set gl_driver "opengl32"
+set gl_driver "libGL.so.1"
 set gl_finish "0"
 set gl_shadows "0"
 set gl_stencilshadow "0"
@@ -120,8 +120,8 @@ set adr0 ""
 set cd_nocd "0"
 set s_primary "0"
 set s_mixahead "0.2"
-set s_loadas8bit "1"
-set s_khz "11"
+set s_loadas8bit "0"
+set s_khz "22"
 set s_volume "0.7"
 set sw_mode "0"
 set sw_stipplealpha "0"
@@ -129,7 +129,7 @@ set sw_allow_modex "1"
 set vid_gamma "1"
 set vid_ypos "32"
 set vid_xpos "115"
-set vid_ref "gl"
+set vid_ref "glx"
 set sv_reconnect_limit "3"
 set allow_download_maps "1"
 set allow_download_sounds "1"
@@ -138,14 +138,14 @@ set allow_download_players "0"
 set allow_download "0"
 set hostname "noname"
 set skin "male/grunt"
-set name "hook"
+set name "player"
 set lookstrafe "0"
 set lookspring "1"
 set m_pitch "-0.022000"
-set hand "2"
+set hand "0"
 set cl_run "0"
 set crosshair "1"
-set sensitivity "9.000000"
+set sensitivity "3"
 set win_noalttab "0"
 set vid_fullscreen "0"
 set viewsize "100"
