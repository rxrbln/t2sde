[I] A popular First Person Shooter by ID-Games

[T] The Shooter ... Orginal Quake2 CD required.

[U] https://sourceforge.net/projects/quake/

[A] Olivier Fourdan <taniwha@users.sourceforge.net>
[M] René Rebe <rene@exactco.de>

[C] extra/game
[F] CROSS FCOMMON NO-LTO

[L] GPL
[V] 0.7.2

[D] 73f81a5fbb6dcb3872470ff4c1ee069ca7c53809cc7bffc95c04f1d9 quakeforge-0.7.2.tar.gz https://prdownloads.sourceforge.net/sourceforge/quake/

var_append CC_WRAPPER_APPEND ' ' '-std=gnu17 -fgnu89-inline'

[ $arch_bigendian = yes ] &&
	var_append confopt ' ' --with-endian=big ||
	var_append confopt ' ' --with-endian=little

# qfcc and pak are run at build time to compile ruamoko and qwaq progs
build_native_qfcc() {
	mkdir -p native
	(cd native
	 env -u PKG_CONFIG_PATH -u PKG_CONFIG_LIBDIR -u PKG_CONFIG_SYSROOT_DIR \
		CC="$BUILDCC" CPP="$BUILDCC -E" CFLAGS="-O2 -std=gnu17 -fgnu89-inline -fcommon" AR=ar AS=as LD=ld NM=nm RANLIB=ranlib STRIP=strip \
		../configure --disable-shared --without-clients --without-servers \
		--with-tools=qfcc,pak --disable-sdl --disable-sound --disable-curses \
		--disable-zlib --disable-png
	 for d in libs/util libs/gamecode tools/qfcc/source tools/pak; do
		$MAKE -C $d CC="$BUILDCC" AR=ar RANLIB=ranlib || exit 1
	 done) || return 1
	var_append makeopt ' ' "QFCC=$PWD/native/tools/qfcc/source/qfcc PAK=$PWD/native/tools/pak/pak"
	var_append makeinstopt ' ' "QFCC=$PWD/native/tools/qfcc/source/qfcc PAK=$PWD/native/tools/pak/pak"
}
atstage cross && hook_add preconf 5 build_native_qfcc

# ruamoko pak archives set RANLIB=touch, configure detects the toolchain one
var_remove_regex makeopt ' ' 'RANLIB=.*'
var_remove_regex makeinstopt ' ' 'RANLIB=.*'

# plugin relink races libQFconsole install
var_append makeinstopt ' ' -j1
