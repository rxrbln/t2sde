[I] Multi-platform 2D and 3D game engine

[T] Your free, open‑source game engine. Develop your 2D & 3D games,
[T] cross-platform projects, or even XR ideas!

[U] https://godotengine.org

[A] godotengine
[M] René Rebe <rene@exactco.de>

[C] extra/tool
[F] CROSS

[L] MIT
[V] 4.7.2

[D] f23860e3f5aeba1ab1e5e32dd42424cf39a6dfe3d5e70ed2965f3812 godot-4.7.2-stable.tar.gz https://github.com/godotengine/godot/archive/4.7.2-stable/

runpysetup=0 rungpepinstall=0 sconsinstopt=

# not working: builtin_embree=no builtin_wslay=no
var_append sconsopt ' ' "builtin_enet=no builtin_freetype=no"
var_append sconsopt ' ' "builtin_graphite=no builtin_harfbuzz=no builtin_libogg=no"
var_append sconsopt ' ' "builtin_libpng=no builtin_libtheora=no builtin_libvorbis=no"
var_append sconsopt ' ' "builtin_libwebp=no builtin_mbedtls=no builtin_miniupnpc=no"
var_append sconsopt ' ' "builtin_pcre2=no builtin_sdl=no builtin_zlib=no builtin_zstd=no"
var_append sconsopt ' ' "builtin_icu4c=no builtin_glslang=no builtin_libjpeg_turbo=no"
var_append sconsopt ' ' "builtin_brotli=no"

hook_add premake 5 "python misc/scripts/install_accesskit.py"
hook_add postmake 5 "install bin/godot* $root$bindir/"
