alutInit takes a pointer to argc, an int-conversion error since GCC 14.

--- a/configure-al.m4
+++ b/configure-al.m4
@@ -91,7 +91,7 @@ if test "x$enable_openaltest" = "xyes" ;
 
 		int main(int argc, char *argv[])
 		{
-			alutInit(argc, argv);
+			alutInit(&argc, argv);
 			return 0;
 		}
 #undef  main
