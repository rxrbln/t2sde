[I] Quake III Arena first person shooter engine

[T] ioquake3 is a maintained version of the Quake III Arena engine released
[T] by id Software, with bug fixes, security fixes and new features. The
[T] original Quake III Arena game data is required to play.

[U] https://www.ioquake3.org/

[A] id and the ioquake team
[M] René Rebe <rene@exactco.de>

[C] extra/game
[F] CROSS

[L] GPL
[V] 93abc60

[D] 3be72f73cfea4970322d68d623b9b82e4a4a9a327581ec5aa1bb7cce ioquake-93abc60.tar.gz !https://github.com/ioquake/ioq3/archive/93abc60.tar.gz

[ $prefix_auto = 1 ] && prefix="opt/ioq3" && set_confopt

ARCH=$(echo $arch | arch2uname | sed 's/i.86/x86/')

var_append SYSCC_WRAPPER_APPEND ' ' -std=gnu11
var_append GCC_WRAPPER_APPEND ' ' -std=gnu11

ioq3opt="DEFAULT_BASEDIR=/$prefix ARCH=$ARCH USE_INTERNAL_LIBS=0"
pkginstalled curl || var_append ioq3opt ' ' USE_CURL=0
pkginstalled openal || var_append ioq3opt ' ' USE_OPENAL=0
pkginstalled opusfile || var_append ioq3opt ' ' "USE_CODEC_OPUS=0 USE_VOIP=0"

var_append makeopt ' ' "$ioq3opt"
makeinstopt="${makeinstopt/install/copyfiles} COPYDIR=$root/$prefix $ioq3opt"

ioquake3_install() {
	ln -sfv ../ioquake3.$ARCH $root$bindir/ioquake3
	ln -sfv ../ioq3ded.$ARCH $root$bindir/ioq3ded
}
hook_add postmake 5 ioquake3_install
