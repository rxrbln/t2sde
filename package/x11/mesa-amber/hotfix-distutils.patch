distutils was removed in Python 3.12, the mako check then always fails.

--- mesa/meson.build.vanilla
+++ mesa/meson.build
@@ -1014,9 +1014,8 @@
 has_mako = run_command(
   prog_python, '-c',
   '''
-from distutils.version import StrictVersion
 import mako
-assert StrictVersion(mako.__version__) > StrictVersion("0.8.0")
+assert tuple(int(x) for x in mako.__version__.split(".")[:2]) >= (0, 8)
   ''')
 if has_mako.returncode() != 0
   error('Python (3.x) mako module >= 0.8.0 required to build mesa.')
