Add the X library path to the xglock link, fixes -lX11 not found with X11 outside
the default library path.

diff -Nurp xlockmore-5.89.orig/configure xlockmore-5.89/configure
--- xlockmore-5.89.orig/configure	2024-11-22 18:26:24.000000000 +0100
+++ xlockmore-5.89/configure	2026-09-27 19:20:07.024694490 +0200
@@ -6366,6 +6366,7 @@ else
     XMLOCK_LDFLAGS="/usr/lib:${x_libraries}"
     XLOCKLIBPATHS="-L${x_libraries} ${XLOCKLIBPATHS}"
     XMLOCKLIBPATHS="-L${x_libraries} ${XMLOCKLIBPATHS}"
+    XGLOCKLIBPATHS="-L${x_libraries} ${XGLOCKLIBPATHS}"
   fi
   XLOCKLIBS="${X_PRE_LIBS} ${X_EXTRA_LIBS} ${XLOCKLIBS}"
   case "${canonical}" in
diff -Nurp xlockmore-5.89.orig/configure.ac xlockmore-5.89/configure.ac
--- xlockmore-5.89.orig/configure.ac	2024-11-22 18:26:17.000000000 +0100
+++ xlockmore-5.89/configure.ac	2026-09-27 19:20:07.027772040 +0200
@@ -443,6 +443,7 @@ dnl   Do not warn me about anything here
     XMLOCK_LDFLAGS="/usr/lib:${x_libraries}"
     XLOCKLIBPATHS="-L${x_libraries} ${XLOCKLIBPATHS}"
     XMLOCKLIBPATHS="-L${x_libraries} ${XMLOCKLIBPATHS}"
+    XGLOCKLIBPATHS="-L${x_libraries} ${XGLOCKLIBPATHS}"
   fi
   XLOCKLIBS="${X_PRE_LIBS} ${X_EXTRA_LIBS} ${XLOCKLIBS}"
   case "${canonical}" in
