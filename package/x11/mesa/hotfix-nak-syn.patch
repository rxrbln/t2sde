Pass syn, quote and proc_macro2 as --extern, like kraid, instead of only -L.
Otherwise rustc also finds the rustc-dev copies in the sysroot ambiguous.

--- mesa-26.3.1/src/nouveau/compiler/meson.build.orig	2026-11-21 10:09:15.582115061 +0000
+++ mesa-26.3.1/src/nouveau/compiler/meson.build	2026-11-21 10:09:15.590861762 +0000
@@ -85,7 +85,7 @@ _libnak_bindings_rs = static_library(
 _libnak_ir_proc_rs = rust.proc_macro(
   'nak_ir_proc',
   files('nak/ir_proc.rs'),
-  dependencies : [idep_compiler_proc_rs],
+  dependencies : [idep_compiler_proc_rs, dep_syn],
   rust_args : rust_global_args,
 )
 
