+ * (EUR_CR_ISP_BGOBJDEPTH), and the stencil the background object carries
+ * (EUR_CR_ISP_BGOBJ [7:0]) - the values a frame without a depth load
+ * begins from. */
+int sgx_set_clear_depth(struct sgx_context *ctx, float depth);
+int sgx_set_clear_stencil(struct sgx_context *ctx, unsigned stencil);
