+/* The colour the frame's clearing draws write. Only the low 21 bits of the
+ * packed pixel reach the hardware: the clear is a USSE program whose immediate
+ * is that wide, so the red channel keeps five of its eight bits. Black, and
+ * anything dark, is exact. */
+int sgx_set_clear_color(struct sgx_context *ctx, uint32_t packed);
