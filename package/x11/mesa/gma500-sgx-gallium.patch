+		printf("  repeat seam %#010x between %#010x and %#010x\n",
+		       got, tex4x4[3], tex4x4[0]);
+		if (!between(got, tex4x4[3], tex4x4[0]))
+			fail("repeat seam not a blend of both texels");
+		if (got == tex4x4[3] || got == tex4x4[0])
+			fail("repeat seam did not wrap");
