+ * PDS program: heap dwords 0x110..0x11a. heap_init[]'s first block stops at
+ * 0xfb, XPSB_SEC_PDS_OFF occupies 0x100..0x10d, and no relocation names any
+ * heap offset between 0x400 and 0x43e4. */
+#define XPSB_VID_CONST_OFF   0x440
+#define XPSB_VID_CONST_DW    (XPSB_VID_CONST_OFF / 4)
+#define XPSB_VID_CONST_N     XPSB_VIDSHADER_SA_PACKED
