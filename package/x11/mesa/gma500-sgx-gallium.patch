+static void expect_rgb(const char *what, uint32_t argb, int r, int g, int b)
+{
+	char tag[80];
+
+	snprintf(tag, sizeof tag, "%s r", what);
+	expect_near(tag, (int)((argb >> 16) & 0xff), r, 2);
+	snprintf(tag, sizeof tag, "%s g", what);
+	expect_near(tag, (int)((argb >> 8) & 0xff), g, 2);
+	snprintf(tag, sizeof tag, "%s b", what);
+	expect_near(tag, (int)(argb & 0xff), b, 2);
+}
