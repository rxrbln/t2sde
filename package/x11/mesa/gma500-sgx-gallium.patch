+/* Source register field of a PCKUNPCK instruction, w0[13:7]. The packed YUV
+ * program reads its texel from pa0, which is the texture sample only under the
+ * closed module's iterator-free plumbing; this frame layer iterates a colour
+ * into pa0 and the sample lands at pa1. Route B of
+ * disasm/video-integration.md section 1. */
+#define XPSB_PCK_SRC1_MASK   0x00003f80u
+#define XPSB_PCK_SRC1_SHIFT  7
+#define XPSB_VID_SRC_PA      1
