+/* pipe_context::set_framebuffer_state. Sizes the scene and allocates whatever
+ * the new size needs; a resize is what makes the parameter heap grow. */
+int sgx_set_framebuffer(struct sgx_context *ctx,
+			const struct sgx_framebuffer *fb);
