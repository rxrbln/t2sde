+/* Three DOUTU words the relocations overwrite outright. The capture holds a
+ * fill pattern there, which is the clearest possible evidence that nothing
+ * reads them before the relocation runs. */
+#define DOUTU_FILL 0x67676767u
+static const uint32_t doutu_fill_at[] = { 0x10008, 0x1000c, 0x10030 };
