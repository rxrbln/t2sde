Disable real buffer in constbuf0 on big-endian r600.

r600 uploads constant buffers as raw words; with
prefer_real_buffer_in_constbuf0 the shader reads them in the wrong
byte order on big-endian.  Part of the same ppc64 enablement, kept
as a separate change because it is a different code path.

--- mesa-26.2.6/src/gallium/drivers/r600/r600_pipe.c
+++ mesa-26.2.6/src/gallium/drivers/r600/r600_pipe.c
@@ -404,7 +404,7 @@ static void r600_init_screen_caps(struct r600_screen *rscreen)
       enum radeon_family family = rscreen->b.family;
 
       /* Supported features (boolean caps). */
-      caps->prefer_real_buffer_in_constbuf0 = true;
+      caps->prefer_real_buffer_in_constbuf0 = !UTIL_ARCH_BIG_ENDIAN;
       caps->npot_textures = true;
       caps->mixed_framebuffer_sizes = true;
       caps->mixed_color_depth_bits = true;
