[I] DesktopEntry Execution - generate and execute XDG autostart entries

[T] dex is a program to generate and execute DesktopEntry files of the
[T] Application type, commonly used to start XDG autostart applications
[T] in lightweight window manager sessions (e.g. dwm).

[U] https://github.com/jceb/dex

[A] Jan Christoph Ebersbach <jceb@e-jc.de>
[M] Dennie Mahne <dennie.mahne@gmail.com>

[C] extra/tool

[E] opt tzdata python-babel
[E] opt docutils

[L] GPL
[V] 0.10.1

[D] a1db2021b6532dbdfedc326643cd6870aef2aa30ddb3d77460e52305 dex-0.10.1.tar.gz https://github.com/jceb/dex/archive/v0.10.1/

var_append makeopt ' ' DOCPREFIX=$docdir

pkg_dex_main() {
	install -D -m 755 dex $root$bindir/dex
}
pkginstalled sphinx-doc ||
	runmake=0 && hook_add inmake 5 pkg_dex_main
