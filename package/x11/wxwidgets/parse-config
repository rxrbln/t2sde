# wx-config is only in the target, the compiler wrapper maps its /usr paths
if ! atstage native && [ -x $root/usr/bin/wx-config ]; then
	export WX_CONFIG_NAME=$root/usr/bin/wx-config WX_CONFIG=$root/usr/bin/wx-config
fi
