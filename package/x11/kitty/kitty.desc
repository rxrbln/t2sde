[I] Cross-platform, fast, feature-rich, GPU based terminal

[T] Kitty ia a fast, feature-rich, cross-platform, GPU based terminal.

[U] https://github.com/kovidgoyal/kitty

[A] Kovid Goyal
[M] René Rebe <rene@exactco.de>

[C] extra/shell

[R] + arm arm64 loongarch64 mips mips64 powerpc64 riscv64 s390x x86 x86-64

[L] GPL3
[V] 0.50.0

[D] 5d2456a44e398b0b749464cee0d211a68485c1de2f92a52008d32640 kitty-v0.50.0.tar.gz https://github.com/kovidgoyal/kitty/archive/v0.50.0/
[D] f9d905fcb0d6ad20bc677b116abfa75b39d528e09957db7025e8d810 NerdFontsSymbolsOnly-3.5.1.tar.xz !https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/NerdFontsSymbolsOnly.tar.xz

rungpepinstall=0 rungo=0 runmake=0
pyconfopt="build"

hook_add preconf 5 "mkdir fonts; tar -C fonts -xf `match_source_file -p NerdFont` SymbolsNerdFontMono-Regular.ttf"

makeinstopt=
hook_add postmake 5 "install kitty/launcher/kitty $root$bindir/"
