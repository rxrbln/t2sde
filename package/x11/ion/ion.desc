[I] A tiling tabbed window manager designed with keyboard users in mind

[T] Ion is a tiling (no overlapping windows) window manager that also has
[T] PWM-style tabbed frames which can contain multiple client windows. These
[T] features help to keep windows organized and to switch quickly between
[T] them. Ion was designed primarily as an efficient and unobtrusive window
[T] manager for users who prefer the keyboard.

[U] https://tuomov.iki.fi/software/ion/

[A] tuomov <tuomov@iki.fi>
[M] René Rebe <rene@exactco.de>

[C] extra/windowmanager
[F] CROSS NOPARALLEL

[L] GPL
[V] 3-20090110

# ion-2 Stable does depend on lua-5.0 ...
[D] d9628c74ac5cf48f7ef16bb60c0eda132a973205e309ccf80d483ab2 ion-3-20090110.tar.gz https://tuomov.iki.fi/software/ion/dl/
[D] ec8b59b422790651ca62edc836d248e487c4ab889070da2fbcef95c4 lua-5.1.5.tar.gz https://www.lua.org/ftp/

var_append makeopt ' ' "ETCDIR=$sysconfdir/ion3"
var_append makeopt ' ' "LUA_LIBS=-llua51 LUA_INCLUDES=-I$root$includedir/lua51"
var_append makeinstopt ' ' "PREFIX=$root/$prefix ETCDIR=$root$sysconfdir/ion3 VARDIR=$root/var/cache/ion3 INSTALL_STRIP="

if atstage cross; then
	# the build runs lua and luac 5.1, build them natively
	ion_host_lua() {
		tar $taropt $(match_source_file -p lua-5.1.5)
		make -C lua-5.1.5/src CC="$BUILDCC" AR="ar rc" RANLIB=ranlib lua luac \
			MYCFLAGS=-DLUA_USE_POSIX MYLIBS=-lm
	}
	hook_add premake 5 ion_host_lua
	var_append makeopt ' ' 'LUA=$PWD/lua-5.1.5/src/lua LUAC=$PWD/lua-5.1.5/src/luac'
else
	var_append makeopt ' ' "LUA=$bindir/lua51 LUAC=$bindir/luac51"
fi
hook_add postinstall 3 "register_wm ion Ion $bindir/ion3"
var_append CC_WRAPPER_APPEND ' ' -std=gnu17
