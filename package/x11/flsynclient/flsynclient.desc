[I] GUI to configure a synaptics touchpad

[T] GUI to configure a synaptics touchpad. Requires Fltk 1.x.
[T] To run, requires the 'synclient' utility in pkg 'xf86-input-synaptics'.

[U] https://matteolucarelli.altervista.org/flsynclient/index_en.htm

[A] Matteo Lucarelli <matteo@matteolucarelli.net>
[M] René Rebe <rene@exactco.de>

[C] extra/tool
[F] CROSS

[L] GPL
[V] 0.7

[D] 5f7c125f147f86b2c3796c83580d4bae039e66dceb239d00ec6dd51f flsynclient-0.7.tar.gz http://distro.ibiblio.org/puppylinux/sources/f/

makeinstopt=

var_append makeopt ' ' 'CC="$CXX"'
atstage cross && var_append makeopt ' ' "LIBS='$($root$bindir/fltk-config --ldflags)'"
flsynclient_install() {
	install -D -m 755 flsynclient $root$bindir/flsynclient
	install -D -m 644 -t $root$datadir/pixmaps flsynclient.xpm flsynclient.png
}
hook_add postmake 5 flsynclient_install
