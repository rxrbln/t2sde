[D] 0ad5febe8db86e09a8f522ee191c3e7457caa0c5f9fa6ba594d32db5 gtk-vnc-1.6.0.tar.xz https://download.gnome.org/sources/gtk-vnc/1.6/

hook_add postmake 5 "cp -v objs/examples/gvncviewer $root$bindir"
pkginstalled gobject-introspection || var_append mesonopt ' ' '-Dintrospection=disabled -Dwith-vala=disabled'
pkginstalled gi-docgen && ! atstage cross || var_append mesonopt ' ' -Dgi-docs=disabled
