ieee1275/ofnet: fix network boot on old IBM CHRP Open Firmware (7043-150)

GRUB loaded via BOOTP/TFTP on an IBM RS/6000 43P-150 (OF TCP99210) can
not use the firmware network device afterwards:

  error: Couldn't open network card.

The firmware obp-tftp open parses only six args
(server,file,client,gateway,bootp-retries,tftp-retries) and passes the
remaining "5,1.1.1.1,512" of GRUB's PAPR suffix to $number, which fails,
so the am79C971 open returns false. MacRISC machines are unaffected as
they set NO_OFNET_SUFFIX. Retry the open without suffix and keep it.

Also:
 - parse_bootpath read past the end of /chosen/bootpath when it is an
   alias ("net", as set by "boot net") or carries no args.
 - locate the BOOTP payload in bootpreply-packet from the frame headers
   instead of a fixed 0x2a, in 802.3 mode the firmware stores LLC/SNAP
   frames with a 22 byte MAC header, free the buffer on error.
 - canon returns the length, NUL terminate the result.
 - the firmware BOOTP request uses the vendor cookie "ibmc", the server
   echoes it in front of RFC 1048 options, which GRUB ignored, falling
   back to a class C /24 without router, so a server on another /24 was
   unreachable unless net_bootp was run manually:

     bootpreply-packet vendor area: 69 62 6d 63 01 04 ff ff 00 00 ...
       03 04 c0 a8 00 01   ("ibmc", mask 255.255.0.0, router)
     grub> net_ls_routes
     ofnet_net:local 192.168.2.0/24 ofnet_net

   Rewrite the cookie to the RFC 1048 magic.
 - closing the card before booting the kernel hangs in the firmware
   obp-tftp close, which closes the global deblocker ihandle of the
   firmware's own load a second time:

     loader: ofnet: closing /pci@80000000/ethernet@c ihandle 0xf70680

   On this firmware, detected by the retry without suffix, only stop the
   chip with the NIC reset method.

Signed-off-by: René Rebe <rene@exactco.de>

--- a/grub-core/net/drivers/ieee1275/ofnet.c
+++ b/grub-core/net/drivers/ieee1275/ofnet.c
@@ -31,6 +31,7 @@ struct grub_ofnetcard_data
   char *path;
   char *suffix;
   grub_ieee1275_ihandle_t handle;
+  int old_obp_tftp;
 };
 
 static grub_err_t
@@ -41,6 +42,17 @@ card_open (struct grub_net_card *dev)
 
   status = grub_ieee1275_open (data->path, &(data->handle));
 
+  /* Older IBM CHRP obp-tftp (e.g. 7043-150) only takes six args and refuses
+     the open with the long PAPR suffix, retry and keep the plain path.  */
+  if (status && *data->suffix)
+    {
+      grub_dprintf ("ofnet", "open %s failed, retrying without suffix\n",
+		    data->path);
+      *data->suffix = '\0';
+      data->old_obp_tftp = 1;
+      status = grub_ieee1275_open (data->path, &(data->handle));
+    }
+
   if (status)
     return grub_error (GRUB_ERR_IO, "Couldn't open network card.");
 
@@ -52,8 +64,31 @@ card_close (struct grub_net_card *dev)
 {
   struct grub_ofnetcard_data *data = dev->data;
 
-  if (data->handle)
+  if (!data->handle)
+    return;
+
+  /* The old obp-tftp close re-closes the stale global deblocker ihandle of
+     the firmware's own load and hangs, only stop the chip with reset.  */
+  if (data->old_obp_tftp)
+    {
+      struct reset_args
+      {
+	struct grub_ieee1275_common_hdr common;
+	grub_ieee1275_cell_t method;
+	grub_ieee1275_cell_t ihandle;
+	grub_ieee1275_cell_t catch_result;
+      }
+      args;
+
+      INIT_IEEE1275_COMMON (&args.common, "call-method", 2, 1);
+      args.method = (grub_ieee1275_cell_t) "reset";
+      args.ihandle = data->handle;
+      args.catch_result = 1;
+      IEEE1275_CALL_ENTRY_FN (&args);
+    }
+  else
     grub_ieee1275_close (data->handle);
+  data->handle = 0;
 }
 
 static grub_err_t
@@ -158,7 +193,11 @@ grub_ieee1275_parse_bootpath (const char
 
   hw_addr.type = GRUB_NET_LINK_LEVEL_PROTOCOL_ETHERNET;
 
-  args = bootpath + grub_strlen (devpath) + 1;
+  /* bootpath may be an alias ("net") or carry no args at all.  */
+  args = grub_strchr (bootpath, ':');
+  if (!args)
+    return 0;
+  args++;
   do
     {
       comma_char = grub_strchr (args, ',');
@@ -238,6 +277,37 @@ grub_ieee1275_parse_bootpath (const char
   return 0;
 }
 
+/* IBM bootpreply-packet holds the whole received frame, locate the BOOTP
+   payload behind Ethernet II or 802.3 LLC/SNAP, IPv4 and UDP headers.  */
+static grub_ssize_t
+bootp_frame_offset (const grub_uint8_t *pkt, grub_ssize_t size,
+		    grub_ssize_t fallback)
+{
+  grub_ssize_t off = 12;
+  grub_uint16_t type;
+  unsigned int ihl;
+
+  if (size < off + 2)
+    return fallback;
+  type = grub_be_to_cpu16 (grub_get_unaligned16 (pkt + off));
+  off += 2;
+  if (type <= 1500)
+    {
+      if (size < off + 8 || pkt[off] != 0xaa || pkt[off + 1] != 0xaa)
+	return fallback;
+      type = grub_be_to_cpu16 (grub_get_unaligned16 (pkt + off + 6));
+      off += 8;
+    }
+  if (type != 0x0800 || size < off + 20 || (pkt[off] >> 4) != 4
+      || pkt[off + 9] != 17)
+    return fallback;
+  ihl = (pkt[off] & 0xf) * 4;
+  if (ihl < 20)
+    return fallback;
+  off += ihl + 8;
+  return off < size ? off : fallback;
+}
+
 static void
 grub_ieee1275_net_config_real (const char *devpath, char **device, char **path,
                                char *bootpath)
@@ -252,7 +322,7 @@ grub_ieee1275_net_config_real (const cha
     char c;
     struct grub_ofnetcard_data *data;
 
-    grub_ssize_t size = -1;
+    grub_ssize_t size = -1, offset;
     unsigned int i;
 
     if (card->driver != &ofdriver)
@@ -290,14 +360,42 @@ grub_ieee1275_net_config_real (const cha
     if (grub_ieee1275_get_property (grub_ieee1275_chosen,
 				    bootp_response_properties[i].name,
 				    bootp_response, size, 0) < 0)
-      return;
+      {
+	grub_free (bootp_response);
+	return;
+      }
+
+    offset = bootp_response_properties[i].offset;
+    if (offset)
+      offset = bootp_frame_offset ((grub_uint8_t *) bootp_response, size,
+				   offset);
+    if (offset >= size)
+      {
+	grub_free (bootp_response);
+	return;
+      }
+
+    /* IBM CHRP OF BOOTP requests use the vendor cookie "ibmc", the server
+       echoes it in front of RFC 1048 options (mask, router) GRUB ignores.  */
+    if ((grub_size_t) (size - offset)
+	>= sizeof (struct grub_net_bootp_packet) + 4)
+      {
+	grub_uint8_t *vend = (grub_uint8_t *) bootp_response + offset
+			     + sizeof (struct grub_net_bootp_packet);
+
+	if (grub_memcmp (vend, "ibmc", 4) == 0)
+	  {
+	    vend[0] = GRUB_NET_BOOTP_RFC1048_MAGIC_0;
+	    vend[1] = GRUB_NET_BOOTP_RFC1048_MAGIC_1;
+	    vend[2] = GRUB_NET_BOOTP_RFC1048_MAGIC_2;
+	    vend[3] = GRUB_NET_BOOTP_RFC1048_MAGIC_3;
+	  }
+      }
 
     grub_net_configure_by_dhcp_ack (card->name, card, 0,
 				    (struct grub_net_bootp_packet *)
-				    (bootp_response
-				     + bootp_response_properties[i].offset),
-				    size - bootp_response_properties[i].offset,
-				    1, device, path);
+				    (bootp_response + offset),
+				    size - offset, 1, device, path);
     grub_free (bootp_response);
     return;
   }
@@ -393,7 +491,7 @@ search_net_devices (struct grub_ieee1275
   if (grub_strcmp (alias->type, "network") != 0)
     return 0;
 
-  ofdata = grub_malloc (sizeof (struct grub_ofnetcard_data));
+  ofdata = grub_zalloc (sizeof (struct grub_ofnetcard_data));
   if (!ofdata)
     {
       grub_print_error ();
--- a/grub-core/kern/ieee1275/openfw.c
+++ b/grub-core/kern/ieee1275/openfw.c
@@ -589,13 +589,19 @@ grub_ieee1275_canonicalise_devname (cons
       args.buf = (grub_ieee1275_cell_t) buf;
       args.inlen = (grub_ieee1275_cell_t) (bufsize - 1);
 
-      if (IEEE1275_CALL_ENTRY_FN (&args) == -1)
-	return 0;
+      if (IEEE1275_CALL_ENTRY_FN (&args) == -1
+	  || args.outlen == (grub_ieee1275_cell_t) -1)
+	{
+	  grub_free (buf);
+	  return 0;
+	}
       if (args.outlen > bufsize - 1)
 	{
 	  bufsize = args.outlen + 2;
 	  continue;
 	}
+      /* canon returns the length, not all firmware copies the NUL.  */
+      buf[args.outlen] = '\0';
       return buf;
     }
   /* Shouldn't reach here.  */
