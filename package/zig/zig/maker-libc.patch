Link the JIT compiled zig build Maker against libc when zig itself is, so
installs use libc calls the fl_wrapper LD_PRELOAD can record.

--- zig-0.18.0-dev.1272+2ff397f75.orig/src/main.zig
+++ zig-0.18.0-dev.1272+2ff397f75/src/main.zig
@@ -5102,6 +5102,8 @@ fn jitCmdInner(
             .have_zcu = true,
             .emit_bin = true,
             .is_test = false,
+            // file operations of the build steps through libc, LD_PRELOAD visible
+            .link_libc = if (builtin.link_libc) true else null,
         });
 
         const root_mod = try Module.create(arena, .{
