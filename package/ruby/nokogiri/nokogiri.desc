[P] X -----5---9 122.000

[D] 774ffb676403b4128cb521dd460fc074865700987067a575ef11ec05 nokogiri-1.19.4.gem https://rubygems.org/downloads/

autoextract=0 runmake=0S

hook_add inmake 5 "gem install --local $archdir/nokogiri-$ver.gem --no-document --bindir=$root/$bindir --ignore-dependencies -- --use-system-libraries"
