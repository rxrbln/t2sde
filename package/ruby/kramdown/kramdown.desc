[I] Fast, pure Ruby Markdown superset converter

[T] kramdown is a fast, pure Ruby Markdown superset converter, using a strict
[T] syntax definition and supporting several common extensions.

[U] https://kramdown.gettalong.org/

[A] Thomas Leitner <t_leitner@gmx.at>
[M] René Rebe <rene@exactco.de>

[C] extra/development

[L] MIT
[V] 2.5.2
[P] X -----5---9 122.000

[D] 8235da83b615f39d303c1a4dee8cd0cbbc9ed4bcb29f2019c7ae7fdd kramdown-2.5.2.gem https://rubygems.org/downloads/

autoextract=0 runmake=0

hook_add inmake 5 "gem install --local $archdir/kramdown-$ver.gem --no-document --bindir=$root/$bindir --ignore-dependencies"
