Do not install gem, rubygems and bundler, they come from the rubygems package.

--- ruby-4.0.10/tool/rbinstall.rb.orig
+++ ruby-4.0.10/tool/rbinstall.rb
@@ -937,6 +937,7 @@ def install_default_gem(dir, srcdir, bin
     load_gemspec("#{base}/#{src}", files: files)
   }
   gems.compact.sort_by(&:name).each do |gemspec|
+    next if gemspec.name == "bundler"
     old_gemspecs = Dir[File.join(with_destdir(default_spec_dir), "#{gemspec.name}-*.gemspec")]
     if old_gemspecs.size > 0
       old_gemspecs.each {|spec| rm spec }
@@ -1082,14 +1083,14 @@ end
 install?(:local, :comm, :bin, :'bin-comm') do
   prepare "command scripts", bindir
 
-  install_recursive(File.join(srcdir, "bin"), bindir, :maxdepth => 1) do |src, cmd|
+  install_recursive(File.join(srcdir, "bin"), bindir, :maxdepth => 1, :no_install => %w[gem]) do |src, cmd|
     $script_installer.install(src, cmd)
   end
 end
 
 install?(:local, :comm, :lib) do
   prepare "library scripts", rubylibdir
-  noinst = %w[*.txt *.rdoc *.gemspec]
+  noinst = %w[*.txt *.rdoc *.gemspec rubygems.rb rubygems/ bundler.rb bundler/]
   install_recursive(File.join(srcdir, "lib"), rubylibdir, :no_install => noinst, :mode => $data_mode)
 end
 
