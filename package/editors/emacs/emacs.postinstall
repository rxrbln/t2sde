# the portable dump of a cross compiled emacs can only be created on the target
emacs=D_bindir/emacs
fp=$($emacs --fingerprint) || exit 0
for d in D_libexecdir/emacs/D_ver/*/; do
	[ -e "${d}emacs-$fp.pdmp" ] && continue
	t=$(mktemp -d) || continue
	cp $emacs $t/emacs &&
	(cd D_datadir/emacs/D_ver/lisp && $t/emacs --temacs=pdump -batch -l loadup) > $t/dump.log 2>&1 &&
	mv $t/emacs.pdmp "${d}emacs-$fp.pdmp"
	rm -rf "${t:?}"
done
