[I] The Editing MACroS - text editor

[T] Emacs is an extensible, customizable real-time display editor
[T] and computing environment. It offers true Lisp -- smoothly
[T] integrated into the editor -- for writing extensions
[T] and provides an interface to the X Window System.

[U] https://www.gnu.org/software/emacs/

[A] Emacs Authors <bug-gnu-emacs@gnu.org>
[M] René Rebe <rene@exactco.de>

[C] extra/editor
[F] CROSS

[E] del openssh
[E] opt acl
[E] opt attr
[E] opt alsa-lib
[E] opt dbus
[E] opt fontconfig
[E] opt freetype
[E] opt gpm
[E] opt harfbuzz
[E] opt lcms2
[E] opt libseccomp
[E] opt libwebp
[E] opt sqlite
[E] opt systemd
[E] opt tree-sitter
[E] opt openssh

[L] GPL
[V] 31.1
[P] X ?----5---9 250.100

[D] edb7b066e92e96ee92c82e11a764cd8ffa11e8432b0038396b9fc651 emacs-31.1.tar.xz http://ftp.gnu.org/pub/gnu/emacs/

pkginstalled libgif || var_append confopt ' ' --with-gif=no
pkginstalled libpng || var_append confopt ' ' --with-png=no
pkginstalled libtiff || var_append confopt ' ' --with-tiff=no
if ! pkginstalled libjpeg && ! pkginstalled -n libjpeg-turbo; then
	var_append confopt ' ' --with-jpeg=no
fi
pkginstalled gnutls || var_append confopt ' ' --with-gnutls=no
pkginstalled gconf || var_append confopt ' ' --without-gconf
pkginstalled glib || var_append confopt ' ' --without-gsettings
pkginstalled cairo || var_append confopt ' ' --without-cairo
pkginstalled gtk+ wayland && var_append confopt ' ' --with-pgtk
pkginstalled libx11 || var_append confopt ' ' --without-x

var_append GCC_WRAPPER_INSERT ' ' "-I$root$(pkgprefix includedir libx11)"
var_append GCC_WRAPPER_INSERT ' ' "-L$root$(pkgprefix libdir libx11)"

if atstage toolchain; then
	var_append confopt ' ' '--without-all --without-x --without-pgtk --without-sound ac_cv_prog_liblockfile=no'
	hook_add postmake 5 "install -m 755 lib-src/make-docfile $root/$prefix/bin/emacs-make-docfile; install -m 755 lib-src/make-fingerprint $root/$prefix/bin/emacs-make-fingerprint"
fi

emacs_cross_bootstrap() {
	printf '#!/bin/sh\nexec %s "$@"\n' $root/TOOLCHAIN/cross/bin/emacs > src/bootstrap-emacs-host
	chmod +x src/bootstrap-emacs-host
}
if atstage cross; then
	var_append confopt ' ' --without-native-compilation
	emacs_crossopt="MAKE_DOCFILE=$root/TOOLCHAIN/cross/bin/emacs-make-docfile MAKE_FINGERPRINT=$root/TOOLCHAIN/cross/bin/emacs-make-fingerprint pdmp= buildlisppath=$datadir/emacs/$ver/lisp RUN_TEMACS=true bootstrap_exe=../src/bootstrap-emacs-host HOST_EMACS=$builddir/$pkg-$ver/src/bootstrap-emacs-host"
	var_append makeopt ' ' "$emacs_crossopt actual-all"
	var_append makeinstopt ' ' "$emacs_crossopt DUMPING=none"
	hook_add premake 5 emacs_cross_bootstrap
fi
