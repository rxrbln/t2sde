[V] 3.14.0

[D] c246ba71d3cc6a17e0ffb46b1c9c116958714413396049421138c68f pragtical-3.14.0.tar.gz https://github.com/pragtical/pragtical/archive/v3.14.0/

pkginstalled luajit || var_append mesonopt ' ' -Djit=false
var_append mesonopt ' ' -Dppm=false

# the bundled static Lua is linked in, do not install it
ninjaopt="${ninjaopt% install}"
hook_add postmake 5 "meson install -C objs --no-rebuild --skip-subprojects lua"
