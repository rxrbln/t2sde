[I] A rich text-editor and reimplementation of Notepad++

[T] NotepadNext is a cross-platform, reimplementation of Notepad++.

[U] https://github.com/dail8859/NotepadNext

[A] dail8859
[M] René Rebe <rene@exactco.de>

[C] extra/editor
[F] CROSS

[L] GPL
[V] 0.14

[D] 89c7fe0e8ec1b945a41a5e72a9132617d5437e7c50ed8800440e3110 NotepadNext-0.14-git.tar.gz git+https://github.com/dail8859/NotepadNext v0.14
[D] 592dd236b413504dd81d79d15e240e64a5d58a3bc2e8e6598c7feea5 QSimpleUpdater-8e7017f.tar.gz https://github.com/alex-spataru/QSimpleUpdater/archive/8e7017f7fbdc2b4b1a26ed1eef9ebcba6a50639c/
[D] 6c45afbc1b8b4c2062604e7c155e0cc60d0ea9798996ca599fdc4897 SingleApplication-494772e.tar.gz https://github.com/itay-grudev/SingleApplication/archive/494772e98cef0aa88124f154feb575cc60b08b38/
[D] 78e9352f9871e32aa42f968aaa841db622d9ef502e7644b1b7b8bdc2 editorconfig-core-qt-ab62f05.tar.gz https://github.com/editorconfig/editorconfig-core-qt/archive/ab62f0554abf2bbe4d45427b36a8b2f81ca7b4ab/

var_append GCC_WRAPPER_APPEND ' ' "-I$(pkgprefix includedir libxcb) -L$(pkgprefix libdir libxcb)"

# bundled CPM dependencies from the extra tarballs, no download at build time
for x in QSimpleUpdater-8e7017f SingleApplication-494772e editorconfig-core-qt-ab62f05; do
	hook_add preconf 3 "tar xf $archdir/$x.tar.gz -C $builddir"
done
var_append cmakeopt ' ' "-DCPM_QSimpleUpdater_SOURCE=$builddir/QSimpleUpdater-8e7017f7fbdc2b4b1a26ed1eef9ebcba6a50639c"
var_append cmakeopt ' ' "-DCPM_SingleApplication_SOURCE=$builddir/SingleApplication-494772e98cef0aa88124f154feb575cc60b08b38"
var_append cmakeopt ' ' "-DCPM_editorconfig_core_qt_SOURCE=$builddir/editorconfig-core-qt-ab62f0554abf2bbe4d45427b36a8b2f81ca7b4ab"
