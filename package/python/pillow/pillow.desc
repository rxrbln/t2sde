	var_append gpepopt ' ' --config-json={\"platform-guessing\":\"disable\"}
	export CFLAGS="$CFLAGS -I$root$includedir" LDFLAGS="$LDFLAGS -L$root$libdir -L$root$(pkgprefix libdir libxcb)"
fi
