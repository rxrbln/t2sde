[I] Simple python packaging tool

[T] Flit is a simple way to put Python packages and modules on PyPI.
[T] It tries to require less thought about packaging and help you
[T] avoid common mistakes.

[U] https://flit.readthedocs.io/

[A] Python Packaging Authority
[M] René Rebe <rene@exactco.de>

[C] extra/development
[F] CROSS

[L] MIT
[V] 4.2.0
[P] X ?----5---9 109.003

[D] 6be3f78ec053646ac5e59fa5cc2a5d9fdc26d99e6bd9a678274a9c8d flit_core-4.2.0.tar.gz https://files.pythonhosted.org/packages/source/f/flit_core/

rungpepinstall=0 runmake=0

hook_add premake 5 "gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
"
flitinstopt=
atstage cross && flitinstopt="--install-root $root -i $libdir/python$(pkgprefix ver python | sed 's/\.[0-9]*$//')/site-packages"
hook_add inmake 5 "python bootstrap_install.py $flitinstopt .dist/flit_core*"
