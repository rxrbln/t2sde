[I] The micro Python programming language

[T] Python is an micro proessor optimized variant of the Python language.

[U] https://micropython.org

[A] Damien George
[M] René Rebe <rene@exactco.de>

[C] base/development
[F] CROSS

[L] MIT
[V] 1.29.0
[P] X -----5---9 109.000

[D] 6c22a5ca81269d65b123fc409672d1df6c3c141798c49dda68ffec61 micropython-1.29.0.tar.xz https://github.com/micropython/micropython/releases/download/v1.29.0/

hook_add preconf 5 "cd ports/unix"
var_append makeopt ' ' 'CPP="$CC -E"'
var_append makeinstopt ' ' 'CPP="$CC -E"'

if atstage cross; then
	micropython_mpy_cross() {
		make -C mpy-cross CC="$BUILDCC" CPP="$BUILDCC -E" BUILD=build-host
		var_append makeopt ' ' "MICROPY_MPYCROSS=$PWD/mpy-cross/build-host/mpy-cross"
		var_append makeinstopt ' ' "MICROPY_MPYCROSS=$PWD/mpy-cross/build-host/mpy-cross"
	}
	hook_add preconf 4 micropython_mpy_cross
fi
