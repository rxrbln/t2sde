[I] Python bindings for libclang

[T] The clang.cindex Python bindings for the libclang C interface, to parse
[T] and traverse C, C++ and Objective-C source code.

[U] https://clang.llvm.org/

[A] The LLVM Team
[M] René Rebe <rene@exactco.de>

[C] extra/development

[E] add clang

[L] APL
[V] 23.1.2
[P] X -----5---9 200.000

[D] 296c0e4b1782c78d58e0e1286328674256857fa79e7d62800d738e57 llvm-project-23.1.2.src.tar.xz https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.2/

autoextract=0 runmake=0

python_clang_install() {
	local sitedir=$(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
	tar xJf $archdir/llvm-project-$ver.src.tar.xz --strip-components=4 \
		llvm-project-$ver.src/clang/bindings/python/clang
	mkdir -p $root$sitedir/clang
	cp -v clang/*.py $root$sitedir/clang/
	python3 -m compileall -q $root$sitedir/clang
}
hook_add inmake 5 python_clang_install
