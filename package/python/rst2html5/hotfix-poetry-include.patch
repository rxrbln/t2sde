poetry-core 2 includes plain include entries only in the sdist, so the
rst2html5_ module of the rst2html5 command was missing from the wheel.

--- rst2html5-2.0.1.orig/pyproject.toml
+++ rst2html5-2.0.1/pyproject.toml
@@ -21,7 +21,7 @@
     "Topic :: Text Processing :: Markup :: HTML",
 ]
 packages = [{ include = "rst2html5" }]
-include = ["rst2html5_.py"]
+include = [{ path = "rst2html5_.py", format = ["sdist", "wheel"] }]
 
 [tool.poetry.scripts]
 rst2html5 = "rst2html5_:main" # overwrites docutils' rst2html5
