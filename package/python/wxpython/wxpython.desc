[I] WxWidgets bindings for Python

[T] WxPython is a GUI toolkit for the Python programming language. It allows
[T] Python programmers to create programs with a robust, highly functional
[T] graphical user interface, simply and easily. It is implemented as a Python
[T] extension module (native code) that wraps the popular wxWidgets cross
[T] platform GUI library, which is written in C++.

[U] https://www.wxpython.org

[A] Robin Dunn
[M] René Rebe <rene@exactco.de>

[C] extra/development

[L] LGPL
[V] 4.3.2
[P] X -----5---9 203.100

[D] d8e6745991edfcb2995698bfc8273f5c734e293b92e137a81c20e6aa wxpython-4.3.2.tar.gz https://files.pythonhosted.org/packages/source/w/wxpython/

runmake=0 runpysetup=0 rungpepinstall=0

# build.py with the system wxWidgets, the generic PEP517 build bundles its own
wxpython_main() {
	python3 build.py build_py --use_syswx --release --nodoc --jobs=$SDECFG_PARALLEL
	python3 build.py install_py --destdir=$root
}
hook_add inmake 5 wxpython_main
