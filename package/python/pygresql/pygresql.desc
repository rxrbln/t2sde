[I] A Python interface for PostgreSQL

[T] PyGreSQL is a Python module that interfaces to a PostgreSQL database.
[T] It embeds the PostgreSQL query library to allow easy use of the powerful
[T] PostgreSQL features from a Python script.

[U] https://pygresql.github.io/

[A] D'Arcy J.M. Cain <darcy@druid.net>
[M] René Rebe <rene@exactco.de>

[C] extra/tool
[F] CROSS

[L] BSD
[V] 6.2.3

[D] 0729e5734653ce280bd889761d3921df7d3748cc420d9d9868cfcf9c pygresql-6.2.3.tar.gz https://files.pythonhosted.org/packages/source/p/pygresql/

# the target pg_config can not run on the build host
pkg_pygresql_pgconfig() {
	mkdir -p pgcross
	cat > pgcross/pg_config <<-EOT
	#!/bin/sh
	case "\$1" in
	--version) echo "PostgreSQL $(pkgprefix ver postgresql)" ;;
	--includedir) echo "$root$(pkgprefix includedir postgresql)" ;;
	--libdir) echo "$root$(pkgprefix libdir postgresql)" ;;
	*) exit 1 ;;
	esac
	EOT
	chmod +x pgcross/pg_config
	export PATH="$PWD/pgcross:$PATH"
}
atstage cross && hook_add preconf 5 pkg_pygresql_pgconfig
