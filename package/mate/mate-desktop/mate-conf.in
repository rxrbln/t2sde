if [ "$prefix_auto" = 1 ]; then
	if [ "$1" = "NO_SANITY_CHECK" ]; then
		if [ "$SDECFG_PKG_MATE_CORE_PREFIX" ]; then
			prefix="$SDECFG_PKG_MATE_CORE_PREFIX"
		else
			prefix="opt/mate"
		fi
	elif pkginstalled -n mate-desktop; then
		pkgprefix -t mate-desktop
		prefix=`pkgprefix mate-desktop`
	fi
	set_confopt
fi

# mate-autogen is an arch independent script, use it from the sysroot
if atstage cross && pkginstalled -n mate-common; then
	var_append PATH ':' "$root$(pkgprefix bindir mate-common)"
	export ACLOCAL_FLAGS="${ACLOCAL_FLAGS:+$ACLOCAL_FLAGS }-I $root$(pkgprefix datadir mate-common)/aclocal"
fi
