[D] ab662b955c49fda40e0642bf79adeecff1c3c07edf5ddb3659506115 luajit-2.1-27f169c.tar.gz https://github.com/LuaJIT/LuaJIT/archive/27f169c/

. $base/package/*/*/lua-conf.in

var_append AR ' ' rc
var_append makeopt ' ' "MYCFLAGS=\"$myCFLAGS\""
var_append makeopt ' ' "MYLIBS=\"-Wl,-E $myLIBS\""
