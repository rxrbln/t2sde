[V] 38

[D] 93a74ab90f976d258f5c551b16f58bf610828e5ccddb5714b87d5cd1 luaposix-38.tar.gz https://github.com/luaposix/luaposix/archive/v38/

. $base/package/*/*/lua-conf.in

runmake=0
hook_add inmake 5 ./build-aux/luke
hook_add postmake 5 "./build-aux/luke PREFIX=$root/$prefix INST_LIBDIR=$root$pkglibdir INST_LUADIR=$root$pkgdatadir install"
