[I] Platform independent system calls for Lua

[T] Platform independent system calls for Lua.

[U] https://github.com/lunarmodules/luasystem/

[A] Lua-system Authors
[M] René Rebe <rene@exactco.de>

[C] extra/base
[F] CROSS

[L] MIT
[V] 0.7.1

[D] 28f35488020815ff41e6b072f6d270804ad658222b6027f8644493ac lua-system-0.7.1.tar.gz https://github.com/lunarmodules/luasystem/archive/v0.7.1/

. $base/package/lua/lua/lua-conf.in

var_append makeopt ' ' "LUA_VERSION=$luaver"
var_append makeinstopt ' ' "LUA_VERSION=$luaver"
atstage cross && var_append makeopt ' ' 'LD=$CC'
atstage cross && var_append makeinstopt ' ' 'LD=$CC'

# the Makefile only installs the C core, the rockspec also the Lua module
hook_add postmake 5 'install -D -m 644 system/init.lua $root$pkgdatadir/system/init.lua'
