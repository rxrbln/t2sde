[I] Libmpack bindings for Lua

[T] Libmpack bindings for Lua.

[U] https://github.com/libmpack/libmpack-lua

[A] Lua-mpack Authors
[M] René Rebe <rene@exactco.de>

[C] extra/base
[F] CROSS

[V] 1.0.13
[L] MIT

[D] 1352c19f59511b3f5c58b36fba1aaa8907871c2d266415e78541a917 libmpack-lua-1.0.13.tar.gz https://github.com/libmpack/libmpack-lua/archive/1.0.13/

makeinstopt=

. $base/package/lua/lua/lua-conf.in

var_append makeopt ' ' 'USE_SYSTEM_LUA=yes USE_SYSTEM_MPACK=yes LUA_IMPL=lua'
hook_add postmake 5 'install -D -m 755 mpack.so $root$pkglibdir/mpack.so'
