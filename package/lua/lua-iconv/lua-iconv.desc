[I] Lua binding to the POSIX 'iconv' library

[T] Lua binding to the POSIX 'iconv' library.

[U] https://github.com/lunarmodules/lua-iconv/

[A] Lua-iconv Authors
[M] René Rebe <rene@exactco.de>

[C] extra/base
[F] CROSS

[V] 7.1.0
[L] MIT

[D] 6fbf266c842ed43bfc7e2d07f34df061a190d028ae14a3d435814e87 lua-iconv-7.1.0.tar.gz https://github.com/lunarmodules/lua-iconv/archive/v7.1.0/

makeinstopt=

. $base/package/lua/lua/lua-conf.in

var_append makeopt ' ' LUAPKG=lua
hook_add postmake 5 'install -D -m 755 iconv.so $root$pkglibdir/iconv.so'
