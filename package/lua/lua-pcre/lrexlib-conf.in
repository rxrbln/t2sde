# inherit $pkglibdir
. $base/package/*/*/lua-conf.in

# build the modules directly, upstream only ships luarocks rockspecs
build_lrexlib() {
	local x libs
	pkglibdir=$root$pkglibdir; mkdir -p $pkglibdir
	for x; do
		case $x in
			pcre) libs=-lpcre ;;
			pcre2) libs=-lpcre2-8 ;;
			oniguruma) libs=-lonig ;;
			*) libs= ;;
		esac
		$CC $CFLAGS -fPIC -shared -DVERSION="\"$ver\"" -DLUA_LIB= -DPCRE2_CODE_UNIT_WIDTH=8 \
			-o $pkglibdir/rex_${x/oniguruma/onig}.so src/common.c src/$x/*.c $libs
	done
}
