[COPY] --- T2-COPYRIGHT-END ---

[I] A data structure server

[T] A database server provides access to mutable data structures via a set of
[T] commands, which are sent using a server-client model with TCP sockets and
[T] a simple protocol. So different processes can query and modify the same
[T] data structures in a shared way.

[U] https://redis.io/

[A] Redis Ltd.
[M] Daniel Ashkenazi <daniel.ashkenazi@gmail.com>

[C] extra/database
[F] CROSS

[E] opt systemd

[L] BSD
[V] 8.10.3

[D] 68a6ed3bd4ce1830229d18b55aaf22e2f466a53918f40c20277e1e0c redis-8.10.3.tar.gz https://download.redis.io/releases/

runconf=0
var_append makeopt ' ' BUILD_TLS=yes
[ "$SDECFG_X8664_X32" = 1 ] && var_append makeopt ' ' 32bit
var_append makeinstopt ' ' 'PREFIX="$root/$prefix"'

install() {
	mkdir -p $root/etc/redis
	cp -vf redis.conf sentinel.conf $root/etc/redis/
}
hook_add postmake 2 install

if atstage cross; then
	jeopt="--host=$arch_target"
	# the bundled jemalloc can not detect the target page size
	[ "$arch" = alpha ] && jeopt="$jeopt --with-lg-page=13"
	var_append makeopt ' ' "JEMALLOC_CONFIGURE_OPTS='$jeopt'"
fi

pkginstalled rustc || var_append makeopt ' ' BUILD_ARGS=redis
