[I] Apache couchdb server

[T] Apache CouchDB is a document-oriented database that can be queried and
[T] indexed in a MapReduce fashion using JavaScript. CouchDB also offers
[T] incremental replication with bi-directional conflict detection and
[T] resolution.

[U] https://couchdb.apache.org

[A] Apache CouchDB
[M] René Rebe <rene@exactco.de>

[C] extra/database
[F] CROSS

[L] APL
[V] 3.5.3

[D] 7f33c071953fbaed1b17dec04fb9ef26805f3eddebcbbec03654c3ee apache-couchdb-3.5.3.tar.gz https://www.apache.org/dist/couchdb/source/3.5.3/

var_append confopt ' ' --user=couchdb
case "$(pkgprefix ver mozjs)" in
	91.*|102.*|115.*|128.*) var_append confopt ' ' --spidermonkey-version=$(pkgprefix ver mozjs | cut -d. -f1) ;;
	*) var_append confopt ' ' --disable-spidermonkey ;;
esac

# make install only builds the release, copy it to /opt like upstream packages
couchdb_install() {
	mkdir -p $root/opt/couchdb
	cp -a rel/couchdb/. $root/opt/couchdb/
	mkdir -p $root/opt/couchdb/data $root/opt/couchdb/var/log $root/var/lib/couchdb
	chown -R 69:69 $root/opt/couchdb/{data,var/log,etc} $root/var/lib/couchdb
}
hook_add postmake 5 couchdb_install
