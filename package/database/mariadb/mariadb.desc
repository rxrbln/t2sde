[D] 3fc33a0e06440d3b14c5e51d55a87795af1293ea985c0a65e4373708 mariadb-13.0.2.tar.gz https://downloads.mariadb.org/interstitial/mariadb-13.0.2/source/

# comp_err, gen_lex_hash and friends run at build time, import them from a native build
mariadb_native_tools() {
	local nat=$builddir/native
	mkdir -p $nat
	(cd $nat && env PATH="${PATH/$CMD_WRAPPER_MYPATH:/}" CC=$HOSTCC CXX=$HOSTCXX \
		CFLAGS= CXXFLAGS= LDFLAGS= PKG_CONFIG_PATH= PKG_CONFIG_LIBDIR= PKG_CONFIG_SYSROOT_DIR= \
		cmake $builddir/$pkg-$ver -DCMAKE_BUILD_TYPE=Release -DWITH_SSL=bundled \
		-DWITH_WSREP=OFF -DWITH_UNIT_TESTS=OFF -DPLUGIN_MROONGA=NO -DPLUGIN_ROCKSDB=NO \
		-DPLUGIN_SPIDER=NO -DPLUGIN_CONNECT=NO -DPLUGIN_COLUMNSTORE=NO &&
		make -j$SDECFG_PARALLEL import_executables) || return 1
	var_append cmakeopt ' ' "-DIMPORT_EXECUTABLES=$nat/import_executables.cmake"
}
atstage cross && hook_add preconf 5 mariadb_native_tools
atstage cross && var_append cmakeopt ' ' -DHAVE_SYSTEM_LIBFMT_EXITCODE=0

var_append cmakeopt ' ' "-DWITH_UNIT_TESTS=OFF -DINSTALL_MYSQLTESTDIR= -DINSTALL_SQLBENCHDIR= -DINSTALL_SCRIPTDIR=bin"
var_append cmakeopt ' ' "-DINSTALL_DOCDIR=${docdir#/$prefix/} -DINSTALL_DOCREADMEDIR=${docdir#/$prefix/} -DINSTALL_SUPPORTFILESDIR=share/mariadb"
