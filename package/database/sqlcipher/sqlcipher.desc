[I] An SQLite extension that provides 256 bit AES encryption of database files

[T] SQLCipher is an SQLite extension that provides 256 bit AES encryption of database files.

[U] https://www.zetetic.net/sqlcipher/

[A] Sqlcipher Authors
[M] René Rebe <rene@exactco.de>

[C] extra/base

[V] 4.19.0
[L] BSD

[D] fda9f79a39a698b93c25b04f4601fc0c7d7bf5a5d9fa25c34b28e774 sqlcipher-4.19.0.tar.gz https://github.com/sqlcipher/sqlcipher/archive/v4.19.0/

atstage cross && export TCLLIBDIR=$libdir/sqlcipher$ver

var_append confopt ' ' --disable-static
var_append makeopt ' ' "libsqlite3.DLL.basename=libsqlcipher LDFLAGS.libsqlite3.soname=-Wl,-soname,libsqlcipher.so.0"
makeinstopt="$makeopt DESTDIR=\$PWD/t2-inst install"

sqlcipher_inst() {
	local s=$PWD/t2-inst
	mkdir -p $root$libdir/pkgconfig $root$includedir/sqlcipher $root$bindir $root$mandir/man1
	cp -av $s$libdir/libsqlcipher.so* $root$libdir/
	cp -av $s$includedir/sqlite3*.h $root$includedir/sqlcipher/
	sed -e 's/-lsqlite3/-lsqlcipher/; s,^includedir=.*,&/sqlcipher,; s/^Name: .*/Name: SQLCipher/' \
		$s$libdir/pkgconfig/sqlite3.pc > $root$libdir/pkgconfig/sqlcipher.pc
	cp -av $s$bindir/sqlite3 $root$bindir/sqlcipher
	cp -av $(find $s -name sqlite3.1) $root$mandir/man1/sqlcipher.1
	find $s -name pkgIndex.tcl | while read d; do
		d=${d%/*}; mkdir -p $root${d#$s}; cp -av $d/. $root${d#$s}/
	done
}
hook_add postmake 5 sqlcipher_inst
