diff -urNp a/drivers/gpu/drm/gma500/power.c b/drivers/gpu/drm/gma500/power.c
--- a/drivers/gpu/drm/gma500/power.c	2026-08-16 23:32:26.000000000 +0200
+++ b/drivers/gpu/drm/gma500/power.c	2026-09-06 18:39:36.531285003 +0200
@@ -34,6 +34,7 @@
 #include "psb_reg.h"
 #include "psb_intel_reg.h"
 #include "psb_irq.h"
+#include "psb_sgx_render.h"
 #include <linux/mutex.h>
 #include <linux/pm_runtime.h>
 
@@ -180,6 +181,8 @@ int gma_power_suspend(struct device *_de
 	struct pci_dev *pdev = to_pci_dev(_dev);
