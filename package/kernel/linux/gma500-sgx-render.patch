+#define SGX_DPM_MIN_WORK_PAGES	0x41u
+#define SGX_DPM_BYTES_PER_MTILE	4096u
+#define SGX_DPM_BYTES_PER_PRIM	256u
+#define SGX_DPM_PRIM_SPREAD	4u
+#define SGX_DPM_MAX_PRIMS	4096u
+
+/* Time the parts of a submit and report the average every 64 frames. */
