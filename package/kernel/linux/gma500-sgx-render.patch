+	if (!dotclock_mhz || !bpp || !dev_priv->mem_freq)
+		return 0;
+
+	drain = psb_wm_drain(dev_priv, PSB_WM_QUEUE_SIZE * latency,
+			     dotclock_mhz, bpp);
+	if (sr_exit)
+		drain += psb_wm_drain(dev_priv, PSB_WM_SR_EXIT_LATENCY,
+				      dotclock_mhz, bpp);
