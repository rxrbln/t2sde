+		val &= ~((FW_BLC1_WM1_MASK << FW_BLC1_DISPA_WM1_SHIFT) |
+			 (FW_BLC1_WM1_MASK << FW_BLC1_DISPB_WM1_SHIFT));
+		val |= (wm_a1 & FW_BLC1_WM1_MASK) << FW_BLC1_DISPA_WM1_SHIFT;
+		val |= (wm_b1 & FW_BLC1_WM1_MASK) << FW_BLC1_DISPB_WM1_SHIFT;
