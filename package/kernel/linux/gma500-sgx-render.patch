+ * only fires when the two have drifted - and it turns a fault the log cannot
+ * attribute into a refusal that names the handle. */
+static bool sgx_bind_check = true;
+module_param_named(sgx_bind_check, sgx_bind_check, bool, 0644);
+MODULE_PARM_DESC(sgx_bind_check,
+	"refuse a submit naming an object that is not bound (default on)");
