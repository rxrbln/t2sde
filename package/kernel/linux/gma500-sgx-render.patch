+/* A fence is signalled before it is handed out and a submit that asks for one
+ * waits in line, so there is no timeline to wait on beyond the ioctl itself.
+ * That is honest rather than convenient: the hardware has no completion
+ * interrupt wired up here, so a fence that claimed to be pending would be a
+ * fence nothing could ever signal. */
+static const struct dma_fence_ops sgx_fence_ops = {
+	.get_driver_name = sgx_fence_get_name,
+	.get_timeline_name = sgx_fence_get_name,
+};
