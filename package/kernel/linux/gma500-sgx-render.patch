+		wm_a2 = psb_wm_level(dev, b_start, false, PSB_WM_DUAL_A_LATENCY,
+				     mhz_a, bpp_a);
+		wm_b1 = psb_wm_level(dev, c_start - b_start, true,
+				     PSB_WM_FIFO_B_LATENCY, mhz_b, bpp_b);
+		wm_b2 = psb_wm_level(dev, c_start - b_start, false,
+				     PSB_WM_FIFO_B_LATENCY, mhz_b, bpp_b);
