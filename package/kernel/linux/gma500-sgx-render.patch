+			FW_BLC3_WM1_STATUS0_SHIFT;
+		val |= (wm_a1 & FW_BLC3_WM1_STATUS_MASK) <<
+			FW_BLC3_WM1_STATUS1_SHIFT;
+		REG_WRITE(FW_BLC3, val);
