+ *	layouts from src/psb_driver.h:1074-1148 and the constants from
+ *	src/i810_reg.h:2287-2303. Nothing here programmed them, so every mode
+ *	ran on whatever the firmware left behind for the panel it booted with,
+ *	and a wider or faster pipe than that underruns the display FIFO.
+ */
+
+#define PSB_WM_QUEUE_SIZE		16
+#define PSB_WM_SR_EXIT_LATENCY		100
+#define PSB_WM_BITS_PER_CACHE_LINE	512
+#define PSB_WM_FIFO_A_LATENCY		12
+#define PSB_WM_FIFO_B_LATENCY		10
+#define PSB_WM_DUAL_A_LATENCY		15
