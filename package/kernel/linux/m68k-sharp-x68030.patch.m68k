From f3f854db6d5a9ff36d69515b6fd4381700e3e2bf Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 10:21:53 +0100
Subject: [PATCH 01/31] serial: pmac_zilog: Support a baud clock from PCLK and
 interrupt vectors
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The X68030 has no 3.6864 MHz clock on RTxC, its baud rate generator runs from
the 5 MHz PCLK.  It also uses the vector the Z8530 supplies when acknowledging an
interrupt, so the no vector bit must stay clear.  Boards give both through new
platform data.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/tty/serial/Kconfig               |  2 +-
 drivers/tty/serial/pmac_zilog.c          | 24 ++++++++++++++++++++++--
 drivers/tty/serial/pmac_zilog.h          |  2 ++
 include/linux/platform_data/pmac_zilog.h | 18 ++++++++++++++++++
 4 files changed, 43 insertions(+), 3 deletions(-)
 create mode 100644 include/linux/platform_data/pmac_zilog.h

diff --git a/drivers/tty/serial/Kconfig b/drivers/tty/serial/Kconfig
index 80f6939a06c0..be07470911a3 100644
--- a/drivers/tty/serial/Kconfig
+++ b/drivers/tty/serial/Kconfig
@@ -735,7 +735,7 @@ config SERIAL_MCF_CONSOLE
 
 config SERIAL_PMACZILOG
 	tristate "Mac or PowerMac z85c30 ESCC support"
-	depends on (M68K && (MAC || NEXT)) || PPC_PMAC
+	depends on (M68K && (MAC || NEXT || X68K)) || PPC_PMAC
 	select SERIAL_CORE
 	help
 	  This driver supports the Zilog z85C30 serial ports found on
diff --git a/drivers/tty/serial/pmac_zilog.c b/drivers/tty/serial/pmac_zilog.c
index 3a58fac973bc..d520634678fe 100644
--- a/drivers/tty/serial/pmac_zilog.c
+++ b/drivers/tty/serial/pmac_zilog.c
@@ -61,6 +61,8 @@
 #include <linux/serial.h>
 #include <linux/serial_core.h>
 
+#include <linux/platform_data/pmac_zilog.h>
+
 #include "pmac_zilog.h"
 
 #ifdef CONFIG_NEXT
@@ -186,6 +188,9 @@ static void pmz_load_zsregs(struct uart_pmac_port *uap, u8 *regs)
 	/* Rewrite R1, this time without IRQ enabled masked.  */
 	write_zsreg(uap, R1, regs[R1]);
 
+	if (uap->vector)
+		write_zsreg(uap, R2, uap->vector);
+
 	/* Enable interrupts */
 	write_zsreg(uap, R9, regs[R9]);
 }
@@ -936,13 +941,13 @@ static int __pmz_startup(struct uart_pmac_port *uap)
 		uap->curregs[R5] |= DTR;
 	uap->curregs[R12] = 0;
 	uap->curregs[R13] = 0;
-	uap->curregs[R14] = BRENAB;
+	uap->curregs[R14] = BRENAB | (uap->pclk ? BRSRC : 0);
 
 	/* Clear handshaking, enable BREAK interrupts */
 	uap->curregs[R15] = BRKIE;
 
 	/* Master interrupt enable */
-	uap->curregs[R9] |= NV | MIE;
+	uap->curregs[R9] |= (uap->vector ? 0 : NV) | MIE;
 
 	pmz_load_zsregs(uap, uap->curregs);
 
@@ -1081,6 +1086,14 @@ static void pmz_convert_to_zs(struct uart_pmac_port *uap, unsigned int cflag,
 		uap->curregs[R12] = 0;
 		uap->curregs[R13] = 0;
 		uap->flags |= PMACZILOG_FLAG_IS_EXTCLK;
+	} else if (uap->pclk) {
+		uap->curregs[R4] = X16CLK;
+		uap->curregs[R11] = TCBR | RCBR;
+		brg = BPS_TO_BRG(baud, uap->pclk / 16);
+		uap->curregs[R12] = (brg & 255);
+		uap->curregs[R13] = ((brg >> 8) & 255);
+		uap->curregs[R14] = BRENAB | BRSRC;
+		uap->flags &= ~PMACZILOG_FLAG_IS_EXTCLK;
 	} else {
 		switch (baud) {
 		case ZS_CLOCK/16:	/* 230400 */
@@ -1732,6 +1745,7 @@ extern struct platform_device scc_a_pdev, scc_b_pdev;
 static int __init pmz_init_port(struct uart_pmac_port *uap)
 {
 	struct resource *r_ports, *r_data;
+	struct pmz_platform_data *pdata;
 	int irq;
 
 	r_ports = platform_get_resource(uap->pdev, IORESOURCE_MEM, 0);
@@ -1759,6 +1773,12 @@ static int __init pmz_init_port(struct uart_pmac_port *uap)
 	uap->port_type     = 0;
 	uap->port.has_sysrq = IS_ENABLED(CONFIG_SERIAL_PMACZILOG_CONSOLE);
 
+	pdata = dev_get_platdata(&uap->pdev->dev);
+	if (pdata) {
+		uap->pclk = pdata->pclk;
+		uap->vector = pdata->vector;
+	}
+
 	pmz_convert_to_zs(uap, CS8, 0, 9600);
 
 	return 0;
diff --git a/drivers/tty/serial/pmac_zilog.h b/drivers/tty/serial/pmac_zilog.h
index 837b97ca0a90..66aad55d8804 100644
--- a/drivers/tty/serial/pmac_zilog.h
+++ b/drivers/tty/serial/pmac_zilog.h
@@ -15,6 +15,8 @@
 struct uart_pmac_port {
 	struct uart_port		port;
 	struct uart_pmac_port		*mate;
+	unsigned int			pclk;	/* baud clock if not RTxC */
+	u8				vector;	/* else no interrupt vector */
 
 #ifdef CONFIG_PPC_PMAC
 	/* macio_dev for the escc holding this port (maybe be null on
diff --git a/include/linux/platform_data/pmac_zilog.h b/include/linux/platform_data/pmac_zilog.h
new file mode 100644
index 000000000000..5ed7fd292107
--- /dev/null
+++ b/include/linux/platform_data/pmac_zilog.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Board wiring of a Z8530 for the pmac_zilog driver
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef _LINUX_PLATFORM_DATA_PMAC_ZILOG_H
+#define _LINUX_PLATFORM_DATA_PMAC_ZILOG_H
+
+#include <linux/types.h>
+
+struct pmz_platform_data {
+	unsigned int pclk;	/* baud rates from this clock instead of RTxC */
+	u8 vector;		/* interrupts acknowledged with this vector */
+};
+
+#endif /* _LINUX_PLATFORM_DATA_PMAC_ZILOG_H */
-- 
2.54.0


From b05631e597c33a8724e30397056e56f7a6e41ba6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 10:21:53 +0100
Subject: [PATCH 02/31] m68k: Add Sharp X68030 support
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add a machine type for the Sharp X68030.  The stock 68EC030 has no MMU, so that
the CPU needs to be replaced with a full MC68030.

 - head.S maps VRAM, devices and ROM to 0xf0000000 with page tables, as they are
   above the RAM and collide with vmalloc space when mapped one to one
 - devices supply their interrupt vectors, the sources of the MFP can be masked
 - system tick and clocksource from MFP timer C
 - reset re-enters the ROM with address translation off

"make x68kboot" builds a loader and the kernel as a flat binary, which mkx68kdisk
writes to a disk the ROM boots from.  The loader only uses documented ROM calls.
It detects the FPU type from the FSAVE frame size, as the kernel validates signal
frames against it.

Tested on MAME with the internal SCSI DMA fixed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/Kbuild                           |   1 +
 arch/m68k/Kconfig.machine                  |  11 ++
 arch/m68k/Makefile                         |   3 +
 arch/m68k/configs/x68k_defconfig           |  31 +++++
 arch/m68k/include/asm/config.h             |   2 +
 arch/m68k/include/asm/irq.h                |   2 +
 arch/m68k/include/asm/setup.h              |  38 ++++--
 arch/m68k/include/asm/x68k.h               |  71 ++++++++++
 arch/m68k/include/uapi/asm/bootinfo-x68k.h |  13 ++
 arch/m68k/include/uapi/asm/bootinfo.h      |   1 +
 arch/m68k/kernel/head.S                    |  64 ++++++++-
 arch/m68k/kernel/setup_mm.c                |   9 +-
 arch/m68k/x68k/Makefile                    |   6 +
 arch/m68k/x68k/boot/Makefile               |  51 +++++++
 arch/m68k/x68k/boot/head.S                 | 148 +++++++++++++++++++++
 arch/m68k/x68k/boot/loader.lds             |  14 ++
 arch/m68k/x68k/boot/main.c                 | 138 +++++++++++++++++++
 arch/m68k/x68k/boot/mkx68kdisk.c           |  75 +++++++++++
 arch/m68k/x68k/config.c                    |  89 +++++++++++++
 arch/m68k/x68k/ints.c                      |  77 +++++++++++
 arch/m68k/x68k/reset.S                     |  28 ++++
 arch/m68k/x68k/time.c                      |  61 +++++++++
 22 files changed, 919 insertions(+), 14 deletions(-)
 create mode 100644 arch/m68k/configs/x68k_defconfig
 create mode 100644 arch/m68k/include/asm/x68k.h
 create mode 100644 arch/m68k/include/uapi/asm/bootinfo-x68k.h
 create mode 100644 arch/m68k/x68k/Makefile
 create mode 100644 arch/m68k/x68k/boot/Makefile
 create mode 100644 arch/m68k/x68k/boot/head.S
 create mode 100644 arch/m68k/x68k/boot/loader.lds
 create mode 100644 arch/m68k/x68k/boot/main.c
 create mode 100644 arch/m68k/x68k/boot/mkx68kdisk.c
 create mode 100644 arch/m68k/x68k/config.c
 create mode 100644 arch/m68k/x68k/ints.c
 create mode 100644 arch/m68k/x68k/reset.S
 create mode 100644 arch/m68k/x68k/time.c

diff --git a/arch/m68k/Kbuild b/arch/m68k/Kbuild
index 6dd34a2754e8..fc459e089799 100644
--- a/arch/m68k/Kbuild
+++ b/arch/m68k/Kbuild
@@ -19,3 +19,4 @@ obj-$(CONFIG_M68000)		+= 68000/
 obj-$(CONFIG_COLDFIRE)		+= coldfire/
 obj-$(CONFIG_VIRT)		+= virt/
 obj-$(CONFIG_NEXT)		+= next/
+obj-$(CONFIG_X68K)		+= x68k/
diff --git a/arch/m68k/Kconfig.machine b/arch/m68k/Kconfig.machine
index f0f1fc21a2e9..7853edaedd78 100644
--- a/arch/m68k/Kconfig.machine
+++ b/arch/m68k/Kconfig.machine
@@ -49,6 +49,17 @@ config NEXT
 	  Say Y here to build a kernel for these machines, and build the
 	  "nextboot" target for an image the boot ROM can load.
 
+config X68K
+	bool "Sharp X68030 support"
+	depends on MMU && M68030
+	select LEGACY_TIMER_TICK
+	help
+	  This option enables support for the Sharp X68030. The stock 68EC030
+	  has no MMU, so it needs to be replaced with a full MC68030.
+
+	  Say Y here to build a kernel for this machine, and build the
+	  "x68kboot" target for an image the boot ROM can load from disk.
+
 config APOLLO
 	bool "Apollo support"
 	depends on MMU
diff --git a/arch/m68k/Makefile b/arch/m68k/Makefile
index b02766af4ff5..14f82def5d40 100644
--- a/arch/m68k/Makefile
+++ b/arch/m68k/Makefile
@@ -124,6 +124,9 @@ else
 	$(KBZIP2) -1c vmlinux >vmlinux.bz2
 endif
 
+x68kboot: vmlinux
+	$(Q)$(MAKE) $(build)=arch/m68k/x68k/boot arch/m68k/x68k/boot/x68kboot
+
 nextboot: vmlinux
 	$(Q)$(MAKE) $(build)=arch/m68k/next/boot arch/m68k/next/boot/nextboot
 
diff --git a/arch/m68k/configs/x68k_defconfig b/arch/m68k/configs/x68k_defconfig
new file mode 100644
index 000000000000..847e8fcded21
--- /dev/null
+++ b/arch/m68k/configs/x68k_defconfig
@@ -0,0 +1,31 @@
+CONFIG_LOCALVERSION="-x68k"
+CONFIG_SYSVIPC=y
+CONFIG_POSIX_MQUEUE=y
+CONFIG_NO_HZ_IDLE=y
+CONFIG_HIGH_RES_TIMERS=y
+CONFIG_LOG_BUF_SHIFT=16
+CONFIG_BLK_DEV_INITRD=y
+CONFIG_CC_OPTIMIZE_FOR_SIZE=y
+CONFIG_EXPERT=y
+CONFIG_M68KCLASSIC=y
+CONFIG_M68030=y
+CONFIG_M68KFPU_EMU=y
+CONFIG_X68K=y
+CONFIG_BOOTINFO_PROC=y
+CONFIG_MODULES=y
+CONFIG_MODULE_UNLOAD=y
+CONFIG_PARTITION_ADVANCED=y
+CONFIG_SWAP=y
+CONFIG_NET=y
+CONFIG_PACKET=y
+CONFIG_UNIX=y
+CONFIG_INET=y
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_BLK_DEV=y
+CONFIG_BLK_DEV_LOOP=y
+CONFIG_SERIAL_PMACZILOG=y
+CONFIG_SERIAL_PMACZILOG_TTYS=y
+CONFIG_SERIAL_PMACZILOG_CONSOLE=y
+CONFIG_VT=y
+CONFIG_VT_CONSOLE=y
diff --git a/arch/m68k/include/asm/config.h b/arch/m68k/include/asm/config.h
index 4e4f34f6cbf4..708541081e1c 100644
--- a/arch/m68k/include/asm/config.h
+++ b/arch/m68k/include/asm/config.h
@@ -22,6 +22,7 @@ extern int mvme16x_parse_bootinfo(const struct bi_record *record);
 extern int q40_parse_bootinfo(const struct bi_record *record);
 extern int virt_parse_bootinfo(const struct bi_record *record);
 extern int next_parse_bootinfo(const struct bi_record *record);
+extern int x68k_parse_bootinfo(const struct bi_record *record);
 
 extern void config_amiga(void);
 extern void config_apollo(void);
@@ -36,5 +37,6 @@ extern void config_sun3(void);
 extern void config_sun3x(void);
 extern void config_virt(void);
 extern void config_next(void);
+extern void config_x68k(void);
 
 #endif /* _M68K_CONFIG_H */
diff --git a/arch/m68k/include/asm/irq.h b/arch/m68k/include/asm/irq.h
index 7a94f5b78064..732a93a657c3 100644
--- a/arch/m68k/include/asm/irq.h
+++ b/arch/m68k/include/asm/irq.h
@@ -26,6 +26,8 @@
 #define NR_IRQS	43
 #elif defined(CONFIG_NEXT)
 #define NR_IRQS	40
+#elif defined(CONFIG_X68K)
+#define NR_IRQS	56
 #elif defined(CONFIG_AMIGA) || !defined(CONFIG_MMU)
 #define NR_IRQS	32
 #elif defined(CONFIG_APOLLO)
diff --git a/arch/m68k/include/asm/setup.h b/arch/m68k/include/asm/setup.h
index 55a688dac9d6..8d2c1c666aed 100644
--- a/arch/m68k/include/asm/setup.h
+++ b/arch/m68k/include/asm/setup.h
@@ -38,7 +38,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_MVME16x) || defined(CONFIG_BVME6000)               \
 	|| defined(CONFIG_HP300) || defined(CONFIG_Q40)                      \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147)                  \
-	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT) || defined(CONFIG_X68K)
 #  define MACH_IS_AMIGA (m68k_machtype == MACH_AMIGA)
 #else
 #  define MACH_AMIGA_ONLY
@@ -52,7 +52,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_MVME16x) || defined(CONFIG_BVME6000)               \
 	|| defined(CONFIG_HP300) || defined(CONFIG_Q40)                      \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147)                  \
-	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT) || defined(CONFIG_X68K)
 #  define MACH_IS_ATARI (m68k_machtype == MACH_ATARI)
 #else
 #  define MACH_ATARI_ONLY
@@ -66,7 +66,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_MVME16x) || defined(CONFIG_BVME6000)                 \
 	|| defined(CONFIG_HP300) || defined(CONFIG_Q40)                        \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147)                    \
-	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT) || defined(CONFIG_X68K)
 #  define MACH_IS_MAC (m68k_machtype == MACH_MAC)
 #else
 #  define MACH_MAC_ONLY
@@ -88,7 +88,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_MVME16x) || defined(CONFIG_BVME6000)              \
 	|| defined(CONFIG_HP300) || defined(CONFIG_Q40)                     \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147)                 \
-	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT) || defined(CONFIG_X68K)
 #  define MACH_IS_APOLLO (m68k_machtype == MACH_APOLLO)
 #else
 #  define MACH_APOLLO_ONLY
@@ -102,7 +102,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_BVME6000)               \
 	|| defined(CONFIG_HP300) || defined(CONFIG_Q40)                     \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME16x)                 \
-	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT) || defined(CONFIG_X68K)
 #  define MACH_IS_MVME147 (m68k_machtype == MACH_MVME147)
 #else
 #  define MACH_MVME147_ONLY
@@ -116,7 +116,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_BVME6000)               \
 	|| defined(CONFIG_HP300) || defined(CONFIG_Q40)                     \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147)                 \
-	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT) || defined(CONFIG_X68K)
 #  define MACH_IS_MVME16x (m68k_machtype == MACH_MVME16x)
 #else
 #  define MACH_MVME16x_ONLY
@@ -130,7 +130,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_MVME16x)                \
 	|| defined(CONFIG_HP300) || defined(CONFIG_Q40)                     \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147)                 \
-	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT) || defined(CONFIG_X68K)
 #  define MACH_IS_BVME6000 (m68k_machtype == MACH_BVME6000)
 #else
 #  define MACH_BVME6000_ONLY
@@ -144,7 +144,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_MVME16x) \
 	|| defined(CONFIG_BVME6000) || defined(CONFIG_Q40) \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147) \
-	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT) || defined(CONFIG_X68K)
 #  define MACH_IS_HP300 (m68k_machtype == MACH_HP300)
 #else
 #  define MACH_HP300_ONLY
@@ -158,7 +158,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_MVME16x)                \
 	|| defined(CONFIG_BVME6000) || defined(CONFIG_HP300)                \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147)                 \
-	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT) || defined(CONFIG_X68K)
 #  define MACH_IS_Q40 (m68k_machtype == MACH_Q40)
 #else
 #  define MACH_Q40_ONLY
@@ -172,7 +172,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_MVME16x)                \
 	|| defined(CONFIG_BVME6000) || defined(CONFIG_HP300)                \
 	|| defined(CONFIG_Q40) || defined(CONFIG_MVME147)                   \
-	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT) || defined(CONFIG_X68K)
 #  define MACH_IS_SUN3X (m68k_machtype == MACH_SUN3X)
 #else
 #  define CONFIG_SUN3X_ONLY
@@ -186,7 +186,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_MVME16x)                \
 	|| defined(CONFIG_BVME6000) || defined(CONFIG_HP300)                \
 	|| defined(CONFIG_Q40) || defined(CONFIG_SUN3X)                     \
-	|| defined(CONFIG_MVME147) || defined(CONFIG_NEXT)
+	|| defined(CONFIG_MVME147) || defined(CONFIG_NEXT) || defined(CONFIG_X68K)
 #  define MACH_IS_VIRT (m68k_machtype == MACH_VIRT)
 #else
 #  define MACH_VIRT_ONLY
@@ -200,7 +200,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_MVME16x)                \
 	|| defined(CONFIG_BVME6000) || defined(CONFIG_HP300)                \
 	|| defined(CONFIG_Q40) || defined(CONFIG_SUN3X)                     \
-	|| defined(CONFIG_MVME147) || defined(CONFIG_VIRT)
+	|| defined(CONFIG_MVME147) || defined(CONFIG_VIRT) || defined(CONFIG_X68K)
 #  define MACH_IS_NEXT (m68k_machtype == MACH_NEXT)
 #else
 #  define MACH_NEXT_ONLY
@@ -208,6 +208,20 @@ extern unsigned long m68k_machtype;
 #  define MACH_TYPE (MACH_NEXT)
 #endif
 
+#if !defined(CONFIG_X68K)
+#  define MACH_IS_X68K (0)
+#elif defined(CONFIG_AMIGA) || defined(CONFIG_MAC) || defined(CONFIG_ATARI) \
+	|| defined(CONFIG_APOLLO) || defined(CONFIG_MVME16x)                \
+	|| defined(CONFIG_BVME6000) || defined(CONFIG_HP300)                \
+	|| defined(CONFIG_Q40) || defined(CONFIG_SUN3X)                     \
+	|| defined(CONFIG_MVME147) || defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
+#  define MACH_IS_X68K (m68k_machtype == MACH_X68K)
+#else
+#  define MACH_X68K_ONLY
+#  define MACH_IS_X68K (1)
+#  define MACH_TYPE (MACH_X68K)
+#endif
+
 #ifndef MACH_TYPE
 #  define MACH_TYPE (m68k_machtype)
 #endif
diff --git a/arch/m68k/include/asm/x68k.h b/arch/m68k/include/asm/x68k.h
new file mode 100644
index 000000000000..746df6d481c1
--- /dev/null
+++ b/arch/m68k/include/asm/x68k.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Sharp X68030 hardware definitions
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef _ASM_M68K_X68K_H
+#define _ASM_M68K_X68K_H
+
+/* The 24 bit bus has VRAM, devices and ROM above the RAM, head.S maps them */
+#define X68K_IO_PHYS		0x00c00000
+#define X68K_IO_VIRT		0xf0000000
+#define X68K_IO_SIZE		0x00400000
+
+#define X68K_SCC		0x00e98000
+#define X68K_SCC_B_CTRL		1
+#define X68K_SCC_B_DATA		3
+#define X68K_SCC_A_CTRL		5
+#define X68K_SCC_A_DATA		7
+
+#ifndef __ASSEMBLER__
+
+#include <linux/types.h>
+
+#define X68K_MFP		0x00e88000
+#define X68K_IOC		0x00e9c000
+#define X68K_DMAC		0x00e84000
+
+static inline void __iomem *x68k_io(unsigned long phys)
+{
+	return (void __iomem *)(phys - X68K_IO_PHYS + X68K_IO_VIRT);
+}
+
+/* MC68901 registers are on the odd bytes */
+#define MFP_IERA		3
+#define MFP_IERB		4
+#define MFP_IPRA		5
+#define MFP_IPRB		6
+#define MFP_ISRA		7
+#define MFP_ISRB		8
+#define MFP_IMRA		9
+#define MFP_IMRB		10
+#define MFP_VR			11
+#define MFP_TCDCR		14
+#define MFP_TCDR		17
+
+static inline void __iomem *x68k_mfp(unsigned int reg)
+{
+	return x68k_io(X68K_MFP + 1 + 2 * reg);
+}
+
+/* Devices supply their vector, whose interrupt number follows IRQ_USER */
+#define X68K_VEC_MFP		0x40	/* 16 sources */
+#define X68K_VEC_SCC		0x50
+#define X68K_VEC_IOC		0x60	/* 4 sources */
+#define X68K_VEC_DMAC		0x64	/* normal and error for each of 4 channels */
+#define X68K_VEC_END		0x70
+
+#define X68K_IRQ(vec)		((vec) - 0x40 + IRQ_USER)
+#define IRQ_X68K_MFP(n)		X68K_IRQ(X68K_VEC_MFP + (n))
+#define IRQ_X68K_TIMER		IRQ_X68K_MFP(5)		/* timer C */
+#define IRQ_X68K_SCC		X68K_IRQ(X68K_VEC_SCC)
+
+void x68k_init_IRQ(void);
+void x68k_sched_init(void);
+void x68k_rom_reset(void);
+
+#endif /* !__ASSEMBLER__ */
+
+#endif /* _ASM_M68K_X68K_H */
diff --git a/arch/m68k/include/uapi/asm/bootinfo-x68k.h b/arch/m68k/include/uapi/asm/bootinfo-x68k.h
