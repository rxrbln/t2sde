2.54.0


From 95cbca8e5afc2c6b4d86a422c0f1d2c58f1203c9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 12:53:26 +0100
Subject: [PATCH 27/31] scsi: x68k_spc: Transfer with DMA and wait for
 interrupts
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Programmed I/O kept the CPU busy for the whole command. Run every phase
as a DMA transfer instead, on channel 1 for the internal controller and
channel 2 for the CZ-6BS1 card, and wait for the controller interrupt
at its end. The DMA controller runs in auto request mode, the boards
hold DTACK of the data register until the controller has a byte.

The next phase is predicted, a different one raises a service request.
Scatter-gather lists become one transfer through array chaining, the
pieces above the 16 MB the DMA controller reaches go through a bounce
page. Bytes received before an early phase change are taken from the
FIFO. The interrupt is vector 0x6c for the internal controller and
0xf6 for the card.

In MAME 8 MB written with dd take 11 s instead of 36 s, reads leave the
CPU 68% idle instead of busy and the requests take 23% less time.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/include/asm/x68k.h |   2 +
 arch/m68k/x68k/config.c      |  22 +-
 drivers/scsi/x68k_spc.c      | 418 +++++++++++++++++++++++++++--------
 3 files changed, 339 insertions(+), 103 deletions(-)

diff --git a/arch/m68k/include/asm/x68k.h b/arch/m68k/include/asm/x68k.h
index c324d937a99f..868927cc1641 100644
--- a/arch/m68k/include/asm/x68k.h
+++ b/arch/m68k/include/asm/x68k.h
@@ -60,7 +60,9 @@ static inline void __iomem *x68k_mfp(unsigned int reg)
 #define X68K_VEC_SCC		0x50
 #define X68K_VEC_IOC		0x60	/* 4 sources */
 #define X68K_VEC_DMAC		0x64	/* normal and error for each of 4 channels */
+#define X68K_VEC_SPC		0x6c	/* internal SCSI */
 #define X68K_VEC_MIDI		0x80	/* CZ-6BM1, 0x20 per board */
+#define X68K_VEC_SPC_EXT	0xf6	/* CZ-6BS1 card */
 #define X68K_VEC_END		0x100	/* expansion cards bring their own */
 
 #define X68K_IRQ(vec)		((vec) - 0x40 + IRQ_USER)
diff --git a/arch/m68k/x68k/config.c b/arch/m68k/x68k/config.c
index f4f391e79dc1..b9ac7a928740 100644
--- a/arch/m68k/x68k/config.c
+++ b/arch/m68k/x68k/config.c
@@ -21,6 +21,7 @@
 #include <asm/machdep.h>
 #include <asm/setup.h>
 #include <asm/x68k.h>
+#include <asm/x68kdmac.h>
 
 #define SCC_PCLK	5000000
 
@@ -61,9 +62,16 @@ static struct rp5c01_platform_data x68k_rtc_pdata = {
 static struct resource x68k_rtc_rsrc = DEFINE_RES_MEM(RTC_PHYS, RTC_SIZE);
 
 /* Internal SCSI and the CZ-6BS1 expansion card */
-static struct resource x68k_spc_rsrc[] = {
-	DEFINE_RES_MEM(0x00e96020, 0x20),
-	DEFINE_RES_MEM(0x00ea0000, 0x20),
+static struct resource x68k_spc_rsrc[][3] = {
+	{
+		DEFINE_RES_MEM(0x00e96020, 0x20),
+		DEFINE_RES_IRQ(X68K_IRQ(X68K_VEC_SPC)),
+		DEFINE_RES_DMA(X68K_DMAC_SPC),
+	}, {
+		DEFINE_RES_MEM(0x00ea0000, 0x20),
+		DEFINE_RES_IRQ(X68K_IRQ(X68K_VEC_SPC_EXT)),
+		DEFINE_RES_DMA(X68K_DMAC_EXP),
+	},
 };
 
 /* CZ-6BM1 MIDI cards with board ID 1 and 2 */
@@ -184,6 +192,7 @@ static struct resource scc_b_rsrcs[] = {
 static int __init x68k_platform_init(void)
 {
 	unsigned long scc = (unsigned long)x68k_io(X68K_SCC);
+	unsigned int i;
 
 	if (!MACH_IS_X68K)
 		return -ENODEV;
@@ -205,8 +214,11 @@ static int __init x68k_platform_init(void)
 	platform_device_register_simple("x68kfb", -1, NULL, 0);
 	platform_device_register_simple("x68kgfb", -1, NULL, 0);
 	platform_device_register_simple("x68kkbd", -1, NULL, 0);
-	platform_device_register_simple("x68k_spc", 0, &x68k_spc_rsrc[0], 1);
-	platform_device_register_simple("x68k_spc", 1, &x68k_spc_rsrc[1], 1);
+	/* The internal controller may also need the enable of the former SASI port */
+	x68k_ioc_irq_enable(X68K_IOC_HDD_IEN, true);
+	for (i = 0; i < ARRAY_SIZE(x68k_spc_rsrc); i++)
+		platform_device_register_simple("x68k_spc", i, x68k_spc_rsrc[i],
+						ARRAY_SIZE(x68k_spc_rsrc[i]));
 	platform_device_register_simple("x68kmouse", -1, NULL, 0);
 	platform_device_register_simple("x68kjoy", -1, NULL, 0);
 	platform_device_register_simple("x68k_sram", -1, NULL, 0);
diff --git a/drivers/scsi/x68k_spc.c b/drivers/scsi/x68k_spc.c
index 98da9a574049..18442c04138e 100644
--- a/drivers/scsi/x68k_spc.c
+++ b/drivers/scsi/x68k_spc.c
@@ -1,19 +1,24 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
  * Sharp X68030 internal SCSI and the CZ-6BS1 card, a Fujitsu MB89352 protocol controller
- * each. Commands run one at a time from a worker with programmed I/O, targets may not
- * disconnect.
+ * each. Commands run one at a time from a worker, every phase is a DMA transfer the
+ * controller interrupts at its end. Targets may not disconnect.
  *
  * Copyright (C) 2026 René Rebe <rene@exactco.de>
  */
 
 #include <linux/blkdev.h>
 #include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/iopoll.h>
 #include <linux/highmem.h>
 #include <linux/jiffies.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/scatterlist.h>
+#include <linux/slab.h>
+#include <linux/wait.h>
 #include <linux/workqueue.h>
 
 #include <scsi/scsi.h>
@@ -26,7 +31,7 @@
 #include <asm/hwtest.h>
 #include <asm/io.h>
 #include <asm/x68k.h>
-
+#include <asm/x68kdmac.h>
 #define SPC_BDID	0
 #define SPC_SCTL	1
 #define SPC_SCMD	2
@@ -43,11 +48,11 @@
 #define SPC_TCM		13
 #define SPC_TCL		14
 
+#define SCTL_IE		0x01
 #define SCTL_ARBIT	0x10
 #define SCTL_RESET	0x80
 
 #define SCMD_RST_OUT	0x10
-#define SCMD_PRG_XFER	0x04
 #define SCMD_SELECT	0x20
 #define SCMD_TRANSFER	0x80
 #define SCMD_RESET_ACK	0xc0
@@ -63,8 +68,6 @@
 #define PSNS_PHASE	0x07
 
 #define SSTS_EMPTY	0x01
-#define SSTS_FULL	0x02
-
 #define PCTL_BFIE	0x80
 
 /* I/O, C/D and MSG lines */
@@ -81,14 +84,31 @@
 #define HOST_ID		7
 
 #define CMD_TIMEOUT	(10 * HZ)
+#define BUS_FREE_POLL	(HZ / 100)
+#define SPC_FIFO_SIZE	8
+#define DMAC_ADDR_LIMIT	0x01000000	/* 24 address lines */
+#define MAX_CDB		16
 #define RESET_DELAY_MS	500
 
 struct x68k_spc {
 	struct Scsi_Host *host;
+	struct device *dev;
 	void __iomem *regs;
+	unsigned long dreg_phys;
+	unsigned int dma_ch;
 	struct work_struct work;
 	struct scsi_cmnd *cmd;
 	unsigned long deadline;
+	wait_queue_head_t wq;
+	spinlock_t lock;
+	u8 ints;
+	u8 fifo[SPC_FIFO_SIZE];
+	/* DMA reachable: command, status and message bytes, chain table, bounce page */
+	u8 *xbuf;
+	struct x68k_dmac_block *table;
+	dma_addr_t *maps;
+	unsigned int *lens;
+	void *bounce;
 };
 
 static u8 spc_read(struct x68k_spc *spc, unsigned int reg)
@@ -108,100 +128,219 @@ static void spc_set_tc(struct x68k_spc *spc, u32 count)
 	spc_write(spc, SPC_TCL, count);
 }
 
-static bool spc_timed_out(struct x68k_spc *spc)
+static u32 spc_get_tc(struct x68k_spc *spc)
+{
+	return spc_read(spc, SPC_TCH) << 16 | spc_read(spc, SPC_TCM) << 8 | spc_read(spc, SPC_TCL);
+}
+
+static irqreturn_t spc_interrupt(int irq, void *dev_id)
 {
-	cond_resched();
-	return time_after(jiffies, spc->deadline);
+	struct x68k_spc *spc = dev_id;
+	u8 ints = spc_read(spc, SPC_INTS);
+
+	if (!ints)
+		return IRQ_NONE;
+	spc_write(spc, SPC_INTS, ints);
+	spin_lock(&spc->lock);
+	spc->ints |= ints;
+	spin_unlock(&spc->lock);
+	wake_up(&spc->wq);
+	return IRQ_HANDLED;
+}
+
+/* Waits for one of @mask, returns and consumes all pending sources, 0 on time out */
+static u8 spc_wait(struct x68k_spc *spc, u8 mask, unsigned long timeout)
+{
+	long left = spc->deadline - jiffies;
+	u8 ints;
+
+	if (left > 0)
+		wait_event_timeout(spc->wq, READ_ONCE(spc->ints) & mask,
+				   min_t(long, left, timeout));
+	spin_lock_irq(&spc->lock);
+	ints = spc->ints;
+	if (ints & mask)
+		spc->ints = 0;
+	spin_unlock_irq(&spc->lock);
+	return ints & mask ? ints : 0;
+}
+
+static void spc_clear_ints(struct x68k_spc *spc)
+{
+	spin_lock_irq(&spc->lock);
+	spc->ints = 0;
+	spin_unlock_irq(&spc->lock);
 }
 
 static int spc_select(struct x68k_spc *spc, unsigned int id)
 {
 	u8 ints;
 
+	spc_clear_ints(spc);
 	spc_write(spc, SPC_PCTL, 0);
-	spc_write(spc, SPC_INTS, 0xff);
 	spc_write(spc, SPC_TEMP, BIT(id) | BIT(HOST_ID));
 	spc_set_tc(spc, SELECT_TC);
 	spc_write(spc, SPC_SCMD, SCMD_SELECT);
 
-	while (!((ints = spc_read(spc, SPC_INTS)) & (INTS_COMPLETE | INTS_TIMEOUT | INTS_HARD_ERR))) {
-		if (spc_timed_out(spc))
-			return DID_ERROR;
-	}
-	spc_write(spc, SPC_INTS, ints);
-
+	ints = spc_wait(spc, INTS_COMPLETE | INTS_TIMEOUT | INTS_HARD_ERR, CMD_TIMEOUT);
 	if (ints & INTS_COMPLETE)
 		return DID_OK;
-	return ints & INTS_TIMEOUT ? DID_NO_CONNECT : DID_ERROR;
+	if (ints & INTS_TIMEOUT)
+		return DID_NO_CONNECT;
+	return ints ? DID_ERROR : DID_TIME_OUT;
 }
 
-/* Transfer in the current phase. A phase change ends it early, returns the bytes moved */
-static int spc_xfer(struct x68k_spc *spc, unsigned int phase, u8 *buf, unsigned int len)
+/*
+ * One transfer command in @phase for @len bytes from the blocks in the chain table.
+ * Returns the bytes moved on the bus, received bytes still in the FIFO after a
+ * phase change are in spc->fifo with their count in @fifo.
+ */
+static int spc_dma_xfer(struct x68k_spc *spc, unsigned int phase, unsigned int len,
+			unsigned int blocks, unsigned int *fifo, u8 *ints)
 {
+	size_t tsize = blocks * sizeof(*spc->table);
 	bool in = phase & 1;
-	unsigned int done = 0;
-	u8 ints;
+	dma_addr_t table;
+	unsigned int left;
+	bool busy;
+	int err;
+
+	*fifo = 0;
+	table = dma_map_single(spc->dev, spc->table, tsize, DMA_TO_DEVICE);
+	if (dma_mapping_error(spc->dev, table))
+		return -ENOMEM;
 
 	spc_write(spc, SPC_PCTL, phase | PCTL_BFIE);
 	spc_set_tc(spc, len);
-	spc_write(spc, SPC_INTS, 0xff);
-	spc_write(spc, SPC_SCMD, SCMD_TRANSFER | SCMD_PRG_XFER);
-
-	while (done < len) {
-		u8 ssts = spc_read(spc, SPC_SSTS);
-
-		if (in && !(ssts & SSTS_EMPTY)) {
-			buf[done++] = spc_read(spc, SPC_DREG);
-			continue;
-		}
-		if (!in && !(ssts & SSTS_FULL)) {
-			spc_write(spc, SPC_DREG, buf[done++]);
-			continue;
-		}
-		if (spc_read(spc, SPC_INTS) & (INTS_SERVICE | INTS_DISCONN | INTS_COMPLETE | INTS_HARD_ERR))
-			break;
-		if (spc_timed_out(spc))
-			return -ETIMEDOUT;
+	err = x68k_dmac_start_chain(spc->dma_ch, table, blocks,
+				    (in ? DMAC_OCR_DEV2MEM : 0) | DMAC_OCR_SIZE_BYTE |
+				    DMAC_OCR_REQG_AUTO_MAX, spc->dreg_phys);
+	if (err) {
+		dma_unmap_single(spc->dev, table, tsize, DMA_TO_DEVICE);
+		return err;
 	}
+	spc_write(spc, SPC_SCMD, SCMD_TRANSFER);
+
+	*ints = spc_wait(spc, INTS_COMPLETE | INTS_SERVICE | INTS_DISCONN | INTS_HARD_ERR,
+			 CMD_TIMEOUT);
+	/* After the last byte the controller only has to finish its bus cycle */
+	if (*ints & INTS_COMPLETE)
+		readx_poll_timeout_atomic(x68k_dmac_busy, spc->dma_ch, busy, !busy, 1, 100);
+	x68k_dmac_stop(spc->dma_ch);
+	dma_unmap_single(spc->dev, table, tsize, DMA_TO_DEVICE);
+
+	left = spc_get_tc(spc);
+	while (in && !(*ints & INTS_COMPLETE) && *fifo < SPC_FIFO_SIZE &&
+	       !(spc_read(spc, SPC_SSTS) & SSTS_EMPTY))
+		spc->fifo[(*fifo)++] = spc_read(spc, SPC_DREG);
+
+	if (!*ints)
+		return -ETIMEDOUT;
+	if (*ints & INTS_HARD_ERR)
+		return -EIO;
+	/* Sent bytes left in the FIFO would go out in the next phase, start over */
+	if (!in && !(*ints & INTS_COMPLETE) && !(spc_read(spc, SPC_SSTS) & SSTS_EMPTY))
+		return -EIO;
+	return len - min(left, len);
+}
 
-	while (!((ints = spc_read(spc, SPC_INTS)) & (INTS_COMPLETE | INTS_SERVICE | INTS_DISCONN |
-						     INTS_HARD_ERR))) {
-		if (spc_timed_out(spc))
-			return -ETIMEDOUT;
+/* A transfer of the small DMA buffer, for command, status and message bytes */
+static int spc_xbuf_xfer(struct x68k_spc *spc, unsigned int phase, u8 *buf, unsigned int len,
+			 u8 *ints)
+{
+	enum dma_data_direction dir = phase & 1 ? DMA_FROM_DEVICE : DMA_TO_DEVICE;
+	unsigned int fifo;
+	dma_addr_t addr;
+	int done;
+
+	if (!(phase & 1))
+		memcpy(spc->xbuf, buf, len);
+	addr = dma_map_single(spc->dev, spc->xbuf, len, dir);
+	if (dma_mapping_error(spc->dev, addr))
+		return -ENOMEM;
+	spc->table[0].addr = cpu_to_be32(addr);
+	spc->table[0].len = cpu_to_be16(len);
+	done = spc_dma_xfer(spc, phase, len, 1, &fifo, ints);
+	dma_unmap_single(spc->dev, addr, len, dir);
+	if (done < 0)
+		return done;
+	if (phase & 1) {
+		memcpy(buf, spc->xbuf, done - fifo);
+		memcpy(buf + done - fifo, spc->fifo, fifo);
 	}
-	/* What the target sent before it changed the phase */
-	while (in && done < len && !(spc_read(spc, SPC_SSTS) & SSTS_EMPTY))
-		buf[done++] = spc_read(spc, SPC_DREG);
-
-	spc_write(spc, SPC_INTS, ints & ~INTS_DISCONN);
-	if (ints & INTS_HARD_ERR)
-		return -EIO;
 	return done;
 }
 
-static int spc_xfer_data(struct x68k_spc *spc, struct scsi_cmnd *cmd, unsigned int phase,
-			 unsigned int *residual)
+static bool spc_dma_reachable(struct scatterlist *sg, unsigned int skip, unsigned int len)
 {
-	struct sg_mapping_iter miter;
-	unsigned int flags = (phase & 1 ? SG_MITER_TO_SG : SG_MITER_FROM_SG);
-	int err = 0;
+	return page_to_phys(sg_page(sg)) + sg->offset + skip + len <= DMAC_ADDR_LIMIT;
+}
 
-	sg_miter_start(&miter, scsi_sglist(cmd), scsi_sg_count(cmd), flags);
-	while (*residual && sg_miter_next(&miter)) {
-		unsigned int n = min_t(unsigned int, miter.length, *residual);
-		int done = spc_xfer(spc, phase, miter.addr, n);
+/*
+ * Moves data from @off on in one transfer command: a run of DMA reachable pieces of
+ * the scatterlist, or one other piece through the bounce page.
+ */
+static int spc_xfer_data(struct x68k_spc *spc, struct scsi_cmnd *cmd, unsigned int phase,
+			 unsigned int off, unsigned int resid, u8 *ints)
+{
+	enum dma_data_direction dir = phase & 1 ? DMA_FROM_DEVICE : DMA_TO_DEVICE;
+	struct scatterlist *sgl = scsi_sglist(cmd), *sg;
+	unsigned int nents = scsi_sg_count(cmd), blocks = 0, len = 0, skip = off, fifo, i;
+	int done;
 
-		if (done < 0) {
-			err = done;
+	for_each_sg(sgl, sg, nents, i) {
+		if (skip < sg->length)
 			break;
+		skip -= sg->length;
+	}
+	if (!sg)
+		return -EINVAL;
+
+	if (!spc_dma_reachable(sg, skip, min(sg->length - skip, resid))) {
+		unsigned int n = min3(sg->length - skip, resid, (unsigned int)PAGE_SIZE);
+		dma_addr_t addr;
+
+		if (!(phase & 1))
+			sg_pcopy_to_buffer(sgl, nents, spc->bounce, n, off);
+		addr = dma_map_single(spc->dev, spc->bounce, n, dir);
+		if (dma_mapping_error(spc->dev, addr))
+			return -ENOMEM;
+		spc->table[0].addr = cpu_to_be32(addr);
+		spc->table[0].len = cpu_to_be16(n);
+		done = spc_dma_xfer(spc, phase, n, 1, &fifo, ints);
+		dma_unmap_single(spc->dev, addr, n, dir);
+		if (done > 0 && (phase & 1)) {
+			memcpy(spc->bounce + done - fifo, spc->fifo, fifo);
+			sg_pcopy_from_buffer(sgl, nents, spc->bounce, done, off);
 		}
-		miter.consumed = done;
-		*residual -= done;
-		if (done < n)
+		return done;
+	}
+
+	for (; sg && len < resid && blocks < spc->host->sg_tablesize; sg = sg_next(sg), skip = 0) {
+		unsigned int n = min(sg->length - skip, resid - len);
+		dma_addr_t addr;
+
+		if (!spc_dma_reachable(sg, skip, n))
+			break;
+		addr = dma_map_page(spc->dev, sg_page(sg), sg->offset + skip, n, dir);
+		if (dma_mapping_error(spc->dev, addr))
 			break;
+		spc->maps[blocks] = addr;
+		spc->lens[blocks] = n;
+		spc->table[blocks].addr = cpu_to_be32(addr);
+		spc->table[blocks].len = cpu_to_be16(n);
+		blocks++;
+		len += n;
 	}
-	sg_miter_stop(&miter);
-	return err;
+	if (!blocks)
+		return -ENOMEM;
+
+	done = spc_dma_xfer(spc, phase, len, blocks, &fifo, ints);
+	for (i = 0; i < blocks; i++)
+		dma_unmap_page(spc->dev, spc->maps[i], spc->lens[i], dir);
+	if (done > 0 && fifo)
+		sg_pcopy_from_buffer(sgl, nents, spc->fifo, fifo, off + done - fifo);
+	return done;
 }
 
 static void spc_reset_bus(struct x68k_spc *spc)
@@ -211,10 +350,12 @@ static void spc_reset_bus(struct x68k_spc *spc)
 	spc_write(spc, SPC_SCMD, 0);
 	msleep(RESET_DELAY_MS);
 	spc_write(spc, SPC_INTS, 0xff);
+	spc_clear_ints(spc);
 }
 
 static void spc_init(struct x68k_spc *spc)
 {
+	x68k_dmac_stop(spc->dma_ch);
 	spc_write(spc, SPC_SCTL, SCTL_RESET);
 	spc_write(spc, SPC_BDID, HOST_ID);
 	spc_write(spc, SPC_SCMD, 0);
@@ -222,65 +363,108 @@ static void spc_init(struct x68k_spc *spc)
 	spc_write(spc, SPC_PCTL, 0);
 	spc_write(spc, SPC_SDGC, 0);
 	spc_set_tc(spc, 0);
-	spc_write(spc, SPC_SCTL, SCTL_ARBIT);
 	spc_write(spc, SPC_INTS, 0xff);
+	spc_write(spc, SPC_SCTL, SCTL_ARBIT | SCTL_IE);
+}
+
+/* Next phase if the target follows the usual order, a different one raises a service request */
+static unsigned int spc_next_phase(struct scsi_cmnd *cmd, unsigned int phase, unsigned int resid)
+{
+	switch (phase) {
+	case PHASE_COMMAND:
+	case PHASE_DATA_IN:
+	case PHASE_DATA_OUT:
+		if (!resid)
+			return PHASE_STATUS;
+		return cmd->sc_data_direction == DMA_FROM_DEVICE ? PHASE_DATA_IN : PHASE_DATA_OUT;
+	case PHASE_STATUS:
+		return PHASE_MSG_IN;
+	default:
+		return PHASE_COMMAND;
+	}
+}
+
+/* After the last message the target leaves the bus, or asks for another phase */
+static int spc_wait_bus_free(struct x68k_spc *spc, unsigned int *phase)
+{
+	for (;;) {
+		u8 ints = spc_wait(spc, INTS_DISCONN, BUS_FREE_POLL);
+		u8 psns;
+
+		if (ints & INTS_DISCONN)
+			return 1;
+		psns = spc_read(spc, SPC_PSNS);
+		if (psns & PSNS_REQ) {
+			*phase = psns & PSNS_PHASE;
+			return 0;
+		}
+		if (time_after(jiffies, spc->deadline))
+			return -ETIMEDOUT;
+	}
 }
 
 static int spc_run(struct x68k_spc *spc, struct scsi_cmnd *cmd)
 {
-	unsigned int residual = scsi_bufflen(cmd);
-	u8 status = SAM_STAT_CHECK_CONDITION, msg = 0, nop = MSG_NOP;
+	unsigned int resid = scsi_bufflen(cmd), off = 0, phase = PHASE_COMMAND;
+	u8 status = SAM_STAT_CHECK_CONDITION, msg = 0, nop = MSG_NOP, ints;
 	int host;
 
 	spc->deadline = jiffies + CMD_TIMEOUT;
-	scsi_set_resid(cmd, residual);
+	scsi_set_resid(cmd, resid);
 
 	host = spc_select(spc, cmd->device->id);
 	if (host != DID_OK)
 		return host << 16;
 
 	for (;;) {
-		u8 psns = spc_read(spc, SPC_PSNS);
-		u8 ints = spc_read(spc, SPC_INTS);
-		int done = 0;
-
-		if (ints & INTS_DISCONN) {
-			spc_write(spc, SPC_INTS, ints);
-			scsi_set_resid(cmd, residual);
-			return status;
-		}
-		if (!(psns & PSNS_REQ)) {
-			if (spc_timed_out(spc))
-				return DID_TIME_OUT << 16;
-			continue;
-		}
+		int done;
 
-		switch (psns & PSNS_PHASE) {
+		ints = 0;
+		switch (phase) {
 		case PHASE_COMMAND:
-			done = spc_xfer(spc, PHASE_COMMAND, cmd->cmnd, cmd->cmd_len);
+			done = spc_xbuf_xfer(spc, phase, cmd->cmnd, cmd->cmd_len, &ints);
 			break;
 		case PHASE_DATA_IN:
 		case PHASE_DATA_OUT:
-			if (!residual)
+			if (!resid || (phase == PHASE_DATA_IN) !=
+			    (cmd->sc_data_direction == DMA_FROM_DEVICE))
 				return DID_ERROR << 16;
-			done = spc_xfer_data(spc, cmd, psns & PSNS_PHASE, &residual);
+			done = spc_xfer_data(spc, cmd, phase, off, resid, &ints);
+			if (done > 0) {
+				off += done;
+				resid -= done;
+				scsi_set_resid(cmd, resid);
+			}
 			break;
 		case PHASE_STATUS:
-			done = spc_xfer(spc, PHASE_STATUS, &status, 1);
+			done = spc_xbuf_xfer(spc, phase, &status, 1, &ints);
 			break;
 		case PHASE_MSG_IN:
-			done = spc_xfer(spc, PHASE_MSG_IN, &msg, 1);
+			done = spc_xbuf_xfer(spc, phase, &msg, 1, &ints);
 			/* The chip holds ACK on the last message byte until told */
 			spc_write(spc, SPC_SCMD, SCMD_RESET_ACK);
+			if (done >= 0 && !(ints & (INTS_SERVICE | INTS_DISCONN))) {
+				done = spc_wait_bus_free(spc, &phase);
+				if (done > 0)
+					return status;
+				if (!done)
+					continue;
+			}
 			break;
 		case PHASE_MSG_OUT:
-			done = spc_xfer(spc, PHASE_MSG_OUT, &nop, 1);
+			done = spc_xbuf_xfer(spc, phase, &nop, 1, &ints);
 			break;
 		default:
 			return DID_ERROR << 16;
 		}
 		if (done < 0)
 			return (done == -ETIMEDOUT ? DID_TIME_OUT : DID_ERROR) << 16;
+		if (ints & INTS_DISCONN)
+			return status;
+		if (ints & INTS_SERVICE)
+			phase = spc_read(spc, SPC_PSNS) & PSNS_PHASE;
+		else
+			phase = spc_next_phase(cmd, phase, resid);
 	}
 }
 
@@ -338,12 +522,16 @@ static const struct scsi_host_template spc_template = {
 static int spc_probe(struct platform_device *pdev)
 {
 	struct resource *res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	struct resource *dma = platform_get_resource(pdev, IORESOURCE_DMA, 0);
+	struct device *dev = &pdev->dev;
 	void __iomem *bdid;
 	struct Scsi_Host *host;
 	struct x68k_spc *spc;
-	int err;
+	unsigned int n;
+	int irq, err;
 
-	if (!res)
+	irq = platform_get_irq(pdev, 0);
+	if (!res || !dma || irq < 0)
 		return -ENODEV;
 	/* An empty slot may not raise a bus error, the ID register reads back as a bit */
 	bdid = x68k_io(res->start) + 2 * SPC_BDID + 1;
@@ -359,22 +547,44 @@ static int spc_probe(struct platform_device *pdev)
 
 	spc = shost_priv(host);
 	spc->host = host;
+	spc->dev = dev;
 	spc->regs = x68k_io(res->start);
+	spc->dreg_phys = res->start + 2 * SPC_DREG + 1;
+	spc->dma_ch = dma->start;
 	INIT_WORK(&spc->work, spc_work);
+	init_waitqueue_head(&spc->wq);
+	spin_lock_init(&spc->lock);
 	host->max_id = 8;
 	host->max_lun = 1;
 	platform_set_drvdata(pdev, host);
 
+	/* The DMA controller only reaches the low 16 MB */
+	n = host->sg_tablesize;
+	err = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(24));
+	spc->xbuf = devm_kmalloc(dev, MAX_CDB, GFP_KERNEL | GFP_DMA);
+	spc->table = devm_kmalloc_array(dev, n, sizeof(*spc->table), GFP_KERNEL | GFP_DMA);
+	spc->maps = devm_kmalloc_array(dev, n, sizeof(*spc->maps), GFP_KERNEL);
+	spc->lens = devm_kmalloc_array(dev, n, sizeof(*spc->lens), GFP_KERNEL);
+	spc->bounce = (void *)devm_get_free_pages(dev, GFP_KERNEL | GFP_DMA, 0);
+	if (err || !spc->xbuf || !spc->table || !spc->maps || !spc->lens || !spc->bounce) {
+		err = err ?: -ENOMEM;
+		goto put;
+	}
+
 	spc_init(spc);
+	err = devm_request_irq(dev, irq, spc_interrupt, 0, dev_name(dev), spc);
+	if (err)
+		goto put;
 	spc_reset_bus(spc);
 
-	err = scsi_add_host(host, &pdev->dev);
-	if (err) {
-		scsi_host_put(host);
-		return err;
-	}
+	err = scsi_add_host(host, dev);
+	if (err)
+		goto put;
 	scsi_scan_host(host);
 	return 0;
+put:
+	scsi_host_put(host);
+	return err;
 }
 
 static void spc_remove(struct platform_device *pdev)
@@ -384,12 +594,24 @@ static void spc_remove(struct platform_device *pdev)
 
 	scsi_remove_host(host);
 	cancel_work_sync(&spc->work);
+	spc_write(spc, SPC_SCTL, SCTL_RESET);
+	x68k_dmac_stop(spc->dma_ch);
 	scsi_host_put(host);
 }
 
+/* The ROM does not expect the controller active after a reboot */
+static void spc_shutdown(struct platform_device *pdev)
+{
+	struct Scsi_Host *host = platform_get_drvdata(pdev);
+	struct x68k_spc *spc = shost_priv(host);
+
+	spc_write(spc, SPC_SCTL, SCTL_RESET);
+	x68k_dmac_stop(spc->dma_ch);
+}
 static struct platform_driver spc_driver = {
 	.probe	= spc_probe,
 	.remove	= spc_remove,
+	.shutdown = spc_shutdown,
 	.driver	= {
 		.name = "x68k_spc",
 	},
-- 
2.54.0


From df4101d3b7c433ee8f34bfe4fa9825cc91c55e12 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 13:04:35 +0100
Subject: [PATCH 28/31] fbdev: x68kfb: Scroll by moving the text start, copy
 glyphs by bytes
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The text scroll register wraps around the 1024 lines of a text plane,
offer them as the virtual screen for y wrap panning. fbcon only uses
it with the legacy acceleration and fast reads, which text VRAM has.
Glyphs on byte boundaries are copied by bytes instead of the generic
code going by pixels.

In MAME 1000 lines on the console take 12.8 s instead of 75.5 s, of
which 8 s are spent in the tty and VT layers.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/x68k_defconfig |  1 +
 drivers/video/fbdev/x68kfb.c     | 57 +++++++++++++++++++++++++++++---
 2 files changed, 54 insertions(+), 4 deletions(-)

diff --git a/arch/m68k/configs/x68k_defconfig b/arch/m68k/configs/x68k_defconfig
index 2cf13dcdf0b5..8c8903140f4b 100644
--- a/arch/m68k/configs/x68k_defconfig
+++ b/arch/m68k/configs/x68k_defconfig
@@ -57,6 +57,7 @@ CONFIG_FB=y
 CONFIG_FB_X68K=y
 CONFIG_FB_X68K_GRAPHICS=y
 CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_FRAMEBUFFER_CONSOLE_LEGACY_ACCELERATION=y
 CONFIG_FONT_SUPPORT=y
 CONFIG_FONTS=y
 CONFIG_FONT_8x16=y
diff --git a/drivers/video/fbdev/x68kfb.c b/drivers/video/fbdev/x68kfb.c
index cd4c0d4b64d8..fb9d566254d6 100644
--- a/drivers/video/fbdev/x68kfb.c
+++ b/drivers/video/fbdev/x68kfb.c
@@ -1,7 +1,8 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
  * Sharp X68030 text screen as a monochrome framebuffer, in the mode the ROM set up.
- * Of the four separately addressed planes of 1024x1024 pixels, one is used.
+ * Of the four separately addressed planes of 1024x1024 pixels, one is used. The text
+ * scroll register wraps around the plane, the console scrolls by moving it.
  *
  * Copyright (C) 2026 René Rebe <rene@exactco.de>
  */
@@ -20,7 +21,7 @@
 #define TVRAM_PLANES	4
 #define TVRAM_PLANE	0x00020000
 #define TVRAM_PITCH	128
-
+#define TVRAM_LINES	1024
 #define CRTC_R10	0x00e80014	/* text scroll, x */
 #define CRTC_R11	0x00e80016	/* and y */
 #define CRTC_R21	0x00e8002a	/* simultaneous plane access and masking */
@@ -44,9 +45,53 @@ static const struct backlight_ops x68kfb_bl_ops = {
 	.update_status	= x68kfb_bl_update,
 };
 
+static int x68kfb_check_var(struct fb_var_screeninfo *var, struct fb_info *info)
+{
+	if (var->xres != X68KFB_WIDTH || var->yres != X68KFB_HEIGHT ||
+	    var->xres_virtual != X68KFB_WIDTH || var->yres_virtual != TVRAM_LINES ||
+	    var->bits_per_pixel != 1 || var->xoffset || var->yoffset >= TVRAM_LINES)
+		return -EINVAL;
+	return 0;
+}
+
+static int x68kfb_pan_display(struct fb_var_screeninfo *var, struct fb_info *info)
+{
+	out_be16(x68k_io(CRTC_R11), var->yoffset);
+	return 0;
+}
+
+/* Glyphs on byte boundaries are copied by bytes, the generic code goes by pixels */
+static void x68kfb_imageblit(struct fb_info *info, const struct fb_image *image)
+{
+	unsigned int w = image->width / 8, x, y;
+	u8 fg = image->fg_color & 1 ? 0xff : 0, bg = image->bg_color & 1 ? 0xff : 0;
+	const u8 *src = image->data;
+	u8 __iomem *dst;
+
+	if (image->depth != 1 || (image->dx | image->width) & 7) {
+		cfb_imageblit(info, image);
+		return;
+	}
+	dst = info->screen_base + image->dy * TVRAM_PITCH + image->dx / 8;
+	for (y = 0; y < image->height; y++, dst += TVRAM_PITCH, src += w) {
+		if (fg == 0xff && !bg) {
+			memcpy_toio(dst, src, w);
+			continue;
+		}
+		for (x = 0; x < w; x++)
+			__raw_writeb((src[x] & fg) | (~src[x] & bg), dst + x);
+	}
+}
+
 static const struct fb_ops x68kfb_ops = {
 	.owner		= THIS_MODULE,
-	FB_DEFAULT_IOMEM_OPS,
+	__FB_DEFAULT_IOMEM_OPS_RDWR,
+	.fb_fillrect	= cfb_fillrect,
+	.fb_copyarea	= cfb_copyarea,
+	.fb_imageblit	= x68kfb_imageblit,
+	__FB_DEFAULT_IOMEM_OPS_MMAP,
+	.fb_check_var	= x68kfb_check_var,
+	.fb_pan_display	= x68kfb_pan_display,
 };
 
 static int x68kfb_probe(struct platform_device *pdev)
@@ -66,9 +111,12 @@ static int x68kfb_probe(struct platform_device *pdev)
 	info->fix.visual = FB_VISUAL_MONO10;
 	info->fix.line_length = TVRAM_PITCH;
 	info->fix.accel = FB_ACCEL_NONE;
+	info->fix.ypanstep = 1;
+	info->fix.ywrapstep = 1;
 
 	info->var.xres = info->var.xres_virtual = X68KFB_WIDTH;
-	info->var.yres = info->var.yres_virtual = X68KFB_HEIGHT;
+	info->var.yres = X68KFB_HEIGHT;
+	info->var.yres_virtual = TVRAM_LINES;
 	info->var.bits_per_pixel = 1;
 	info->var.red.length = info->var.green.length = info->var.blue.length = 1;
 	info->var.activate = FB_ACTIVATE_NOW;
@@ -76,6 +124,7 @@ static int x68kfb_probe(struct platform_device *pdev)
 	info->var.height = info->var.width = -1;
 
 	info->fbops = &x68kfb_ops;
+	info->flags = FBINFO_HWACCEL_YPAN | FBINFO_HWACCEL_YWRAP | FBINFO_READS_FAST;
 	info->screen_base = x68k_io(TVRAM_PHYS);
 	info->screen_size = TVRAM_PLANE;
 
-- 
2.54.0


From c4ec5704186c915eac5f13d6f847f6d888d067c4 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 15:23:18 +0100
Subject: [PATCH 29/31] Input: misc: Add Sharp X68000 series power switch
 driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The front panel power switch of the X68000 series is a request to the
operating system: MFP GPIP2 goes high while the switch is off, and the
system powers itself off when done.  Report turning it off as KEY_POWER,
the interrupt edge follows the level so that turning it on again only
re-arms it.

Tested in MAME with the switch modelled on GPIP2.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/x68k_defconfig |  2 +
 arch/m68k/include/asm/x68k.h     |  3 ++
 arch/m68k/x68k/config.c          |  1 +
 drivers/input/misc/Kconfig       |  7 +++
 drivers/input/misc/Makefile      |  1 +
 drivers/input/misc/x68k_power.c  | 77 ++++++++++++++++++++++++++++++++
 6 files changed, 91 insertions(+)
 create mode 100644 drivers/input/misc/x68k_power.c

diff --git a/arch/m68k/configs/x68k_defconfig b/arch/m68k/configs/x68k_defconfig
index 8c8903140f4b..da36341eced2 100644
--- a/arch/m68k/configs/x68k_defconfig
+++ b/arch/m68k/configs/x68k_defconfig
@@ -50,6 +50,8 @@ CONFIG_INPUT_MOUSE=y
 CONFIG_MOUSE_X68K=y
 CONFIG_INPUT_JOYSTICK=y
 CONFIG_JOYSTICK_X68K=y
+CONFIG_INPUT_MISC=y
+CONFIG_INPUT_X68K_POWER=y
 CONFIG_INPUT_MOUSEDEV=y
 CONFIG_VT=y
 CONFIG_VT_CONSOLE=y
diff --git a/arch/m68k/include/asm/x68k.h b/arch/m68k/include/asm/x68k.h
index 868927cc1641..a20193b4e803 100644
--- a/arch/m68k/include/asm/x68k.h
+++ b/arch/m68k/include/asm/x68k.h
@@ -38,6 +38,8 @@ static inline void __iomem *x68k_io(unsigned long phys)
 }
 
 /* MC68901 registers are on the odd bytes */
+#define MFP_GPDR		0
+#define MFP_AER			1
 #define MFP_IERA		3
 #define MFP_IERB		4
 #define MFP_IPRA		5
@@ -67,6 +69,7 @@ static inline void __iomem *x68k_mfp(unsigned int reg)
 
 #define X68K_IRQ(vec)		((vec) - 0x40 + IRQ_USER)
 #define IRQ_X68K_MFP(n)		X68K_IRQ(X68K_VEC_MFP + (n))
+#define MFP_INT_POWER		2			/* GPIP2, power switch */
 #define IRQ_X68K_TIMER		IRQ_X68K_MFP(5)		/* timer C */
 #define IRQ_X68K_SCC		X68K_IRQ(X68K_VEC_SCC)
 
diff --git a/arch/m68k/x68k/config.c b/arch/m68k/x68k/config.c
index b9ac7a928740..16052294e289 100644
--- a/arch/m68k/x68k/config.c
+++ b/arch/m68k/x68k/config.c
@@ -221,6 +221,7 @@ static int __init x68k_platform_init(void)
 						ARRAY_SIZE(x68k_spc_rsrc[i]));
 	platform_device_register_simple("x68kmouse", -1, NULL, 0);
 	platform_device_register_simple("x68kjoy", -1, NULL, 0);
+	platform_device_register_simple("x68k_power", -1, NULL, 0);
 	platform_device_register_simple("x68k_sram", -1, NULL, 0);
 	platform_device_register_simple("x68k-snd", -1, NULL, 0);
 	platform_device_register_simple("x68k-midi", 0, &x68k_midi_rsrc[0], 1);
diff --git a/drivers/input/misc/Kconfig b/drivers/input/misc/Kconfig
index 169768e3d5bb..64ae351a8555 100644
--- a/drivers/input/misc/Kconfig
+++ b/drivers/input/misc/Kconfig
@@ -590,6 +590,13 @@ config INPUT_TWL6040_VIBRA
 	  To compile this driver as a module, choose M here. The module will
 	  be called twl6040_vibra.
 
+config INPUT_X68K_POWER
+	bool "Sharp X68000 series power switch"
+	depends on X68K
+	help
+	  Say Y here to report the front panel power switch of the Sharp
+	  X68000 series as a power key.
+
 config INPUT_UINPUT
 	tristate "User level driver support"
 	help
diff --git a/drivers/input/misc/Makefile b/drivers/input/misc/Makefile
index 1339619f0769..46160240ae02 100644
--- a/drivers/input/misc/Makefile
+++ b/drivers/input/misc/Makefile
@@ -92,6 +92,7 @@ obj-$(CONFIG_INPUT_TWL4030_PWRBUTTON)	+= twl4030-pwrbutton.o
 obj-$(CONFIG_INPUT_TWL4030_VIBRA)	+= twl4030-vibra.o
 obj-$(CONFIG_INPUT_TWL6040_VIBRA)	+= twl6040-vibra.o
 obj-$(CONFIG_INPUT_UINPUT)		+= uinput.o
+obj-$(CONFIG_INPUT_X68K_POWER)		+= x68k_power.o
 obj-$(CONFIG_INPUT_WISTRON_BTNS)	+= wistron_btns.o
 obj-$(CONFIG_INPUT_WM831X_ON)		+= wm831x-on.o
 obj-$(CONFIG_INPUT_XEN_KBDDEV_FRONTEND)	+= xen-kbdfront.o
diff --git a/drivers/input/misc/x68k_power.c b/drivers/input/misc/x68k_power.c
new file mode 100644
index 000000000000..c895ac4891ab
--- /dev/null
+++ b/drivers/input/misc/x68k_power.c
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp X68000 series front panel power switch on MFP GPIP2, as KEY_POWER
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include <asm/io.h>
+#include <asm/x68k.h>
+
+#define GPIP_POWER	0x04	/* high while the switch is off */
+
+/* Interrupt on the next change, the edge follows the level */
+static bool x68k_power_arm(void)
+{
+	unsigned long flags;
+	bool off;
+	u8 aer;
+
+	local_irq_save(flags);
+	off = in_8(x68k_mfp(MFP_GPDR)) & GPIP_POWER;
+	aer = in_8(x68k_mfp(MFP_AER));
+	out_8(x68k_mfp(MFP_AER), off ? aer & ~GPIP_POWER : aer | GPIP_POWER);
+	local_irq_restore(flags);
+	return off;
+}
+
+static irqreturn_t x68k_power_interrupt(int irq, void *dev_id)
+{
+	struct input_dev *input = dev_id;
+
+	if (x68k_power_arm()) {
+		input_report_key(input, KEY_POWER, 1);
+		input_sync(input);
+		input_report_key(input, KEY_POWER, 0);
+		input_sync(input);
+	}
+	return IRQ_HANDLED;
+}
+
+static int x68k_power_probe(struct platform_device *pdev)
+{
+	struct input_dev *input;
+	int err;
+
+	input = devm_input_allocate_device(&pdev->dev);
+	if (!input)
+		return -ENOMEM;
+	input->name = "X68000 Power Switch";
+	input->phys = "x68k_power/input0";
+	input->id.bustype = BUS_HOST;
+	input_set_capability(input, EV_KEY, KEY_POWER);
+	err = input_register_device(input);
+	if (err)
+		return err;
+
+	x68k_power_arm();
+	return devm_request_irq(&pdev->dev, IRQ_X68K_MFP(MFP_INT_POWER), x68k_power_interrupt, 0,
+				"x68k-power", input);
+}
+
+static struct platform_driver x68k_power_driver = {
+	.probe	= x68k_power_probe,
+	.driver	= {
+		.name = "x68k_power",
+	},
+};
+builtin_platform_driver(x68k_power_driver);
+
+MODULE_DESCRIPTION("Sharp X68000 power switch driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From b1b0e0398b1f202699af1f4e164262a47b941233 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 15:23:30 +0100
Subject: [PATCH 30/31] ALSA: x68k: Record through the MSM6258
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The MSM6258 also encodes its analog input to ADPCM, DMA channel 3 moves
the bytes to memory at the sample rate.  Add a capture stream that runs
the same ring of three DMA blocks as playback in the other direction and
decodes each finished block into the ALSA buffer.  The codec plays or
records, so the PCM is half duplex.

Recorded bytes carry the first sample in the upper nibble, as XM6 models
it, the opposite of playback.

Tested in MAME with its MSM6258 extended to record a microphone input fed
from a 1 kHz WAV file.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 sound/m68k/Kconfig    |  6 +--
 sound/m68k/x68k_snd.c | 86 +++++++++++++++++++++++++++++++++++++------
 2 files changed, 78 insertions(+), 14 deletions(-)

diff --git a/sound/m68k/Kconfig b/sound/m68k/Kconfig
index f10333c98ee1..b6c0c238f988 100644
--- a/sound/m68k/Kconfig
+++ b/sound/m68k/Kconfig
@@ -27,9 +27,9 @@ config SND_X68K
 	select SND_PCM
 	select SND_HWDEP
 	help
-	  Say Y here for 16 bit PCM playback through the MSM6258 ADPCM
-	  decoder of the Sharp X68030, and register access to its YM2151 FM
-	  synthesizer.
+	  Say Y here for 16 bit PCM playback and recording through the
+	  MSM6258 ADPCM codec of the Sharp X68030, and register access to its
+	  YM2151 FM synthesizer.
 
 	  To compile this driver as a module, choose M here: the module
 	  will be called snd-x68k.
diff --git a/sound/m68k/x68k_snd.c b/sound/m68k/x68k_snd.c
index 7ee76459a325..1a6a9cd7bc2a 100644
--- a/sound/m68k/x68k_snd.c
+++ b/sound/m68k/x68k_snd.c
@@ -1,7 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * Sharp X68030 sound: 16 bit PCM played through the OKI MSM6258 ADPCM decoder fed
- * by DMA channel 3, and register access to the YM2151 FM synthesizer.
+ * Sharp X68030 sound: 16 bit PCM played and recorded through the OKI MSM6258 ADPCM
+ * codec on DMA channel 3, and register access to the YM2151 FM synthesizer.
  *
  * Copyright (C) 2026 René Rebe <rene@exactco.de>
  */
@@ -29,6 +29,7 @@
 #define ADPCM_DATA		0x00e92003
 #define ADPCM_STOP		0x01
 #define ADPCM_PLAY		0x02
+#define ADPCM_REC		0x04
 
 /* Rate and output select are on port C of the 8255, set bit by bit */
 #define PPI_CTRL		0x00e9a007
@@ -52,7 +53,7 @@
 #define DMAC_VEC_NORMAL		(X68K_VEC_DMAC + 2 * X68K_DMAC_ADPCM)
 #define DMAC_VEC_ERROR		(DMAC_VEC_NORMAL + 1)
 
-#define ADPCM_SLOTS		3	/* playing, queued, being encoded */
+#define ADPCM_SLOTS		3	/* transferring, queued, being encoded or decoded */
 #define MAX_PERIOD_BYTES	8192
 #define MAX_BUFFER_BYTES	(64 * 1024)
 
@@ -76,10 +77,12 @@ static const s8 oki_index_shift[8] = { -1, -1, -1, -1, 2, 4, 6, 8 };
 struct x68k_snd {
 	struct snd_card *card;
 	struct snd_pcm_substream *substream;
+	struct snd_pcm_substream *open;	/* the codec plays or records */
 	spinlock_t lock;
 	u8 *adpcm;			/* ADPCM_SLOTS periods for the DMA */
 	unsigned int period_bytes;	/* of ADPCM, half the frames */
 	unsigned int next_encode;	/* period of the ALSA buffer */
+	bool capture;
 	snd_pcm_uframes_t pending;	/* consumed since ALSA last saw the pointer */
 	unsigned int slot;
 	int signal;
@@ -156,6 +159,40 @@ static void x68k_encode_period(struct x68k_snd *chip, unsigned int slot)
 	}
 }
 
+static s16 oki_decode_sample(struct x68k_snd *chip, u8 nibble)
+{
+	int step = oki_steps[chip->step];
+	int delta = step >> 3;
+
+	if (nibble & 4)
+		delta += step;
+	if (nibble & 2)
+		delta += step >> 1;
+	if (nibble & 1)
+		delta += step >> 2;
+	chip->signal += nibble & 8 ? -delta : delta;
+	chip->signal = clamp(chip->signal, -2048, 2047);
+	chip->step = clamp(chip->step + oki_index_shift[nibble & 7], 0, 48);
+	return chip->signal << 4;
+}
+
+/* Recorded bytes hold the first sample in the upper nibble, as in XM6 */
+static void x68k_decode_period(struct x68k_snd *chip, unsigned int slot)
+{
+	struct snd_pcm_runtime *runtime = chip->substream->runtime;
+	u8 *in = chip->adpcm + slot * chip->period_bytes;
+	s16 *pcm = (s16 *)(runtime->dma_area +
+			   frames_to_bytes(runtime, chip->next_encode * runtime->period_size));
+	unsigned int i;
+
+	cache_clear(virt_to_phys(in), chip->period_bytes);
+	for (i = 0; i < chip->period_bytes; i++) {
+		pcm[2 * i] = oki_decode_sample(chip, in[i] >> 4);
+		pcm[2 * i + 1] = oki_decode_sample(chip, in[i] & 0x0f);
+	}
+	chip->next_encode = (chip->next_encode + 1) % runtime->periods;
+}
+
 static void x68k_queue_slot(struct x68k_snd *chip, unsigned int slot)
 {
 	out_be32(x68k_io(DMAC_CH3 + DMAC_BAR), virt_to_phys(chip->adpcm + slot * chip->period_bytes));
@@ -175,12 +212,17 @@ static irqreturn_t x68k_snd_interrupt(int irq, void *dev_id)
 	spin_lock(&chip->lock);
 	substream = chip->substream;
 	if (substream && !(csr & CSR_ERROR)) {
+		unsigned int done = (chip->slot + ADPCM_SLOTS - 1) % ADPCM_SLOTS;
+
 		/* The queued block runs now, the next one goes behind it */
 		chip->slot = (chip->slot + 1) % ADPCM_SLOTS;
-		x68k_encode_period(chip, chip->slot);
+		if (!chip->capture)
+			x68k_encode_period(chip, chip->slot);
 		x68k_queue_slot(chip, chip->slot);
 		/* The start bit would restart the channel, only arm the next block */
 		out_8(x68k_io(DMAC_CH3 + DMAC_CCR), CCR_CONTINUE | CCR_INT);
+		if (chip->capture)
+			x68k_decode_period(chip, done);
 	}
 	spin_unlock(&chip->lock);
 
@@ -211,8 +253,18 @@ static const struct snd_pcm_hardware x68k_snd_hw = {
 
 static int x68k_snd_open(struct snd_pcm_substream *substream)
 {
+	struct x68k_snd *chip = snd_pcm_substream_chip(substream);
 	struct snd_pcm_runtime *runtime = substream->runtime;
-	int err;
+	int err = 0;
+
+	spin_lock_irq(&chip->lock);
+	if (chip->open)
+		err = -EBUSY;
+	else
+		chip->open = substream;
+	spin_unlock_irq(&chip->lock);
+	if (err)
+		return err;
 
 	runtime->hw = x68k_snd_hw;
 	err = snd_pcm_hw_constraint_list(runtime, 0, SNDRV_PCM_HW_PARAM_RATE, &x68k_rate_list);
@@ -227,6 +279,11 @@ static int x68k_snd_open(struct snd_pcm_substream *substream)
 
 static int x68k_snd_close(struct snd_pcm_substream *substream)
 {
+	struct x68k_snd *chip = snd_pcm_substream_chip(substream);
+
+	spin_lock_irq(&chip->lock);
+	chip->open = NULL;
+	spin_unlock_irq(&chip->lock);
 	return 0;
 }
 
@@ -259,21 +316,25 @@ static int x68k_snd_trigger(struct snd_pcm_substream *substream, int cmd)
 	case SNDRV_PCM_TRIGGER_START:
 		spin_lock(&chip->lock);
 		chip->substream = substream;
+		chip->capture = substream->stream == SNDRV_PCM_STREAM_CAPTURE;
 		chip->next_encode = 0;
 		chip->pending = 0;
 		chip->slot = 1;
-		/* The decoder starts from this state at play */
+		/* The codec starts from this state at play and record */
 		chip->signal = -2;
 		chip->step = 0;
-		x68k_encode_period(chip, 0);
-		x68k_encode_period(chip, 1);
+		if (!chip->capture) {
+			x68k_encode_period(chip, 0);
+			x68k_encode_period(chip, 1);
+		}
 		len = chip->period_bytes;
 		/* Started first, the decoder must not miss the first byte */
-		out_8(x68k_io(ADPCM_CMD), ADPCM_PLAY);
+		out_8(x68k_io(ADPCM_CMD), chip->capture ? ADPCM_REC : ADPCM_PLAY);
 		out_8(x68k_io(DMAC_CH3 + DMAC_NIV), DMAC_VEC_NORMAL);
 		out_8(x68k_io(DMAC_CH3 + DMAC_EIV), DMAC_VEC_ERROR);
 		x68k_dmac_start(X68K_DMAC_ADPCM, virt_to_phys(chip->adpcm), len,
-				DMAC_OCR_SIZE_BYTE | DMAC_OCR_REQG_EXT, ADPCM_DATA);
+				DMAC_OCR_SIZE_BYTE | DMAC_OCR_REQG_EXT |
+				(chip->capture ? DMAC_OCR_DEV2MEM : 0), ADPCM_DATA);
 		x68k_queue_slot(chip, 1);
 		out_8(x68k_io(DMAC_CH3 + DMAC_CCR), CCR_CONTINUE | CCR_INT);
 		x68k_ppi_bit(PPI_PAN_LEFT_OFF, !chip->pan_left);
@@ -386,12 +447,14 @@ static int x68k_snd_probe(struct platform_device *pdev)
 	strscpy(card->shortname, "X68030 sound", sizeof(card->shortname));
 	strscpy(card->longname, "Sharp X68030 MSM6258 ADPCM and YM2151 FM", sizeof(card->longname));
 
-	err = snd_pcm_new(card, "ADPCM", 0, 1, 0, &pcm);
+	err = snd_pcm_new(card, "ADPCM", 0, 1, 1, &pcm);
 	if (err < 0)
 		return err;
 	pcm->private_data = chip;
 	strscpy(pcm->name, "MSM6258 ADPCM", sizeof(pcm->name));
 	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_PLAYBACK, &x68k_snd_ops);
+	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_CAPTURE, &x68k_snd_ops);
+	pcm->info_flags = SNDRV_PCM_INFO_HALF_DUPLEX;
 	snd_pcm_set_managed_buffer_all(pcm, SNDRV_DMA_TYPE_VMALLOC, NULL, 0, 0);
 
 	err = snd_ctl_add(card, snd_ctl_new1(&x68k_pan_ctl, chip));
@@ -404,6 +467,7 @@ static int x68k_snd_probe(struct platform_device *pdev)
 	strscpy(hw->name, "YM2151 FM", sizeof(hw->name));
 	hw->ops.write = x68k_opm_hwdep_write;
 
+
 	out_8(x68k_io(ADPCM_CMD), ADPCM_STOP);
 	err = devm_request_irq(&pdev->dev, X68K_IRQ(DMAC_VEC_NORMAL), x68k_snd_interrupt, 0,
 			       "x68k-adpcm", chip);
-- 
2.54.0


From 9e398cc7f96ef725c2643f665f7631b6687a21dd Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 15:23:30 +0100
Subject: [PATCH 31/31] ALSA: x68k: Add a YM2151 sequencer synthesizer
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Play the MIDI events of an ALSA sequencer port on the eight channels of
the YM2151, in the way of the OPL3 and OPL4 synthesizers: the sound card
creates a sequencer device, snd-x68k-opm-synth binds to it and handles
the events with the MIDI emulation layer.

Each note takes the longest released channel, else the oldest playing
one.  Velocity, volume and expression set the total level of the output
operators of the connection, pan sets the output bits and pitch bend the
key fraction, with 64 steps per semitone.  The key codes are corrected
for the 4 MHz clock of the X68000, the YM2151 tables assume 3.58 MHz.

SNDRV_X68K_OPM_IOCTL_VOICE on the hwdep device loads the voice of a MIDI
program as register values, programs without one play a default voice.
The drum channel is not played.

Tested in MAME: A4 at 440 Hz, pitch bend, a loaded voice on another
program and the volume controller.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/x68k_defconfig |   2 +
 include/uapi/sound/x68k_opm.h    |  38 +++
 sound/m68k/Kconfig               |  13 ++
 sound/m68k/Makefile              |   2 +
 sound/m68k/x68k_opm.h            |  23 ++
 sound/m68k/x68k_opm_synth.c      | 384 +++++++++++++++++++++++++++++++
 sound/m68k/x68k_snd.c            |  45 ++++
 7 files changed, 507 insertions(+)
 create mode 100644 include/uapi/sound/x68k_opm.h
 create mode 100644 sound/m68k/x68k_opm.h
 create mode 100644 sound/m68k/x68k_opm_synth.c

diff --git a/arch/m68k/configs/x68k_defconfig b/arch/m68k/configs/x68k_defconfig
index da36341eced2..ecb3d9dba422 100644
--- a/arch/m68k/configs/x68k_defconfig
+++ b/arch/m68k/configs/x68k_defconfig
@@ -73,5 +73,7 @@ CONFIG_ZRAM=y
 CONFIG_CRYPTO_LZO=y
 CONFIG_SOUND=y
 CONFIG_SND=y
+CONFIG_SND_SEQUENCER=y
 CONFIG_SND_X68K=y
+CONFIG_SND_X68K_OPM_SYNTH=y
 CONFIG_SND_X68K_MIDI=y
diff --git a/include/uapi/sound/x68k_opm.h b/include/uapi/sound/x68k_opm.h
new file mode 100644
index 000000000000..fa47f67f7d42
--- /dev/null
+++ b/include/uapi/sound/x68k_opm.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * Sharp X68000 series YM2151 voices for the sequencer synthesizer, loaded
+ * through the hwdep device of the sound card.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef _UAPI__SOUND_X68K_OPM_H
+#define _UAPI__SOUND_X68K_OPM_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+#define SNDRV_X68K_OPM_PROGRAMS	128
+
+/* Operators in register order: M1, M2, C1, C2 */
+enum {
+	SNDRV_X68K_OPM_DT1_MUL,		/* register 0x40 */
+	SNDRV_X68K_OPM_TL,		/* register 0x60, carriers follow the velocity */
+	SNDRV_X68K_OPM_KS_AR,		/* register 0x80 */
+	SNDRV_X68K_OPM_AMSEN_D1R,	/* register 0xa0 */
+	SNDRV_X68K_OPM_DT2_D2R,		/* register 0xc0 */
+	SNDRV_X68K_OPM_D1L_RR,		/* register 0xe0 */
+	SNDRV_X68K_OPM_OP_REGS,
+};
+
+struct snd_x68k_opm_voice {
+	__u8 program;			/* MIDI program 0 to 127 */
+	__u8 fl_con;			/* register 0x20 bits 5-0: feedback, connection */
+	__u8 slots;			/* register 0x08 bits 6-3: operators to key on */
+	__u8 pms_ams;			/* register 0x38 */
+	__u8 op[SNDRV_X68K_OPM_OP_REGS][4];
+};
+
+#define SNDRV_X68K_OPM_IOCTL_VOICE	_IOW('H', 0x60, struct snd_x68k_opm_voice)
+
+#endif /* _UAPI__SOUND_X68K_OPM_H */
diff --git a/sound/m68k/Kconfig b/sound/m68k/Kconfig
index b6c0c238f988..b8cb7b1edc0e 100644
--- a/sound/m68k/Kconfig
+++ b/sound/m68k/Kconfig
@@ -26,6 +26,7 @@ config SND_X68K
 	depends on X68K
 	select SND_PCM
 	select SND_HWDEP
+	select SND_SEQ_DEVICE if SND_SEQUENCER != n
 	help
 	  Say Y here for 16 bit PCM playback and recording through the
 	  MSM6258 ADPCM codec of the Sharp X68030, and register access to its
@@ -34,6 +35,18 @@ config SND_X68K
 	  To compile this driver as a module, choose M here: the module
 	  will be called snd-x68k.
 
+config SND_X68K_OPM_SYNTH
+	tristate "Sharp X68030 YM2151 sequencer synthesizer"
+	depends on SND_X68K && SND_SEQUENCER
+	select SND_SEQ_MIDI_EMUL
+	help
+	  Say Y here to play MIDI events of an ALSA sequencer port on the
+	  eight voices of the YM2151, with voices loaded through the hwdep
+	  device of the sound card.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called snd-x68k-opm-synth.
+
 config SND_X68K_MIDI
 	tristate "Sharp CZ-6BM1 MIDI card"
 	depends on X68K
diff --git a/sound/m68k/Makefile b/sound/m68k/Makefile
index fa4e47a1af51..f7f4e241dac4 100644
--- a/sound/m68k/Makefile
+++ b/sound/m68k/Makefile
@@ -3,6 +3,8 @@ snd-next-y := next_snd.o
 
 snd-x68k-y := x68k_snd.o
 snd-x68k-midi-y := x68k_midi.o
+snd-x68k-opm-synth-y := x68k_opm_synth.o
 obj-$(CONFIG_SND_NEXT) += snd-next.o
 obj-$(CONFIG_SND_X68K) += snd-x68k.o
 obj-$(CONFIG_SND_X68K_MIDI) += snd-x68k-midi.o
+obj-$(CONFIG_SND_X68K_OPM_SYNTH) += snd-x68k-opm-synth.o
diff --git a/sound/m68k/x68k_opm.h b/sound/m68k/x68k_opm.h
new file mode 100644
index 000000000000..1df267299027
--- /dev/null
+++ b/sound/m68k/x68k_opm.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Sharp X68030 YM2151 voices shared by the sound card and its sequencer synthesizer
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef __SOUND_M68K_X68K_OPM_H
+#define __SOUND_M68K_X68K_OPM_H
+
+#include <linux/spinlock.h>
+#include <sound/core.h>
+#include <sound/x68k_opm.h>
+
+#define SNDRV_SEQ_DEV_ID_X68K_OPM	"x68k-opm-synth"
+
+struct x68k_opm {
+	struct snd_card *card;
+	spinlock_t lock;		/* the voices, held while the synthesizer programs them */
+	struct snd_x68k_opm_voice *voice[SNDRV_X68K_OPM_PROGRAMS];	/* NULL plays the default */
+};
+
+#endif /* __SOUND_M68K_X68K_OPM_H */
diff --git a/sound/m68k/x68k_opm_synth.c b/sound/m68k/x68k_opm_synth.c
new file mode 100644
index 000000000000..851a8eb9b021
--- /dev/null
+++ b/sound/m68k/x68k_opm_synth.c
@@ -0,0 +1,384 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp X68030 YM2151 as an ALSA sequencer synthesizer: eight voices played from
+ * the MIDI events of one port, with the YM2151 voice of each program.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/int_log.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include <sound/asoundef.h>
+#include <sound/core.h>
+#include <sound/seq_device.h>
+#include <sound/seq_kernel.h>
+#include <sound/seq_midi_emul.h>
+
+#include <asm/x68k.h>
+
+#include "x68k_opm.h"
+
+#define OPM_CHANNELS		8
+#define OPM_KEY_ON		0x08
+#define OPM_RL_FL_CON		0x20
+#define OPM_KC			0x28
+#define OPM_KF			0x30
+#define OPM_PMS_AMS		0x38
+#define OPM_OP_BASE		0x40	/* 0x20 per parameter, 8 per operator */
+#define OPM_LEFT		0x40
+#define OPM_RIGHT		0x80
+#define TL_MAX			127
+#define GAIN_MAX		(127 * 127 * 127)
+
+/* Key codes count from C#, 64 fractions per semitone, 4 MHz clock instead of 3.58 MHz */
+#define PITCH_NOTE_BASE		13
+#define PITCH_CLOCK_OFFSET	123	/* 768 * log2(4 / 3.579545) */
+#define PITCH_MAX		(8 * 12 * 64 - 1)
+
+struct opm_ch {
+	struct snd_midi_channel *chan;	/* NULL when free */
+	struct snd_x68k_opm_voice voice;	/* as programmed */
+	bool programmed;
+	bool on;
+	int note;
+	int vel;
+	unsigned long stamp;		/* of the last key on or off */
+};
+
+struct opm_synth {
+	struct x68k_opm *opm;
+	struct snd_midi_channel_set *chset;
+	int client;
+	unsigned long stamp;
+	struct opm_ch ch[OPM_CHANNELS];
+};
+
+/* A sustained tone with a little brightness from two modulators, connection 4 */
+static const struct snd_x68k_opm_voice opm_default_voice = {
+	.fl_con		= (3 << 3) | 4,
+	.slots		= 0x78,
+	.op = {
+		[SNDRV_X68K_OPM_DT1_MUL]	= { 0x01, 0x02, 0x01, 0x01 },
+		[SNDRV_X68K_OPM_TL]		= { 0x28, 0x34, 0x00, 0x00 },
+		[SNDRV_X68K_OPM_KS_AR]		= { 0x1f, 0x1f, 0x1f, 0x1f },
+		[SNDRV_X68K_OPM_AMSEN_D1R]	= { 0x08, 0x08, 0x04, 0x04 },
+		[SNDRV_X68K_OPM_DT2_D2R]	= { 0x02, 0x02, 0x01, 0x01 },
+		[SNDRV_X68K_OPM_D1L_RR]		= { 0x27, 0x27, 0x17, 0x17 },
+	},
+};
+
+/* Output operators of each connection, bit n for operator n in register order */
+static const u8 opm_carriers[8] = { 0x8, 0x8, 0x8, 0x8, 0xc, 0xe, 0xe, 0xf };
+
+static u8 opm_op_reg(int param, int op, int c)
+{
+	return OPM_OP_BASE + 0x20 * param + 8 * op + c;
+}
+
+static u8 opm_pan(struct snd_midi_channel *chan)
+{
+	if (chan->gm_pan < 43)
+		return OPM_LEFT;
+	if (chan->gm_pan > 85)
+		return OPM_RIGHT;
+	return OPM_LEFT | OPM_RIGHT;
+}
+
+static void opm_set_pan(struct opm_ch *ch, int c)
+{
+	x68k_opm_write(OPM_RL_FL_CON + c, opm_pan(ch->chan) | (ch->voice.fl_con & 0x3f));
+}
+
+static void opm_set_pitch(struct opm_ch *ch, int c)
+{
+	struct snd_midi_channel *chan = ch->chan;
+	int bend = chan->midi_pitchbend * chan->gm_rpn_pitch_bend_range / 16384;
+	int pitch = clamp((ch->note - PITCH_NOTE_BASE) * 64 + bend - PITCH_CLOCK_OFFSET,
+			  0, PITCH_MAX);
+	int semi = pitch / 64 % 12;
+
+	x68k_opm_write(OPM_KC + c, (pitch / 768) << 4 | (semi + semi / 3));
+	x68k_opm_write(OPM_KF + c, (pitch % 64) << 2);
+}
+
+/* 40 log10 for each of velocity, volume and expression, in steps of 0.75 dB */
+static void opm_set_level(struct opm_ch *ch, int c)
+{
+	struct snd_midi_channel *chan = ch->chan;
+	u32 gain = ch->vel * chan->gm_volume * chan->gm_expression;
+	u8 carriers = opm_carriers[ch->voice.fl_con & 7];
+	unsigned int atten = TL_MAX;
+	int op;
+
+	if (gain >= GAIN_MAX)
+		atten = 0;
+	else if (gain)
+		atten = ((intlog10(GAIN_MAX) - intlog10(gain)) >> 8) * 160 / 3 >> 16;
+	for (op = 0; op < 4; op++) {
+		unsigned int tl = ch->voice.op[SNDRV_X68K_OPM_TL][op] & 0x7f;
+
+		if (carriers & BIT(op))
+			tl = min(tl + atten, TL_MAX);
+		x68k_opm_write(opm_op_reg(SNDRV_X68K_OPM_TL, op, c), tl);
+	}
+}
+
+static void opm_program(struct opm_ch *ch, int c, const struct snd_x68k_opm_voice *v)
+{
+	int param, op;
+
+	if (ch->programmed && !memcmp(&ch->voice, v, sizeof(*v)))
+		return;
+	ch->voice = *v;
+	ch->programmed = true;
+	x68k_opm_write(OPM_PMS_AMS + c, v->pms_ams);
+	for (param = 0; param < SNDRV_X68K_OPM_OP_REGS; param++)
+		if (param != SNDRV_X68K_OPM_TL)
+			for (op = 0; op < 4; op++)
+				x68k_opm_write(opm_op_reg(param, op, c), v->op[param][op]);
+}
+
+static void opm_key_off(struct opm_synth *s, int c)
+{
+	x68k_opm_write(OPM_KEY_ON, c);
+	s->ch[c].on = false;
+	s->ch[c].stamp = ++s->stamp;
+}
+
+/* The longest released channel, else the oldest playing one */
+static int opm_alloc(struct opm_synth *s)
+{
+	int c, best = 0;
+
+	for (c = 1; c < OPM_CHANNELS; c++) {
+		struct opm_ch *a = &s->ch[c], *b = &s->ch[best];
+
+		if (a->on != b->on ? !a->on : time_before(a->stamp, b->stamp))
+			best = c;
+	}
+	return best;
+}
+
+static void opm_note_on(void *private_data, int note, int vel, struct snd_midi_channel *chan)
+{
+	struct opm_synth *s = private_data;
+	struct x68k_opm *opm = s->opm;
+	const struct snd_x68k_opm_voice *v;
+	unsigned long flags;
+	struct opm_ch *ch;
+	int c;
+
+	if (chan->drum_channel)
+		return;
+	spin_lock_irqsave(&opm->lock, flags);
+	c = opm_alloc(s);
+	ch = &s->ch[c];
+	opm_key_off(s, c);
+	v = opm->voice[chan->midi_program & 0x7f] ?: &opm_default_voice;
+	opm_program(ch, c, v);
+	ch->chan = chan;
+	ch->note = note;
+	ch->vel = vel;
+	ch->on = true;
+	opm_set_pan(ch, c);
+	opm_set_pitch(ch, c);
+	opm_set_level(ch, c);
+	x68k_opm_write(OPM_KEY_ON, (v->slots & 0x78) | c);
+	spin_unlock_irqrestore(&opm->lock, flags);
+}
+
+static void opm_release(struct opm_synth *s, int note, struct snd_midi_channel *chan, bool now)
+{
+	unsigned long flags;
+	int c, op;
+
+	spin_lock_irqsave(&s->opm->lock, flags);
+	for (c = 0; c < OPM_CHANNELS; c++) {
+		struct opm_ch *ch = &s->ch[c];
+
+		if (!ch->on || ch->chan != chan || ch->note != note)
+			continue;
+		opm_key_off(s, c);
+		/* Silence the release, the levels are set again at the next key on */
+		if (now)
+			for (op = 0; op < 4; op++)
+				x68k_opm_write(opm_op_reg(SNDRV_X68K_OPM_TL, op, c), TL_MAX);
+	}
+	spin_unlock_irqrestore(&s->opm->lock, flags);
+}
+
+static void opm_note_off(void *private_data, int note, int vel, struct snd_midi_channel *chan)
+{
+	opm_release(private_data, note, chan, false);
+}
+
+static void opm_note_terminate(void *private_data, int note, struct snd_midi_channel *chan)
+{
+	opm_release(private_data, note, chan, true);
+}
+
+static void opm_control(void *private_data, int type, struct snd_midi_channel *chan)
+{
+	struct opm_synth *s = private_data;
+	unsigned long flags;
+	int c;
+
+	spin_lock_irqsave(&s->opm->lock, flags);
+	for (c = 0; c < OPM_CHANNELS; c++) {
+		struct opm_ch *ch = &s->ch[c];
+
+		if (!ch->on || ch->chan != chan)
+			continue;
+		switch (type) {
+		case MIDI_CTL_PITCHBEND:
+			opm_set_pitch(ch, c);
+			break;
+		case MIDI_CTL_MSB_MAIN_VOLUME:
+		case MIDI_CTL_MSB_EXPRESSION:
+			opm_set_level(ch, c);
+			break;
+		case MIDI_CTL_MSB_PAN:
+			opm_set_pan(ch, c);
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&s->opm->lock, flags);
+}
+
+static const struct snd_midi_op opm_ops = {
+	.note_on	= opm_note_on,
+	.note_off	= opm_note_off,
+	.note_terminate	= opm_note_terminate,
+	.control	= opm_control,
+};
+
+static void opm_all_off(struct opm_synth *s)
+{
+	unsigned long flags;
+	int c;
+
+	spin_lock_irqsave(&s->opm->lock, flags);
+	for (c = 0; c < OPM_CHANNELS; c++) {
+		opm_key_off(s, c);
+		s->ch[c].chan = NULL;
+	}
+	spin_unlock_irqrestore(&s->opm->lock, flags);
+}
+
+static int opm_use(void *private_data, struct snd_seq_port_subscribe *info)
+{
+	struct opm_synth *s = private_data;
+
+	if (!try_module_get(s->opm->card->module))
+		return -EFAULT;
+	snd_midi_channel_set_clear(s->chset);
+	opm_all_off(s);
+	return 0;
+}
+
+static int opm_unuse(void *private_data, struct snd_seq_port_subscribe *info)
+{
+	struct opm_synth *s = private_data;
+
+	opm_all_off(s);
+	module_put(s->opm->card->module);
+	return 0;
+}
+
+static int opm_event_input(struct snd_seq_event *ev, int direct, void *private_data, int atomic,
+			   int hop)
+{
+	struct opm_synth *s = private_data;
+
+	snd_midi_process_event(&opm_ops, ev, s->chset);
+	return 0;
+}
+
+static void opm_free_port(void *private_data)
+{
+	struct opm_synth *s = private_data;
+
+	snd_midi_channel_free_set(s->chset);
+}
+
+static int opm_synth_probe(struct snd_seq_device *dev)
+{
+	struct x68k_opm *opm = *(struct x68k_opm **)SNDRV_SEQ_DEVICE_ARGPTR(dev);
+	struct snd_seq_port_callback cb = {
+		.owner		= THIS_MODULE,
+		.use		= opm_use,
+		.unuse		= opm_unuse,
+		.event_input	= opm_event_input,
+		.private_free	= opm_free_port,
+	};
+	struct opm_synth *s;
+	int port, err;
+
+	s = kzalloc_obj(*s);
+	if (!s)
+		return -ENOMEM;
+	s->opm = opm;
+	s->chset = snd_midi_channel_alloc_set(16);
+	if (!s->chset)
+		goto nomem;
+	s->chset->private_data = s;
+	/* General MIDI handles the RPNs and the drum channel */
+	s->chset->midi_mode = SNDRV_MIDI_MODE_GM;
+	snd_midi_channel_set_clear(s->chset);
+
+	s->client = snd_seq_create_kernel_client(opm->card, dev->device, "YM2151 FM");
+	if (s->client < 0) {
+		err = s->client;
+		snd_midi_channel_free_set(s->chset);
+		kfree(s);
+		return err;
+	}
+	s->chset->client = s->client;
+	cb.private_data = s;
+	port = snd_seq_event_port_attach(s->client, &cb,
+					 SNDRV_SEQ_PORT_CAP_WRITE | SNDRV_SEQ_PORT_CAP_SUBS_WRITE,
+					 SNDRV_SEQ_PORT_TYPE_MIDI_GENERIC |
+					 SNDRV_SEQ_PORT_TYPE_MIDI_GM |
+					 SNDRV_SEQ_PORT_TYPE_HARDWARE |
+					 SNDRV_SEQ_PORT_TYPE_SYNTHESIZER,
+					 16, OPM_CHANNELS, "YM2151 FM Port");
+	if (port < 0) {
+		snd_midi_channel_free_set(s->chset);
+		snd_seq_delete_kernel_client(s->client);
+		kfree(s);
+		return port;
+	}
+	s->chset->port = port;
+	dev_set_drvdata(&dev->dev, s);
+	return 0;
+
+nomem:
+	kfree(s);
+	return -ENOMEM;
+}
+
+static void opm_synth_remove(struct snd_seq_device *dev)
+{
+	struct opm_synth *s = dev_get_drvdata(&dev->dev);
+
+	snd_seq_delete_kernel_client(s->client);
+	kfree(s);
+}
+
+static struct snd_seq_driver opm_synth_driver = {
+	.probe		= opm_synth_probe,
+	.remove		= opm_synth_remove,
+	.driver		= {
+		.name = KBUILD_MODNAME,
+	},
+	.id		= SNDRV_SEQ_DEV_ID_X68K_OPM,
+	.argsize	= sizeof(struct x68k_opm *),
+};
+module_snd_seq_driver(opm_synth_driver);
+
+MODULE_DESCRIPTION("Sharp X68030 YM2151 sequencer synthesizer");
+MODULE_LICENSE("GPL");
diff --git a/sound/m68k/x68k_snd.c b/sound/m68k/x68k_snd.c
index 1a6a9cd7bc2a..6e79f3d070b2 100644
--- a/sound/m68k/x68k_snd.c
+++ b/sound/m68k/x68k_snd.c
@@ -20,11 +20,14 @@
 #include <sound/initval.h>
 #include <sound/pcm.h>
 #include <sound/pcm_params.h>
+#include <sound/seq_device.h>
 
 #include <asm/cacheflush.h>
 #include <asm/x68k.h>
 #include <asm/x68kdmac.h>
 
+#include "x68k_opm.h"
+
 #define ADPCM_CMD		0x00e92001
 #define ADPCM_DATA		0x00e92003
 #define ADPCM_STOP		0x01
@@ -76,6 +79,8 @@ static const s8 oki_index_shift[8] = { -1, -1, -1, -1, 2, 4, 6, 8 };
 
 struct x68k_snd {
 	struct snd_card *card;
+	struct device *dev;
+	struct x68k_opm opm;
 	struct snd_pcm_substream *substream;
 	struct snd_pcm_substream *open;	/* the codec plays or records */
 	spinlock_t lock;
@@ -422,6 +427,32 @@ static long x68k_opm_hwdep_write(struct snd_hwdep *hw, const char __user *buf, l
 	return done;
 }
 
+/* Voices for the sequencer synthesizer */
+static int x68k_opm_hwdep_ioctl(struct snd_hwdep *hw, struct file *file, unsigned int cmd,
+				unsigned long arg)
+{
+	struct x68k_snd *chip = hw->private_data;
+	struct snd_x68k_opm_voice *v, *old;
+
+	if (cmd != SNDRV_X68K_OPM_IOCTL_VOICE)
+		return -ENOTTY;
+	v = devm_kmalloc(chip->dev, sizeof(*v), GFP_KERNEL);
+	if (!v)
+		return -ENOMEM;
+	if (copy_from_user(v, (void __user *)arg, sizeof(*v)) ||
+	    v->program >= SNDRV_X68K_OPM_PROGRAMS) {
+		devm_kfree(chip->dev, v);
+		return -EINVAL;
+	}
+	spin_lock_irq(&chip->opm.lock);
+	old = chip->opm.voice[v->program];
+	chip->opm.voice[v->program] = v;
+	spin_unlock_irq(&chip->opm.lock);
+	if (old)
+		devm_kfree(chip->dev, old);
+	return 0;
+}
+
 static int x68k_snd_probe(struct platform_device *pdev)
 {
 	struct snd_card *card;
@@ -436,7 +467,10 @@ static int x68k_snd_probe(struct platform_device *pdev)
 		return err;
 	chip = card->private_data;
 	chip->card = card;
+	chip->dev = &pdev->dev;
 	spin_lock_init(&chip->lock);
+	chip->opm.card = card;
+	spin_lock_init(&chip->opm.lock);
 	chip->pan_left = chip->pan_right = true;
 
 	chip->adpcm = devm_kmalloc(&pdev->dev, ADPCM_SLOTS * MAX_PERIOD_BYTES / 4, GFP_KERNEL | GFP_DMA);
@@ -465,8 +499,19 @@ static int x68k_snd_probe(struct platform_device *pdev)
 	if (err < 0)
 		return err;
 	strscpy(hw->name, "YM2151 FM", sizeof(hw->name));
+	hw->private_data = chip;
 	hw->ops.write = x68k_opm_hwdep_write;
+	hw->ops.ioctl = x68k_opm_hwdep_ioctl;
 
+#if IS_ENABLED(CONFIG_SND_SEQUENCER)
+	{
+		struct snd_seq_device *seq;
+
+		if (snd_seq_device_new(card, 0, SNDRV_SEQ_DEV_ID_X68K_OPM,
+				       sizeof(struct x68k_opm *), &seq) >= 0)
+			*(struct x68k_opm **)SNDRV_SEQ_DEVICE_ARGPTR(seq) = &chip->opm;
+	}
+#endif
 
 	out_8(x68k_io(ADPCM_CMD), ADPCM_STOP);
 	err = devm_request_irq(&pdev->dev, X68K_IRQ(DMAC_VEC_NORMAL), x68k_snd_interrupt, 0,
-- 
