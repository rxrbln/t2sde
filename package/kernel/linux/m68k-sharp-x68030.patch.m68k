diff --git a/arch/m68k/x68k/Makefile b/arch/m68k/x68k/Makefile
new file mode 100644
index 000000000000..13265f72e816
--- /dev/null
+++ b/arch/m68k/x68k/Makefile
@@ -0,0 +1,6 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Makefile for Linux arch/m68k/x68k source directory
+#
+
+obj-y		:= config.o ints.o reset.o time.o
diff --git a/arch/m68k/x68k/boot/Makefile b/arch/m68k/x68k/boot/Makefile
new file mode 100644
index 000000000000..8d5dc4c48bae
--- /dev/null
+++ b/arch/m68k/x68k/boot/Makefile
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Boot image for the X68030 ROM: a loader in the boot block format, followed by
+# the kernel as a flat binary. mkx68kdisk writes it to a disk.
+#
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+#
+
+X68KBOOT_CMDLINE ?= console=ttyS0,9600 console=tty0
+
+hostprogs	:= mkx68kdisk
+targets		:= head.o main.o loader.elf loader.bin vmlinux.bin x68kboot
+
+kernel-end	 = $(shell $(NM) vmlinux | sed -n 's/^\([0-9a-f]*\) . _end$$/0x\1/p')
+
+KBUILD_CFLAGS	:= -m68030 -msoft-float -Os -std=gnu11 -Wall -ffreestanding \
+		   -fno-pic -fno-stack-protector -fno-asynchronous-unwind-tables \
+		   -fno-builtin -nostdinc \
+		   -I$(srctree)/arch/m68k/include/uapi -I$(srctree)/include/uapi \
+		   -I$(objtree)/arch/m68k/include/generated/uapi \
+		   -I$(objtree)/include/generated/uapi -D__KERNEL__
+KBUILD_AFLAGS	:= -m68030 -msoft-float -D__ASSEMBLY__ -D__ASSEMBLER__
+KBUILD_CFLAGS_KERNEL	:=
+KBUILD_AFLAGS_KERNEL	:=
+
+CFLAGS_main.o	:= -DKERNEL_END=$(kernel-end) -DX68KBOOT_CMDLINE='"$(X68KBOOT_CMDLINE)"'
+
+quiet_cmd_x68kld = LD      $@
+      cmd_x68kld = $(LD) -m m68kelf -T $(src)/loader.lds --no-warn-rwx-segments \
+		   $(obj)/head.o $(obj)/main.o -o $@
+
+$(obj)/loader.elf: $(obj)/head.o $(obj)/main.o $(src)/loader.lds FORCE
+	$(call if_changed,x68kld)
+
+quiet_cmd_bin = OBJCOPY $@
+      cmd_bin = $(OBJCOPY) -O binary $< $@
+
+$(obj)/loader.bin: $(obj)/loader.elf FORCE
+	$(call if_changed,bin)
+
+$(obj)/vmlinux.bin: vmlinux FORCE
+	$(call if_changed,bin)
+
+# The loader has a fixed size so that mkx68kdisk finds the kernel behind it
+quiet_cmd_x68kboot = BOOTIMG $@
+      cmd_x68kboot = test $$(stat -c %s $(obj)/loader.bin) -le 16384 && \
+		     cp $(obj)/loader.bin $@ && truncate -s 16384 $@ && \
+		     cat $(obj)/vmlinux.bin >> $@
+
+$(obj)/x68kboot: $(obj)/loader.bin $(obj)/vmlinux.bin $(obj)/mkx68kdisk FORCE
+	$(call if_changed,x68kboot)
diff --git a/arch/m68k/x68k/boot/head.S b/arch/m68k/x68k/boot/head.S
new file mode 100644
index 000000000000..fe42f4321674
--- /dev/null
+++ b/arch/m68k/x68k/boot/head.S
@@ -0,0 +1,148 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * X68030 boot block. The ROM loads the first 1 KB from the disk and runs it at an
+ * address which depends on the path taken, so that it first moves itself, then
+ * reads the rest of the loader. Only ROM calls (IOCS) are used for disk access.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#define IOCS_B_PRINT	0x21
+#define IOCS_SCSIDRV	-11
+#define S_READ		0x21
+#define S_READCAP	0x25
+
+#define LINK_ADDR	0x3000
+#define STACK_TOP	0x000ffff0
+
+	.chip	68030
+	.section .text.start,"ax"
+	.globl	_start, boot_params
+_start:
+	bras	entry
+	.ascii	"SHARP/X680x0"
+	.even
+	/* Filled in by mkx68kdisk */
+boot_params:
+	.long	0, 0, 0, 0	/* kernel block and count, loader block and count */
+
+entry:
+	movel	%d4,%d7			/* SCSI ID from the ROM */
+	lea	%pc@(_start),%a0
+	lea	LINK_ADDR,%a1
+	movew	#1024/4-1,%d0
+1:	movel	%a0@+,%a1@+
+	dbra	%d0,1b
+	jmp	relocated
+
+relocated:
+	lea	STACK_TOP,%sp
+	/* Without the read capacity data, block numbers are unknown */
+	movel	%d7,%d4
+	moveq	#S_READCAP,%d1
+	lea	capacity,%a1
+	moveq	#IOCS_SCSIDRV,%d0
+	trap	#15
+	tstl	%d0
+	jne	fail
+
+	movel	capacity+4,%d5
+	lsrl	#8,%d5
+	lsrl	#1,%d5			/* 256, 512 and 1024 bytes are 0, 1 and 2 */
+	movel	boot_params+8,%d2
+	movel	boot_params+12,%d3
+	moveq	#S_READ,%d1
+	lea	_start+1024,%a1
+	moveq	#IOCS_SCSIDRV,%d0
+	trap	#15
+	tstl	%d0
+	jne	fail
+
+	movel	%d5,%sp@-
+	movel	%d7,%sp@-
+	jsr	x68k_boot
+	addql	#8,%sp
+fail:
+	lea	failmsg,%a1
+	moveq	#IOCS_B_PRINT,%d0
+	trap	#15
+2:	jra	2b
+
+	.globl	iocs_print
+iocs_print:
+	movel	%sp@(4),%a1
+	moveq	#IOCS_B_PRINT,%d0
+	trap	#15
+	rts
+
+	/* int iocs_s_read(u32 block, u32 count, u32 id, u32 size, void *buf) */
+	.globl	iocs_s_read
+iocs_s_read:
+	moveml	%d2-%d5,%sp@-
+	moveml	%sp@(20),%d2-%d5
+	movel	%sp@(36),%a1
+	moveq	#S_READ,%d1
+	moveq	#IOCS_SCSIDRV,%d0
+	trap	#15
+	moveml	%sp@+,%d2-%d5
+	rts
+
+failmsg:
+	.asciz	"x68kboot: disk read failed\r\n"
+	.even
+capacity:
+	.long	0, 0
+
+	/* Everything above fits the first 1 KB */
+	.text
+
+	/*
+	 * int fsave_size(void *buf): the size of the state saved by the FPU, 0 without
+	 * one, as an absent coprocessor raises the F line exception.
+	 */
+	.globl	fsave_size
+fsave_size:
+	movel	%a2,%sp@-
+	movel	%sp@(8),%a2
+	movel	0x2c,%a0
+	lea	1f,%a1
+	movel	%a1,0x2c
+	movel	%sp,%a1
+	moveq	#0,%d0
+	.word	0xf280,0x0000		/* fnop */
+	.word	0xf312			/* fsave %a2@ */
+	moveb	%a2@(1),%d0
+1:	movel	%a1,%sp
+	movel	%a0,0x2c
+	movel	%sp@+,%a2
+	rts
+
+	/*
+	 * void enter_kernel(void *dst, void *src, u32 len, void *end, void *bi, u32 bilen)
+	 * Runs from high memory, as the kernel moves over the loader.
+	 */
+	.globl	move_stub, move_stub_end
+move_stub:
+	movel	%sp@(4),%a1		/* destination */
+	movel	%sp@(8),%a2		/* image */
+	movel	%sp@(12),%d0		/* its length */
+	movel	%sp@(16),%a4		/* end of the kernel */
+	movel	%sp@(20),%a3		/* bootinfo */
+	movel	%sp@(24),%d1		/* its length */
+	addql	#3,%d0
+	lsrl	#2,%d0
+1:	movel	%a2@+,%a1@+
+	subql	#1,%d0
+	jne	1b
+	/* The rest of the kernel is its BSS */
+2:	cmpal	%a4,%a1
+	jcc	3f
+	clrb	%a1@+
+	jra	2b
+3:	movel	%a4,%a1
+4:	moveb	%a3@+,%a1@+
+	subql	#1,%d1
+	jne	4b
+	movel	#0x1000,%a0
+	jmp	%a0@
+move_stub_end:
diff --git a/arch/m68k/x68k/boot/loader.lds b/arch/m68k/x68k/boot/loader.lds
new file mode 100644
index 000000000000..81f55d672c84
--- /dev/null
+++ b/arch/m68k/x68k/boot/loader.lds
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+OUTPUT_FORMAT("elf32-m68k")
+OUTPUT_ARCH(m68k)
+ENTRY(_start)
+
+SECTIONS
+{
+	. = 0x3000;
+	.text : { *(.text.start) *(.text*) }
+	.rodata : { *(.rodata*) }
+	.data : { *(.data*) }
+	.bss : { __bss_start = .; *(.bss*) *(COMMON) . = ALIGN(4); __bss_end = .; }
+	/DISCARD/ : { *(.comment) *(.note*) *(.eh_frame*) }
+}
diff --git a/arch/m68k/x68k/boot/main.c b/arch/m68k/x68k/boot/main.c
new file mode 100644
index 000000000000..b0b6a9b5f546
--- /dev/null
+++ b/arch/m68k/x68k/boot/main.c
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * X68030 boot loader: read the kernel with the ROM's SCSI calls, build bootinfo and
+ * start it with the ROM out of the picture.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/types.h>
+#include <asm/bootinfo.h>
+#include <asm/bootinfo-x68k.h>
+
+typedef unsigned char u8;
+typedef unsigned short u16;
+typedef unsigned int u32;
+
+#define SRAM_RAM_SIZE	0x00ed0008
+#define RAM_MAX		0x00c00000
+#define IMAGE_ADDR	0x00100000	/* above the loader, its stack and the ROM data */
+#define KERNEL_ADDR	0x00001000
+#define READ_BLOCKS	128
+#define MFP_IER_A	0x00e88007
+#define MFP_IER_B	0x00e88009
+#define BI_SIZE		1024
+
+extern u32 boot_params[4];
+extern const char move_stub[], move_stub_end[];
+extern void iocs_print(const char *s);
+extern int iocs_s_read(u32 block, u32 count, u32 id, u32 size, void *buf);
+extern u32 fsave_size(void *buf);
+
+static u8 bi_buf[BI_SIZE] __attribute__((aligned(4)));
+static u32 bi_len;
+
+/* The kernel checks saved FPU state against this type, the frame sizes tell them apart */
+static u32 fpu_type(void)
+{
+	static u8 frame[256] __attribute__((aligned(4)));
+
+	switch (fsave_size(frame)) {
+	case 0x18:
+	case 0xb4:
+		return FPU_68881;
+	case 0x38:
+	case 0xd4:
+		return FPU_68882;
+	}
+	return 0;
+}
+
+static u32 str_len(const char *s)
+{
+	u32 n = 0;
+
+	while (s[n])
+		n++;
+	return n;
+}
+
+static void *copy(void *d, const void *s, u32 n)
+{
+	u8 *dp = d;
+	const u8 *sp = s;
+
+	while (n--)
+		*dp++ = *sp++;
+	return d;
+}
+
+static void bi_add(u16 tag, const void *data, u32 size)
+{
+	struct bi_record *rec = (struct bi_record *)(bi_buf + bi_len);
+	u32 len = (sizeof(*rec) + size + 3) & ~3;
+
+	rec->tag = tag;
+	rec->size = len;
+	copy(rec->data, data, size);
+	bi_len += len;
+}
+
+static void bi_add_u32(u16 tag, u32 val)
+{
+	bi_add(tag, &val, sizeof(val));
+}
+
+void x68k_boot(u32 scsi_id, u32 size)
+{
+	struct mem_info mem;
+	u32 kblock = boot_params[0], kcount = boot_params[1];
+	u32 shift = size ? size - 1 : 0, len, done, ram, top;
+	void (*stub)(void *, void *, u32, void *, void *, u32);
+
+	for (done = 0; done < kcount; done += READ_BLOCKS) {
+		u32 n = kcount - done < READ_BLOCKS ? kcount - done : READ_BLOCKS;
+
+		if (iocs_s_read((kblock + done) >> shift, n >> shift, scsi_id, size,
+				(u8 *)IMAGE_ADDR + done * 512)) {
+			iocs_print("x68kboot: kernel read failed\r\n");
+			return;
+		}
+	}
+	len = kcount * 512;
+
+	ram = *(volatile u32 *)SRAM_RAM_SIZE;
+	if (!ram || ram > RAM_MAX || (ram & 0xffff))
+		ram = RAM_MAX;
+
+	bi_add_u32(BI_MACHTYPE, MACH_X68K);
+	bi_add_u32(BI_CPUTYPE, CPU_68030);
+	bi_add_u32(BI_MMUTYPE, MMU_68030);
+	bi_add_u32(BI_FPUTYPE, fpu_type());
+	mem.addr = 0;
+	mem.size = ram;
+	bi_add(BI_MEMCHUNK, &mem, sizeof(mem));
+	bi_add(BI_COMMAND_LINE, X68KBOOT_CMDLINE, str_len(X68KBOOT_CMDLINE) + 1);
+	bi_add_u32(BI_LAST, 0);
+
+	/* Above both the image and the running kernel */
+	top = IMAGE_ADDR + len;
+	if (top < KERNEL_END)
+		top = KERNEL_END;
+	top = (top + 15) & ~15;
+	if (top + BI_SIZE + 1024 > ram) {
+		iocs_print("x68kboot: not enough memory\r\n");
+		return;
+	}
+
+	asm volatile("movew #0x2700,%sr");
+	*(volatile u8 *)MFP_IER_A = 0;
+	*(volatile u8 *)MFP_IER_B = 0;
+	/* Disable and clear both caches */
+	asm volatile("movel #0x0808,%%d0\n\tmovec %%d0,%%cacr" : : : "d0");
+
+	copy((void *)top, bi_buf, bi_len);
+	copy((void *)(top + BI_SIZE), move_stub, move_stub_end - move_stub);
+	stub = (void *)(top + BI_SIZE);
+	stub((void *)KERNEL_ADDR, (void *)IMAGE_ADDR, len, (void *)KERNEL_END, (void *)top, bi_len);
+}
diff --git a/arch/m68k/x68k/boot/mkx68kdisk.c b/arch/m68k/x68k/boot/mkx68kdisk.c
new file mode 100644
index 000000000000..97225c066634
--- /dev/null
+++ b/arch/m68k/x68k/boot/mkx68kdisk.c
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Make a disk image or device bootable by the X68030 ROM: its signature in block 0,
+ * the first 1 KB of x68kboot behind it, then the rest of the loader and the kernel.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define BLOCK		512
+#define LOADER_SIZE	16384
+#define BOOT_OFFSET	1024
+#define PARAMS_OFFSET	14	/* behind the branch and the signature */
+#define REST_BLOCK	32	/* room for a partition table before it */
+#define KERNEL_BLOCK	(REST_BLOCK + LOADER_SIZE / BLOCK)
+
+static void die(const char *what)
+{
+	perror(what);
+	exit(1);
+}
+
+int main(int argc, char **argv)
+{
+	struct stat st;
+	uint32_t *params;
+	char sector[BLOCK] = "X68SCSI1";
+	char *img;
+	ssize_t kernel;
+	int disk, file;
+
+	if (argc != 3) {
+		fprintf(stderr, "usage: %s DISK X68KBOOT\n", argv[0]);
+		return 1;
+	}
+	disk = open(argv[1], O_RDWR);
+	if (disk < 0)
+		die(argv[1]);
+	file = open(argv[2], O_RDONLY);
+	if (file < 0 || fstat(file, &st))
+		die(argv[2]);
+	if (st.st_size <= LOADER_SIZE) {
+		fprintf(stderr, "%s: too short\n", argv[2]);
+		return 1;
+	}
+	img = malloc(st.st_size);
+	if (!img)
+		die("malloc");
+	if (read(file, img, st.st_size) != st.st_size)
+		die(argv[2]);
+	kernel = st.st_size - LOADER_SIZE;
+
+	params = (uint32_t *)(img + PARAMS_OFFSET);
+	params[0] = htonl(KERNEL_BLOCK);
+	params[1] = htonl((kernel + BLOCK - 1) / BLOCK);
+	params[2] = htonl(REST_BLOCK);
+	params[3] = htonl((LOADER_SIZE - 1024) / BLOCK);
+
+	if (pwrite(disk, sector, BLOCK, 0) != BLOCK ||
+	    pwrite(disk, img, 1024, BOOT_OFFSET) != 1024 ||
+	    pwrite(disk, img + 1024, LOADER_SIZE - 1024, (off_t)REST_BLOCK * BLOCK) !=
+		    LOADER_SIZE - 1024 ||
+	    pwrite(disk, img + LOADER_SIZE, kernel, (off_t)KERNEL_BLOCK * BLOCK) != kernel)
+		die("write");
+	printf("%s: kernel of %zd KiB at block %d\n", argv[1], kernel / 1024, KERNEL_BLOCK);
+	return close(disk) ? 1 : 0;
+}
diff --git a/arch/m68k/x68k/config.c b/arch/m68k/x68k/config.c
new file mode 100644
index 000000000000..4fbbca88c4ac
--- /dev/null
+++ b/arch/m68k/x68k/config.c
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp X68030 machine setup
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/platform_data/pmac_zilog.h>
+#include <linux/platform_device.h>
+
+#include <asm/bootinfo.h>
+#include <asm/config.h>
+#include <asm/io.h>
+#include <asm/irq.h>
+#include <asm/machdep.h>
+#include <asm/setup.h>
+#include <asm/x68k.h>
+
+#define SCC_PCLK	5000000
+
+extern struct platform_device scc_a_pdev, scc_b_pdev;
+
+int __init x68k_parse_bootinfo(const struct bi_record *record)
+{
+	return 1;
+}
+
+static void x68k_get_model(char *model)
+{
+	strcpy(model, "Sharp X68030");
+}
+
+static void x68k_reset(void)
+{
+	local_irq_disable();
+	x68k_rom_reset();
+}
+
+void __init config_x68k(void)
+{
+	mach_sched_init	= x68k_sched_init;
+	mach_init_IRQ	= x68k_init_IRQ;
+	mach_get_model	= x68k_get_model;
+	mach_reset	= x68k_reset;
+}
+
+static struct pmz_platform_data x68k_scc_pdata = {
+	.pclk	= SCC_PCLK,
+	.vector	= X68K_VEC_SCC,
+};
+
+static struct resource scc_a_rsrcs[] = {
+	DEFINE_RES_MEM(0, 1),
+	DEFINE_RES_MEM(0, 1),
+	DEFINE_RES_IRQ(IRQ_X68K_SCC),
+};
+
+static struct resource scc_b_rsrcs[] = {
+	DEFINE_RES_MEM(0, 1),
+	DEFINE_RES_MEM(0, 1),
+	DEFINE_RES_IRQ(IRQ_X68K_SCC),
+};
+
+static int __init x68k_platform_init(void)
+{
+	unsigned long scc = (unsigned long)x68k_io(X68K_SCC);
+
+	if (!MACH_IS_X68K)
+		return -ENODEV;
+
+	scc_a_rsrcs[0].start = scc_a_rsrcs[0].end = scc + X68K_SCC_A_CTRL;
+	scc_a_rsrcs[1].start = scc_a_rsrcs[1].end = scc + X68K_SCC_A_DATA;
+	scc_a_pdev.resource = scc_a_rsrcs;
+	scc_a_pdev.num_resources = ARRAY_SIZE(scc_a_rsrcs);
+	scc_a_pdev.dev.platform_data = &x68k_scc_pdata;
+
+	scc_b_rsrcs[0].start = scc_b_rsrcs[0].end = scc + X68K_SCC_B_CTRL;
+	scc_b_rsrcs[1].start = scc_b_rsrcs[1].end = scc + X68K_SCC_B_DATA;
+	scc_b_pdev.resource = scc_b_rsrcs;
+	scc_b_pdev.num_resources = ARRAY_SIZE(scc_b_rsrcs);
+	scc_b_pdev.dev.platform_data = &x68k_scc_pdata;
+
+	platform_device_register(&scc_a_pdev);
+	platform_device_register(&scc_b_pdev);
+	return 0;
+}
+arch_initcall(x68k_platform_init);
diff --git a/arch/m68k/x68k/ints.c b/arch/m68k/x68k/ints.c
new file mode 100644
index 000000000000..3f8dd1bb7ea4
--- /dev/null
+++ b/arch/m68k/x68k/ints.c
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp X68030 interrupts: every device supplies a vector, only the MFP sources
+ * can be masked here.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+
+#include <asm/io.h>
+#include <asm/irq.h>
+#include <asm/x68k.h>
+
+static void x68k_mfp_update(unsigned int n, bool on)
+{
+	unsigned int bank = n < 8 ? MFP_IERB : MFP_IERA;
+	unsigned int mask = n < 8 ? MFP_IMRB : MFP_IMRA;
+	u8 bit = BIT(n & 7);
+
+	out_8(x68k_mfp(bank), on ? in_8(x68k_mfp(bank)) | bit : in_8(x68k_mfp(bank)) & ~bit);
+	out_8(x68k_mfp(mask), on ? in_8(x68k_mfp(mask)) | bit : in_8(x68k_mfp(mask)) & ~bit);
+}
+
+static void x68k_mfp_mask(struct irq_data *d)
+{
+	x68k_mfp_update(d->irq - IRQ_X68K_MFP(0), false);
+}
+
+static void x68k_mfp_unmask(struct irq_data *d)
+{
+	x68k_mfp_update(d->irq - IRQ_X68K_MFP(0), true);
+}
+
+static unsigned int x68k_mfp_startup(struct irq_data *d)
+{
+	m68k_irq_startup(d);
+	x68k_mfp_unmask(d);
+	return 0;
+}
+
+static void x68k_mfp_shutdown(struct irq_data *d)
+{
+	x68k_mfp_mask(d);
+	m68k_irq_shutdown(d);
+}
+
+static struct irq_chip x68k_mfp_chip = {
+	.name		= "mfp",
+	.irq_startup	= x68k_mfp_startup,
+	.irq_shutdown	= x68k_mfp_shutdown,
+	.irq_mask	= x68k_mfp_mask,
+	.irq_unmask	= x68k_mfp_unmask,
+};
+
+void __init x68k_init_IRQ(void)
+{
+	m68k_setup_user_interrupt(0x40, X68K_VEC_END - 0x40);
+	m68k_setup_irq_controller(&x68k_mfp_chip, handle_simple_irq, IRQ_X68K_MFP(0), 16);
+
+	/* Automatic end of interrupt, nothing left from the ROM */
+	out_8(x68k_mfp(MFP_VR), X68K_VEC_MFP);
+	out_8(x68k_mfp(MFP_IERA), 0);
+	out_8(x68k_mfp(MFP_IERB), 0);
+	out_8(x68k_mfp(MFP_IMRA), 0);
+	out_8(x68k_mfp(MFP_IMRB), 0);
+	out_8(x68k_mfp(MFP_IPRA), 0);
+	out_8(x68k_mfp(MFP_IPRB), 0);
+	out_8(x68k_mfp(MFP_ISRA), 0);
+	out_8(x68k_mfp(MFP_ISRB), 0);
+
+	/* I/O controller vector, its sources stay off until a driver wants them */
+	out_8(x68k_io(X68K_IOC + 1), 0);
+	out_8(x68k_io(X68K_IOC + 3), X68K_VEC_IOC);
+}
diff --git a/arch/m68k/x68k/reset.S b/arch/m68k/x68k/reset.S
new file mode 100644
index 000000000000..ddd65e7a4a0e
--- /dev/null
+++ b/arch/m68k/x68k/reset.S
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Sharp X68030 reset: back to the ROM with address translation off. RAM is mapped
+ * one to one, so this keeps running where it is.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/linkage.h>
+
+#define ROM_RESET_VECTORS	0x00ff0000
+
+ENTRY(x68k_rom_reset)
+	movew	#0x2700,%sr
+	.chip	68030
+	/* Disable and clear both caches */
+	movel	#0x0808,%d0
+	movec	%d0,%cacr
+	clrl	%sp@-
+	pmove	%sp@,%tc
+	pflusha
+	moveq	#0,%d0
+	movec	%d0,%vbr
+	.chip	68k
+	lea	ROM_RESET_VECTORS,%a0
+	movel	%a0@+,%sp
+	movel	%a0@,%a0
+	jmp	%a0@
diff --git a/arch/m68k/x68k/time.c b/arch/m68k/x68k/time.c
new file mode 100644
index 000000000000..b0e34e843fa0
--- /dev/null
+++ b/arch/m68k/x68k/time.c
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp X68030 system tick from MFP timer C
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/clocksource.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/jiffies.h>
+#include <linux/timekeeper_internal.h>
+
+#include <asm/io.h>
+#include <asm/x68k.h>
+
+/* 4 MHz divided by 200 */
+#define TIMER_HZ	20000
+#define TIMER_TICKS	(TIMER_HZ / HZ)
+#define TCDCR_DIV200	0x70
+#define IPRB_TIMER_C	0x20
+
+static u64 x68k_read_clk(struct clocksource *cs)
+{
+	unsigned long flags;
+	u32 ticks, cycles;
+
+	local_irq_save(flags);
+	ticks = in_8(x68k_mfp(MFP_TCDR));
+	cycles = jiffies * TIMER_TICKS + TIMER_TICKS - ticks;
+	/* The counter reloaded but the tick did not run yet */
+	if ((in_8(x68k_mfp(MFP_IPRB)) & IPRB_TIMER_C) && ticks > TIMER_TICKS / 2)
+		cycles += TIMER_TICKS;
+	local_irq_restore(flags);
+	return cycles;
+}
+
+static struct clocksource x68k_clk = {
+	.name	= "mfp-timerc",
+	.rating	= 250,
+	.read	= x68k_read_clk,
+	.mask	= CLOCKSOURCE_MASK(32),
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+};
+
+static irqreturn_t x68k_timer_interrupt(int irq, void *dev_id)
+{
+	legacy_timer_tick(1);
+	return IRQ_HANDLED;
+}
+
+void __init x68k_sched_init(void)
+{
+	out_8(x68k_mfp(MFP_TCDCR), 0);
+	if (request_irq(IRQ_X68K_TIMER, x68k_timer_interrupt, IRQF_TIMER, "timer", NULL))
+		pr_err("Could not allocate timer IRQ\n");
+	out_8(x68k_mfp(MFP_TCDR), TIMER_TICKS);
+	out_8(x68k_mfp(MFP_TCDCR), TCDCR_DIV200);
+
+	clocksource_register_hz(&x68k_clk, TIMER_HZ);
+}
-- 
2.54.0


From 8c1b73664e36029d0302f0900ab1800f06529f18 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 10:25:15 +0100
Subject: [PATCH 03/31] Input: Add Sharp X68000 series keyboard driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The keyboard is a 2400 baud serial device on the USART of the MFP.  The key table
was generated from the MAME keyboard model and checked against XM6.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/input/keyboard/Kconfig   |   6 +
 drivers/input/keyboard/Makefile  |   1 +
 drivers/input/keyboard/x68kkbd.c | 230 +++++++++++++++++++++++++++++++
 3 files changed, 237 insertions(+)
 create mode 100644 drivers/input/keyboard/x68kkbd.c

diff --git a/drivers/input/keyboard/Kconfig b/drivers/input/keyboard/Kconfig
index 167895600ffe..fc21d5efe7bc 100644
--- a/drivers/input/keyboard/Kconfig
+++ b/drivers/input/keyboard/Kconfig
@@ -446,6 +446,12 @@ config KEYBOARD_IMX_SC_KEY
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx_sc_key.
 
+config KEYBOARD_X68K
+	bool "Sharp X68000 series keyboard"
+	depends on X68K
+	help
+	  Say Y here to use the keyboard of a Sharp X68030.
+
 config KEYBOARD_NEXT
 	tristate "NeXT keyboard and mouse"
 	depends on NEXT
diff --git a/drivers/input/keyboard/Makefile b/drivers/input/keyboard/Makefile
index 395590c77633..1a07a60ee176 100644
--- a/drivers/input/keyboard/Makefile
+++ b/drivers/input/keyboard/Makefile
@@ -47,6 +47,7 @@ obj-$(CONFIG_KEYBOARD_MPR121)		+= mpr121_touchkey.o
 obj-$(CONFIG_KEYBOARD_MT6779)		+= mt6779-keypad.o
 obj-$(CONFIG_KEYBOARD_MTK_PMIC) 	+= mtk-pmic-keys.o
 obj-$(CONFIG_KEYBOARD_NEWTON)		+= newtonkbd.o
+obj-$(CONFIG_KEYBOARD_X68K)		+= x68kkbd.o
 obj-$(CONFIG_KEYBOARD_NEXT)		+= nextkbd.o
 obj-$(CONFIG_KEYBOARD_NSPIRE)		+= nspire-keypad.o
 obj-$(CONFIG_KEYBOARD_OMAP)		+= omap-keypad.o
diff --git a/drivers/input/keyboard/x68kkbd.c b/drivers/input/keyboard/x68kkbd.c
new file mode 100644
index 000000000000..ad027aa9214e
--- /dev/null
+++ b/drivers/input/keyboard/x68kkbd.c
@@ -0,0 +1,230 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp X68000 series keyboard, a serial device on the USART of the MFP
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include <asm/io.h>
+#include <asm/x68k.h>
+
+#define MFP_TBCR		13
+#define MFP_TBDR		16
+#define MFP_UCR			20
+#define MFP_RSR			21
+#define MFP_TSR			22
+#define MFP_UDR			23
+
+/* Timer B makes the USART clock: 4 MHz / 4 / 13 / 2 / 16 is 2400 baud */
+#define TBCR_DIV4		0x01
+#define TBDR_2400		13
+#define UCR_DIV16_8N1		0x88
+#define RSR_ENABLE		0x01
+#define RSR_OVERRUN		0x40
+#define RSR_FULL		0x80
+#define TSR_ENABLE		0x05
+
+#define MFP_IRQ_RX_ERROR	IRQ_X68K_MFP(11)
+#define MFP_IRQ_RX_FULL		IRQ_X68K_MFP(12)
+
+#define SYSPORT_KEYCTRL		0x00e8e007
+#define KEYCTRL_ENABLE		0x08
+
+#define KEY_RELEASE		0x80
+
+static const unsigned short x68kkbd_keycodes[128] = {
+	[0x01] = KEY_ESC,
+	[0x02] = KEY_1,
+	[0x03] = KEY_2,
+	[0x04] = KEY_3,
+	[0x05] = KEY_4,
+	[0x06] = KEY_5,
+	[0x07] = KEY_6,
+	[0x08] = KEY_7,
+	[0x09] = KEY_8,
+	[0x0a] = KEY_9,
+	[0x0b] = KEY_0,
+	[0x0c] = KEY_MINUS,
+	[0x0d] = KEY_EQUAL,
+	[0x0e] = KEY_YEN,
+	[0x0f] = KEY_BACKSPACE,
+	[0x10] = KEY_TAB,
+	[0x11] = KEY_Q,
+	[0x12] = KEY_W,
+	[0x13] = KEY_E,
+	[0x14] = KEY_R,
+	[0x15] = KEY_T,
+	[0x16] = KEY_Y,
+	[0x17] = KEY_U,
+	[0x18] = KEY_I,
+	[0x19] = KEY_O,
+	[0x1a] = KEY_P,
+	[0x1b] = KEY_LEFTBRACE,
+	[0x1c] = KEY_RIGHTBRACE,
+	[0x1d] = KEY_ENTER,
+	[0x1e] = KEY_A,
+	[0x1f] = KEY_S,
+	[0x20] = KEY_D,
+	[0x21] = KEY_F,
+	[0x22] = KEY_G,
+	[0x23] = KEY_H,
+	[0x24] = KEY_J,
+	[0x25] = KEY_K,
+	[0x26] = KEY_L,
+	[0x27] = KEY_SEMICOLON,
+	[0x28] = KEY_APOSTROPHE,
+	[0x29] = KEY_BACKSLASH,
+	[0x2a] = KEY_Z,
+	[0x2b] = KEY_X,
+	[0x2c] = KEY_C,
+	[0x2d] = KEY_V,
+	[0x2e] = KEY_B,
+	[0x2f] = KEY_N,
+	[0x30] = KEY_M,
+	[0x31] = KEY_COMMA,
+	[0x32] = KEY_DOT,
+	[0x33] = KEY_SLASH,
+	[0x34] = KEY_RO,
+	[0x35] = KEY_SPACE,
+	[0x36] = KEY_HOME,
+	[0x37] = KEY_DELETE,
+	[0x38] = KEY_PAGEUP,
+	[0x39] = KEY_PAGEDOWN,
+	[0x3a] = KEY_UNDO,
+	[0x3b] = KEY_LEFT,
+	[0x3c] = KEY_UP,
+	[0x3d] = KEY_RIGHT,
+	[0x3e] = KEY_DOWN,
+	[0x3f] = KEY_NUMLOCK,
+	[0x40] = KEY_KPSLASH,
+	[0x41] = KEY_KPASTERISK,
+	[0x42] = KEY_KPMINUS,
+	[0x43] = KEY_KP7,
+	[0x44] = KEY_KP8,
+	[0x45] = KEY_KP9,
+	[0x46] = KEY_KPPLUS,
+	[0x47] = KEY_KP4,
+	[0x48] = KEY_KP5,
+	[0x49] = KEY_KP6,
+	[0x4a] = KEY_KPEQUAL,
+	[0x4b] = KEY_KP1,
+	[0x4c] = KEY_KP2,
+	[0x4d] = KEY_KP3,
+	[0x4e] = KEY_KPENTER,
+	[0x4f] = KEY_KP0,
+	[0x50] = KEY_KPCOMMA,
+	[0x51] = KEY_KPDOT,
+	[0x54] = KEY_HELP,
+	[0x55] = KEY_F11,
+	[0x56] = KEY_F12,
+	[0x59] = KEY_RIGHTALT,
+	[0x5d] = KEY_CAPSLOCK,
+	[0x5e] = KEY_INSERT,
+	[0x5f] = KEY_LEFTALT,
+	[0x60] = KEY_RIGHTCTRL,
+	[0x63] = KEY_F1,
+	[0x64] = KEY_F2,
+	[0x65] = KEY_F3,
+	[0x66] = KEY_F4,
+	[0x67] = KEY_F5,
+	[0x68] = KEY_F6,
+	[0x69] = KEY_F7,
+	[0x6a] = KEY_F8,
+	[0x6b] = KEY_F9,
+	[0x6c] = KEY_F10,
+	[0x70] = KEY_LEFTSHIFT,
+	[0x71] = KEY_LEFTCTRL,
+	[0x72] = KEY_LEFTALT,
+	[0x73] = KEY_RIGHTALT,
+};
+
+struct x68kkbd {
+	struct input_dev *input;
+	unsigned short keycodes[ARRAY_SIZE(x68kkbd_keycodes)];
+};
+
+static irqreturn_t x68kkbd_interrupt(int irq, void *dev_id)
+{
+	struct x68kkbd *kbd = dev_id;
+	u8 rsr = in_8(x68k_mfp(MFP_RSR));
+	u8 code;
+
+	if (!(rsr & RSR_FULL))
+		return IRQ_HANDLED;
+
+	code = in_8(x68k_mfp(MFP_UDR));
+	if (kbd->keycodes[code & ~KEY_RELEASE]) {
+		input_report_key(kbd->input, kbd->keycodes[code & ~KEY_RELEASE],
+				 !(code & KEY_RELEASE));
+		input_sync(kbd->input);
+	}
+	return IRQ_HANDLED;
+}
+
+static int x68kkbd_probe(struct platform_device *pdev)
+{
+	struct x68kkbd *kbd;
+	struct input_dev *input;
+	int i, err;
+
+	kbd = devm_kzalloc(&pdev->dev, sizeof(*kbd), GFP_KERNEL);
+	if (!kbd)
+		return -ENOMEM;
+	input = devm_input_allocate_device(&pdev->dev);
+	if (!input)
+		return -ENOMEM;
+	kbd->input = input;
+	memcpy(kbd->keycodes, x68kkbd_keycodes, sizeof(kbd->keycodes));
+
+	input->name = "X68000 Keyboard";
+	input->phys = "x68kkbd/input0";
+	input->id.bustype = BUS_RS232;
+	input->keycode = kbd->keycodes;
+	input->keycodesize = sizeof(kbd->keycodes[0]);
+	input->keycodemax = ARRAY_SIZE(kbd->keycodes);
+	__set_bit(EV_KEY, input->evbit);
+	__set_bit(EV_REP, input->evbit);
+	for (i = 0; i < ARRAY_SIZE(kbd->keycodes); i++)
+		__set_bit(kbd->keycodes[i], input->keybit);
+	__clear_bit(KEY_RESERVED, input->keybit);
+
+	err = input_register_device(input);
+	if (err)
+		return err;
+
+	out_8(x68k_mfp(MFP_RSR), 0);
+	out_8(x68k_mfp(MFP_TSR), 0);
+	out_8(x68k_mfp(MFP_TBCR), 0);
+	out_8(x68k_mfp(MFP_TBDR), TBDR_2400);
+	out_8(x68k_mfp(MFP_TBCR), TBCR_DIV4);
+	out_8(x68k_mfp(MFP_UCR), UCR_DIV16_8N1);
+
+	err = devm_request_irq(&pdev->dev, MFP_IRQ_RX_FULL, x68kkbd_interrupt, 0, "x68kkbd", kbd);
+	if (err)
+		return err;
+	err = devm_request_irq(&pdev->dev, MFP_IRQ_RX_ERROR, x68kkbd_interrupt, 0, "x68kkbd", kbd);
+	if (err)
+		return err;
+
+	out_8(x68k_mfp(MFP_RSR), RSR_ENABLE);
+	out_8(x68k_mfp(MFP_TSR), TSR_ENABLE);
+	out_8(x68k_io(SYSPORT_KEYCTRL), KEYCTRL_ENABLE);
+	return 0;
+}
+
+static struct platform_driver x68kkbd_driver = {
+	.probe	= x68kkbd_probe,
+	.driver	= {
+		.name = "x68kkbd",
+	},
+};
+builtin_platform_driver(x68kkbd_driver);
+
+MODULE_DESCRIPTION("Sharp X68000 keyboard driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 4702e54334dcb44219ec541bd05e99938d2efebd Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 10:25:16 +0100
Subject: [PATCH 04/31] fbdev: Add Sharp X68030 text screen driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Use one plane of the text VRAM as a monochrome framebuffer, in the 768x512 mode
the ROM set up.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/x68k_defconfig |  9 +++
 arch/m68k/x68k/config.c          |  2 +
 drivers/video/fbdev/Kconfig      |  8 +++
 drivers/video/fbdev/Makefile     |  1 +
 drivers/video/fbdev/x68kfb.c     | 95 ++++++++++++++++++++++++++++++++
 5 files changed, 115 insertions(+)
 create mode 100644 drivers/video/fbdev/x68kfb.c

diff --git a/arch/m68k/configs/x68k_defconfig b/arch/m68k/configs/x68k_defconfig
index 847e8fcded21..ce07da0529cd 100644
--- a/arch/m68k/configs/x68k_defconfig
+++ b/arch/m68k/configs/x68k_defconfig
@@ -20,6 +20,7 @@ CONFIG_NET=y
 CONFIG_PACKET=y
 CONFIG_UNIX=y
 CONFIG_INET=y
+# CONFIG_IPV6 is not set
 CONFIG_DEVTMPFS=y
 CONFIG_DEVTMPFS_MOUNT=y
 CONFIG_BLK_DEV=y
@@ -27,5 +28,13 @@ CONFIG_BLK_DEV_LOOP=y
 CONFIG_SERIAL_PMACZILOG=y
 CONFIG_SERIAL_PMACZILOG_TTYS=y
 CONFIG_SERIAL_PMACZILOG_CONSOLE=y
+CONFIG_INPUT_EVDEV=y
+CONFIG_KEYBOARD_X68K=y
 CONFIG_VT=y
 CONFIG_VT_CONSOLE=y
+CONFIG_FB=y
+CONFIG_FB_X68K=y
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_FONT_SUPPORT=y
+CONFIG_FONTS=y
+CONFIG_FONT_8x16=y
diff --git a/arch/m68k/x68k/config.c b/arch/m68k/x68k/config.c
index 4fbbca88c4ac..0f242ca2afdf 100644
--- a/arch/m68k/x68k/config.c
+++ b/arch/m68k/x68k/config.c
@@ -84,6 +84,8 @@ static int __init x68k_platform_init(void)
 
 	platform_device_register(&scc_a_pdev);
 	platform_device_register(&scc_b_pdev);
+	platform_device_register_simple("x68kfb", -1, NULL, 0);
+	platform_device_register_simple("x68kkbd", -1, NULL, 0);
 	return 0;
 }
 arch_initcall(x68k_platform_init);
diff --git a/drivers/video/fbdev/Kconfig b/drivers/video/fbdev/Kconfig
index d0d065aa53b4..34f24ab52d5e 100644
--- a/drivers/video/fbdev/Kconfig
+++ b/drivers/video/fbdev/Kconfig
@@ -198,6 +198,14 @@ config FB_Q40
 	default y
 	select FB_IOMEM_HELPERS
 
+config FB_X68K
+	bool "Sharp X68030 text screen support"
+	depends on (FB = y) && X68K
+	select FB_IOMEM_HELPERS
+	help
+	  Support for the text screen of the Sharp X68030 as a monochrome
+	  framebuffer.
+
 config FB_NEXTDIMENSION
 	bool "NeXTdimension framebuffer support"
 	depends on (FB = y) && NEXT
diff --git a/drivers/video/fbdev/Makefile b/drivers/video/fbdev/Makefile
index 2516e26c9cab..a4907591eb60 100644
--- a/drivers/video/fbdev/Makefile
+++ b/drivers/video/fbdev/Makefile
@@ -65,6 +65,7 @@ obj-$(CONFIG_FB_XVR1000)          += sunxvr1000.o
 obj-$(CONFIG_FB_APOLLO)           += dnfb.o
 obj-$(CONFIG_FB_Q40)              += q40fb.o
 obj-$(CONFIG_FB_NEXT)             += nextfb.o
+obj-$(CONFIG_FB_X68K)             += x68kfb.o
 obj-$(CONFIG_FB_NEXTDIMENSION)    += nextdimfb.o
 obj-$(CONFIG_FB_TGA)              += tgafb.o
 obj-$(CONFIG_FB_HP300)            += hpfb.o
diff --git a/drivers/video/fbdev/x68kfb.c b/drivers/video/fbdev/x68kfb.c
new file mode 100644
index 000000000000..e0b6a2833116
--- /dev/null
+++ b/drivers/video/fbdev/x68kfb.c
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp X68030 text screen as a monochrome framebuffer, in the mode the ROM set up.
+ * Of the four separately addressed planes of 1024x1024 pixels, one is used.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/fb.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include <asm/io.h>
+#include <asm/x68k.h>
+
+#define TVRAM_PHYS	0x00e00000
+#define TVRAM_PLANES	4
+#define TVRAM_PLANE	0x00020000
+#define TVRAM_PITCH	128
+
+#define CRTC_R10	0x00e80014	/* text scroll, x */
+#define CRTC_R11	0x00e80016	/* and y */
+#define CRTC_R21	0x00e8002a	/* simultaneous plane access and masking */
+#define TEXT_PALETTE	0x00e82200	/* green 5, red 5, blue 5, intensity */
+#define PALETTE_WHITE	0xfffe
+
+#define X68KFB_WIDTH	768
+#define X68KFB_HEIGHT	512
+
+static const struct fb_ops x68kfb_ops = {
+	.owner		= THIS_MODULE,
+	FB_DEFAULT_IOMEM_OPS,
+};
+
+static int x68kfb_probe(struct platform_device *pdev)
+{
+	struct fb_info *info;
+	void __iomem *pal = x68k_io(TEXT_PALETTE);
+	int i, err;
+
+	info = framebuffer_alloc(0, &pdev->dev);
+	if (!info)
+		return -ENOMEM;
+
+	strscpy(info->fix.id, "x68kfb", sizeof(info->fix.id));
+	info->fix.smem_start = TVRAM_PHYS;
+	info->fix.smem_len = TVRAM_PLANE;
+	info->fix.type = FB_TYPE_PACKED_PIXELS;
+	info->fix.visual = FB_VISUAL_MONO10;
+	info->fix.line_length = TVRAM_PITCH;
+	info->fix.accel = FB_ACCEL_NONE;
+
+	info->var.xres = info->var.xres_virtual = X68KFB_WIDTH;
+	info->var.yres = info->var.yres_virtual = X68KFB_HEIGHT;
+	info->var.bits_per_pixel = 1;
+	info->var.red.length = info->var.green.length = info->var.blue.length = 1;
+	info->var.activate = FB_ACTIVATE_NOW;
+	info->var.vmode = FB_VMODE_NONINTERLACED;
+	info->var.height = info->var.width = -1;
+
+	info->fbops = &x68kfb_ops;
+	info->screen_base = x68k_io(TVRAM_PHYS);
+	info->screen_size = TVRAM_PLANE;
+
+	/* Plain access to one plane, nothing left on the screen from the ROM */
+	out_be16(x68k_io(CRTC_R21), 0);
+	out_be16(x68k_io(CRTC_R10), 0);
+	out_be16(x68k_io(CRTC_R11), 0);
+	for (i = 0; i < TVRAM_PLANES; i++)
+		memset_io(info->screen_base + i * TVRAM_PLANE, 0, TVRAM_PLANE);
+	for (i = 0; i < 16; i++)
+		out_be16(pal + 2 * i, i & 1 ? PALETTE_WHITE : 0);
+
+	err = register_framebuffer(info);
+	if (err) {
+		framebuffer_release(info);
+		return err;
+	}
+	platform_set_drvdata(pdev, info);
+	fb_info(info, "X68030 text screen, %ux%u\n", X68KFB_WIDTH, X68KFB_HEIGHT);
+	return 0;
+}
+
+static struct platform_driver x68kfb_driver = {
+	.probe	= x68kfb_probe,
+	.driver	= {
+		.name = "x68kfb",
+	},
+};
+builtin_platform_driver(x68kfb_driver);
+
+MODULE_DESCRIPTION("Sharp X68030 text screen framebuffer driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From e108038cb8154ba43f873913d6847f15b2f97c7a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 10:46:32 +0100
Subject: [PATCH 05/31] block: partitions: Add Human68k partition table parser
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Sharp X68000 series keeps the table in the second 1 KiB block of a SCSI disk
marked with the X68SCSI1 signature, with positions in 1 KiB blocks.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 block/partitions/Kconfig    |  7 +++++
 block/partitions/Makefile   |  1 +
 block/partitions/check.h    |  1 +
 block/partitions/core.c     |  3 ++
 block/partitions/human68k.c | 62 +++++++++++++++++++++++++++++++++++++
 5 files changed, 74 insertions(+)
 create mode 100644 block/partitions/human68k.c

diff --git a/block/partitions/Kconfig b/block/partitions/Kconfig
index 89cdf9ebe134..17c81bca78a5 100644
--- a/block/partitions/Kconfig
+++ b/block/partitions/Kconfig
@@ -217,6 +217,13 @@ config SGI_PARTITION
 	  Say Y here if you would like to be able to read the hard disk
 	  partition table format used by SGI machines.
 
+config HUMAN68K_PARTITION
+	bool "Human68k partition table support" if PARTITION_ADVANCED
+	default y if X68K
+	help
+	  Say Y here to read the partition table of SCSI disks of the Sharp
+	  X68000 series, as written by Human68k or mkx68kdisk.
+
 config NEXT_PARTITION
 	bool "NeXT disk label support" if PARTITION_ADVANCED
 	default y if NEXT
diff --git a/block/partitions/Makefile b/block/partitions/Makefile
index 8d461372b2e5..1f77bc62e51b 100644
--- a/block/partitions/Makefile
+++ b/block/partitions/Makefile
@@ -16,6 +16,7 @@ obj-$(CONFIG_OF_PARTITION) += of.o
 obj-$(CONFIG_OSF_PARTITION) += osf.o
 obj-$(CONFIG_SGI_PARTITION) += sgi.o
 obj-$(CONFIG_SUN_PARTITION) += sun.o
+obj-$(CONFIG_HUMAN68K_PARTITION) += human68k.o
 obj-$(CONFIG_NEXT_PARTITION) += next.o
 obj-$(CONFIG_ULTRIX_PARTITION) += ultrix.o
 obj-$(CONFIG_IBM_PARTITION) += ibm.o
diff --git a/block/partitions/check.h b/block/partitions/check.h
index 8e8980555c2a..dafa7af7abe4 100644
--- a/block/partitions/check.h
+++ b/block/partitions/check.h
@@ -60,6 +60,7 @@ int karma_partition(struct parsed_partitions *state);
 int ldm_partition(struct parsed_partitions *state);
 int mac_partition(struct parsed_partitions *state);
 int msdos_partition(struct parsed_partitions *state);
+int human68k_partition(struct parsed_partitions *state);
 int next_partition(struct parsed_partitions *state);
 int of_partition(struct parsed_partitions *state);
 int osf_partition(struct parsed_partitions *state);
diff --git a/block/partitions/core.c b/block/partitions/core.c
index 36429fc19c75..c2e5036af33d 100644
--- a/block/partitions/core.c
+++ b/block/partitions/core.c
@@ -57,6 +57,9 @@ static int (*const check_part[])(struct parsed_partitions *) = {
 #ifdef CONFIG_LDM_PARTITION
 	ldm_partition,		/* this must come before msdos */
 #endif
+#ifdef CONFIG_HUMAN68K_PARTITION
+	human68k_partition,	/* has a signature, msdos only checks a word */
+#endif
 #ifdef CONFIG_NEXT_PARTITION
 	next_partition,		/* the label has a checksum, msdos only a signature */
 #endif
diff --git a/block/partitions/human68k.c b/block/partitions/human68k.c
new file mode 100644
index 000000000000..dd45f3c5c015
--- /dev/null
+++ b/block/partitions/human68k.c
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Human68k partition table of Sharp X68000 series SCSI disks
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/string.h>
+#include "check.h"
+
+#define H68K_DISK_MAGIC		"X68SCSI1"
+#define H68K_TABLE_MAGIC	"X68K"
+#define H68K_TABLE_SECTOR	4	/* in 512 byte sectors */
+#define H68K_ENTRIES		8
+#define H68K_FLAG_UNUSED	1
+#define H68K_BLOCK_SECTORS	2	/* positions are in 1 KiB blocks */
+
+struct h68k_partition {
+	char name[8];
+	u8 flag;
+	u8 start[3];
+	__be32 size;
+} __packed;
+
+int human68k_partition(struct parsed_partitions *state)
+{
+	const struct h68k_partition *entry;
+	Sector sect;
+	u8 *data;
+	bool found;
+	int i;
+
+	data = read_part_sector(state, 0, &sect);
+	if (!data)
+		return -1;
+	found = !memcmp(data, H68K_DISK_MAGIC, strlen(H68K_DISK_MAGIC));
+	put_dev_sector(sect);
+	if (!found)
+		return 0;
+
+	data = read_part_sector(state, H68K_TABLE_SECTOR, &sect);
+	if (!data)
+		return -1;
+	entry = (const struct h68k_partition *)data;
+	if (memcmp(entry[0].name, H68K_TABLE_MAGIC, strlen(H68K_TABLE_MAGIC))) {
+		put_dev_sector(sect);
+		return 0;
+	}
+
+	/* The first entry is the header */
+	for (i = 1; i < H68K_ENTRIES; i++) {
+		u32 start = entry[i].start[0] << 16 | entry[i].start[1] << 8 | entry[i].start[2];
+		u32 size = be32_to_cpu(entry[i].size);
+
+		if (entry[i].flag != H68K_FLAG_UNUSED && start && size)
+			put_partition(state, i, (sector_t)start * H68K_BLOCK_SECTORS,
+				      (sector_t)size * H68K_BLOCK_SECTORS);
+	}
+	put_dev_sector(sect);
+	seq_buf_puts(&state->pp_buf, "\n");
+	return 1;
+}
-- 
2.54.0


From e553a5d8d3f2a5c6c9e57cb67ec90b4c9f680823 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 10:46:32 +0100
Subject: [PATCH 06/31] scsi: Add Sharp X68030 internal SCSI driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Drive the Fujitsu MB89352 with programmed I/O from a worker, one command at a
time and without disconnects.  The chip keeps ACK asserted on the last message in
byte until it is told otherwise, the target only frees the bus after that.

Have mkx68kdisk add a partition over the rest of the disk, and make the default
configuration smaller as these machines have at most 12 MB of memory.

Tested on MAME with a disk and a CD-ROM.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/x68k_defconfig |  18 +-
 arch/m68k/x68k/boot/mkx68kdisk.c |  46 +++-
 arch/m68k/x68k/config.c          |   1 +
 drivers/scsi/Kconfig             |   7 +
 drivers/scsi/Makefile            |   1 +
 drivers/scsi/x68k_spc.c          | 388 +++++++++++++++++++++++++++++++
 6 files changed, 457 insertions(+), 4 deletions(-)
 create mode 100644 drivers/scsi/x68k_spc.c

diff --git a/arch/m68k/configs/x68k_defconfig b/arch/m68k/configs/x68k_defconfig
index ce07da0529cd..bdf881772c33 100644
--- a/arch/m68k/configs/x68k_defconfig
+++ b/arch/m68k/configs/x68k_defconfig
@@ -3,17 +3,22 @@ CONFIG_SYSVIPC=y
 CONFIG_POSIX_MQUEUE=y
 CONFIG_NO_HZ_IDLE=y
 CONFIG_HIGH_RES_TIMERS=y
-CONFIG_LOG_BUF_SHIFT=16
+CONFIG_LOG_BUF_SHIFT=15
 CONFIG_BLK_DEV_INITRD=y
 CONFIG_CC_OPTIMIZE_FOR_SIZE=y
 CONFIG_EXPERT=y
+CONFIG_BASE_SMALL=y
+CONFIG_SLUB_TINY=y
+# CONFIG_IO_URING is not set
+# CONFIG_AIO is not set
+# CONFIG_BPF_SYSCALL is not set
+# CONFIG_KALLSYMS_ALL is not set
+# CONFIG_COMPAT_BRK is not set
 CONFIG_M68KCLASSIC=y
 CONFIG_M68030=y
 CONFIG_M68KFPU_EMU=y
 CONFIG_X68K=y
 CONFIG_BOOTINFO_PROC=y
-CONFIG_MODULES=y
-CONFIG_MODULE_UNLOAD=y
 CONFIG_PARTITION_ADVANCED=y
 CONFIG_SWAP=y
 CONFIG_NET=y
@@ -25,6 +30,11 @@ CONFIG_DEVTMPFS=y
 CONFIG_DEVTMPFS_MOUNT=y
 CONFIG_BLK_DEV=y
 CONFIG_BLK_DEV_LOOP=y
+CONFIG_BLK_DEV_SD=y
+CONFIG_BLK_DEV_SR=y
+CONFIG_SCSI=y
+CONFIG_SCSI_LOWLEVEL=y
+CONFIG_SCSI_X68K_SPC=y
 CONFIG_SERIAL_PMACZILOG=y
 CONFIG_SERIAL_PMACZILOG_TTYS=y
 CONFIG_SERIAL_PMACZILOG_CONSOLE=y
@@ -38,3 +48,5 @@ CONFIG_FRAMEBUFFER_CONSOLE=y
 CONFIG_FONT_SUPPORT=y
 CONFIG_FONTS=y
 CONFIG_FONT_8x16=y
+CONFIG_EXT2_FS=y
+CONFIG_ISO9660_FS=y
diff --git a/arch/m68k/x68k/boot/mkx68kdisk.c b/arch/m68k/x68k/boot/mkx68kdisk.c
index 97225c066634..6401bf614be9 100644
--- a/arch/m68k/x68k/boot/mkx68kdisk.c
+++ b/arch/m68k/x68k/boot/mkx68kdisk.c
@@ -12,25 +12,51 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <sys/ioctl.h>
 #include <sys/stat.h>
 #include <unistd.h>
+#include <linux/fs.h>
 
 #define BLOCK		512
 #define LOADER_SIZE	16384
 #define BOOT_OFFSET	1024
+#define TABLE_OFFSET	2048
 #define PARAMS_OFFSET	14	/* behind the branch and the signature */
 #define REST_BLOCK	32	/* room for a partition table before it */
 #define KERNEL_BLOCK	(REST_BLOCK + LOADER_SIZE / BLOCK)
 
+struct partition {
+	char name[8];
+	uint8_t flag;
+	uint8_t start[3];
+	uint32_t size;
+} __attribute__((packed));
+
 static void die(const char *what)
 {
 	perror(what);
 	exit(1);
 }
 
+static uint64_t disk_size(int fd)
+{
+	struct stat st;
+	uint64_t size;
+
+	if (fstat(fd, &st))
+		die("stat");
+	if (!S_ISBLK(st.st_mode))
+		return st.st_size;
+	if (ioctl(fd, BLKGETSIZE64, &size))
+		die("BLKGETSIZE64");
+	return size;
+}
+
 int main(int argc, char **argv)
 {
+	struct partition table[8] = {};
 	struct stat st;
+	uint32_t first, total;
 	uint32_t *params;
 	char sector[BLOCK] = "X68SCSI1";
 	char *img;
@@ -64,12 +90,30 @@ int main(int argc, char **argv)
 	params[2] = htonl(REST_BLOCK);
 	params[3] = htonl((LOADER_SIZE - 1024) / BLOCK);
 
+	/* One partition over the rest of the disk, in 1 KiB blocks */
+	first = ((off_t)KERNEL_BLOCK * BLOCK + kernel + 1023) / 1024;
+	total = disk_size(disk) / 1024;
+	if (first >= total) {
+		fprintf(stderr, "%s: too small\n", argv[1]);
+		return 1;
+	}
+	memcpy(table[0].name, "X68K", 4);
+	memcpy(table[1].name, "Linux   ", 8);
+	table[1].start[0] = first >> 16;
+	table[1].start[1] = first >> 8;
+	table[1].start[2] = first;
+	table[1].size = htonl(total - first);
+
+	if (pwrite(disk, table, sizeof(table), TABLE_OFFSET) != sizeof(table))
+		die("partition table");
+
 	if (pwrite(disk, sector, BLOCK, 0) != BLOCK ||
 	    pwrite(disk, img, 1024, BOOT_OFFSET) != 1024 ||
 	    pwrite(disk, img + 1024, LOADER_SIZE - 1024, (off_t)REST_BLOCK * BLOCK) !=
 		    LOADER_SIZE - 1024 ||
 	    pwrite(disk, img + LOADER_SIZE, kernel, (off_t)KERNEL_BLOCK * BLOCK) != kernel)
 		die("write");
-	printf("%s: kernel of %zd KiB at block %d\n", argv[1], kernel / 1024, KERNEL_BLOCK);
+	printf("%s: kernel of %zd KiB at block %d, partition 1 at %u KiB\n", argv[1],
+	       kernel / 1024, KERNEL_BLOCK, first);
 	return close(disk) ? 1 : 0;
 }
diff --git a/arch/m68k/x68k/config.c b/arch/m68k/x68k/config.c
index 0f242ca2afdf..51d7bafce979 100644
--- a/arch/m68k/x68k/config.c
+++ b/arch/m68k/x68k/config.c
@@ -86,6 +86,7 @@ static int __init x68k_platform_init(void)
 	platform_device_register(&scc_b_pdev);
 	platform_device_register_simple("x68kfb", -1, NULL, 0);
 	platform_device_register_simple("x68kkbd", -1, NULL, 0);
+	platform_device_register_simple("x68k_spc", -1, NULL, 0);
 	return 0;
 }
 arch_initcall(x68k_platform_init);
diff --git a/drivers/scsi/Kconfig b/drivers/scsi/Kconfig
index d3b4d0cdd893..f10350f233ff 100644
--- a/drivers/scsi/Kconfig
+++ b/drivers/scsi/Kconfig
@@ -1395,6 +1395,13 @@ config MAC_SCSI
 	  SCSI-HOWTO, available from
 	  <http://www.tldp.org/docs.html#howto>.
 
+config SCSI_X68K_SPC
+	tristate "Sharp X68030 internal SCSI support"
+	depends on X68K && SCSI
+	help
+	  This driver supports the internal SCSI of the Sharp X68030, a Fujitsu
+	  MB89352 protocol controller.
+
 config SCSI_NEXT_ESP
 	tristate "NeXT NCR53C90 SCSI"
 	depends on NEXT && SCSI
diff --git a/drivers/scsi/Makefile b/drivers/scsi/Makefile
index 175ffe69b04e..d5006427a241 100644
--- a/drivers/scsi/Makefile
+++ b/drivers/scsi/Makefile
@@ -61,6 +61,7 @@ obj-$(CONFIG_SGIWD93_SCSI)	+= sgiwd93.o	wd33c93.o
 obj-$(CONFIG_ATARI_SCSI)	+= atari_scsi.o
 obj-$(CONFIG_MAC_SCSI)		+= mac_scsi.o
 obj-$(CONFIG_SCSI_MAC_ESP)	+= esp_scsi.o	mac_esp.o
+obj-$(CONFIG_SCSI_X68K_SPC)	+= x68k_spc.o
 obj-$(CONFIG_SCSI_NEXT_ESP)	+= esp_scsi.o	next_esp.o
 obj-$(CONFIG_SUN3_SCSI)		+= sun3_scsi.o  sun3_scsi_vme.o
 obj-$(CONFIG_MVME16x_SCSI)	+= 53c700.o	mvme16x_scsi.o
diff --git a/drivers/scsi/x68k_spc.c b/drivers/scsi/x68k_spc.c
new file mode 100644
index 000000000000..32896c814369
--- /dev/null
+++ b/drivers/scsi/x68k_spc.c
@@ -0,0 +1,388 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp X68030 internal SCSI, a Fujitsu MB89352 protocol controller. Commands run one
+ * at a time from a worker with programmed I/O, targets may not disconnect.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/blkdev.h>
+#include <linux/delay.h>
+#include <linux/highmem.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/scatterlist.h>
+#include <linux/workqueue.h>
+
+#include <scsi/scsi.h>
+#include <scsi/scsi_cmnd.h>
+#include <scsi/scsi_device.h>
+#include <scsi/scsi_eh.h>
+#include <scsi/scsi_host.h>
+#include <scsi/scsi_tcq.h>
+
+#include <asm/io.h>
+#include <asm/x68k.h>
+
+#define SPC_BASE	0x00e96020
+
+#define SPC_BDID	0
+#define SPC_SCTL	1
+#define SPC_SCMD	2
+#define SPC_TMOD	3
+#define SPC_INTS	4
+#define SPC_PSNS	5	/* read */
+#define SPC_SDGC	5	/* write */
+#define SPC_SSTS	6
+#define SPC_SERR	7
+#define SPC_PCTL	8
+#define SPC_DREG	10
+#define SPC_TEMP	11
+#define SPC_TCH		12
+#define SPC_TCM		13
+#define SPC_TCL		14
+
+#define SCTL_ARBIT	0x10
+#define SCTL_RESET	0x80
+
+#define SCMD_RST_OUT	0x10
+#define SCMD_PRG_XFER	0x04
+#define SCMD_SELECT	0x20
+#define SCMD_TRANSFER	0x80
+#define SCMD_RESET_ACK	0xc0
+
+#define INTS_RESET	0x01
+#define INTS_HARD_ERR	0x02
+#define INTS_TIMEOUT	0x04
+#define INTS_SERVICE	0x08
+#define INTS_COMPLETE	0x10
+#define INTS_DISCONN	0x20
+
+#define PSNS_REQ	0x80
+#define PSNS_PHASE	0x07
+
+#define SSTS_EMPTY	0x01
+#define SSTS_FULL	0x02
+
+#define PCTL_BFIE	0x80
+
+/* I/O, C/D and MSG lines */
+#define PHASE_DATA_OUT	0
+#define PHASE_DATA_IN	1
+#define PHASE_COMMAND	2
+#define PHASE_STATUS	3
+#define PHASE_MSG_OUT	6
+#define PHASE_MSG_IN	7
+
+#define MSG_NOP		0x08
+
+#define SELECT_TC	0x2000		/* the time out, about 250 ms */
+#define HOST_ID		7
+
+#define CMD_TIMEOUT	(10 * HZ)
+#define RESET_DELAY_MS	500
+
+struct x68k_spc {
+	struct Scsi_Host *host;
+	void __iomem *regs;
+	struct work_struct work;
+	struct scsi_cmnd *cmd;
+	unsigned long deadline;
+};
+
+static u8 spc_read(struct x68k_spc *spc, unsigned int reg)
+{
+	return in_8(spc->regs + 2 * reg + 1);
+}
+
+static void spc_write(struct x68k_spc *spc, unsigned int reg, u8 val)
+{
+	out_8(spc->regs + 2 * reg + 1, val);
+}
+
+static void spc_set_tc(struct x68k_spc *spc, u32 count)
+{
+	spc_write(spc, SPC_TCH, count >> 16);
+	spc_write(spc, SPC_TCM, count >> 8);
+	spc_write(spc, SPC_TCL, count);
+}
+
+static bool spc_timed_out(struct x68k_spc *spc)
+{
+	cond_resched();
+	return time_after(jiffies, spc->deadline);
+}
+
+static int spc_select(struct x68k_spc *spc, unsigned int id)
+{
+	u8 ints;
+
+	spc_write(spc, SPC_PCTL, 0);
+	spc_write(spc, SPC_INTS, 0xff);
+	spc_write(spc, SPC_TEMP, BIT(id) | BIT(HOST_ID));
+	spc_set_tc(spc, SELECT_TC);
+	spc_write(spc, SPC_SCMD, SCMD_SELECT);
+
+	while (!((ints = spc_read(spc, SPC_INTS)) & (INTS_COMPLETE | INTS_TIMEOUT | INTS_HARD_ERR))) {
+		if (spc_timed_out(spc))
+			return DID_ERROR;
+	}
+	spc_write(spc, SPC_INTS, ints);
+
+	if (ints & INTS_COMPLETE)
+		return DID_OK;
+	return ints & INTS_TIMEOUT ? DID_NO_CONNECT : DID_ERROR;
+}
+
+/* Transfer in the current phase. A phase change ends it early, returns the bytes moved */
+static int spc_xfer(struct x68k_spc *spc, unsigned int phase, u8 *buf, unsigned int len)
+{
+	bool in = phase & 1;
+	unsigned int done = 0;
+	u8 ints;
+
+	spc_write(spc, SPC_PCTL, phase | PCTL_BFIE);
+	spc_set_tc(spc, len);
+	spc_write(spc, SPC_INTS, 0xff);
+	spc_write(spc, SPC_SCMD, SCMD_TRANSFER | SCMD_PRG_XFER);
+
+	while (done < len) {
+		u8 ssts = spc_read(spc, SPC_SSTS);
+
+		if (in && !(ssts & SSTS_EMPTY)) {
+			buf[done++] = spc_read(spc, SPC_DREG);
+			continue;
+		}
+		if (!in && !(ssts & SSTS_FULL)) {
+			spc_write(spc, SPC_DREG, buf[done++]);
+			continue;
+		}
+		if (spc_read(spc, SPC_INTS) & (INTS_SERVICE | INTS_DISCONN | INTS_COMPLETE | INTS_HARD_ERR))
+			break;
+		if (spc_timed_out(spc))
+			return -ETIMEDOUT;
+	}
+
+	while (!((ints = spc_read(spc, SPC_INTS)) & (INTS_COMPLETE | INTS_SERVICE | INTS_DISCONN |
+						     INTS_HARD_ERR))) {
+		if (spc_timed_out(spc))
+			return -ETIMEDOUT;
+	}
+	/* What the target sent before it changed the phase */
+	while (in && done < len && !(spc_read(spc, SPC_SSTS) & SSTS_EMPTY))
+		buf[done++] = spc_read(spc, SPC_DREG);
+
+	spc_write(spc, SPC_INTS, ints & ~INTS_DISCONN);
+	if (ints & INTS_HARD_ERR)
+		return -EIO;
+	return done;
+}
+
+static int spc_xfer_data(struct x68k_spc *spc, struct scsi_cmnd *cmd, unsigned int phase,
+			 unsigned int *residual)
+{
+	struct sg_mapping_iter miter;
+	unsigned int flags = (phase & 1 ? SG_MITER_TO_SG : SG_MITER_FROM_SG);
+	int err = 0;
+
+	sg_miter_start(&miter, scsi_sglist(cmd), scsi_sg_count(cmd), flags);
+	while (*residual && sg_miter_next(&miter)) {
+		unsigned int n = min_t(unsigned int, miter.length, *residual);
+		int done = spc_xfer(spc, phase, miter.addr, n);
+
+		if (done < 0) {
+			err = done;
+			break;
+		}
+		miter.consumed = done;
+		*residual -= done;
+		if (done < n)
+			break;
+	}
+	sg_miter_stop(&miter);
+	return err;
+}
+
+static void spc_reset_bus(struct x68k_spc *spc)
+{
+	spc_write(spc, SPC_SCMD, SCMD_RST_OUT);
+	udelay(100);
+	spc_write(spc, SPC_SCMD, 0);
+	msleep(RESET_DELAY_MS);
+	spc_write(spc, SPC_INTS, 0xff);
+}
+
+static void spc_init(struct x68k_spc *spc)
+{
+	spc_write(spc, SPC_SCTL, SCTL_RESET);
+	spc_write(spc, SPC_BDID, HOST_ID);
+	spc_write(spc, SPC_SCMD, 0);
+	spc_write(spc, SPC_TMOD, 0);
+	spc_write(spc, SPC_PCTL, 0);
+	spc_write(spc, SPC_SDGC, 0);
+	spc_set_tc(spc, 0);
+	spc_write(spc, SPC_SCTL, SCTL_ARBIT);
+	spc_write(spc, SPC_INTS, 0xff);
+}
+
+static int spc_run(struct x68k_spc *spc, struct scsi_cmnd *cmd)
+{
+	unsigned int residual = scsi_bufflen(cmd);
+	u8 status = SAM_STAT_CHECK_CONDITION, msg = 0, nop = MSG_NOP;
+	int host;
+
+	spc->deadline = jiffies + CMD_TIMEOUT;
+	scsi_set_resid(cmd, residual);
+
+	host = spc_select(spc, cmd->device->id);
+	if (host != DID_OK)
+		return host << 16;
+
+	for (;;) {
+		u8 psns = spc_read(spc, SPC_PSNS);
+		u8 ints = spc_read(spc, SPC_INTS);
+		int done = 0;
+
+		if (ints & INTS_DISCONN) {
+			spc_write(spc, SPC_INTS, ints);
+			scsi_set_resid(cmd, residual);
+			return status;
+		}
+		if (!(psns & PSNS_REQ)) {
+			if (spc_timed_out(spc))
+				return DID_TIME_OUT << 16;
+			continue;
+		}
+
+		switch (psns & PSNS_PHASE) {
+		case PHASE_COMMAND:
+			done = spc_xfer(spc, PHASE_COMMAND, cmd->cmnd, cmd->cmd_len);
+			break;
+		case PHASE_DATA_IN:
+		case PHASE_DATA_OUT:
+			if (!residual)
+				return DID_ERROR << 16;
+			done = spc_xfer_data(spc, cmd, psns & PSNS_PHASE, &residual);
+			break;
+		case PHASE_STATUS:
+			done = spc_xfer(spc, PHASE_STATUS, &status, 1);
+			break;
+		case PHASE_MSG_IN:
+			done = spc_xfer(spc, PHASE_MSG_IN, &msg, 1);
+			/* The chip holds ACK on the last message byte until told */
+			spc_write(spc, SPC_SCMD, SCMD_RESET_ACK);
+			break;
+		case PHASE_MSG_OUT:
+			done = spc_xfer(spc, PHASE_MSG_OUT, &nop, 1);
+			break;
+		default:
+			return DID_ERROR << 16;
+		}
+		if (done < 0)
+			return (done == -ETIMEDOUT ? DID_TIME_OUT : DID_ERROR) << 16;
+	}
+}
+
+static void spc_work(struct work_struct *work)
+{
+	struct x68k_spc *spc = container_of(work, struct x68k_spc, work);
+	struct scsi_cmnd *cmd = spc->cmd;
+
+	if (!cmd)
+		return;
+
+	cmd->result = spc_run(spc, cmd);
+	if (host_byte(cmd->result) == DID_TIME_OUT || host_byte(cmd->result) == DID_ERROR) {
+		spc_init(spc);
+		spc_reset_bus(spc);
+	}
+	spc->cmd = NULL;
+	scsi_done(cmd);
+}
+
+static enum scsi_qc_status spc_queuecommand(struct Scsi_Host *host, struct scsi_cmnd *cmd)
+{
+	struct x68k_spc *spc = shost_priv(host);
+
+	spc->cmd = cmd;
+	schedule_work(&spc->work);
+	return 0;
+}
+
+static int spc_host_reset(struct scsi_cmnd *cmd)
+{
+	struct x68k_spc *spc = shost_priv(cmd->device->host);
+
+	cancel_work_sync(&spc->work);
+	spc->cmd = NULL;
+	spc_init(spc);
+	spc_reset_bus(spc);
+	return SUCCESS;
+}
+
+static const struct scsi_host_template spc_template = {
+	.module			= THIS_MODULE,
+	.name			= "x68k_spc",
+	.proc_name		= "x68k_spc",
+	.queuecommand		= spc_queuecommand,
+	.eh_host_reset_handler	= spc_host_reset,
+	.can_queue		= 1,
+	.this_id		= HOST_ID,
+	.sg_tablesize		= SG_ALL,
+	.cmd_per_lun		= 1,
+	.dma_boundary		= PAGE_SIZE - 1,
+	.max_segment_size	= PAGE_SIZE,
+};
+
+static int spc_probe(struct platform_device *pdev)
+{
+	struct Scsi_Host *host;
+	struct x68k_spc *spc;
+	int err;
+
+	host = scsi_host_alloc(&spc_template, sizeof(*spc));
+	if (!host)
+		return -ENOMEM;
+
+	spc = shost_priv(host);
+	spc->host = host;
+	spc->regs = x68k_io(SPC_BASE);
+	INIT_WORK(&spc->work, spc_work);
+	host->max_id = 8;
+	host->max_lun = 1;
+	platform_set_drvdata(pdev, host);
+
+	spc_init(spc);
+	spc_reset_bus(spc);
+
+	err = scsi_add_host(host, &pdev->dev);
+	if (err) {
+		scsi_host_put(host);
+		return err;
+	}
+	scsi_scan_host(host);
+	return 0;
+}
+
+static void spc_remove(struct platform_device *pdev)
+{
+	struct Scsi_Host *host = platform_get_drvdata(pdev);
+	struct x68k_spc *spc = shost_priv(host);
+
+	scsi_remove_host(host);
+	cancel_work_sync(&spc->work);
+	scsi_host_put(host);
+}
+
+static struct platform_driver spc_driver = {
+	.probe	= spc_probe,
+	.remove	= spc_remove,
+	.driver	= {
+		.name = "x68k_spc",
+	},
+};
+module_platform_driver(spc_driver);
+
+MODULE_DESCRIPTION("Sharp X68030 internal SCSI driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 27997fed27396e3adc2bfa464ba17cde512203d5 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 10:58:44 +0100
Subject: [PATCH 07/31] rtc: rp5c01: Support byte wide registers and another
 year base
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The RP5C15 of the Sharp X68030 has its registers on odd bytes, and the year
counts from 1980 there.  Boards give both through new platform data.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/rtc/rtc-rp5c01.c                 | 33 +++++++++++++++++++-----
 include/linux/platform_data/rtc-rp5c01.h | 16 ++++++++++++
 2 files changed, 43 insertions(+), 6 deletions(-)
 create mode 100644 include/linux/platform_data/rtc-rp5c01.h

diff --git a/drivers/rtc/rtc-rp5c01.c b/drivers/rtc/rtc-rp5c01.c
index 44afa6d996e7..c0b6e763cf3c 100644
--- a/drivers/rtc/rtc-rp5c01.c
+++ b/drivers/rtc/rtc-rp5c01.c
@@ -11,6 +11,7 @@
 #include <linux/io.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
+#include <linux/platform_data/rtc-rp5c01.h>
 #include <linux/platform_device.h>
 #include <linux/rtc.h>
 #include <linux/slab.h>
@@ -63,6 +64,8 @@ enum {
 
 struct rp5c01_priv {
 	u32 __iomem *regs;
+	u8 __iomem *regs8;	/* registers on odd bytes */
+	unsigned int year_base;
 	struct rtc_device *rtc;
 	spinlock_t lock;	/* against concurrent RTC/NVRAM access */
 };
@@ -70,13 +73,18 @@ struct rp5c01_priv {
 static inline unsigned int rp5c01_read(struct rp5c01_priv *priv,
 				       unsigned int reg)
 {
+	if (priv->regs8)
+		return __raw_readb(priv->regs8 + 2 * reg + 1) & 0xf;
 	return __raw_readl(&priv->regs[reg]) & 0xf;
 }
 
 static inline void rp5c01_write(struct rp5c01_priv *priv, unsigned int val,
 				unsigned int reg)
 {
-	__raw_writel(val, &priv->regs[reg]);
+	if (priv->regs8)
+		__raw_writeb(val, priv->regs8 + 2 * reg + 1);
+	else
+		__raw_writel(val, &priv->regs[reg]);
 }
 
 static void rp5c01_lock(struct rp5c01_priv *priv)
@@ -110,7 +118,9 @@ static int rp5c01_read_time(struct device *dev, struct rtc_time *tm)
 		      rp5c01_read(priv, RP5C01_1_MONTH) - 1;
 	tm->tm_year = rp5c01_read(priv, RP5C01_10_YEAR) * 10 +
 		      rp5c01_read(priv, RP5C01_1_YEAR);
-	if (tm->tm_year <= 69)
+	if (priv->year_base)
+		tm->tm_year += priv->year_base - 1900;
+	else if (tm->tm_year <= 69)
 		tm->tm_year += 100;
 
 	rp5c01_unlock(priv);
@@ -122,6 +132,7 @@ static int rp5c01_read_time(struct device *dev, struct rtc_time *tm)
 static int rp5c01_set_time(struct device *dev, struct rtc_time *tm)
 {
 	struct rp5c01_priv *priv = dev_get_drvdata(dev);
+	int year;
 
 	spin_lock_irq(&priv->lock);
 	rp5c01_lock(priv);
@@ -138,10 +149,13 @@ static int rp5c01_set_time(struct device *dev, struct rtc_time *tm)
 		rp5c01_write(priv, tm->tm_wday, RP5C01_DAY_OF_WEEK);
 	rp5c01_write(priv, (tm->tm_mon + 1) / 10, RP5C01_10_MONTH);
 	rp5c01_write(priv, (tm->tm_mon + 1) % 10, RP5C01_1_MONTH);
-	if (tm->tm_year >= 100)
-		tm->tm_year -= 100;
-	rp5c01_write(priv, tm->tm_year / 10, RP5C01_10_YEAR);
-	rp5c01_write(priv, tm->tm_year % 10, RP5C01_1_YEAR);
+	year = tm->tm_year;
+	if (priv->year_base)
+		year -= priv->year_base - 1900;
+	else if (year >= 100)
+		year -= 100;
+	rp5c01_write(priv, year / 10, RP5C01_10_YEAR);
+	rp5c01_write(priv, year % 10, RP5C01_1_YEAR);
 
 	rp5c01_unlock(priv);
 	spin_unlock_irq(&priv->lock);
@@ -218,6 +232,7 @@ static int rp5c01_nvram_write(void *_priv, unsigned int pos, void *val,
 static int __init rp5c01_rtc_probe(struct platform_device *dev)
 {
 	struct resource *res;
+	struct rp5c01_platform_data *pdata;
 	struct rp5c01_priv *priv;
 	struct rtc_device *rtc;
 	int error;
@@ -241,6 +256,12 @@ static int __init rp5c01_rtc_probe(struct platform_device *dev)
 	priv->regs = devm_ioremap(&dev->dev, res->start, resource_size(res));
 	if (!priv->regs)
 		return -ENOMEM;
+	pdata = dev_get_platdata(&dev->dev);
+	if (pdata) {
+		priv->year_base = pdata->year_base;
+		if (pdata->odd_bytes)
+			priv->regs8 = (u8 __iomem *)priv->regs;
+	}
 
 	spin_lock_init(&priv->lock);
 
diff --git a/include/linux/platform_data/rtc-rp5c01.h b/include/linux/platform_data/rtc-rp5c01.h
new file mode 100644
index 000000000000..e0d0a09a6952
--- /dev/null
+++ b/include/linux/platform_data/rtc-rp5c01.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Board wiring of a Ricoh RP5C01 or RP5C15 real time clock
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef _LINUX_PLATFORM_DATA_RTC_RP5C01_H
+#define _LINUX_PLATFORM_DATA_RTC_RP5C01_H
+
+struct rp5c01_platform_data {
+	unsigned int year_base;	/* year of register value 0, else 1900 or 2000 */
+	bool odd_bytes;		/* registers on odd bytes instead of 32 bit words */
+};
+
+#endif /* _LINUX_PLATFORM_DATA_RTC_RP5C01_H */
-- 
2.54.0


From 126e9ccc6c4cc2fafb128ba92275a9ba424d529f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 10:58:44 +0100
Subject: [PATCH 08/31] Input: Add Sharp X68000 series mouse and joystick
 drivers
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The mouse sends a packet on channel B of the Z8530 each time the host pulls RTS.
The two joystick ports are read through the 8255 PPI.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/input/joystick/Kconfig   |   6 ++
 drivers/input/joystick/Makefile  |   1 +
 drivers/input/joystick/x68kjoy.c |  83 ++++++++++++++++
 drivers/input/mouse/Kconfig      |   6 ++
 drivers/input/mouse/Makefile     |   1 +
 drivers/input/mouse/x68kmouse.c  | 166 +++++++++++++++++++++++++++++++
 6 files changed, 263 insertions(+)
 create mode 100644 drivers/input/joystick/x68kjoy.c
 create mode 100644 drivers/input/mouse/x68kmouse.c

diff --git a/drivers/input/joystick/Kconfig b/drivers/input/joystick/Kconfig
index 7755e5b454d2..c3dcadc8948c 100644
--- a/drivers/input/joystick/Kconfig
+++ b/drivers/input/joystick/Kconfig
@@ -16,6 +16,12 @@ menuconfig INPUT_JOYSTICK
 
 if INPUT_JOYSTICK
 
+config JOYSTICK_X68K
+	bool "Sharp X68000 series joystick ports"
+	depends on X68K
+	help
+	  Say Y here to use joysticks on the ports of a Sharp X68030.
+
 config JOYSTICK_ANALOG
 	tristate "Classic PC analog joysticks and gamepads"
 	select GAMEPORT
diff --git a/drivers/input/joystick/Makefile b/drivers/input/joystick/Makefile
index 9976f596a920..67d21e9f2228 100644
--- a/drivers/input/joystick/Makefile
+++ b/drivers/input/joystick/Makefile
@@ -5,6 +5,7 @@
 
 # Each configuration option enables a list of files.
 
+obj-$(CONFIG_JOYSTICK_X68K)		+= x68kjoy.o
 obj-$(CONFIG_JOYSTICK_A3D)		+= a3d.o
 obj-$(CONFIG_JOYSTICK_ADC)		+= adc-joystick.o
 obj-$(CONFIG_JOYSTICK_ADI)		+= adi.o
diff --git a/drivers/input/joystick/x68kjoy.c b/drivers/input/joystick/x68kjoy.c
new file mode 100644
index 000000000000..af17fccaa26c
--- /dev/null
+++ b/drivers/input/joystick/x68kjoy.c
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp X68000 series joystick ports on the 8255 PPI, Atari style with two buttons
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include <asm/io.h>
+#include <asm/x68k.h>
+
+#define PPI_PORT(n)	(0x00e9a001 + 2 * (n))
+#define JOY_PORTS	2
+#define POLL_MS		20
+
+/* Active low lines */
+#define JOY_UP		0x01
+#define JOY_DOWN	0x02
+#define JOY_LEFT	0x04
+#define JOY_RIGHT	0x08
+#define JOY_A		0x20
+#define JOY_B		0x40
+
+struct x68kjoy {
+	struct input_dev *input[JOY_PORTS];
+};
+
+static void x68kjoy_poll(struct input_dev *input)
+{
+	unsigned int port = (unsigned long)input_get_drvdata(input);
+	u8 v = ~in_8(x68k_io(PPI_PORT(port)));
+
+	input_report_abs(input, ABS_X, !!(v & JOY_RIGHT) - !!(v & JOY_LEFT));
+	input_report_abs(input, ABS_Y, !!(v & JOY_DOWN) - !!(v & JOY_UP));
+	input_report_key(input, BTN_TRIGGER, v & JOY_A);
+	input_report_key(input, BTN_THUMB, v & JOY_B);
+	input_sync(input);
+}
+
+static int x68kjoy_probe(struct platform_device *pdev)
+{
+	unsigned long port;
+	int err;
+
+	for (port = 0; port < JOY_PORTS; port++) {
+		struct input_dev *input = devm_input_allocate_device(&pdev->dev);
+
+		if (!input)
+			return -ENOMEM;
+		input->name = port ? "X68000 Joystick 2" : "X68000 Joystick 1";
+		input->phys = port ? "x68kjoy/input1" : "x68kjoy/input0";
+		input->id.bustype = BUS_HOST;
+		input_set_drvdata(input, (void *)port);
+		input_set_abs_params(input, ABS_X, -1, 1, 0, 0);
+		input_set_abs_params(input, ABS_Y, -1, 1, 0, 0);
+		input_set_capability(input, EV_KEY, BTN_TRIGGER);
+		input_set_capability(input, EV_KEY, BTN_THUMB);
+
+		err = input_setup_polling(input, x68kjoy_poll);
+		if (err)
+			return err;
+		input_set_poll_interval(input, POLL_MS);
+		err = input_register_device(input);
+		if (err)
+			return err;
+	}
+	return 0;
+}
+
+static struct platform_driver x68kjoy_driver = {
+	.probe	= x68kjoy_probe,
+	.driver	= {
+		.name = "x68kjoy",
+	},
+};
+builtin_platform_driver(x68kjoy_driver);
+
+MODULE_DESCRIPTION("Sharp X68000 joystick driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/input/mouse/Kconfig b/drivers/input/mouse/Kconfig
index 074130d88953..bb9bb9fe6df3 100644
--- a/drivers/input/mouse/Kconfig
+++ b/drivers/input/mouse/Kconfig
@@ -13,6 +13,12 @@ menuconfig INPUT_MOUSE
 
 if INPUT_MOUSE
 
+config MOUSE_X68K
+	bool "Sharp X68000 series mouse"
+	depends on X68K
+	help
+	  Say Y here to use the mouse of a Sharp X68030.
+
 config MOUSE_PS2
 	tristate "PS/2 mouse"
 	default y
diff --git a/drivers/input/mouse/Makefile b/drivers/input/mouse/Makefile
index ed40f141691e..5dfbc238d69a 100644
--- a/drivers/input/mouse/Makefile
+++ b/drivers/input/mouse/Makefile
@@ -5,6 +5,7 @@
 
 # Each configuration option enables a list of files.
 
+obj-$(CONFIG_MOUSE_X68K)		+= x68kmouse.o
 obj-$(CONFIG_MOUSE_AMIGA)		+= amimouse.o
 obj-$(CONFIG_MOUSE_APPLETOUCH)		+= appletouch.o
 obj-$(CONFIG_MOUSE_ATARI)		+= atarimouse.o
diff --git a/drivers/input/mouse/x68kmouse.c b/drivers/input/mouse/x68kmouse.c
new file mode 100644
index 000000000000..720ea611940f
--- /dev/null
+++ b/drivers/input/mouse/x68kmouse.c
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp X68000 series mouse on channel B of the Z8530: the mouse sends a status
+ * byte and two motion bytes each time the host pulls RTS.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/timer.h>
+
+#include <asm/io.h>
+#include <asm/x68k.h>
+
+/* 4800 baud 8N2 from the 5 MHz PCLK */
+#define SCC_PCLK		5000000
+#define MOUSE_BAUD		4800
+#define MOUSE_BRG		(SCC_PCLK / (2 * 16 * MOUSE_BAUD) - 2)
+
+#define WR0_RES_EXT		0x10
+#define WR0_RES_H_IUS		0x38
+#define WR1_RX_INT_ALL		0x10
+#define WR3_RX_8BIT		0xc0
+#define WR3_RX_EN		0x01
+#define WR4_X16_2STOP		0x4c
+#define WR5_TX_8BIT		0x60
+#define WR5_RTS			0x02
+#define WR9_RESET_B		0x40
+#define WR9_MIE			0x08
+#define WR11_BRG		0x50
+#define WR14_BRG_PCLK		0x03
+#define RR0_RX_AVAIL		0x01
+#define RR3_B_RX_IP		0x04
+
+#define STS_RB			0x01
+#define STS_LB			0x02
+
+#define POLL_HZ			60
+
+struct x68kmouse {
+	struct input_dev *input;
+	struct timer_list poll;
+	u8 packet[3];
+	unsigned int count;
+};
+
+static void __iomem *scc_b_ctrl(void)
+{
+	return x68k_io(X68K_SCC + X68K_SCC_B_CTRL);
+}
+
+static void scc_b_write(unsigned int reg, u8 val)
+{
+	out_8(scc_b_ctrl(), reg);
+	out_8(scc_b_ctrl(), val);
+}
+
+/* Pulling RTS asks for the next packet */
+static void x68kmouse_request(void)
+{
+	scc_b_write(5, WR5_TX_8BIT);
+	scc_b_write(5, WR5_TX_8BIT | WR5_RTS);
+}
+
+static void x68kmouse_poll(struct timer_list *t)
+{
+	struct x68kmouse *mouse = timer_container_of(mouse, t, poll);
+
+	mouse->count = 0;
+	x68kmouse_request();
+	mod_timer(&mouse->poll, jiffies + HZ / POLL_HZ);
+}
+
+static irqreturn_t x68kmouse_interrupt(int irq, void *dev_id)
+{
+	struct x68kmouse *mouse = dev_id;
+	irqreturn_t ret = IRQ_NONE;
+
+	/* Only channel A has the pending bits of both channels */
+	out_8(x68k_io(X68K_SCC + X68K_SCC_A_CTRL), 3);
+	if (!(in_8(x68k_io(X68K_SCC + X68K_SCC_A_CTRL)) & RR3_B_RX_IP))
+		return IRQ_NONE;
+
+	while (in_8(scc_b_ctrl()) & RR0_RX_AVAIL) {
+		u8 c = in_8(x68k_io(X68K_SCC + X68K_SCC_B_DATA));
+
+		ret = IRQ_HANDLED;
+		mouse->packet[mouse->count++] = c;
+		if (mouse->count < ARRAY_SIZE(mouse->packet))
+			continue;
+		mouse->count = 0;
+		input_report_key(mouse->input, BTN_LEFT, mouse->packet[0] & STS_LB);
+		input_report_key(mouse->input, BTN_RIGHT, mouse->packet[0] & STS_RB);
+		input_report_rel(mouse->input, REL_X, (s8)mouse->packet[1]);
+		input_report_rel(mouse->input, REL_Y, (s8)mouse->packet[2]);
+		input_sync(mouse->input);
+	}
+	scc_b_write(0, WR0_RES_H_IUS);
+	return ret;
+}
+
+static int x68kmouse_probe(struct platform_device *pdev)
+{
+	struct x68kmouse *mouse;
+	struct input_dev *input;
+	int err;
+
+	mouse = devm_kzalloc(&pdev->dev, sizeof(*mouse), GFP_KERNEL);
+	if (!mouse)
+		return -ENOMEM;
+	input = devm_input_allocate_device(&pdev->dev);
+	if (!input)
+		return -ENOMEM;
+	mouse->input = input;
+	timer_setup(&mouse->poll, x68kmouse_poll, 0);
+
+	input->name = "X68000 Mouse";
+	input->phys = "x68kmouse/input0";
+	input->id.bustype = BUS_RS232;
+	input_set_capability(input, EV_REL, REL_X);
+	input_set_capability(input, EV_REL, REL_Y);
+	input_set_capability(input, EV_KEY, BTN_LEFT);
+	input_set_capability(input, EV_KEY, BTN_RIGHT);
+
+	err = input_register_device(input);
+	if (err)
+		return err;
+
+	scc_b_write(9, WR9_RESET_B);
+	scc_b_write(4, WR4_X16_2STOP);
+	scc_b_write(3, WR3_RX_8BIT);
+	scc_b_write(5, WR5_TX_8BIT);
+	scc_b_write(11, WR11_BRG);
+	scc_b_write(12, MOUSE_BRG & 0xff);
+	scc_b_write(13, MOUSE_BRG >> 8);
+	scc_b_write(14, WR14_BRG_PCLK);
+	scc_b_write(3, WR3_RX_8BIT | WR3_RX_EN);
+	scc_b_write(0, WR0_RES_EXT);
+	scc_b_write(1, WR1_RX_INT_ALL);
+
+	err = devm_request_irq(&pdev->dev, IRQ_X68K_SCC, x68kmouse_interrupt, IRQF_SHARED,
+			       "x68kmouse", mouse);
+	if (err)
+		return err;
+	/* The interrupt vector and master enable are shared with the serial port driver */
+	scc_b_write(2, X68K_VEC_SCC);
+	scc_b_write(9, WR9_MIE);
+
+	mod_timer(&mouse->poll, jiffies + HZ / POLL_HZ);
+	return 0;
+}
+
+static struct platform_driver x68kmouse_driver = {
+	.probe	= x68kmouse_probe,
+	.driver	= {
+		.name = "x68kmouse",
+	},
+};
+builtin_platform_driver(x68kmouse_driver);
+
+MODULE_DESCRIPTION("Sharp X68000 mouse driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From eeddbb1313aaa96ac8d8c98d376278783937793e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 10:58:44 +0100
Subject: [PATCH 09/31] serial: pmac_zilog: Allow boards to use channel B for
 something else
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The X68030 has its mouse on channel B, so that it gets no resources.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/tty/serial/pmac_zilog.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/drivers/tty/serial/pmac_zilog.c b/drivers/tty/serial/pmac_zilog.c
index d520634678fe..350a06cc48d2 100644
--- a/drivers/tty/serial/pmac_zilog.c
+++ b/drivers/tty/serial/pmac_zilog.c
@@ -1798,14 +1798,17 @@ static int __init pmz_probe(void)
 		return err;
 	pmz_ports_count++;
 
-	pmz_ports[0].mate      = &pmz_ports[1];
-	pmz_ports[1].mate      = &pmz_ports[0];
 	pmz_ports[1].port.line = 1;
 	pmz_ports[1].flags     = 0;
 	pmz_ports[1].pdev      = &scc_b_pdev;
 	err = pmz_init_port(&pmz_ports[1]);
+	/* Boards may use channel B for something else, then it has no resources */
+	if (err == -ENODEV)
+		return 0;
 	if (err)
 		return err;
+	pmz_ports[0].mate      = &pmz_ports[1];
+	pmz_ports[1].mate      = &pmz_ports[0];
 	pmz_ports_count++;
 
 	return 0;
-- 
2.54.0


From a8b00e2988ab819f544f421e607083ae97a0b4cc Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 10:58:44 +0100
Subject: [PATCH 10/31] m68k: x68k: Add RTC, SRAM, mouse, joystick and power
 off
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The battery backed SRAM with the ROM settings becomes an nvmem device, written
with the system port write protection lifted.  Power off follows the sequence
the power controller expects on the system port.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/x68k_defconfig |  8 ++++
 arch/m68k/x68k/Makefile          |  2 +-
 arch/m68k/x68k/config.c          | 34 ++++++++++++++++-
 arch/m68k/x68k/sram.c            | 64 ++++++++++++++++++++++++++++++++
 4 files changed, 106 insertions(+), 2 deletions(-)
 create mode 100644 arch/m68k/x68k/sram.c

diff --git a/arch/m68k/configs/x68k_defconfig b/arch/m68k/configs/x68k_defconfig
index bdf881772c33..eded6864918e 100644
--- a/arch/m68k/configs/x68k_defconfig
+++ b/arch/m68k/configs/x68k_defconfig
@@ -40,6 +40,11 @@ CONFIG_SERIAL_PMACZILOG_TTYS=y
 CONFIG_SERIAL_PMACZILOG_CONSOLE=y
 CONFIG_INPUT_EVDEV=y
 CONFIG_KEYBOARD_X68K=y
+CONFIG_INPUT_MOUSE=y
+CONFIG_MOUSE_X68K=y
+CONFIG_INPUT_JOYSTICK=y
+CONFIG_JOYSTICK_X68K=y
+CONFIG_INPUT_MOUSEDEV=y
 CONFIG_VT=y
 CONFIG_VT_CONSOLE=y
 CONFIG_FB=y
@@ -50,3 +55,6 @@ CONFIG_FONTS=y
 CONFIG_FONT_8x16=y
 CONFIG_EXT2_FS=y
 CONFIG_ISO9660_FS=y
+CONFIG_RTC_CLASS=y
+CONFIG_RTC_DRV_RP5C01=y
+CONFIG_NVMEM=y
diff --git a/arch/m68k/x68k/Makefile b/arch/m68k/x68k/Makefile
index 13265f72e816..f65ef1a961ef 100644
--- a/arch/m68k/x68k/Makefile
+++ b/arch/m68k/x68k/Makefile
@@ -3,4 +3,4 @@
 # Makefile for Linux arch/m68k/x68k source directory
 #
 
-obj-y		:= config.o ints.o reset.o time.o
+obj-y		:= config.o ints.o reset.o sram.o time.o
diff --git a/arch/m68k/x68k/config.c b/arch/m68k/x68k/config.c
index 51d7bafce979..ec178827a720 100644
--- a/arch/m68k/x68k/config.c
+++ b/arch/m68k/x68k/config.c
@@ -8,6 +8,8 @@
 #include <linux/init.h>
 #include <linux/kernel.h>
 #include <linux/platform_data/pmac_zilog.h>
+#include <linux/platform_data/rtc-rp5c01.h>
+#include <linux/reboot.h>
 #include <linux/platform_device.h>
 
 #include <asm/bootinfo.h>
@@ -32,6 +34,30 @@ static void x68k_get_model(char *model)
 	strcpy(model, "Sharp X68030");
 }
 
+#define SYSPORT_POWER	0x00e8e00f
+#define RTC_PHYS	0x00e8a000
+#define RTC_SIZE	0x20
+
+/* The power controller switches off after this sequence */
+static void x68k_power_off(void)
+{
+	static const u8 seq[] = { 0x00, 0x0f, 0x0f };
+	unsigned int i;
+
+	local_irq_disable();
+	for (i = 0; i < ARRAY_SIZE(seq); i++)
+		out_8(x68k_io(SYSPORT_POWER), seq[i]);
+	for (;;)
+		;
+}
+
+static struct rp5c01_platform_data x68k_rtc_pdata = {
+	.year_base	= 1980,
+	.odd_bytes	= true,
+};
+
+static struct resource x68k_rtc_rsrc = DEFINE_RES_MEM(RTC_PHYS, RTC_SIZE);
+
 static void x68k_reset(void)
 {
 	local_irq_disable();
@@ -44,6 +70,7 @@ void __init config_x68k(void)
 	mach_init_IRQ	= x68k_init_IRQ;
 	mach_get_model	= x68k_get_model;
 	mach_reset	= x68k_reset;
+	register_platform_power_off(x68k_power_off);
 }
 
 static struct pmz_platform_data x68k_scc_pdata = {
@@ -82,11 +109,16 @@ static int __init x68k_platform_init(void)
 	scc_b_pdev.num_resources = ARRAY_SIZE(scc_b_rsrcs);
 	scc_b_pdev.dev.platform_data = &x68k_scc_pdata;
 
+	/* Channel B is the mouse port */
 	platform_device_register(&scc_a_pdev);
-	platform_device_register(&scc_b_pdev);
 	platform_device_register_simple("x68kfb", -1, NULL, 0);
 	platform_device_register_simple("x68kkbd", -1, NULL, 0);
 	platform_device_register_simple("x68k_spc", -1, NULL, 0);
+	platform_device_register_simple("x68kmouse", -1, NULL, 0);
+	platform_device_register_simple("x68kjoy", -1, NULL, 0);
+	platform_device_register_simple("x68k_sram", -1, NULL, 0);
+	platform_device_register_resndata(NULL, "rtc-rp5c01", -1, &x68k_rtc_rsrc, 1,
+					  &x68k_rtc_pdata, sizeof(x68k_rtc_pdata));
 	return 0;
 }
 arch_initcall(x68k_platform_init);
diff --git a/arch/m68k/x68k/sram.c b/arch/m68k/x68k/sram.c
new file mode 100644
index 000000000000..f090ad690767
--- /dev/null
+++ b/arch/m68k/x68k/sram.c
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp X68030 battery backed SRAM with the ROM settings, write protected by the
+ * system port unless unlocked
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/nvmem-provider.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+
+#include <asm/x68k.h>
+
+#define SRAM_PHYS		0x00ed0000
+#define SRAM_SIZE		0x4000
+#define SYSPORT_SRAM_WP		0x00e8e00d
+#define SRAM_UNLOCK		0x31
+
+static DEFINE_SPINLOCK(sram_lock);
+
+static int x68k_sram_read(void *priv, unsigned int offset, void *val, size_t bytes)
+{
+	memcpy_fromio(val, x68k_io(SRAM_PHYS) + offset, bytes);
+	return 0;
+}
+
+static int x68k_sram_write(void *priv, unsigned int offset, void *val, size_t bytes)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&sram_lock, flags);
+	out_8(x68k_io(SYSPORT_SRAM_WP), SRAM_UNLOCK);
+	memcpy_toio(x68k_io(SRAM_PHYS) + offset, val, bytes);
+	out_8(x68k_io(SYSPORT_SRAM_WP), 0);
+	spin_unlock_irqrestore(&sram_lock, flags);
+	return 0;
+}
+
+static int x68k_sram_probe(struct platform_device *pdev)
+{
+	struct nvmem_config cfg = {
+		.dev		= &pdev->dev,
+		.name		= "x68k_sram",
+		.id		= NVMEM_DEVID_NONE,
+		.size		= SRAM_SIZE,
+		.word_size	= 1,
+		.stride		= 1,
+		.reg_read	= x68k_sram_read,
+		.reg_write	= x68k_sram_write,
+	};
+
+	return PTR_ERR_OR_ZERO(devm_nvmem_register(&pdev->dev, &cfg));
+}
+
+static struct platform_driver x68k_sram_driver = {
+	.probe	= x68k_sram_probe,
+	.driver	= {
+		.name = "x68k_sram",
+	},
+};
+builtin_platform_driver(x68k_sram_driver);
-- 
2.54.0


From 67565649a4f70b552bc755241d78c73f0c6189c2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 11:10:27 +0100
Subject: [PATCH 11/31] m68k: x68k: Reset the devices before re-entering the
 ROM, add zram
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The ROM locked up after a reboot with interrupts of devices still pending.  Put
the MFP, SCC, SCSI controller, I/O controller and DMA channels into their reset
state, and pulse the reset line.  Enable zram for swap, these machines have at
most 12 MB of memory.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/x68k_defconfig |  3 +++
 arch/m68k/x68k/config.c          | 33 ++++++++++++++++++++++++++++++++
 arch/m68k/x68k/reset.S           |  2 ++
 3 files changed, 38 insertions(+)

diff --git a/arch/m68k/configs/x68k_defconfig b/arch/m68k/configs/x68k_defconfig
index eded6864918e..b3f0c6f839db 100644
--- a/arch/m68k/configs/x68k_defconfig
+++ b/arch/m68k/configs/x68k_defconfig
@@ -58,3 +58,6 @@ CONFIG_ISO9660_FS=y
 CONFIG_RTC_CLASS=y
 CONFIG_RTC_DRV_RP5C01=y
 CONFIG_NVMEM=y
+CONFIG_ZSMALLOC=y
+CONFIG_ZRAM=y
+CONFIG_CRYPTO_LZO=y
diff --git a/arch/m68k/x68k/config.c b/arch/m68k/x68k/config.c
index ec178827a720..b463a9562821 100644
--- a/arch/m68k/x68k/config.c
+++ b/arch/m68k/x68k/config.c
@@ -58,9 +58,42 @@ static struct rp5c01_platform_data x68k_rtc_pdata = {
 
 static struct resource x68k_rtc_rsrc = DEFINE_RES_MEM(RTC_PHYS, RTC_SIZE);
 
+#define SCC_A_CTRL	(X68K_SCC + X68K_SCC_A_CTRL)
+#define WR9_HW_RESET	0xc0
+#define SPC_SCTL	0x00e96023
+#define SCTL_DISABLE	0x80
+#define DMAC_CHANNELS	4
+#define DMAC_CSR(ch)	(X68K_DMAC + 0x40 * (ch))
+#define DMAC_CCR(ch)	(X68K_DMAC + 0x40 * (ch) + 7)
+#define DMAC_CCR_ABORT	0x10
+
+/* The ROM expects the devices as after a reset, pending interrupts lock it up */
+static void x68k_quiesce(void)
+{
+	int ch;
+
+	out_8(x68k_mfp(MFP_IERA), 0);
+	out_8(x68k_mfp(MFP_IERB), 0);
+	out_8(x68k_mfp(MFP_IMRA), 0);
+	out_8(x68k_mfp(MFP_IMRB), 0);
+	out_8(x68k_mfp(MFP_IPRA), 0);
+	out_8(x68k_mfp(MFP_IPRB), 0);
+	out_8(x68k_mfp(MFP_ISRA), 0);
+	out_8(x68k_mfp(MFP_ISRB), 0);
+	out_8(x68k_io(SCC_A_CTRL), 9);
+	out_8(x68k_io(SCC_A_CTRL), WR9_HW_RESET);
+	out_8(x68k_io(SPC_SCTL), SCTL_DISABLE);
+	out_8(x68k_io(X68K_IOC + 1), 0);
+	for (ch = 0; ch < DMAC_CHANNELS; ch++) {
+		out_8(x68k_io(DMAC_CCR(ch)), DMAC_CCR_ABORT);
+		out_8(x68k_io(DMAC_CSR(ch)), 0xff);
+	}
+}
+
 static void x68k_reset(void)
 {
 	local_irq_disable();
+	x68k_quiesce();
 	x68k_rom_reset();
 }
 
diff --git a/arch/m68k/x68k/reset.S b/arch/m68k/x68k/reset.S
index ddd65e7a4a0e..da4711c2ca58 100644
--- a/arch/m68k/x68k/reset.S
+++ b/arch/m68k/x68k/reset.S
@@ -22,6 +22,8 @@ ENTRY(x68k_rom_reset)
 	moveq	#0,%d0
 	movec	%d0,%vbr
 	.chip	68k
+	/* Reset the devices as at power on */
+	reset
 	lea	ROM_RESET_VECTORS,%a0
 	movel	%a0@+,%sp
 	movel	%a0@,%a0
-- 
2.54.0


From 3d4e9552c41578b87a08b0a2a414788d8cb7cd94 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 11:22:46 +0100
Subject: [PATCH 12/31] m68k: floppy: Support the Sharp X68030
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The uPD72065 sits behind the PC register interface of floppy.c, mapped to the
drive select and disk present ports.  The reset line of the chip is not wired:
its reset command stands in, followed by a recalibrate for the interrupt
floppy.c waits for.  Bytes come every 16 us, too fast for interrupt driven
transfers, so they move by DMA.  The drives give no ready signal, it is forced
through a pin of the YM2151.

The 2HD format with 8 sectors of 1024 bytes needs setting with FDSETPRM, the
format table of floppy.c is full.

Define the DMA lock once for all m68k machines with a floppy.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/Kconfig.devices        |   2 +-
 arch/m68k/include/asm/floppy.h   |  73 +++++++++++---
 arch/m68k/include/asm/x68kflop.h | 158 +++++++++++++++++++++++++++++++
 arch/m68k/kernel/setup_mm.c      |   6 ++
 arch/m68k/next/dma.c             |   2 -
 5 files changed, 226 insertions(+), 15 deletions(-)
 create mode 100644 arch/m68k/include/asm/x68kflop.h

diff --git a/arch/m68k/Kconfig.devices b/arch/m68k/Kconfig.devices
index 48531572ceae..c43d9ea13041 100644
--- a/arch/m68k/Kconfig.devices
+++ b/arch/m68k/Kconfig.devices
@@ -3,7 +3,7 @@ if MMU
 
 config ARCH_MAY_HAVE_PC_FDC
 	bool
-	depends on (BROKEN && (Q40 || SUN3X)) || NEXT
+	depends on (BROKEN && (Q40 || SUN3X)) || NEXT || X68K
 	default y
 
 menu "Platform devices"
diff --git a/arch/m68k/include/asm/floppy.h b/arch/m68k/include/asm/floppy.h
index 669a26cce543..2fe02a93ddca 100644
--- a/arch/m68k/include/asm/floppy.h
+++ b/arch/m68k/include/asm/floppy.h
@@ -28,7 +28,7 @@ asmlinkage irqreturn_t floppy_hardint(int irq, void *dev_id);
 /*
  * Again, the CMOS information doesn't work on m68k..
  */
-#define FLOPPY0_TYPE ((MACH_IS_Q40 || MACH_IS_NEXT) ? 6 : 4)
+#define FLOPPY0_TYPE ((MACH_IS_Q40 || MACH_IS_NEXT) ? 6 : MACH_IS_X68K ? 2 : 4)
 #define FLOPPY1_TYPE 0
 
 /* basically PC init + set use_virtual_dma */
@@ -65,6 +65,9 @@ static int doing_pdma=0;
 #ifdef CONFIG_NEXT
 #include <asm/nextflop.h>
 #endif
+#ifdef CONFIG_X68K
+#include <asm/x68kflop.h>
+#endif
 
 extern spinlock_t  dma_spin_lock;
 
@@ -87,6 +90,10 @@ static __inline__ unsigned char fd_inb(int base, int reg)
 	if (MACH_IS_NEXT)
 		return in_8((unsigned long)base + reg);
 #endif
+#ifdef CONFIG_X68K
+	if (MACH_IS_X68K)
+		return x68k_fd_inb(reg);
+#endif
 #ifdef M68K_FLOPPY_Q40
 	if(MACH_IS_Q40)
 		return inb_p(base + reg);
@@ -104,6 +111,10 @@ static __inline__ void fd_outb(unsigned char value, int base, int reg)
 	if (MACH_IS_NEXT)
 		out_8((unsigned long)base + reg, value);
 #endif
+#ifdef CONFIG_X68K
+	if (MACH_IS_X68K)
+		x68k_fd_outb(value, reg);
+#endif
 #ifdef M68K_FLOPPY_Q40
 	if(MACH_IS_Q40)
 		outb_p(value, base + reg);
@@ -120,6 +131,15 @@ static int fd_request_irq(void)
 	if (MACH_IS_Q40 || MACH_IS_NEXT)
 		return request_irq(FLOPPY_IRQ, floppy_hardint,
 				   0, "floppy", floppy_hardint);
+#ifdef CONFIG_X68K
+	if (MACH_IS_X68K) {
+		int err = request_irq(FLOPPY_IRQ, floppy_hardint, 0, "floppy", floppy_hardint);
+
+		if (!err)
+			x68k_fd_irq_enable(true);
+		return err;
+	}
+#endif
 #ifdef M68K_FLOPPY_SUN3X
 	if(MACH_IS_SUN3X)
 		return sun3xflop_request_irq();
@@ -129,7 +149,11 @@ static int fd_request_irq(void)
 
 static void fd_free_irq(void)
 {
-	if (MACH_IS_Q40 || MACH_IS_NEXT)
+#ifdef CONFIG_X68K
+	if (MACH_IS_X68K)
+		x68k_fd_irq_enable(false);
+#endif
+	if (MACH_IS_Q40 || MACH_IS_NEXT || MACH_IS_X68K)
 		free_irq(FLOPPY_IRQ, floppy_hardint);
 }
 
@@ -161,6 +185,17 @@ static int m68k_floppy_init(void)
   }
 #endif
 
+#ifdef CONFIG_X68K
+  if (MACH_IS_X68K) {
+	  use_virtual_dma = 0;
+	  can_use_virtual_dma = 0;
+	  FLOPPY_IRQ = X68K_IRQ(X68K_VEC_IOC);
+	  /* The drives give no ready signal */
+	  x68k_opm_set_ct(X68K_OPM_CT_FDC_READY, X68K_OPM_CT_FDC_READY);
+	  return 0;
+  }
+#endif
+
   use_virtual_dma =1;
   can_use_virtual_dma = 1;
 
@@ -188,6 +223,10 @@ static int __maybe_unused vdma_get_dma_residue(unsigned int dummy)
 #ifdef CONFIG_NEXT
 	if (MACH_IS_NEXT)
 		return next_fd.residue;
+#endif
+#ifdef CONFIG_X68K
+	if (MACH_IS_X68K)
+		return x68k_fd.residue;
 #endif
 	return virtual_dma_count + virtual_dma_residue;
 }
@@ -195,8 +234,8 @@ static int __maybe_unused vdma_get_dma_residue(unsigned int dummy)
 
 static unsigned long vdma_mem_alloc(unsigned long size)
 {
-	/* NeXT uses real DMA */
-	if (MACH_IS_NEXT)
+	/* NeXT and X68030 use real DMA */
+	if (MACH_IS_NEXT || MACH_IS_X68K)
 		return __get_free_pages(GFP_KERNEL, get_order(size));
 	return (unsigned long) vmalloc(size);
 
@@ -204,7 +243,7 @@ static unsigned long vdma_mem_alloc(unsigned long size)
 
 static void _fd_dma_mem_free(unsigned long addr, unsigned long size)
 {
-	if (MACH_IS_NEXT) {
+	if (MACH_IS_NEXT || MACH_IS_X68K) {
 		free_pages(addr, get_order(size));
 		return;
 	}
@@ -220,6 +259,10 @@ static int vdma_dma_setup(char *addr, unsigned long size, int mode, int io)
 #ifdef CONFIG_NEXT
 	if (MACH_IS_NEXT)
 		return next_fd_dma_setup(addr, size, mode == DMA_MODE_READ);
+#endif
+#ifdef CONFIG_X68K
+	if (MACH_IS_X68K)
+		return x68k_fd_dma_setup(addr, size, mode == DMA_MODE_READ);
 #endif
 	doing_pdma = 1;
 	virtual_dma_port = (MACH_IS_Q40 ? io : 0);
@@ -239,6 +282,12 @@ static void fd_disable_dma(void)
 		next_fd_dma_stop();
 		return;
 	}
+#endif
+#ifdef CONFIG_X68K
+	if (MACH_IS_X68K) {
+		x68k_fd_dma_stop();
+		return;
+	}
 #endif
 	doing_pdma = 0;
 	virtual_dma_residue += virtual_dma_count;
@@ -251,7 +300,7 @@ static void fd_disable_dma(void)
 
 asmlinkage irqreturn_t floppy_hardint(int irq, void *dev_id)
 {
-#ifdef M68K_FLOPPY_Q40
+#if defined(M68K_FLOPPY_Q40) || defined(CONFIG_X68K)
 	register unsigned char st;
 #endif
 
@@ -268,7 +317,7 @@ asmlinkage irqreturn_t floppy_hardint(int irq, void *dev_id)
 		return IRQ_HANDLED;
 	}
 
-#ifdef M68K_FLOPPY_Q40
+#if defined(M68K_FLOPPY_Q40) || defined(CONFIG_X68K)
 
 #ifdef TRACE_FLPY_INT
 	if(!calls)
@@ -284,19 +333,19 @@ asmlinkage irqreturn_t floppy_hardint(int irq, void *dev_id)
 		st=1;
 		for(lcount=virtual_dma_count, lptr=virtual_dma_addr;
 		    lcount; lcount--, lptr++) {
-			st = inb(virtual_dma_port + FD_STATUS);
+			st = fd_inb(virtual_dma_port, FD_STATUS);
 			st &= STATUS_DMA | STATUS_READY;
 			if (st != (STATUS_DMA | STATUS_READY))
 				break;
 			if(virtual_dma_mode)
-				outb_p(*lptr, virtual_dma_port + FD_DATA);
+				fd_outb(*lptr, virtual_dma_port, FD_DATA);
 			else
-				*lptr = inb_p(virtual_dma_port + FD_DATA);
+				*lptr = fd_inb(virtual_dma_port, FD_DATA);
 		}
 
 		virtual_dma_count = lcount;
 		virtual_dma_addr = lptr;
-		st = inb(virtual_dma_port + FD_STATUS);
+		st = fd_inb(virtual_dma_port, FD_STATUS);
 	}
 
 #ifdef TRACE_FLPY_INT
@@ -322,7 +371,7 @@ asmlinkage irqreturn_t floppy_hardint(int irq, void *dev_id)
 	if(!virtual_dma_count)
 		dma_wait++;
 #endif
-#endif /* M68K_FLOPPY_Q40 */
+#endif /* M68K_FLOPPY_Q40 || CONFIG_X68K */
 	return IRQ_HANDLED;
 }
 
diff --git a/arch/m68k/include/asm/x68kflop.h b/arch/m68k/include/asm/x68kflop.h
new file mode 100644
index 000000000000..2dea5586bd2f
--- /dev/null
+++ b/arch/m68k/include/asm/x68kflop.h
@@ -0,0 +1,158 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Sharp X68030 floppy: a uPD72065 with the PC register interface of floppy.c
+ * mapped to its own drive control port. Data moves by interrupt, not DMA.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef _ASM_M68K_X68KFLOP_H
+#define _ASM_M68K_X68KFLOP_H
+
+#include <linux/delay.h>
+#include <linux/fdreg.h>
+#include <asm/cacheflush.h>
+#include <asm/io.h>
+#include <asm/x68k.h>
+#include <asm/x68kdmac.h>
+
+#define X68K_FDC_STATUS		0x00e94001	/* write: auxiliary command */
+#define X68K_FDC_DATA		0x00e94003
+#define X68K_FDD_OPTION		0x00e94005	/* drives to check, disk present */
+#define X68K_FDD_SELECT		0x00e94007
+
+#define X68K_FDC_SOFT_RESET	0x36
+#define FDD_INSERTED		0x80
+#define FDD_SELECT_MOTOR	0x80
+#define FDD_SELECT_300K		0x10
+
+#define IOC_FDC_IEN		0x04
+
+struct x68k_fd_state {
+	u8 dor;
+	u8 rate;
+	bool in_reset;
+	/* the DMA transfer of the current command */
+	char *addr;
+	unsigned long size;
+	unsigned long residue;
+	bool read;
+	bool active;
+};
+
+extern struct x68k_fd_state x68k_fd;
+
+static inline void x68k_fd_select(void)
+{
+	unsigned int drive = x68k_fd.dor & 3;
+	u8 val = drive | (x68k_fd.rate ? FDD_SELECT_300K : 0);
+
+	if (x68k_fd.dor & (0x10 << drive))
+		val |= FDD_SELECT_MOTOR;
+	out_8(x68k_io(X68K_FDD_SELECT), val);
+}
+
+/* Only an absent disk counts as a change, a new one is noticed by floppy.c */
+static inline u8 x68k_fd_dir(void)
+{
+	u8 present;
+
+	out_8(x68k_io(X68K_FDD_OPTION), BIT(x68k_fd.dor & 3));
+	present = in_8(x68k_io(X68K_FDD_OPTION)) & FDD_INSERTED;
+	out_8(x68k_io(X68K_FDD_OPTION), 0);
+	return present ? 0 : 0x80;
+}
+
+/*
+ * The reset line is not wired, the chip has a reset command. Unlike a hardware
+ * reset with ready polling, it raises no interrupt, which floppy.c waits for.
+ * A recalibrate of the selected drive provides it, and floppy.c recalibrates
+ * after a reset anyway.
+ */
+static inline void x68k_fd_reset(void)
+{
+	unsigned int i;
+
+	out_8(x68k_io(X68K_FDC_STATUS), X68K_FDC_SOFT_RESET);
+	for (i = 0; i < 1000 && (in_8(x68k_io(X68K_FDC_STATUS)) & 0xc0) != 0x80; i++)
+		udelay(10);
+	out_8(x68k_io(X68K_FDC_DATA), FD_RECALIBRATE);
+	for (i = 0; i < 1000 && (in_8(x68k_io(X68K_FDC_STATUS)) & 0xc0) != 0x80; i++)
+		udelay(10);
+	out_8(x68k_io(X68K_FDC_DATA), x68k_fd.dor & 3);
+}
+
+static inline u8 x68k_fd_inb(int reg)
+{
+	switch (reg) {
+	case FD_STATUS:
+		return in_8(x68k_io(X68K_FDC_STATUS));
+	case FD_DATA:
+		return in_8(x68k_io(X68K_FDC_DATA));
+	case FD_DIR:
+		return x68k_fd_dir();
+	}
+	return 0;
+}
+
+static inline void x68k_fd_outb(u8 val, int reg)
+{
+	switch (reg) {
+	case FD_DATA:
+		out_8(x68k_io(X68K_FDC_DATA), val);
+		break;
+	case FD_DOR:
+		x68k_fd.dor = val;
+		x68k_fd_select();
+		/* Leaving reset */
+		if ((val & 0x04) && x68k_fd.in_reset)
+			x68k_fd_reset();
+		x68k_fd.in_reset = !(val & 0x04);
+		break;
+	case FD_DSR:
+		if (val & 0x80)
+			x68k_fd_reset();
+		fallthrough;
+	case FD_DCR:
+		x68k_fd.rate = val & 3;
+		x68k_fd_select();
+		break;
+	}
+}
+
+/* The controller requests each byte, the byte of a 2HD disk comes every 16 us */
+static inline int x68k_fd_dma_setup(char *addr, unsigned long size, bool read)
+{
+	unsigned long phys = virt_to_phys(addr);
+	int err;
+
+	x68k_fd.addr = addr;
+	x68k_fd.size = size;
+	x68k_fd.read = read;
+	x68k_fd.residue = size;
+	cache_push(phys, size);
+	err = x68k_dmac_start(X68K_DMAC_FDC, phys, size,
+			      DMAC_OCR_SIZE_BYTE | DMAC_OCR_REQG_EXT | (read ? DMAC_OCR_DEV2MEM : 0),
+			      X68K_FDC_DATA);
+	x68k_fd.active = !err;
+	return err;
+}
+
+static inline void x68k_fd_dma_stop(void)
+{
+	if (!x68k_fd.active)
+		return;
+	x68k_fd.active = false;
+	x68k_fd.residue = x68k_dmac_stop(X68K_DMAC_FDC);
+	if (x68k_fd.read)
+		cache_clear(virt_to_phys(x68k_fd.addr), x68k_fd.size);
+}
+
+static inline void x68k_fd_irq_enable(bool on)
+{
+	u8 ien = in_8(x68k_io(X68K_IOC + 1)) & 0x0f;
+
+	out_8(x68k_io(X68K_IOC + 1), on ? ien | IOC_FDC_IEN : ien & ~IOC_FDC_IEN);
+}
+
+#endif /* _ASM_M68K_X68KFLOP_H */
diff --git a/arch/m68k/kernel/setup_mm.c b/arch/m68k/kernel/setup_mm.c
index 5acdecf9c2ed..157e1a12b236 100644
--- a/arch/m68k/kernel/setup_mm.c
+++ b/arch/m68k/kernel/setup_mm.c
@@ -208,6 +208,12 @@ static void __init m68k_parse_bootinfo(const struct bi_record *record)
 #endif
 }
 
+/* The floppy driver takes this lock, m68k has no ISA DMA API defining it */
+#if IS_ENABLED(CONFIG_BLK_DEV_FD) && !defined(CONFIG_ISA_DMA_API)
+DEFINE_SPINLOCK(dma_spin_lock);
+EXPORT_SYMBOL(dma_spin_lock);
+#endif
+
 #if defined(CONFIG_MAC) || defined(CONFIG_NEXT) || defined(CONFIG_X68K)
 /* Z8530 ports, the machine setup code provides their resources */
 struct platform_device scc_a_pdev = {
diff --git a/arch/m68k/next/dma.c b/arch/m68k/next/dma.c
index 24a51b976a17..b0217d3836d2 100644
--- a/arch/m68k/next/dma.c
+++ b/arch/m68k/next/dma.c
@@ -14,8 +14,6 @@
 #include <asm/nextdma.h>
 
 /* Used by the generic floppy driver, there is no ISA DMA API on m68k */
-DEFINE_SPINLOCK(dma_spin_lock);
-EXPORT_SYMBOL(dma_spin_lock);
 
 u32 nextdma_csr_read(unsigned int chan)
 {
-- 
2.54.0


From d257d41d9a47bdec63ed335e459cacb546689109 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 11:22:46 +0100
Subject: [PATCH 13/31] m68k: x68k: Add HD63450 DMA and YM2151 control port
 helpers
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The DMA controller moves single blocks for the floppy and the ADPCM sound.  The
control pins of the YM2151 are shared by the sound and floppy drivers, as the
register cannot be read back a copy keeps the bits of both.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/x68k_defconfig |  1 +
 arch/m68k/include/asm/x68k.h     |  6 +++
 arch/m68k/include/asm/x68kdmac.h | 27 ++++++++++
 arch/m68k/x68k/Makefile          |  2 +-
 arch/m68k/x68k/config.c          | 46 ++++++++++++++++
 arch/m68k/x68k/dmac.c            | 92 ++++++++++++++++++++++++++++++++
 6 files changed, 173 insertions(+), 1 deletion(-)
 create mode 100644 arch/m68k/include/asm/x68kdmac.h
 create mode 100644 arch/m68k/x68k/dmac.c

diff --git a/arch/m68k/configs/x68k_defconfig b/arch/m68k/configs/x68k_defconfig
index b3f0c6f839db..ce6b17b78beb 100644
--- a/arch/m68k/configs/x68k_defconfig
+++ b/arch/m68k/configs/x68k_defconfig
@@ -29,6 +29,7 @@ CONFIG_INET=y
 CONFIG_DEVTMPFS=y
 CONFIG_DEVTMPFS_MOUNT=y
 CONFIG_BLK_DEV=y
+CONFIG_BLK_DEV_FD=y
 CONFIG_BLK_DEV_LOOP=y
 CONFIG_BLK_DEV_SD=y
 CONFIG_BLK_DEV_SR=y
diff --git a/arch/m68k/include/asm/x68k.h b/arch/m68k/include/asm/x68k.h
index 746df6d481c1..a5d5f4c35999 100644
--- a/arch/m68k/include/asm/x68k.h
+++ b/arch/m68k/include/asm/x68k.h
@@ -62,6 +62,12 @@ static inline void __iomem *x68k_mfp(unsigned int reg)
 #define IRQ_X68K_TIMER		IRQ_X68K_MFP(5)		/* timer C */
 #define IRQ_X68K_SCC		X68K_IRQ(X68K_VEC_SCC)
 
+/* Register 0x1b of the YM2151 also drives the CT pins, shared by sound and floppy */
+#define X68K_OPM_CT_ADPCM_4MHZ	0x80
+#define X68K_OPM_CT_FDC_READY	0x40
+void x68k_opm_write(u8 reg, u8 val);
+void x68k_opm_set_ct(u8 mask, u8 val);
+
 void x68k_init_IRQ(void);
 void x68k_sched_init(void);
 void x68k_rom_reset(void);
diff --git a/arch/m68k/include/asm/x68kdmac.h b/arch/m68k/include/asm/x68kdmac.h
new file mode 100644
index 000000000000..a9bdab848e56
--- /dev/null
+++ b/arch/m68k/include/asm/x68kdmac.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Sharp X68030 Hitachi HD63450 DMA controller, channels 0 floppy, 1 and 2 SCSI and
+ * expansion, 3 ADPCM
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef _ASM_M68K_X68KDMAC_H
+#define _ASM_M68K_X68KDMAC_H
+
+#include <linux/types.h>
+
+#define X68K_DMAC_FDC		0
+#define X68K_DMAC_ADPCM		3
+
+/* Operation control: transfer direction and request source */
+#define DMAC_OCR_DEV2MEM	0x80
+#define DMAC_OCR_SIZE_BYTE	0x00
+#define DMAC_OCR_REQG_EXT	0x02
+
+int x68k_dmac_start(unsigned int ch, unsigned long phys, unsigned int len, u8 ocr,
+		    unsigned long dev_phys);
+unsigned int x68k_dmac_stop(unsigned int ch);
+bool x68k_dmac_busy(unsigned int ch);
+
+#endif /* _ASM_M68K_X68KDMAC_H */
diff --git a/arch/m68k/x68k/Makefile b/arch/m68k/x68k/Makefile
index f65ef1a961ef..7a7cf56df58a 100644
--- a/arch/m68k/x68k/Makefile
+++ b/arch/m68k/x68k/Makefile
@@ -3,4 +3,4 @@
 # Makefile for Linux arch/m68k/x68k source directory
 #
 
-obj-y		:= config.o ints.o reset.o sram.o time.o
+obj-y		:= config.o dmac.o ints.o reset.o sram.o time.o
diff --git a/arch/m68k/x68k/config.c b/arch/m68k/x68k/config.c
index b463a9562821..816ba0d0597e 100644
--- a/arch/m68k/x68k/config.c
+++ b/arch/m68k/x68k/config.c
@@ -5,12 +5,14 @@
  * Copyright (C) 2026 René Rebe <rene@exactco.de>
  */
 
+#include <linux/delay.h>
 #include <linux/init.h>
 #include <linux/kernel.h>
 #include <linux/platform_data/pmac_zilog.h>
 #include <linux/platform_data/rtc-rp5c01.h>
 #include <linux/reboot.h>
 #include <linux/platform_device.h>
+#include <linux/spinlock.h>
 
 #include <asm/bootinfo.h>
 #include <asm/config.h>
@@ -106,6 +108,50 @@ void __init config_x68k(void)
 	register_platform_power_off(x68k_power_off);
 }
 
+#ifdef CONFIG_BLK_DEV_FD
+#include <asm/x68kflop.h>
+
+struct x68k_fd_state x68k_fd = { .dor = 0x04 };
+#endif
+
+#define OPM_ADDR	0x00e90001
+#define OPM_DATA	0x00e90003
+#define OPM_BUSY	0x80
+#define OPM_REG_CT	0x1b
+
+static DEFINE_SPINLOCK(opm_lock);
+static u8 opm_ct;
+
+void x68k_opm_write(u8 reg, u8 val)
+{
+	unsigned long flags;
+	unsigned int i;
+
+	spin_lock_irqsave(&opm_lock, flags);
+	for (i = 0; i < 1000 && (in_8(x68k_io(OPM_DATA)) & OPM_BUSY); i++)
+		udelay(1);
+	out_8(x68k_io(OPM_ADDR), reg);
+	for (i = 0; i < 1000 && (in_8(x68k_io(OPM_DATA)) & OPM_BUSY); i++)
+		udelay(1);
+	out_8(x68k_io(OPM_DATA), reg == OPM_REG_CT ? (val & 0x3f) | opm_ct : val);
+	if (reg == OPM_REG_CT)
+		opm_ct = (opm_ct & 0xc0) | (val & 0x3f);
+	spin_unlock_irqrestore(&opm_lock, flags);
+}
+EXPORT_SYMBOL_GPL(x68k_opm_write);
+
+/* The register cannot be read back, a copy keeps the bits of the other user */
+void x68k_opm_set_ct(u8 mask, u8 val)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&opm_lock, flags);
+	opm_ct = (opm_ct & ~mask) | (val & mask);
+	spin_unlock_irqrestore(&opm_lock, flags);
+	x68k_opm_write(OPM_REG_CT, opm_ct & 0x3f);
+}
+EXPORT_SYMBOL_GPL(x68k_opm_set_ct);
+
 static struct pmz_platform_data x68k_scc_pdata = {
 	.pclk	= SCC_PCLK,
 	.vector	= X68K_VEC_SCC,
diff --git a/arch/m68k/x68k/dmac.c b/arch/m68k/x68k/dmac.c
new file mode 100644
index 000000000000..d547752af46a
--- /dev/null
+++ b/arch/m68k/x68k/dmac.c
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp X68030 HD63450 DMA controller, single block transfers between memory and
+ * an 8 bit device which requests each byte
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/export.h>
+#include <linux/io.h>
+#include <linux/spinlock.h>
+
+#include <asm/x68k.h>
+#include <asm/x68kdmac.h>
+
+#define DMAC_CH(ch)		(X68K_DMAC + 0x40 * (ch))
+#define DMAC_CSR		0x00
+#define DMAC_CER		0x01
+#define DMAC_DCR		0x04
+#define DMAC_OCR		0x05
+#define DMAC_SCR		0x06
+#define DMAC_CCR		0x07
+#define DMAC_MTC		0x0a
+#define DMAC_MAR		0x0c
+#define DMAC_DAR		0x14
+#define DMAC_MFC		0x29
+#define DMAC_CPR		0x2d
+#define DMAC_DFC		0x31
+
+#define DCR_CYCLE_STEAL		0x80	/* 68000 type device, 8 bit port */
+#define SCR_MEM_COUNT_UP	0x04
+#define CCR_START		0x80
+#define CCR_ABORT		0x10
+#define CSR_ACTIVE		0x08
+#define FC_SUPER_DATA		0x05
+
+#define DMAC_MAX_LEN		0xffff
+
+static DEFINE_SPINLOCK(dmac_lock);
+
+static void __iomem *dmac_reg(unsigned int ch, unsigned int reg)
+{
+	return x68k_io(DMAC_CH(ch) + reg);
+}
+
+int x68k_dmac_start(unsigned int ch, unsigned long phys, unsigned int len, u8 ocr,
+		    unsigned long dev_phys)
+{
+	unsigned long flags;
+
+	if (!len || len > DMAC_MAX_LEN)
+		return -EINVAL;
+
+	spin_lock_irqsave(&dmac_lock, flags);
+	out_8(dmac_reg(ch, DMAC_CCR), CCR_ABORT);
+	out_8(dmac_reg(ch, DMAC_CSR), 0xff);
+	out_8(dmac_reg(ch, DMAC_DCR), DCR_CYCLE_STEAL);
+	out_8(dmac_reg(ch, DMAC_OCR), ocr);
+	out_8(dmac_reg(ch, DMAC_SCR), SCR_MEM_COUNT_UP);
+	out_8(dmac_reg(ch, DMAC_MFC), FC_SUPER_DATA);
+	out_8(dmac_reg(ch, DMAC_DFC), FC_SUPER_DATA);
+	out_8(dmac_reg(ch, DMAC_CPR), 0);
+	out_be16(dmac_reg(ch, DMAC_MTC), len);
+	out_be32(dmac_reg(ch, DMAC_MAR), phys);
+	out_be32(dmac_reg(ch, DMAC_DAR), dev_phys);
+	out_8(dmac_reg(ch, DMAC_CCR), CCR_START);
+	spin_unlock_irqrestore(&dmac_lock, flags);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(x68k_dmac_start);
+
+/* Returns the bytes not transferred */
+unsigned int x68k_dmac_stop(unsigned int ch)
+{
+	unsigned long flags;
+	unsigned int left;
+
+	spin_lock_irqsave(&dmac_lock, flags);
+	if (in_8(dmac_reg(ch, DMAC_CSR)) & CSR_ACTIVE)
+		out_8(dmac_reg(ch, DMAC_CCR), CCR_ABORT);
+	left = in_be16(dmac_reg(ch, DMAC_MTC));
+	out_8(dmac_reg(ch, DMAC_CSR), 0xff);
+	spin_unlock_irqrestore(&dmac_lock, flags);
+	return left;
+}
+EXPORT_SYMBOL_GPL(x68k_dmac_stop);
+
+bool x68k_dmac_busy(unsigned int ch)
+{
+	return in_8(dmac_reg(ch, DMAC_CSR)) & CSR_ACTIVE;
+}
+EXPORT_SYMBOL_GPL(x68k_dmac_busy);
-- 
2.54.0


From fd8e70bc0c4132daa5a63cc978e1290e505188cd Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 11:26:43 +0100
Subject: [PATCH 14/31] m68k: irq: Set up user vector interrupts at their
 interrupt numbers
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

User vector interrupts are numbered from IRQ_USER, but the chip was set up for
the numbers from 0.  This replaced the chip of the autovector interrupts, and
the last IRQ_USER user vectors had no chip, so requesting them failed with
-ENOSYS.  The callers that cover all interrupt numbers did not notice, the
Atari one already subtracts IRQ_USER from its count.

Found with the DMA interrupts of the Sharp X68030 sound driver.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/kernel/ints.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/m68k/kernel/ints.c b/arch/m68k/kernel/ints.c
index cf2b13488476..eb41aace61d4 100644
--- a/arch/m68k/kernel/ints.c
+++ b/arch/m68k/kernel/ints.c
@@ -97,7 +97,8 @@ void __init m68k_setup_user_interrupt(unsigned int vec, unsigned int cnt)
 	BUG_ON(IRQ_USER + cnt > NR_IRQS);
 	m68k_first_user_vec = vec;
 	for (i = 0; i < cnt; i++)
-		irq_set_chip_and_handler(i, &user_irq_chip, handle_simple_irq);
+		irq_set_chip_and_handler(IRQ_USER + i, &user_irq_chip,
+					 handle_simple_irq);
 	*user_irqvec_fixup = vec - IRQ_USER;
 	flush_icache();
 }
-- 
2.54.0


From fcee72cf3d006a9cca3c9b7920bfc3809b7314f8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 11:30:36 +0100
Subject: [PATCH 15/31] ALSA: Add Sharp X68030 sound driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Play 16 bit mono PCM through the OKI MSM6258 ADPCM decoder: each period is
encoded with the arithmetic of the decoder and fed by DMA channel 3 in continue
mode, one block playing while the next waits.  The position given to ALSA is
what was encoded, only data the application wrote is used, silence otherwise.
Rates are 3906 to 15625 Hz, from the 8 or 4 MHz clock selected through the
YM2151 and a divider on the 8255.

The YM2151 FM synthesizer gets a hwdep device taking register and value pairs.

Tested on MAME by recording its output: a 1 kHz sine and an FM note.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/x68k_defconfig |   3 +
 arch/m68k/x68k/config.c          |   1 +
 sound/m68k/Kconfig               |  13 +
 sound/m68k/Makefile              |   3 +
 sound/m68k/x68k_snd.c            | 432 +++++++++++++++++++++++++++++++
 5 files changed, 452 insertions(+)
 create mode 100644 sound/m68k/x68k_snd.c

diff --git a/arch/m68k/configs/x68k_defconfig b/arch/m68k/configs/x68k_defconfig
index ce6b17b78beb..f89de6113c1f 100644
--- a/arch/m68k/configs/x68k_defconfig
+++ b/arch/m68k/configs/x68k_defconfig
@@ -62,3 +62,6 @@ CONFIG_NVMEM=y
 CONFIG_ZSMALLOC=y
 CONFIG_ZRAM=y
 CONFIG_CRYPTO_LZO=y
+CONFIG_SOUND=y
+CONFIG_SND=y
+CONFIG_SND_X68K=y
diff --git a/arch/m68k/x68k/config.c b/arch/m68k/x68k/config.c
index 816ba0d0597e..c4ae23b969d5 100644
--- a/arch/m68k/x68k/config.c
+++ b/arch/m68k/x68k/config.c
@@ -196,6 +196,7 @@ static int __init x68k_platform_init(void)
 	platform_device_register_simple("x68kmouse", -1, NULL, 0);
 	platform_device_register_simple("x68kjoy", -1, NULL, 0);
 	platform_device_register_simple("x68k_sram", -1, NULL, 0);
+	platform_device_register_simple("x68k-snd", -1, NULL, 0);
 	platform_device_register_resndata(NULL, "rtc-rp5c01", -1, &x68k_rtc_rsrc, 1,
 					  &x68k_rtc_pdata, sizeof(x68k_rtc_pdata));
 	return 0;
diff --git a/sound/m68k/Kconfig b/sound/m68k/Kconfig
index f295a04c730c..8c9eab0e2d64 100644
--- a/sound/m68k/Kconfig
+++ b/sound/m68k/Kconfig
@@ -21,4 +21,17 @@ config SND_NEXT
 	  To compile this driver as a module, choose M here: the module
 	  will be called snd-next.
 
+config SND_X68K
+	tristate "Sharp X68030 sound"
+	depends on X68K
+	select SND_PCM
+	select SND_HWDEP
+	help
+	  Say Y here for 16 bit PCM playback through the MSM6258 ADPCM
+	  decoder of the Sharp X68030, and register access to its YM2151 FM
+	  synthesizer.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called snd-x68k.
+
 endif # SND_M68K
diff --git a/sound/m68k/Makefile b/sound/m68k/Makefile
index 0fb280fa69cc..bd1db8dbb748 100644
--- a/sound/m68k/Makefile
+++ b/sound/m68k/Makefile
@@ -1,4 +1,7 @@
 # SPDX-License-Identifier: GPL-2.0-only
 snd-next-y := next_snd.o
 
+snd-x68k-y := x68k_snd.o
+
 obj-$(CONFIG_SND_NEXT) += snd-next.o
+obj-$(CONFIG_SND_X68K) += snd-x68k.o
diff --git a/sound/m68k/x68k_snd.c b/sound/m68k/x68k_snd.c
new file mode 100644
index 000000000000..7ee76459a325
--- /dev/null
+++ b/sound/m68k/x68k_snd.c
@@ -0,0 +1,432 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp X68030 sound: 16 bit PCM played through the OKI MSM6258 ADPCM decoder fed
+ * by DMA channel 3, and register access to the YM2151 FM synthesizer.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include <sound/control.h>
+#include <sound/core.h>
+#include <sound/hwdep.h>
+#include <sound/initval.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+
+#include <asm/cacheflush.h>
+#include <asm/x68k.h>
+#include <asm/x68kdmac.h>
+
+#define ADPCM_CMD		0x00e92001
+#define ADPCM_DATA		0x00e92003
+#define ADPCM_STOP		0x01
+#define ADPCM_PLAY		0x02
+
+/* Rate and output select are on port C of the 8255, set bit by bit */
+#define PPI_CTRL		0x00e9a007
+#define PPI_BIT(n, on)		(((n) << 1) | ((on) ? 1 : 0))
+#define PPI_PAN_LEFT_OFF	0	/* the bit turns the left channel off */
+#define PPI_PAN_RIGHT_OFF	1
+#define PPI_RATE0		2
+
+#define DMAC_CH3		(X68K_DMAC + 0x40 * X68K_DMAC_ADPCM)
+#define DMAC_CSR		0x00
+#define DMAC_CCR		0x07
+#define DMAC_BTC		0x1a
+#define DMAC_BAR		0x1c
+#define DMAC_NIV		0x25
+#define DMAC_EIV		0x27
+#define CSR_BLOCK_DONE		0x40
+#define CSR_ERROR		0x10
+#define CCR_START		0x80
+#define CCR_CONTINUE		0x40
+#define CCR_INT			0x08
+#define DMAC_VEC_NORMAL		(X68K_VEC_DMAC + 2 * X68K_DMAC_ADPCM)
+#define DMAC_VEC_ERROR		(DMAC_VEC_NORMAL + 1)
+
+#define ADPCM_SLOTS		3	/* playing, queued, being encoded */
+#define MAX_PERIOD_BYTES	8192
+#define MAX_BUFFER_BYTES	(64 * 1024)
+
+/* 8 or 4 MHz divided by 1024, 768 or 512 */
+static const unsigned int x68k_rates[] = { 3906, 5208, 7813, 10417, 15625 };
+static const u8 x68k_rate_div[] = { 0, 1, 0, 1, 2 };
+static const bool x68k_rate_4mhz[] = { true, true, false, false, false };
+
+static const struct snd_pcm_hw_constraint_list x68k_rate_list = {
+	.count	= ARRAY_SIZE(x68k_rates),
+	.list	= x68k_rates,
+};
+
+static const s16 oki_steps[49] = {
+	16, 17, 19, 21, 23, 25, 28, 31, 34, 37, 41, 45, 50, 55, 60, 66, 73, 80, 88, 97,
+	107, 118, 130, 143, 157, 173, 190, 209, 230, 253, 279, 307, 337, 371, 408, 449,
+	494, 544, 598, 658, 724, 796, 876, 963, 1060, 1166, 1282, 1411, 1552,
+};
+static const s8 oki_index_shift[8] = { -1, -1, -1, -1, 2, 4, 6, 8 };
+
+struct x68k_snd {
+	struct snd_card *card;
+	struct snd_pcm_substream *substream;
+	spinlock_t lock;
+	u8 *adpcm;			/* ADPCM_SLOTS periods for the DMA */
+	unsigned int period_bytes;	/* of ADPCM, half the frames */
+	unsigned int next_encode;	/* period of the ALSA buffer */
+	snd_pcm_uframes_t pending;	/* consumed since ALSA last saw the pointer */
+	unsigned int slot;
+	int signal;
+	int step;
+	bool pan_left;
+	bool pan_right;
+};
+
+static void x68k_ppi_bit(unsigned int bit, bool on)
+{
+	out_8(x68k_io(PPI_CTRL), PPI_BIT(bit, on));
+}
+
+/* Same arithmetic as the decoder, so that both follow the same signal */
+static u8 oki_encode_sample(struct x68k_snd *chip, int sample)
+{
+	int step = oki_steps[chip->step];
+	int diff = (sample >> 4) - chip->signal;
+	int delta = step >> 3;
+	u8 nibble = 0;
+
+	if (diff < 0) {
+		nibble = 8;
+		diff = -diff;
+	}
+	if (diff >= step) {
+		nibble |= 4;
+		diff -= step;
+		delta += step;
+	}
+	step >>= 1;
+	if (diff >= step) {
+		nibble |= 2;
+		diff -= step;
+		delta += step;
+	}
+	step >>= 1;
+	if (diff >= step) {
+		nibble |= 1;
+		delta += step;
+	}
+
+	chip->signal += nibble & 8 ? -delta : delta;
+	chip->signal = clamp(chip->signal, -2048, 2047);
+	chip->step = clamp(chip->step + oki_index_shift[nibble & 7], 0, 48);
+	return nibble;
+}
+
+/*
+ * Encode the next period if the application wrote it, else silence. The data is
+ * consumed here, two periods ahead of the decoder, which is the position ALSA
+ * gets: the application may overwrite all that was encoded.
+ */
+static void x68k_encode_period(struct x68k_snd *chip, unsigned int slot)
+{
+	struct snd_pcm_runtime *runtime = chip->substream->runtime;
+	u8 *out = chip->adpcm + slot * chip->period_bytes;
+	const s16 *pcm = NULL;
+	unsigned int i;
+
+	if (snd_pcm_playback_hw_avail(runtime) >= runtime->period_size + chip->pending)
+		pcm = (const s16 *)(runtime->dma_area +
+				    frames_to_bytes(runtime, chip->next_encode * runtime->period_size));
+
+	for (i = 0; i < chip->period_bytes; i++) {
+		u8 lo = oki_encode_sample(chip, pcm ? pcm[2 * i] : 0);
+
+		out[i] = lo | oki_encode_sample(chip, pcm ? pcm[2 * i + 1] : 0) << 4;
+	}
+	cache_push(virt_to_phys(out), chip->period_bytes);
+	if (pcm) {
+		chip->next_encode = (chip->next_encode + 1) % runtime->periods;
+		chip->pending += runtime->period_size;
+	}
+}
+
+static void x68k_queue_slot(struct x68k_snd *chip, unsigned int slot)
+{
+	out_be32(x68k_io(DMAC_CH3 + DMAC_BAR), virt_to_phys(chip->adpcm + slot * chip->period_bytes));
+	out_be16(x68k_io(DMAC_CH3 + DMAC_BTC), chip->period_bytes);
+}
+
+static irqreturn_t x68k_snd_interrupt(int irq, void *dev_id)
+{
+	struct x68k_snd *chip = dev_id;
+	struct snd_pcm_substream *substream;
+	u8 csr = in_8(x68k_io(DMAC_CH3 + DMAC_CSR));
+
+	if (!(csr & (CSR_BLOCK_DONE | CSR_ERROR)))
+		return IRQ_NONE;
+	out_8(x68k_io(DMAC_CH3 + DMAC_CSR), csr);
+
+	spin_lock(&chip->lock);
+	substream = chip->substream;
+	if (substream && !(csr & CSR_ERROR)) {
+		/* The queued block runs now, the next one goes behind it */
+		chip->slot = (chip->slot + 1) % ADPCM_SLOTS;
+		x68k_encode_period(chip, chip->slot);
+		x68k_queue_slot(chip, chip->slot);
+		/* The start bit would restart the channel, only arm the next block */
+		out_8(x68k_io(DMAC_CH3 + DMAC_CCR), CCR_CONTINUE | CCR_INT);
+	}
+	spin_unlock(&chip->lock);
+
+	if (substream) {
+		snd_pcm_period_elapsed(substream);
+		spin_lock(&chip->lock);
+		chip->pending = 0;
+		spin_unlock(&chip->lock);
+	}
+	return IRQ_HANDLED;
+}
+
+static const struct snd_pcm_hardware x68k_snd_hw = {
+	.info		= SNDRV_PCM_INFO_MMAP | SNDRV_PCM_INFO_MMAP_VALID |
+			  SNDRV_PCM_INFO_INTERLEAVED | SNDRV_PCM_INFO_BLOCK_TRANSFER,
+	.formats	= SNDRV_PCM_FMTBIT_S16,
+	.rates		= SNDRV_PCM_RATE_KNOT,
+	.rate_min	= 3906,
+	.rate_max	= 15625,
+	.channels_min	= 1,
+	.channels_max	= 1,
+	.buffer_bytes_max = MAX_BUFFER_BYTES,
+	.period_bytes_min = 256,
+	.period_bytes_max = MAX_PERIOD_BYTES,
+	.periods_min	= ADPCM_SLOTS,
+	.periods_max	= 64,
+};
+
+static int x68k_snd_open(struct snd_pcm_substream *substream)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	int err;
+
+	runtime->hw = x68k_snd_hw;
+	err = snd_pcm_hw_constraint_list(runtime, 0, SNDRV_PCM_HW_PARAM_RATE, &x68k_rate_list);
+	if (err < 0)
+		return err;
+	/* Two samples per ADPCM byte */
+	err = snd_pcm_hw_constraint_step(runtime, 0, SNDRV_PCM_HW_PARAM_PERIOD_SIZE, 2);
+	if (err < 0)
+		return err;
+	return snd_pcm_hw_constraint_integer(runtime, SNDRV_PCM_HW_PARAM_PERIODS);
+}
+
+static int x68k_snd_close(struct snd_pcm_substream *substream)
+{
+	return 0;
+}
+
+static int x68k_snd_prepare(struct snd_pcm_substream *substream)
+{
+	struct x68k_snd *chip = snd_pcm_substream_chip(substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(x68k_rates); i++)
+		if (x68k_rates[i] == runtime->rate)
+			break;
+	if (i == ARRAY_SIZE(x68k_rates))
+		return -EINVAL;
+
+	x68k_opm_set_ct(X68K_OPM_CT_ADPCM_4MHZ, x68k_rate_4mhz[i] ? X68K_OPM_CT_ADPCM_4MHZ : 0);
+	x68k_ppi_bit(PPI_RATE0, x68k_rate_div[i] & 1);
+	x68k_ppi_bit(PPI_RATE0 + 1, x68k_rate_div[i] & 2);
+
+	chip->period_bytes = frames_to_bytes(runtime, runtime->period_size) / 4;
+	return 0;
+}
+
+static int x68k_snd_trigger(struct snd_pcm_substream *substream, int cmd)
+{
+	struct x68k_snd *chip = snd_pcm_substream_chip(substream);
+	unsigned int len;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+		spin_lock(&chip->lock);
+		chip->substream = substream;
+		chip->next_encode = 0;
+		chip->pending = 0;
+		chip->slot = 1;
+		/* The decoder starts from this state at play */
+		chip->signal = -2;
+		chip->step = 0;
+		x68k_encode_period(chip, 0);
+		x68k_encode_period(chip, 1);
+		len = chip->period_bytes;
+		/* Started first, the decoder must not miss the first byte */
+		out_8(x68k_io(ADPCM_CMD), ADPCM_PLAY);
+		out_8(x68k_io(DMAC_CH3 + DMAC_NIV), DMAC_VEC_NORMAL);
+		out_8(x68k_io(DMAC_CH3 + DMAC_EIV), DMAC_VEC_ERROR);
+		x68k_dmac_start(X68K_DMAC_ADPCM, virt_to_phys(chip->adpcm), len,
+				DMAC_OCR_SIZE_BYTE | DMAC_OCR_REQG_EXT, ADPCM_DATA);
+		x68k_queue_slot(chip, 1);
+		out_8(x68k_io(DMAC_CH3 + DMAC_CCR), CCR_CONTINUE | CCR_INT);
+		x68k_ppi_bit(PPI_PAN_LEFT_OFF, !chip->pan_left);
+		x68k_ppi_bit(PPI_PAN_RIGHT_OFF, !chip->pan_right);
+		spin_unlock(&chip->lock);
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+		spin_lock(&chip->lock);
+		out_8(x68k_io(ADPCM_CMD), ADPCM_STOP);
+		x68k_dmac_stop(X68K_DMAC_ADPCM);
+		chip->substream = NULL;
+		spin_unlock(&chip->lock);
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static snd_pcm_uframes_t x68k_snd_pointer(struct snd_pcm_substream *substream)
+{
+	struct x68k_snd *chip = snd_pcm_substream_chip(substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+
+	return chip->next_encode * runtime->period_size;
+}
+
+static const struct snd_pcm_ops x68k_snd_ops = {
+	.open		= x68k_snd_open,
+	.close		= x68k_snd_close,
+	.prepare	= x68k_snd_prepare,
+	.trigger	= x68k_snd_trigger,
+	.pointer	= x68k_snd_pointer,
+};
+
+static int x68k_pan_info(struct snd_kcontrol *kctl, struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_BOOLEAN;
+	uinfo->count = 2;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = 1;
+	return 0;
+}
+
+static int x68k_pan_get(struct snd_kcontrol *kctl, struct snd_ctl_elem_value *v)
+{
+	struct x68k_snd *chip = snd_kcontrol_chip(kctl);
+
+	v->value.integer.value[0] = chip->pan_left;
+	v->value.integer.value[1] = chip->pan_right;
+	return 0;
+}
+
+static int x68k_pan_put(struct snd_kcontrol *kctl, struct snd_ctl_elem_value *v)
+{
+	struct x68k_snd *chip = snd_kcontrol_chip(kctl);
+	bool left = v->value.integer.value[0], right = v->value.integer.value[1];
+	int changed = left != chip->pan_left || right != chip->pan_right;
+
+	chip->pan_left = left;
+	chip->pan_right = right;
+	x68k_ppi_bit(PPI_PAN_LEFT_OFF, !left);
+	x68k_ppi_bit(PPI_PAN_RIGHT_OFF, !right);
+	return changed;
+}
+
+static const struct snd_kcontrol_new x68k_pan_ctl = {
+	.iface	= SNDRV_CTL_ELEM_IFACE_MIXER,
+	.name	= "ADPCM Playback Switch",
+	.info	= x68k_pan_info,
+	.get	= x68k_pan_get,
+	.put	= x68k_pan_put,
+};
+
+/* YM2151: register and value byte pairs */
+static long x68k_opm_hwdep_write(struct snd_hwdep *hw, const char __user *buf, long count,
+				 loff_t *offset)
+{
+	long done;
+	u8 pair[2];
+
+	for (done = 0; done + 1 < count; done += 2) {
+		if (copy_from_user(pair, buf + done, 2))
+			return done ? done : -EFAULT;
+		x68k_opm_write(pair[0], pair[1]);
+	}
+	return done;
+}
+
+static int x68k_snd_probe(struct platform_device *pdev)
+{
+	struct snd_card *card;
+	struct x68k_snd *chip;
+	struct snd_hwdep *hw;
+	struct snd_pcm *pcm;
+	int err;
+
+	err = snd_devm_card_new(&pdev->dev, SNDRV_DEFAULT_IDX1, SNDRV_DEFAULT_STR1, THIS_MODULE,
+				sizeof(*chip), &card);
+	if (err < 0)
+		return err;
+	chip = card->private_data;
+	chip->card = card;
+	spin_lock_init(&chip->lock);
+	chip->pan_left = chip->pan_right = true;
+
+	chip->adpcm = devm_kmalloc(&pdev->dev, ADPCM_SLOTS * MAX_PERIOD_BYTES / 4, GFP_KERNEL | GFP_DMA);
+	if (!chip->adpcm)
+		return -ENOMEM;
+
+	strscpy(card->driver, "X68K", sizeof(card->driver));
+	strscpy(card->shortname, "X68030 sound", sizeof(card->shortname));
+	strscpy(card->longname, "Sharp X68030 MSM6258 ADPCM and YM2151 FM", sizeof(card->longname));
+
+	err = snd_pcm_new(card, "ADPCM", 0, 1, 0, &pcm);
+	if (err < 0)
+		return err;
+	pcm->private_data = chip;
+	strscpy(pcm->name, "MSM6258 ADPCM", sizeof(pcm->name));
+	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_PLAYBACK, &x68k_snd_ops);
+	snd_pcm_set_managed_buffer_all(pcm, SNDRV_DMA_TYPE_VMALLOC, NULL, 0, 0);
+
+	err = snd_ctl_add(card, snd_ctl_new1(&x68k_pan_ctl, chip));
+	if (err < 0)
+		return err;
+
+	err = snd_hwdep_new(card, "YM2151", 0, &hw);
+	if (err < 0)
+		return err;
+	strscpy(hw->name, "YM2151 FM", sizeof(hw->name));
+	hw->ops.write = x68k_opm_hwdep_write;
+
+	out_8(x68k_io(ADPCM_CMD), ADPCM_STOP);
+	err = devm_request_irq(&pdev->dev, X68K_IRQ(DMAC_VEC_NORMAL), x68k_snd_interrupt, 0,
+			       "x68k-adpcm", chip);
+	if (!err)
+		err = devm_request_irq(&pdev->dev, X68K_IRQ(DMAC_VEC_ERROR), x68k_snd_interrupt, 0,
+				       "x68k-adpcm", chip);
+	if (err)
+		return err;
+
+	err = snd_card_register(card);
+	if (err < 0)
+		return err;
+	platform_set_drvdata(pdev, card);
+	return 0;
+}
+
+static struct platform_driver x68k_snd_driver = {
+	.probe	= x68k_snd_probe,
+	.driver	= {
+		.name = "x68k-snd",
+	},
+};
+module_platform_driver(x68k_snd_driver);
+
+MODULE_DESCRIPTION("Sharp X68030 sound driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 4db23578085250f376e5cec7cec964ec75def15a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 11:35:08 +0100
Subject: [PATCH 16/31] fbdev: Add Sharp X68030 graphics screen driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Offer the graphics screen as a 512x512 framebuffer with 65536 colours.  The
CRTC switches to this mode while the device is open and back to the 768 dot
text mode after.  An identity palette passes both bytes of a pixel unchanged,
derived from the lookup XM6 implements; MAME skips the palette in this mode.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/x68k_defconfig |   1 +
 arch/m68k/x68k/config.c          |   1 +
 drivers/video/fbdev/Kconfig      |   8 ++
 drivers/video/fbdev/Makefile     |   1 +
 drivers/video/fbdev/x68kgfb.c    | 178 +++++++++++++++++++++++++++++++
 5 files changed, 189 insertions(+)
 create mode 100644 drivers/video/fbdev/x68kgfb.c

diff --git a/arch/m68k/configs/x68k_defconfig b/arch/m68k/configs/x68k_defconfig
index f89de6113c1f..340fc3b0a0d4 100644
--- a/arch/m68k/configs/x68k_defconfig
+++ b/arch/m68k/configs/x68k_defconfig
@@ -50,6 +50,7 @@ CONFIG_VT=y
 CONFIG_VT_CONSOLE=y
 CONFIG_FB=y
 CONFIG_FB_X68K=y
+CONFIG_FB_X68K_GRAPHICS=y
 CONFIG_FRAMEBUFFER_CONSOLE=y
 CONFIG_FONT_SUPPORT=y
 CONFIG_FONTS=y
diff --git a/arch/m68k/x68k/config.c b/arch/m68k/x68k/config.c
index c4ae23b969d5..fe62bb640a21 100644
--- a/arch/m68k/x68k/config.c
+++ b/arch/m68k/x68k/config.c
@@ -191,6 +191,7 @@ static int __init x68k_platform_init(void)
 	/* Channel B is the mouse port */
 	platform_device_register(&scc_a_pdev);
 	platform_device_register_simple("x68kfb", -1, NULL, 0);
+	platform_device_register_simple("x68kgfb", -1, NULL, 0);
 	platform_device_register_simple("x68kkbd", -1, NULL, 0);
 	platform_device_register_simple("x68k_spc", -1, NULL, 0);
 	platform_device_register_simple("x68kmouse", -1, NULL, 0);
diff --git a/drivers/video/fbdev/Kconfig b/drivers/video/fbdev/Kconfig
index 34f24ab52d5e..c03618fac07d 100644
--- a/drivers/video/fbdev/Kconfig
+++ b/drivers/video/fbdev/Kconfig
@@ -206,6 +206,14 @@ config FB_X68K
 	  Support for the text screen of the Sharp X68030 as a monochrome
 	  framebuffer.
 
+config FB_X68K_GRAPHICS
+	bool "Sharp X68030 graphics screen support"
+	depends on (FB = y) && X68K
+	select FB_IOMEM_HELPERS
+	help
+	  Support for the 512x512 graphics screen with 65536 colours of the
+	  Sharp X68030. The display switches to it while the device is open.
+
 config FB_NEXTDIMENSION
 	bool "NeXTdimension framebuffer support"
 	depends on (FB = y) && NEXT
diff --git a/drivers/video/fbdev/Makefile b/drivers/video/fbdev/Makefile
index a4907591eb60..ea62f6aac798 100644
--- a/drivers/video/fbdev/Makefile
+++ b/drivers/video/fbdev/Makefile
@@ -66,6 +66,7 @@ obj-$(CONFIG_FB_APOLLO)           += dnfb.o
 obj-$(CONFIG_FB_Q40)              += q40fb.o
 obj-$(CONFIG_FB_NEXT)             += nextfb.o
 obj-$(CONFIG_FB_X68K)             += x68kfb.o
+obj-$(CONFIG_FB_X68K_GRAPHICS)    += x68kgfb.o
 obj-$(CONFIG_FB_NEXTDIMENSION)    += nextdimfb.o
 obj-$(CONFIG_FB_TGA)              += tgafb.o
 obj-$(CONFIG_FB_HP300)            += hpfb.o
diff --git a/drivers/video/fbdev/x68kgfb.c b/drivers/video/fbdev/x68kgfb.c
new file mode 100644
index 000000000000..dfdf079bc805
--- /dev/null
+++ b/drivers/video/fbdev/x68kgfb.c
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp X68030 graphics screen: 512x512 with 65536 colours. The CRTC switches to
+ * this mode while the device is open, the text console shrinks to the same size
+ * for that time.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/fb.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+
+#include <asm/io.h>
+#include <asm/x68k.h>
+
+#define GVRAM_PHYS	0x00c00000
+#define GFB_SIZE	512
+#define GFB_PITCH	(GFB_SIZE * 2)
+#define GFB_LEN		(GFB_PITCH * GFB_SIZE)
+
+#define CRTC_REG(n)	(0x00e80000 + 2 * (n))
+#define CRTC_R20	20
+#define GRAPHIC_PALETTE	0x00e82000
+#define VC_MODE		0x00e82400	/* graphics colour mode */
+#define VC_LAYERS	0x00e82600	/* layers shown */
+#define VC_MODE_64K	0x0003
+#define VC_LAYERS_GFX	0x000f
+
+/* Horizontal timing of the 31 kHz 512 and 768 dot modes, the vertical one is shared */
+static const u16 timing_512[] = { 0x005b, 0x0009, 0x0011, 0x0051 };
+static const u16 timing_768[] = { 0x0089, 0x000e, 0x001c, 0x007c };
+#define R20_512_64K	0x0315	/* 65536 colours, 31 kHz, 512x512 */
+
+struct x68kgfb_par {
+	struct mutex lock;
+	unsigned int users;
+	u16 r20;
+	u16 vc_mode;
+	u16 vc_layers;
+	u32 pseudo_palette[16];
+};
+
+static void x68kgfb_timing(const u16 *t)
+{
+	int i;
+
+	for (i = 0; i < 4; i++)
+		out_be16(x68k_io(CRTC_REG(i)), t[i]);
+}
+
+/*
+ * In this mode the two bytes of a pixel go through halves of the palette: an
+ * entry pair 2n, 2n + 1 holding 2n and 2n + 1 passes both bytes unchanged.
+ */
+static void x68kgfb_identity_palette(void)
+{
+	int i;
+
+	for (i = 0; i < 256; i++) {
+		u16 n = i & ~1;
+
+		out_be16(x68k_io(GRAPHIC_PALETTE) + 2 * i, (n << 8) | (n + 1));
+	}
+}
+
+static int x68kgfb_open(struct fb_info *info, int user)
+{
+	struct x68kgfb_par *par = info->par;
+
+	mutex_lock(&par->lock);
+	if (!par->users++) {
+		par->r20 = in_be16(x68k_io(CRTC_REG(CRTC_R20)));
+		par->vc_mode = in_be16(x68k_io(VC_MODE));
+		par->vc_layers = in_be16(x68k_io(VC_LAYERS));
+		x68kgfb_identity_palette();
+		x68kgfb_timing(timing_512);
+		out_be16(x68k_io(CRTC_REG(CRTC_R20)), R20_512_64K);
+		out_be16(x68k_io(VC_MODE), VC_MODE_64K);
+		out_be16(x68k_io(VC_LAYERS), par->vc_layers | VC_LAYERS_GFX);
+	}
+	mutex_unlock(&par->lock);
+	return 0;
+}
+
+static int x68kgfb_release(struct fb_info *info, int user)
+{
+	struct x68kgfb_par *par = info->par;
+
+	mutex_lock(&par->lock);
+	if (!--par->users) {
+		out_be16(x68k_io(VC_LAYERS), par->vc_layers);
+		out_be16(x68k_io(VC_MODE), par->vc_mode);
+		out_be16(x68k_io(CRTC_REG(CRTC_R20)), par->r20);
+		x68kgfb_timing(timing_768);
+	}
+	mutex_unlock(&par->lock);
+	return 0;
+}
+
+static int x68kgfb_setcolreg(unsigned int regno, unsigned int red, unsigned int green,
+			     unsigned int blue, unsigned int transp, struct fb_info *info)
+{
+	if (regno >= 16)
+		return 1;
+	((u32 *)info->pseudo_palette)[regno] = ((green >> 11) << 11) | ((red >> 11) << 6) |
+					       ((blue >> 11) << 1);
+	return 0;
+}
+
+static const struct fb_ops x68kgfb_ops = {
+	.owner		= THIS_MODULE,
+	.fb_open	= x68kgfb_open,
+	.fb_release	= x68kgfb_release,
+	.fb_setcolreg	= x68kgfb_setcolreg,
+	FB_DEFAULT_IOMEM_OPS,
+};
+
+static int x68kgfb_probe(struct platform_device *pdev)
+{
+	struct x68kgfb_par *par;
+	struct fb_info *info;
+	int err;
+
+	info = framebuffer_alloc(sizeof(*par), &pdev->dev);
+	if (!info)
+		return -ENOMEM;
+	par = info->par;
+	mutex_init(&par->lock);
+
+	strscpy(info->fix.id, "x68kgfb", sizeof(info->fix.id));
+	info->fix.smem_start = GVRAM_PHYS;
+	info->fix.smem_len = GFB_LEN;
+	info->fix.type = FB_TYPE_PACKED_PIXELS;
+	info->fix.visual = FB_VISUAL_TRUECOLOR;
+	info->fix.line_length = GFB_PITCH;
+	info->fix.accel = FB_ACCEL_NONE;
+
+	info->var.xres = info->var.xres_virtual = GFB_SIZE;
+	info->var.yres = info->var.yres_virtual = GFB_SIZE;
+	info->var.bits_per_pixel = 16;
+	/* Green, red and blue with 5 bits, an intensity bit below */
+	info->var.green = (struct fb_bitfield){ .offset = 11, .length = 5 };
+	info->var.red = (struct fb_bitfield){ .offset = 6, .length = 5 };
+	info->var.blue = (struct fb_bitfield){ .offset = 1, .length = 5 };
+	info->var.activate = FB_ACTIVATE_NOW;
+	info->var.vmode = FB_VMODE_NONINTERLACED;
+	info->var.height = info->var.width = -1;
+
+	info->fbops = &x68kgfb_ops;
+	info->pseudo_palette = par->pseudo_palette;
+	info->screen_base = x68k_io(GVRAM_PHYS);
+	info->screen_size = GFB_LEN;
+	memset_io(info->screen_base, 0, GFB_LEN);
+
+	err = register_framebuffer(info);
+	if (err) {
+		framebuffer_release(info);
+		return err;
+	}
+	platform_set_drvdata(pdev, info);
+	fb_info(info, "X68030 graphics screen, %ux%u, 65536 colours\n", GFB_SIZE, GFB_SIZE);
+	return 0;
+}
+
+static struct platform_driver x68kgfb_driver = {
+	.probe	= x68kgfb_probe,
+	.driver	= {
+		.name = "x68kgfb",
+	},
+};
+builtin_platform_driver(x68kgfb_driver);
+
+MODULE_DESCRIPTION("Sharp X68030 graphics screen framebuffer driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From da1a32cc9ad1647de0332d2f966d87d6cc5855e1 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 11:51:17 +0100
Subject: [PATCH 17/31] net: 8390: Add Neptune-X driver for the Sharp X68000
 series
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Neptune-X puts a DP8390 on the even bytes of the expansion I/O space like
the Amiga cards of zorro8390.c, which this is derived from.  It interrupts with
vector 0xf9, so the user vectors of the X68030 now reach to 0xff.

The interrupt cannot be masked in the machine, but lib8390 disables it while
sending.  The transmit interrupt then came back without end, so the card masks
it through its own interrupt mask register.

Tested on MAME with the internal loopback of the chip.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/x68k_defconfig         |   2 +
 arch/m68k/include/asm/irq.h              |   2 +-
 arch/m68k/include/asm/x68k.h             |   2 +-
 arch/m68k/x68k/config.c                  |   1 +
 drivers/net/ethernet/8390/Kconfig        |  11 +
 drivers/net/ethernet/8390/Makefile       |   1 +
 drivers/net/ethernet/8390/x68k_neptune.c | 435 +++++++++++++++++++++++
 7 files changed, 452 insertions(+), 2 deletions(-)
 create mode 100644 drivers/net/ethernet/8390/x68k_neptune.c

diff --git a/arch/m68k/configs/x68k_defconfig b/arch/m68k/configs/x68k_defconfig
index 340fc3b0a0d4..f6e16cf0a007 100644
--- a/arch/m68k/configs/x68k_defconfig
+++ b/arch/m68k/configs/x68k_defconfig
@@ -36,6 +36,8 @@ CONFIG_BLK_DEV_SR=y
 CONFIG_SCSI=y
 CONFIG_SCSI_LOWLEVEL=y
 CONFIG_SCSI_X68K_SPC=y
+CONFIG_NETDEVICES=y
+CONFIG_X68K_NEPTUNE=y
 CONFIG_SERIAL_PMACZILOG=y
 CONFIG_SERIAL_PMACZILOG_TTYS=y
 CONFIG_SERIAL_PMACZILOG_CONSOLE=y
diff --git a/arch/m68k/include/asm/irq.h b/arch/m68k/include/asm/irq.h
index 732a93a657c3..85f65ec4a030 100644
--- a/arch/m68k/include/asm/irq.h
+++ b/arch/m68k/include/asm/irq.h
@@ -27,7 +27,7 @@
 #elif defined(CONFIG_NEXT)
 #define NR_IRQS	40
 #elif defined(CONFIG_X68K)
-#define NR_IRQS	56
+#define NR_IRQS	200
 #elif defined(CONFIG_AMIGA) || !defined(CONFIG_MMU)
 #define NR_IRQS	32
 #elif defined(CONFIG_APOLLO)
diff --git a/arch/m68k/include/asm/x68k.h b/arch/m68k/include/asm/x68k.h
index a5d5f4c35999..0bc4175d793e 100644
--- a/arch/m68k/include/asm/x68k.h
+++ b/arch/m68k/include/asm/x68k.h
@@ -55,7 +55,7 @@ static inline void __iomem *x68k_mfp(unsigned int reg)
 #define X68K_VEC_SCC		0x50
 #define X68K_VEC_IOC		0x60	/* 4 sources */
 #define X68K_VEC_DMAC		0x64	/* normal and error for each of 4 channels */
-#define X68K_VEC_END		0x70
+#define X68K_VEC_END		0x100	/* expansion cards bring their own */
 
 #define X68K_IRQ(vec)		((vec) - 0x40 + IRQ_USER)
 #define IRQ_X68K_MFP(n)		X68K_IRQ(X68K_VEC_MFP + (n))
diff --git a/arch/m68k/x68k/config.c b/arch/m68k/x68k/config.c
index fe62bb640a21..e581b74081a4 100644
--- a/arch/m68k/x68k/config.c
+++ b/arch/m68k/x68k/config.c
@@ -198,6 +198,7 @@ static int __init x68k_platform_init(void)
 	platform_device_register_simple("x68kjoy", -1, NULL, 0);
 	platform_device_register_simple("x68k_sram", -1, NULL, 0);
 	platform_device_register_simple("x68k-snd", -1, NULL, 0);
+	platform_device_register_simple("x68k_neptune", -1, NULL, 0);
 	platform_device_register_resndata(NULL, "rtc-rp5c01", -1, &x68k_rtc_rsrc, 1,
 					  &x68k_rtc_pdata, sizeof(x68k_rtc_pdata));
 	return 0;
diff --git a/drivers/net/ethernet/8390/Kconfig b/drivers/net/ethernet/8390/Kconfig
index 57d73a7747ec..c139dbd15293 100644
--- a/drivers/net/ethernet/8390/Kconfig
+++ b/drivers/net/ethernet/8390/Kconfig
@@ -154,6 +154,17 @@ config STNIC
 
 	  If unsure, say N.
 
+config X68K_NEPTUNE
+	tristate "Neptune-X support"
+	depends on X68K
+	select CRC32
+	help
+	  This driver is for the Neptune-X Ethernet card of the Sharp X68000
+	  series, an NE2000 compatible design.
+
+	  To compile this driver as a module, choose M here. The module
+	  will be called x68k_neptune.
+
 config ZORRO8390
 	tristate "Zorro NS8390-based Ethernet support"
 	depends on ZORRO
diff --git a/drivers/net/ethernet/8390/Makefile b/drivers/net/ethernet/8390/Makefile
index bca5babdadc7..185852977e2f 100644
--- a/drivers/net/ethernet/8390/Makefile
+++ b/drivers/net/ethernet/8390/Makefile
@@ -14,4 +14,5 @@ obj-$(CONFIG_NE2K_PCI) += ne2k-pci.o 8390.o
 obj-$(CONFIG_PCMCIA_PCNET) += pcnet_cs.o 8390.o
 obj-$(CONFIG_STNIC) += stnic.o 8390.o
 obj-$(CONFIG_XSURF100) += xsurf100.o
+obj-$(CONFIG_X68K_NEPTUNE) += x68k_neptune.o
 obj-$(CONFIG_ZORRO8390) += zorro8390.o
diff --git a/drivers/net/ethernet/8390/x68k_neptune.c b/drivers/net/ethernet/8390/x68k_neptune.c
new file mode 100644
index 000000000000..b4f04699f283
--- /dev/null
+++ b/drivers/net/ethernet/8390/x68k_neptune.c
@@ -0,0 +1,435 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Neptune-X Ethernet card of the Sharp X68000 series: an NS DP8390 in NE2000
+ * fashion on the even bytes of the expansion I/O space. Based on neptune.c,
+ * the same layout on the Amiga.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/errno.h>
+#include <linux/init.h>
+#include <linux/delay.h>
+#include <linux/netdevice.h>
+#include <linux/etherdevice.h>
+#include <linux/jiffies.h>
+#include <linux/irq.h>
+#include <linux/platform_device.h>
+
+#include <asm/hwtest.h>
+#include <asm/io.h>
+#include <asm/x68k.h>
+
+#define EI_SHIFT(x)		(ei_local->reg_offset[x])
+#define ei_inb(port)		in_8(port)
+#define ei_outb(val, port)	out_8(port, val)
+#define ei_inb_p(port)		in_8(port)
+#define ei_outb_p(val, port)	out_8(port, val)
+
+static const char version[] =
+	"8390.c:v1.10cvs 9/23/94 Donald Becker (becker@cesdis.gsfc.nasa.gov)\n";
+
+#include "lib8390.c"
+
+#define DRV_NAME	"x68k_neptune"
+
+#define NEPTUNE_PHYS	0x00ece200
+#define NEPTUNE_VECTOR	0xf9
+
+/* The data port gives bytes in memory order, words are not swapped */
+#define z_readb(a)	in_8((void __iomem *)(a))
+#define z_writeb(v, a)	out_8((void __iomem *)(a), v)
+#define z_readw(a)	in_be16((void __iomem *)(a))
+#define z_writew(v, a)	out_be16((void __iomem *)(a), v)
+
+#define NE_BASE		(dev->base_addr)
+#define NE_CMD		(0x00 * 2)
+#define NE_DATAPORT	(0x10 * 2)
+#define NE_RESET	(0x1f * 2)
+#define NE_IO_EXTENT	(0x20 * 2)
+
+#define NE_EN0_ISR	(0x07 * 2)
+#define NE_EN0_DCFG	(0x0e * 2)
+
+#define NE_EN0_RSARLO	(0x08 * 2)
+#define NE_EN0_RSARHI	(0x09 * 2)
+#define NE_EN0_RCNTLO	(0x0a * 2)
+#define NE_EN0_RXCR	(0x0c * 2)
+#define NE_EN0_TXCR	(0x0d * 2)
+#define NE_EN0_RCNTHI	(0x0b * 2)
+#define NE_EN0_IMR	(0x0f * 2)
+
+#define NESM_START_PG	0x40	/* First page of TX buffer */
+#define NESM_STOP_PG	0x80	/* Last page +1 of RX ring */
+
+#define WORDSWAP(a)	((((a) >> 8) & 0xff) | ((a) << 8))
+
+static void neptune_reset_8390(struct net_device *dev)
+{
+	unsigned long reset_start_time = jiffies;
+	struct ei_device *ei_local = netdev_priv(dev);
+
+	netif_dbg(ei_local, hw, dev, "resetting - t=%ld...\n", jiffies);
+
+	z_writeb(z_readb(NE_BASE + NE_RESET), NE_BASE + NE_RESET);
+
+	ei_status.txing = 0;
+	ei_status.dmaing = 0;
+
+	/* This check _should_not_ be necessary, omit eventually. */
+	while ((z_readb(NE_BASE + NE_EN0_ISR) & ENISR_RESET) == 0)
+		if (time_after(jiffies, reset_start_time + 2 * HZ / 100)) {
+			netdev_warn(dev, "%s: did not complete\n", __func__);
+			break;
+		}
+	z_writeb(ENISR_RESET, NE_BASE + NE_EN0_ISR);	/* Ack intr */
+}
+
+/* Grab the 8390 specific header. Similar to the block_input routine, but
+ * we don't need to be concerned with ring wrap as the header will be at
+ * the start of a page, so we optimize accordingly.
+ */
+static void neptune_get_8390_hdr(struct net_device *dev,
+				   struct e8390_pkt_hdr *hdr, int ring_page)
+{
+	int nic_base = dev->base_addr;
+	int cnt;
+	short *ptrs;
+
+	/* This *shouldn't* happen.
+	 * If it does, it's the last thing you'll see
+	 */
+	if (ei_status.dmaing) {
+		netdev_warn(dev,
+			    "%s: DMAing conflict [DMAstat:%d][irqlock:%d]\n",
+			    __func__, ei_status.dmaing, ei_status.irqlock);
+		return;
+	}
+
+	ei_status.dmaing |= 0x01;
+	z_writeb(E8390_NODMA + E8390_PAGE0 + E8390_START, nic_base + NE_CMD);
+	z_writeb(ENISR_RDC, nic_base + NE_EN0_ISR);
+	z_writeb(sizeof(struct e8390_pkt_hdr), nic_base + NE_EN0_RCNTLO);
+	z_writeb(0, nic_base + NE_EN0_RCNTHI);
+	z_writeb(0, nic_base + NE_EN0_RSARLO);		/* On page boundary */
+	z_writeb(ring_page, nic_base + NE_EN0_RSARHI);
+	z_writeb(E8390_RREAD+E8390_START, nic_base + NE_CMD);
+
+	ptrs = (short *)hdr;
+	for (cnt = 0; cnt < sizeof(struct e8390_pkt_hdr) >> 1; cnt++)
+		*ptrs++ = z_readw(NE_BASE + NE_DATAPORT);
+
+	z_writeb(ENISR_RDC, nic_base + NE_EN0_ISR);	/* Ack intr */
+
+	hdr->count = WORDSWAP(hdr->count);
+
+	ei_status.dmaing &= ~0x01;
+}
+
+/* Block input and output, similar to the Crynwr packet driver.
+ * If you are porting to a new ethercard, look at the packet driver source
+ * for hints. The NEx000 doesn't share the on-board packet memory --
+ * you have to put the packet out through the "remote DMA" dataport
+ * using z_writeb.
+ */
+static void neptune_block_input(struct net_device *dev, int count,
+				  struct sk_buff *skb, int ring_offset)
+{
+	int nic_base = dev->base_addr;
+	char *buf = skb->data;
+	short *ptrs;
+	int cnt;
+
+	/* This *shouldn't* happen.
+	 * If it does, it's the last thing you'll see
+	 */
+	if (ei_status.dmaing) {
+		netdev_err(dev, "%s: DMAing conflict [DMAstat:%d][irqlock:%d]\n",
+			   __func__, ei_status.dmaing, ei_status.irqlock);
+		return;
+	}
+	ei_status.dmaing |= 0x01;
+	z_writeb(E8390_NODMA + E8390_PAGE0 + E8390_START, nic_base + NE_CMD);
+	z_writeb(ENISR_RDC, nic_base + NE_EN0_ISR);
+	z_writeb(count & 0xff, nic_base + NE_EN0_RCNTLO);
+	z_writeb(count >> 8, nic_base + NE_EN0_RCNTHI);
+	z_writeb(ring_offset & 0xff, nic_base + NE_EN0_RSARLO);
+	z_writeb(ring_offset >> 8, nic_base + NE_EN0_RSARHI);
+	z_writeb(E8390_RREAD+E8390_START, nic_base + NE_CMD);
+	ptrs = (short *)buf;
+	for (cnt = 0; cnt < count >> 1; cnt++)
+		*ptrs++ = z_readw(NE_BASE + NE_DATAPORT);
+	if (count & 0x01)
+		buf[count - 1] = z_readb(NE_BASE + NE_DATAPORT);
+
+	z_writeb(ENISR_RDC, nic_base + NE_EN0_ISR);	/* Ack intr */
+	ei_status.dmaing &= ~0x01;
+}
+
+static void neptune_block_output(struct net_device *dev, int count,
+				   const unsigned char *buf,
+				   const int start_page)
+{
+	int nic_base = NE_BASE;
+	unsigned long dma_start;
+	short *ptrs;
+	int cnt;
+
+	/* Round the count up for word writes.  Do we need to do this?
+	 * What effect will an odd byte count have on the 8390?
+	 * I should check someday.
+	 */
+	if (count & 0x01)
+		count++;
+
+	/* This *shouldn't* happen.
+	 * If it does, it's the last thing you'll see
+	 */
+	if (ei_status.dmaing) {
+		netdev_err(dev, "%s: DMAing conflict [DMAstat:%d][irqlock:%d]\n",
+			   __func__, ei_status.dmaing, ei_status.irqlock);
+		return;
+	}
+	ei_status.dmaing |= 0x01;
+	/* We should already be in page 0, but to be safe... */
+	z_writeb(E8390_PAGE0+E8390_START+E8390_NODMA, nic_base + NE_CMD);
+
+	z_writeb(ENISR_RDC, nic_base + NE_EN0_ISR);
+
+	/* Now the normal output. */
+	z_writeb(count & 0xff, nic_base + NE_EN0_RCNTLO);
+	z_writeb(count >> 8,   nic_base + NE_EN0_RCNTHI);
+	z_writeb(0x00, nic_base + NE_EN0_RSARLO);
+	z_writeb(start_page, nic_base + NE_EN0_RSARHI);
+
+	z_writeb(E8390_RWRITE + E8390_START, nic_base + NE_CMD);
+	ptrs = (short *)buf;
+	for (cnt = 0; cnt < count >> 1; cnt++)
+		z_writew(*ptrs++, NE_BASE + NE_DATAPORT);
+
+	dma_start = jiffies;
+
+	while ((z_readb(NE_BASE + NE_EN0_ISR) & ENISR_RDC) == 0)
+		if (time_after(jiffies, dma_start + 2 * HZ / 100)) {
+					/* 20ms */
+			netdev_warn(dev, "timeout waiting for Tx RDC\n");
+			neptune_reset_8390(dev);
+			__NS8390_init(dev, 1);
+			break;
+		}
+
+	z_writeb(ENISR_RDC, nic_base + NE_EN0_ISR);	/* Ack intr */
+	ei_status.dmaing &= ~0x01;
+}
+
+/*
+ * The vectored interrupt has no mask in the machine, but lib8390 disables it while
+ * it sends. The pending transmit interrupt then would come back without end, so
+ * the card itself masks it. Its registers are on page 0 whenever interrupts can
+ * come, lib8390 only switches pages with them disabled.
+ */
+static void neptune_irq_mask(struct irq_data *d)
+{
+	out_8(irq_data_get_irq_chip_data(d) + NE_EN0_IMR, 0);
+}
+
+static void neptune_irq_unmask(struct irq_data *d)
+{
+	out_8(irq_data_get_irq_chip_data(d) + NE_EN0_IMR, ENISR_ALL);
+}
+
+static struct irq_chip neptune_irq_chip = {
+	.name		= "neptune",
+	.irq_startup	= m68k_irq_startup,
+	.irq_shutdown	= m68k_irq_shutdown,
+	.irq_mask	= neptune_irq_mask,
+	.irq_unmask	= neptune_irq_unmask,
+};
+
+static int neptune_open(struct net_device *dev)
+{
+	__ei_open(dev);
+	return 0;
+}
+
+static int neptune_close(struct net_device *dev)
+{
+	struct ei_device *ei_local = netdev_priv(dev);
+
+	netif_dbg(ei_local, ifdown, dev, "Shutting down ethercard\n");
+	__ei_close(dev);
+	return 0;
+}
+
+static const struct net_device_ops neptune_netdev_ops = {
+	.ndo_open		= neptune_open,
+	.ndo_stop		= neptune_close,
+	.ndo_start_xmit		= __ei_start_xmit,
+	.ndo_tx_timeout		= __ei_tx_timeout,
+	.ndo_get_stats		= __ei_get_stats,
+	.ndo_set_rx_mode	= __ei_set_multicast_list,
+	.ndo_validate_addr	= eth_validate_addr,
+	.ndo_set_mac_address	= eth_mac_addr,
+#ifdef CONFIG_NET_POLL_CONTROLLER
+	.ndo_poll_controller	= __ei_poll,
+#endif
+};
+
+static int neptune_init(struct net_device *dev, unsigned long board,
+			  const char *name, void __iomem *ioaddr)
+{
+	int i;
+	int err;
+	unsigned char SA_prom[32];
+	int start_page, stop_page;
+	static u32 neptune_offsets[16] = {
+		0x00, 0x02, 0x04, 0x06, 0x08, 0x0a, 0x0c, 0x0e,
+		0x10, 0x12, 0x14, 0x16, 0x18, 0x1a, 0x1c, 0x1e,
+	};
+
+	/* Reset card. Who knows what dain-bramaged state it was left in. */
+	{
+		unsigned long reset_start_time = jiffies;
+
+		z_writeb(z_readb(ioaddr + NE_RESET), ioaddr + NE_RESET);
+
+		while ((z_readb(ioaddr + NE_EN0_ISR) & ENISR_RESET) == 0)
+			if (time_after(jiffies,
+				       reset_start_time + 2 * HZ / 100)) {
+				netdev_warn(dev, "not found (no reset ack)\n");
+				return -ENODEV;
+			}
+
+		z_writeb(0xff, ioaddr + NE_EN0_ISR);	/* Ack all intr. */
+	}
+
+	/* Read the 16 bytes of station address PROM.
+	 * We must first initialize registers,
+	 * similar to NS8390_init(eifdev, 0).
+	 * We can't reliably read the SAPROM address without this.
+	 * (I learned the hard way!).
+	 */
+	{
+		static const struct {
+			u32 value;
+			u32 offset;
+		} program_seq[] = {
+			{E8390_NODMA + E8390_PAGE0 + E8390_STOP, NE_CMD},
+						/* Select page 0 */
+			{0x48,	NE_EN0_DCFG},	/* 0x48: Set byte-wide access */
+			{0x00,	NE_EN0_RCNTLO},	/* Clear the count regs */
+			{0x00,	NE_EN0_RCNTHI},
+			{0x00,	NE_EN0_IMR},	/* Mask completion irq */
+			{0xFF,	NE_EN0_ISR},
+			{E8390_RXOFF, NE_EN0_RXCR}, /* 0x20 Set to monitor */
+			{E8390_TXOFF, NE_EN0_TXCR}, /* 0x02 and loopback mode */
+			{32,	NE_EN0_RCNTLO},
+			{0x00,	NE_EN0_RCNTHI},
+			{0x00,	NE_EN0_RSARLO},	/* DMA starting at 0x0000 */
+			{0x00,	NE_EN0_RSARHI},
+			{E8390_RREAD + E8390_START, NE_CMD},
+		};
+		for (i = 0; i < ARRAY_SIZE(program_seq); i++)
+			z_writeb(program_seq[i].value,
+				 ioaddr + program_seq[i].offset);
+	}
+	for (i = 0; i < 16; i++) {
+		SA_prom[i] = z_readb(ioaddr + NE_DATAPORT);
+		(void)z_readb(ioaddr + NE_DATAPORT);
+	}
+
+	/* We must set the 8390 for word mode. */
+	z_writeb(0x49, ioaddr + NE_EN0_DCFG);
+	start_page = NESM_START_PG;
+	stop_page = NESM_STOP_PG;
+
+	dev->base_addr = (unsigned long)ioaddr;
+	dev->irq = X68K_IRQ(NEPTUNE_VECTOR);
+
+	irq_set_chip_and_handler(dev->irq, &neptune_irq_chip, handle_level_irq);
+	irq_set_chip_data(dev->irq, ioaddr);
+
+	/* Install the Interrupt handler */
+	i = request_irq(dev->irq, __ei_interrupt,
+			IRQF_SHARED, DRV_NAME, dev);
+	if (i)
+		return i;
+
+	eth_hw_addr_set(dev, SA_prom);
+
+	pr_debug("Found ethernet address: %pM\n", dev->dev_addr);
+
+	ei_status.name = name;
+	ei_status.tx_start_page = start_page;
+	ei_status.stop_page = stop_page;
+	ei_status.word16 = 1;
+
+	ei_status.rx_start_page = start_page + TX_PAGES;
+
+	ei_status.reset_8390 = neptune_reset_8390;
+	ei_status.block_input = neptune_block_input;
+	ei_status.block_output = neptune_block_output;
+	ei_status.get_8390_hdr = neptune_get_8390_hdr;
+	ei_status.reg_offset = neptune_offsets;
+
+	dev->netdev_ops = &neptune_netdev_ops;
+	__NS8390_init(dev, 0);
+
+	err = register_netdev(dev);
+	if (err) {
+		free_irq(dev->irq, dev);
+		return err;
+	}
+
+	netdev_info(dev, "%s at 0x%08lx, Ethernet Address %pM\n",
+		    name, board, dev->dev_addr);
+
+	return 0;
+}
+
+static int neptune_probe(struct platform_device *pdev)
+{
+	void __iomem *ioaddr = x68k_io(NEPTUNE_PHYS);
+	struct net_device *dev;
+	int err;
+
+	if (!hwreg_present(ioaddr + NE_CMD))
+		return -ENODEV;
+
+	dev = ____alloc_ei_netdev(0);
+	if (!dev)
+		return -ENOMEM;
+	SET_NETDEV_DEV(dev, &pdev->dev);
+	err = neptune_init(dev, NEPTUNE_PHYS, "Neptune-X", ioaddr);
+	if (err) {
+		free_netdev(dev);
+		return err;
+	}
+	platform_set_drvdata(pdev, dev);
+	return 0;
+}
+
+static void neptune_remove(struct platform_device *pdev)
+{
+	struct net_device *dev = platform_get_drvdata(pdev);
+
+	unregister_netdev(dev);
+	free_irq(dev->irq, dev);
+	free_netdev(dev);
+}
+
+static struct platform_driver neptune_driver = {
+	.probe	= neptune_probe,
+	.remove	= neptune_remove,
+	.driver	= {
+		.name = DRV_NAME,
+	},
+};
+module_platform_driver(neptune_driver);
+
+MODULE_DESCRIPTION("Neptune-X Ethernet driver for the Sharp X68000 series");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 12b374fc95bae40f42539bab950742f6ad5d52df Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 11:54:46 +0100
Subject: [PATCH 18/31] m68k: x68k: Use the memory of high memory boards
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Boards like the TS-6BE16 add up to 16 MB at 0x01000000, above the 24 bit address
space of the main board.  The loader finds it by writing and reading back a
value at each megabyte, a bus error ending the search without a board.  The DMA
controller only has 24 address lines, so ZONE_DMA ends at 16 MB and the floppy
takes its buffer from there.

Tested on MAME with 16 MB on such a board.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/include/asm/floppy.h |  5 +++--
 arch/m68k/mm/init.c            |  7 +++++++
 arch/m68k/x68k/boot/head.S     | 20 ++++++++++++++++++++
 arch/m68k/x68k/boot/main.c     | 27 +++++++++++++++++++++++++++
 4 files changed, 57 insertions(+), 2 deletions(-)

diff --git a/arch/m68k/include/asm/floppy.h b/arch/m68k/include/asm/floppy.h
index 2fe02a93ddca..494baa6a6be5 100644
--- a/arch/m68k/include/asm/floppy.h
+++ b/arch/m68k/include/asm/floppy.h
@@ -234,9 +234,10 @@ static int __maybe_unused vdma_get_dma_residue(unsigned int dummy)
 
 static unsigned long vdma_mem_alloc(unsigned long size)
 {
-	/* NeXT and X68030 use real DMA */
+	/* NeXT and X68030 use real DMA, which only reaches 16 MB there */
 	if (MACH_IS_NEXT || MACH_IS_X68K)
-		return __get_free_pages(GFP_KERNEL, get_order(size));
+		return __get_free_pages(MACH_IS_X68K ? GFP_KERNEL | GFP_DMA : GFP_KERNEL,
+					get_order(size));
 	return (unsigned long) vmalloc(size);
 
 }
diff --git a/arch/m68k/mm/init.c b/arch/m68k/mm/init.c
index 3b88c0dd1616..a482d6135d4a 100644
--- a/arch/m68k/mm/init.c
+++ b/arch/m68k/mm/init.c
@@ -36,6 +36,13 @@
 void __init arch_zone_limits_init(unsigned long *max_zone_pfns)
 {
 	max_zone_pfns[ZONE_DMA] = PFN_DOWN(memblock_end_of_DRAM());
+#ifdef CONFIG_X68K
+	/* The DMA controller has 24 address lines, high memory boards sit above */
+	if (MACH_IS_X68K) {
+		max_zone_pfns[ZONE_DMA] = min(max_zone_pfns[ZONE_DMA], PFN_DOWN(SZ_16M));
+		max_zone_pfns[ZONE_NORMAL] = PFN_DOWN(memblock_end_of_DRAM());
+	}
+#endif
 }
 
 #ifdef CONFIG_MMU
diff --git a/arch/m68k/x68k/boot/head.S b/arch/m68k/x68k/boot/head.S
index fe42f4321674..8f3177e043f6 100644
--- a/arch/m68k/x68k/boot/head.S
+++ b/arch/m68k/x68k/boot/head.S
@@ -117,6 +117,26 @@ fsave_size:
 	movel	%sp@+,%a2
 	rts
 
+	/* int probe_long(u32 *addr, u32 val): write and read back, 0 on a bus error */
+	.globl	probe_long
+probe_long:
+	movel	%sp@(4),%a1
+	movel	%sp@(8),%d1
+	movel	0x08,%a0
+	movel	%a2,%sp@-
+	lea	1f,%a2
+	movel	%a2,0x08
+	movel	%sp,%a2
+	moveq	#0,%d0
+	movel	%d1,%a1@
+	cmpl	%a1@,%d1
+	jne	1f
+	moveq	#1,%d0
+1:	movel	%a2,%sp
+	movel	%a0,0x08
+	movel	%sp@+,%a2
+	rts
+
 	/*
 	 * void enter_kernel(void *dst, void *src, u32 len, void *end, void *bi, u32 bilen)
 	 * Runs from high memory, as the kernel moves over the loader.
diff --git a/arch/m68k/x68k/boot/main.c b/arch/m68k/x68k/boot/main.c
index b0b6a9b5f546..9ae0787d2d66 100644
--- a/arch/m68k/x68k/boot/main.c
+++ b/arch/m68k/x68k/boot/main.c
@@ -22,12 +22,16 @@ typedef unsigned int u32;
 #define MFP_IER_A	0x00e88007
 #define MFP_IER_B	0x00e88009
 #define BI_SIZE		1024
+#define HIGH_RAM_BASE	0x01000000
+#define HIGH_RAM_MAX	0x01000000	/* boards with up to 16 MB */
+#define HIGH_RAM_STEP	0x00100000
 
 extern u32 boot_params[4];
 extern const char move_stub[], move_stub_end[];
 extern void iocs_print(const char *s);
 extern int iocs_s_read(u32 block, u32 count, u32 id, u32 size, void *buf);
 extern u32 fsave_size(void *buf);
+extern int probe_long(volatile u32 *addr, u32 val);
 
 static u8 bi_buf[BI_SIZE] __attribute__((aligned(4)));
 static u32 bi_len;
@@ -48,6 +52,24 @@ static u32 fpu_type(void)
 	return 0;
 }
 
+/*
+ * RAM of a high memory board, found by writing a different value at each step
+ * and reading all back, so that address wrapping shows. Without a board the
+ * access ends with a bus error.
+ */
+static u32 high_ram_size(void)
+{
+	u32 size, n;
+
+	for (size = 0; size < HIGH_RAM_MAX; size += HIGH_RAM_STEP)
+		if (!probe_long((volatile u32 *)(HIGH_RAM_BASE + size), 0x5a000000 | size))
+			break;
+	for (n = 0; n < size; n += HIGH_RAM_STEP)
+		if (*(volatile u32 *)(HIGH_RAM_BASE + n) != (0x5a000000 | n))
+			return n;
+	return size;
+}
+
 static u32 str_len(const char *s)
 {
 	u32 n = 0;
@@ -112,6 +134,11 @@ void x68k_boot(u32 scsi_id, u32 size)
 	mem.addr = 0;
 	mem.size = ram;
 	bi_add(BI_MEMCHUNK, &mem, sizeof(mem));
+	mem.size = high_ram_size();
+	if (mem.size) {
+		mem.addr = HIGH_RAM_BASE;
+		bi_add(BI_MEMCHUNK, &mem, sizeof(mem));
+	}
 	bi_add(BI_COMMAND_LINE, X68KBOOT_CMDLINE, str_len(X68KBOOT_CMDLINE) + 1);
 	bi_add_u32(BI_LAST, 0);
 
-- 
2.54.0


From 29a613c4e4a985f4d6e1b12d85ca6477dfbef21f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 12:00:06 +0100
Subject: [PATCH 19/31] parport: Add Sharp X68000 series printer port driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The port only has the data latch and a strobe, the ready line is read and
interrupts through the I/O controller.  The lp driver works on top of it.

Tested on MAME, with a Centronics port added there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/x68k_defconfig |   3 +
 arch/m68k/x68k/config.c          |   1 +
 drivers/parport/Kconfig          |   7 ++
 drivers/parport/Makefile         |   1 +
 drivers/parport/parport_x68k.c   | 186 +++++++++++++++++++++++++++++++
 5 files changed, 198 insertions(+)
 create mode 100644 drivers/parport/parport_x68k.c

diff --git a/arch/m68k/configs/x68k_defconfig b/arch/m68k/configs/x68k_defconfig
index f6e16cf0a007..d6742955bf00 100644
--- a/arch/m68k/configs/x68k_defconfig
+++ b/arch/m68k/configs/x68k_defconfig
@@ -28,6 +28,8 @@ CONFIG_INET=y
 # CONFIG_IPV6 is not set
 CONFIG_DEVTMPFS=y
 CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_PARPORT=y
+CONFIG_PARPORT_X68K=y
 CONFIG_BLK_DEV=y
 CONFIG_BLK_DEV_FD=y
 CONFIG_BLK_DEV_LOOP=y
@@ -39,6 +41,7 @@ CONFIG_SCSI_X68K_SPC=y
 CONFIG_NETDEVICES=y
 CONFIG_X68K_NEPTUNE=y
 CONFIG_SERIAL_PMACZILOG=y
+CONFIG_PRINTER=y
 CONFIG_SERIAL_PMACZILOG_TTYS=y
 CONFIG_SERIAL_PMACZILOG_CONSOLE=y
 CONFIG_INPUT_EVDEV=y
diff --git a/arch/m68k/x68k/config.c b/arch/m68k/x68k/config.c
index e581b74081a4..cc027ae43576 100644
--- a/arch/m68k/x68k/config.c
+++ b/arch/m68k/x68k/config.c
@@ -199,6 +199,7 @@ static int __init x68k_platform_init(void)
 	platform_device_register_simple("x68k_sram", -1, NULL, 0);
 	platform_device_register_simple("x68k-snd", -1, NULL, 0);
 	platform_device_register_simple("x68k_neptune", -1, NULL, 0);
+	platform_device_register_simple("x68k-parallel", -1, NULL, 0);
 	platform_device_register_resndata(NULL, "rtc-rp5c01", -1, &x68k_rtc_rsrc, 1,
 					  &x68k_rtc_pdata, sizeof(x68k_rtc_pdata));
 	return 0;
diff --git a/drivers/parport/Kconfig b/drivers/parport/Kconfig
index 631c193fe42c..0f148a076c41 100644
--- a/drivers/parport/Kconfig
+++ b/drivers/parport/Kconfig
@@ -109,6 +109,13 @@ config PARPORT_AMIGA
 	  Amiga machines. This code is also available as a module (say M),
 	  called parport_amiga. If in doubt, saying N is the safe plan.
 
+config PARPORT_X68K
+	tristate "Sharp X68000 series printer port"
+	depends on X68K
+	select PARPORT_NOT_PC
+	help
+	  Say Y here to print through the printer port of a Sharp X68030.
+
 config PARPORT_MFC3
 	tristate "Multiface III parallel port"
 	depends on ZORRO
diff --git a/drivers/parport/Makefile b/drivers/parport/Makefile
index d4a6b890852d..f82d3353c8c9 100644
--- a/drivers/parport/Makefile
+++ b/drivers/parport/Makefile
@@ -14,6 +14,7 @@ obj-$(CONFIG_PARPORT_PC)	+= parport_pc.o
 obj-$(CONFIG_PARPORT_SERIAL)	+= parport_serial.o
 obj-$(CONFIG_PARPORT_PC_PCMCIA) += parport_cs.o
 obj-$(CONFIG_PARPORT_AMIGA)	+= parport_amiga.o
+obj-$(CONFIG_PARPORT_X68K)	+= parport_x68k.o
 obj-$(CONFIG_PARPORT_MFC3)	+= parport_mfc3.o
 obj-$(CONFIG_PARPORT_ATARI)	+= parport_atari.o
 obj-$(CONFIG_PARPORT_SUNBPP)	+= parport_sunbpp.o
diff --git a/drivers/parport/parport_x68k.c b/drivers/parport/parport_x68k.c
new file mode 100644
index 000000000000..a459955c7fb5
--- /dev/null
+++ b/drivers/parport/parport_x68k.c
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Printer port of the Sharp X68000 series: an output only port with a strobe, and a
+ * ready line in the I/O controller which also interrupts when it rises.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/parport.h>
+#include <linux/platform_device.h>
+
+#include <asm/x68k.h>
+
+#define PRT_DATA	0x00e8c001
+#define PRT_STROBE	0x00e8c003	/* bit 0, low active */
+#define IOC_STATUS	(X68K_IOC + 1)
+#define IOC_PRT_READY	0x20
+#define IOC_PRT_IEN	0x01
+#define PRT_VECTOR	(X68K_VEC_IOC + 3)
+
+/* The data latch cannot be read back */
+static unsigned char x68k_pp_data;
+
+static void x68k_pp_write_data(struct parport *p, unsigned char data)
+{
+	x68k_pp_data = data;
+	out_8(x68k_io(PRT_DATA), data);
+}
+
+static unsigned char x68k_pp_read_data(struct parport *p)
+{
+	return x68k_pp_data;
+}
+
+static void x68k_pp_write_control(struct parport *p, unsigned char control)
+{
+	out_8(x68k_io(PRT_STROBE), control & PARPORT_CONTROL_STROBE ? 0 : 1);
+}
+
+static unsigned char x68k_pp_read_control(struct parport *p)
+{
+	return PARPORT_CONTROL_SELECT | PARPORT_CONTROL_INIT;
+}
+
+static unsigned char x68k_pp_frob_control(struct parport *p, unsigned char mask,
+					  unsigned char val)
+{
+	if (mask & PARPORT_CONTROL_STROBE)
+		out_8(x68k_io(PRT_STROBE), val & PARPORT_CONTROL_STROBE ? 0 : 1);
+	return x68k_pp_read_control(p);
+}
+
+/* The busy bit of parport is the inverted line, set when the printer is ready */
+static unsigned char x68k_pp_read_status(struct parport *p)
+{
+	unsigned char status = PARPORT_STATUS_SELECT | PARPORT_STATUS_ERROR | PARPORT_STATUS_ACK;
+
+	if (in_8(x68k_io(IOC_STATUS)) & IOC_PRT_READY)
+		status |= PARPORT_STATUS_BUSY;
+	return status;
+}
+
+static void x68k_pp_irq(struct parport *p, bool on)
+{
+	u8 ien = in_8(x68k_io(IOC_STATUS)) & 0x0f;
+
+	out_8(x68k_io(IOC_STATUS), on ? ien | IOC_PRT_IEN : ien & ~IOC_PRT_IEN);
+}
+
+static void x68k_pp_enable_irq(struct parport *p)
+{
+	x68k_pp_irq(p, true);
+}
+
+static void x68k_pp_disable_irq(struct parport *p)
+{
+	x68k_pp_irq(p, false);
+}
+
+static void x68k_pp_data_forward(struct parport *p)
+{
+}
+
+static void x68k_pp_data_reverse(struct parport *p)
+{
+}
+
+static void x68k_pp_init_state(struct pardevice *dev, struct parport_state *s)
+{
+	s->u.amiga.data = 0;
+}
+
+static void x68k_pp_save_state(struct parport *p, struct parport_state *s)
+{
+	s->u.amiga.data = x68k_pp_read_data(p);
+}
+
+static void x68k_pp_restore_state(struct parport *p, struct parport_state *s)
+{
+	x68k_pp_write_data(p, s->u.amiga.data);
+}
+
+static struct parport_operations x68k_pp_ops = {
+	.write_data	= x68k_pp_write_data,
+	.read_data	= x68k_pp_read_data,
+
+	.write_control	= x68k_pp_write_control,
+	.read_control	= x68k_pp_read_control,
+	.frob_control	= x68k_pp_frob_control,
+
+	.read_status	= x68k_pp_read_status,
+
+	.enable_irq	= x68k_pp_enable_irq,
+	.disable_irq	= x68k_pp_disable_irq,
+
+	.data_forward	= x68k_pp_data_forward,
+	.data_reverse	= x68k_pp_data_reverse,
+
+	.init_state	= x68k_pp_init_state,
+	.save_state	= x68k_pp_save_state,
+	.restore_state	= x68k_pp_restore_state,
+
+	.epp_write_data	= parport_ieee1284_epp_write_data,
+	.epp_read_data	= parport_ieee1284_epp_read_data,
+	.epp_write_addr	= parport_ieee1284_epp_write_addr,
+	.epp_read_addr	= parport_ieee1284_epp_read_addr,
+
+	.ecp_write_data	= parport_ieee1284_ecp_write_data,
+	.ecp_read_data	= parport_ieee1284_ecp_read_data,
+	.ecp_write_addr	= parport_ieee1284_ecp_write_addr,
+
+	.compat_write_data	= parport_ieee1284_write_compat,
+	.nibble_read_data	= parport_ieee1284_read_nibble,
+	.byte_read_data		= parport_ieee1284_read_byte,
+
+	.owner		= THIS_MODULE,
+};
+
+static int x68k_pp_probe(struct platform_device *pdev)
+{
+	int irq = X68K_IRQ(PRT_VECTOR);
+	struct parport *p;
+	int err;
+
+	out_8(x68k_io(PRT_STROBE), 1);
+	p = parport_register_port(PRT_DATA, irq, PARPORT_DMA_NONE, &x68k_pp_ops);
+	if (!p)
+		return -EBUSY;
+
+	p->dev = &pdev->dev;
+	err = request_irq(irq, parport_irq_handler, 0, p->name, p);
+	if (err) {
+		parport_put_port(p);
+		return err;
+	}
+	pr_info("%s: X68000 printer port\n", p->name);
+	parport_announce_port(p);
+	platform_set_drvdata(pdev, p);
+	return 0;
+}
+
+static void x68k_pp_remove(struct platform_device *pdev)
+{
+	struct parport *p = platform_get_drvdata(pdev);
+
+	parport_remove_port(p);
+	x68k_pp_irq(p, false);
+	free_irq(p->irq, p);
+	parport_put_port(p);
+}
+
+static struct platform_driver x68k_pp_driver = {
+	.probe	= x68k_pp_probe,
+	.remove	= x68k_pp_remove,
+	.driver	= {
+		.name = "x68k-parallel",
+	},
+};
+module_platform_driver(x68k_pp_driver);
+
+MODULE_DESCRIPTION("Sharp X68000 printer port driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 7cc387965565fd9ea06ec1dd8811ea7934add882 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 12:00:06 +0100
Subject: [PATCH 20/31] m68k: x68k: Drive the keyboard LEDs and the display
 contrast
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Kana, code input and caps lock LEDs are set with the low active LED command of
the keyboard, as XM6 handles it and the MAME layout shows it.  The contrast of
the system port becomes a backlight device of the text screen.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/input/keyboard/x68kkbd.c | 35 ++++++++++++++++++++++++++++++++
 drivers/video/fbdev/Kconfig      |  1 +
 drivers/video/fbdev/x68kfb.c     | 25 +++++++++++++++++++++++
 3 files changed, 61 insertions(+)

diff --git a/drivers/input/keyboard/x68kkbd.c b/drivers/input/keyboard/x68kkbd.c
index ad027aa9214e..fa054eb39dce 100644
--- a/drivers/input/keyboard/x68kkbd.c
+++ b/drivers/input/keyboard/x68kkbd.c
@@ -8,6 +8,7 @@
 #include <linux/init.h>
 #include <linux/input.h>
 #include <linux/interrupt.h>
+#include <linux/delay.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
 
@@ -38,6 +39,14 @@
 
 #define KEY_RELEASE		0x80
 
+/* LED command: the bits are low active */
+#define KBD_CMD_LED		0x80
+#define KBD_LED_KANA		0x01
+#define KBD_LED_CODE		0x04
+#define KBD_LED_CAPS		0x08
+#define KBD_LED_ALL		0x7f
+#define TSR_EMPTY		0x80
+
 static const unsigned short x68kkbd_keycodes[128] = {
 	[0x01] = KEY_ESC,
 	[0x02] = KEY_1,
@@ -167,6 +176,27 @@ static irqreturn_t x68kkbd_interrupt(int irq, void *dev_id)
 	return IRQ_HANDLED;
 }
 
+static int x68kkbd_event(struct input_dev *dev, unsigned int type, unsigned int code, int value)
+{
+	unsigned int i;
+	u8 leds = 0;
+
+	if (type != EV_LED)
+		return -1;
+
+	if (test_bit(LED_KANA, dev->led))
+		leds |= KBD_LED_KANA;
+	if (test_bit(LED_COMPOSE, dev->led))
+		leds |= KBD_LED_CODE;
+	if (test_bit(LED_CAPSL, dev->led))
+		leds |= KBD_LED_CAPS;
+
+	for (i = 0; i < 1000 && !(in_8(x68k_mfp(MFP_TSR)) & TSR_EMPTY); i++)
+		udelay(10);
+	out_8(x68k_mfp(MFP_UDR), KBD_CMD_LED | (~leds & KBD_LED_ALL));
+	return 0;
+}
+
 static int x68kkbd_probe(struct platform_device *pdev)
 {
 	struct x68kkbd *kbd;
@@ -190,6 +220,11 @@ static int x68kkbd_probe(struct platform_device *pdev)
 	input->keycodemax = ARRAY_SIZE(kbd->keycodes);
 	__set_bit(EV_KEY, input->evbit);
 	__set_bit(EV_REP, input->evbit);
+	__set_bit(EV_LED, input->evbit);
+	__set_bit(LED_KANA, input->ledbit);
+	__set_bit(LED_COMPOSE, input->ledbit);
+	__set_bit(LED_CAPSL, input->ledbit);
+	input->event = x68kkbd_event;
 	for (i = 0; i < ARRAY_SIZE(kbd->keycodes); i++)
 		__set_bit(kbd->keycodes[i], input->keybit);
 	__clear_bit(KEY_RESERVED, input->keybit);
diff --git a/drivers/video/fbdev/Kconfig b/drivers/video/fbdev/Kconfig
index c03618fac07d..d287d6835506 100644
--- a/drivers/video/fbdev/Kconfig
+++ b/drivers/video/fbdev/Kconfig
@@ -202,6 +202,7 @@ config FB_X68K
 	bool "Sharp X68030 text screen support"
 	depends on (FB = y) && X68K
 	select FB_IOMEM_HELPERS
+	select BACKLIGHT_CLASS_DEVICE
 	help
 	  Support for the text screen of the Sharp X68030 as a monochrome
 	  framebuffer.
diff --git a/drivers/video/fbdev/x68kfb.c b/drivers/video/fbdev/x68kfb.c
index e0b6a2833116..cd4c0d4b64d8 100644
--- a/drivers/video/fbdev/x68kfb.c
+++ b/drivers/video/fbdev/x68kfb.c
@@ -6,6 +6,7 @@
  * Copyright (C) 2026 René Rebe <rene@exactco.de>
  */
 
+#include <linux/backlight.h>
 #include <linux/fb.h>
 #include <linux/io.h>
 #include <linux/kernel.h>
@@ -29,6 +30,20 @@
 #define X68KFB_WIDTH	768
 #define X68KFB_HEIGHT	512
 
+/* The system port sets the contrast of the display, 16 levels */
+#define SYSPORT_CONTRAST	0x00e8e001
+#define CONTRAST_MAX		15
+
+static int x68kfb_bl_update(struct backlight_device *bl)
+{
+	out_8(x68k_io(SYSPORT_CONTRAST), backlight_get_brightness(bl));
+	return 0;
+}
+
+static const struct backlight_ops x68kfb_bl_ops = {
+	.update_status	= x68kfb_bl_update,
+};
+
 static const struct fb_ops x68kfb_ops = {
 	.owner		= THIS_MODULE,
 	FB_DEFAULT_IOMEM_OPS,
@@ -79,6 +94,16 @@ static int x68kfb_probe(struct platform_device *pdev)
 		return err;
 	}
 	platform_set_drvdata(pdev, info);
+	{
+		struct backlight_properties props = {
+			.type		= BACKLIGHT_RAW,
+			.max_brightness	= CONTRAST_MAX,
+			.brightness	= in_8(x68k_io(SYSPORT_CONTRAST)) & CONTRAST_MAX,
+		};
+
+		devm_backlight_device_register(&pdev->dev, "x68k-contrast", &pdev->dev, NULL,
+					       &x68kfb_bl_ops, &props);
+	}
 	fb_info(info, "X68030 text screen, %ux%u\n", X68KFB_WIDTH, X68KFB_HEIGHT);
 	return 0;
 }
-- 
2.54.0


From 51dacd6a42d3da6012154c0923d760606a60c00d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 12:11:45 +0100
Subject: [PATCH 21/31] scsi: x68k_spc: Support the CZ-6BS1 expansion card
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The CZ-6BS1 card carries the same MB89352 as the X68030 internal SCSI,
at 0xea0000. Take the register base from a memory resource, register
both instances and probe each by writing the host ID to BDID and reading
back its bit, as an empty slot does not have to raise a bus error.

Tested in MAME with and without the card: a file system on a disk of
the card, and the internal controller next to it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/x68k/config.c |  9 ++++++++-
 drivers/scsi/x68k_spc.c | 22 +++++++++++++++++-----
 2 files changed, 25 insertions(+), 6 deletions(-)

diff --git a/arch/m68k/x68k/config.c b/arch/m68k/x68k/config.c
index cc027ae43576..7940e9646c45 100644
--- a/arch/m68k/x68k/config.c
+++ b/arch/m68k/x68k/config.c
@@ -60,6 +60,12 @@ static struct rp5c01_platform_data x68k_rtc_pdata = {
 
 static struct resource x68k_rtc_rsrc = DEFINE_RES_MEM(RTC_PHYS, RTC_SIZE);
 
+/* Internal SCSI and the CZ-6BS1 expansion card */
+static struct resource x68k_spc_rsrc[] = {
+	DEFINE_RES_MEM(0x00e96020, 0x20),
+	DEFINE_RES_MEM(0x00ea0000, 0x20),
+};
+
 #define SCC_A_CTRL	(X68K_SCC + X68K_SCC_A_CTRL)
 #define WR9_HW_RESET	0xc0
 #define SPC_SCTL	0x00e96023
@@ -193,7 +199,8 @@ static int __init x68k_platform_init(void)
 	platform_device_register_simple("x68kfb", -1, NULL, 0);
 	platform_device_register_simple("x68kgfb", -1, NULL, 0);
 	platform_device_register_simple("x68kkbd", -1, NULL, 0);
-	platform_device_register_simple("x68k_spc", -1, NULL, 0);
+	platform_device_register_simple("x68k_spc", 0, &x68k_spc_rsrc[0], 1);
+	platform_device_register_simple("x68k_spc", 1, &x68k_spc_rsrc[1], 1);
 	platform_device_register_simple("x68kmouse", -1, NULL, 0);
 	platform_device_register_simple("x68kjoy", -1, NULL, 0);
 	platform_device_register_simple("x68k_sram", -1, NULL, 0);
diff --git a/drivers/scsi/x68k_spc.c b/drivers/scsi/x68k_spc.c
index 32896c814369..98da9a574049 100644
--- a/drivers/scsi/x68k_spc.c
+++ b/drivers/scsi/x68k_spc.c
@@ -1,7 +1,8 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * Sharp X68030 internal SCSI, a Fujitsu MB89352 protocol controller. Commands run one
- * at a time from a worker with programmed I/O, targets may not disconnect.
+ * Sharp X68030 internal SCSI and the CZ-6BS1 card, a Fujitsu MB89352 protocol controller
+ * each. Commands run one at a time from a worker with programmed I/O, targets may not
+ * disconnect.
  *
  * Copyright (C) 2026 René Rebe <rene@exactco.de>
  */
@@ -22,11 +23,10 @@
 #include <scsi/scsi_host.h>
 #include <scsi/scsi_tcq.h>
 
+#include <asm/hwtest.h>
 #include <asm/io.h>
 #include <asm/x68k.h>
 
-#define SPC_BASE	0x00e96020
-
 #define SPC_BDID	0
 #define SPC_SCTL	1
 #define SPC_SCMD	2
@@ -337,17 +337,29 @@ static const struct scsi_host_template spc_template = {
 
 static int spc_probe(struct platform_device *pdev)
 {
+	struct resource *res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	void __iomem *bdid;
 	struct Scsi_Host *host;
 	struct x68k_spc *spc;
 	int err;
 
+	if (!res)
+		return -ENODEV;
+	/* An empty slot may not raise a bus error, the ID register reads back as a bit */
+	bdid = x68k_io(res->start) + 2 * SPC_BDID + 1;
+	if (!hwreg_present(bdid))
+		return -ENODEV;
+	out_8(bdid, HOST_ID);
+	if (in_8(bdid) != BIT(HOST_ID))
+		return -ENODEV;
+
 	host = scsi_host_alloc(&spc_template, sizeof(*spc));
 	if (!host)
 		return -ENOMEM;
 
 	spc = shost_priv(host);
 	spc->host = host;
-	spc->regs = x68k_io(SPC_BASE);
+	spc->regs = x68k_io(res->start);
 	INIT_WORK(&spc->work, spc_work);
 	host->max_id = 8;
 	host->max_lun = 1;
-- 
2.54.0


From c40b84693042095e871238d30abd952f5bfc26cc Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 12:11:45 +0100
Subject: [PATCH 22/31] m68k: floppy: Eject X68030 floppy disks
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The X68030 floppy drives eject under control of the floppy option port:
set the eject bit with the drive selected, then clear the drive bit.
Hook it up as fd_eject() for the FDEJECT ioctl.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/include/asm/floppy.h   |  4 ++++
 arch/m68k/include/asm/x68kflop.h | 12 ++++++++++++
 2 files changed, 16 insertions(+)

diff --git a/arch/m68k/include/asm/floppy.h b/arch/m68k/include/asm/floppy.h
index 494baa6a6be5..7650a2cc626d 100644
--- a/arch/m68k/include/asm/floppy.h
+++ b/arch/m68k/include/asm/floppy.h
@@ -161,6 +161,10 @@ static void fd_free_irq(void)
 #define fd_dma_claim()		do { if (MACH_IS_NEXT) next_fd_dma_claim(); } while (0)
 #endif
 
+#ifdef CONFIG_X68K
+#define fd_eject(drive)		(MACH_IS_X68K ? x68k_fd_eject(drive) : -EINVAL)
+#endif
+
 #define fd_request_dma()        vdma_request_dma(FLOPPY_DMA,"floppy")
 #define fd_get_dma_residue()    vdma_get_dma_residue(FLOPPY_DMA)
 #define fd_dma_mem_alloc(size)	vdma_mem_alloc(size)
diff --git a/arch/m68k/include/asm/x68kflop.h b/arch/m68k/include/asm/x68kflop.h
index 2dea5586bd2f..610356edd432 100644
--- a/arch/m68k/include/asm/x68kflop.h
+++ b/arch/m68k/include/asm/x68kflop.h
@@ -148,6 +148,18 @@ static inline void x68k_fd_dma_stop(void)
 		cache_clear(virt_to_phys(x68k_fd.addr), x68k_fd.size);
 }
 
+#define FDD_OPTION_EJECT	0x20
+
+/* The eject line acts when the drive bit goes back to 0 */
+static inline int x68k_fd_eject(int drive)
+{
+	out_8(x68k_io(X68K_FDD_OPTION), FDD_OPTION_EJECT | BIT(drive & 3));
+	udelay(1);
+	out_8(x68k_io(X68K_FDD_OPTION), FDD_OPTION_EJECT);
+	out_8(x68k_io(X68K_FDD_OPTION), 0);
+	return 0;
+}
+
 static inline void x68k_fd_irq_enable(bool on)
 {
 	u8 ien = in_8(x68k_io(X68K_IOC + 1)) & 0x0f;
-- 
2.54.0


From a166314f38fa22298823c1adcb5d313aeb51ac7e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 12:21:32 +0100
Subject: [PATCH 23/31] ALSA: Add Sharp CZ-6BM1 MIDI card driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The CZ-6BM1 MIDI card of the X68000 series carries a Yamaha YM3802 at
0xeafa00 for board ID 1 or 0xeafa10 for board ID 2. Register both and
probe for the chip by a bus error and the register group read back.

Expose the card as an ALSA raw MIDI port at 31250 baud. The receive
FIFO is drained on its ready interrupt, the transmit FIFO is refilled
on its empty interrupt while data is pending. The interrupt vectors
are the IOR base, 0x80 for board 1 and 0xa0 for board 2, plus twice
the number of the source.

Tested in MAME, with its YM3802 receive path added: a SysEx file
played into MIDI in arrives unchanged, 3125 bytes sent take about the
line time. Board 2 and real hardware are untested.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/x68k_defconfig |   1 +
 arch/m68k/include/asm/x68k.h     |   1 +
 arch/m68k/x68k/config.c          |   8 +
 sound/m68k/Kconfig               |  10 +
 sound/m68k/Makefile              |   3 +-
 sound/m68k/x68k_midi.c           | 332 +++++++++++++++++++++++++++++++
 6 files changed, 354 insertions(+), 1 deletion(-)
 create mode 100644 sound/m68k/x68k_midi.c

diff --git a/arch/m68k/configs/x68k_defconfig b/arch/m68k/configs/x68k_defconfig
index d6742955bf00..2cf13dcdf0b5 100644
--- a/arch/m68k/configs/x68k_defconfig
+++ b/arch/m68k/configs/x68k_defconfig
@@ -71,3 +71,4 @@ CONFIG_CRYPTO_LZO=y
 CONFIG_SOUND=y
 CONFIG_SND=y
 CONFIG_SND_X68K=y
+CONFIG_SND_X68K_MIDI=y
diff --git a/arch/m68k/include/asm/x68k.h b/arch/m68k/include/asm/x68k.h
index 0bc4175d793e..14e7f47fe553 100644
--- a/arch/m68k/include/asm/x68k.h
+++ b/arch/m68k/include/asm/x68k.h
@@ -55,6 +55,7 @@ static inline void __iomem *x68k_mfp(unsigned int reg)
 #define X68K_VEC_SCC		0x50
 #define X68K_VEC_IOC		0x60	/* 4 sources */
 #define X68K_VEC_DMAC		0x64	/* normal and error for each of 4 channels */
+#define X68K_VEC_MIDI		0x80	/* CZ-6BM1, 0x20 per board */
 #define X68K_VEC_END		0x100	/* expansion cards bring their own */
 
 #define X68K_IRQ(vec)		((vec) - 0x40 + IRQ_USER)
diff --git a/arch/m68k/x68k/config.c b/arch/m68k/x68k/config.c
index 7940e9646c45..f4f391e79dc1 100644
--- a/arch/m68k/x68k/config.c
+++ b/arch/m68k/x68k/config.c
@@ -66,6 +66,12 @@ static struct resource x68k_spc_rsrc[] = {
 	DEFINE_RES_MEM(0x00ea0000, 0x20),
 };
 
+/* CZ-6BM1 MIDI cards with board ID 1 and 2 */
+static struct resource x68k_midi_rsrc[] = {
+	DEFINE_RES_MEM(0x00eafa00, 0x10),
+	DEFINE_RES_MEM(0x00eafa10, 0x10),
+};
+
 #define SCC_A_CTRL	(X68K_SCC + X68K_SCC_A_CTRL)
 #define WR9_HW_RESET	0xc0
 #define SPC_SCTL	0x00e96023
@@ -205,6 +211,8 @@ static int __init x68k_platform_init(void)
 	platform_device_register_simple("x68kjoy", -1, NULL, 0);
 	platform_device_register_simple("x68k_sram", -1, NULL, 0);
 	platform_device_register_simple("x68k-snd", -1, NULL, 0);
+	platform_device_register_simple("x68k-midi", 0, &x68k_midi_rsrc[0], 1);
+	platform_device_register_simple("x68k-midi", 1, &x68k_midi_rsrc[1], 1);
 	platform_device_register_simple("x68k_neptune", -1, NULL, 0);
 	platform_device_register_simple("x68k-parallel", -1, NULL, 0);
 	platform_device_register_resndata(NULL, "rtc-rp5c01", -1, &x68k_rtc_rsrc, 1,
diff --git a/sound/m68k/Kconfig b/sound/m68k/Kconfig
index 8c9eab0e2d64..f10333c98ee1 100644
--- a/sound/m68k/Kconfig
+++ b/sound/m68k/Kconfig
@@ -34,4 +34,14 @@ config SND_X68K
 	  To compile this driver as a module, choose M here: the module
 	  will be called snd-x68k.
 
+config SND_X68K_MIDI
+	tristate "Sharp CZ-6BM1 MIDI card"
+	depends on X68K
+	select SND_RAWMIDI
+	help
+	  Say Y here for the YM3802 based MIDI expansion card of the Sharp
+	  X68000 series.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called snd-x68k-midi.
 endif # SND_M68K
diff --git a/sound/m68k/Makefile b/sound/m68k/Makefile
index bd1db8dbb748..fa4e47a1af51 100644
--- a/sound/m68k/Makefile
+++ b/sound/m68k/Makefile
@@ -2,6 +2,7 @@
 snd-next-y := next_snd.o
 
 snd-x68k-y := x68k_snd.o
-
+snd-x68k-midi-y := x68k_midi.o
 obj-$(CONFIG_SND_NEXT) += snd-next.o
 obj-$(CONFIG_SND_X68K) += snd-x68k.o
+obj-$(CONFIG_SND_X68K_MIDI) += snd-x68k-midi.o
diff --git a/sound/m68k/x68k_midi.c b/sound/m68k/x68k_midi.c
new file mode 100644
index 000000000000..8f42428da534
--- /dev/null
+++ b/sound/m68k/x68k_midi.c
@@ -0,0 +1,332 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sharp CZ-6BM1 MIDI card for the X68000 series, a Yamaha YM3802 MIDI communication
+ * and service controller, as an ALSA raw MIDI port.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/log2.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include <sound/core.h>
+#include <sound/initval.h>
+#include <sound/rawmidi.h>
+
+#include <asm/hwtest.h>
+#include <asm/x68k.h>
+
+/* Registers 4 to 7 are banked, register number = 10 * group + offset */
+#define MCS_IVR		0
+#define MCS_RGR		1
+#define MCS_ISR		2
+#define MCS_ICR		3
+#define MCS_IOR		4
+#define MCS_IMR		5
+#define MCS_IER		6
+#define MCS_RRR		24
+#define MCS_RMR		25
+#define MCS_RSR		34
+#define MCS_RCR		35
+#define MCS_RDR		36
+#define MCS_TRR		44
+#define MCS_TMR		45
+#define MCS_TSR		54
+#define MCS_TCR		55
+#define MCS_TDR		56
+
+#define RGR_RESET	0x80
+#define IMR_68K		0x02	/* vectored 68000 style interrupts */
+#define INT_RX		0x20
+#define INT_TX		0x40
+#define RATE_31250	0x08	/* 1 MHz CLKM / 32 */
+#define RSR_READY	0x80
+#define RCR_CLEAR	0x80
+#define RCR_FLAGS	0x4c	/* clear overrun, break and offline */
+#define RCR_ENABLE	0x01
+#define TSR_EMPTY	0x80
+#define TSR_ROOM	0x40
+#define TCR_CLEAR	0x80
+#define TCR_ENABLE	0x01
+
+struct x68k_midi {
+	spinlock_t lock;
+	void __iomem *regs;
+	struct snd_rawmidi_substream *in, *out;
+	u8 ier;
+	u8 vector;
+};
+
+static void mcs_select(struct x68k_midi *m, int reg)
+{
+	if (reg >= 4)
+		out_8(m->regs + 2 * MCS_RGR + 1, reg / 10);
+}
+
+static u8 mcs_read(struct x68k_midi *m, int reg)
+{
+	mcs_select(m, reg);
+	return in_8(m->regs + 2 * (reg < 4 ? reg : reg % 10) + 1);
+}
+
+static void mcs_write(struct x68k_midi *m, int reg, u8 val)
+{
+	mcs_select(m, reg);
+	out_8(m->regs + 2 * (reg < 4 ? reg : reg % 10) + 1, val);
+}
+
+static void midi_set_ier(struct x68k_midi *m, u8 bits, bool on)
+{
+	m->ier = on ? m->ier | bits : m->ier & ~bits;
+	mcs_write(m, MCS_IER, m->ier);
+}
+
+/* Fill the transmit FIFO, the empty interrupt asks for more while data is pending */
+static void midi_tx(struct x68k_midi *m)
+{
+	u8 byte;
+
+	if (!m->out) {
+		midi_set_ier(m, INT_TX, false);
+		return;
+	}
+	while ((mcs_read(m, MCS_TSR) & TSR_ROOM) && snd_rawmidi_transmit(m->out, &byte, 1) == 1)
+		mcs_write(m, MCS_TDR, byte);
+	midi_set_ier(m, INT_TX, !snd_rawmidi_transmit_empty(m->out));
+}
+
+static irqreturn_t x68k_midi_interrupt(int irq, void *dev_id)
+{
+	struct x68k_midi *m = dev_id;
+	irqreturn_t ret = IRQ_NONE;
+	u8 isr, byte;
+
+	spin_lock(&m->lock);
+	while ((isr = mcs_read(m, MCS_ISR) & m->ier)) {
+		ret = IRQ_HANDLED;
+		mcs_write(m, MCS_ICR, isr);
+		if (isr & INT_RX) {
+			while (mcs_read(m, MCS_RSR) & RSR_READY) {
+				byte = mcs_read(m, MCS_RDR);
+				if (m->in)
+					snd_rawmidi_receive(m->in, &byte, 1);
+			}
+		}
+		if (isr & INT_TX)
+			midi_tx(m);
+	}
+	spin_unlock(&m->lock);
+	return ret;
+}
+
+static int midi_in_open(struct snd_rawmidi_substream *s)
+{
+	struct x68k_midi *m = s->rmidi->private_data;
+	unsigned long flags;
+
+	spin_lock_irqsave(&m->lock, flags);
+	mcs_write(m, MCS_RCR, RCR_CLEAR | RCR_FLAGS);
+	mcs_write(m, MCS_RCR, RCR_ENABLE);
+	spin_unlock_irqrestore(&m->lock, flags);
+	return 0;
+}
+
+static int midi_in_close(struct snd_rawmidi_substream *s)
+{
+	struct x68k_midi *m = s->rmidi->private_data;
+	unsigned long flags;
+
+	spin_lock_irqsave(&m->lock, flags);
+	m->in = NULL;
+	midi_set_ier(m, INT_RX, false);
+	mcs_write(m, MCS_RCR, 0);
+	spin_unlock_irqrestore(&m->lock, flags);
+	return 0;
+}
+
+static void midi_in_trigger(struct snd_rawmidi_substream *s, int up)
+{
+	struct x68k_midi *m = s->rmidi->private_data;
+	unsigned long flags;
+
+	spin_lock_irqsave(&m->lock, flags);
+	m->in = up ? s : NULL;
+	midi_set_ier(m, INT_RX, up);
+	spin_unlock_irqrestore(&m->lock, flags);
+}
+
+static int midi_out_open(struct snd_rawmidi_substream *s)
+{
+	return 0;
+}
+
+static int midi_out_close(struct snd_rawmidi_substream *s)
+{
+	struct x68k_midi *m = s->rmidi->private_data;
+	unsigned long flags;
+
+	spin_lock_irqsave(&m->lock, flags);
+	m->out = NULL;
+	midi_set_ier(m, INT_TX, false);
+	spin_unlock_irqrestore(&m->lock, flags);
+	return 0;
+}
+
+static void midi_out_trigger(struct snd_rawmidi_substream *s, int up)
+{
+	struct x68k_midi *m = s->rmidi->private_data;
+	unsigned long flags;
+
+	spin_lock_irqsave(&m->lock, flags);
+	m->out = up ? s : NULL;
+	midi_tx(m);
+	spin_unlock_irqrestore(&m->lock, flags);
+}
+
+static u8 midi_tsr(struct x68k_midi *m)
+{
+	unsigned long flags;
+	u8 tsr;
+
+	spin_lock_irqsave(&m->lock, flags);
+	tsr = mcs_read(m, MCS_TSR);
+	spin_unlock_irqrestore(&m->lock, flags);
+	return tsr;
+}
+
+/* 16 bytes in the FIFO take 5 ms at 31250 baud */
+static void midi_out_drain(struct snd_rawmidi_substream *s)
+{
+	struct x68k_midi *m = s->rmidi->private_data;
+	u8 tsr;
+
+	read_poll_timeout(midi_tsr, tsr, tsr & TSR_EMPTY, 500, 20000, false, m);
+}
+
+static const struct snd_rawmidi_ops midi_in_ops = {
+	.open		= midi_in_open,
+	.close		= midi_in_close,
+	.trigger	= midi_in_trigger,
+};
+
+static const struct snd_rawmidi_ops midi_out_ops = {
+	.open		= midi_out_open,
+	.close		= midi_out_close,
+	.trigger	= midi_out_trigger,
+	.drain		= midi_out_drain,
+};
+
+static void midi_hw_init(struct x68k_midi *m)
+{
+	out_8(m->regs + 2 * MCS_RGR + 1, RGR_RESET);
+	udelay(10);
+	out_8(m->regs + 2 * MCS_RGR + 1, 0);
+	mcs_write(m, MCS_IOR, m->vector);
+	mcs_write(m, MCS_IMR, IMR_68K);
+	mcs_write(m, MCS_IER, 0);
+	mcs_write(m, MCS_RRR, RATE_31250);
+	mcs_write(m, MCS_RMR, 0);
+	mcs_write(m, MCS_RCR, RCR_CLEAR | RCR_FLAGS);
+	mcs_write(m, MCS_TRR, RATE_31250);
+	mcs_write(m, MCS_TMR, 0);
+	mcs_write(m, MCS_TCR, TCR_CLEAR);
+	mcs_write(m, MCS_TCR, TCR_ENABLE);
+}
+
+/* An empty slot raises a bus error, a present chip reads back its register group */
+static bool midi_present(void __iomem *regs)
+{
+	void __iomem *rgr = regs + 2 * MCS_RGR + 1;
+
+	if (!hwreg_present(rgr))
+		return false;
+	out_8(rgr, 4);
+	if ((in_8(rgr) & 0x0f) != 4)
+		return false;
+	out_8(rgr, 0);
+	return (in_8(rgr) & 0x0f) == 0;
+}
+
+static int x68k_midi_probe(struct platform_device *pdev)
+{
+	struct resource *res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	struct snd_rawmidi *rmidi;
+	struct snd_card *card;
+	struct x68k_midi *m;
+	void __iomem *regs;
+	int err;
+
+	if (!res)
+		return -ENODEV;
+	regs = x68k_io(res->start);
+	if (!midi_present(regs))
+		return -ENODEV;
+
+	err = snd_devm_card_new(&pdev->dev, SNDRV_DEFAULT_IDX1, SNDRV_DEFAULT_STR1, THIS_MODULE,
+				sizeof(*m), &card);
+	if (err < 0)
+		return err;
+	m = card->private_data;
+	spin_lock_init(&m->lock);
+	m->regs = regs;
+	m->vector = X68K_VEC_MIDI + 0x20 * max(pdev->id, 0);
+
+	strscpy(card->driver, "X68K-MIDI", sizeof(card->driver));
+	strscpy(card->shortname, "CZ-6BM1 MIDI", sizeof(card->shortname));
+	snprintf(card->longname, sizeof(card->longname), "Sharp CZ-6BM1 YM3802 MIDI at 0x%06llx",
+		 (unsigned long long)res->start);
+
+	err = snd_rawmidi_new(card, "YM3802", 0, 1, 1, &rmidi);
+	if (err < 0)
+		return err;
+	rmidi->private_data = m;
+	strscpy(rmidi->name, "CZ-6BM1 MIDI", sizeof(rmidi->name));
+	rmidi->info_flags = SNDRV_RAWMIDI_INFO_OUTPUT | SNDRV_RAWMIDI_INFO_INPUT |
+			    SNDRV_RAWMIDI_INFO_DUPLEX;
+	snd_rawmidi_set_ops(rmidi, SNDRV_RAWMIDI_STREAM_INPUT, &midi_in_ops);
+	snd_rawmidi_set_ops(rmidi, SNDRV_RAWMIDI_STREAM_OUTPUT, &midi_out_ops);
+
+	midi_hw_init(m);
+	/* The vector is the IOR base plus twice the number of the interrupt source */
+	err = devm_request_irq(&pdev->dev, X68K_IRQ(m->vector + 2 * ilog2(INT_RX)),
+			       x68k_midi_interrupt, 0, "x68k-midi", m);
+	if (!err)
+		err = devm_request_irq(&pdev->dev, X68K_IRQ(m->vector + 2 * ilog2(INT_TX)),
+				       x68k_midi_interrupt, 0, "x68k-midi", m);
+	if (err)
+		return err;
+
+	err = snd_card_register(card);
+	if (err < 0)
+		return err;
+	platform_set_drvdata(pdev, card);
+	return 0;
+}
+
+static void x68k_midi_shutdown(struct platform_device *pdev)
+{
+	struct snd_card *card = platform_get_drvdata(pdev);
+	struct x68k_midi *m;
+
+	if (!card)
+		return;
+	m = card->private_data;
+	out_8(m->regs + 2 * MCS_RGR + 1, RGR_RESET);
+}
+
+static struct platform_driver x68k_midi_driver = {
+	.probe		= x68k_midi_probe,
+	.shutdown	= x68k_midi_shutdown,
+	.driver		= {
+		.name = "x68k-midi",
+	},
+};
+module_platform_driver(x68k_midi_driver);
+
+MODULE_DESCRIPTION("Sharp CZ-6BM1 MIDI card driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 23ed9184e0031e1f670d24fbce21201bea85020d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 12:23:05 +0100
Subject: [PATCH 24/31] Documentation: m68k: Describe the Sharp X68030 support
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Describe the supported machines, booting from SCSI disks, the devices
and their drivers, hardware notes and what was tested.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 Documentation/arch/m68k/index.rst |   2 +-
 Documentation/arch/m68k/x68k.rst  | 135 ++++++++++++++++++++++++++++++
 2 files changed, 136 insertions(+), 1 deletion(-)
 create mode 100644 Documentation/arch/m68k/x68k.rst

diff --git a/Documentation/arch/m68k/index.rst b/Documentation/arch/m68k/index.rst
index 9024dc1cf870..ca1374695048 100644
--- a/Documentation/arch/m68k/index.rst
+++ b/Documentation/arch/m68k/index.rst
@@ -10,5 +10,5 @@ m68k Architecture
    kernel-options
    buddha-driver
    next
-
+   x68k
    features
diff --git a/Documentation/arch/m68k/x68k.rst b/Documentation/arch/m68k/x68k.rst
new file mode 100644
index 000000000000..882115e288f8
--- /dev/null
+++ b/Documentation/arch/m68k/x68k.rst
@@ -0,0 +1,135 @@
+.. SPDX-License-Identifier: GPL-2.0
+
+======================
+Linux on Sharp X68030
+======================
+
+Supported machines
+==================
+
+The Sharp X68030 and X68030 Compact.  The stock 68EC030 has no MMU, Linux needs
+a full MC68030 in its place.  A 68881 or 68882 FPU is optional and detected by
+the loader.
+
+Memory up to 12 MB sits at 0, the 24 bit limit of the X68000 series.  A board
+at 0x01000000 adds up to 16 MB more, the loader probes it in 1 MB steps.  The
+DMA controller only reaches the low 16 MB, ZONE_DMA covers them.
+
+Booting
+=======
+
+``make ARCH=m68k x68k_defconfig x68kboot`` builds
+``arch/m68k/x68k/boot/x68kboot``, a small loader and the kernel.  The default
+command line is ``console=ttyS0,9600 console=tty0`` and can be set with
+``X68KBOOT_CMDLINE=...`` on the make command line.
+
+``arch/m68k/x68k/boot/mkx68kdisk`` makes a SCSI disk or image bootable::
+
+    mkx68kdisk disk.img x68kboot
+
+It writes the ``X68SCSI1`` signature to block 0, the first 1 KB of the loader
+where the ROM looks for it, the rest of the loader and the kernel behind it,
+and a Human68k partition table with one partition over the rest of the disk,
+which holds the root file system as ``sda1``.
+
+The loader reads the kernel through the ROM SCSI calls, builds the boot
+information and moves the kernel to 0x1000.  The ROM is only used through its
+documented calls.
+
+Devices
+=======
+
+=====================  ==============================  ======================
+Device                 Driver                          Interface
+=====================  ==============================  ======================
+Z8530 serial port A    pmac_zilog                      ``ttyS0``
+Text screen            x68kfb                          ``fb0``, backlight
+Graphics screen        x68kgfb                         ``fb1``
+Keyboard               x68kkbd                         input, LEDs
+Mouse (Z8530 B)        x68kmouse                       input
+Joystick ports         x68kjoy                         input
+MB89352 SCSI           x68k_spc                        SCSI disks and so on
+uPD72065 floppy        floppy                          ``fd0`` and up
+RP5C15 clock           rtc-rp5c01                      ``rtc0``
+SRAM                   x68k_sram                       nvmem
+ADPCM and YM2151       snd-x68k                        ALSA PCM, hwdep
+YM2151 synthesizer     snd-x68k-opm-synth              ALSA sequencer port
+Printer port           parport_x68k                    ``parport0``, ``lp0``
+Neptune-X Ethernet     x68k_neptune                    ``eth0``
+CZ-6BS1 SCSI card      x68k_spc                        second SCSI host
+CZ-6BM1 MIDI card      snd-x68k-midi                   ALSA raw MIDI
+Power switch           x68k_power                      input, ``KEY_POWER``
+Power off              built in                        ``poweroff``
+=====================  ==============================  ======================
+
+The text console uses one plane of the text screen in the mode the ROM set up.
+It scrolls by moving the text start, which wraps around the 1024 lines of a
+plane, this needs ``CONFIG_FRAMEBUFFER_CONSOLE_LEGACY_ACCELERATION``.  The
+graphics screen offers 512x512 with 65536 colours, the CRTC switches to this
+mode while ``fb1`` is open and the text console shrinks to the same size for
+that time.  The backlight device sets the display contrast.
+
+Sound plays and records 16 bit PCM, coded to ADPCM for the MSM6258 and moved
+by DMA, one direction at a time.  Recorded bytes hold the first sample in the
+upper nibble as in XM6, which is the opposite of playback.  The YM2151 is
+reached through the hwdep device: each write takes pairs of register and value
+bytes.
+
+The sequencer synthesizer plays the MIDI events of its port on the eight YM2151
+channels, with velocity, volume, expression, pan and pitch bend.  The drum
+channel is not played.  ``SNDRV_X68K_OPM_IOCTL_VOICE`` on the hwdep device loads
+the voice of a program from ``<sound/x68k_opm.h>``, programs without one play a
+default voice.  Register writes through the hwdep device change the same
+channels.
+
+Turning the front panel power switch off reports ``KEY_POWER``, for the init
+system or a daemon to shut down.  Turning it on again while running reports
+nothing.
+
+The 1232 KB 2HD floppy format with 1024 byte sectors is not one of the floppy
+driver defaults, set it with ``FDSETPRM``: size 2464, 16 sectors, 2 heads,
+77 tracks, gap 0x35, rate 0x08, spec1 0xdf, format gap 0x74.  ``FDEJECT``
+ejects the disk, the drive needs a writable open for it.
+
+The SCSI controllers transfer every phase with DMA, channel 1 for the internal
+one and channel 2 for the card, and interrupt at its end.  The DMA controller
+only reaches the low 16 MB, other memory goes through a bounce page.
+
+The SCSI and MIDI cards are found by probing their registers, absent cards do
+not register a device.  The MIDI card runs at 31250 baud, its interrupt vectors
+are 0x80 for board ID 1 and 0xa0 for board ID 2, plus twice the source number.
+
+Not supported:
+
+- Sprites and background planes, and the other graphics screen modes.
+- RS-232C and other expansion cards not listed above.
+
+Notes on the hardware
+=====================
+
+Most devices put their own vector on the bus, MFP sources start at 0x40, the
+SCC at 0x50, the I/O controller at 0x60 and the DMA channels at 0x64.  The
+internal SCSI controller uses 0x6c and the CZ-6BS1 card 0xf6.  Linux
+handles them as user vector interrupts, expansion cards up to vector 0xff.
+Expansion card interrupts are masked at the card, as the system has no mask for
+them.
+
+Before ``reboot`` re-enters the ROM, the kernel stops DMA, sound, SCSI and the
+interrupt sources and issues a ``reset``, the ROM does not expect them active.
+
+The ROM ejects floppy disks it cannot boot from.
+
+Testing
+=======
+
+Development was done on MAME, with fixes and additions to its X68030 model for
+internal SCSI DMA and interrupt vector, the SCSI bus free timing, the high
+memory board, the printer port, the serial port, YM3802 receive, ADPCM
+recording from a microphone input and the power switch.  A MAME sound module
+offers a WAV file as that input.  MAME runs its sound streams at whole sample
+rates, so only 15625 Hz records without an occasional repeated byte there.  The CZ-6BS1 card was tested in MAME
+without its ROM, which only the ROM boot needs.  MIDI board ID 2, more than one
+floppy drive and real hardware are untested.
+
+The Sharp ROM licence does not allow analysing or changing the ROM.  The port
+treats it as a black box and uses only its documented calls.
-- 
2.54.0


From a08f010de8fd30481049c53dbef1d3e48ebc21cb Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 12:53:26 +0100
Subject: [PATCH 25/31] m68k: x68k: Share the I/O controller interrupt enables
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The floppy and printer drivers each changed their enable bit in the I/O
controller status register with an unlocked read, modify and write,
and the SCSI driver is about to need one too. Add a locked helper and
name the bits.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/include/asm/x68k.h     |  6 ++++++
 arch/m68k/include/asm/x68kflop.h |  6 +-----
 arch/m68k/x68k/ints.c            | 18 +++++++++++++++++-
 drivers/parport/parport_x68k.c   |  5 +----
 4 files changed, 25 insertions(+), 10 deletions(-)

diff --git a/arch/m68k/include/asm/x68k.h b/arch/m68k/include/asm/x68k.h
index 14e7f47fe553..c324d937a99f 100644
--- a/arch/m68k/include/asm/x68k.h
+++ b/arch/m68k/include/asm/x68k.h
@@ -27,6 +27,11 @@
 #define X68K_IOC		0x00e9c000
 #define X68K_DMAC		0x00e84000
 
+/* Interrupt enables in the I/O controller status register */
+#define X68K_IOC_PRT_IEN	0x01
+#define X68K_IOC_FDD_IEN	0x02
+#define X68K_IOC_FDC_IEN	0x04
+#define X68K_IOC_HDD_IEN	0x08
 static inline void __iomem *x68k_io(unsigned long phys)
 {
 	return (void __iomem *)(phys - X68K_IO_PHYS + X68K_IO_VIRT);
@@ -70,6 +75,7 @@ void x68k_opm_write(u8 reg, u8 val);
 void x68k_opm_set_ct(u8 mask, u8 val);
 
 void x68k_init_IRQ(void);
+void x68k_ioc_irq_enable(u8 bits, bool on);
 void x68k_sched_init(void);
 void x68k_rom_reset(void);
 
diff --git a/arch/m68k/include/asm/x68kflop.h b/arch/m68k/include/asm/x68kflop.h
index 610356edd432..d4295f74b929 100644
--- a/arch/m68k/include/asm/x68kflop.h
+++ b/arch/m68k/include/asm/x68kflop.h
@@ -26,8 +26,6 @@
 #define FDD_SELECT_MOTOR	0x80
 #define FDD_SELECT_300K		0x10
 
-#define IOC_FDC_IEN		0x04
-
 struct x68k_fd_state {
 	u8 dor;
 	u8 rate;
@@ -162,9 +160,7 @@ static inline int x68k_fd_eject(int drive)
 
 static inline void x68k_fd_irq_enable(bool on)
 {
-	u8 ien = in_8(x68k_io(X68K_IOC + 1)) & 0x0f;
-
-	out_8(x68k_io(X68K_IOC + 1), on ? ien | IOC_FDC_IEN : ien & ~IOC_FDC_IEN);
+	x68k_ioc_irq_enable(X68K_IOC_FDC_IEN, on);
 }
 
 #endif /* _ASM_M68K_X68KFLOP_H */
diff --git a/arch/m68k/x68k/ints.c b/arch/m68k/x68k/ints.c
index 3f8dd1bb7ea4..a457383a5b99 100644
--- a/arch/m68k/x68k/ints.c
+++ b/arch/m68k/x68k/ints.c
@@ -6,10 +6,11 @@
  * Copyright (C) 2026 René Rebe <rene@exactco.de>
  */
 
+#include <linux/export.h>
 #include <linux/init.h>
 #include <linux/interrupt.h>
 #include <linux/irq.h>
-
+#include <linux/spinlock.h>
 #include <asm/io.h>
 #include <asm/irq.h>
 #include <asm/x68k.h>
@@ -75,3 +76,18 @@ void __init x68k_init_IRQ(void)
 	out_8(x68k_io(X68K_IOC + 1), 0);
 	out_8(x68k_io(X68K_IOC + 3), X68K_VEC_IOC);
 }
+
+static DEFINE_SPINLOCK(ioc_lock);
+
+/* The low nibble of the status register holds the enables of the I/O controller */
+void x68k_ioc_irq_enable(u8 bits, bool on)
+{
+	unsigned long flags;
+	u8 ien;
+
+	spin_lock_irqsave(&ioc_lock, flags);
+	ien = in_8(x68k_io(X68K_IOC + 1)) & 0x0f;
+	out_8(x68k_io(X68K_IOC + 1), on ? ien | bits : ien & ~bits);
+	spin_unlock_irqrestore(&ioc_lock, flags);
+}
+EXPORT_SYMBOL_GPL(x68k_ioc_irq_enable);
diff --git a/drivers/parport/parport_x68k.c b/drivers/parport/parport_x68k.c
index a459955c7fb5..1f51c77adeee 100644
--- a/drivers/parport/parport_x68k.c
+++ b/drivers/parport/parport_x68k.c
@@ -19,7 +19,6 @@
 #define PRT_STROBE	0x00e8c003	/* bit 0, low active */
 #define IOC_STATUS	(X68K_IOC + 1)
 #define IOC_PRT_READY	0x20
-#define IOC_PRT_IEN	0x01
 #define PRT_VECTOR	(X68K_VEC_IOC + 3)
 
 /* The data latch cannot be read back */
@@ -66,9 +65,7 @@ static unsigned char x68k_pp_read_status(struct parport *p)
 
 static void x68k_pp_irq(struct parport *p, bool on)
 {
-	u8 ien = in_8(x68k_io(IOC_STATUS)) & 0x0f;
-
-	out_8(x68k_io(IOC_STATUS), on ? ien | IOC_PRT_IEN : ien & ~IOC_PRT_IEN);
+	x68k_ioc_irq_enable(X68K_IOC_PRT_IEN, on);
 }
 
 static void x68k_pp_enable_irq(struct parport *p)
-- 
2.54.0


From 0d05eb958a7c0d7740505b3b1d03cdaa4bd8e5e0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 12:53:26 +0100
Subject: [PATCH 26/31] m68k: x68k: Add array chained DMA transfers
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Let the HD63450 read the blocks of a transfer from a table in memory,
for scatter-gather transfers of the SCSI controllers on channels 1
and 2.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/include/asm/x68kdmac.h | 12 ++++++++
 arch/m68k/x68k/dmac.c            | 53 +++++++++++++++++++++++---------
 2 files changed, 51 insertions(+), 14 deletions(-)

diff --git a/arch/m68k/include/asm/x68kdmac.h b/arch/m68k/include/asm/x68kdmac.h
index a9bdab848e56..589a2db06821 100644
--- a/arch/m68k/include/asm/x68kdmac.h
+++ b/arch/m68k/include/asm/x68kdmac.h
@@ -12,15 +12,27 @@
 #include <linux/types.h>
 
 #define X68K_DMAC_FDC		0
+#define X68K_DMAC_SPC		1
+#define X68K_DMAC_EXP		2
 #define X68K_DMAC_ADPCM		3
 
 /* Operation control: transfer direction and request source */
 #define DMAC_OCR_DEV2MEM	0x80
 #define DMAC_OCR_SIZE_BYTE	0x00
 #define DMAC_OCR_REQG_EXT	0x02
+#define DMAC_OCR_REQG_AUTO_MAX	0x01
 
+/* Array chaining: the controller reads the blocks from a table in DMA memory */
+struct x68k_dmac_block {
+	__be32 addr;
+	__be16 len;
+} __packed;
+
+#define X68K_DMAC_MAX_BLOCK	0xffff
 int x68k_dmac_start(unsigned int ch, unsigned long phys, unsigned int len, u8 ocr,
 		    unsigned long dev_phys);
+int x68k_dmac_start_chain(unsigned int ch, unsigned long table_phys, unsigned int blocks, u8 ocr,
+			  unsigned long dev_phys);
 unsigned int x68k_dmac_stop(unsigned int ch);
 bool x68k_dmac_busy(unsigned int ch);
 
diff --git a/arch/m68k/x68k/dmac.c b/arch/m68k/x68k/dmac.c
index d547752af46a..2179b2780c0d 100644
--- a/arch/m68k/x68k/dmac.c
+++ b/arch/m68k/x68k/dmac.c
@@ -1,7 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * Sharp X68030 HD63450 DMA controller, single block transfers between memory and
- * an 8 bit device which requests each byte
+ * Sharp X68030 HD63450 DMA controller, transfers between memory and an 8 bit device,
+ * of one block or a chained array of blocks
  *
  * Copyright (C) 2026 René Rebe <rene@exactco.de>
  */
@@ -23,19 +23,20 @@
 #define DMAC_MTC		0x0a
 #define DMAC_MAR		0x0c
 #define DMAC_DAR		0x14
+#define DMAC_BTC		0x1a
+#define DMAC_BAR		0x1c
 #define DMAC_MFC		0x29
 #define DMAC_CPR		0x2d
 #define DMAC_DFC		0x31
-
+#define DMAC_BFC		0x39
 #define DCR_CYCLE_STEAL		0x80	/* 68000 type device, 8 bit port */
 #define SCR_MEM_COUNT_UP	0x04
 #define CCR_START		0x80
 #define CCR_ABORT		0x10
 #define CSR_ACTIVE		0x08
+#define OCR_ARRAY_CHAIN		0x08
 #define FC_SUPER_DATA		0x05
 
-#define DMAC_MAX_LEN		0xffff
-
 static DEFINE_SPINLOCK(dmac_lock);
 
 static void __iomem *dmac_reg(unsigned int ch, unsigned int reg)
@@ -43,15 +44,8 @@ static void __iomem *dmac_reg(unsigned int ch, unsigned int reg)
 	return x68k_io(DMAC_CH(ch) + reg);
 }
 
-int x68k_dmac_start(unsigned int ch, unsigned long phys, unsigned int len, u8 ocr,
-		    unsigned long dev_phys)
+static void dmac_setup(unsigned int ch, u8 ocr, unsigned long dev_phys)
 {
-	unsigned long flags;
-
-	if (!len || len > DMAC_MAX_LEN)
-		return -EINVAL;
-
-	spin_lock_irqsave(&dmac_lock, flags);
 	out_8(dmac_reg(ch, DMAC_CCR), CCR_ABORT);
 	out_8(dmac_reg(ch, DMAC_CSR), 0xff);
 	out_8(dmac_reg(ch, DMAC_DCR), DCR_CYCLE_STEAL);
@@ -59,16 +53,47 @@ int x68k_dmac_start(unsigned int ch, unsigned long phys, unsigned int len, u8 oc
 	out_8(dmac_reg(ch, DMAC_SCR), SCR_MEM_COUNT_UP);
 	out_8(dmac_reg(ch, DMAC_MFC), FC_SUPER_DATA);
 	out_8(dmac_reg(ch, DMAC_DFC), FC_SUPER_DATA);
+	out_8(dmac_reg(ch, DMAC_BFC), FC_SUPER_DATA);
 	out_8(dmac_reg(ch, DMAC_CPR), 0);
+	out_be32(dmac_reg(ch, DMAC_DAR), dev_phys);
+}
+
+int x68k_dmac_start(unsigned int ch, unsigned long phys, unsigned int len, u8 ocr,
+		    unsigned long dev_phys)
+{
+	unsigned long flags;
+
+	if (!len || len > X68K_DMAC_MAX_BLOCK)
+		return -EINVAL;
+
+	spin_lock_irqsave(&dmac_lock, flags);
+	dmac_setup(ch, ocr, dev_phys);
 	out_be16(dmac_reg(ch, DMAC_MTC), len);
 	out_be32(dmac_reg(ch, DMAC_MAR), phys);
-	out_be32(dmac_reg(ch, DMAC_DAR), dev_phys);
 	out_8(dmac_reg(ch, DMAC_CCR), CCR_START);
 	spin_unlock_irqrestore(&dmac_lock, flags);
 	return 0;
 }
 EXPORT_SYMBOL_GPL(x68k_dmac_start);
 
+int x68k_dmac_start_chain(unsigned int ch, unsigned long table_phys, unsigned int blocks, u8 ocr,
+			  unsigned long dev_phys)
+{
+	unsigned long flags;
+
+	if (!blocks || blocks > 0xffff)
+		return -EINVAL;
+
+	spin_lock_irqsave(&dmac_lock, flags);
+	dmac_setup(ch, ocr | OCR_ARRAY_CHAIN, dev_phys);
+	out_be16(dmac_reg(ch, DMAC_BTC), blocks);
+	out_be32(dmac_reg(ch, DMAC_BAR), table_phys);
+	out_8(dmac_reg(ch, DMAC_CCR), CCR_START);
+	spin_unlock_irqrestore(&dmac_lock, flags);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(x68k_dmac_start_chain);
+
 /* Returns the bytes not transferred */
 unsigned int x68k_dmac_stop(unsigned int ch)
 {
