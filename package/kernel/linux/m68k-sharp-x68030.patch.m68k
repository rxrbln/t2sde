+
 #ifdef CONFIG_HP300
 	is_not_hp300(L(nothp300))
 
@@ -1480,6 +1495,12 @@ L(mmu_fixup_done):
 	is_not_next(1f)
 	movel	#NEXT_IO_VIRT,L(iobase)
 1:
