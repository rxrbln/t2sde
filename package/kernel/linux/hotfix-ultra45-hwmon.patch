 struct env {
 	void __iomem	*regs;
-	spinlock_t	lock;
-
-	struct device	*hwmon_dev;
+	struct resource	*res;
 };
 
-static u8 env_read(struct env *p, u8 ireg)
-{
-	u8 ret;
+static const u8 env_temp_reg[] = {
+	IREG_LCL_TEMP, IREG_RMT1_TEMP, IREG_RMT2_TEMP, IREG_RMT3_TEMP,
+	IREG_LM95221_TEMP, IREG_FIRE_TEMP, IREG_LSI1064_TEMP, IREG_FRONT_TEMP,
+	IREG_PSU_TEMP,
+};
 
-	spin_lock(&p->lock);
-	writeb(ireg, p->regs + REG_ADDR);
-	ret = readb(p->regs + REG_DATA);
-	spin_unlock(&p->lock);
+/* fan status bits as named by the obdiag env-monitor test, PSU has no tach */
+static const char * const env_fan_label[] = {
+	"CPU0", "CPU1", "SYS0", "SYS1", "SYS2", "SYS3", "PSU",
+};
 
-	return ret;
-}
+static const char * const env_temp_label[] = {
+	"ADT7462 local", "CPU0", "CPU1", "Motherboard", "LM95221 local",
+	"Fire", "LSI1064 local", "Front panel", "PSU",
+};
 
-static void env_write(struct env *p, u8 ireg, u8 val)
+/* hwmon core serializes the attribute callbacks, no extra locking needed */
+static u8 env_read(struct env *p, u8 ireg)
 {
-	spin_lock(&p->lock);
 	writeb(ireg, p->regs + REG_ADDR);
-	writeb(val, p->regs + REG_DATA);
-	spin_unlock(&p->lock);
+	return readb(p->regs + REG_DATA);
 }
 
 /*
@@ -91,215 +93,156 @@ static void env_write(struct env *p, u8
  * of these calculations are borrowed from the adt7470 driver.
  */
 #define FAN_PERIOD_TO_RPM(x)	((90000 * 60) / (x))
-#define FAN_RPM_TO_PERIOD	FAN_PERIOD_TO_RPM
 #define FAN_PERIOD_INVALID	(0xff << 8)
 #define FAN_DATA_VALID(x)	((x) && (x) != FAN_PERIOD_INVALID)
 
-static ssize_t show_fan_speed(struct device *dev, struct device_attribute *attr,
-			      char *buf)
-{
-	int fan_nr = to_sensor_dev_attr(attr)->index;
-	struct env *p = dev_get_drvdata(dev);
-	int rpm, period;
-	u8 val;
-
-	val = env_read(p, IREG_FAN0 + fan_nr);
-	period = (int) val << 8;
-	if (FAN_DATA_VALID(period))
-		rpm = FAN_PERIOD_TO_RPM(period);
-	else
-		rpm = 0;
-
-	return sprintf(buf, "%d\n", rpm);
-}
-
-static ssize_t set_fan_speed(struct device *dev, struct device_attribute *attr,
-			     const char *buf, size_t count)
+static int env_hwmon_read(struct device *dev, enum hwmon_sensor_types type,
+			  u32 attr, int channel, long *val)
 {
-	int fan_nr = to_sensor_dev_attr(attr)->index;
-	unsigned long rpm;
 	struct env *p = dev_get_drvdata(dev);
 	int period;
-	u8 val;
-	int err;
-
-	err = kstrtoul(buf, 10, &rpm);
-	if (err)
-		return err;
+	u8 raw;
 
-	if (!rpm)
-		return -EINVAL;
-
-	period = FAN_RPM_TO_PERIOD(rpm);
-	val = period >> 8;
-	env_write(p, IREG_FAN0 + fan_nr, val);
-
-	return count;
+	switch (type) {
+	case hwmon_temp:
+		/* offset 64 encoding, 0 is reported for absent sensors */
+		raw = env_read(p, env_temp_reg[channel]);
+		if (!raw)
+			return -ENODATA;
+		*val = ((long)raw - 64) * 1000;
+		return 0;
+	case hwmon_fan:
+		if (attr == hwmon_fan_fault) {
+			*val = !!(env_read(p, IREG_FAN_STAT) & BIT(channel));
+			return 0;
+		}
+		period = (int)env_read(p, IREG_FAN0 + channel) << 8;
+		*val = FAN_DATA_VALID(period) ? FAN_PERIOD_TO_RPM(period) : 0;
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
 }
 
-static ssize_t show_fan_fault(struct device *dev, struct device_attribute *attr,
-			      char *buf)
-{
-	int fan_nr = to_sensor_dev_attr(attr)->index;
-	struct env *p = dev_get_drvdata(dev);
-	u8 val = env_read(p, IREG_FAN_STAT);
-	return sprintf(buf, "%d\n", (val & (1 << fan_nr)) ? 1 : 0);
+static int env_hwmon_read_string(struct device *dev,
+				 enum hwmon_sensor_types type, u32 attr,
+				 int channel, const char **str)
+{
+	if (type == hwmon_temp)
+		*str = env_temp_label[channel];
+	else if (type == hwmon_fan)
+		*str = env_fan_label[channel];
+	else
+		return -EOPNOTSUPP;
+	return 0;
 }
 
-#define fan(index)							\
-static SENSOR_DEVICE_ATTR(fan##index##_speed, S_IRUGO | S_IWUSR,	\
-		show_fan_speed, set_fan_speed, index);			\
-static SENSOR_DEVICE_ATTR(fan##index##_fault, S_IRUGO,			\
-		show_fan_fault, NULL, index)
-
-fan(0);
-fan(1);
-fan(2);
-fan(3);
-fan(4);
-
-static SENSOR_DEVICE_ATTR(psu_fan_fault, S_IRUGO, show_fan_fault, NULL, 6);
-
-static ssize_t show_temp(struct device *dev, struct device_attribute *attr,
-			 char *buf)
-{
-	int temp_nr = to_sensor_dev_attr(attr)->index;
-	struct env *p = dev_get_drvdata(dev);
-	s8 val;
+static const struct hwmon_ops env_hwmon_ops = {
+	.visible	= 0444,
+	.read		= env_hwmon_read,
+	.read_string	= env_hwmon_read_string,
+};
 
-	val = env_read(p, IREG_LCL_TEMP + temp_nr);
-	return sprintf(buf, "%d\n", ((int) val) - 64);
-}
+static const struct hwmon_channel_info * const env_info[] = {
+	HWMON_CHANNEL_INFO(temp,
+			   HWMON_T_INPUT | HWMON_T_LABEL,
+			   HWMON_T_INPUT | HWMON_T_LABEL,
+			   HWMON_T_INPUT | HWMON_T_LABEL,
+			   HWMON_T_INPUT | HWMON_T_LABEL,
+			   HWMON_T_INPUT | HWMON_T_LABEL,
+			   HWMON_T_INPUT | HWMON_T_LABEL,
+			   HWMON_T_INPUT | HWMON_T_LABEL,
+			   HWMON_T_INPUT | HWMON_T_LABEL,
+			   HWMON_T_INPUT | HWMON_T_LABEL),
+	HWMON_CHANNEL_INFO(fan,
+			   HWMON_F_INPUT | HWMON_F_FAULT | HWMON_F_LABEL,
+			   HWMON_F_INPUT | HWMON_F_FAULT | HWMON_F_LABEL,
+			   HWMON_F_INPUT | HWMON_F_FAULT | HWMON_F_LABEL,
+			   HWMON_F_INPUT | HWMON_F_FAULT | HWMON_F_LABEL,
+			   HWMON_F_INPUT | HWMON_F_FAULT | HWMON_F_LABEL,
+			   HWMON_F_INPUT | HWMON_F_FAULT | HWMON_F_LABEL,
+			   HWMON_F_FAULT | HWMON_F_LABEL),
+	NULL
+};
 
-static SENSOR_DEVICE_ATTR(adt7462_local_temp, S_IRUGO, show_temp, NULL, 0);
-static SENSOR_DEVICE_ATTR(cpu0_temp, S_IRUGO, show_temp, NULL, 1);
-static SENSOR_DEVICE_ATTR(cpu1_temp, S_IRUGO, show_temp, NULL, 2);
-static SENSOR_DEVICE_ATTR(motherboard_temp, S_IRUGO, show_temp, NULL, 3);
-static SENSOR_DEVICE_ATTR(lm95221_local_temp, S_IRUGO, show_temp, NULL, 4);
-static SENSOR_DEVICE_ATTR(fire_temp, S_IRUGO, show_temp, NULL, 5);
-static SENSOR_DEVICE_ATTR(lsi1064_local_temp, S_IRUGO, show_temp, NULL, 6);
-static SENSOR_DEVICE_ATTR(front_panel_temp, S_IRUGO, show_temp, NULL, 7);
-static SENSOR_DEVICE_ATTR(psu_temp, S_IRUGO, show_temp, NULL, 13);
+static const struct hwmon_chip_info env_chip_info = {
+	.ops	= &env_hwmon_ops,
+	.info	= env_info,
+};
 
-static ssize_t show_stat_bit(struct device *dev, struct device_attribute *attr,
-			     char *buf)
+static ssize_t env_stat_show(struct device *dev, char *buf, u8 mask)
 {
-	int index = to_sensor_dev_attr(attr)->index;
 	struct env *p = dev_get_drvdata(dev);
-	u8 val;
 
-	val = readb(p->regs + REG_STAT);
-	return sprintf(buf, "%d\n", (val & (1 << index)) ? 1 : 0);
+	return sysfs_emit(buf, "%d\n", !!(readb(p->regs + REG_STAT) & mask));
 }
 
-static SENSOR_DEVICE_ATTR(fan_failure, S_IRUGO, show_stat_bit, NULL, 0);
-static SENSOR_DEVICE_ATTR(env_bus_busy, S_IRUGO, show_stat_bit, NULL, 1);
-static SENSOR_DEVICE_ATTR(env_data_stale, S_IRUGO, show_stat_bit, NULL, 2);
-static SENSOR_DEVICE_ATTR(tpm_self_test_passed, S_IRUGO, show_stat_bit, NULL,
-			  3);
+#define ENV_STAT_ATTR(_name, _mask)					\
+static ssize_t status_##_name##_show(struct device *dev,		\
+				     struct device_attribute *attr,	\
+				     char *buf)				\
+{									\
+	return env_stat_show(dev, buf, _mask);				\
+}									\
+static DEVICE_ATTR_RO(status_##_name)
+
+ENV_STAT_ATTR(fault, REG_STAT_FAULT);
+ENV_STAT_ATTR(busy, REG_STAT_BUSY);
+ENV_STAT_ATTR(stale, REG_STAT_STALE);
+ENV_STAT_ATTR(tgood, REG_STAT_TGOOD);
 
-static ssize_t show_fwver(struct device *dev, struct device_attribute *attr,
-			  char *buf)
+static ssize_t firmware_version_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
 {
 	struct env *p = dev_get_drvdata(dev);
-	u8 val;
 
-	val = readb(p->regs + REG_STAT);
-	return sprintf(buf, "%d\n", val >> 4);
+	return sysfs_emit(buf, "%u\n", readb(p->regs + REG_STAT) >> 4);
 }
+static DEVICE_ATTR_RO(firmware_version);
 
-static SENSOR_DEVICE_ATTR(firmware_version, S_IRUGO, show_fwver, NULL, 0);
