+/*
+ * Pad DMA mappings made behind a Quicksilver AGP bridge.
+ *
+ * For a connected PCI DMA read, the IOC keeps fetching ahead until the bridge
+ * disconnects.  A Quicksilver does not disconnect at the 4KB page boundary, so
+ * a read that runs to the end of a mapping prefetches into the next IOVA page.
+ * If that page is not mapped the IOMMU rejects it, the rope hard-fails and the
+ * machine takes an HPMC.  HP's zx1 IOMMU driver for ia64 described the same
+ * hazard and noted that later zx1 LBA revisions disconnect on 4KB boundaries;
+ * the Quicksilver in the C8000 is TR1.0.
+ *
+ * So follow each such mapping with one extra pdir entry pointing at a shared
+ * scratch page: the prefetch then reads that page instead of hard-failing.
+ * AGP mode is unaffected, since parisc-agp keeps the whole GART aperture valid.
+ *
+ * sba_iommu.sba_prefetch_pad=0 disables it, for diagnosis only.
+ */
+static int sba_prefetch_pad = 1;
+module_param(sba_prefetch_pad, int, 0444);
+MODULE_PARM_DESC(sba_prefetch_pad,
+		 "Pad DMA mappings behind a Quicksilver AGP bridge (1, default; 0 to diagnose)");
+
+static unsigned long sba_pad_pa;	/* scratch page the pad entries point at */
+
+/*
+ * Keyed on the bridge rather than the device: the fault has been seen with two
+ * different graphics cards behind a Quicksilver and never behind a Mercury.
+ * Only the AGP slot sits behind a Quicksilver, so this also covers whatever
+ * card is fitted there.
+ */
+static bool sba_needs_prefetch_pad(struct device *dev)
+{
+	struct pci_hba_data *hba;
+
+	if (!sba_pad_pa || !dev)
+		return false;
+
+	hba = parisc_walk_tree(dev);
+
+	return hba && hba->dev && IS_QUICKSILVER(hba->dev);
+}
