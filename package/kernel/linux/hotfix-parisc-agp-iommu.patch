+/**
+ * sba_resmap_update - set or clear a run of bits in the resource bitmap
+ * @ioc: IO MMU structure which owns the bitmap
+ * @start: first bit (pide) of the run
+ * @nbits: length of the run
+ * @set: true to mark busy, false to mark free
+ *
+ * Bits are numbered most-significant-first within each word, the opposite of
+ * the convention bitmap_set()/bitmap_clear() use, so those cannot be
+ * substituted.  Walking a word at a time also keeps RESMAP_MASK() within the
+ * 1..BITS_PER_LONG range it is defined for.
+ */
+static void sba_resmap_update(struct ioc *ioc, unsigned long start,
+			      unsigned long nbits, bool set)
+{
+	unsigned long *map = (unsigned long *) ioc->res_map;
+
+	while (nbits) {
+		unsigned long off = start % BITS_PER_LONG;
+		unsigned long n = min(nbits, BITS_PER_LONG - off);
+		unsigned long mask = RESMAP_MASK(n) >> off;
+
+		if (set)
+			map[start / BITS_PER_LONG] |= mask;
+		else
+			map[start / BITS_PER_LONG] &= ~mask;
+
+		start += n;
+		nbits -= n;
+	}
+}
 
