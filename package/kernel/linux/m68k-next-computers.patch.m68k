+	.section .payload,"a"
+	.globl	payload_start, payload_end
+payload_start:
+	.incbin	VMLINUX_STRIP
+payload_end:
diff --git a/arch/m68k/next/config.c b/arch/m68k/next/config.c
new file mode 100644
index 000000000000..d3e6d2c44d91
--- /dev/null
+++ b/arch/m68k/next/config.c
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NeXT Computer, NeXTcube and NeXTstation machine setup
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/ioport.h>
+#include <linux/kernel.h>
+#include <linux/platform_device.h>
+#include <linux/string.h>
+
+#include <asm/bootinfo.h>
+#include <asm/byteorder.h>
+#include <asm/config.h>
+#include <asm/io.h>
+#include <asm/machdep.h>
+#include <asm/next.h>
+#include <asm/setup.h>
+
+#define SCC_CTRL_A	1
+#define SCC_CTRL_B	0
+#define SCC_DATA_A	3
+#define SCC_DATA_B	2
+
+#define C16_UNBLANK	0x04
+#define C16_CLEAR_INT	0x01
+
+#define ESP_CMD		3
+#define ESP_CMD_RESET	0x02
+
+unsigned long next_machine;
+EXPORT_SYMBOL(next_machine);
+unsigned long next_board_rev;
+u8 next_ethaddr[6];
+EXPORT_SYMBOL(next_ethaddr);
+
+extern const char next_rom_reset_stub[];
+
+int __init next_parse_bootinfo(const struct bi_record *record)
+{
+	const void *data = record->data;
+
+	switch (be16_to_cpu(record->tag)) {
+	case BI_NEXT_MACHINE:
+		next_machine = be32_to_cpup(data);
+		break;
+	case BI_NEXT_BOARD_REV:
+		next_board_rev = be32_to_cpup(data);
+		break;
+	case BI_NEXT_ETHADDR:
+		memcpy(next_ethaddr, data, sizeof(next_ethaddr));
+		break;
+	default:
+		return 1;
+	}
+	return 0;
+}
+
+static void next_get_model(char *model)
+{
+	static const char * const names[] = {
+		[NEXT_MACH_CUBE030]	= "NeXT Computer",
+		[NEXT_MACH_STATION]	= "NeXTstation",
+		[NEXT_MACH_CUBE]	= "NeXTcube",
+		[NEXT_MACH_COLOR]	= "NeXTstation Color",
+		[NEXT_MACH_TURBO]	= "NeXTstation Turbo",
+		[NEXT_MACH_TURBO_COLOR]	= "NeXTstation Turbo Color",
+		[NEXT_MACH_CUBE_TURBO]	= "NeXTcube Turbo",
+	};
+
+	if (next_machine < ARRAY_SIZE(names) && names[next_machine])
+		strcpy(model, names[next_machine]);
+	else
+		sprintf(model, "NeXT machine type %lu", next_machine);
+}
+
+static void next_reset(void)
+{
+	next_rom_reset(virt_to_phys((void *)next_rom_reset_stub));
+}
+
+/* Sources which the interrupt mask register cannot turn off */
+static void __init next_quiesce(void)
+{
+	out_8(next_dev(NEXT_ESP) + ESP_CMD, ESP_CMD_RESET);
+	if (next_machine == NEXT_MACH_COLOR)
+		out_8(next_dev(NEXT_C16_CMD), C16_UNBLANK | C16_CLEAR_INT);
+}
+
+static struct resource scc_a_rsrcs[] = {
+	DEFINE_RES_MEM(0, 1),
+	DEFINE_RES_MEM(0, 1),
+	DEFINE_RES_IRQ(IRQ_NEXT_SCC),
+};
+
+static struct resource scc_b_rsrcs[] = {
+	DEFINE_RES_MEM(0, 1),
+	DEFINE_RES_MEM(0, 1),
+	DEFINE_RES_IRQ(IRQ_NEXT_SCC),
+};
+
+static void __init next_scc_setup(void)
+{
+	unsigned long scc = (unsigned long)next_dev(NEXT_SCC);
+
+	/* PCLK and both baud rate sources from the 3.6864 MHz oscillator */
+	out_8(next_dev(NEXT_SCC_CLK), 0);
+
+	scc_a_rsrcs[0].start = scc_a_rsrcs[0].end = scc + SCC_CTRL_A;
+	scc_a_rsrcs[1].start = scc_a_rsrcs[1].end = scc + SCC_DATA_A;
+	scc_a_pdev.resource = scc_a_rsrcs;
+	scc_a_pdev.num_resources = ARRAY_SIZE(scc_a_rsrcs);
+
+	scc_b_rsrcs[0].start = scc_b_rsrcs[0].end = scc + SCC_CTRL_B;
+	scc_b_rsrcs[1].start = scc_b_rsrcs[1].end = scc + SCC_DATA_B;
+	scc_b_pdev.resource = scc_b_rsrcs;
+	scc_b_pdev.num_resources = ARRAY_SIZE(scc_b_rsrcs);
+}
+
+void __init config_next(void)
+{
+	next_quiesce();
+	next_scc_setup();
+
+	mach_sched_init	= next_sched_init;
+	mach_init_IRQ	= next_init_IRQ;
+	mach_get_model	= next_get_model;
+	mach_reset	= next_reset;
+}
+
+static unsigned long __init next_fb_base(void)
+{
+	if (next_is_turbo())
+		return NEXT_TURBO_VRAM;
+	return next_is_color() ? NEXT_COLOR_VRAM : NEXT_MONO_VRAM;
+}
+
+static int __init next_platform_init(void)
+{
+	struct resource fb = DEFINE_RES_MEM(next_fb_base(), NEXT_VRAM_SIZE);
+	struct resource kbd[] = {
+		DEFINE_RES_MEM(NEXT_IO_PHYS + NEXT_MON, 0x10),
+		DEFINE_RES_IRQ(IRQ_NEXT_KEYMOUSE),
+	};
+
+	if (!MACH_IS_NEXT)
+		return -ENODEV;
+
+	platform_device_register(&scc_a_pdev);
+	platform_device_register(&scc_b_pdev);
+	platform_device_register_simple("nextfb", -1, &fb, 1);
+	platform_device_register_simple("nextkbd", -1, kbd, ARRAY_SIZE(kbd));
+
+	return 0;
+}
+arch_initcall(next_platform_init);
diff --git a/arch/m68k/next/ints.c b/arch/m68k/next/ints.c
new file mode 100644
index 000000000000..5396f10a7424
--- /dev/null
+++ b/arch/m68k/next/ints.c
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NeXT interrupt status and mask register handling
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+
+#include <asm/io.h>
+#include <asm/irq.h>
+#include <asm/next.h>
+
+#define NEXT_NR_IRQS	32
+
+/* Sources per CPU interrupt priority level, indexed by autovector */
+static const u32 next_level_mask[8] = {
+	[1] = 0x00000001,
+	[2] = 0x00000002,
+	[3] = 0x00003ffc,
+	[4] = 0x00004000,
+	[5] = 0x00038000,
+	[6] = 0x3ffc0000,
+	[7] = 0xc0000000,
+};
+
+static u32 next_irq_enabled;
+
+static void next_irq_write_mask(void)
+{
+	out_be32(next_io(NEXT_INTRMASK), next_irq_enabled);
+}
+
+static void next_irq_unmask(struct irq_data *d)
+{
+	next_irq_enabled |= BIT(d->irq - NEXT_IRQ_BASE);
+	next_irq_write_mask();
+}
+
+static void next_irq_mask(struct irq_data *d)
+{
+	next_irq_enabled &= ~BIT(d->irq - NEXT_IRQ_BASE);
+	next_irq_write_mask();
+}
+
+static struct irq_chip next_irq_chip = {
+	.name		= "next",
+	.irq_mask	= next_irq_mask,
+	.irq_unmask	= next_irq_unmask,
+};
+
+static void next_irq_demux(struct irq_desc *desc)
+{
+	unsigned int level = irq_desc_get_irq(desc);
+	u32 pending;
+
+	/* Some sources cannot be masked in hardware, consider only ours */
+	pending = in_be32(next_io(NEXT_INTRSTAT)) & next_level_mask[level] &
+		  next_irq_enabled;
+
+	while (pending) {
+		unsigned int bit = __fls(pending);
+
+		generic_handle_irq(NEXT_IRQ(bit));
+		pending &= ~BIT(bit);
+	}
+}
+
+void __init next_init_IRQ(void)
+{
+	unsigned int level;
+
+	next_irq_write_mask();
+	m68k_setup_irq_controller(&next_irq_chip, handle_simple_irq,
+				  NEXT_IRQ_BASE, NEXT_NR_IRQS);
+	for (level = 1; level < ARRAY_SIZE(next_level_mask); level++)
+		irq_set_chained_handler(IRQ_AUTO_1 + level - 1, next_irq_demux);
+}
diff --git a/arch/m68k/next/reset.S b/arch/m68k/next/reset.S
new file mode 100644
index 000000000000..04540896844e
--- /dev/null
+++ b/arch/m68k/next/reset.S
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Re-enter the NeXT boot ROM from the kernel with address translation off.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/linkage.h>
+#include <asm/setup.h>
+
+#define TT040_RAM	0x0403c040	/* 0x04000000-0x07ffffff, uncached */
+#define TT030_RAM	0x04038507
+
+/* void next_rom_reset(unsigned long phys_stub) */
+ENTRY(next_rom_reset)
+	movew	#0x2700,%sr
+	movel	%sp@(4),%a0
+	movel	m68k_cputype,%d1
+	btst	#CPUB_68040,%d1
+	jeq	1f
+
+	.chip	68040
+	cpusha	%bc
+	movel	#TT040_RAM,%d0
+	movec	%d0,%itt0
+	movec	%d0,%dtt0
+	nop
+	moveq	#0,%d0
+	movec	%d0,%cacr
+	cinva	%bc
+	.chip	68k
+	jmp	%a0@
+
+1:	.chip	68030
+	movel	#TT030_RAM,%sp@-
+	pmove	%sp@,%tt0
+	addql	#4,%sp
+	moveq	#0,%d0
+	movec	%d0,%cacr
+	.chip	68k
+	jmp	%a0@
+
+	/* Runs at its physical address, PC relative only */
+GLOBAL(next_rom_reset_stub)
+	btst	#CPUB_68040,%d1
+	jeq	2f
+
+	moveq	#0,%d0
+	.chip	68040
+	movec	%d0,%tc
+	nop
+	pflusha
+	movec	%d0,%itt0
+	movec	%d0,%dtt0
+	.chip	68k
+	jra	3f
+
+2:	.chip	68030
+	clrl	%sp@-
+	pmove	%sp@,%tc
+	pflusha
+	pmove	%sp@,%tt0
+	.chip	68k
+
+3:	movel	0x01000000,%sp
+	movel	0x01000004,%a0
+	jmp	%a0@
diff --git a/arch/m68k/next/time.c b/arch/m68k/next/time.c
new file mode 100644
index 000000000000..e50d194ab335
--- /dev/null
+++ b/arch/m68k/next/time.c
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NeXT system timer: periodic hardclock and free running event counter
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/clocksource.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/timex.h>
+
+#include <asm/io.h>
+#include <asm/next.h>
+
+#define TIMER_ENABLE	0x80
+#define TIMER_LATCH	0x40
+
+#define TIMER_HZ	1000000
+#define TIMER_PERIOD	(TIMER_HZ / HZ)
+
+static u64 next_read_clk(struct clocksource *cs)
+{
+	return in_be32(next_dev(NEXT_EVENTC)) & 0xfffff;
+}
+
+static struct clocksource next_clk = {
+	.name	= "eventc",
+	.rating	= 250,
+	.read	= next_read_clk,
+	.mask	= CLOCKSOURCE_MASK(20),
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+};
+
+static irqreturn_t next_timer_interrupt(int irq, void *dev_id)
+{
+	/* Reading the control register acknowledges the interrupt */
+	in_8(next_dev(NEXT_TIMER_CSR));
+	legacy_timer_tick(1);
+	return IRQ_HANDLED;
+}
+
+void __init next_sched_init(void)
+{
+	void __iomem *timer = next_dev(NEXT_TIMER);
+
+	out_8(next_dev(NEXT_TIMER_CSR), 0);
+	if (request_irq(IRQ_NEXT_TIMER, next_timer_interrupt, IRQF_TIMER,
+			"timer", NULL))
+		pr_err("Could not allocate timer IRQ\n");
+
+	out_8(timer, TIMER_PERIOD >> 8);
+	out_8(timer + 1, TIMER_PERIOD & 0xff);
+	out_8(next_dev(NEXT_TIMER_CSR), TIMER_ENABLE | TIMER_LATCH);
+
+	clocksource_register_hz(&next_clk, TIMER_HZ);
+}
-- 
2.54.0


From 42d3b124e0128777f7401720592f2c4bb6543cd4 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 00:40:10 +0100
Subject: [PATCH 02/35] serial: pmac_zilog: Support the NeXT Z8530 register
 layout
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

NeXT machines place the Z8530 data registers two bytes after the control
registers, not four as on the Macintosh.  Take the data register from an
optional second memory resource and allow building for NEXT.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/tty/serial/Kconfig      | 2 +-
 drivers/tty/serial/pmac_zilog.c | 6 ++++--
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/drivers/tty/serial/Kconfig b/drivers/tty/serial/Kconfig
index 3864cef711a6..80f6939a06c0 100644
--- a/drivers/tty/serial/Kconfig
+++ b/drivers/tty/serial/Kconfig
@@ -735,7 +735,7 @@ config SERIAL_MCF_CONSOLE
 
 config SERIAL_PMACZILOG
 	tristate "Mac or PowerMac z85c30 ESCC support"
-	depends on (M68K && MAC) || PPC_PMAC
+	depends on (M68K && (MAC || NEXT)) || PPC_PMAC
 	select SERIAL_CORE
 	help
 	  This driver supports the Zilog z85C30 serial ports found on
diff --git a/drivers/tty/serial/pmac_zilog.c b/drivers/tty/serial/pmac_zilog.c
index a612f1db9f18..27b05c275851 100644
--- a/drivers/tty/serial/pmac_zilog.c
+++ b/drivers/tty/serial/pmac_zilog.c
@@ -1619,12 +1619,13 @@ extern struct platform_device scc_a_pdev, scc_b_pdev;
 
 static int __init pmz_init_port(struct uart_pmac_port *uap)
 {
-	struct resource *r_ports;
+	struct resource *r_ports, *r_data;
 	int irq;
 
 	r_ports = platform_get_resource(uap->pdev, IORESOURCE_MEM, 0);
 	if (!r_ports)
 		return -ENODEV;
+	r_data = platform_get_resource(uap->pdev, IORESOURCE_MEM, 1);
 
 	irq = platform_get_irq(uap->pdev, 0);
 	if (irq < 0)
@@ -1641,7 +1642,8 @@ static int __init pmz_init_port(struct uart_pmac_port *uap)
 	uap->port.flags    = 0;
 
 	uap->control_reg   = uap->port.membase;
-	uap->data_reg      = uap->control_reg + 4;
+	uap->data_reg      = r_data ? (u8 __iomem *)r_data->start :
+				      uap->control_reg + 4;
 	uap->port_type     = 0;
 	uap->port.has_sysrq = IS_ENABLED(CONFIG_SERIAL_PMACZILOG_CONSOLE);
 
-- 
2.54.0


From 0d11916d5883f6da42c4f34bd9fe45b3fb8ccd61 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 00:40:11 +0100
Subject: [PATCH 03/35] fbdev: Add NeXT framebuffer driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The boot ROM sets up the built in 1120x832 display: 2 bpp grayscale where
pixel value 0 is white, or RGBX 4:4:4:4 on color models.  Non-Turbo models
have 32 hidden pixels per line.  fbcon assumes 0 is black, so the mono
drawing colors are inverted.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/video/fbdev/Kconfig  |  11 +++
 drivers/video/fbdev/Makefile |   1 +
 drivers/video/fbdev/nextfb.c | 157 +++++++++++++++++++++++++++++++++++
 3 files changed, 169 insertions(+)
 create mode 100644 drivers/video/fbdev/nextfb.c

diff --git a/drivers/video/fbdev/Kconfig b/drivers/video/fbdev/Kconfig
index e8cd8cb76874..ac862090d99a 100644
--- a/drivers/video/fbdev/Kconfig
+++ b/drivers/video/fbdev/Kconfig
@@ -198,6 +198,17 @@ config FB_Q40
 	default y
 	select FB_IOMEM_HELPERS
 
+config FB_NEXT
+	bool "NeXT framebuffer support"
+	depends on (FB = y) && NEXT
+	select FB_CFB_FILLRECT
+	select FB_CFB_COPYAREA
+	select FB_CFB_IMAGEBLIT
+	select FB_IOMEM_FOPS
+	help
+	  Support for the built in display of the NeXT computers: the 2 bpp
+	  grayscale NeXTcube and NeXTstation, and the 16 bpp NeXTstation Color.
+
 config FB_AMIGA
 	tristate "Amiga native chipset support"
 	depends on FB && AMIGA
diff --git a/drivers/video/fbdev/Makefile b/drivers/video/fbdev/Makefile
index 0b17c878154d..bb70b34e8f21 100644
--- a/drivers/video/fbdev/Makefile
+++ b/drivers/video/fbdev/Makefile
@@ -64,6 +64,7 @@ obj-$(CONFIG_FB_XVR2500)          += sunxvr2500.o
 obj-$(CONFIG_FB_XVR1000)          += sunxvr1000.o
 obj-$(CONFIG_FB_APOLLO)           += dnfb.o
 obj-$(CONFIG_FB_Q40)              += q40fb.o
+obj-$(CONFIG_FB_NEXT)             += nextfb.o
 obj-$(CONFIG_FB_TGA)              += tgafb.o
 obj-$(CONFIG_FB_HP300)            += hpfb.o
 obj-$(CONFIG_FB_G364)             += g364fb.o
diff --git a/drivers/video/fbdev/nextfb.c b/drivers/video/fbdev/nextfb.c
new file mode 100644
index 000000000000..1e734856e64e
--- /dev/null
+++ b/drivers/video/fbdev/nextfb.c
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * NeXT framebuffer: built in 1120x832 display, set up by the boot ROM.
+ * Monochrome models use 2 bpp grayscale, color models RGBX 4:4:4:4.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/fb.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include <asm/next.h>
+
+#define NEXTFB_WIDTH	1120
+#define NEXTFB_HEIGHT	832
+/* Non-Turbo models keep 32 hidden pixels at the end of each line */
+#define NEXTFB_PITCH(turbo)	((turbo) ? NEXTFB_WIDTH : NEXTFB_WIDTH + 32)
+#define MONO_INVERT	3
+
+struct nextfb_par {
+	u32 palette[16];
+};
+
+static int nextfb_setcolreg(unsigned int regno, unsigned int red,
+			    unsigned int green, unsigned int blue,
+			    unsigned int transp, struct fb_info *info)
+{
+	if (info->var.bits_per_pixel == 2)
+		return regno > MONO_INVERT;
+	if (regno >= 16)
+		return 1;
+
+	((u32 *)info->pseudo_palette)[regno] =
+		((red >> 12) << 12) | ((green >> 12) << 8) | ((blue >> 12) << 4);
+	return 0;
+}
+
+/* fbcon assumes 0 is black, the monochrome display has 0 as white */
+static void nextfb_fillrect(struct fb_info *info, const struct fb_fillrect *rect)
+{
+	struct fb_fillrect r = *rect;
+
+	if (info->var.bits_per_pixel == 2)
+		r.color ^= MONO_INVERT;
+	cfb_fillrect(info, &r);
+}
+
+static void nextfb_imageblit(struct fb_info *info, const struct fb_image *image)
+{
+	struct fb_image im = *image;
+
+	if (info->var.bits_per_pixel == 2) {
+		im.fg_color ^= MONO_INVERT;
+		im.bg_color ^= MONO_INVERT;
+	}
+	cfb_imageblit(info, &im);
+}
+
+static const struct fb_ops nextfb_ops = {
+	.owner		= THIS_MODULE,
+	__FB_DEFAULT_IOMEM_OPS_RDWR,
+	.fb_setcolreg	= nextfb_setcolreg,
+	.fb_fillrect	= nextfb_fillrect,
+	.fb_copyarea	= cfb_copyarea,
+	.fb_imageblit	= nextfb_imageblit,
+	__FB_DEFAULT_IOMEM_OPS_MMAP,
+};
+
+static int nextfb_probe(struct platform_device *pdev)
+{
+	bool color = next_is_color(), turbo = next_is_turbo();
+	struct nextfb_par *par;
+	struct fb_info *info;
+	struct resource *res;
+	int ret;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -ENODEV;
+
+	info = framebuffer_alloc(sizeof(*par), &pdev->dev);
+	if (!info)
+		return -ENOMEM;
+	par = info->par;
+
+	strscpy(info->fix.id, "NeXT", sizeof(info->fix.id));
+	info->fix.type = FB_TYPE_PACKED_PIXELS;
+	info->fix.visual = color ? FB_VISUAL_TRUECOLOR : FB_VISUAL_STATIC_PSEUDOCOLOR;
+	info->fix.accel = FB_ACCEL_NONE;
+	info->fix.line_length = NEXTFB_PITCH(turbo) * (color ? 2 : 1);
+	if (!color)
+		info->fix.line_length /= 4;
+	info->fix.smem_start = res->start;
+	info->fix.smem_len = info->fix.line_length * NEXTFB_HEIGHT;
+
+	info->var.xres = info->var.xres_virtual = NEXTFB_WIDTH;
+	info->var.yres = info->var.yres_virtual = NEXTFB_HEIGHT;
+	info->var.bits_per_pixel = color ? 16 : 2;
+	info->var.activate = FB_ACTIVATE_NOW;
+	info->var.vmode = FB_VMODE_NONINTERLACED;
+	info->var.height = -1;
+	info->var.width = -1;
+	if (color) {
+		info->var.red = (struct fb_bitfield){ 12, 4, 0 };
+		info->var.green = (struct fb_bitfield){ 8, 4, 0 };
+		info->var.blue = (struct fb_bitfield){ 4, 4, 0 };
+	} else {
+		info->var.grayscale = 1;
+		info->var.red = (struct fb_bitfield){ 0, 2, 0 };
+		info->var.green = info->var.red;
+		info->var.blue = info->var.red;
+	}
+
+	info->fbops = &nextfb_ops;
+	info->pseudo_palette = par->palette;
+	info->screen_base = ioremap_wt(res->start, info->fix.smem_len);
+	if (!info->screen_base) {
+		ret = -ENOMEM;
+		goto err_release;
+	}
+
+	ret = fb_alloc_cmap(&info->cmap, color ? 16 : 4, 0);
+	if (ret)
+		goto err_unmap;
+
+	ret = register_framebuffer(info);
+	if (ret)
+		goto err_cmap;
+
+	platform_set_drvdata(pdev, info);
+	fb_info(info, "%s %dx%d, %d bpp\n", color ? "color" : "grayscale",
+		NEXTFB_WIDTH, NEXTFB_HEIGHT, info->var.bits_per_pixel);
+	return 0;
+
+err_cmap:
+	fb_dealloc_cmap(&info->cmap);
+err_unmap:
+	iounmap(info->screen_base);
+err_release:
+	framebuffer_release(info);
+	return ret;
+}
+
+static struct platform_driver nextfb_driver = {
+	.probe	= nextfb_probe,
+	.driver	= {
+		.name = "nextfb",
+	},
+};
+module_platform_driver(nextfb_driver);
+
+MODULE_DESCRIPTION("NeXT framebuffer driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 373332c665399763326c5d80e93f4139a9e3dfff Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 00:40:11 +0100
Subject: [PATCH 04/35] Input: Add NeXT keyboard and mouse driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Both devices share the display monitor interface and its data register.
Modifier keys are reported as state bits in every keyboard word instead of
as key codes, so changes are turned into key events here.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/input/keyboard/Kconfig   |  10 ++
 drivers/input/keyboard/Makefile  |   1 +
 drivers/input/keyboard/nextkbd.c | 204 +++++++++++++++++++++++++++++++
 3 files changed, 215 insertions(+)
 create mode 100644 drivers/input/keyboard/nextkbd.c

diff --git a/drivers/input/keyboard/Kconfig b/drivers/input/keyboard/Kconfig
index d8c64f333462..167895600ffe 100644
--- a/drivers/input/keyboard/Kconfig
+++ b/drivers/input/keyboard/Kconfig
@@ -446,6 +446,16 @@ config KEYBOARD_IMX_SC_KEY
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx_sc_key.
 
+config KEYBOARD_NEXT
+	tristate "NeXT keyboard and mouse"
+	depends on NEXT
+	help
+	  Say Y here if you want to use the keyboard and mouse connected to
+	  the display of a NeXT computer.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called nextkbd.
+
 config KEYBOARD_NEWTON
 	tristate "Newton keyboard"
 	select SERIO
diff --git a/drivers/input/keyboard/Makefile b/drivers/input/keyboard/Makefile
index 60bb7baf802f..395590c77633 100644
--- a/drivers/input/keyboard/Makefile
+++ b/drivers/input/keyboard/Makefile
@@ -47,6 +47,7 @@ obj-$(CONFIG_KEYBOARD_MPR121)		+= mpr121_touchkey.o
 obj-$(CONFIG_KEYBOARD_MT6779)		+= mt6779-keypad.o
 obj-$(CONFIG_KEYBOARD_MTK_PMIC) 	+= mtk-pmic-keys.o
 obj-$(CONFIG_KEYBOARD_NEWTON)		+= newtonkbd.o
+obj-$(CONFIG_KEYBOARD_NEXT)		+= nextkbd.o
 obj-$(CONFIG_KEYBOARD_NSPIRE)		+= nspire-keypad.o
 obj-$(CONFIG_KEYBOARD_OMAP)		+= omap-keypad.o
 obj-$(CONFIG_KEYBOARD_OMAP4)		+= omap4-keypad.o
diff --git a/drivers/input/keyboard/nextkbd.c b/drivers/input/keyboard/nextkbd.c
new file mode 100644
index 000000000000..4b701e2e0757
--- /dev/null
+++ b/drivers/input/keyboard/nextkbd.c
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * NeXT keyboard and mouse attached through the display monitor interface.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/bitops.h>
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+/* Keyboard/mouse status byte */
+#define KM_STAT		1
+#define KM_OVERRUN	0x20
+#define KM_RECEIVED	0x40
+
+#define KM_DATA		8
+
+/* Top byte of a data word */
+#define KM_ADDR_USER_POLL	0x20000000
+#define KM_ADDR_NO_RESPONSE	0x40000000
+#define KM_ADDR_MOUSE		0x01000000
+
+#define KBD_KEY_VALID	0x8000
+#define KBD_KEY_UP	0x0080
+#define KBD_KEY_MASK	0x007f
+#define KBD_MOD_SHIFT	8
+#define KBD_NR_MODS	7
+
+#define MOUSE_LEFT_UP	0x0001
+#define MOUSE_RIGHT_UP	0x0100
+
+static const unsigned short nextkbd_keycode[KBD_KEY_MASK + 1] = {
+	[0x01] = KEY_BRIGHTNESSDOWN,	[0x02] = KEY_VOLUMEDOWN,
+	[0x03] = KEY_BACKSLASH,		[0x04] = KEY_RIGHTBRACE,
+	[0x05] = KEY_LEFTBRACE,		[0x06] = KEY_I,
+	[0x07] = KEY_O,			[0x08] = KEY_P,
+	[0x09] = KEY_LEFT,		[0x0b] = KEY_KP0,
+	[0x0c] = KEY_KPDOT,		[0x0d] = KEY_KPENTER,
+	[0x0f] = KEY_DOWN,		[0x10] = KEY_RIGHT,
+	[0x11] = KEY_KP1,		[0x12] = KEY_KP4,
+	[0x13] = KEY_KP6,		[0x14] = KEY_KP3,
+	[0x15] = KEY_KPPLUS,		[0x16] = KEY_UP,
+	[0x17] = KEY_KP2,		[0x18] = KEY_KP5,
+	[0x19] = KEY_BRIGHTNESSUP,	[0x1a] = KEY_VOLUMEUP,
+	[0x1b] = KEY_BACKSPACE,		[0x1c] = KEY_EQUAL,
+	[0x1d] = KEY_MINUS,		[0x1e] = KEY_8,
+	[0x1f] = KEY_9,			[0x20] = KEY_0,
+	[0x21] = KEY_KP7,		[0x22] = KEY_KP8,
+	[0x23] = KEY_KP9,		[0x24] = KEY_KPMINUS,
+	[0x25] = KEY_KPASTERISK,	[0x26] = KEY_GRAVE,
+	[0x27] = KEY_KPEQUAL,		[0x28] = KEY_KPSLASH,
+	[0x2a] = KEY_ENTER,		[0x2b] = KEY_APOSTROPHE,
+	[0x2c] = KEY_SEMICOLON,		[0x2d] = KEY_L,
+	[0x2e] = KEY_COMMA,		[0x2f] = KEY_DOT,
+	[0x30] = KEY_SLASH,		[0x31] = KEY_Z,
+	[0x32] = KEY_X,			[0x33] = KEY_C,
+	[0x34] = KEY_V,			[0x35] = KEY_B,
+	[0x36] = KEY_M,			[0x37] = KEY_N,
+	[0x38] = KEY_SPACE,		[0x39] = KEY_A,
+	[0x3a] = KEY_S,			[0x3b] = KEY_D,
+	[0x3c] = KEY_F,			[0x3d] = KEY_G,
+	[0x3e] = KEY_K,			[0x3f] = KEY_J,
+	[0x40] = KEY_H,			[0x41] = KEY_TAB,
+	[0x42] = KEY_Q,			[0x43] = KEY_W,
+	[0x44] = KEY_E,			[0x45] = KEY_R,
+	[0x46] = KEY_U,			[0x47] = KEY_Y,
+	[0x48] = KEY_T,			[0x49] = KEY_ESC,
+	[0x4a] = KEY_1,			[0x4b] = KEY_2,
+	[0x4c] = KEY_3,			[0x4d] = KEY_4,
+	[0x4e] = KEY_7,			[0x4f] = KEY_6,
+	[0x50] = KEY_5,
+};
+
+/* Modifier state is reported in the data word instead of key codes */
+static const unsigned short nextkbd_modcode[KBD_NR_MODS] = {
+	KEY_LEFTCTRL, KEY_LEFTSHIFT, KEY_RIGHTSHIFT, KEY_LEFTMETA,
+	KEY_RIGHTMETA, KEY_LEFTALT, KEY_RIGHTALT,
+};
+
+struct nextkbd {
+	void __iomem *regs;
+	struct input_dev *kbd;
+	struct input_dev *mouse;
+	unsigned int mods;
+};
+
+static void nextkbd_key(struct nextkbd *nk, u32 data)
+{
+	unsigned int mods = (data >> KBD_MOD_SHIFT) & (BIT(KBD_NR_MODS) - 1);
+	unsigned int changed = mods ^ nk->mods;
+	unsigned int code = data & KBD_KEY_MASK;
+	int i;
+
+	for (i = 0; i < KBD_NR_MODS; i++)
+		if (changed & BIT(i))
+			input_report_key(nk->kbd, nextkbd_modcode[i], mods & BIT(i));
+	nk->mods = mods;
+
+	if (code && nextkbd_keycode[code])
+		input_report_key(nk->kbd, nextkbd_keycode[code], !(data & KBD_KEY_UP));
+	input_sync(nk->kbd);
+}
+
+/* Bits 1-7 and 9-15 hold signed motion, negative is right and down */
+static void nextkbd_mouse(struct nextkbd *nk, u32 data)
+{
+	input_report_rel(nk->mouse, REL_X, -sign_extend32((data >> 1) & 0x7f, 6));
+	input_report_rel(nk->mouse, REL_Y, -sign_extend32((data >> 9) & 0x7f, 6));
+	input_report_key(nk->mouse, BTN_LEFT, !(data & MOUSE_LEFT_UP));
+	input_report_key(nk->mouse, BTN_RIGHT, !(data & MOUSE_RIGHT_UP));
+	input_sync(nk->mouse);
+}
+
+static irqreturn_t nextkbd_interrupt(int irq, void *dev_id)
+{
+	struct nextkbd *nk = dev_id;
+	irqreturn_t ret = IRQ_NONE;
+	u8 stat;
+
+	while ((stat = in_8(nk->regs + KM_STAT)) & KM_RECEIVED) {
+		u32 data = in_be32(nk->regs + KM_DATA);
+
+		ret = IRQ_HANDLED;
+		if (stat & KM_OVERRUN)
+			out_8(nk->regs + KM_STAT, KM_OVERRUN);
+		if (data & (KM_ADDR_USER_POLL | KM_ADDR_NO_RESPONSE))
+			continue;
+
+		if (data & KM_ADDR_MOUSE)
+			nextkbd_mouse(nk, data);
+		else if (data & KBD_KEY_VALID)
+			nextkbd_key(nk, data);
+	}
+	return ret;
+}
+
+static int nextkbd_probe(struct platform_device *pdev)
+{
+	struct nextkbd *nk;
+	int i, irq, ret;
+
+	nk = devm_kzalloc(&pdev->dev, sizeof(*nk), GFP_KERNEL);
+	if (!nk)
+		return -ENOMEM;
+
+	nk->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(nk->regs))
+		return PTR_ERR(nk->regs);
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	nk->kbd = devm_input_allocate_device(&pdev->dev);
+	nk->mouse = devm_input_allocate_device(&pdev->dev);
+	if (!nk->kbd || !nk->mouse)
+		return -ENOMEM;
+
+	nk->kbd->name = "NeXT Keyboard";
+	nk->kbd->phys = "next/input0";
+	nk->kbd->id.bustype = BUS_HOST;
+	nk->kbd->evbit[0] = BIT_MASK(EV_KEY) | BIT_MASK(EV_REP);
+	nk->kbd->keycode = (void *)nextkbd_keycode;
+	nk->kbd->keycodesize = sizeof(nextkbd_keycode[0]);
+	nk->kbd->keycodemax = ARRAY_SIZE(nextkbd_keycode);
+	for (i = 0; i < ARRAY_SIZE(nextkbd_keycode); i++)
+		__set_bit(nextkbd_keycode[i], nk->kbd->keybit);
+	for (i = 0; i < ARRAY_SIZE(nextkbd_modcode); i++)
+		__set_bit(nextkbd_modcode[i], nk->kbd->keybit);
+	__clear_bit(KEY_RESERVED, nk->kbd->keybit);
+
+	nk->mouse->name = "NeXT Mouse";
+	nk->mouse->phys = "next/input1";
+	nk->mouse->id.bustype = BUS_HOST;
+	input_set_capability(nk->mouse, EV_REL, REL_X);
+	input_set_capability(nk->mouse, EV_REL, REL_Y);
+	input_set_capability(nk->mouse, EV_KEY, BTN_LEFT);
+	input_set_capability(nk->mouse, EV_KEY, BTN_RIGHT);
+
+	ret = input_register_device(nk->kbd);
+	if (ret)
+		return ret;
+	ret = input_register_device(nk->mouse);
+	if (ret)
+		return ret;
+
+	return devm_request_irq(&pdev->dev, irq, nextkbd_interrupt, 0,
+				"nextkbd", nk);
+}
+
+static struct platform_driver nextkbd_driver = {
+	.probe	= nextkbd_probe,
+	.driver	= {
+		.name = "nextkbd",
+	},
+};
+module_platform_driver(nextkbd_driver);
+
+MODULE_DESCRIPTION("NeXT keyboard and mouse driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From a433dd22e7f54b37029abe04643b586132c2f1dc Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 00:49:38 +0100
Subject: [PATCH 05/35] m68k: mm: Set min_low_pfn to the start of RAM on
 Motorola MMUs
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

min_low_pfn was derived from availmem, the end of memory allocated by
head.S.  The generic DMA code treats any RAM below min_low_pfn as not DMA
capable, so streaming mappings of freed init memory, which lies below
availmem, failed with "DMA addr ... overflow".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/mm/motorola.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/m68k/mm/motorola.c b/arch/m68k/mm/motorola.c
index f3efa0d13963..67eadc93cbc2 100644
--- a/arch/m68k/mm/motorola.c
+++ b/arch/m68k/mm/motorola.c
@@ -511,7 +511,7 @@ void __init paging_init(void)
 
 	high_memory = phys_to_virt(max_addr) + 1;
 
-	min_low_pfn = availmem >> PAGE_SHIFT;
+	min_low_pfn = PFN_DOWN(min_addr);
 	max_pfn = max_low_pfn = (max_addr >> PAGE_SHIFT) + 1;
 
 	/* Reserve kernel text/data/bss and the memory allocated in head.S */
-- 
2.54.0


From eb5315377dbfeff1fec0e5dd49fc56d65c597dd6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 00:49:38 +0100
Subject: [PATCH 06/35] scsi: Add NeXT NCR53C90 front end for esp_scsi
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The integrated DMA channel only transfers aligned 16 byte bursts.  Aligned
parts of a request use DMA directly, anything else goes through a bounce
buffer.  Data the channel still holds at the end of a read is drained with
the flush bit in the SCSI control register.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/next_defconfig |   4 +
 arch/m68k/include/asm/nextdma.h  |  82 +++++++++
 arch/m68k/next/config.c          |   3 +
 drivers/scsi/Kconfig             |   7 +
 drivers/scsi/Makefile            |   1 +
 drivers/scsi/next_esp.c          | 277 +++++++++++++++++++++++++++++++
 6 files changed, 374 insertions(+)
 create mode 100644 arch/m68k/include/asm/nextdma.h
 create mode 100644 drivers/scsi/next_esp.c

diff --git a/arch/m68k/configs/next_defconfig b/arch/m68k/configs/next_defconfig
index acec0bbce3c6..a1eb18969901 100644
--- a/arch/m68k/configs/next_defconfig
+++ b/arch/m68k/configs/next_defconfig
@@ -26,6 +26,10 @@ CONFIG_DEVTMPFS=y
 CONFIG_DEVTMPFS_MOUNT=y
 CONFIG_BLK_DEV=y
 CONFIG_BLK_DEV_LOOP=y
+CONFIG_BLK_DEV_SD=y
+CONFIG_SCSI=y
+CONFIG_SCSI_LOWLEVEL=y
+CONFIG_SCSI_NEXT_ESP=y
 CONFIG_SERIAL_PMACZILOG=y
 CONFIG_SERIAL_PMACZILOG_TTYS=y
 CONFIG_SERIAL_PMACZILOG_CONSOLE=y
diff --git a/arch/m68k/include/asm/nextdma.h b/arch/m68k/include/asm/nextdma.h
new file mode 100644
index 000000000000..e143fc509ad2
--- /dev/null
+++ b/arch/m68k/include/asm/nextdma.h
@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * NeXT integrated channel DMA controller
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef _ASM_M68K_NEXTDMA_H
+#define _ASM_M68K_NEXTDMA_H
+
+#include <asm/io.h>
+#include <asm/next.h>
+
+/* Channels by their control register offset in I/O space */
+#define NEXTDMA_SCSI		0x010
+#define NEXTDMA_SOUND_OUT	0x040
+#define NEXTDMA_DISK		0x050
+#define NEXTDMA_SOUND_IN	0x080
+#define NEXTDMA_PRINTER		0x090
+#define NEXTDMA_ENET_TX		0x110
+#define NEXTDMA_ENET_RX		0x150
+
+/* Status */
+#define NEXTDMA_ENABLE		0x01000000
+#define NEXTDMA_SUPDATE		0x02000000
+#define NEXTDMA_COMPLETE	0x08000000
+#define NEXTDMA_BUSEXC		0x10000000
+/* Commands */
+#define NEXTDMA_SETENABLE	0x00010000
+#define NEXTDMA_SETSUPDATE	0x00020000
+#define NEXTDMA_M2DEV		0x00000000
+#define NEXTDMA_DEV2M		0x00040000
+#define NEXTDMA_CLRCOMPLETE	0x00080000
+#define NEXTDMA_RESET		0x00100000
+#define NEXTDMA_INITBUF		0x00200000
+#define NEXTDMA_INITBUF_TURBO	0x00800000
+
+/* Offsets from the current address register */
+#define NEXTDMA_REG_SAVED_LIMIT	(-0x0c)
+#define NEXTDMA_REG_NEXT	0x00
+#define NEXTDMA_REG_LIMIT	0x04
+#define NEXTDMA_REG_START	0x08
+#define NEXTDMA_REG_STOP	0x0c
+/* Next address which also initializes the channel buffer */
+#define NEXTDMA_REG_INITBUF	0x200
+
+/* The controller transfers 16 byte bursts on aligned addresses */
+#define NEXTDMA_ALIGN		16
+
+static inline void nextdma_csr_write(unsigned int chan, u32 val)
+{
+	out_be32(next_io(chan), val);
+}
+
+static inline u32 nextdma_csr_read(unsigned int chan)
+{
+	return in_be32(next_io(chan));
+}
+
+static inline void nextdma_reg_write(unsigned int chan, int reg, u32 val)
+{
+	out_be32(next_io(0x4000 + chan + reg), val);
+}
+
+static inline u32 nextdma_reg_read(unsigned int chan, int reg)
+{
+	return in_be32(next_io(0x4000 + chan + reg));
+}
+
+static inline u32 nextdma_initbuf(void)
+{
+	return next_is_turbo() ? NEXTDMA_INITBUF_TURBO : NEXTDMA_INITBUF;
+}
+
+/* Stop a channel and empty its internal buffer */
+static inline void nextdma_reset(unsigned int chan)
+{
+	nextdma_csr_write(chan, NEXTDMA_RESET | NEXTDMA_CLRCOMPLETE | nextdma_initbuf());
+	nextdma_csr_write(chan, 0);
+}
+
+#endif /* _ASM_M68K_NEXTDMA_H */
diff --git a/arch/m68k/next/config.c b/arch/m68k/next/config.c
index d3e6d2c44d91..85fdf2ee6999 100644
--- a/arch/m68k/next/config.c
+++ b/arch/m68k/next/config.c
@@ -145,6 +145,8 @@ static int __init next_platform_init(void)
 		DEFINE_RES_IRQ(IRQ_NEXT_KEYMOUSE),
 	};
 
+	struct resource esp = DEFINE_RES_IRQ(IRQ_NEXT_SCSI);
+
 	if (!MACH_IS_NEXT)
 		return -ENODEV;
 
@@ -152,6 +154,7 @@ static int __init next_platform_init(void)
 	platform_device_register(&scc_b_pdev);
 	platform_device_register_simple("nextfb", -1, &fb, 1);
 	platform_device_register_simple("nextkbd", -1, kbd, ARRAY_SIZE(kbd));
+	platform_device_register_simple("next_esp", -1, &esp, 1);
 
 	return 0;
 }
diff --git a/drivers/scsi/Kconfig b/drivers/scsi/Kconfig
index 1eec66195cf4..d3b4d0cdd893 100644
--- a/drivers/scsi/Kconfig
+++ b/drivers/scsi/Kconfig
@@ -1395,6 +1395,13 @@ config MAC_SCSI
 	  SCSI-HOWTO, available from
 	  <http://www.tldp.org/docs.html#howto>.
 
+config SCSI_NEXT_ESP
+	tristate "NeXT NCR53C90 SCSI"
+	depends on NEXT && SCSI
+	select SCSI_SPI_ATTRS
+	help
+	  This is the built in SCSI controller of the NeXT computers.
+
 config SCSI_MAC_ESP
 	tristate "Macintosh NCR53c9[46] SCSI"
 	depends on MAC && SCSI
diff --git a/drivers/scsi/Makefile b/drivers/scsi/Makefile
index 5b9328dc3b62..175ffe69b04e 100644
--- a/drivers/scsi/Makefile
+++ b/drivers/scsi/Makefile
@@ -61,6 +61,7 @@ obj-$(CONFIG_SGIWD93_SCSI)	+= sgiwd93.o	wd33c93.o
 obj-$(CONFIG_ATARI_SCSI)	+= atari_scsi.o
 obj-$(CONFIG_MAC_SCSI)		+= mac_scsi.o
 obj-$(CONFIG_SCSI_MAC_ESP)	+= esp_scsi.o	mac_esp.o
+obj-$(CONFIG_SCSI_NEXT_ESP)	+= esp_scsi.o	next_esp.o
 obj-$(CONFIG_SUN3_SCSI)		+= sun3_scsi.o  sun3_scsi_vme.o
 obj-$(CONFIG_MVME16x_SCSI)	+= 53c700.o	mvme16x_scsi.o
 obj-$(CONFIG_BVME6000_SCSI)	+= 53c700.o	bvme6000_scsi.o
diff --git a/drivers/scsi/next_esp.c b/drivers/scsi/next_esp.c
new file mode 100644
index 000000000000..193833ffaab5
--- /dev/null
+++ b/drivers/scsi/next_esp.c
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NeXT NCR53C90 SCSI front end for the esp_scsi core.
+ *
+ * The DMA channel transfers aligned 16 byte bursts.  Aligned parts of a
+ * request are transferred in place, anything else through a bounce buffer.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <scsi/scsi_host.h>
+
+#include <asm/next.h>
+#include <asm/nextdma.h>
+
+#include "esp_scsi.h"
+
+#define DRV_MODULE_NAME		"next_esp"
+#define PFX			DRV_MODULE_NAME ": "
+
+#define NEXT_ESP_CTRL		0x20
+#define ESPCTRL_CLK20MHZ	0x80
+#define ESPCTRL_ENABLE_INT	0x20
+#define ESPCTRL_MODE_DMA	0x10
+#define ESPCTRL_DMA_READ	0x08
+#define ESPCTRL_FLUSH		0x04
+#define ESPCTRL_RESET		0x02
+
+#define ESPCTRL_BASE		(ESPCTRL_CLK20MHZ | ESPCTRL_ENABLE_INT)
+
+#define NEXT_ESP_BOUNCE_SIZE	8192
+#define NEXT_ESP_MAX_XFER	0xfff0
+/* Worst case number of 4 byte flushes to empty the channel buffer */
+#define NEXT_ESP_FLUSH_COUNT	(NEXTDMA_ALIGN / 4)
+
+struct next_esp_priv {
+	void *bounce;
+	void *buf;
+	void *user;
+	dma_addr_t dma_addr;
+	u32 dma_len;
+	u32 xfer_len;
+	enum dma_data_direction dir;
+	bool mapped;
+	u8 ctrl;
+};
+
+#define esp_read8(REG)		next_esp_read8(esp, REG)
+#define esp_write8(VAL, REG)	next_esp_write8(esp, VAL, REG)
+
+static void next_esp_write8(struct esp *esp, u8 val, unsigned long reg)
+{
+	out_8(esp->regs + reg, val);
+}
+
+static u8 next_esp_read8(struct esp *esp, unsigned long reg)
+{
+	return in_8(esp->regs + reg);
+}
+
+static struct next_esp_priv *next_esp_priv(struct esp *esp)
+{
+	return dev_get_drvdata(esp->dev);
+}
+
+static void next_esp_ctrl(struct esp *esp, u8 val)
+{
+	out_8(esp->regs + NEXT_ESP_CTRL, val);
+}
+
+static int next_esp_irq_pending(struct esp *esp)
+{
+	return !!(in_8(esp->regs + ESP_STATUS) & ESP_STAT_INTR);
+}
+
+static u32 next_esp_dma_length_limit(struct esp *esp, u32 dma_addr, u32 dma_len)
+{
+	u32 aligned = min(dma_len, (u32)NEXT_ESP_MAX_XFER) & ~(NEXTDMA_ALIGN - 1);
+
+	if (!(dma_addr & (NEXTDMA_ALIGN - 1)) && aligned)
+		return aligned;
+	return min(dma_len, (u32)NEXT_ESP_BOUNCE_SIZE);
+}
+
+static void next_esp_reset_dma(struct esp *esp)
+{
+	struct next_esp_priv *priv = next_esp_priv(esp);
+
+	nextdma_reset(NEXTDMA_SCSI);
+	priv->ctrl = ESPCTRL_BASE;
+	next_esp_ctrl(esp, priv->ctrl);
+}
+
+/* Move bytes the channel holds back at the end of a device to memory transfer */
+static void next_esp_dma_drain(struct esp *esp)
+{
+	struct next_esp_priv *priv = next_esp_priv(esp);
+	int i;
+
+	if (!priv->mapped)
+		return;
+
+	for (i = 0; i < NEXT_ESP_FLUSH_COUNT; i++) {
+		next_esp_ctrl(esp, priv->ctrl | ESPCTRL_FLUSH);
+		next_esp_ctrl(esp, priv->ctrl);
+	}
+}
+
+static void next_esp_dma_invalidate(struct esp *esp)
+{
+	struct next_esp_priv *priv = next_esp_priv(esp);
+	u32 residual = 0;
+
+	if (!priv->mapped)
+		return;
+	priv->mapped = false;
+
+	if (!(esp->sreg & ESP_STAT_TCNT))
+		residual = esp_read8(ESP_TCLOW) | (esp_read8(ESP_TCMED) << 8);
+	residual = min(residual, priv->xfer_len);
+
+	nextdma_reset(NEXTDMA_SCSI);
+	priv->ctrl = ESPCTRL_BASE;
+	next_esp_ctrl(esp, priv->ctrl);
+
+	dma_unmap_single(esp->dev, priv->dma_addr, priv->dma_len, priv->dir);
+	if (priv->buf == priv->bounce && priv->dir == DMA_FROM_DEVICE)
+		memcpy(priv->user, priv->bounce, priv->xfer_len - residual);
+}
+
+static void next_esp_send_dma_cmd(struct esp *esp, u32 addr, u32 esp_count,
+				  u32 dma_count, int write, u8 cmd)
+{
+	struct next_esp_priv *priv = next_esp_priv(esp);
+	void *user = (void *)addr;
+
+	/* The core derives the residual from the ESP transfer counter */
+	esp->send_cmd_error = 0;
+	esp->send_cmd_residual = 0;
+	priv->user = user;
+	priv->xfer_len = esp_count;
+	priv->dir = write ? DMA_FROM_DEVICE : DMA_TO_DEVICE;
+
+	if ((addr | esp_count) & (NEXTDMA_ALIGN - 1)) {
+		priv->buf = priv->bounce;
+		priv->dma_len = ALIGN(esp_count, NEXTDMA_ALIGN);
+		if (!write)
+			memcpy(priv->buf, user, esp_count);
+	} else {
+		priv->buf = user;
+		priv->dma_len = esp_count;
+	}
+
+	priv->dma_addr = dma_map_single(esp->dev, priv->buf, priv->dma_len, priv->dir);
+	if (dma_mapping_error(esp->dev, priv->dma_addr)) {
+		esp->send_cmd_error = 1;
+		return;
+	}
+	priv->mapped = true;
+
+	esp_write8(esp_count & 0xff, ESP_TCLOW);
+	esp_write8((esp_count >> 8) & 0xff, ESP_TCMED);
+
+	priv->ctrl = ESPCTRL_BASE | ESPCTRL_MODE_DMA | (write ? ESPCTRL_DMA_READ : 0);
+	next_esp_ctrl(esp, priv->ctrl);
+
+	nextdma_reset(NEXTDMA_SCSI);
+	nextdma_reg_write(NEXTDMA_SCSI, NEXTDMA_REG_NEXT, priv->dma_addr);
+	nextdma_reg_write(NEXTDMA_SCSI, NEXTDMA_REG_LIMIT, priv->dma_addr + priv->dma_len);
+	nextdma_csr_write(NEXTDMA_SCSI, NEXTDMA_SETENABLE |
+			  (write ? NEXTDMA_DEV2M : NEXTDMA_M2DEV));
+
+	scsi_esp_cmd(esp, cmd);
+}
+
+static int next_esp_dma_error(struct esp *esp)
+{
+	return esp->send_cmd_error ||
+	       (nextdma_csr_read(NEXTDMA_SCSI) & NEXTDMA_BUSEXC);
+}
+
+static const struct esp_driver_ops next_esp_ops = {
+	.esp_write8		= next_esp_write8,
+	.esp_read8		= next_esp_read8,
+	.irq_pending		= next_esp_irq_pending,
+	.dma_length_limit	= next_esp_dma_length_limit,
+	.reset_dma		= next_esp_reset_dma,
+	.dma_drain		= next_esp_dma_drain,
+	.dma_invalidate		= next_esp_dma_invalidate,
+	.send_dma_cmd		= next_esp_send_dma_cmd,
+	.dma_error		= next_esp_dma_error,
+};
+
+static int next_esp_probe(struct platform_device *pdev)
+{
+	struct next_esp_priv *priv;
+	struct Scsi_Host *host;
+	struct esp *esp;
+	int irq, err;
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	err = dma_coerce_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (err)
+		return err;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	priv->bounce = devm_kmalloc(&pdev->dev, NEXT_ESP_BOUNCE_SIZE, GFP_KERNEL);
+	if (!priv->bounce)
+		return -ENOMEM;
+
+	host = scsi_host_alloc(&scsi_esp_template, sizeof(struct esp));
+	if (!host)
+		return -ENOMEM;
+
+	host->max_id = 8;
+	esp = shost_priv(host);
+	esp->host = host;
+	esp->dev = &pdev->dev;
+	esp->ops = &next_esp_ops;
+	esp->regs = next_dev(NEXT_ESP);
+	esp->cfreq = 20000000;
+	esp->flags = ESP_FLAG_USE_FIFO | ESP_FLAG_NO_DMA_MAP | ESP_FLAG_DISABLE_SYNC;
+	esp->scsi_id = 7;
+	host->this_id = esp->scsi_id;
+	esp->scsi_id_mask = 1 << esp->scsi_id;
+	host->irq = irq;
+
+	esp->command_block = devm_kzalloc(&pdev->dev, 16, GFP_KERNEL);
+	if (!esp->command_block) {
+		err = -ENOMEM;
+		goto err_put;
+	}
+	esp->command_block_dma = (dma_addr_t)esp->command_block;
+
+	platform_set_drvdata(pdev, priv);
+
+	next_esp_ctrl(esp, ESPCTRL_CLK20MHZ | ESPCTRL_RESET);
+	next_esp_ctrl(esp, ESPCTRL_CLK20MHZ);
+	next_esp_reset_dma(esp);
+
+	err = request_irq(irq, scsi_esp_intr, 0, DRV_MODULE_NAME, esp);
+	if (err)
+		goto err_put;
+
+	err = scsi_esp_register(esp);
+	if (err)
+		goto err_irq;
+
+	return 0;
+
+err_irq:
+	free_irq(irq, esp);
+err_put:
+	scsi_host_put(host);
+	return err;
+}
+
+static struct platform_driver next_esp_driver = {
+	.probe	= next_esp_probe,
+	.driver	= {
+		.name = DRV_MODULE_NAME,
+	},
+};
+module_platform_driver(next_esp_driver);
+
+MODULE_DESCRIPTION("NeXT NCR53C90 SCSI driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From bb2d5dc908bacd7a384c3f171cf8ae1495292051 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 00:53:05 +0100
Subject: [PATCH 07/35] net: Add NeXT built in Ethernet driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Fujitsu MB8795, or its Turbo chipset equivalent, uses separate DMA
channels for receive and transmit.  Receive chains between two aligned
buffers, the interrupt handler copies a finished one out and chains it
again.  Transmit uses one aligned buffer, on non-Turbo models with the
limit register moved past the frame, as their channel stops 15 bytes early.

The connector is detected through the BMAP chip, or the Turbo control
register.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/next_defconfig   |   4 +
 arch/m68k/next/config.c            |   1 +
 drivers/net/ethernet/Kconfig       |   1 +
 drivers/net/ethernet/Makefile      |   1 +
 drivers/net/ethernet/next/Kconfig  |  21 ++
 drivers/net/ethernet/next/Makefile |   2 +
 drivers/net/ethernet/next/mb8795.c | 403 +++++++++++++++++++++++++++++
 7 files changed, 433 insertions(+)
 create mode 100644 drivers/net/ethernet/next/Kconfig
 create mode 100644 drivers/net/ethernet/next/Makefile
 create mode 100644 drivers/net/ethernet/next/mb8795.c

diff --git a/arch/m68k/configs/next_defconfig b/arch/m68k/configs/next_defconfig
index a1eb18969901..8c707c6a48b0 100644
--- a/arch/m68k/configs/next_defconfig
+++ b/arch/m68k/configs/next_defconfig
@@ -22,6 +22,8 @@ CONFIG_NET=y
 CONFIG_PACKET=y
 CONFIG_UNIX=y
 CONFIG_INET=y
+CONFIG_IP_PNP=y
+CONFIG_IP_PNP_DHCP=y
 CONFIG_DEVTMPFS=y
 CONFIG_DEVTMPFS_MOUNT=y
 CONFIG_BLK_DEV=y
@@ -30,6 +32,8 @@ CONFIG_BLK_DEV_SD=y
 CONFIG_SCSI=y
 CONFIG_SCSI_LOWLEVEL=y
 CONFIG_SCSI_NEXT_ESP=y
+CONFIG_NETDEVICES=y
+CONFIG_MB8795=y
 CONFIG_SERIAL_PMACZILOG=y
 CONFIG_SERIAL_PMACZILOG_TTYS=y
 CONFIG_SERIAL_PMACZILOG_CONSOLE=y
diff --git a/arch/m68k/next/config.c b/arch/m68k/next/config.c
index 85fdf2ee6999..fd524b642858 100644
--- a/arch/m68k/next/config.c
+++ b/arch/m68k/next/config.c
@@ -155,6 +155,7 @@ static int __init next_platform_init(void)
 	platform_device_register_simple("nextfb", -1, &fb, 1);
 	platform_device_register_simple("nextkbd", -1, kbd, ARRAY_SIZE(kbd));
 	platform_device_register_simple("next_esp", -1, &esp, 1);
+	platform_device_register_simple("mb8795", -1, NULL, 0);
 
 	return 0;
 }
diff --git a/drivers/net/ethernet/Kconfig b/drivers/net/ethernet/Kconfig
index c2b0161d0bec..9cdc527901b0 100644
--- a/drivers/net/ethernet/Kconfig
+++ b/drivers/net/ethernet/Kconfig
@@ -129,6 +129,7 @@ config FEALNX
 	  cards. <http://www.myson.com.tw/>
 
 source "drivers/net/ethernet/ni/Kconfig"
+source "drivers/net/ethernet/next/Kconfig"
 source "drivers/net/ethernet/natsemi/Kconfig"
 source "drivers/net/ethernet/nebula-matrix/Kconfig"
 source "drivers/net/ethernet/netronome/Kconfig"
diff --git a/drivers/net/ethernet/Makefile b/drivers/net/ethernet/Makefile
index a306dae23bcb..0ea9705c582f 100644
--- a/drivers/net/ethernet/Makefile
+++ b/drivers/net/ethernet/Makefile
@@ -70,6 +70,7 @@ obj-$(CONFIG_NET_VENDOR_NATSEMI) += natsemi/
 obj-$(CONFIG_NET_VENDOR_NEBULA_MATRIX) += nebula-matrix/
 obj-$(CONFIG_NET_VENDOR_NETRONOME) += netronome/
 obj-$(CONFIG_NET_VENDOR_NI) += ni/
+obj-$(CONFIG_NET_VENDOR_NEXT) += next/
 obj-$(CONFIG_NET_VENDOR_NVIDIA) += nvidia/
 obj-$(CONFIG_LPC_ENET) += nxp/
 obj-$(CONFIG_NET_VENDOR_OKI) += oki-semi/
diff --git a/drivers/net/ethernet/next/Kconfig b/drivers/net/ethernet/next/Kconfig
new file mode 100644
index 000000000000..e798368a2e31
--- /dev/null
+++ b/drivers/net/ethernet/next/Kconfig
@@ -0,0 +1,21 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config NET_VENDOR_NEXT
+	bool "NeXT devices"
+	default y
+	depends on NEXT
+	help
+	  If you have a network card belonging to this class, say Y.
+
+if NET_VENDOR_NEXT
+
+config MB8795
+	tristate "NeXT built in Ethernet (Fujitsu MB8795) support"
+	depends on NEXT
+	help
+	  Ethernet controller of the NeXT computers, with thin wire and on
+	  newer models twisted pair connectors.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called mb8795.
+
+endif # NET_VENDOR_NEXT
diff --git a/drivers/net/ethernet/next/Makefile b/drivers/net/ethernet/next/Makefile
new file mode 100644
index 000000000000..b1c3d986ecbe
--- /dev/null
+++ b/drivers/net/ethernet/next/Makefile
@@ -0,0 +1,2 @@
+# SPDX-License-Identifier: GPL-2.0-only
+obj-$(CONFIG_MB8795) += mb8795.o
diff --git a/drivers/net/ethernet/next/mb8795.c b/drivers/net/ethernet/next/mb8795.c
new file mode 100644
index 000000000000..fd67a297dbd8
--- /dev/null
+++ b/drivers/net/ethernet/next/mb8795.c
@@ -0,0 +1,403 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * NeXT built in Ethernet: Fujitsu MB8795, or an AT&T compatible on Turbo
+ * models, with receive and transmit on separate DMA channels.
+ *
+ * Receive alternates between two aligned buffers by DMA chaining, which the
+ * interrupt handler copies out.  Transmit sends from one aligned buffer.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/etherdevice.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/netdevice.h>
+#include <linux/platform_device.h>
+#include <linux/skbuff.h>
+
+#include <asm/next.h>
+#include <asm/nextdma.h>
+
+#define NEXT_ENET		0x00006000
+
+#define EN_TXSTAT		0
+#define EN_TXMASK		1
+#define EN_RXSTAT		2
+#define EN_RXMASK		3
+#define EN_TXMODE		4
+#define EN_RXMODE		5
+#define EN_RESET		6
+#define EN_CONTROL		6	/* Turbo, on read */
+#define EN_NODEID		8
+
+#define TXSTAT_16COLLS		0x02
+#define TXSTAT_CLEAR		0xff
+#define RXSTAT_CLEAR		0xff
+
+#define TXMODE_DIS_LOOP		0x02
+#define TXMODE_TURBO_ENABLE	0x80
+#define TXMODE_TURBO_TPE	0x04
+
+#define RXMODE_NORMAL		0x02
+#define RXMODE_PROMISC		0x03
+#define RXMODE_TURBO_ENABLE	0x80
+#define RXMODE_TURBO_OWN	0x02
+#define RXMODE_TURBO_ANY	0x01
+
+#define RESET_ON		0x80
+#define CONTROL_BADTPE		0x40
+
+/* 68040 non-Turbo connector selection in the BMAP chip */
+#define NEXT_BMAP_DRW		0x000c0034
+#define BMAP_TPE_RXSEL		0x80000000
+#define BMAP_TPE_ILBC		0x10000000
+
+/* The Turbo chipset saves the final receive address at a fixed location */
+#define TURBO_RX_SAVED_LIMIT	0x00004050
+
+/* DMA end of packet, and bits the channel adds to its addresses */
+#define DMA_EOP			0x80000000
+#define DMA_ADDR_MASK		0x3fffffff
+/* Non-Turbo transmit channels stop this many bytes before their limit */
+#define TX_LIMIT_SLOP		15
+
+#define MB8795_BUF_SIZE		ALIGN(ETH_FRAME_LEN + ETH_FCS_LEN + 32, NEXTDMA_ALIGN)
+#define MB8795_RX_BUFS		2
+#define MB8795_TX_TIMEOUT	(2 * HZ)
+
+struct mb8795_priv {
+	struct net_device *dev;
+	void __iomem *regs;
+	spinlock_t lock;
+
+	u8 *buf;
+	dma_addr_t buf_dma;
+	unsigned int rx_cur;
+	bool twisted_pair;
+};
+
+static u8 *mb8795_rx_buf(struct mb8795_priv *priv, unsigned int i)
+{
+	return priv->buf + i * MB8795_BUF_SIZE;
+}
+
+static dma_addr_t mb8795_rx_dma(struct mb8795_priv *priv, unsigned int i)
+{
+	return priv->buf_dma + i * MB8795_BUF_SIZE;
+}
+
+static u8 *mb8795_tx_buf(struct mb8795_priv *priv)
+{
+	return priv->buf + MB8795_RX_BUFS * MB8795_BUF_SIZE;
+}
+
+static dma_addr_t mb8795_tx_dma(struct mb8795_priv *priv)
+{
+	return priv->buf_dma + MB8795_RX_BUFS * MB8795_BUF_SIZE;
+}
+
+static void mb8795_select_media(struct mb8795_priv *priv)
+{
+	if (next_is_turbo()) {
+		u8 mode = TXMODE_TURBO_ENABLE | TXMODE_TURBO_TPE;
+
+		out_8(priv->regs + EN_TXMODE, mode);
+		priv->twisted_pair = !(in_8(priv->regs + EN_CONTROL) & CONTROL_BADTPE);
+		if (!priv->twisted_pair)
+			out_8(priv->regs + EN_TXMODE, TXMODE_TURBO_ENABLE);
+	} else if (next_machine != NEXT_MACH_CUBE030) {
+		void __iomem *drw = next_io(NEXT_BMAP_DRW);
+		u32 val = in_be32(drw);
+
+		priv->twisted_pair = val & BMAP_TPE_ILBC;
+		if (priv->twisted_pair)
+			val |= BMAP_TPE_RXSEL | BMAP_TPE_ILBC;
+		else
+			val &= ~(BMAP_TPE_RXSEL | BMAP_TPE_ILBC);
+		out_be32(drw, val);
+	}
+}
+
+static void mb8795_set_rx_mode(struct net_device *dev)
+{
+	struct mb8795_priv *priv = netdev_priv(dev);
+	bool promisc = dev->flags & IFF_PROMISC;
+	u8 mode;
+
+	if (next_is_turbo()) {
+		mode = RXMODE_TURBO_ENABLE | RXMODE_TURBO_OWN;
+		/* There is no multicast filter */
+		if (promisc || (dev->flags & IFF_ALLMULTI) || !netdev_mc_empty(dev))
+			mode |= RXMODE_TURBO_ANY;
+	} else {
+		mode = promisc ? RXMODE_PROMISC : RXMODE_NORMAL;
+	}
+	out_8(priv->regs + EN_RXMODE, mode);
+}
+
+static void mb8795_rx_start(struct mb8795_priv *priv)
+{
+	unsigned int next = (priv->rx_cur + 1) % MB8795_RX_BUFS;
+	dma_addr_t cur = mb8795_rx_dma(priv, priv->rx_cur);
+	dma_addr_t cont = mb8795_rx_dma(priv, next);
+
+	nextdma_reset(NEXTDMA_ENET_RX);
+	nextdma_reg_write(NEXTDMA_ENET_RX, NEXTDMA_REG_NEXT, cur);
+	nextdma_reg_write(NEXTDMA_ENET_RX, NEXTDMA_REG_LIMIT, cur + MB8795_BUF_SIZE);
+	nextdma_reg_write(NEXTDMA_ENET_RX, NEXTDMA_REG_START, cont);
+	nextdma_reg_write(NEXTDMA_ENET_RX, NEXTDMA_REG_STOP, cont + MB8795_BUF_SIZE);
+	nextdma_csr_write(NEXTDMA_ENET_RX, NEXTDMA_SETENABLE | NEXTDMA_SETSUPDATE |
+			  NEXTDMA_DEV2M);
+}
+
+static void mb8795_rx_packet(struct net_device *dev, u8 *data, unsigned int len)
+{
+	struct sk_buff *skb;
+
+	/* DMA restarts can produce zero length packets */
+	if (len < ETH_ZLEN || len > MB8795_BUF_SIZE) {
+		dev->stats.rx_length_errors++;
+		dev->stats.rx_errors++;
+		return;
+	}
+
+	skb = netdev_alloc_skb_ip_align(dev, len);
+	if (!skb) {
+		dev->stats.rx_dropped++;
+		return;
+	}
+	skb_put_data(skb, data, len);
+	skb->protocol = eth_type_trans(skb, dev);
+	dev->stats.rx_packets++;
+	dev->stats.rx_bytes += len;
+	netif_rx(skb);
+}
+
+static irqreturn_t mb8795_rx_interrupt(int irq, void *dev_id)
+{
+	struct net_device *dev = dev_id;
+	struct mb8795_priv *priv = netdev_priv(dev);
+	unsigned int cur = priv->rx_cur, next = (cur + 1) % MB8795_RX_BUFS;
+	u32 csr, end;
+
+	csr = nextdma_csr_read(NEXTDMA_ENET_RX);
+	if (!(csr & NEXTDMA_COMPLETE))
+		return IRQ_NONE;
+
+	if (next_is_turbo())
+		end = in_be32(next_io(TURBO_RX_SAVED_LIMIT));
+	else
+		end = nextdma_reg_read(NEXTDMA_ENET_RX, NEXTDMA_REG_SAVED_LIMIT);
+	end &= DMA_ADDR_MASK;
+
+	out_8(priv->regs + EN_RXSTAT, RXSTAT_CLEAR);
+
+	if (end > mb8795_rx_dma(priv, cur))
+		mb8795_rx_packet(dev, mb8795_rx_buf(priv, cur),
+				 end - mb8795_rx_dma(priv, cur) - ETH_FCS_LEN);
+
+	priv->rx_cur = next;
+
+	if (csr & NEXTDMA_ENABLE) {
+		/* The buffer just emptied becomes the next one in the chain */
+		nextdma_reg_write(NEXTDMA_ENET_RX, NEXTDMA_REG_START,
+				  mb8795_rx_dma(priv, cur));
+		nextdma_reg_write(NEXTDMA_ENET_RX, NEXTDMA_REG_STOP,
+				  mb8795_rx_dma(priv, cur) + MB8795_BUF_SIZE);
+		nextdma_csr_write(NEXTDMA_ENET_RX, NEXTDMA_CLRCOMPLETE |
+				  NEXTDMA_SETSUPDATE | NEXTDMA_DEV2M);
+	} else {
+		dev->stats.rx_fifo_errors++;
+		mb8795_rx_start(priv);
+	}
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t mb8795_tx_interrupt(int irq, void *dev_id)
+{
+	struct net_device *dev = dev_id;
+	struct mb8795_priv *priv = netdev_priv(dev);
+	u8 stat;
+
+	if (!(nextdma_csr_read(NEXTDMA_ENET_TX) & NEXTDMA_COMPLETE))
+		return IRQ_NONE;
+
+	nextdma_reset(NEXTDMA_ENET_TX);
+
+	stat = in_8(priv->regs + EN_TXSTAT);
+	out_8(priv->regs + EN_TXSTAT, TXSTAT_CLEAR);
+	if (stat & TXSTAT_16COLLS) {
+		dev->stats.tx_errors++;
+		dev->stats.tx_aborted_errors++;
+	} else {
+		dev->stats.tx_packets++;
+	}
+	netif_wake_queue(dev);
+	return IRQ_HANDLED;
+}
+
+static netdev_tx_t mb8795_start_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	struct mb8795_priv *priv = netdev_priv(dev);
+	dma_addr_t dma = mb8795_tx_dma(priv);
+	unsigned int len = max_t(unsigned int, skb->len, ETH_ZLEN);
+	u32 limit = dma + len;
+	u8 *buf = mb8795_tx_buf(priv);
+	unsigned long flags;
+
+	if (!next_is_turbo())
+		limit += TX_LIMIT_SLOP;
+
+	netif_stop_queue(dev);
+
+	memset(buf + skb->len, 0, len - skb->len);
+	skb_copy_from_linear_data(skb, buf, skb->len);
+	dev->stats.tx_bytes += skb->len;
+	dev_kfree_skb(skb);
+
+	spin_lock_irqsave(&priv->lock, flags);
+	nextdma_reset(NEXTDMA_ENET_TX);
+	nextdma_reg_write(NEXTDMA_ENET_TX, next_is_turbo() ? NEXTDMA_REG_NEXT :
+			  NEXTDMA_REG_INITBUF, dma);
+	nextdma_reg_write(NEXTDMA_ENET_TX, NEXTDMA_REG_LIMIT, limit | DMA_EOP);
+	nextdma_csr_write(NEXTDMA_ENET_TX, NEXTDMA_SETENABLE | NEXTDMA_M2DEV);
+	spin_unlock_irqrestore(&priv->lock, flags);
+
+	return NETDEV_TX_OK;
+}
+
+static void mb8795_tx_timeout(struct net_device *dev, unsigned int txqueue)
+{
+	dev->stats.tx_errors++;
+	nextdma_reset(NEXTDMA_ENET_TX);
+	netif_wake_queue(dev);
+}
+
+static void mb8795_hw_init(struct net_device *dev)
+{
+	struct mb8795_priv *priv = netdev_priv(dev);
+	int i;
+
+	out_8(priv->regs + EN_RESET, RESET_ON);
+	udelay(10);
+
+	out_8(priv->regs + EN_TXMASK, 0);
+	out_8(priv->regs + EN_RXMASK, 0);
+	out_8(priv->regs + EN_TXSTAT, TXSTAT_CLEAR);
+	out_8(priv->regs + EN_RXSTAT, RXSTAT_CLEAR);
+	if (!next_is_turbo())
+		out_8(priv->regs + EN_TXMODE, TXMODE_DIS_LOOP);
+	mb8795_select_media(priv);
+	mb8795_set_rx_mode(dev);
+
+	for (i = 0; i < ETH_ALEN; i++)
+		out_8(priv->regs + EN_NODEID + i, dev->dev_addr[i]);
+
+	out_8(priv->regs + EN_RESET, 0);
+}
+
+static int mb8795_open(struct net_device *dev)
+{
+	struct mb8795_priv *priv = netdev_priv(dev);
+	int err;
+
+	nextdma_reset(NEXTDMA_ENET_TX);
+	nextdma_reset(NEXTDMA_ENET_RX);
+
+	err = request_irq(IRQ_NEXT_ENET_RX_DMA, mb8795_rx_interrupt, 0, "mb8795 rx", dev);
+	if (err)
+		return err;
+	err = request_irq(IRQ_NEXT_ENET_TX_DMA, mb8795_tx_interrupt, 0, "mb8795 tx", dev);
+	if (err) {
+		free_irq(IRQ_NEXT_ENET_RX_DMA, dev);
+		return err;
+	}
+
+	priv->rx_cur = 0;
+	mb8795_rx_start(priv);
+	mb8795_hw_init(dev);
+
+	netdev_info(dev, "%s connector\n", priv->twisted_pair ? "twisted pair" : "thin wire");
+	netif_carrier_on(dev);
+	netif_start_queue(dev);
+	return 0;
+}
+
+static int mb8795_stop(struct net_device *dev)
+{
+	struct mb8795_priv *priv = netdev_priv(dev);
+
+	netif_stop_queue(dev);
+	out_8(priv->regs + EN_RESET, RESET_ON);
+	nextdma_reset(NEXTDMA_ENET_TX);
+	nextdma_reset(NEXTDMA_ENET_RX);
+	free_irq(IRQ_NEXT_ENET_TX_DMA, dev);
+	free_irq(IRQ_NEXT_ENET_RX_DMA, dev);
+	return 0;
+}
+
+static const struct net_device_ops mb8795_netdev_ops = {
+	.ndo_open		= mb8795_open,
+	.ndo_stop		= mb8795_stop,
+	.ndo_start_xmit		= mb8795_start_xmit,
+	.ndo_set_rx_mode	= mb8795_set_rx_mode,
+	.ndo_tx_timeout		= mb8795_tx_timeout,
+	.ndo_validate_addr	= eth_validate_addr,
+	.ndo_set_mac_address	= eth_mac_addr,
+};
+
+static int mb8795_probe(struct platform_device *pdev)
+{
+	struct mb8795_priv *priv;
+	struct net_device *dev;
+	int err;
+
+	err = dma_coerce_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (err)
+		return err;
+
+	dev = devm_alloc_etherdev(&pdev->dev, sizeof(*priv));
+	if (!dev)
+		return -ENOMEM;
+	SET_NETDEV_DEV(dev, &pdev->dev);
+
+	priv = netdev_priv(dev);
+	priv->dev = dev;
+	priv->regs = next_dev(NEXT_ENET);
+	spin_lock_init(&priv->lock);
+
+	priv->buf = dmam_alloc_coherent(&pdev->dev,
+					(MB8795_RX_BUFS + 1) * MB8795_BUF_SIZE,
+					&priv->buf_dma, GFP_KERNEL);
+	if (!priv->buf)
+		return -ENOMEM;
+
+	dev->netdev_ops = &mb8795_netdev_ops;
+	dev->watchdog_timeo = MB8795_TX_TIMEOUT;
+
+	if (is_valid_ether_addr(next_ethaddr))
+		eth_hw_addr_set(dev, next_ethaddr);
+	else
+		eth_hw_addr_random(dev);
+
+	err = devm_register_netdev(&pdev->dev, dev);
+	if (err)
+		return err;
+
+	netdev_info(dev, "NeXT Ethernet, address %pM\n", dev->dev_addr);
+	return 0;
+}
+
+static struct platform_driver mb8795_driver = {
+	.probe	= mb8795_probe,
+	.driver	= {
+		.name = "mb8795",
+	},
+};
+module_platform_driver(mb8795_driver);
+
+MODULE_DESCRIPTION("NeXT built in Ethernet driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 6eac645644abca0c1ac14b381ba0df8c1294302e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 00:57:03 +0100
Subject: [PATCH 08/35] ALSA: Add NeXT built in sound driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Sound goes through the display monitor interface on two DMA channels, which
are chained period by period through the ring buffer.  Output is 16 bit big
endian stereo at 44.1 kHz, or 22.05 kHz using the sample doubling of the
interface.  Input is the 8012 Hz mu-law microphone CODEC.

Volume, mute and de-emphasis are controlled through the monitor output port.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/next_defconfig |   5 +
 arch/m68k/next/config.c          |   1 +
 sound/Kconfig                    |   2 +
 sound/Makefile                   |   2 +-
 sound/m68k/Kconfig               |  24 ++
 sound/m68k/Makefile              |   4 +
 sound/m68k/next_snd.c            | 514 +++++++++++++++++++++++++++++++
 7 files changed, 551 insertions(+), 1 deletion(-)
 create mode 100644 sound/m68k/Kconfig
 create mode 100644 sound/m68k/Makefile
 create mode 100644 sound/m68k/next_snd.c

diff --git a/arch/m68k/configs/next_defconfig b/arch/m68k/configs/next_defconfig
index 8c707c6a48b0..afb364c605da 100644
--- a/arch/m68k/configs/next_defconfig
+++ b/arch/m68k/configs/next_defconfig
@@ -48,6 +48,11 @@ CONFIG_FONT_SUPPORT=y
 CONFIG_FONTS=y
 CONFIG_FONT_8x16=y
 CONFIG_LOGO=y
+CONFIG_SOUND=y
+CONFIG_SND=y
+CONFIG_SND_OSSEMUL=y
+CONFIG_SND_PCM_OSS=y
+CONFIG_SND_NEXT=y
 CONFIG_TMPFS=y
 CONFIG_EXT2_FS=y
 CONFIG_EXT4_FS=y
diff --git a/arch/m68k/next/config.c b/arch/m68k/next/config.c
index fd524b642858..27f31ec6519e 100644
--- a/arch/m68k/next/config.c
+++ b/arch/m68k/next/config.c
@@ -156,6 +156,7 @@ static int __init next_platform_init(void)
 	platform_device_register_simple("nextkbd", -1, kbd, ARRAY_SIZE(kbd));
 	platform_device_register_simple("next_esp", -1, &esp, 1);
 	platform_device_register_simple("mb8795", -1, NULL, 0);
+	platform_device_register_simple("next_snd", -1, NULL, 0);
 
 	return 0;
 }
diff --git a/sound/Kconfig b/sound/Kconfig
index 8b40205394fe..5d72bb52b00a 100644
--- a/sound/Kconfig
+++ b/sound/Kconfig
@@ -87,6 +87,8 @@ source "sound/pcmcia/Kconfig"
 
 source "sound/sparc/Kconfig"
 
+source "sound/m68k/Kconfig"
+
 source "sound/parisc/Kconfig"
 
 source "sound/soc/Kconfig"
diff --git a/sound/Makefile b/sound/Makefile
index 5942311a4232..7f005a3daa02 100644
--- a/sound/Makefile
+++ b/sound/Makefile
@@ -5,7 +5,7 @@
 obj-$(CONFIG_SOUND) += soundcore.o
 obj-$(CONFIG_DMASOUND) += oss/dmasound/
 obj-$(CONFIG_SND) += core/ i2c/ drivers/ isa/ pci/ ppc/ arm/ sh/ synth/ usb/ \
-	firewire/ sparc/ spi/ parisc/ pcmcia/ mips/ soc/ atmel/ hda/ x86/ xen/ \
+	firewire/ sparc/ m68k/ spi/ parisc/ pcmcia/ mips/ soc/ atmel/ hda/ x86/ xen/ \
 	virtio/
 obj-$(CONFIG_SND_AOA) += aoa/
 
diff --git a/sound/m68k/Kconfig b/sound/m68k/Kconfig
new file mode 100644
index 000000000000..f295a04c730c
--- /dev/null
+++ b/sound/m68k/Kconfig
@@ -0,0 +1,24 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# ALSA m68k drivers
+
+menuconfig SND_M68K
+	bool "m68k sound devices"
+	depends on M68K
+	default y
+	help
+	  Support for sound devices specific to m68k architectures.
+
+if SND_M68K
+
+config SND_NEXT
+	tristate "NeXT built in sound"
+	depends on NEXT
+	select SND_PCM
+	help
+	  Say Y here for the 16 bit stereo output and the 8 bit mu-law
+	  microphone input of the NeXT display monitor interface.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called snd-next.
+
+endif # SND_M68K
diff --git a/sound/m68k/Makefile b/sound/m68k/Makefile
new file mode 100644
index 000000000000..0fb280fa69cc
--- /dev/null
+++ b/sound/m68k/Makefile
@@ -0,0 +1,4 @@
+# SPDX-License-Identifier: GPL-2.0-only
+snd-next-y := next_snd.o
+
+obj-$(CONFIG_SND_NEXT) += snd-next.o
diff --git a/sound/m68k/next_snd.c b/sound/m68k/next_snd.c
new file mode 100644
index 000000000000..e47040c16d50
--- /dev/null
+++ b/sound/m68k/next_snd.c
@@ -0,0 +1,514 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * NeXT built in sound through the display monitor interface.
+ *
+ * Output is 16 bit big endian stereo at 44.1 kHz, or 22.05 kHz using the
+ * sample doubling of the interface.  Input is the 8012 Hz mu-law microphone
+ * CODEC.  Both directions have a DMA channel, which is chained period by
+ * period through the ring buffer.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+
+#include <sound/control.h>
+#include <sound/core.h>
+#include <sound/initval.h>
+#include <sound/pcm.h>
+
+#include <asm/next.h>
+#include <asm/nextdma.h>
+
+#define IRQ_SND_IN_DMA		NEXT_IRQ(22)
+#define IRQ_SND_OUT_DMA		NEXT_IRQ(23)
+
+/* Monitor interface */
+#define MON_SND_CTRL		0
+#define MON_TX			2
+#define MON_CMD			3
+#define MON_DATA		4
+
+#define SND_CTRL_OUT_ENABLE	0x80
+#define SND_CTRL_OUT_UNDERRUN	0x20
+#define SND_CTRL_IN_ENABLE	0x08
+#define SND_CTRL_IN_OVERRUN	0x02
+
+#define TX_CPU_BUSY		0x30
+
+#define CMD_SND_IN		0x03
+#define CMD_SND_OUT		0x07
+#define CMD_ENABLE		0x08
+#define CMD_DOUBLE		0x10
+#define CMD_CTRL_OUT		0xc4
+
+/* Volume control logic on the monitor output port */
+#define GPO_MUTE		0x10
+#define GPO_DEEMPHASIS		0x08
+#define GPO_CLOCK		0x04
+#define GPO_DATA		0x02
+#define GPO_STROBE		0x01
+
+#define VOL_START		0x700
+#define VOL_LEFT		0x40
+#define VOL_RIGHT		0x80
+#define VOL_BITS		11
+/* Attenuation in steps of 2 dB */
+#define VOL_MAX			43
+
+#define NEXT_SND_RATE		44100
+#define NEXT_SND_CODEC_RATE	8012
+#define NEXT_SND_BUFFER_MAX	(128 * 1024)
+
+#define NEXT_SND_NR_STREAMS	2
+
+struct next_snd;
+
+struct next_snd_stream {
+	struct next_snd *chip;
+	struct snd_pcm_substream *substream;
+	unsigned int channel;
+	unsigned int dir;
+	dma_addr_t buffer;
+	unsigned int period_bytes;
+	unsigned int periods;
+	unsigned int cur;
+	u8 cmd;
+	u8 enable;
+};
+
+struct next_snd {
+	struct snd_card *card;
+	void __iomem *mon;
+	/* Protects the monitor command port and stream state */
+	spinlock_t lock;
+	struct next_snd_stream streams[NEXT_SND_NR_STREAMS];
+	u8 ctrl;
+	int volume[2];
+	bool mute;
+	bool deemphasis;
+};
+
+static void next_snd_mon_cmd(struct next_snd *chip, u8 cmd, u32 data)
+{
+	int timeout = 1000;
+
+	while ((in_8(chip->mon + MON_TX) & TX_CPU_BUSY) && --timeout)
+		udelay(1);
+	out_8(chip->mon + MON_CMD, cmd);
+	out_be32(chip->mon + MON_DATA, data);
+}
+
+static void next_snd_gpo(struct next_snd *chip, u8 val)
+{
+	next_snd_mon_cmd(chip, CMD_CTRL_OUT, (u32)val << 24);
+}
+
+static u8 next_snd_gpo_base(struct next_snd *chip)
+{
+	return (chip->mute ? GPO_MUTE : 0) | (chip->deemphasis ? GPO_DEEMPHASIS : 0);
+}
+
+/* Shift one volume word into the control logic */
+static void next_snd_write_volume(struct next_snd *chip, unsigned int word)
+{
+	u8 base = next_snd_gpo_base(chip);
+	int i;
+
+	next_snd_gpo(chip, base);
+	for (i = VOL_BITS - 1; i >= 0; i--) {
+		u8 bit = (word >> i) & 1 ? GPO_DATA : 0;
+
+		next_snd_gpo(chip, base | bit);
+		next_snd_gpo(chip, base | bit | GPO_CLOCK);
+		next_snd_gpo(chip, base | bit);
+	}
+	next_snd_gpo(chip, base | GPO_STROBE);
+	next_snd_gpo(chip, base);
+}
+
+static void next_snd_update_mixer(struct next_snd *chip)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&chip->lock, flags);
+	next_snd_write_volume(chip, VOL_START | VOL_LEFT | (VOL_MAX - chip->volume[0]));
+	next_snd_write_volume(chip, VOL_START | VOL_RIGHT | (VOL_MAX - chip->volume[1]));
+	spin_unlock_irqrestore(&chip->lock, flags);
+}
+
+static dma_addr_t next_snd_period(struct next_snd_stream *s, unsigned int i)
+{
+	return s->buffer + i * s->period_bytes;
+}
+
+static void next_snd_chain(struct next_snd_stream *s, unsigned int i)
+{
+	dma_addr_t addr = next_snd_period(s, i);
+
+	nextdma_reg_write(s->channel, NEXTDMA_REG_START, addr);
+	nextdma_reg_write(s->channel, NEXTDMA_REG_STOP, addr + s->period_bytes);
+}
+
+static irqreturn_t next_snd_interrupt(int irq, void *dev_id)
+{
+	struct next_snd_stream *s = dev_id;
+	struct next_snd *chip = s->chip;
+	struct snd_pcm_substream *substream;
+	u32 csr;
+
+	spin_lock(&chip->lock);
+	csr = nextdma_csr_read(s->channel);
+	if (!(csr & NEXTDMA_COMPLETE)) {
+		spin_unlock(&chip->lock);
+		return IRQ_NONE;
+	}
+
+	substream = s->substream;
+	if (!substream) {
+		nextdma_reset(s->channel);
+		spin_unlock(&chip->lock);
+		return IRQ_HANDLED;
+	}
+
+	s->cur = (s->cur + 1) % s->periods;
+	if (csr & NEXTDMA_ENABLE) {
+		next_snd_chain(s, (s->cur + 1) % s->periods);
+		nextdma_csr_write(s->channel, NEXTDMA_CLRCOMPLETE | NEXTDMA_SETSUPDATE | s->dir);
+	} else {
+		nextdma_reset(s->channel);
+		spin_unlock(&chip->lock);
+		snd_pcm_stop_xrun(substream);
+		return IRQ_HANDLED;
+	}
+	spin_unlock(&chip->lock);
+
+	snd_pcm_period_elapsed(substream);
+	return IRQ_HANDLED;
+}
+
+static const struct snd_pcm_hardware next_snd_playback_hw = {
+	.info			= SNDRV_PCM_INFO_MMAP | SNDRV_PCM_INFO_MMAP_VALID |
+				  SNDRV_PCM_INFO_INTERLEAVED |
+				  SNDRV_PCM_INFO_BLOCK_TRANSFER,
+	.formats		= SNDRV_PCM_FMTBIT_S16_BE,
+	.rates			= SNDRV_PCM_RATE_22050 | SNDRV_PCM_RATE_44100,
+	.rate_min		= 22050,
+	.rate_max		= NEXT_SND_RATE,
+	.channels_min		= 2,
+	.channels_max		= 2,
+	.buffer_bytes_max	= NEXT_SND_BUFFER_MAX,
+	.period_bytes_min	= 1024,
+	.period_bytes_max	= NEXT_SND_BUFFER_MAX / 2,
+	.periods_min		= 2,
+	.periods_max		= 128,
+};
+
+static const struct snd_pcm_hardware next_snd_capture_hw = {
+	.info			= SNDRV_PCM_INFO_MMAP | SNDRV_PCM_INFO_MMAP_VALID |
+				  SNDRV_PCM_INFO_INTERLEAVED |
+				  SNDRV_PCM_INFO_BLOCK_TRANSFER,
+	.formats		= SNDRV_PCM_FMTBIT_MU_LAW,
+	.rates			= SNDRV_PCM_RATE_KNOT,
+	.rate_min		= NEXT_SND_CODEC_RATE,
+	.rate_max		= NEXT_SND_CODEC_RATE,
+	.channels_min		= 1,
+	.channels_max		= 1,
+	.buffer_bytes_max	= NEXT_SND_BUFFER_MAX,
+	.period_bytes_min	= 256,
+	.period_bytes_max	= NEXT_SND_BUFFER_MAX / 2,
+	.periods_min		= 2,
+	.periods_max		= 128,
+};
+
+static int next_snd_open(struct snd_pcm_substream *substream)
+{
+	struct next_snd *chip = snd_pcm_substream_chip(substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	int dir = substream->stream;
+	struct next_snd_stream *s = &chip->streams[dir];
+	unsigned long flags;
+
+	runtime->hw = dir == SNDRV_PCM_STREAM_PLAYBACK ?
+		next_snd_playback_hw : next_snd_capture_hw;
+
+	/* The channels transfer aligned bursts */
+	snd_pcm_hw_constraint_step(runtime, 0, SNDRV_PCM_HW_PARAM_PERIOD_BYTES,
+				   NEXTDMA_ALIGN);
+	snd_pcm_hw_constraint_step(runtime, 0, SNDRV_PCM_HW_PARAM_BUFFER_BYTES,
+				   NEXTDMA_ALIGN);
+	snd_pcm_hw_constraint_integer(runtime, SNDRV_PCM_HW_PARAM_PERIODS);
+
+	spin_lock_irqsave(&chip->lock, flags);
+	s->substream = substream;
+	spin_unlock_irqrestore(&chip->lock, flags);
+	return 0;
+}
+
+static int next_snd_close(struct snd_pcm_substream *substream)
+{
+	struct next_snd *chip = snd_pcm_substream_chip(substream);
+	unsigned long flags;
+
+	spin_lock_irqsave(&chip->lock, flags);
+	chip->streams[substream->stream].substream = NULL;
+	spin_unlock_irqrestore(&chip->lock, flags);
+	return 0;
+}
+
+static int next_snd_prepare(struct snd_pcm_substream *substream)
+{
+	struct next_snd *chip = snd_pcm_substream_chip(substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct next_snd_stream *s = &chip->streams[substream->stream];
+	unsigned long flags;
+
+	spin_lock_irqsave(&chip->lock, flags);
+	s->buffer = runtime->dma_addr;
+	s->period_bytes = snd_pcm_lib_period_bytes(substream);
+	s->periods = runtime->periods;
+	s->cur = 0;
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK)
+		s->cmd = CMD_SND_OUT | (runtime->rate == NEXT_SND_RATE ? 0 : CMD_DOUBLE);
+	else
+		s->cmd = CMD_SND_IN;
+	nextdma_reset(s->channel);
+	spin_unlock_irqrestore(&chip->lock, flags);
+	return 0;
+}
+
+static void next_snd_start(struct next_snd *chip, struct next_snd_stream *s)
+{
+	dma_addr_t addr = next_snd_period(s, 0);
+
+	nextdma_reset(s->channel);
+	nextdma_reg_write(s->channel, NEXTDMA_REG_NEXT, addr);
+	nextdma_reg_write(s->channel, NEXTDMA_REG_LIMIT, addr + s->period_bytes);
+	next_snd_chain(s, 1 % s->periods);
+	nextdma_csr_write(s->channel, NEXTDMA_SETENABLE | NEXTDMA_SETSUPDATE | s->dir);
+
+	chip->ctrl |= s->enable;
+	out_8(chip->mon + MON_SND_CTRL, chip->ctrl);
+	next_snd_mon_cmd(chip, s->cmd | CMD_ENABLE, 0);
+}
+
+static void next_snd_stop(struct next_snd *chip, struct next_snd_stream *s)
+{
+	next_snd_mon_cmd(chip, s->cmd, 0);
+	chip->ctrl &= ~s->enable;
+	out_8(chip->mon + MON_SND_CTRL, chip->ctrl | SND_CTRL_OUT_UNDERRUN | SND_CTRL_IN_OVERRUN);
+	nextdma_reset(s->channel);
+}
+
+static int next_snd_trigger(struct snd_pcm_substream *substream, int cmd)
+{
+	struct next_snd *chip = snd_pcm_substream_chip(substream);
+	struct next_snd_stream *s = &chip->streams[substream->stream];
+	int err = 0;
+
+	spin_lock(&chip->lock);
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+		next_snd_start(chip, s);
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+		next_snd_stop(chip, s);
+		break;
+	default:
+		err = -EINVAL;
+		break;
+	}
+	spin_unlock(&chip->lock);
+	return err;
+}
+
+static snd_pcm_uframes_t next_snd_pointer(struct snd_pcm_substream *substream)
+{
+	struct next_snd *chip = snd_pcm_substream_chip(substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct next_snd_stream *s = &chip->streams[substream->stream];
+	u32 pos;
+
+	pos = nextdma_reg_read(s->channel, NEXTDMA_REG_NEXT) - s->buffer;
+	if (pos >= s->periods * s->period_bytes)
+		pos = s->cur * s->period_bytes;
+	return bytes_to_frames(runtime, pos);
+}
+
+static const struct snd_pcm_ops next_snd_ops = {
+	.open		= next_snd_open,
+	.close		= next_snd_close,
+	.prepare	= next_snd_prepare,
+	.trigger	= next_snd_trigger,
+	.pointer	= next_snd_pointer,
+};
+
+static int next_snd_vol_info(struct snd_kcontrol *kcontrol, struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 2;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = VOL_MAX;
+	return 0;
+}
+
+static int next_snd_vol_get(struct snd_kcontrol *kcontrol, struct snd_ctl_elem_value *ucontrol)
+{
+	struct next_snd *chip = snd_kcontrol_chip(kcontrol);
+
+	ucontrol->value.integer.value[0] = chip->volume[0];
+	ucontrol->value.integer.value[1] = chip->volume[1];
+	return 0;
+}
+
+static int next_snd_vol_put(struct snd_kcontrol *kcontrol, struct snd_ctl_elem_value *ucontrol)
+{
+	struct next_snd *chip = snd_kcontrol_chip(kcontrol);
+	int left = ucontrol->value.integer.value[0];
+	int right = ucontrol->value.integer.value[1];
+	int changed;
+
+	if (left < 0 || left > VOL_MAX || right < 0 || right > VOL_MAX)
+		return -EINVAL;
+	changed = left != chip->volume[0] || right != chip->volume[1];
+	chip->volume[0] = left;
+	chip->volume[1] = right;
+	if (changed)
+		next_snd_update_mixer(chip);
+	return changed;
+}
+
+static int next_snd_switch_get(struct snd_kcontrol *kcontrol, struct snd_ctl_elem_value *ucontrol)
+{
+	struct next_snd *chip = snd_kcontrol_chip(kcontrol);
+
+	ucontrol->value.integer.value[0] = kcontrol->private_value ? chip->deemphasis : !chip->mute;
+	return 0;
+}
+
+static int next_snd_switch_put(struct snd_kcontrol *kcontrol, struct snd_ctl_elem_value *ucontrol)
+{
+	struct next_snd *chip = snd_kcontrol_chip(kcontrol);
+	bool val = ucontrol->value.integer.value[0];
+	bool *state = kcontrol->private_value ? &chip->deemphasis : &chip->mute;
+	bool new = kcontrol->private_value ? val : !val;
+	int changed = *state != new;
+
+	*state = new;
+	if (changed)
+		next_snd_update_mixer(chip);
+	return changed;
+}
+
+static const struct snd_kcontrol_new next_snd_controls[] = {
+	{
+		.iface	= SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name	= "Master Playback Volume",
+		.info	= next_snd_vol_info,
+		.get	= next_snd_vol_get,
+		.put	= next_snd_vol_put,
+	},
+	{
+		.iface	= SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name	= "Master Playback Switch",
+		.info	= snd_ctl_boolean_mono_info,
+		.get	= next_snd_switch_get,
+		.put	= next_snd_switch_put,
+		.private_value = 0,
+	},
+	{
+		.iface	= SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name	= "De-emphasis Playback Switch",
+		.info	= snd_ctl_boolean_mono_info,
+		.get	= next_snd_switch_get,
+		.put	= next_snd_switch_put,
+		.private_value = 1,
+	},
+};
+
+static int next_snd_probe(struct platform_device *pdev)
+{
+	static const struct {
+		unsigned int channel, dir, irq;
+		u8 enable;
+	} cfg[NEXT_SND_NR_STREAMS] = {
+		[SNDRV_PCM_STREAM_PLAYBACK] = { NEXTDMA_SOUND_OUT, NEXTDMA_M2DEV,
+						IRQ_SND_OUT_DMA, SND_CTRL_OUT_ENABLE },
+		[SNDRV_PCM_STREAM_CAPTURE] = { NEXTDMA_SOUND_IN, NEXTDMA_DEV2M,
+					       IRQ_SND_IN_DMA, SND_CTRL_IN_ENABLE },
+	};
+	struct snd_card *card;
+	struct next_snd *chip;
+	struct snd_pcm *pcm;
+	int err, i;
+
+	err = dma_coerce_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (err)
+		return err;
+
+	err = snd_devm_card_new(&pdev->dev, SNDRV_DEFAULT_IDX1, SNDRV_DEFAULT_STR1,
+				THIS_MODULE, sizeof(*chip), &card);
+	if (err)
+		return err;
+
+	chip = card->private_data;
+	chip->card = card;
+	chip->mon = next_io(NEXT_MON);
+	spin_lock_init(&chip->lock);
+	chip->volume[0] = chip->volume[1] = VOL_MAX;
+
+	for (i = 0; i < NEXT_SND_NR_STREAMS; i++) {
+		struct next_snd_stream *s = &chip->streams[i];
+
+		s->chip = chip;
+		s->channel = cfg[i].channel;
+		s->dir = cfg[i].dir;
+		s->enable = cfg[i].enable;
+		nextdma_reset(s->channel);
+		err = devm_request_irq(&pdev->dev, cfg[i].irq, next_snd_interrupt, 0,
+				       "next_snd", s);
+		if (err)
+			return err;
+	}
+
+	strscpy(card->driver, "NeXT", sizeof(card->driver));
+	strscpy(card->shortname, "NeXT sound", sizeof(card->shortname));
+	strscpy(card->longname, "NeXT built in sound", sizeof(card->longname));
+
+	err = snd_pcm_new(card, "NeXT", 0, 1, 1, &pcm);
+	if (err)
+		return err;
+	pcm->private_data = chip;
+	strscpy(pcm->name, "NeXT", sizeof(pcm->name));
+	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_PLAYBACK, &next_snd_ops);
+	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_CAPTURE, &next_snd_ops);
+	snd_pcm_set_managed_buffer_all(pcm, SNDRV_DMA_TYPE_DEV, &pdev->dev,
+				       NEXT_SND_BUFFER_MAX, NEXT_SND_BUFFER_MAX);
+
+	for (i = 0; i < ARRAY_SIZE(next_snd_controls); i++) {
+		err = snd_ctl_add(card, snd_ctl_new1(&next_snd_controls[i], chip));
+		if (err)
+			return err;
+	}
+	next_snd_update_mixer(chip);
+
+	return snd_card_register(card);
+}
+
+static struct platform_driver next_snd_driver = {
+	.probe	= next_snd_probe,
+	.driver	= {
+		.name = "next_snd",
+	},
+};
+module_platform_driver(next_snd_driver);
+
+MODULE_DESCRIPTION("NeXT built in sound driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 69836039d9bfb0982922e0de787ab63797350a1a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 01:20:38 +0100
Subject: [PATCH 09/35] m68k: next: Support Turbo models and 68030 ROMs
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Take the machine type from the system control registers and the Ethernet
address from the ROM image.  mon_global of old 68030 ROMs is much shorter
than on later versions and the ROM is only mapped at address 0 there.

On Turbo the video interrupt shares the unmaskable disk interrupt line, so
turn it off along with all other sources the mask register cannot control,
which otherwise cause an interrupt storm at boot.

Round the memory chunk to 256 KB for the 68030: it is mapped in units of
this size, and map_node() runs away on any remainder.

Arguments at the ROM monitor are in the boot argument string after the boot
device, pass those on to the kernel.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/include/asm/next.h       |  3 +-
 arch/m68k/next/boot/main.c         | 51 +++++++++++++++++++++++-------
 arch/m68k/next/config.c            | 19 +++++++++--
 arch/m68k/next/reset.S             |  7 ++--
 drivers/net/ethernet/next/mb8795.c |  2 --
 5 files changed, 63 insertions(+), 19 deletions(-)

diff --git a/arch/m68k/include/asm/next.h b/arch/m68k/include/asm/next.h
index 23389fd20cb9..0d3ca6cbd57f 100644
--- a/arch/m68k/include/asm/next.h
+++ b/arch/m68k/include/asm/next.h
@@ -33,6 +33,7 @@
 #define NEXT_MON		0x0000e000
 
 /* Devices, relative to the 68040 BMAP or 68030 I/O window */
+#define NEXT_ENET		0x00006000
 #define NEXT_ESP		0x00014000
 #define NEXT_TIMER		0x00016000
 #define NEXT_TIMER_CSR		0x00016004
@@ -51,7 +52,7 @@ extern u8 next_ethaddr[6];
 
 void next_init_IRQ(void);
 void next_sched_init(void);
-void next_rom_reset(unsigned long phys_stub);
+void next_rom_reset(unsigned long phys_stub, unsigned long rom_base);
 
 static inline void __iomem *next_io(unsigned long off)
 {
diff --git a/arch/m68k/next/boot/main.c b/arch/m68k/next/boot/main.c
index 98a8b66ce6b6..22a135a542e4 100644
--- a/arch/m68k/next/boot/main.c
+++ b/arch/m68k/next/boot/main.c
@@ -10,13 +10,22 @@
 #include <asm/bootinfo.h>
 #include <asm/bootinfo-next.h>
 
-/* Byte offsets into the ROM struct mon_global */
+/* Byte offsets into the ROM struct mon_global, only SIMMs on ROM 1.x */
 #define MG_SIMM		0
 #define MG_BOOT_ARG	244
-#define MG_ETHERADDR	788
 #define MG_PUTC		734
-#define MG_MACHINE	936
-#define MG_BOARD_REV	937
+
+/* System type from the system control registers */
+#define SCR1		0x0200c000
+#define TMC_SCR1	0x02200000
+#define SCR1_TYPE(v)	(((v) >> 12) & 0xf)
+#define SCR1_REV(v)	(((v) >> 8) & 0xf)
+#define SCR1_TYPE_TURBO	4
+
+/* The Ethernet address is part of the ROM image, 68040 models use BMAP */
+#define ROM_BASE_030	0x00000000
+#define ROM_BASE_040	0x01000000
+#define ROM_ETHERADDR	8
 
 #define NR_SIMM		4
 #define SIMM_SIZE	0x03
@@ -27,6 +36,8 @@
 /* The ROM keeps its data at the very top of memory */
 #define ROM_RESERVED	0x2000
 
+#define CHUNK_ALIGN_030	0x40000UL
+
 #define CMDLINE_SIZE	256
 
 #define NR_CHUNKS	NR_SIMM
@@ -35,12 +46,14 @@ extern const char payload_start[], payload_end[], _start[];
 void enter_kernel(unsigned long entry, int is_040) __attribute__((noreturn));
 
 static const char *mg;
+static int have_rom_console;
 
 static void putc_rom(char c)
 {
 	void (*rom_putc)(int) = *(void (**)(int))(mg + MG_PUTC);
 
-	rom_putc(c);
+	if (have_rom_console)
+		rom_putc(c);
 }
 
 static void puts_rom(const char *s)
@@ -158,8 +171,12 @@ static unsigned int get_memory(unsigned int machine, struct mem_info *chunks)
 			n++;
 		}
 	}
-	if (n)
+	if (n) {
 		chunks[n - 1].size -= ROM_RESERVED;
+		/* Memory is mapped in units of 256 KB on the 68030 */
+		if (machine == NEXT_MACH_CUBE030)
+			chunks[n - 1].size &= ~(CHUNK_ALIGN_030 - 1);
+	}
 	return n;
 }
 
@@ -172,12 +189,19 @@ void next_boot(const char *mon_global)
 	const char *arg, *rec;
 	unsigned int machine, nchunks, i;
 	unsigned long len;
+	u32 scr1;
 	int is_040;
 
 	mg = mon_global;
-	machine = (unsigned char)mg[MG_MACHINE];
+	scr1 = *(volatile u32 *)SCR1;
+	machine = SCR1_TYPE(scr1);
+	if (machine == SCR1_TYPE_TURBO)
+		machine = SCR1_TYPE(*(volatile u32 *)TMC_SCR1);
 	is_040 = machine != NEXT_MACH_CUBE030;
 
+	/* mon_global of old 68030 ROMs is too short for the fields used here */
+	have_rom_console = is_040;
+
 	puts_rom("Linux nextboot, machine ");
 	put_hex(machine);
 	puts_rom("\n");
@@ -219,10 +243,14 @@ void next_boot(const char *mon_global)
 	for (i = 0; i < nchunks; i++)
 		bi_add(BI_MEMCHUNK, &chunks[i], sizeof(chunks[i]));
 
-	/* Arguments typed at the ROM monitor follow the built in default */
+	/* Monitor arguments after the boot device follow the built in default */
 	len = str_len(NEXTBOOT_CMDLINE);
 	copy(cmdline, NEXTBOOT_CMDLINE, len);
-	arg = *(const char **)(mg + MG_BOOT_ARG);
+	arg = is_040 ? *(const char **)(mg + MG_BOOT_ARG) : NULL;
+	while (arg && *arg && *arg != ' ')
+		arg++;
+	while (arg && *arg == ' ')
+		arg++;
 	if (arg && *arg) {
 		unsigned long alen = str_len(arg);
 
@@ -236,8 +264,9 @@ void next_boot(const char *mon_global)
 	bi_add(BI_COMMAND_LINE, cmdline, len);
 
 	bi_add_u32(BI_NEXT_MACHINE, machine);
-	bi_add_u32(BI_NEXT_BOARD_REV, (unsigned char)mg[MG_BOARD_REV]);
-	bi_add(BI_NEXT_ETHADDR, *(const char **)(mg + MG_ETHERADDR), 6);
+	bi_add_u32(BI_NEXT_BOARD_REV, SCR1_REV(scr1));
+	bi_add(BI_NEXT_ETHADDR, (const char *)(is_040 ? ROM_BASE_040 : ROM_BASE_030) +
+	       ROM_ETHERADDR, 6);
 	bi_add_u32(BI_LAST, 0);
 
 	puts_rom("Starting kernel, bootinfo ");
diff --git a/arch/m68k/next/config.c b/arch/m68k/next/config.c
index 27f31ec6519e..1975c74beef2 100644
--- a/arch/m68k/next/config.c
+++ b/arch/m68k/next/config.c
@@ -29,6 +29,15 @@
 
 #define ESP_CMD		3
 #define ESP_CMD_RESET	0x02
+#define ESP_DMA_CTRL	0x20
+#define ESP_CTRL_CLK20	0x80
+
+#define ENET_TXMASK	1
+#define ENET_RXMASK	3
+
+#define TMC_VIDEO	0x00200080
+#define TMC_VI_CLEAR	0x01
+#define TMC_VI_ENABLE	0x04
 
 unsigned long next_machine;
 EXPORT_SYMBOL(next_machine);
@@ -78,14 +87,20 @@ static void next_get_model(char *model)
 
 static void next_reset(void)
 {
-	next_rom_reset(virt_to_phys((void *)next_rom_reset_stub));
+	next_rom_reset(virt_to_phys((void *)next_rom_reset_stub),
+		       next_machine == NEXT_MACH_CUBE030 ? 0 : 0x01000000);
 }
 
 /* Sources which the interrupt mask register cannot turn off */
 static void __init next_quiesce(void)
 {
+	out_8(next_dev(NEXT_ESP) + ESP_DMA_CTRL, ESP_CTRL_CLK20);
 	out_8(next_dev(NEXT_ESP) + ESP_CMD, ESP_CMD_RESET);
-	if (next_machine == NEXT_MACH_COLOR)
+	out_8(next_dev(NEXT_ENET) + ENET_TXMASK, 0);
+	out_8(next_dev(NEXT_ENET) + ENET_RXMASK, 0);
+	if (next_is_turbo())
+		out_8(next_io(TMC_VIDEO), TMC_VI_ENABLE | TMC_VI_CLEAR);
+	else if (next_is_color())
 		out_8(next_dev(NEXT_C16_CMD), C16_UNBLANK | C16_CLEAR_INT);
 }
 
diff --git a/arch/m68k/next/reset.S b/arch/m68k/next/reset.S
index 04540896844e..1a088b473dbb 100644
--- a/arch/m68k/next/reset.S
+++ b/arch/m68k/next/reset.S
@@ -11,10 +11,11 @@
 #define TT040_RAM	0x0403c040	/* 0x04000000-0x07ffffff, uncached */
 #define TT030_RAM	0x04038507
 
-/* void next_rom_reset(unsigned long phys_stub) */
+/* void next_rom_reset(unsigned long phys_stub, unsigned long rom_base) */
 ENTRY(next_rom_reset)
 	movew	#0x2700,%sr
 	movel	%sp@(4),%a0
+	movel	%sp@(8),%a1
 	movel	m68k_cputype,%d1
 	btst	#CPUB_68040,%d1
 	jeq	1f
@@ -62,6 +63,6 @@ GLOBAL(next_rom_reset_stub)
 	pmove	%sp@,%tt0
 	.chip	68k
 
-3:	movel	0x01000000,%sp
-	movel	0x01000004,%a0
+3:	movel	%a1@,%sp
+	movel	%a1@(4),%a0
 	jmp	%a0@
diff --git a/drivers/net/ethernet/next/mb8795.c b/drivers/net/ethernet/next/mb8795.c
index fd67a297dbd8..d66430f3c331 100644
--- a/drivers/net/ethernet/next/mb8795.c
+++ b/drivers/net/ethernet/next/mb8795.c
@@ -21,8 +21,6 @@
 #include <asm/next.h>
 #include <asm/nextdma.h>
 
-#define NEXT_ENET		0x00006000
-
 #define EN_TXSTAT		0
 #define EN_TXMASK		1
 #define EN_RXSTAT		2
-- 
2.54.0


From f2163f495b0e5d4fa11a0104511d90dad170fcfe Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 02:10:03 +0100
Subject: [PATCH 10/35] m68k: next: Add clock chip access, soft power off and a
 working reboot
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The MC68HC68T1 or MCCS1850 clock chip is accessed through three bits of
system control register 2 and also controls the power supply.

Reboot re-enters the ROM, which expects devices in their reset state: a
pending SCSI interrupt makes it call a handler it has not set up yet.  Reset
them first, and do not use the virtual stack pointer on the 68030 once
address translation is off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/next_defconfig |   3 +
 arch/m68k/include/asm/nextrtc.h  |  45 +++++++++++
 arch/m68k/next/Makefile          |   2 +-
 arch/m68k/next/config.c          |  48 ++++++++++--
 arch/m68k/next/reset.S           |  11 ++-
 arch/m68k/next/rtc.c             | 125 +++++++++++++++++++++++++++++++
 6 files changed, 222 insertions(+), 12 deletions(-)
 create mode 100644 arch/m68k/include/asm/nextrtc.h
 create mode 100644 arch/m68k/next/rtc.c

diff --git a/arch/m68k/configs/next_defconfig b/arch/m68k/configs/next_defconfig
index afb364c605da..50b60bad3196 100644
--- a/arch/m68k/configs/next_defconfig
+++ b/arch/m68k/configs/next_defconfig
@@ -53,6 +53,9 @@ CONFIG_SND=y
 CONFIG_SND_OSSEMUL=y
 CONFIG_SND_PCM_OSS=y
 CONFIG_SND_NEXT=y
+CONFIG_RTC_CLASS=y
+CONFIG_RTC_HCTOSYS=y
+CONFIG_RTC_DRV_NEXT=y
 CONFIG_TMPFS=y
 CONFIG_EXT2_FS=y
 CONFIG_EXT4_FS=y
diff --git a/arch/m68k/include/asm/nextrtc.h b/arch/m68k/include/asm/nextrtc.h
new file mode 100644
index 000000000000..2d5e194dcec2
--- /dev/null
+++ b/arch/m68k/include/asm/nextrtc.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * NeXT clock chips: MC68HC68T1 with BCD time, MCCS1850 with a seconds counter
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef _ASM_M68K_NEXTRTC_H
+#define _ASM_M68K_NEXTRTC_H
+
+#include <linux/types.h>
+
+/* Common */
+#define NEXT_RTC_RAM		0x00
+#define NEXT_RTC_RAM_SIZE	32
+#define NEXT_RTC_STATUS		0x30
+#define NEXT_RTC_STATUS_NEW	0x80
+#define NEXT_RTC_START		0x80
+#define NEXT_RTC_POWERDOWN	0x40
+
+/* MC68HC68T1 */
+#define NEXT_RTC_SEC		0x20
+#define NEXT_RTC_MIN		0x21
+#define NEXT_RTC_HOUR		0x22
+#define NEXT_RTC_WDAY		0x23
+#define NEXT_RTC_MDAY		0x24
+#define NEXT_RTC_MON		0x25
+#define NEXT_RTC_YEAR		0x26
+#define NEXT_RTC_CLKCTRL	0x31
+#define NEXT_RTC_INTCTRL	0x32
+
+/* MCCS1850 */
+#define NEXT_NRTC_CNTR0		0x20
+#define NEXT_NRTC_CNTR3		0x23
+#define NEXT_NRTC_CONTROL	0x31
+#define NEXT_NRTC_CLR_FIRSTUP	0x04
+#define NEXT_NRTC_CLR_PDOWN	0x01
+#define NEXT_NRTC_RAM2		0x40
+
+u8 next_rtc_read(u8 reg);
+void next_rtc_write(u8 reg, u8 val);
+bool next_rtc_is_mccs1850(void);
+void next_power_off(void);
+
+#endif /* _ASM_M68K_NEXTRTC_H */
diff --git a/arch/m68k/next/Makefile b/arch/m68k/next/Makefile
index 19cfc9204f93..d0c5d1a8cfa5 100644
--- a/arch/m68k/next/Makefile
+++ b/arch/m68k/next/Makefile
@@ -3,4 +3,4 @@
 # Makefile for Linux arch/m68k/next source directory
 #
 
-obj-y		:= config.o ints.o reset.o time.o
+obj-y		:= config.o ints.o reset.o rtc.o time.o
diff --git a/arch/m68k/next/config.c b/arch/m68k/next/config.c
index 1975c74beef2..31dd1569d443 100644
--- a/arch/m68k/next/config.c
+++ b/arch/m68k/next/config.c
@@ -9,6 +9,7 @@
 #include <linux/ioport.h>
 #include <linux/kernel.h>
 #include <linux/platform_device.h>
+#include <linux/reboot.h>
 #include <linux/string.h>
 
 #include <asm/bootinfo.h>
@@ -17,6 +18,8 @@
 #include <asm/io.h>
 #include <asm/machdep.h>
 #include <asm/next.h>
+#include <asm/nextdma.h>
+#include <asm/nextrtc.h>
 #include <asm/setup.h>
 
 #define SCC_CTRL_A	1
@@ -34,6 +37,8 @@
 
 #define ENET_TXMASK	1
 #define ENET_RXMASK	3
+#define ENET_RESET	6
+#define ENET_RESET_ON	0x80
 
 #define TMC_VIDEO	0x00200080
 #define TMC_VI_CLEAR	0x01
@@ -85,14 +90,8 @@ static void next_get_model(char *model)
 		sprintf(model, "NeXT machine type %lu", next_machine);
 }
 
-static void next_reset(void)
-{
-	next_rom_reset(virt_to_phys((void *)next_rom_reset_stub),
-		       next_machine == NEXT_MACH_CUBE030 ? 0 : 0x01000000);
-}
-
 /* Sources which the interrupt mask register cannot turn off */
-static void __init next_quiesce(void)
+static void next_quiesce(void)
 {
 	out_8(next_dev(NEXT_ESP) + ESP_DMA_CTRL, ESP_CTRL_CLK20);
 	out_8(next_dev(NEXT_ESP) + ESP_CMD, ESP_CMD_RESET);
@@ -134,6 +133,38 @@ static void __init next_scc_setup(void)
 	scc_b_pdev.num_resources = ARRAY_SIZE(scc_b_rsrcs);
 }
 
+/*
+ * The ROM expects devices in their reset state, a pending interrupt makes it
+ * call handlers it has not set up yet.
+ */
+static void next_reset(void)
+{
+	static const unsigned int chans[] = {
+		NEXTDMA_SCSI, NEXTDMA_SOUND_OUT, NEXTDMA_DISK, NEXTDMA_SOUND_IN,
+		NEXTDMA_PRINTER, NEXTDMA_ENET_TX, NEXTDMA_ENET_RX,
+	};
+	void __iomem *scc = next_dev(NEXT_SCC);
+	int i;
+
+	local_irq_disable();
+	out_be32(next_io(NEXT_INTRMASK), 0);
+
+	next_quiesce();
+	out_8(next_dev(NEXT_ENET) + ENET_RESET, ENET_RESET_ON);
+	in_8(scc + SCC_CTRL_A);
+	out_8(scc + SCC_CTRL_A, 9);
+	out_8(scc + SCC_CTRL_A, 0xc0);
+	out_8(next_dev(NEXT_TIMER_CSR), 0);
+	for (i = 0; i < ARRAY_SIZE(chans); i++) {
+		/* Turbo models have no optical drive channel */
+		if (chans[i] != NEXTDMA_DISK || !next_is_turbo())
+			nextdma_reset(chans[i]);
+	}
+
+	next_rom_reset(virt_to_phys((void *)next_rom_reset_stub),
+		       next_machine == NEXT_MACH_CUBE030 ? 0 : 0x01000000);
+}
+
 void __init config_next(void)
 {
 	next_quiesce();
@@ -165,6 +196,8 @@ static int __init next_platform_init(void)
 	if (!MACH_IS_NEXT)
 		return -ENODEV;
 
+	register_platform_power_off(next_power_off);
+
 	platform_device_register(&scc_a_pdev);
 	platform_device_register(&scc_b_pdev);
 	platform_device_register_simple("nextfb", -1, &fb, 1);
@@ -172,6 +205,7 @@ static int __init next_platform_init(void)
 	platform_device_register_simple("next_esp", -1, &esp, 1);
 	platform_device_register_simple("mb8795", -1, NULL, 0);
 	platform_device_register_simple("next_snd", -1, NULL, 0);
+	platform_device_register_simple("rtc-next", -1, NULL, 0);
 
 	return 0;
 }
diff --git a/arch/m68k/next/reset.S b/arch/m68k/next/reset.S
index 1a088b473dbb..290f9eeddff4 100644
--- a/arch/m68k/next/reset.S
+++ b/arch/m68k/next/reset.S
@@ -56,13 +56,16 @@ GLOBAL(next_rom_reset_stub)
 	.chip	68k
 	jra	3f
 
-2:	.chip	68030
-	clrl	%sp@-
-	pmove	%sp@,%tc
+	/* The stack pointer is a virtual address, it is unusable from here on */
+2:	lea	%pc@(zero),%a0
+	.chip	68030
+	pmove	%a0@,%tc
 	pflusha
-	pmove	%sp@,%tt0
+	pmove	%a0@,%tt0
 	.chip	68k
 
 3:	movel	%a1@,%sp
 	movel	%a1@(4),%a0
 	jmp	%a0@
+
+zero:	.long	0
diff --git a/arch/m68k/next/rtc.c b/arch/m68k/next/rtc.c
new file mode 100644
index 000000000000..28a44892f8ab
--- /dev/null
+++ b/arch/m68k/next/rtc.c
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NeXT clock chip access through three bits of system control register 2,
+ * and soft power off: the chip also controls the power supply.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/delay.h>
+#include <linux/export.h>
+#include <linux/init.h>
+#include <linux/spinlock.h>
+
+#include <asm/io.h>
+#include <asm/next.h>
+#include <asm/nextrtc.h>
+
+#define SCR2_RTC	(NEXT_SCR2 + 2)
+#define SCR2_RTDATA	0x04
+#define SCR2_RTCLK	0x02
+#define SCR2_RTCE	0x01
+
+#define RTC_WRITE	0x80
+#define RTC_DELAY_US	1
+
+static DEFINE_SPINLOCK(next_rtc_lock);
+
+static void next_rtc_clock_bit(u8 base, u8 bit)
+{
+	void __iomem *scr2 = next_io(SCR2_RTC);
+
+	out_8(scr2, base | bit);
+	udelay(RTC_DELAY_US);
+	out_8(scr2, base | bit | SCR2_RTCLK);
+	udelay(RTC_DELAY_US);
+	out_8(scr2, base | bit);
+	udelay(RTC_DELAY_US);
+}
+
+static u8 next_rtc_begin(void)
+{
+	void __iomem *scr2 = next_io(SCR2_RTC);
+	u8 base = in_8(scr2) & ~(SCR2_RTDATA | SCR2_RTCLK | SCR2_RTCE);
+
+	out_8(scr2, base);
+	udelay(RTC_DELAY_US);
+	base |= SCR2_RTCE;
+	out_8(scr2, base);
+	udelay(RTC_DELAY_US);
+	return base;
+}
+
+static void next_rtc_end(u8 base)
+{
+	out_8(next_io(SCR2_RTC), base & ~SCR2_RTCE);
+	udelay(RTC_DELAY_US);
+}
+
+static void next_rtc_send(u8 base, u8 val)
+{
+	int i;
+
+	for (i = 7; i >= 0; i--)
+		next_rtc_clock_bit(base, (val >> i) & 1 ? SCR2_RTDATA : 0);
+}
+
+u8 next_rtc_read(u8 reg)
+{
+	void __iomem *scr2 = next_io(SCR2_RTC);
+	unsigned long flags;
+	u8 base, val = 0;
+	int i;
+
+	spin_lock_irqsave(&next_rtc_lock, flags);
+	base = next_rtc_begin();
+	next_rtc_send(base, reg);
+	for (i = 0; i < 8; i++) {
+		next_rtc_clock_bit(base, 0);
+		val = (val << 1) | !!(in_8(scr2) & SCR2_RTDATA);
+	}
+	next_rtc_end(base);
+	spin_unlock_irqrestore(&next_rtc_lock, flags);
+	return val;
+}
+EXPORT_SYMBOL_GPL(next_rtc_read);
+
+void next_rtc_write(u8 reg, u8 val)
+{
+	unsigned long flags;
+	u8 base;
+
+	spin_lock_irqsave(&next_rtc_lock, flags);
+	base = next_rtc_begin();
+	next_rtc_send(base, reg | RTC_WRITE);
+	next_rtc_send(base, val);
+	next_rtc_end(base);
+	spin_unlock_irqrestore(&next_rtc_lock, flags);
+}
+EXPORT_SYMBOL_GPL(next_rtc_write);
+
+bool next_rtc_is_mccs1850(void)
+{
+	return next_rtc_read(NEXT_RTC_STATUS) & NEXT_RTC_STATUS_NEW;
+}
+EXPORT_SYMBOL_GPL(next_rtc_is_mccs1850);
+
+void next_power_off(void)
+{
+	bool new = next_rtc_is_mccs1850();
+	u8 sec_reg = new ? NEXT_NRTC_CNTR3 : NEXT_RTC_SEC;
+	u8 sec = next_rtc_read(sec_reg);
+	int timeout = 2000;
+
+	/* The supply ignores the request right after the time counter ticks */
+	while (next_rtc_read(sec_reg) == sec && --timeout)
+		mdelay(1);
+	mdelay(850);
+
+	if (new)
+		next_rtc_write(NEXT_NRTC_CONTROL,
+			       next_rtc_read(NEXT_NRTC_CONTROL) | NEXT_RTC_POWERDOWN);
+	else
+		next_rtc_write(NEXT_RTC_INTCTRL,
+			       next_rtc_read(NEXT_RTC_INTCTRL) | NEXT_RTC_POWERDOWN);
+}
-- 
2.54.0


From cba1afc4d1e946bee034653f71141d07ffa54f0c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 02:10:03 +0100
Subject: [PATCH 11/35] rtc: Add NeXT real time clock driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Supports the MC68HC68T1 with BCD time and the MCCS1850 seconds counter, the
battery backed memory through nvmem, and the power key.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/rtc/Kconfig    |  10 ++
 drivers/rtc/Makefile   |   1 +
 drivers/rtc/rtc-next.c | 222 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 233 insertions(+)
 create mode 100644 drivers/rtc/rtc-next.c

diff --git a/drivers/rtc/Kconfig b/drivers/rtc/Kconfig
index 05b9233b9418..799371c55921 100644
--- a/drivers/rtc/Kconfig
+++ b/drivers/rtc/Kconfig
@@ -1288,6 +1288,16 @@ config RTC_DRV_M48T59
 	  This driver can also be built as a module, if so, the module
 	  will be called "rtc-m48t59".
 
+config RTC_DRV_NEXT
+	tristate "NeXT real time clock"
+	depends on NEXT
+	help
+	  Say Y here for the MC68HC68T1 or MCCS1850 clock chip of the NeXT
+	  computers, including its battery backed memory and the power key.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called rtc-next.
+
 config RTC_DRV_MSM6242
 	tristate "Oki MSM6242"
 	depends on HAS_IOMEM
diff --git a/drivers/rtc/Makefile b/drivers/rtc/Makefile
index 0347645b021f..3c935230058f 100644
--- a/drivers/rtc/Makefile
+++ b/drivers/rtc/Makefile
@@ -119,6 +119,7 @@ obj-$(CONFIG_RTC_DRV_MT7622)	+= rtc-mt7622.o
 obj-$(CONFIG_RTC_DRV_MV)	+= rtc-mv.o
 obj-$(CONFIG_RTC_DRV_MXC)	+= rtc-mxc.o
 obj-$(CONFIG_RTC_DRV_MXC_V2)	+= rtc-mxc_v2.o
+obj-$(CONFIG_RTC_DRV_NEXT)	+= rtc-next.o
 obj-$(CONFIG_RTC_DRV_GAMECUBE)	+= rtc-gamecube.o
 obj-$(CONFIG_RTC_DRV_NCT3018Y)	+= rtc-nct3018y.o
 obj-$(CONFIG_RTC_DRV_NCT6694)	+= rtc-nct6694.o
diff --git a/drivers/rtc/rtc-next.c b/drivers/rtc/rtc-next.c
new file mode 100644
index 000000000000..99ac823222aa
--- /dev/null
+++ b/drivers/rtc/rtc-next.c
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NeXT real time clock, battery backed memory and power key.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/bcd.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/nvmem-provider.h>
+#include <linux/platform_device.h>
+#include <linux/reboot.h>
+#include <linux/rtc.h>
+
+#include <asm/next.h>
+#include <asm/nextrtc.h>
+
+#define IRQ_NEXT_POWER		NEXT_IRQ(2)
+
+#define HOUR_12		0x80
+#define HOUR_PM		0x20
+#define HOUR_MASK_12	0x1f
+
+/* Two digit year in years since 1900, the upper digit may exceed nine */
+#define YEAR_PIVOT	69
+
+struct next_rtc {
+	struct rtc_device *rtc;
+	bool new_chip;
+};
+
+static int next_rtc_old_read_time(struct rtc_time *tm)
+{
+	u8 hour, year;
+
+	tm->tm_sec = bcd2bin(next_rtc_read(NEXT_RTC_SEC) & 0x7f);
+	tm->tm_min = bcd2bin(next_rtc_read(NEXT_RTC_MIN) & 0x7f);
+	hour = next_rtc_read(NEXT_RTC_HOUR);
+	if (hour & HOUR_12) {
+		tm->tm_hour = bcd2bin(hour & HOUR_MASK_12) % 12;
+		if (hour & HOUR_PM)
+			tm->tm_hour += 12;
+	} else {
+		tm->tm_hour = bcd2bin(hour & 0x3f);
+	}
+	tm->tm_mday = bcd2bin(next_rtc_read(NEXT_RTC_MDAY) & 0x3f);
+	tm->tm_mon = bcd2bin(next_rtc_read(NEXT_RTC_MON) & 0x1f) - 1;
+	year = next_rtc_read(NEXT_RTC_YEAR);
+	tm->tm_year = (year >> 4) * 10 + (year & 0xf);
+	if (tm->tm_year < YEAR_PIVOT)
+		tm->tm_year += 100;
+	tm->tm_wday = (next_rtc_read(NEXT_RTC_WDAY) & 0x07) - 1;
+	return 0;
+}
+
+static int next_rtc_old_set_time(struct rtc_time *tm)
+{
+	u8 ctrl = next_rtc_read(NEXT_RTC_CLKCTRL);
+	u8 hour = next_rtc_read(NEXT_RTC_HOUR);
+
+	next_rtc_write(NEXT_RTC_CLKCTRL, ctrl & ~NEXT_RTC_START);
+	next_rtc_write(NEXT_RTC_SEC, bin2bcd(tm->tm_sec));
+	next_rtc_write(NEXT_RTC_MIN, bin2bcd(tm->tm_min));
+	if (hour & HOUR_12) {
+		int h = tm->tm_hour % 12;
+
+		next_rtc_write(NEXT_RTC_HOUR, bin2bcd(h ? h : 12) | HOUR_12 |
+			       (tm->tm_hour >= 12 ? HOUR_PM : 0));
+	} else {
+		next_rtc_write(NEXT_RTC_HOUR, bin2bcd(tm->tm_hour));
+	}
+	next_rtc_write(NEXT_RTC_WDAY, tm->tm_wday + 1);
+	next_rtc_write(NEXT_RTC_MDAY, bin2bcd(tm->tm_mday));
+	next_rtc_write(NEXT_RTC_MON, bin2bcd(tm->tm_mon + 1));
+	next_rtc_write(NEXT_RTC_YEAR, ((tm->tm_year / 10) << 4) | (tm->tm_year % 10));
+	next_rtc_write(NEXT_RTC_CLKCTRL, ctrl | NEXT_RTC_START);
+	return 0;
+}
+
+static int next_rtc_new_read_time(struct rtc_time *tm)
+{
+	u32 secs = 0;
+	int i;
+
+	for (i = 0; i < 4; i++)
+		secs = (secs << 8) | next_rtc_read(NEXT_NRTC_CNTR0 + i);
+	rtc_time64_to_tm(secs, tm);
+	return 0;
+}
+
+static int next_rtc_new_set_time(struct rtc_time *tm)
+{
+	u32 secs = rtc_tm_to_time64(tm);
+	u8 ctrl = next_rtc_read(NEXT_NRTC_CONTROL);
+	int i;
+
+	next_rtc_write(NEXT_NRTC_CONTROL, ctrl & ~NEXT_RTC_START);
+	for (i = 0; i < 4; i++)
+		next_rtc_write(NEXT_NRTC_CNTR0 + i, secs >> (24 - i * 8));
+	next_rtc_write(NEXT_NRTC_CONTROL, ctrl | NEXT_RTC_START);
+	return 0;
+}
+
+static int next_rtc_read_time(struct device *dev, struct rtc_time *tm)
+{
+	struct next_rtc *nr = dev_get_drvdata(dev);
+
+	return nr->new_chip ? next_rtc_new_read_time(tm) : next_rtc_old_read_time(tm);
+}
+
+static int next_rtc_set_time(struct device *dev, struct rtc_time *tm)
+{
+	struct next_rtc *nr = dev_get_drvdata(dev);
+
+	return nr->new_chip ? next_rtc_new_set_time(tm) : next_rtc_old_set_time(tm);
+}
+
+static const struct rtc_class_ops next_rtc_ops = {
+	.read_time	= next_rtc_read_time,
+	.set_time	= next_rtc_set_time,
+};
+
+/* The second half of the larger memory is not contiguous in the address space */
+static u8 next_rtc_ram_reg(unsigned int offset)
+{
+	if (offset < NEXT_RTC_RAM_SIZE)
+		return NEXT_RTC_RAM + offset;
+	return NEXT_NRTC_RAM2 + offset - NEXT_RTC_RAM_SIZE;
+}
+
+static int next_rtc_nvram_read(void *priv, unsigned int offset, void *val, size_t bytes)
+{
+	u8 *buf = val;
+
+	while (bytes--)
+		*buf++ = next_rtc_read(next_rtc_ram_reg(offset++));
+	return 0;
+}
+
+static int next_rtc_nvram_write(void *priv, unsigned int offset, void *val, size_t bytes)
+{
+	u8 *buf = val;
+
+	while (bytes--)
+		next_rtc_write(next_rtc_ram_reg(offset++), *buf++);
+	return 0;
+}
+
+/* The power key: shut down cleanly, the supply then turns the machine off */
+static irqreturn_t next_rtc_power_interrupt(int irq, void *dev_id)
+{
+	struct next_rtc *nr = dev_id;
+
+	/* The old chip holds the line while the key is down */
+	disable_irq_nosync(irq);
+	if (nr->new_chip)
+		next_rtc_write(NEXT_NRTC_CONTROL, next_rtc_read(NEXT_NRTC_CONTROL) |
+			       NEXT_NRTC_CLR_PDOWN);
+	orderly_poweroff(true);
+	return IRQ_HANDLED;
+}
+
+static int next_rtc_probe(struct platform_device *pdev)
+{
+	struct nvmem_config nvmem = {
+		.name		= "next_nvram",
+		.type		= NVMEM_TYPE_BATTERY_BACKED,
+		.word_size	= 1,
+		.stride		= 1,
+		.reg_read	= next_rtc_nvram_read,
+		.reg_write	= next_rtc_nvram_write,
+	};
+	struct next_rtc *nr;
+	int err;
+
+	nr = devm_kzalloc(&pdev->dev, sizeof(*nr), GFP_KERNEL);
+	if (!nr)
+		return -ENOMEM;
+	platform_set_drvdata(pdev, nr);
+
+	nr->new_chip = next_rtc_is_mccs1850();
+	if (nr->new_chip)
+		next_rtc_write(NEXT_NRTC_CONTROL, next_rtc_read(NEXT_NRTC_CONTROL) |
+			       NEXT_NRTC_CLR_FIRSTUP);
+
+	nr->rtc = devm_rtc_allocate_device(&pdev->dev);
+	if (IS_ERR(nr->rtc))
+		return PTR_ERR(nr->rtc);
+
+	nr->rtc->ops = &next_rtc_ops;
+	nr->rtc->range_min = nr->new_chip ? 0 : RTC_TIMESTAMP_BEGIN_1900 + 69 * 31556952LL;
+	nr->rtc->range_max = nr->new_chip ? U32_MAX : RTC_TIMESTAMP_END_2099;
+
+	err = devm_request_irq(&pdev->dev, IRQ_NEXT_POWER, next_rtc_power_interrupt, 0,
+			       "next power", nr);
+	if (err)
+		return err;
+
+	err = devm_rtc_register_device(nr->rtc);
+	if (err)
+		return err;
+
+	nvmem.size = nr->new_chip ? 2 * NEXT_RTC_RAM_SIZE : NEXT_RTC_RAM_SIZE;
+	devm_rtc_nvmem_register(nr->rtc, &nvmem);
+
+	dev_info(&pdev->dev, "%s clock chip\n", nr->new_chip ? "MCCS1850" : "MC68HC68T1");
+	return 0;
+}
+
+static struct platform_driver next_rtc_driver = {
+	.probe	= next_rtc_probe,
+	.driver	= {
+		.name = "rtc-next",
+	},
+};
+module_platform_driver(next_rtc_driver);
+
+MODULE_DESCRIPTION("NeXT real time clock driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 69bee42025681c343e96b16a183c9971d11f0620 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 02:29:33 +0100
Subject: [PATCH 12/35] m68k: next: Add floppy support on the DMA channel
 shared with SCSI
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Intel 82077 uses the SCSI DMA channel, owned for one transfer at a time
with a small arbiter.  The floppy controller must own the channel before it
gets a command, or it overruns, so floppy.c gets a hook to claim it in work
context ahead of its DMA lock.

The ISA style pseudo DMA loop and sun3x parts of asm/floppy.h are now only
built for their machines.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/Kconfig.devices        |   2 +-
 arch/m68k/Kconfig.machine        |   1 +
 arch/m68k/configs/next_defconfig |   1 +
 arch/m68k/include/asm/floppy.h   |  83 ++++++++++++++++++++--
 arch/m68k/include/asm/nextdma.h  |  13 ++++
 arch/m68k/include/asm/nextflop.h | 116 +++++++++++++++++++++++++++++++
 arch/m68k/next/Makefile          |   2 +-
 arch/m68k/next/dma.c             |  93 +++++++++++++++++++++++++
 drivers/block/floppy.c           |   3 +
 drivers/scsi/next_esp.c          |  49 ++++++++++---
 10 files changed, 343 insertions(+), 20 deletions(-)
 create mode 100644 arch/m68k/include/asm/nextflop.h
 create mode 100644 arch/m68k/next/dma.c

diff --git a/arch/m68k/Kconfig.devices b/arch/m68k/Kconfig.devices
index 3f809a02438b..3528a46cdf4c 100644
--- a/arch/m68k/Kconfig.devices
+++ b/arch/m68k/Kconfig.devices
@@ -3,7 +3,7 @@ if MMU
 
 config ARCH_MAY_HAVE_PC_FDC
 	bool
-	depends on BROKEN && (Q40 || SUN3X)
+	depends on (BROKEN && (Q40 || SUN3X)) || NEXT
 	default y
 
 menu "Platform devices"
diff --git a/arch/m68k/Kconfig.machine b/arch/m68k/Kconfig.machine
index f0f1fc21a2e9..5afe5d4b4b90 100644
--- a/arch/m68k/Kconfig.machine
+++ b/arch/m68k/Kconfig.machine
@@ -41,6 +41,7 @@ config MAC
 config NEXT
 	bool "NeXT support"
 	depends on MMU
+	select ISA_DMA_API
 	select LEGACY_TIMER_TICK
 	help
 	  This option enables support for the NeXT 68030 and 68040 computers:
diff --git a/arch/m68k/configs/next_defconfig b/arch/m68k/configs/next_defconfig
index 50b60bad3196..79f22525a2cb 100644
--- a/arch/m68k/configs/next_defconfig
+++ b/arch/m68k/configs/next_defconfig
@@ -27,6 +27,7 @@ CONFIG_IP_PNP_DHCP=y
 CONFIG_DEVTMPFS=y
 CONFIG_DEVTMPFS_MOUNT=y
 CONFIG_BLK_DEV=y
+CONFIG_BLK_DEV_FD=y
 CONFIG_BLK_DEV_LOOP=y
 CONFIG_BLK_DEV_SD=y
 CONFIG_SCSI=y
diff --git a/arch/m68k/include/asm/floppy.h b/arch/m68k/include/asm/floppy.h
index dea98bbc0932..d25f051b08d2 100644
--- a/arch/m68k/include/asm/floppy.h
+++ b/arch/m68k/include/asm/floppy.h
@@ -28,7 +28,7 @@ asmlinkage irqreturn_t floppy_hardint(int irq, void *dev_id);
 /*
  * Again, the CMOS information doesn't work on m68k..
  */
-#define FLOPPY0_TYPE (MACH_IS_Q40 ? 6 : 4)
+#define FLOPPY0_TYPE ((MACH_IS_Q40 || MACH_IS_NEXT) ? 6 : 4)
 #define FLOPPY1_TYPE 0
 
 /* basically PC init + set use_virtual_dma */
@@ -46,7 +46,17 @@ static char *virtual_dma_addr=NULL;
 static int virtual_dma_mode=0;
 static int doing_pdma=0;
 
+#ifdef CONFIG_SUN3X
 #include <asm/sun3xflop.h>
+#else
+#undef release_region
+#undef request_region
+#define release_region(X, Y)	do { } while (0)
+#define request_region(X, Y, Z)	(1)
+#endif
+#ifdef CONFIG_NEXT
+#include <asm/nextflop.h>
+#endif
 
 extern spinlock_t  dma_spin_lock;
 
@@ -65,38 +75,60 @@ static __inline__ void release_dma_lock(unsigned long flags)
 
 static __inline__ unsigned char fd_inb(int base, int reg)
 {
+#ifdef CONFIG_NEXT
+	if (MACH_IS_NEXT)
+		return in_8((unsigned long)base + reg);
+#endif
+#ifdef CONFIG_Q40
 	if(MACH_IS_Q40)
 		return inb_p(base + reg);
-	else if(MACH_IS_SUN3X)
+#endif
+#ifdef CONFIG_SUN3X
+	if(MACH_IS_SUN3X)
 		return sun3x_82072_fd_inb(base + reg);
+#endif
 	return 0;
 }
 
 static __inline__ void fd_outb(unsigned char value, int base, int reg)
 {
+#ifdef CONFIG_NEXT
+	if (MACH_IS_NEXT)
+		out_8((unsigned long)base + reg, value);
+#endif
+#ifdef CONFIG_Q40
 	if(MACH_IS_Q40)
 		outb_p(value, base + reg);
-	else if(MACH_IS_SUN3X)
+#endif
+#ifdef CONFIG_SUN3X
+	if(MACH_IS_SUN3X)
 		sun3x_82072_fd_outb(value, base + reg);
+#endif
 }
 
 
 static int fd_request_irq(void)
 {
-	if(MACH_IS_Q40)
+	if (MACH_IS_Q40 || MACH_IS_NEXT)
 		return request_irq(FLOPPY_IRQ, floppy_hardint,
 				   0, "floppy", floppy_hardint);
-	else if(MACH_IS_SUN3X)
+#ifdef CONFIG_SUN3X
+	if(MACH_IS_SUN3X)
 		return sun3xflop_request_irq();
+#endif
 	return -ENXIO;
 }
 
 static void fd_free_irq(void)
 {
-	if(MACH_IS_Q40)
+	if (MACH_IS_Q40 || MACH_IS_NEXT)
 		free_irq(FLOPPY_IRQ, floppy_hardint);
 }
 
+#ifdef CONFIG_NEXT
+#define fd_dma_claim()		do { if (MACH_IS_NEXT) next_fd_dma_claim(); } while (0)
+#endif
+
 #define fd_request_dma()        vdma_request_dma(FLOPPY_DMA,"floppy")
 #define fd_get_dma_residue()    vdma_get_dma_residue(FLOPPY_DMA)
 #define fd_dma_mem_alloc(size)	vdma_mem_alloc(size)
@@ -112,14 +144,25 @@ static void fd_free_irq(void)
 
 static int m68k_floppy_init(void)
 {
+#ifdef CONFIG_NEXT
+  if (MACH_IS_NEXT) {
+	  use_virtual_dma = 0;
+	  can_use_virtual_dma = 0;
+	  FLOPPY_IRQ = NEXT_FDC_IRQ;
+	  return next_fd_init();
+  }
+#endif
+
   use_virtual_dma =1;
   can_use_virtual_dma = 1;
 
 
   if (MACH_IS_Q40)
 	  return 0x3f0;
+#ifdef CONFIG_SUN3X
   else if(MACH_IS_SUN3X)
 	  return sun3xflop_init();
+#endif
   else
     return -1;
 }
@@ -131,20 +174,31 @@ static int vdma_request_dma(unsigned int dmanr, const char * device_id)
 }
 
 
-static int vdma_get_dma_residue(unsigned int dummy)
+static int __maybe_unused vdma_get_dma_residue(unsigned int dummy)
 {
+#ifdef CONFIG_NEXT
+	if (MACH_IS_NEXT)
+		return next_fd.residue;
+#endif
 	return virtual_dma_count + virtual_dma_residue;
 }
 
 
 static unsigned long vdma_mem_alloc(unsigned long size)
 {
+	/* NeXT uses real DMA */
+	if (MACH_IS_NEXT)
+		return __get_free_pages(GFP_KERNEL, get_order(size));
 	return (unsigned long) vmalloc(size);
 
 }
 
 static void _fd_dma_mem_free(unsigned long addr, unsigned long size)
 {
+	if (MACH_IS_NEXT) {
+		free_pages(addr, get_order(size));
+		return;
+	}
         vfree((void *)addr);
 }
 #define fd_dma_mem_free(addr,size) _fd_dma_mem_free(addr, size)
@@ -154,6 +208,10 @@ static void _fd_dma_mem_free(unsigned long addr, unsigned long size)
 
 static int vdma_dma_setup(char *addr, unsigned long size, int mode, int io)
 {
+#ifdef CONFIG_NEXT
+	if (MACH_IS_NEXT)
+		return next_fd_dma_setup(addr, size, mode == DMA_MODE_READ);
+#endif
 	doing_pdma = 1;
 	virtual_dma_port = (MACH_IS_Q40 ? io : 0);
 	virtual_dma_mode = (mode  == DMA_MODE_WRITE);
@@ -167,6 +225,12 @@ static int vdma_dma_setup(char *addr, unsigned long size, int mode, int io)
 
 static void fd_disable_dma(void)
 {
+#ifdef CONFIG_NEXT
+	if (MACH_IS_NEXT) {
+		next_fd_dma_stop();
+		return;
+	}
+#endif
 	doing_pdma = 0;
 	virtual_dma_residue += virtual_dma_count;
 	virtual_dma_count=0;
@@ -178,7 +242,9 @@ static void fd_disable_dma(void)
 
 asmlinkage irqreturn_t floppy_hardint(int irq, void *dev_id)
 {
+#ifdef CONFIG_Q40
 	register unsigned char st;
+#endif
 
 #undef TRACE_FLPY_INT
 #define NO_FLOPPY_ASSEMBLER
@@ -193,6 +259,8 @@ asmlinkage irqreturn_t floppy_hardint(int irq, void *dev_id)
 		return IRQ_HANDLED;
 	}
 
+#ifdef CONFIG_Q40
+
 #ifdef TRACE_FLPY_INT
 	if(!calls)
 		bytes = virtual_dma_count;
@@ -245,6 +313,7 @@ asmlinkage irqreturn_t floppy_hardint(int irq, void *dev_id)
 	if(!virtual_dma_count)
 		dma_wait++;
 #endif
+#endif /* CONFIG_Q40 */
 	return IRQ_HANDLED;
 }
 
diff --git a/arch/m68k/include/asm/nextdma.h b/arch/m68k/include/asm/nextdma.h
index e143fc509ad2..f3ed1383ed1a 100644
--- a/arch/m68k/include/asm/nextdma.h
+++ b/arch/m68k/include/asm/nextdma.h
@@ -8,6 +8,8 @@
 #ifndef _ASM_M68K_NEXTDMA_H
 #define _ASM_M68K_NEXTDMA_H
 
+#include <linux/list.h>
+
 #include <asm/io.h>
 #include <asm/next.h>
 
@@ -79,4 +81,15 @@ static inline void nextdma_reset(unsigned int chan)
 	nextdma_csr_write(chan, 0);
 }
 
+/* Ownership of the channel shared by the SCSI and floppy controllers */
+struct next_scsidma_job {
+	struct list_head list;
+	void (*start)(struct next_scsidma_job *job);
+};
+
+void next_scsidma_request(struct next_scsidma_job *job);
+void next_scsidma_release(void);
+bool next_scsidma_cancel(struct next_scsidma_job *job);
+void next_scsidma_claim(void);
+
 #endif /* _ASM_M68K_NEXTDMA_H */
diff --git a/arch/m68k/include/asm/nextflop.h b/arch/m68k/include/asm/nextflop.h
new file mode 100644
index 000000000000..b663bf585032
--- /dev/null
+++ b/arch/m68k/include/asm/nextflop.h
@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * NeXT parts of the floppy driver: Intel 82077 on the channel shared with SCSI
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef _ASM_M68K_NEXTFLOP_H
+#define _ASM_M68K_NEXTFLOP_H
+
+#include <linux/string.h>
+
+#include <asm/cacheflush.h>
+#include <asm/hwtest.h>
+#include <asm/next.h>
+#include <asm/nextdma.h>
+
+#define NEXT_FDC		0x00014100
+#define NEXT_FDC_CTRL		0x00014108
+#define NEXT_FDC_CTRL_82077	0x40
+#define NEXT_FDC_IRQ		NEXT_IRQ(7)
+
+#define NEXT_ESP_DMA_CTRL	(NEXT_ESP + 0x20)
+#define NEXT_ESP_CTRL_DMA	0xb0
+#define NEXT_ESP_CTRL_DMA_READ	0x08
+#define NEXT_ESP_CTRL_IDLE	0xa0
+
+struct next_fd_dma {
+	char *addr;
+	unsigned long size;
+	unsigned long residue;
+	bool read;
+	bool active;
+	bool claimed;
+};
+
+static struct next_fd_dma next_fd;
+
+static inline void next_fd_cache(void)
+{
+	cache_push(virt_to_phys(next_fd.addr), next_fd.size);
+	if (next_fd.read)
+		cache_clear(virt_to_phys(next_fd.addr), next_fd.size);
+}
+
+static inline void next_fd_dma_stop(void)
+{
+	if (!next_fd.active)
+		return;
+	next_fd.active = false;
+
+	next_fd.residue = virt_to_phys(next_fd.addr) + next_fd.size -
+			  nextdma_reg_read(NEXTDMA_SCSI, NEXTDMA_REG_NEXT);
+	nextdma_reset(NEXTDMA_SCSI);
+	out_8(next_dev(NEXT_ESP_DMA_CTRL), NEXT_ESP_CTRL_IDLE);
+	out_8(next_dev(NEXT_FDC_CTRL), 0);
+	if (next_fd.read)
+		cache_clear(virt_to_phys(next_fd.addr), next_fd.size);
+	next_scsidma_release();
+}
+
+/*
+ * The controller must own the channel before it is given a command, or it
+ * overruns.  Called in work context, ahead of the DMA lock of the driver.
+ */
+static inline void next_fd_dma_claim(void)
+{
+	next_fd_dma_stop();
+	next_scsidma_claim();
+	next_fd.claimed = true;
+}
+
+static inline void next_fd_dma_start(void)
+{
+	u32 start = virt_to_phys(next_fd.addr);
+
+	out_8(next_dev(NEXT_FDC_CTRL), NEXT_FDC_CTRL_82077);
+	out_8(next_dev(NEXT_ESP_DMA_CTRL), NEXT_ESP_CTRL_DMA |
+	      (next_fd.read ? NEXT_ESP_CTRL_DMA_READ : 0));
+
+	nextdma_reset(NEXTDMA_SCSI);
+	nextdma_reg_write(NEXTDMA_SCSI, NEXTDMA_REG_NEXT, start);
+	nextdma_reg_write(NEXTDMA_SCSI, NEXTDMA_REG_LIMIT, start + next_fd.size);
+	nextdma_csr_write(NEXTDMA_SCSI, NEXTDMA_SETENABLE |
+			  (next_fd.read ? NEXTDMA_DEV2M : NEXTDMA_M2DEV));
+}
+
+static inline int next_fd_dma_setup(char *addr, unsigned long size, bool read)
+{
+	if (((unsigned long)addr | size) & (NEXTDMA_ALIGN - 1)) {
+		next_fd.claimed = false;
+		next_scsidma_release();
+		return -EINVAL;
+	}
+
+	next_fd.addr = addr;
+	next_fd.size = size;
+	next_fd.read = read;
+	next_fd.residue = 0;
+	next_fd.active = true;
+	next_fd.claimed = false;
+	next_fd_cache();
+	next_fd_dma_start();
+	return 0;
+}
+
+static inline int next_fd_init(void)
+{
+	/* The controller is optional on the 68030 */
+	if (!hwreg_present(next_dev(NEXT_FDC)))
+		return -1;
+	out_8(next_dev(NEXT_FDC_CTRL), 0);
+	return (int)(unsigned long)next_dev(NEXT_FDC);
+}
+
+#endif /* _ASM_M68K_NEXTFLOP_H */
diff --git a/arch/m68k/next/Makefile b/arch/m68k/next/Makefile
index d0c5d1a8cfa5..b6e70f4688d7 100644
--- a/arch/m68k/next/Makefile
+++ b/arch/m68k/next/Makefile
@@ -3,4 +3,4 @@
 # Makefile for Linux arch/m68k/next source directory
 #
 
-obj-y		:= config.o ints.o reset.o rtc.o time.o
+obj-y		:= config.o dma.o ints.o reset.o rtc.o time.o
diff --git a/arch/m68k/next/dma.c b/arch/m68k/next/dma.c
new file mode 100644
index 000000000000..b4049e1cbe24
--- /dev/null
+++ b/arch/m68k/next/dma.c
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The SCSI and floppy controllers share one DMA channel, which they own for
+ * one transfer at a time.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/completion.h>
+#include <linux/export.h>
+#include <linux/list.h>
+#include <linux/spinlock.h>
+
+#include <asm/nextdma.h>
+
+static DEFINE_SPINLOCK(scsidma_lock);
+static LIST_HEAD(scsidma_queue);
+static bool scsidma_busy;
+
+/* Run the job now if the channel is free, otherwise when it is released */
+void next_scsidma_request(struct next_scsidma_job *job)
+{
+	unsigned long flags;
+	bool idle;
+
+	spin_lock_irqsave(&scsidma_lock, flags);
+	idle = !scsidma_busy;
+	if (idle)
+		scsidma_busy = true;
+	else
+		list_add_tail(&job->list, &scsidma_queue);
+	spin_unlock_irqrestore(&scsidma_lock, flags);
+
+	if (idle)
+		job->start(job);
+}
+EXPORT_SYMBOL_GPL(next_scsidma_request);
+
+void next_scsidma_release(void)
+{
+	struct next_scsidma_job *job;
+	unsigned long flags;
+
+	spin_lock_irqsave(&scsidma_lock, flags);
+	job = list_first_entry_or_null(&scsidma_queue, struct next_scsidma_job, list);
+	if (job)
+		list_del_init(&job->list);
+	else
+		scsidma_busy = false;
+	spin_unlock_irqrestore(&scsidma_lock, flags);
+
+	if (job)
+		job->start(job);
+}
+EXPORT_SYMBOL_GPL(next_scsidma_release);
+
+/* Forget a job which has not run yet, returns false if it owns the channel */
+bool next_scsidma_cancel(struct next_scsidma_job *job)
+{
+	unsigned long flags;
+	bool queued;
+
+	spin_lock_irqsave(&scsidma_lock, flags);
+	queued = !list_empty(&job->list);
+	if (queued)
+		list_del_init(&job->list);
+	spin_unlock_irqrestore(&scsidma_lock, flags);
+	return queued;
+}
+EXPORT_SYMBOL_GPL(next_scsidma_cancel);
+
+struct next_scsidma_waiter {
+	struct next_scsidma_job job;
+	struct completion done;
+};
+
+static void next_scsidma_wake(struct next_scsidma_job *job)
+{
+	complete(&container_of(job, struct next_scsidma_waiter, job)->done);
+}
+
+/* Sleep until the channel is free, for users with no callback context */
+void next_scsidma_claim(void)
+{
+	struct next_scsidma_waiter w;
+
+	INIT_LIST_HEAD(&w.job.list);
+	w.job.start = next_scsidma_wake;
+	init_completion(&w.done);
+	next_scsidma_request(&w.job);
+	wait_for_completion(&w.done);
+}
+EXPORT_SYMBOL_GPL(next_scsidma_claim);
diff --git a/drivers/block/floppy.c b/drivers/block/floppy.c
index c677d783811f..7915303da338 100644
--- a/drivers/block/floppy.c
+++ b/drivers/block/floppy.c
@@ -1083,6 +1083,9 @@ static void setup_DMA(void)
 		fdc_state[current_fdc].reset = 1;
 		return;
 	}
+#ifdef fd_dma_claim
+	fd_dma_claim();
+#endif
 	f = claim_dma_lock();
 	fd_disable_dma();
 #ifdef fd_dma_setup
diff --git a/drivers/scsi/next_esp.c b/drivers/scsi/next_esp.c
index 193833ffaab5..cceebbcc7b93 100644
--- a/drivers/scsi/next_esp.c
+++ b/drivers/scsi/next_esp.c
@@ -48,6 +48,11 @@ struct next_esp_priv {
 	enum dma_data_direction dir;
 	bool mapped;
 	u8 ctrl;
+
+	/* The channel is shared with the floppy controller */
+	struct next_scsidma_job job;
+	struct esp *esp;
+	u8 cmd;
 };
 
 #define esp_read8(REG)		next_esp_read8(esp, REG)
@@ -91,7 +96,14 @@ static void next_esp_reset_dma(struct esp *esp)
 {
 	struct next_esp_priv *priv = next_esp_priv(esp);
 
-	nextdma_reset(NEXTDMA_SCSI);
+	if (priv->mapped) {
+		priv->mapped = false;
+		dma_unmap_single(esp->dev, priv->dma_addr, priv->dma_len, priv->dir);
+		if (!next_scsidma_cancel(&priv->job)) {
+			nextdma_reset(NEXTDMA_SCSI);
+			next_scsidma_release();
+		}
+	}
 	priv->ctrl = ESPCTRL_BASE;
 	next_esp_ctrl(esp, priv->ctrl);
 }
@@ -127,12 +139,32 @@ static void next_esp_dma_invalidate(struct esp *esp)
 	nextdma_reset(NEXTDMA_SCSI);
 	priv->ctrl = ESPCTRL_BASE;
 	next_esp_ctrl(esp, priv->ctrl);
+	next_scsidma_release();
 
 	dma_unmap_single(esp->dev, priv->dma_addr, priv->dma_len, priv->dir);
 	if (priv->buf == priv->bounce && priv->dir == DMA_FROM_DEVICE)
 		memcpy(priv->user, priv->bounce, priv->xfer_len - residual);
 }
 
+/* The ESP waits in the data phase while the floppy controller owns the channel */
+static void next_esp_dma_start(struct next_scsidma_job *job)
+{
+	struct next_esp_priv *priv = container_of(job, struct next_esp_priv, job);
+	struct esp *esp = priv->esp;
+	bool write = priv->dir == DMA_FROM_DEVICE;
+
+	priv->ctrl = ESPCTRL_BASE | ESPCTRL_MODE_DMA | (write ? ESPCTRL_DMA_READ : 0);
+	next_esp_ctrl(esp, priv->ctrl);
+
+	nextdma_reset(NEXTDMA_SCSI);
+	nextdma_reg_write(NEXTDMA_SCSI, NEXTDMA_REG_NEXT, priv->dma_addr);
+	nextdma_reg_write(NEXTDMA_SCSI, NEXTDMA_REG_LIMIT, priv->dma_addr + priv->dma_len);
+	nextdma_csr_write(NEXTDMA_SCSI, NEXTDMA_SETENABLE |
+			  (write ? NEXTDMA_DEV2M : NEXTDMA_M2DEV));
+
+	scsi_esp_cmd(esp, priv->cmd);
+}
+
 static void next_esp_send_dma_cmd(struct esp *esp, u32 addr, u32 esp_count,
 				  u32 dma_count, int write, u8 cmd)
 {
@@ -166,16 +198,8 @@ static void next_esp_send_dma_cmd(struct esp *esp, u32 addr, u32 esp_count,
 	esp_write8(esp_count & 0xff, ESP_TCLOW);
 	esp_write8((esp_count >> 8) & 0xff, ESP_TCMED);
 
-	priv->ctrl = ESPCTRL_BASE | ESPCTRL_MODE_DMA | (write ? ESPCTRL_DMA_READ : 0);
-	next_esp_ctrl(esp, priv->ctrl);
-
-	nextdma_reset(NEXTDMA_SCSI);
-	nextdma_reg_write(NEXTDMA_SCSI, NEXTDMA_REG_NEXT, priv->dma_addr);
-	nextdma_reg_write(NEXTDMA_SCSI, NEXTDMA_REG_LIMIT, priv->dma_addr + priv->dma_len);
-	nextdma_csr_write(NEXTDMA_SCSI, NEXTDMA_SETENABLE |
-			  (write ? NEXTDMA_DEV2M : NEXTDMA_M2DEV));
-
-	scsi_esp_cmd(esp, cmd);
+	priv->cmd = cmd;
+	next_scsidma_request(&priv->job);
 }
 
 static int next_esp_dma_error(struct esp *esp)
@@ -217,6 +241,8 @@ static int next_esp_probe(struct platform_device *pdev)
 	priv->bounce = devm_kmalloc(&pdev->dev, NEXT_ESP_BOUNCE_SIZE, GFP_KERNEL);
 	if (!priv->bounce)
 		return -ENOMEM;
+	INIT_LIST_HEAD(&priv->job.list);
+	priv->job.start = next_esp_dma_start;
 
 	host = scsi_host_alloc(&scsi_esp_template, sizeof(struct esp));
 	if (!host)
@@ -224,6 +250,7 @@ static int next_esp_probe(struct platform_device *pdev)
 
 	host->max_id = 8;
 	esp = shost_priv(host);
+	priv->esp = esp;
 	esp->host = host;
 	esp->dev = &pdev->dev;
 	esp->ops = &next_esp_ops;
-- 
2.54.0


From eda074e916a2470ffb941d252c0aad758d56ab0d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 02:48:04 +0100
Subject: [PATCH 13/35] m68k: next: Stop the Ethernet and DMA left running by
 the ROM
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

After netbooting the ROM leaves the Ethernet receiver and its DMA channel
running, with buffers near the top of memory.  Every later packet then
overwrites memory now owned by the kernel, showing up as random corruption
of user space code in the page cache.

Stop them in the loader, ahead of copying the kernel, and reset all channels
during kernel startup.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/next/boot/main.c | 13 +++++++++++++
 arch/m68k/next/config.c    | 35 ++++++++++++++++++++++-------------
 2 files changed, 35 insertions(+), 13 deletions(-)

diff --git a/arch/m68k/next/boot/main.c b/arch/m68k/next/boot/main.c
index 22a135a542e4..0dbc22f3859f 100644
--- a/arch/m68k/next/boot/main.c
+++ b/arch/m68k/next/boot/main.c
@@ -36,6 +36,14 @@
 /* The ROM keeps its data at the very top of memory */
 #define ROM_RESERVED	0x2000
 
+/* Ethernet and DMA channel the ROM used to load this image */
+#define ENET_RESET_REG	0x02006006
+#define ENET_RESET_ON	0x80
+#define BMAP_OFFSET	0x00100000
+#define DMA_ENET_TX_CSR	0x02000110
+#define DMA_ENET_RX_CSR	0x02000150
+#define DMA_CSR_RESET	0x00100000
+
 #define CHUNK_ALIGN_030	0x40000UL
 
 #define CMDLINE_SIZE	256
@@ -212,6 +220,11 @@ void next_boot(const char *mon_global)
 		return;
 	}
 
+	/* The ROM leaves receive DMA running, stray packets would hit the kernel */
+	*(volatile u8 *)(ENET_RESET_REG + (is_040 ? BMAP_OFFSET : 0)) = ENET_RESET_ON;
+	*(volatile u32 *)DMA_ENET_RX_CSR = DMA_CSR_RESET;
+	*(volatile u32 *)DMA_ENET_TX_CSR = DMA_CSR_RESET;
+
 	nchunks = get_memory(machine, chunks);
 	if (!nchunks) {
 		puts_rom("nextboot: no memory found\n");
diff --git a/arch/m68k/next/config.c b/arch/m68k/next/config.c
index 31dd1569d443..8a03d87ad0a3 100644
--- a/arch/m68k/next/config.c
+++ b/arch/m68k/next/config.c
@@ -41,6 +41,7 @@
 #define ENET_RESET_ON	0x80
 
 #define TMC_VIDEO	0x00200080
+#define TMC_ADB_INTMASK	0x00208008
 #define TMC_VI_CLEAR	0x01
 #define TMC_VI_ENABLE	0x04
 
@@ -90,15 +91,34 @@ static void next_get_model(char *model)
 		sprintf(model, "NeXT machine type %lu", next_machine);
 }
 
-/* Sources which the interrupt mask register cannot turn off */
+/*
+ * Stop all DMA the ROM left running, a stray packet would overwrite memory now
+ * owned by the kernel.  Also turn off interrupt sources which the mask register
+ * cannot control.
+ */
 static void next_quiesce(void)
 {
+	static const unsigned int chans[] = {
+		NEXTDMA_SCSI, NEXTDMA_SOUND_OUT, NEXTDMA_DISK, NEXTDMA_SOUND_IN,
+		NEXTDMA_PRINTER, NEXTDMA_ENET_TX, NEXTDMA_ENET_RX,
+	};
+	int i;
+
+	out_8(next_dev(NEXT_ENET) + ENET_RESET, ENET_RESET_ON);
+	for (i = 0; i < ARRAY_SIZE(chans); i++) {
+		/* Turbo models have no optical drive channel */
+		if (chans[i] != NEXTDMA_DISK || !next_is_turbo())
+			nextdma_reset(chans[i]);
+	}
+
 	out_8(next_dev(NEXT_ESP) + ESP_DMA_CTRL, ESP_CTRL_CLK20);
 	out_8(next_dev(NEXT_ESP) + ESP_CMD, ESP_CMD_RESET);
 	out_8(next_dev(NEXT_ENET) + ENET_TXMASK, 0);
 	out_8(next_dev(NEXT_ENET) + ENET_RXMASK, 0);
-	if (next_is_turbo())
+	if (next_is_turbo()) {
 		out_8(next_io(TMC_VIDEO), TMC_VI_ENABLE | TMC_VI_CLEAR);
+		out_be32(next_io(TMC_ADB_INTMASK), 0);
+	}
 	else if (next_is_color())
 		out_8(next_dev(NEXT_C16_CMD), C16_UNBLANK | C16_CLEAR_INT);
 }
@@ -139,27 +159,16 @@ static void __init next_scc_setup(void)
  */
 static void next_reset(void)
 {
-	static const unsigned int chans[] = {
-		NEXTDMA_SCSI, NEXTDMA_SOUND_OUT, NEXTDMA_DISK, NEXTDMA_SOUND_IN,
-		NEXTDMA_PRINTER, NEXTDMA_ENET_TX, NEXTDMA_ENET_RX,
-	};
 	void __iomem *scc = next_dev(NEXT_SCC);
-	int i;
 
 	local_irq_disable();
 	out_be32(next_io(NEXT_INTRMASK), 0);
 
 	next_quiesce();
-	out_8(next_dev(NEXT_ENET) + ENET_RESET, ENET_RESET_ON);
 	in_8(scc + SCC_CTRL_A);
 	out_8(scc + SCC_CTRL_A, 9);
 	out_8(scc + SCC_CTRL_A, 0xc0);
 	out_8(next_dev(NEXT_TIMER_CSR), 0);
-	for (i = 0; i < ARRAY_SIZE(chans); i++) {
-		/* Turbo models have no optical drive channel */
-		if (chans[i] != NEXTDMA_DISK || !next_is_turbo())
-			nextdma_reset(chans[i]);
-	}
 
 	next_rom_reset(virt_to_phys((void *)next_rom_reset_stub),
 		       next_machine == NEXT_MACH_CUBE030 ? 0 : 0x01000000);
-- 
2.54.0


From 46b9854a6dedb3818983b6d31a66bd4b021591c6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 02:48:24 +0100
Subject: [PATCH 14/35] macintosh: Add ADB controller driver for NeXT Turbo
 models
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The automatic polling of the controller is broken in hardware, as noted by
the Previous emulator authors, so devices are polled from a timer.  Bus
transactions finish with the access interrupt status bit.

The chrp and powermac check in adbhid only applies to PowerPC.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/next_defconfig |   5 +
 drivers/macintosh/Kconfig        |  11 +-
 drivers/macintosh/Makefile       |   1 +
 drivers/macintosh/adb-next.c     | 257 +++++++++++++++++++++++++++++++
 drivers/macintosh/adb.c          |   6 +-
 drivers/macintosh/adbhid.c       |   2 +-
 6 files changed, 278 insertions(+), 4 deletions(-)
 create mode 100644 drivers/macintosh/adb-next.c

diff --git a/arch/m68k/configs/next_defconfig b/arch/m68k/configs/next_defconfig
index 79f22525a2cb..3d95ead69b39 100644
--- a/arch/m68k/configs/next_defconfig
+++ b/arch/m68k/configs/next_defconfig
@@ -42,6 +42,11 @@ CONFIG_VT=y
 CONFIG_VT_CONSOLE=y
 CONFIG_INPUT_EVDEV=y
 CONFIG_KEYBOARD_NEXT=y
+CONFIG_MACINTOSH_DRIVERS=y
+CONFIG_ADB=y
+CONFIG_ADB_NEXT=y
+CONFIG_INPUT_ADBHID=y
+CONFIG_INPUT_MOUSEDEV=y
 CONFIG_FB=y
 CONFIG_FB_NEXT=y
 CONFIG_FRAMEBUFFER_CONSOLE=y
diff --git a/drivers/macintosh/Kconfig b/drivers/macintosh/Kconfig
index d00e713c1092..f5c1d26751dd 100644
--- a/drivers/macintosh/Kconfig
+++ b/drivers/macintosh/Kconfig
@@ -2,7 +2,7 @@
 
 menuconfig MACINTOSH_DRIVERS
 	bool "Macintosh device drivers"
-	depends on PPC || MAC || X86
+	depends on PPC || MAC || X86 || NEXT
 	default y if (PPC_PMAC || MAC)
 	help
 	  Say Y here to get to see options for devices used with Macintosh
@@ -14,7 +14,7 @@ if MACINTOSH_DRIVERS
 
 config ADB
 	bool "Apple Desktop Bus (ADB) support"
-	depends on MAC || (PPC_PMAC && PPC32)
+	depends on MAC || NEXT || (PPC_PMAC && PPC32)
 	help
 	  Apple Desktop Bus (ADB) support is for support of devices which
 	  are connected to an ADB port.  ADB devices tend to have 4 pins.
@@ -22,6 +22,13 @@ config ADB
 	  PowerBook, or a "Blue and White G3", you probably want to say Y
 	  here.  Otherwise say N.
 
+config ADB_NEXT
+	bool "NeXT Turbo ADB controller"
+	depends on ADB && NEXT
+	help
+	  Say Y here for the Apple Desktop Bus controller of the NeXT Turbo
+	  models with a keyboard and mouse on ADB.
+
 config ADB_MACII
 	bool "Include Mac II ADB driver"
 	depends on ADB && MAC
diff --git a/drivers/macintosh/Makefile b/drivers/macintosh/Makefile
index 712edcb3e0b0..3b98b0e1e94c 100644
--- a/drivers/macintosh/Makefile
+++ b/drivers/macintosh/Makefile
@@ -21,6 +21,7 @@ obj-$(CONFIG_PMAC_APM_EMU)	+= apm_emu.o
 obj-$(CONFIG_PMAC_SMU)		+= smu.o
 
 obj-$(CONFIG_ADB)		+= adb.o
+obj-$(CONFIG_ADB_NEXT)		+= adb-next.o
 obj-$(CONFIG_ADB_MACII)		+= via-macii.o
 obj-$(CONFIG_ADB_IOP)		+= adb-iop.o
 obj-$(CONFIG_ADB_MACIO)		+= macio-adb.o
diff --git a/drivers/macintosh/adb-next.c b/drivers/macintosh/adb-next.c
new file mode 100644
index 000000000000..8a585b9414d4
--- /dev/null
+++ b/drivers/macintosh/adb-next.c
@@ -0,0 +1,257 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple Desktop Bus controller of NeXT Turbo models.
+ *
+ * The automatic polling of the controller does not work in hardware, so all
+ * devices are polled by software from a timer.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/adb.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/list.h>
+#include <linux/spinlock.h>
+#include <linux/timer.h>
+#include <linux/unaligned.h>
+
+#include <asm/next.h>
+
+#define NEXT_ADB		0x00208000
+
+#define ADB_INTSTATUS		0x00
+#define ADB_CTRL		0x20
+#define ADB_STATUS		0x28
+#define ADB_CMD			0x30
+#define ADB_COUNT		0x38
+#define ADB_DATA0		0x80
+#define ADB_DATA1		0x88
+
+/* Set when a bus transaction has ended, write one to clear */
+#define ADB_INT_ACCESS		0x04
+
+#define ADB_CTRL_DIS_POLL	0x02
+#define ADB_CTRL_XMIT_CMD	0x04
+#define ADB_CTRL_RESET_ADB	0x08
+
+#define ADB_STAT_DATAPEND	0x08
+
+#define ADB_DATA_MAX		8
+#define ADB_POLL_INTERVAL	(HZ / 50)
+#define ADB_NR_DEVS		16
+#define ADB_SYNC_LOOPS		100000
+
+static DEFINE_SPINLOCK(next_adb_lock);
+static struct adb_request *req_head, *req_tail;
+static struct adb_request *req_cur;
+static struct timer_list next_adb_timer;
+static unsigned int autopoll_devs;
+static unsigned int poll_dev;
+static bool cmd_active;
+static u8 cmd_cur;
+
+static u32 next_adb_read(unsigned int reg)
+{
+	return in_be32(next_io(NEXT_ADB + reg));
+}
+
+static void next_adb_write(unsigned int reg, u32 val)
+{
+	out_be32(next_io(NEXT_ADB + reg), val);
+}
+
+static void next_adb_xmit(u8 cmd, const u8 *data, unsigned int len)
+{
+	u8 buf[ADB_DATA_MAX] = { 0 };
+
+	if (len > ADB_DATA_MAX)
+		len = ADB_DATA_MAX;
+	if (len)
+		memcpy(buf, data, len);
+
+	next_adb_write(ADB_DATA0, get_unaligned_be32(buf));
+	next_adb_write(ADB_DATA1, get_unaligned_be32(buf + 4));
+	next_adb_write(ADB_COUNT, len * 8);
+	next_adb_write(ADB_CMD, cmd);
+	next_adb_write(ADB_INTSTATUS, ADB_INT_ACCESS);
+	next_adb_write(ADB_CTRL, ADB_CTRL_XMIT_CMD);
+
+	cmd_cur = cmd;
+	cmd_active = true;
+}
+
+static void next_adb_start_next(void)
+{
+	struct adb_request *req = req_head;
+	unsigned int i;
+
+	if (cmd_active)
+		return;
+
+	if (req) {
+		req_head = req->next;
+		if (!req_head)
+			req_tail = NULL;
+		req_cur = req;
+		/* Byte 0 selects the ADB protocol, the bus command follows */
+		next_adb_xmit(req->data[1], req->data + 2, req->nbytes - 2);
+		return;
+	}
+
+	for (i = 0; i < ADB_NR_DEVS; i++) {
+		poll_dev = (poll_dev + 1) % ADB_NR_DEVS;
+		if (autopoll_devs & BIT(poll_dev)) {
+			next_adb_xmit(ADB_READREG(poll_dev, 0), NULL, 0);
+			return;
+		}
+	}
+}
+
+/* Complete a finished bus transaction, returns false if it is still running */
+static bool next_adb_finish(void)
+{
+	struct adb_request *req = req_cur;
+	u8 reply[ADB_DATA_MAX + 1];
+	unsigned int len = 0;
+	u32 stat;
+
+	if (!cmd_active)
+		return true;
+
+	if (!(next_adb_read(ADB_INTSTATUS) & ADB_INT_ACCESS))
+		return false;
+
+	stat = next_adb_read(ADB_STATUS);
+	if (stat & ADB_STAT_DATAPEND) {
+		len = min_t(unsigned int, next_adb_read(ADB_COUNT) >> 3, ADB_DATA_MAX);
+		put_unaligned_be32(next_adb_read(ADB_DATA0), reply + 1);
+		put_unaligned_be32(next_adb_read(ADB_DATA1), reply + 5);
+	}
+	reply[0] = cmd_cur;
+	cmd_active = false;
+
+	if (req) {
+		req_cur = NULL;
+		req->reply_len = 0;
+		if (len && req->reply_expected) {
+			memcpy(req->reply, reply, len + 1);
+			req->reply_len = len + 1;
+		}
+		req->complete = 1;
+		if (req->done) {
+			spin_unlock(&next_adb_lock);
+			req->done(req);
+			spin_lock(&next_adb_lock);
+		}
+	} else if (len) {
+		spin_unlock(&next_adb_lock);
+		adb_input(reply, len + 1, 1);
+		spin_lock(&next_adb_lock);
+	}
+	return true;
+}
+
+static void next_adb_tick(void)
+{
+	if (next_adb_finish())
+		next_adb_start_next();
+}
+
+static void next_adb_timer_func(struct timer_list *t)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&next_adb_lock, flags);
+	next_adb_tick();
+	spin_unlock_irqrestore(&next_adb_lock, flags);
+	mod_timer(&next_adb_timer, jiffies + ADB_POLL_INTERVAL);
+}
+
+static int next_adb_probe(void)
+{
+	return MACH_IS_NEXT && next_is_turbo() ? 0 : -ENODEV;
+}
+
+static int next_adb_init(void)
+{
+	next_adb_write(ADB_CTRL, ADB_CTRL_DIS_POLL);
+	timer_setup(&next_adb_timer, next_adb_timer_func, 0);
+	mod_timer(&next_adb_timer, jiffies + ADB_POLL_INTERVAL);
+	return 0;
+}
+
+static void next_adb_poll(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&next_adb_lock, flags);
+	next_adb_tick();
+	spin_unlock_irqrestore(&next_adb_lock, flags);
+}
+
+static int next_adb_send_request(struct adb_request *req, int sync)
+{
+	unsigned long flags;
+	int loops = ADB_SYNC_LOOPS;
+
+	if (req->nbytes < 2 || req->data[0] != ADB_PACKET ||
+	    req->nbytes > ADB_DATA_MAX + 2) {
+		req->complete = 1;
+		return -EINVAL;
+	}
+
+	req->next = NULL;
+	req->sent = 0;
+	req->complete = 0;
+	req->reply_len = 0;
+
+	spin_lock_irqsave(&next_adb_lock, flags);
+	if (req_tail)
+		req_tail->next = req;
+	else
+		req_head = req;
+	req_tail = req;
+	next_adb_tick();
+	spin_unlock_irqrestore(&next_adb_lock, flags);
+
+	if (sync) {
+		while (!req->complete && --loops) {
+			next_adb_poll();
+			udelay(10);
+		}
+		if (!req->complete)
+			return -EIO;
+	}
+	return 0;
+}
+
+static int next_adb_autopoll(int devs)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&next_adb_lock, flags);
+	autopoll_devs = devs & 0xfffe;
+	spin_unlock_irqrestore(&next_adb_lock, flags);
+	return 0;
+}
+
+static int next_adb_reset_bus(void)
+{
+	next_adb_write(ADB_CTRL, ADB_CTRL_RESET_ADB);
+	return 0;
+}
+
+struct adb_driver next_adb_driver = {
+	.name		= "NeXT",
+	.probe		= next_adb_probe,
+	.init		= next_adb_init,
+	.send_request	= next_adb_send_request,
+	.autopoll	= next_adb_autopoll,
+	.poll		= next_adb_poll,
+	.reset_bus	= next_adb_reset_bus,
+};
diff --git a/drivers/macintosh/adb.c b/drivers/macintosh/adb.c
index fe150125e099..9279728e1ff7 100644
--- a/drivers/macintosh/adb.c
+++ b/drivers/macintosh/adb.c
@@ -49,6 +49,7 @@
 EXPORT_SYMBOL(adb_client_list);
 
 extern struct adb_driver via_macii_driver;
+extern struct adb_driver next_adb_driver;
 extern struct adb_driver via_cuda_driver;
 extern struct adb_driver adb_iop_driver;
 extern struct adb_driver via_pmu_driver;
@@ -56,6 +57,9 @@ extern struct adb_driver macio_adb_driver;
 
 static DEFINE_MUTEX(adb_mutex);
 static struct adb_driver *adb_driver_list[] = {
+#ifdef CONFIG_ADB_NEXT
+	&next_adb_driver,
+#endif
 #ifdef CONFIG_ADB_MACII
 	&via_macii_driver,
 #endif
@@ -316,7 +320,7 @@ static int __init adb_init(void)
 		return 0;
 #endif
 #ifdef CONFIG_MAC
-	if (!MACH_IS_MAC)
+	if (!MACH_IS_MAC && !MACH_IS_NEXT)
 		return 0;
 #endif
 
diff --git a/drivers/macintosh/adbhid.c b/drivers/macintosh/adbhid.c
index 6155da58091b..48ecc7c8e2b3 100644
--- a/drivers/macintosh/adbhid.c
+++ b/drivers/macintosh/adbhid.c
@@ -1250,7 +1250,7 @@ init_ms_a3(int id)
 
 static int __init adbhid_init(void)
 {
-#ifndef CONFIG_MAC
+#ifdef CONFIG_PPC
 	if (!machine_is(chrp) && !machine_is(powermac))
 		return 0;
 #endif
-- 
2.54.0


From 55ecd9a3dff4acac28fd142bcd282988050d3059 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 02:55:18 +0100
Subject: [PATCH 15/35] fbdev: nextfb: Add blanking and monitor brightness
 control
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The monochrome monitor has a 6 bit brightness level and an unblank bit in one
register.  Color and Turbo models have only the unblank bit, in their display
command registers.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/video/fbdev/Kconfig  |  1 +
 drivers/video/fbdev/nextfb.c | 69 ++++++++++++++++++++++++++++++++++++
 2 files changed, 70 insertions(+)

diff --git a/drivers/video/fbdev/Kconfig b/drivers/video/fbdev/Kconfig
index ac862090d99a..33ca85d04c6a 100644
--- a/drivers/video/fbdev/Kconfig
+++ b/drivers/video/fbdev/Kconfig
@@ -201,6 +201,7 @@ config FB_Q40
 config FB_NEXT
 	bool "NeXT framebuffer support"
 	depends on (FB = y) && NEXT
+	select BACKLIGHT_CLASS_DEVICE
 	select FB_CFB_FILLRECT
 	select FB_CFB_COPYAREA
 	select FB_CFB_IMAGEBLIT
diff --git a/drivers/video/fbdev/nextfb.c b/drivers/video/fbdev/nextfb.c
index 1e734856e64e..8303b233399f 100644
--- a/drivers/video/fbdev/nextfb.c
+++ b/drivers/video/fbdev/nextfb.c
@@ -6,6 +6,7 @@
  * Copyright (C) 2026 René Rebe <rene@exactco.de>
  */
 
+#include <linux/backlight.h>
 #include <linux/fb.h>
 #include <linux/init.h>
 #include <linux/io.h>
@@ -21,8 +22,58 @@
 #define NEXTFB_PITCH(turbo)	((turbo) ? NEXTFB_WIDTH : NEXTFB_WIDTH + 32)
 #define MONO_INVERT	3
 
+/* Display control: brightness on the monochrome monitor, unblank everywhere */
+#define NEXT_BRIGHTNESS		0x00010000
+#define BRIGHTNESS_UNBLANK	0x40
+#define BRIGHTNESS_MASK		0x3f
+#define BRIGHTNESS_DEFAULT	0x3d
+
+#define NEXT_C16_CMD_UNBLANK	0x04
+
+#define TMC_VIDEO		0x00200080
+#define TMC_VIDEO_UNBLANK	0x04
+
 struct nextfb_par {
 	u32 palette[16];
+	struct backlight_device *bl;
+	int brightness;
+	bool blanked;
+};
+
+static void nextfb_update_display(struct nextfb_par *par)
+{
+	bool on = !par->blanked;
+
+	if (next_is_turbo()) {
+		out_8(next_io(TMC_VIDEO), on ? TMC_VIDEO_UNBLANK : 0);
+	} else if (next_is_color()) {
+		out_8(next_dev(NEXT_C16_CMD), on ? NEXT_C16_CMD_UNBLANK : 0);
+	} else {
+		out_8(next_dev(NEXT_BRIGHTNESS),
+		      (on ? BRIGHTNESS_UNBLANK : 0) | par->brightness);
+	}
+}
+
+static int nextfb_blank(int blank, struct fb_info *info)
+{
+	struct nextfb_par *par = info->par;
+
+	par->blanked = blank != FB_BLANK_UNBLANK;
+	nextfb_update_display(par);
+	return 0;
+}
+
+static int nextfb_bl_update(struct backlight_device *bl)
+{
+	struct nextfb_par *par = bl_get_data(bl);
+
+	par->brightness = backlight_get_brightness(bl);
+	nextfb_update_display(par);
+	return 0;
+}
+
+static const struct backlight_ops nextfb_bl_ops = {
+	.update_status	= nextfb_bl_update,
 };
 
 static int nextfb_setcolreg(unsigned int regno, unsigned int red,
@@ -64,6 +115,7 @@ static const struct fb_ops nextfb_ops = {
 	.owner		= THIS_MODULE,
 	__FB_DEFAULT_IOMEM_OPS_RDWR,
 	.fb_setcolreg	= nextfb_setcolreg,
+	.fb_blank	= nextfb_blank,
 	.fb_fillrect	= nextfb_fillrect,
 	.fb_copyarea	= cfb_copyarea,
 	.fb_imageblit	= nextfb_imageblit,
@@ -127,6 +179,23 @@ static int nextfb_probe(struct platform_device *pdev)
 	if (ret)
 		goto err_unmap;
 
+	par->brightness = BRIGHTNESS_DEFAULT;
+
+	/* Only the monochrome monitor has brightness under software control */
+	if (!color && !turbo) {
+		struct backlight_properties props = {
+			.type		= BACKLIGHT_RAW,
+			.max_brightness	= BRIGHTNESS_MASK,
+			.brightness	= BRIGHTNESS_DEFAULT,
+		};
+
+		par->bl = devm_backlight_device_register(&pdev->dev, "nextfb",
+							 &pdev->dev, par,
+							 &nextfb_bl_ops, &props);
+		if (IS_ERR(par->bl))
+			par->bl = NULL;
+	}
+
 	ret = register_framebuffer(info);
 	if (ret)
 		goto err_cmap;
-- 
2.54.0


From 1a3b55166b7eb1c06e0d38bfddfaa603fd680f7a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 02:55:18 +0100
Subject: [PATCH 16/35] leds: Add NeXT status LED driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The front panel LED is a bit in system control register 2, with the
heartbeat trigger as a default.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/next_defconfig |  6 ++++
 arch/m68k/next/config.c          |  1 +
 drivers/leds/Kconfig             |  7 +++++
 drivers/leds/Makefile            |  1 +
 drivers/leds/leds-next.c         | 53 ++++++++++++++++++++++++++++++++
 5 files changed, 68 insertions(+)
 create mode 100644 drivers/leds/leds-next.c

diff --git a/arch/m68k/configs/next_defconfig b/arch/m68k/configs/next_defconfig
index 3d95ead69b39..24b7372b80f9 100644
--- a/arch/m68k/configs/next_defconfig
+++ b/arch/m68k/configs/next_defconfig
@@ -59,6 +59,12 @@ CONFIG_SND=y
 CONFIG_SND_OSSEMUL=y
 CONFIG_SND_PCM_OSS=y
 CONFIG_SND_NEXT=y
+CONFIG_NEW_LEDS=y
+CONFIG_LEDS_CLASS=y
+CONFIG_LEDS_NEXT=y
+CONFIG_LEDS_TRIGGERS=y
+CONFIG_LEDS_TRIGGER_HEARTBEAT=y
+CONFIG_BACKLIGHT_CLASS_DEVICE=y
 CONFIG_RTC_CLASS=y
 CONFIG_RTC_HCTOSYS=y
 CONFIG_RTC_DRV_NEXT=y
diff --git a/arch/m68k/next/config.c b/arch/m68k/next/config.c
index 8a03d87ad0a3..0279d78331d7 100644
--- a/arch/m68k/next/config.c
+++ b/arch/m68k/next/config.c
@@ -215,6 +215,7 @@ static int __init next_platform_init(void)
 	platform_device_register_simple("mb8795", -1, NULL, 0);
 	platform_device_register_simple("next_snd", -1, NULL, 0);
 	platform_device_register_simple("rtc-next", -1, NULL, 0);
+	platform_device_register_simple("leds-next", -1, NULL, 0);
 
 	return 0;
 }
diff --git a/drivers/leds/Kconfig b/drivers/leds/Kconfig
index 7ec2c8d78542..80b1d89d7e9c 100644
--- a/drivers/leds/Kconfig
+++ b/drivers/leds/Kconfig
@@ -317,6 +317,13 @@ config LEDS_MT6323
 	  This option enables support for on-chip LED drivers found on
 	  Mediatek MT6323 PMIC.
 
+config LEDS_NEXT
+	tristate "NeXT status LED"
+	depends on LEDS_CLASS && NEXT
+	help
+	  This option enables support for the status LED of the NeXT
+	  computers.
+
 config LEDS_NET48XX
 	tristate "LED Support for Soekris net48xx series Error LED"
 	depends on LEDS_CLASS
diff --git a/drivers/leds/Makefile b/drivers/leds/Makefile
index 4d4b089156e2..f1e614db9fe6 100644
--- a/drivers/leds/Makefile
+++ b/drivers/leds/Makefile
@@ -73,6 +73,7 @@ obj-$(CONFIG_LEDS_MIKROTIK_RB532)	+= leds-rb532.o
 obj-$(CONFIG_LEDS_MLXCPLD)		+= leds-mlxcpld.o
 obj-$(CONFIG_LEDS_MLXREG)		+= leds-mlxreg.o
 obj-$(CONFIG_LEDS_MT6323)		+= leds-mt6323.o
+obj-$(CONFIG_LEDS_NEXT)			+= leds-next.o
 obj-$(CONFIG_LEDS_NET48XX)		+= leds-net48xx.o
 obj-$(CONFIG_LEDS_NETXBIG)		+= leds-netxbig.o
 obj-$(CONFIG_LEDS_NIC78BX)		+= leds-nic78bx.o
diff --git a/drivers/leds/leds-next.c b/drivers/leds/leds-next.c
new file mode 100644
index 000000000000..f14f1b156c33
--- /dev/null
+++ b/drivers/leds/leds-next.c
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * NeXT status LED in system control register 2.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/io.h>
+#include <linux/leds.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include <asm/next.h>
+
+#define SCR2_LED_BYTE	(NEXT_SCR2 + 3)
+#define SCR2_LED	0x01
+
+static DEFINE_SPINLOCK(next_led_lock);
+
+static void next_led_set(struct led_classdev *cdev, enum led_brightness value)
+{
+	void __iomem *reg = next_io(SCR2_LED_BYTE);
+	unsigned long flags;
+	u8 val;
+
+	spin_lock_irqsave(&next_led_lock, flags);
+	val = in_8(reg);
+	out_8(reg, value ? val | SCR2_LED : val & ~SCR2_LED);
+	spin_unlock_irqrestore(&next_led_lock, flags);
+}
+
+static struct led_classdev next_led = {
+	.name			= "next:status",
+	.max_brightness		= 1,
+	.brightness_set		= next_led_set,
+	.default_trigger	= "heartbeat",
+};
+
+static int next_led_probe(struct platform_device *pdev)
+{
+	return devm_led_classdev_register(&pdev->dev, &next_led);
+}
+
+static struct platform_driver next_led_driver = {
+	.probe	= next_led_probe,
+	.driver	= {
+		.name = "leds-next",
+	},
+};
+module_platform_driver(next_led_driver);
+
+MODULE_DESCRIPTION("NeXT status LED driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 01ef351068a3f58382bbcde5d884076392ee6c1f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 03:16:40 +0100
Subject: [PATCH 17/35] block: Add NeXT magneto-optical disk driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Fujitsu MB600310 controller drives the 256 MB optical disk drive of the
NeXT Computer.  The head follows a continuous spiral and the formatter waits
for the sector ID it was given, so it has to be armed before the spiral
starts, and a transfer seeks one track ahead of its first sector.  Writing
takes an erase and a write pass, the controller handles the ECC.

Transfers are synchronous in a blocking blk-mq queue, through one DMA buffer
for the channel's 16 byte bursts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/next_defconfig |   1 +
 arch/m68k/next/config.c          |   1 +
 drivers/block/Kconfig            |  10 +
 drivers/block/Makefile           |   1 +
 drivers/block/next_mo.c          | 438 +++++++++++++++++++++++++++++++
 5 files changed, 451 insertions(+)
 create mode 100644 drivers/block/next_mo.c

diff --git a/arch/m68k/configs/next_defconfig b/arch/m68k/configs/next_defconfig
index 24b7372b80f9..ec73284f064a 100644
--- a/arch/m68k/configs/next_defconfig
+++ b/arch/m68k/configs/next_defconfig
@@ -28,6 +28,7 @@ CONFIG_DEVTMPFS=y
 CONFIG_DEVTMPFS_MOUNT=y
 CONFIG_BLK_DEV=y
 CONFIG_BLK_DEV_FD=y
+CONFIG_BLK_DEV_NEXT_MO=y
 CONFIG_BLK_DEV_LOOP=y
 CONFIG_BLK_DEV_SD=y
 CONFIG_SCSI=y
diff --git a/arch/m68k/next/config.c b/arch/m68k/next/config.c
index 0279d78331d7..28b343c12075 100644
--- a/arch/m68k/next/config.c
+++ b/arch/m68k/next/config.c
@@ -216,6 +216,7 @@ static int __init next_platform_init(void)
 	platform_device_register_simple("next_snd", -1, NULL, 0);
 	platform_device_register_simple("rtc-next", -1, NULL, 0);
 	platform_device_register_simple("leds-next", -1, NULL, 0);
+	platform_device_register_simple("next_mo", -1, NULL, 0);
 
 	return 0;
 }
diff --git a/drivers/block/Kconfig b/drivers/block/Kconfig
index 858320b6ebb7..b370d2857c12 100644
--- a/drivers/block/Kconfig
+++ b/drivers/block/Kconfig
@@ -34,6 +34,16 @@ config BLK_DEV_FD
 	  To compile this driver as a module, choose M here: the
 	  module will be called floppy.
 
+config BLK_DEV_NEXT_MO
+	tristate "NeXT magneto-optical disk support"
+	depends on NEXT
+	help
+	  Say Y here for the 256 MB magneto-optical disk drive of the NeXT
+	  computers.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called next_mo.
+
 config BLK_DEV_FD_RAWCMD
 	bool "Support for raw floppy disk commands (DEPRECATED)"
 	depends on BLK_DEV_FD
diff --git a/drivers/block/Makefile b/drivers/block/Makefile
index 2d8096eb8cdf..82e5b691ffe8 100644
--- a/drivers/block/Makefile
+++ b/drivers/block/Makefile
@@ -12,6 +12,7 @@ ccflags-y				+= -I$(src)
 obj-$(CONFIG_MAC_FLOPPY)	+= swim3.o
 obj-$(CONFIG_BLK_DEV_SWIM)	+= swim_mod.o
 obj-$(CONFIG_BLK_DEV_FD)	+= floppy.o
+obj-$(CONFIG_BLK_DEV_NEXT_MO)	+= next_mo.o
 obj-$(CONFIG_AMIGA_FLOPPY)	+= amiflop.o
 obj-$(CONFIG_PS3_DISK)		+= ps3disk.o
 obj-$(CONFIG_PS3_VRAM)		+= ps3vram.o
diff --git a/drivers/block/next_mo.c b/drivers/block/next_mo.c
new file mode 100644
index 000000000000..96ad515a3515
--- /dev/null
+++ b/drivers/block/next_mo.c
@@ -0,0 +1,438 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * NeXT magneto-optical disk drive with the Fujitsu MB600310 controller (OSP).
+ *
+ * The head follows a continuous spiral and the formatter waits for the sector
+ * ID it was given, so a transfer seeks one track ahead of its first sector.
+ * Writing takes an erase and a write pass, the controller adds the ECC.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/blk-mq.h>
+#include <linux/blkdev.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include <asm/next.h>
+#include <asm/nextdma.h>
+
+#define NEXT_OSP		0x00012000
+#define IRQ_NEXT_DISK		NEXT_IRQ(13)
+
+/* Controller registers */
+#define OSP_TRACK_H		0x00
+#define OSP_TRACK_L		0x01
+#define OSP_SECTOR		0x02	/* increment in the high nibble */
+#define OSP_COUNT		0x03
+#define OSP_INTSTAT		0x04
+#define OSP_INTMASK		0x05
+#define OSP_CSR2		0x06
+#define OSP_CSR1		0x07
+#define OSP_DRIVE_H		0x08
+#define OSP_DRIVE_L		0x09
+#define OSP_ERRSTAT		0x0a
+#define OSP_INIT		0x0c
+#define OSP_FORMAT		0x0d
+
+#define INT_CMD_COMPL		0x01
+#define INT_ATTN		0x02
+#define INT_OPER_COMPL		0x04
+#define INT_ECC_DONE		0x08
+#define INT_TIMEOUT		0x10
+#define INT_READ_FAULT		0x20
+#define INT_PARITY		0x40
+#define INT_DATA_ERR		0x80
+#define INT_CLEAR		0xfc
+#define INT_ERRORS		(INT_TIMEOUT | INT_READ_FAULT | INT_PARITY | INT_DATA_ERR)
+
+#define CSR2_CLR_BUF		0x08
+
+#define FMT_RESET		0x00
+#define FMT_RD_STAT		0x20
+#define FMT_ERASE		0x04
+#define FMT_READ		0x02
+#define FMT_WRITE		0x01
+
+#define INIT_ID_ALL		0x03
+#define INIT_25MHZ		0x10
+#define FORMAT_NOMINAL		0x36
+
+/* Drive commands */
+#define DRV_SEEK		0x0000
+#define DRV_HIGH_SEEK		0xa000
+#define DRV_RECAL		0x1000
+#define DRV_STATUS		0x2000
+#define DRV_READ_HEAD		0x4100
+#define DRV_WRITE_HEAD		0x4300
+#define DRV_ERASE_HEAD		0x4400
+#define DRV_RESET_ATTN		0x5000
+#define DRV_START_MOTOR		0x5300
+#define DRV_SPIRAL_ON		0x5900
+#define DRV_SPIRAL_OFF		0x5a00
+
+#define DS_STOPPED		0x0200
+#define DS_WP			0x2000
+#define DS_EMPTY		0x4000
+
+/* Disk layout */
+#define MO_SECTOR_SIZE		1024
+#define MO_SEC_PER_TRACK	16
+#define MO_TRACK_OFFSET		4096
+#define MO_TRACKS		(19819 - MO_TRACK_OFFSET)
+#define MO_SECTORS		(MO_TRACKS * MO_SEC_PER_TRACK)
+
+#define MO_MAX_XFER		32
+#define MO_BUF_SIZE		(MO_MAX_XFER * MO_SECTOR_SIZE)
+
+#define MO_CMD_SPIN_US		1000
+#define MO_CMD_TIMEOUT_MS	3000
+#define MO_OPER_TIMEOUT		(5 * HZ)
+#define MO_RETRIES		2
+
+struct next_mo {
+	struct device *dev;
+	void __iomem *regs;
+	struct gendisk *disk;
+	struct blk_mq_tag_set tag_set;
+	struct completion done;
+	void *buf;
+	dma_addr_t buf_dma;
+	u8 wait_mask;
+};
+
+static irqreturn_t next_mo_interrupt(int irq, void *dev_id)
+{
+	struct next_mo *mo = dev_id;
+	u8 stat = in_8(mo->regs + OSP_INTSTAT);
+
+	if (!(stat & in_8(mo->regs + OSP_INTMASK)))
+		return IRQ_NONE;
+
+	/* All awaited conditions arrived, or something went wrong */
+	if ((stat & mo->wait_mask) == mo->wait_mask || (stat & (INT_ERRORS | INT_ATTN))) {
+		out_8(mo->regs + OSP_INTMASK, 0);
+		complete(&mo->done);
+	} else {
+		out_8(mo->regs + OSP_INTMASK, (mo->wait_mask & ~stat) | INT_ERRORS | INT_ATTN);
+	}
+	return IRQ_HANDLED;
+}
+
+static int next_mo_cmd_status(struct next_mo *mo)
+{
+	u8 stat = in_8(mo->regs + OSP_INTSTAT);
+
+	if (stat & INT_ATTN)
+		return -EIO;
+	return stat & INT_CMD_COMPL ? 0 : -EBUSY;
+}
+
+/* Run one drive command, it finishes with the command complete signal */
+static int next_mo_drive_cmd(struct next_mo *mo, u16 cmd)
+{
+	int err, ms, us;
+
+	out_8(mo->regs + OSP_DRIVE_H, cmd >> 8);
+	out_8(mo->regs + OSP_DRIVE_L, cmd & 0xff);
+
+	/* Most commands finish right away, seeks and spin up take their time */
+	for (us = 0; us < MO_CMD_SPIN_US; us += 10) {
+		err = next_mo_cmd_status(mo);
+		if (err != -EBUSY)
+			return err;
+		udelay(10);
+	}
+	for (ms = 0; ms < MO_CMD_TIMEOUT_MS; ms += jiffies_to_msecs(1)) {
+		err = next_mo_cmd_status(mo);
+		if (err != -EBUSY)
+			return err;
+		usleep_range(1000, 2000);
+	}
+	return -ETIMEDOUT;
+}
+
+static int next_mo_status(struct next_mo *mo, u16 *status)
+{
+	int err = next_mo_drive_cmd(mo, DRV_STATUS);
+
+	if (err)
+		return err;
+	out_8(mo->regs + OSP_CSR1, FMT_RD_STAT);
+	*status = (in_8(mo->regs + OSP_DRIVE_H) << 8) | in_8(mo->regs + OSP_DRIVE_L);
+	out_8(mo->regs + OSP_CSR1, FMT_RESET);
+	return 0;
+}
+
+static void next_mo_clear_attn(struct next_mo *mo)
+{
+	next_mo_drive_cmd(mo, DRV_RESET_ATTN);
+	out_8(mo->regs + OSP_INTSTAT, INT_CLEAR);
+}
+
+/* Position ahead of the first sector and run one formatter pass */
+static int next_mo_pass(struct next_mo *mo, u16 head, u8 fmt, sector_t sector, int count,
+			u8 wait)
+{
+	u32 track = MO_TRACK_OFFSET + div_u64(sector, MO_SEC_PER_TRACK);
+	u32 start = track > 0 ? track - 1 : 0;
+	long left;
+	int err;
+
+	out_8(mo->regs + OSP_CSR1, FMT_RESET);
+	out_8(mo->regs + OSP_INTSTAT, INT_CLEAR);
+
+	out_8(mo->regs + OSP_TRACK_H, track >> 8);
+	out_8(mo->regs + OSP_TRACK_L, track & 0xff);
+	out_8(mo->regs + OSP_SECTOR, (1 << 4) | ((u32)sector % MO_SEC_PER_TRACK));
+	out_8(mo->regs + OSP_COUNT, count);
+
+	err = next_mo_drive_cmd(mo, head);
+	if (!err)
+		err = next_mo_drive_cmd(mo, DRV_HIGH_SEEK | (start >> 12));
+	if (!err)
+		err = next_mo_drive_cmd(mo, DRV_SEEK | (start & 0x0fff));
+	if (err)
+		return err;
+
+	reinit_completion(&mo->done);
+	mo->wait_mask = wait;
+	out_8(mo->regs + OSP_INTMASK, wait | INT_ERRORS | INT_ATTN);
+
+	/* The formatter must be armed before the head starts passing sectors */
+	out_8(mo->regs + OSP_CSR1, fmt);
+	err = next_mo_drive_cmd(mo, DRV_SPIRAL_ON);
+	if (err) {
+		out_8(mo->regs + OSP_INTMASK, 0);
+		out_8(mo->regs + OSP_CSR1, FMT_RESET);
+		return err;
+	}
+
+	left = wait_for_completion_timeout(&mo->done, MO_OPER_TIMEOUT);
+
+	out_8(mo->regs + OSP_INTMASK, 0);
+	next_mo_drive_cmd(mo, DRV_SPIRAL_OFF);
+	out_8(mo->regs + OSP_CSR1, FMT_RESET);
+
+	if (!left)
+		return -ETIMEDOUT;
+	if (in_8(mo->regs + OSP_INTSTAT) & (INT_ERRORS | INT_ATTN)) {
+		dev_err(mo->dev, "error at sector %llu, status %02x, error %02x\n",
+			(unsigned long long)sector, in_8(mo->regs + OSP_INTSTAT),
+			in_8(mo->regs + OSP_ERRSTAT));
+		return -EIO;
+	}
+	return 0;
+}
+
+static void next_mo_dma_start(struct next_mo *mo, unsigned int len, u32 dir)
+{
+	out_8(mo->regs + OSP_CSR2, CSR2_CLR_BUF);
+	nextdma_reset(NEXTDMA_DISK);
+	nextdma_reg_write(NEXTDMA_DISK, NEXTDMA_REG_NEXT, mo->buf_dma);
+	nextdma_reg_write(NEXTDMA_DISK, NEXTDMA_REG_LIMIT, mo->buf_dma + len);
+	nextdma_csr_write(NEXTDMA_DISK, NEXTDMA_SETENABLE | dir);
+}
+
+static int next_mo_read(struct next_mo *mo, sector_t sector, int count)
+{
+	int err;
+
+	next_mo_dma_start(mo, count * MO_SECTOR_SIZE, NEXTDMA_DEV2M);
+	err = next_mo_pass(mo, DRV_READ_HEAD, FMT_READ, sector, count,
+			   INT_OPER_COMPL | INT_ECC_DONE);
+	nextdma_reset(NEXTDMA_DISK);
+	return err;
+}
+
+static int next_mo_write(struct next_mo *mo, sector_t sector, int count)
+{
+	int err;
+
+	err = next_mo_pass(mo, DRV_ERASE_HEAD, FMT_ERASE, sector, count, INT_OPER_COMPL);
+	if (err)
+		return err;
+
+	next_mo_dma_start(mo, count * MO_SECTOR_SIZE, NEXTDMA_M2DEV);
+	err = next_mo_pass(mo, DRV_WRITE_HEAD, FMT_WRITE, sector, count, INT_OPER_COMPL);
+	nextdma_reset(NEXTDMA_DISK);
+	return err;
+}
+
+static int next_mo_xfer(struct next_mo *mo, bool write, sector_t sector, int count)
+{
+	int tries = MO_RETRIES, err;
+
+	do {
+		err = write ? next_mo_write(mo, sector, count) :
+			      next_mo_read(mo, sector, count);
+		if (!err)
+			break;
+		next_mo_clear_attn(mo);
+	} while (--tries);
+	return err;
+}
+
+static blk_status_t next_mo_queue_rq(struct blk_mq_hw_ctx *hctx,
+				     const struct blk_mq_queue_data *bd)
+{
+	struct next_mo *mo = hctx->queue->queuedata;
+	struct request *rq = bd->rq;
+	bool write = rq_data_dir(rq) == WRITE;
+	sector_t sector = blk_rq_pos(rq) >> (ilog2(MO_SECTOR_SIZE) - SECTOR_SHIFT);
+	unsigned int bytes = blk_rq_bytes(rq);
+	struct req_iterator iter;
+	struct bio_vec bvec;
+	unsigned int off = 0;
+	int err;
+
+	if (req_op(rq) != REQ_OP_READ && req_op(rq) != REQ_OP_WRITE)
+		return BLK_STS_IOERR;
+
+	blk_mq_start_request(rq);
+
+	if (write) {
+		rq_for_each_segment(bvec, rq, iter) {
+			memcpy_from_bvec(mo->buf + off, &bvec);
+			off += bvec.bv_len;
+		}
+	}
+
+	err = next_mo_xfer(mo, write, sector, bytes / MO_SECTOR_SIZE);
+
+	if (!err && !write) {
+		rq_for_each_segment(bvec, rq, iter) {
+			memcpy_to_bvec(&bvec, mo->buf + off);
+			off += bvec.bv_len;
+		}
+	}
+
+	blk_mq_end_request(rq, errno_to_blk_status(err));
+	return BLK_STS_OK;
+}
+
+static const struct blk_mq_ops next_mo_mq_ops = {
+	.queue_rq	= next_mo_queue_rq,
+};
+
+static const struct block_device_operations next_mo_fops = {
+	.owner		= THIS_MODULE,
+};
+
+static int next_mo_probe(struct platform_device *pdev)
+{
+	struct queue_limits lim = {
+		.logical_block_size	= MO_SECTOR_SIZE,
+		.physical_block_size	= MO_SECTOR_SIZE,
+		.max_hw_sectors		= MO_BUF_SIZE >> SECTOR_SHIFT,
+		.max_segments		= BLK_MAX_SEGMENTS,
+	};
+	struct next_mo *mo;
+	u16 status = 0;
+	int err;
+
+	/* There is no optical drive channel on Turbo models */
+	if (next_is_turbo())
+		return -ENODEV;
+
+	err = dma_coerce_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (err)
+		return err;
+
+	mo = devm_kzalloc(&pdev->dev, sizeof(*mo), GFP_KERNEL);
+	if (!mo)
+		return -ENOMEM;
+	mo->dev = &pdev->dev;
+	mo->regs = next_dev(NEXT_OSP);
+	init_completion(&mo->done);
+	platform_set_drvdata(pdev, mo);
+
+	out_8(mo->regs + OSP_INTMASK, 0);
+	out_8(mo->regs + OSP_INIT, INIT_ID_ALL | INIT_25MHZ);
+	out_8(mo->regs + OSP_FORMAT, FORMAT_NOMINAL);
+	out_8(mo->regs + OSP_CSR2, CSR2_CLR_BUF);
+	out_8(mo->regs + OSP_CSR1, FMT_RESET);
+
+	/* An absent drive does not complete commands */
+	if (next_mo_drive_cmd(mo, DRV_RESET_ATTN) || next_mo_status(mo, &status))
+		return -ENODEV;
+
+	if (status & DS_EMPTY) {
+		dev_info(&pdev->dev, "drive without a disk\n");
+		return -ENODEV;
+	}
+	if (status & DS_STOPPED) {
+		err = next_mo_drive_cmd(mo, DRV_START_MOTOR);
+		if (err)
+			return err;
+	}
+	err = next_mo_drive_cmd(mo, DRV_RECAL);
+	if (err)
+		return err;
+
+	mo->buf = dmam_alloc_coherent(&pdev->dev, MO_BUF_SIZE, &mo->buf_dma, GFP_KERNEL);
+	if (!mo->buf)
+		return -ENOMEM;
+
+	err = devm_request_irq(&pdev->dev, IRQ_NEXT_DISK, next_mo_interrupt, IRQF_SHARED,
+			       "next_mo", mo);
+	if (err)
+		return err;
+
+	err = blk_mq_alloc_sq_tag_set(&mo->tag_set, &next_mo_mq_ops, 1, BLK_MQ_F_BLOCKING);
+	if (err)
+		return err;
+
+	mo->disk = blk_mq_alloc_disk(&mo->tag_set, &lim, mo);
+	if (IS_ERR(mo->disk)) {
+		err = PTR_ERR(mo->disk);
+		goto err_tags;
+	}
+	mo->disk->flags |= GENHD_FL_NO_PART;
+	mo->disk->fops = &next_mo_fops;
+	mo->disk->private_data = mo;
+	strscpy(mo->disk->disk_name, "mo0", sizeof(mo->disk->disk_name));
+	set_capacity(mo->disk, (sector_t)MO_SECTORS << (ilog2(MO_SECTOR_SIZE) - SECTOR_SHIFT));
+	if (status & DS_WP)
+		set_disk_ro(mo->disk, true);
+
+	err = add_disk(mo->disk);
+	if (err)
+		goto err_disk;
+
+	dev_info(&pdev->dev, "%u MB disk%s\n", MO_SECTORS / 1024,
+		 status & DS_WP ? ", write protected" : "");
+	return 0;
+
+err_disk:
+	put_disk(mo->disk);
+err_tags:
+	blk_mq_free_tag_set(&mo->tag_set);
+	return err;
+}
+
+static void next_mo_remove(struct platform_device *pdev)
+{
+	struct next_mo *mo = platform_get_drvdata(pdev);
+
+	del_gendisk(mo->disk);
+	put_disk(mo->disk);
+	blk_mq_free_tag_set(&mo->tag_set);
+}
+
+static struct platform_driver next_mo_driver = {
+	.probe	= next_mo_probe,
+	.remove	= next_mo_remove,
+	.driver	= {
+		.name = "next_mo",
+	},
+};
+module_platform_driver(next_mo_driver);
+
+MODULE_DESCRIPTION("NeXT magneto-optical disk driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 4614bd920137e8e084323437176c2bfad2b27eb8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 03:27:44 +0100
Subject: [PATCH 18/35] m68k: dsp56k: Support the NeXT DSP56001
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

NeXT computers have the same 56001 host interface at another address.  There
the boot ROM of the DSP directly takes 512 words of program memory from the
host port, so no bootstrap firmware is needed for uploads.  The Falcon
firmware would not work anyway, it relocates itself into external memory
only the Falcon has at that address.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/Kconfig.devices |  7 ++--
 drivers/char/dsp56k.c     | 88 ++++++++++++++++++++++++++++++++++++++-
 2 files changed, 90 insertions(+), 5 deletions(-)

diff --git a/arch/m68k/Kconfig.devices b/arch/m68k/Kconfig.devices
index 3528a46cdf4c..48531572ceae 100644
--- a/arch/m68k/Kconfig.devices
+++ b/arch/m68k/Kconfig.devices
@@ -98,10 +98,11 @@ endmenu
 menu "Character devices"
 
 config ATARI_DSP56K
-	tristate "Atari DSP56k support"
-	depends on ATARI
+	tristate "Atari and NeXT DSP56k support"
+	depends on ATARI || NEXT
 	help
-	  If you want to be able to use the DSP56001 in Falcons, say Y. This
+	  If you want to be able to use the DSP56001 in Falcons, or in NeXT
+	  computers, say Y. This
 	  driver is still experimental, and if you don't know what it is, or
 	  if you don't have this processor, just say N.
 
diff --git a/drivers/char/dsp56k.c b/drivers/char/dsp56k.c
index 1c2c8439797c..1b0169cb352a 100644
--- a/drivers/char/dsp56k.c
+++ b/drivers/char/dsp56k.c
@@ -39,9 +39,46 @@
 
 #include <asm/atarihw.h>
 #include <asm/traps.h>
+#ifdef CONFIG_NEXT
+#include <asm/io.h>
+#include <asm/next.h>
+#endif
 
 #include <asm/dsp56k.h>
 
+/* NeXT has the same host interface, at an address known only at run time */
+static volatile struct DSP56K_HOST_INTERFACE *dsp56k_hi =
+	(volatile struct DSP56K_HOST_INTERFACE *)DSP56K_HOST_INTERFACE_BASE;
+#undef dsp56k_host_interface
+#define dsp56k_host_interface (*dsp56k_hi)
+
+#ifdef CONFIG_NEXT
+#define NEXT_DSP		0x00008000
+#define SCR2_DSP		NEXT_SCR2
+#define SCR2_DSP_RUN		0x80	/* zero holds the DSP in reset */
+#define SCR2_DSP_MODE_MASK	0x18
+#define SCR2_DSP_MODE_HOST	0x10	/* bootstrap from the host port, inverted */
+#define SCR2_DSP_MEM		(NEXT_SCR2 + 3)
+#define SCR2_DSP_MEM_EN		0x20	/* active low before Turbo */
+#define DSP56K_BOOT_WORDS	512
+
+static void dsp56k_next_reset(void)
+{
+	void __iomem *scr2 = next_io(SCR2_DSP);
+	void __iomem *mem = next_io(SCR2_DSP_MEM);
+	u8 val = in_8(scr2) & ~(SCR2_DSP_RUN | SCR2_DSP_MODE_MASK);
+
+	out_8(scr2, val);
+	udelay(10);
+	if (next_is_turbo())
+		out_8(mem, in_8(mem) | SCR2_DSP_MEM_EN);
+	else
+		out_8(mem, in_8(mem) & ~SCR2_DSP_MEM_EN);
+	out_8(scr2, val | SCR2_DSP_MODE_HOST);
+	out_8(scr2, val | SCR2_DSP_MODE_HOST | SCR2_DSP_RUN);
+}
+#endif
+
 /* minor devices */
 #define DSP56K_DEV_56001        0    /* The only device so far */
 
@@ -108,7 +145,14 @@ static const struct class dsp56k_class = {
 static int dsp56k_reset(void)
 {
 	u_char status;
-	
+
+#ifdef CONFIG_NEXT
+	if (MACH_IS_NEXT) {
+		dsp56k_next_reset();
+		return 0;
+	}
+#endif
+
 	/* Power down the DSP */
 	sound_ym.rd_data_reg_sel = 14;
 	status = sound_ym.rd_data_reg_sel & 0xef;
@@ -124,6 +168,36 @@ static int dsp56k_reset(void)
 	return 0;
 }
 
+#ifdef CONFIG_NEXT
+/*
+ * The boot ROM takes exactly 512 words of program memory from the host port
+ * and starts at address 0.  Larger programs need a loader of their own.
+ */
+static int dsp56k_next_upload(u_char __user *bin, int len)
+{
+	int i;
+
+	if (len > DSP56K_BOOT_WORDS)
+		return -EINVAL;
+
+	dsp56k_reset();
+
+	for (i = 0; i < DSP56K_BOOT_WORDS; i++) {
+		tx_wait(10);
+		if (i < len) {
+			get_user(dsp56k_host_interface.data.b[1], bin++);
+			get_user(dsp56k_host_interface.data.b[2], bin++);
+			get_user(dsp56k_host_interface.data.b[3], bin++);
+		} else {
+			dsp56k_host_interface.data.b[1] = 0;
+			dsp56k_host_interface.data.b[2] = 0;
+			dsp56k_host_interface.data.b[3] = 0;
+		}
+	}
+	return 0;
+}
+#endif
+
 static int dsp56k_upload(u_char __user *bin, int len)
 {
 	struct platform_device *pdev;
@@ -132,6 +206,11 @@ static int dsp56k_upload(u_char __user *bin, int len)
 	int err;
 	int i;
 
+#ifdef CONFIG_NEXT
+	if (MACH_IS_NEXT)
+		return dsp56k_next_upload(bin, len);
+#endif
+
 	dsp56k_reset();
 
 	pdev = platform_device_register_simple("dsp56k", 0, NULL, 0);
@@ -497,6 +576,11 @@ static int __init dsp56k_init_driver(void)
 {
 	int err;
 
+#ifdef CONFIG_NEXT
+	if (MACH_IS_NEXT)
+		dsp56k_hi = (volatile struct DSP56K_HOST_INTERFACE *)next_dev(NEXT_DSP);
+	else
+#endif
 	if(!MACH_IS_ATARI || !ATARIHW_PRESENT(DSP56K)) {
 		printk("DSP56k driver: Hardware not present\n");
 		return -ENODEV;
@@ -530,6 +614,6 @@ static void __exit dsp56k_cleanup_driver(void)
 }
 module_exit(dsp56k_cleanup_driver);
 
-MODULE_DESCRIPTION("Atari DSP56001 Device Driver");
+MODULE_DESCRIPTION("Atari and NeXT DSP56001 Device Driver");
 MODULE_LICENSE("GPL");
 MODULE_FIRMWARE("dsp56k/bootstrap.bin");
-- 
2.54.0


From cbd1fe243e7fefb815d507c719ebfbae5e7163c3 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 03:27:44 +0100
Subject: [PATCH 19/35] char: Add NeXT laser printer driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The printer interface takes one page in a continuous DMA stream, it cannot
wait for data once the page started.  Writes to /dev/nextlp therefore collect
a bitmap page in chained DMA segments, which is printed on close.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/configs/next_defconfig    |   2 +
 arch/m68k/include/uapi/asm/nextlp.h |  21 ++
 arch/m68k/next/config.c             |   1 +
 drivers/char/Kconfig                |  11 +
 drivers/char/Makefile               |   1 +
 drivers/char/nextlp.c               | 421 ++++++++++++++++++++++++++++
 6 files changed, 457 insertions(+)
 create mode 100644 arch/m68k/include/uapi/asm/nextlp.h
 create mode 100644 drivers/char/nextlp.c

diff --git a/arch/m68k/configs/next_defconfig b/arch/m68k/configs/next_defconfig
index ec73284f064a..a6d2b5a5840b 100644
--- a/arch/m68k/configs/next_defconfig
+++ b/arch/m68k/configs/next_defconfig
@@ -66,6 +66,8 @@ CONFIG_LEDS_NEXT=y
 CONFIG_LEDS_TRIGGERS=y
 CONFIG_LEDS_TRIGGER_HEARTBEAT=y
 CONFIG_BACKLIGHT_CLASS_DEVICE=y
+CONFIG_ATARI_DSP56K=y
+CONFIG_NEXT_LASERPRINTER=y
 CONFIG_RTC_CLASS=y
 CONFIG_RTC_HCTOSYS=y
 CONFIG_RTC_DRV_NEXT=y
diff --git a/arch/m68k/include/uapi/asm/nextlp.h b/arch/m68k/include/uapi/asm/nextlp.h
new file mode 100644
index 000000000000..a3c3ff08f893
--- /dev/null
+++ b/arch/m68k/include/uapi/asm/nextlp.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * NeXT laser printer interface
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef _UAPI_ASM_M68K_NEXTLP_H
+#define _UAPI_ASM_M68K_NEXTLP_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+struct nextlp_page {
+	__u32 width_bytes;	/* multiple of 4 */
+	__u32 dpi;		/* 300 or 400 */
+};
+
+#define NEXTLP_SET_PAGE		_IOW('N', 1, struct nextlp_page)
+
+#endif /* _UAPI_ASM_M68K_NEXTLP_H */
diff --git a/arch/m68k/next/config.c b/arch/m68k/next/config.c
index 28b343c12075..c12070b9717c 100644
--- a/arch/m68k/next/config.c
+++ b/arch/m68k/next/config.c
@@ -217,6 +217,7 @@ static int __init next_platform_init(void)
 	platform_device_register_simple("rtc-next", -1, NULL, 0);
 	platform_device_register_simple("leds-next", -1, NULL, 0);
 	platform_device_register_simple("next_mo", -1, NULL, 0);
+	platform_device_register_simple("nextlp", -1, NULL, 0);
 
 	return 0;
 }
diff --git a/drivers/char/Kconfig b/drivers/char/Kconfig
index 9865227af167..e33f74f86376 100644
--- a/drivers/char/Kconfig
+++ b/drivers/char/Kconfig
@@ -58,6 +58,17 @@ config PRINTER
 	  If you have more than 8 printers, you need to increase the LP_NO
 	  macro in lp.c and the PARPORT_MAX macro in parport.h.
 
+config NEXT_LASERPRINTER
+	tristate "NeXT laser printer support"
+	depends on NEXT
+	help
+	  Say Y here for the NeXT 400 dpi laser printer, driven by the printer
+	  interface of the NeXT computers.  /dev/nextlp prints one bitmap page
+	  for each time it is written and closed.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called nextlp.
+
 config LP_CONSOLE
 	bool "Support for console on line printer"
 	depends on PRINTER
diff --git a/drivers/char/Makefile b/drivers/char/Makefile
index bb3bf66937b3..84a57f4aebee 100644
--- a/drivers/char/Makefile
+++ b/drivers/char/Makefile
@@ -8,6 +8,7 @@ obj-$(CONFIG_TTY_PRINTK)	+= ttyprintk.o
 obj-y				+= misc.o
 obj-$(CONFIG_TEST_MISC_MINOR)	+= misc_minor_kunit.o
 obj-$(CONFIG_ATARI_DSP56K)	+= dsp56k.o
+obj-$(CONFIG_NEXT_LASERPRINTER)	+= nextlp.o
 obj-$(CONFIG_VIRTIO_CONSOLE)	+= virtio_console.o
 obj-$(CONFIG_UV_MMTIMER)	+= uv_mmtimer.o
 obj-$(CONFIG_IBM_BSR)		+= bsr.o
diff --git a/drivers/char/nextlp.c b/drivers/char/nextlp.c
new file mode 100644
index 000000000000..81c7264da639
--- /dev/null
+++ b/drivers/char/nextlp.c
@@ -0,0 +1,421 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * NeXT laser printer interface.
+ *
+ * Writes collect one bitmap page, one bit per pixel with 1 as black, which is
+ * printed on close.  The engine takes the page in one continuous DMA stream
+ * and cannot wait for data once it started, so the page is buffered first.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/fs.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/list.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include <asm/next.h>
+#include <asm/nextdma.h>
+#include <asm/nextlp.h>
+
+#define NEXT_LP			0x0000f000
+#define IRQ_NEXT_LP_DMA		NEXT_IRQ(24)
+
+#define LP_CSR_DMA		0
+#define LP_CSR_PRINTER		1
+#define LP_CSR_TX		2
+#define LP_CMD			3
+#define LP_DATA			4
+
+#define LP_DMA_OUT_EN		0x80
+#define LP_DMA_OUT_UNDERRUN	0x20
+#define LP_PRINTER_ON		0x80
+#define LP_PRINTER_DATA		0x04
+#define LP_PRINTER_OVERRUN	0x02
+#define LP_TX_EN		0x02
+#define LP_TX_CPU_BUSY		0x30
+
+#define CMD_GPO			0xc4
+#define CMD_MARGINS		0xc2
+#define CMD_GPI_REQ		0x04
+#define CMD_DATA_STOP		0x07
+#define CMD_DATA_START		0x0f
+#define CMD_300DPI		0x10
+
+/* Output port, sent inverted */
+#define GPO_ENABLE		0x10
+#define GPO_VSYNC		0x20
+#define GPO_PWR_RDY		0x08
+#define GPO_CLOCK		0x04
+#define GPO_CMD_BIT		0x02
+#define GPO_BUSY		0x01
+
+/* Input port */
+#define GPI_PWR_RDY		0x10
+#define GPI_RDY			0x08
+
+/* Engine commands on the serial line of the output port */
+#define ENGINE_CASSETTE_FEED	0x4c
+
+#define MARGINS_WIDTH_SHIFT	16
+#define MARGINS_WIDTH_MASK	0x7f
+
+#define LP_SEG_SIZE		(64 * 1024)
+#define LP_DEFAULT_WIDTH	428	/* 8.5 inches at 400 dpi, rounded up */
+#define LP_MAX_WIDTH		(MARGINS_WIDTH_MASK * 4)
+#define LP_MAX_PAGE		(512 * LP_SEG_SIZE)
+#define LP_POWER_TIMEOUT_MS	2000
+#define LP_DMA_TIMEOUT		(60 * HZ)
+
+struct nextlp_seg {
+	struct list_head list;
+	void *buf;
+	dma_addr_t dma;
+	size_t used;
+};
+
+struct nextlp {
+	struct device *dev;
+	void __iomem *regs;
+	struct miscdevice misc;
+	struct mutex lock;
+	struct list_head segs;
+	struct nextlp_seg *chain;
+	struct completion done;
+	size_t page_bytes;
+	struct nextlp_page page;
+	bool failed;
+};
+
+static void nextlp_cmd(struct nextlp *lp, u8 cmd, u32 data)
+{
+	int timeout = 1000;
+
+	while ((in_8(lp->regs + LP_CSR_TX) & LP_TX_CPU_BUSY) && --timeout)
+		udelay(1);
+	out_8(lp->regs + LP_CMD, cmd);
+	out_be32(lp->regs + LP_DATA, data);
+}
+
+static void nextlp_gpo(struct nextlp *lp, u8 val)
+{
+	nextlp_cmd(lp, CMD_GPO, ~((u32)val << 24));
+}
+
+static void nextlp_drain_input(struct nextlp *lp)
+{
+	int i;
+
+	for (i = 0; i < 16 && (in_8(lp->regs + LP_CSR_PRINTER) & LP_PRINTER_DATA); i++) {
+		in_be32(lp->regs + LP_DATA);
+		udelay(10);
+	}
+}
+
+/* The input port arrives inverted in the top byte of a data word */
+static int nextlp_gpi(struct nextlp *lp, u8 *val)
+{
+	int timeout = 100;
+
+	nextlp_drain_input(lp);
+	nextlp_cmd(lp, CMD_GPI_REQ, 0);
+	while (!(in_8(lp->regs + LP_CSR_PRINTER) & LP_PRINTER_DATA)) {
+		if (!--timeout)
+			return -ETIMEDOUT;
+		usleep_range(1000, 2000);
+	}
+	*val = ~(in_be32(lp->regs + LP_DATA) >> 24);
+	return 0;
+}
+
+static void nextlp_engine_cmd(struct nextlp *lp, u8 base, u8 cmd)
+{
+	int i;
+
+	nextlp_gpo(lp, base | GPO_BUSY);
+	for (i = 7; i >= 0; i--) {
+		u8 bit = (cmd >> i) & 1 ? GPO_CMD_BIT : 0;
+
+		nextlp_gpo(lp, base | GPO_BUSY | bit);
+		nextlp_gpo(lp, base | GPO_BUSY | bit | GPO_CLOCK);
+		nextlp_gpo(lp, base | GPO_BUSY | bit);
+	}
+	nextlp_gpo(lp, base);
+}
+
+static int nextlp_power_on(struct nextlp *lp)
+{
+	int ms;
+	u8 gpi = 0;
+
+	out_8(lp->regs + LP_CSR_PRINTER, LP_PRINTER_ON);
+	out_8(lp->regs + LP_CSR_TX, LP_TX_EN);
+
+	for (ms = 0; ms < LP_POWER_TIMEOUT_MS; ms += 20) {
+		if (!nextlp_gpi(lp, &gpi) && (gpi & GPI_PWR_RDY) && (gpi & GPI_RDY))
+			break;
+		msleep(20);
+	}
+	if (ms >= LP_POWER_TIMEOUT_MS)
+		return -ENODEV;
+
+	nextlp_gpo(lp, GPO_PWR_RDY);
+	return 0;
+}
+
+static void nextlp_power_off(struct nextlp *lp)
+{
+	nextlp_drain_input(lp);
+	out_8(lp->regs + LP_CSR_TX, 0);
+	out_8(lp->regs + LP_CSR_PRINTER, 0);
+}
+
+static void nextlp_free_page(struct nextlp *lp)
+{
+	struct nextlp_seg *seg, *tmp;
+
+	list_for_each_entry_safe(seg, tmp, &lp->segs, list) {
+		list_del(&seg->list);
+		dma_free_coherent(lp->dev, LP_SEG_SIZE, seg->buf, seg->dma);
+		kfree(seg);
+	}
+	lp->page_bytes = 0;
+}
+
+static void nextlp_chain(struct nextlp *lp, struct nextlp_seg *seg)
+{
+	nextdma_reg_write(NEXTDMA_PRINTER, NEXTDMA_REG_START, seg->dma);
+	nextdma_reg_write(NEXTDMA_PRINTER, NEXTDMA_REG_STOP,
+			  seg->dma + ALIGN(seg->used, NEXTDMA_ALIGN));
+}
+
+static struct nextlp_seg *nextlp_next_seg(struct nextlp *lp, struct nextlp_seg *seg)
+{
+	return list_is_last(&seg->list, &lp->segs) ? NULL : list_next_entry(seg, list);
+}
+
+static irqreturn_t nextlp_interrupt(int irq, void *dev_id)
+{
+	struct nextlp *lp = dev_id;
+	u32 csr = nextdma_csr_read(NEXTDMA_PRINTER);
+
+	if (!(csr & NEXTDMA_COMPLETE))
+		return IRQ_NONE;
+
+	lp->chain = lp->chain ? nextlp_next_seg(lp, lp->chain) : NULL;
+
+	if (lp->chain && (csr & NEXTDMA_ENABLE)) {
+		struct nextlp_seg *next = nextlp_next_seg(lp, lp->chain);
+
+		if (next) {
+			nextlp_chain(lp, next);
+			nextdma_csr_write(NEXTDMA_PRINTER, NEXTDMA_CLRCOMPLETE |
+					  NEXTDMA_SETSUPDATE | NEXTDMA_M2DEV);
+		} else {
+			nextdma_csr_write(NEXTDMA_PRINTER, NEXTDMA_CLRCOMPLETE | NEXTDMA_M2DEV);
+		}
+		return IRQ_HANDLED;
+	}
+
+	nextdma_reset(NEXTDMA_PRINTER);
+	if (lp->chain)
+		lp->failed = true;
+	complete(&lp->done);
+	return IRQ_HANDLED;
+}
+
+static int nextlp_print_page(struct nextlp *lp)
+{
+	struct nextlp_seg *first, *second;
+	u8 cmd = CMD_DATA_START | (lp->page.dpi == 300 ? CMD_300DPI : 0);
+	u8 base = GPO_PWR_RDY;
+	int err;
+
+	if (list_empty(&lp->segs))
+		return 0;
+
+	err = nextlp_power_on(lp);
+	if (err)
+		return err;
+
+	nextlp_cmd(lp, CMD_MARGINS, (lp->page.width_bytes / 4) << MARGINS_WIDTH_SHIFT);
+	nextlp_engine_cmd(lp, base, ENGINE_CASSETTE_FEED);
+
+	first = list_first_entry(&lp->segs, struct nextlp_seg, list);
+	second = nextlp_next_seg(lp, first);
+
+	reinit_completion(&lp->done);
+	lp->failed = false;
+	lp->chain = first;
+
+	nextdma_reset(NEXTDMA_PRINTER);
+	nextdma_reg_write(NEXTDMA_PRINTER, NEXTDMA_REG_NEXT, first->dma);
+	nextdma_reg_write(NEXTDMA_PRINTER, NEXTDMA_REG_LIMIT,
+			  first->dma + ALIGN(first->used, NEXTDMA_ALIGN));
+	if (second)
+		nextlp_chain(lp, second);
+	nextdma_csr_write(NEXTDMA_PRINTER, NEXTDMA_SETENABLE | NEXTDMA_M2DEV |
+			  (second ? NEXTDMA_SETSUPDATE : 0));
+
+	out_8(lp->regs + LP_CSR_DMA, LP_DMA_OUT_EN);
+	nextlp_gpo(lp, base | GPO_ENABLE | GPO_VSYNC);
+	nextlp_cmd(lp, cmd, 0);
+
+	if (!wait_for_completion_timeout(&lp->done, LP_DMA_TIMEOUT))
+		err = -ETIMEDOUT;
+	else if (lp->failed)
+		err = -EIO;
+
+	nextlp_cmd(lp, CMD_DATA_STOP, 0);
+	out_8(lp->regs + LP_CSR_DMA, LP_DMA_OUT_UNDERRUN);
+	nextdma_reset(NEXTDMA_PRINTER);
+	nextlp_gpo(lp, base);
+	nextlp_power_off(lp);
+	return err;
+}
+
+static ssize_t nextlp_write(struct file *file, const char __user *buf, size_t count,
+			    loff_t *ppos)
+{
+	struct nextlp *lp = container_of(file->private_data, struct nextlp, misc);
+	size_t done = 0;
+	int err = 0;
+
+	mutex_lock(&lp->lock);
+	while (done < count) {
+		struct nextlp_seg *seg = list_last_entry_or_null(&lp->segs, struct nextlp_seg, list);
+		size_t chunk;
+
+		if (lp->page_bytes >= LP_MAX_PAGE) {
+			err = -ENOSPC;
+			break;
+		}
+		if (!seg || seg->used == LP_SEG_SIZE) {
+			seg = kzalloc_obj(*seg);
+			if (!seg) {
+				err = -ENOMEM;
+				break;
+			}
+			seg->buf = dma_alloc_coherent(lp->dev, LP_SEG_SIZE, &seg->dma, GFP_KERNEL);
+			if (!seg->buf) {
+				kfree(seg);
+				err = -ENOMEM;
+				break;
+			}
+			list_add_tail(&seg->list, &lp->segs);
+		}
+		chunk = min(count - done, LP_SEG_SIZE - seg->used);
+		if (copy_from_user(seg->buf + seg->used, buf + done, chunk)) {
+			err = -EFAULT;
+			break;
+		}
+		seg->used += chunk;
+		lp->page_bytes += chunk;
+		done += chunk;
+	}
+	mutex_unlock(&lp->lock);
+	return done ? done : err;
+}
+
+static long nextlp_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct nextlp *lp = container_of(file->private_data, struct nextlp, misc);
+	struct nextlp_page page;
+
+	if (cmd != NEXTLP_SET_PAGE)
+		return -ENOTTY;
+	if (copy_from_user(&page, (void __user *)arg, sizeof(page)))
+		return -EFAULT;
+	if (!page.width_bytes || page.width_bytes > LP_MAX_WIDTH || page.width_bytes % 4 ||
+	    (page.dpi != 300 && page.dpi != 400))
+		return -EINVAL;
+
+	mutex_lock(&lp->lock);
+	lp->page = page;
+	mutex_unlock(&lp->lock);
+	return 0;
+}
+
+static int nextlp_release(struct inode *inode, struct file *file)
+{
+	struct nextlp *lp = container_of(file->private_data, struct nextlp, misc);
+	int err;
+
+	mutex_lock(&lp->lock);
+	err = nextlp_print_page(lp);
+	if (err)
+		dev_err(lp->dev, "printing failed: %d\n", err);
+	nextlp_free_page(lp);
+	mutex_unlock(&lp->lock);
+	return 0;
+}
+
+static const struct file_operations nextlp_fops = {
+	.owner		= THIS_MODULE,
+	.write		= nextlp_write,
+	.unlocked_ioctl	= nextlp_ioctl,
+	.release	= nextlp_release,
+	.llseek		= noop_llseek,
+};
+
+static int nextlp_probe(struct platform_device *pdev)
+{
+	struct nextlp *lp;
+	int err;
+
+	err = dma_coerce_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (err)
+		return err;
+
+	lp = devm_kzalloc(&pdev->dev, sizeof(*lp), GFP_KERNEL);
+	if (!lp)
+		return -ENOMEM;
+
+	lp->dev = &pdev->dev;
+	lp->regs = next_io(NEXT_LP);
+	mutex_init(&lp->lock);
+	INIT_LIST_HEAD(&lp->segs);
+	init_completion(&lp->done);
+	lp->page.width_bytes = LP_DEFAULT_WIDTH;
+	lp->page.dpi = 400;
+
+	nextdma_reset(NEXTDMA_PRINTER);
+	err = devm_request_irq(&pdev->dev, IRQ_NEXT_LP_DMA, nextlp_interrupt, 0, "nextlp", lp);
+	if (err)
+		return err;
+
+	lp->misc.minor = MISC_DYNAMIC_MINOR;
+	lp->misc.name = "nextlp";
+	lp->misc.fops = &nextlp_fops;
+	lp->misc.parent = &pdev->dev;
+	platform_set_drvdata(pdev, lp);
+	return misc_register(&lp->misc);
+}
+
+static void nextlp_remove(struct platform_device *pdev)
+{
+	struct nextlp *lp = platform_get_drvdata(pdev);
+
+	misc_deregister(&lp->misc);
+}
+
+static struct platform_driver nextlp_driver = {
+	.probe	= nextlp_probe,
+	.remove	= nextlp_remove,
+	.driver	= {
+		.name = "nextlp",
+	},
+};
+module_platform_driver(nextlp_driver);
+
+MODULE_DESCRIPTION("NeXT laser printer driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 4bcd6ffd1b5486704c37cbb15456f7e0192a9fb9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 03:58:05 +0100
Subject: [PATCH 20/35] m68k: next: Fix floppy on the 68030 and in
 multi-platform kernels
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The 68030 routes the shared DMA channel to the floppy controller with an
output of the optical disk controller instead of a floppy register.

Enabling the floppy driver for NeXT must not build the Q40 and sun3x support,
which is still marked as broken, in a kernel for several machines.  Also
provide dma_spin_lock: m68k does not build the ISA DMA API.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/Kconfig.machine        |  1 -
 arch/m68k/include/asm/floppy.h   | 35 ++++++++++++++++++++------------
 arch/m68k/include/asm/nextdma.h  |  5 +++++
 arch/m68k/include/asm/nextflop.h | 17 +++++++++++++---
 arch/m68k/next/dma.c             |  7 +++++++
 arch/m68k/q40/q40ints.c          |  2 +-
 drivers/block/next_mo.c          |  4 ++--
 7 files changed, 51 insertions(+), 20 deletions(-)

diff --git a/arch/m68k/Kconfig.machine b/arch/m68k/Kconfig.machine
index 5afe5d4b4b90..f0f1fc21a2e9 100644
--- a/arch/m68k/Kconfig.machine
+++ b/arch/m68k/Kconfig.machine
@@ -41,7 +41,6 @@ config MAC
 config NEXT
 	bool "NeXT support"
 	depends on MMU
-	select ISA_DMA_API
 	select LEGACY_TIMER_TICK
 	help
 	  This option enables support for the NeXT 68030 and 68040 computers:
diff --git a/arch/m68k/include/asm/floppy.h b/arch/m68k/include/asm/floppy.h
index d25f051b08d2..669a26cce543 100644
--- a/arch/m68k/include/asm/floppy.h
+++ b/arch/m68k/include/asm/floppy.h
@@ -46,7 +46,15 @@ static char *virtual_dma_addr=NULL;
 static int virtual_dma_mode=0;
 static int doing_pdma=0;
 
-#ifdef CONFIG_SUN3X
+/* The floppy support of these two machines is marked as broken */
+#if defined(CONFIG_BROKEN) && defined(CONFIG_Q40)
+#define M68K_FLOPPY_Q40
+#endif
+#if defined(CONFIG_BROKEN) && defined(CONFIG_SUN3X)
+#define M68K_FLOPPY_SUN3X
+#endif
+
+#ifdef M68K_FLOPPY_SUN3X
 #include <asm/sun3xflop.h>
 #else
 #undef release_region
@@ -79,11 +87,11 @@ static __inline__ unsigned char fd_inb(int base, int reg)
 	if (MACH_IS_NEXT)
 		return in_8((unsigned long)base + reg);
 #endif
-#ifdef CONFIG_Q40
+#ifdef M68K_FLOPPY_Q40
 	if(MACH_IS_Q40)
 		return inb_p(base + reg);
 #endif
-#ifdef CONFIG_SUN3X
+#ifdef M68K_FLOPPY_SUN3X
 	if(MACH_IS_SUN3X)
 		return sun3x_82072_fd_inb(base + reg);
 #endif
@@ -96,11 +104,11 @@ static __inline__ void fd_outb(unsigned char value, int base, int reg)
 	if (MACH_IS_NEXT)
 		out_8((unsigned long)base + reg, value);
 #endif
-#ifdef CONFIG_Q40
+#ifdef M68K_FLOPPY_Q40
 	if(MACH_IS_Q40)
 		outb_p(value, base + reg);
 #endif
-#ifdef CONFIG_SUN3X
+#ifdef M68K_FLOPPY_SUN3X
 	if(MACH_IS_SUN3X)
 		sun3x_82072_fd_outb(value, base + reg);
 #endif
@@ -112,7 +120,7 @@ static int fd_request_irq(void)
 	if (MACH_IS_Q40 || MACH_IS_NEXT)
 		return request_irq(FLOPPY_IRQ, floppy_hardint,
 				   0, "floppy", floppy_hardint);
-#ifdef CONFIG_SUN3X
+#ifdef M68K_FLOPPY_SUN3X
 	if(MACH_IS_SUN3X)
 		return sun3xflop_request_irq();
 #endif
@@ -157,14 +165,15 @@ static int m68k_floppy_init(void)
   can_use_virtual_dma = 1;
 
 
+#ifdef M68K_FLOPPY_Q40
   if (MACH_IS_Q40)
 	  return 0x3f0;
-#ifdef CONFIG_SUN3X
-  else if(MACH_IS_SUN3X)
+#endif
+#ifdef M68K_FLOPPY_SUN3X
+  if(MACH_IS_SUN3X)
 	  return sun3xflop_init();
 #endif
-  else
-    return -1;
+  return -1;
 }
 
 
@@ -242,7 +251,7 @@ static void fd_disable_dma(void)
 
 asmlinkage irqreturn_t floppy_hardint(int irq, void *dev_id)
 {
-#ifdef CONFIG_Q40
+#ifdef M68K_FLOPPY_Q40
 	register unsigned char st;
 #endif
 
@@ -259,7 +268,7 @@ asmlinkage irqreturn_t floppy_hardint(int irq, void *dev_id)
 		return IRQ_HANDLED;
 	}
 
-#ifdef CONFIG_Q40
+#ifdef M68K_FLOPPY_Q40
 
 #ifdef TRACE_FLPY_INT
 	if(!calls)
@@ -313,7 +322,7 @@ asmlinkage irqreturn_t floppy_hardint(int irq, void *dev_id)
 	if(!virtual_dma_count)
 		dma_wait++;
 #endif
-#endif /* CONFIG_Q40 */
+#endif /* M68K_FLOPPY_Q40 */
 	return IRQ_HANDLED;
 }
 
diff --git a/arch/m68k/include/asm/nextdma.h b/arch/m68k/include/asm/nextdma.h
index f3ed1383ed1a..784eaf96ce65 100644
--- a/arch/m68k/include/asm/nextdma.h
+++ b/arch/m68k/include/asm/nextdma.h
@@ -81,6 +81,11 @@ static inline void nextdma_reset(unsigned int chan)
 	nextdma_csr_write(chan, 0);
 }
 
+/* On the 68030 the optical disk controller selects the floppy for the channel */
+#define NEXT_OSP_INTSTAT	0x00012004
+#define NEXT_OSP_GPO		0x02
+extern u8 next_osp_gpo;
+
 /* Ownership of the channel shared by the SCSI and floppy controllers */
 struct next_scsidma_job {
 	struct list_head list;
diff --git a/arch/m68k/include/asm/nextflop.h b/arch/m68k/include/asm/nextflop.h
index b663bf585032..bb2354d3f18f 100644
--- a/arch/m68k/include/asm/nextflop.h
+++ b/arch/m68k/include/asm/nextflop.h
@@ -43,6 +43,17 @@ static inline void next_fd_cache(void)
 		cache_clear(virt_to_phys(next_fd.addr), next_fd.size);
 }
 
+/* Route the shared channel to the floppy controller, the 68030 does it elsewhere */
+static inline void next_fd_select(bool on)
+{
+	if (next_machine == NEXT_MACH_CUBE030) {
+		next_osp_gpo = on ? NEXT_OSP_GPO : 0;
+		out_8(next_dev(NEXT_OSP_INTSTAT), next_osp_gpo);
+	} else {
+		out_8(next_dev(NEXT_FDC_CTRL), on ? NEXT_FDC_CTRL_82077 : 0);
+	}
+}
+
 static inline void next_fd_dma_stop(void)
 {
 	if (!next_fd.active)
@@ -53,7 +64,7 @@ static inline void next_fd_dma_stop(void)
 			  nextdma_reg_read(NEXTDMA_SCSI, NEXTDMA_REG_NEXT);
 	nextdma_reset(NEXTDMA_SCSI);
 	out_8(next_dev(NEXT_ESP_DMA_CTRL), NEXT_ESP_CTRL_IDLE);
-	out_8(next_dev(NEXT_FDC_CTRL), 0);
+	next_fd_select(false);
 	if (next_fd.read)
 		cache_clear(virt_to_phys(next_fd.addr), next_fd.size);
 	next_scsidma_release();
@@ -74,7 +85,7 @@ static inline void next_fd_dma_start(void)
 {
 	u32 start = virt_to_phys(next_fd.addr);
 
-	out_8(next_dev(NEXT_FDC_CTRL), NEXT_FDC_CTRL_82077);
+	next_fd_select(true);
 	out_8(next_dev(NEXT_ESP_DMA_CTRL), NEXT_ESP_CTRL_DMA |
 	      (next_fd.read ? NEXT_ESP_CTRL_DMA_READ : 0));
 
@@ -109,7 +120,7 @@ static inline int next_fd_init(void)
 	/* The controller is optional on the 68030 */
 	if (!hwreg_present(next_dev(NEXT_FDC)))
 		return -1;
-	out_8(next_dev(NEXT_FDC_CTRL), 0);
+	next_fd_select(false);
 	return (int)(unsigned long)next_dev(NEXT_FDC);
 }
 
diff --git a/arch/m68k/next/dma.c b/arch/m68k/next/dma.c
index b4049e1cbe24..ed6882487f3c 100644
--- a/arch/m68k/next/dma.c
+++ b/arch/m68k/next/dma.c
@@ -13,6 +13,13 @@
 
 #include <asm/nextdma.h>
 
+/* Used by the generic floppy driver, there is no ISA DMA API on m68k */
+DEFINE_SPINLOCK(dma_spin_lock);
+EXPORT_SYMBOL(dma_spin_lock);
+
+u8 next_osp_gpo;
+EXPORT_SYMBOL_GPL(next_osp_gpo);
+
 static DEFINE_SPINLOCK(scsidma_lock);
 static LIST_HEAD(scsidma_queue);
 static bool scsidma_busy;
diff --git a/arch/m68k/q40/q40ints.c b/arch/m68k/q40/q40ints.c
index 14b774b9d308..482aab884424 100644
--- a/arch/m68k/q40/q40ints.c
+++ b/arch/m68k/q40/q40ints.c
@@ -215,7 +215,7 @@ static void q40_irq_handler(unsigned int irq, struct pt_regs *fp)
 
 //repeat:
 	mir = master_inb(IIRQ_REG);
-#ifdef CONFIG_BLK_DEV_FD
+#if defined(CONFIG_BLK_DEV_FD) && defined(CONFIG_BROKEN)
 	if ((mir & Q40_IRQ_EXT_MASK) &&
 	    (master_inb(EIRQ_REG) & Q40_IRQ6_MASK)) {
 		floppy_hardint();
diff --git a/drivers/block/next_mo.c b/drivers/block/next_mo.c
index 96ad515a3515..5ebdfee7a538 100644
--- a/drivers/block/next_mo.c
+++ b/drivers/block/next_mo.c
@@ -172,7 +172,7 @@ static int next_mo_status(struct next_mo *mo, u16 *status)
 static void next_mo_clear_attn(struct next_mo *mo)
 {
 	next_mo_drive_cmd(mo, DRV_RESET_ATTN);
-	out_8(mo->regs + OSP_INTSTAT, INT_CLEAR);
+	out_8(mo->regs + OSP_INTSTAT, INT_CLEAR | next_osp_gpo);
 }
 
 /* Position ahead of the first sector and run one formatter pass */
@@ -185,7 +185,7 @@ static int next_mo_pass(struct next_mo *mo, u16 head, u8 fmt, sector_t sector, i
 	int err;
 
 	out_8(mo->regs + OSP_CSR1, FMT_RESET);
-	out_8(mo->regs + OSP_INTSTAT, INT_CLEAR);
+	out_8(mo->regs + OSP_INTSTAT, INT_CLEAR | next_osp_gpo);
 
 	out_8(mo->regs + OSP_TRACK_H, track >> 8);
 	out_8(mo->regs + OSP_TRACK_L, track & 0xff);
-- 
2.54.0


From 362c2dc9f942c650605ce7e08b3199ef6c6cfcd7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 03:58:05 +0100
Subject: [PATCH 21/35] Documentation: m68k: Describe the NeXT support
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 Documentation/arch/m68k/index.rst |  1 +
 Documentation/arch/m68k/next.rst  | 90 +++++++++++++++++++++++++++++++
 2 files changed, 91 insertions(+)
 create mode 100644 Documentation/arch/m68k/next.rst

diff --git a/Documentation/arch/m68k/index.rst b/Documentation/arch/m68k/index.rst
index c334026e0ae1..9024dc1cf870 100644
--- a/Documentation/arch/m68k/index.rst
+++ b/Documentation/arch/m68k/index.rst
@@ -9,5 +9,6 @@ m68k Architecture
 
    kernel-options
    buddha-driver
+   next
 
    features
diff --git a/Documentation/arch/m68k/next.rst b/Documentation/arch/m68k/next.rst
new file mode 100644
index 000000000000..7cbcb4460052
--- /dev/null
+++ b/Documentation/arch/m68k/next.rst
@@ -0,0 +1,90 @@
+.. SPDX-License-Identifier: GPL-2.0
+
+=========================
+Linux on NeXT 68k systems
+=========================
+
+Supported machines
+==================
+
+=========================  ======  ============  ==================  ==========
+Machine                    CPU     Display       Clock chip          Keyboard
+=========================  ======  ============  ==================  ==========
+NeXT Computer              68030   2 bpp gray    MC68HC68T1          monitor
+NeXTcube                   68040   2 bpp gray    MC68HC68T1          monitor
+NeXTstation                68040   2 bpp gray    MC68HC68T1          monitor
+NeXTstation Color          68040   16 bpp        MC68HC68T1          monitor
+NeXTcube Turbo             68040   2 bpp gray    MCCS1850            monitor
+NeXTstation Turbo          68040   2 bpp gray    MCCS1850            monitor, ADB
+NeXTstation Turbo Color    68040   16 bpp        MCCS1850            monitor, ADB
+=========================  ======  ============  ==================  ==========
+
+The clock chip can differ by board revision and is detected at run time.
+
+Booting
+=======
+
+``make ARCH=m68k next_defconfig nextboot`` builds
+``arch/m68k/next/boot/nextboot``, an OMAGIC a.out with a small loader and the
+kernel, which the boot ROM loads through BOOTP and TFTP.  The ROM asks for the
+file ``boot``.  The default command line can be set with
+``NEXTBOOT_CMDLINE=...`` on the make command line, arguments typed at the ROM
+monitor are added to it::
+
+    NeXT> b en root=/dev/sda console=ttyS0,9600
+
+The loader needs memory for the kernel and for itself above it, as the image
+is not compressed.  Booting from a local disk is not implemented yet.
+
+Devices
+=======
+
+=====================  ==============================  ======================
+Device                 Driver                          Interface
+=====================  ==============================  ======================
+Z8530 serial ports     pmac_zilog                      ``ttyS0``, ``ttyS1``
+Display                nextfb                          ``fb0``, backlight
+Monitor keyboard       nextkbd                         input
+Monitor mouse          nextkbd                         input
+ADB keyboard, mouse    adb-next, adbhid                input
+NCR53C90 SCSI          next_esp, esp_scsi              SCSI disks and so on
+MB8795 Ethernet        mb8795                          ``eth0``
+Sound                  snd-next                        ALSA
+Clock, NVRAM, power    rtc-next                        ``rtc0``, nvmem
+82077 floppy           floppy                          ``fd0``
+Optical disk           next_mo                         ``mo0``
+DSP56001               dsp56k                          ``dsp56k``
+Laser printer          nextlp                          ``nextlp``
+Status LED             leds-next                       LED class
+=====================  ==============================  ======================
+
+Not supported: the NeXTdimension board, the serial port DMA channels, and the
+sound input of the DSP serial port.
+
+Notes on the hardware
+=====================
+
+DMA channels transfer aligned 16 byte bursts.  The SCSI and floppy controllers
+share one channel, which ``asm/nextdma.h`` arbitrates per transfer.
+
+The interrupt mask register cannot mask all sources.  The kernel therefore
+turns off such sources at the device, and ignores pending ones without a
+handler when dispatching.  The ROM also leaves Ethernet receive DMA running
+after a network boot: this has to be stopped before anything else uses the
+memory, or later packets overwrite it.
+
+Most of this was developed on the Previous emulator, which also documents
+much of the hardware.  To print on the emulator, set the file output directory
+of the printer.  The optical disk and printer engine sequences are based only
+on the emulator and are unverified on real hardware.
+
+Testing
+=======
+
+/dev/nextlp prints one page per open.  ``NEXTLP_SET_PAGE`` in ``asm/nextlp.h``
+sets the width and resolution, each byte holds eight pixels, a set bit prints
+black.
+
+``DSP56K_UPLOAD`` takes up to 512 24 bit words for program memory, the program
+starts at address 0.  ``read`` and ``write`` then talk to it through the host
+port.
-- 
2.54.0


From ce4558857433acb1cf844239fbd838b6fcb37cf9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 05:51:13 +0100
Subject: [PATCH 22/35] block: partitions: Add NeXT disk label parser
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Read the partition table of the labels written by NeXTSTEP and read by the
NeXT ROM.  The checksum positions of the three label versions were checked
against the disk boot code of the ROM.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 block/partitions/Kconfig  |   7 +++
 block/partitions/Makefile |   1 +
 block/partitions/check.h  |   1 +
 block/partitions/core.c   |   3 +
 block/partitions/next.c   | 122 ++++++++++++++++++++++++++++++++++++++
 5 files changed, 134 insertions(+)
 create mode 100644 block/partitions/next.c

diff --git a/block/partitions/Kconfig b/block/partitions/Kconfig
index ce17e41451af..89cdf9ebe134 100644
--- a/block/partitions/Kconfig
+++ b/block/partitions/Kconfig
@@ -217,6 +217,13 @@ config SGI_PARTITION
 	  Say Y here if you would like to be able to read the hard disk
 	  partition table format used by SGI machines.
 
+config NEXT_PARTITION
+	bool "NeXT disk label support" if PARTITION_ADVANCED
+	default y if NEXT
+	help
+	  Say Y here to read the partition table of disks labeled by NeXTSTEP
+	  or by mkbootdisk for booting Linux from the NeXT ROM.
+
 config ULTRIX_PARTITION
 	bool "Ultrix partition table support" if PARTITION_ADVANCED
 	default y if MACH_DECSTATION
diff --git a/block/partitions/Makefile b/block/partitions/Makefile
index 25d424922c6e..8d461372b2e5 100644
--- a/block/partitions/Makefile
+++ b/block/partitions/Makefile
@@ -16,6 +16,7 @@ obj-$(CONFIG_OF_PARTITION) += of.o
 obj-$(CONFIG_OSF_PARTITION) += osf.o
 obj-$(CONFIG_SGI_PARTITION) += sgi.o
 obj-$(CONFIG_SUN_PARTITION) += sun.o
+obj-$(CONFIG_NEXT_PARTITION) += next.o
 obj-$(CONFIG_ULTRIX_PARTITION) += ultrix.o
 obj-$(CONFIG_IBM_PARTITION) += ibm.o
 obj-$(CONFIG_EFI_PARTITION) += efi.o
diff --git a/block/partitions/check.h b/block/partitions/check.h
index b0997467b61a..8e8980555c2a 100644
--- a/block/partitions/check.h
+++ b/block/partitions/check.h
@@ -60,6 +60,7 @@ int karma_partition(struct parsed_partitions *state);
 int ldm_partition(struct parsed_partitions *state);
 int mac_partition(struct parsed_partitions *state);
 int msdos_partition(struct parsed_partitions *state);
+int next_partition(struct parsed_partitions *state);
 int of_partition(struct parsed_partitions *state);
 int osf_partition(struct parsed_partitions *state);
 int sgi_partition(struct parsed_partitions *state);
diff --git a/block/partitions/core.c b/block/partitions/core.c
index b5c59b79ca7c..36429fc19c75 100644
--- a/block/partitions/core.c
+++ b/block/partitions/core.c
@@ -57,6 +57,9 @@ static int (*const check_part[])(struct parsed_partitions *) = {
 #ifdef CONFIG_LDM_PARTITION
 	ldm_partition,		/* this must come before msdos */
 #endif
+#ifdef CONFIG_NEXT_PARTITION
+	next_partition,		/* the label has a checksum, msdos only a signature */
+#endif
 #ifdef CONFIG_MSDOS_PARTITION
 	msdos_partition,
 #endif
diff --git a/block/partitions/next.c b/block/partitions/next.c
new file mode 100644
index 000000000000..f4208f29b346
--- /dev/null
+++ b/block/partitions/next.c
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NeXT disk label partition parser
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+#include "check.h"
+
+#define NEXT_LABEL_V1		0x4e655854	/* "NeXT" */
+#define NEXT_LABEL_V2		0x646c5632	/* "dlV2" */
+#define NEXT_LABEL_V3		0x646c5633	/* "dlV3" */
+
+/* The checksum is the last word of the checksummed area, V3 dropped the bad block list */
+#define NEXT_LABEL_V12_SIZE	0x1c48
+#define NEXT_LABEL_V3_SIZE	0x230
+
+#define NEXT_MAX_PARTS		8
+
+struct next_partition {
+	__be32	offset;		/* in label sectors, behind the front porch */
+	__be32	size;
+	u8	pad[38];
+} __packed;
+
+struct next_label {
+	__be32	version;
+	__be32	label_blkno;
+	u8	pad1[84];
+	__be32	secsize;
+	u8	pad2[16];
+	__be16	front;
+	u8	pad3[76];
+	struct next_partition part[NEXT_MAX_PARTS];
+} __packed;
+
+static_assert(sizeof(struct next_partition) == 46);
+static_assert(offsetof(struct next_label, secsize) == 92);
+static_assert(offsetof(struct next_label, part) == 190);
+static_assert(sizeof(struct next_label) + 2 == NEXT_LABEL_V3_SIZE);
+
+static u16 next_label_sum(const u8 *buf, unsigned int size)
+{
+	u32 sum = 0;
+	unsigned int i;
+
+	for (i = 0; i < size; i += 2)
+		sum += (buf[i] << 8) + buf[i + 1];
+	sum += sum >> 16;
+	return sum;
+}
+
+int next_partition(struct parsed_partitions *state)
+{
+	const struct next_label *label;
+	unsigned int size, i, scale, secsize, front;
+	u16 stored;
+	Sector sect;
+	u8 *data, *buf;
+	int ret = 0;
+
+	data = read_part_sector(state, 0, &sect);
+	if (!data)
+		return -1;
+
+	switch (get_unaligned_be32(data)) {
+	case NEXT_LABEL_V1:
+	case NEXT_LABEL_V2:
+		size = NEXT_LABEL_V12_SIZE;
+		break;
+	case NEXT_LABEL_V3:
+		size = NEXT_LABEL_V3_SIZE;
+		break;
+	default:
+		put_dev_sector(sect);
+		return 0;
+	}
+	put_dev_sector(sect);
+
+	buf = kmalloc(size, GFP_KERNEL);
+	if (!buf)
+		return -1;
+
+	for (i = 0; i < size; i += SECTOR_SIZE) {
+		data = read_part_sector(state, i / SECTOR_SIZE, &sect);
+		if (!data) {
+			ret = -1;
+			goto out;
+		}
+		memcpy(buf + i, data, min(size - i, SECTOR_SIZE));
+		put_dev_sector(sect);
+	}
+
+	/* The checksum is computed with its own field cleared */
+	stored = get_unaligned_be16(buf + size - 2);
+	buf[size - 2] = buf[size - 1] = 0;
+	if (next_label_sum(buf, size) != stored)
+		goto out;
+
+	label = (const struct next_label *)buf;
+	secsize = be32_to_cpu(label->secsize);
+	if (label->label_blkno || !secsize || secsize % SECTOR_SIZE)
+		goto out;
+	scale = secsize / SECTOR_SIZE;
+	front = be16_to_cpu(label->front);
+
+	for (i = 0; i < NEXT_MAX_PARTS; i++) {
+		s32 start = be32_to_cpu(label->part[i].offset);
+		s32 len = be32_to_cpu(label->part[i].size);
+
+		if (start >= 0 && len > 0)
+			put_partition(state, i + 1, (sector_t)(front + start) * scale,
+				      (sector_t)len * scale);
+	}
+	seq_buf_puts(&state->pp_buf, "\n");
+	ret = 1;
+out:
+	kfree(buf);
+	return ret;
+}
-- 
2.54.0


From 08902921173810f74640f9f163ff60dbf039019c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 05:51:13 +0100
Subject: [PATCH 23/35] m68k: next: Add mkbootdisk to boot from SCSI and
 optical disks
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Write a label, the loader and one partition over the rest of the disk.  The
ROM loads the same image as over the network.  It uses the geometry of the
label on optical disks, so this has the 16 sectors per track of these.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/next/boot/Makefile     |   4 +-
 arch/m68k/next/boot/mkbootdisk.c | 152 +++++++++++++++++++++++++++++++
 2 files changed, 154 insertions(+), 2 deletions(-)
 create mode 100644 arch/m68k/next/boot/mkbootdisk.c

diff --git a/arch/m68k/next/boot/Makefile b/arch/m68k/next/boot/Makefile
index e27aa2145be0..3ee09d9b7efc 100644
--- a/arch/m68k/next/boot/Makefile
+++ b/arch/m68k/next/boot/Makefile
@@ -8,7 +8,7 @@
 
 NEXTBOOT_CMDLINE ?= console=ttyS0,9600 console=tty0
 
-hostprogs	:= mkaout
+hostprogs	:= mkaout mkbootdisk
 targets		:= head.o main.o payload.o nextboot.lds vmlinux.strip \
 		   nextboot.elf nextboot.bin nextboot
 
@@ -58,5 +58,5 @@ $(obj)/nextboot.bin: $(obj)/nextboot.elf FORCE
 quiet_cmd_mkaout = MKAOUT  $@
       cmd_mkaout = $(obj)/mkaout $< $$(printf 0x%s $$($(NM) $(obj)/nextboot.elf | sed -n 's/^\([0-9a-f]*\) . _start$$/\1/p')) $@
 
-$(obj)/nextboot: $(obj)/nextboot.bin $(obj)/mkaout FORCE
+$(obj)/nextboot: $(obj)/nextboot.bin $(obj)/mkaout $(obj)/mkbootdisk FORCE
 	$(call if_changed,mkaout)
diff --git a/arch/m68k/next/boot/mkbootdisk.c b/arch/m68k/next/boot/mkbootdisk.c
new file mode 100644
index 000000000000..ad46c71c78d1
--- /dev/null
+++ b/arch/m68k/next/boot/mkbootdisk.c
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Make a disk image or device bootable by the NeXT ROM: a label in block 0,
+ * the nextboot image behind it and one partition over the rest of the disk.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <linux/fs.h>
+
+#define LABEL_V3	0x646c5633	/* "dlV3" */
+#define LABEL_SIZE	0x230
+#define SECSIZE		1024
+#define BOOT_SECTOR	32		/* behind the label copies the ROM looks for */
+
+struct partition {
+	uint32_t offset, size;
+	uint16_t bsize, fsize;
+	char opt, pad1;
+	uint16_t cpg, density;
+	int8_t minfree, newfs;
+	char mountpt[16];
+	int8_t automnt;
+	char type[8];
+	char pad2;
+} __attribute__((packed));
+
+struct label {
+	uint32_t version, label_blkno, size;
+	char label[24];
+	uint32_t flags, tag;
+	char name[24], type[24];
+	uint32_t secsize, ntracks, nsectors, ncylinders, rpm;
+	uint16_t front, back, ngroups, ag_size, ag_alts, ag_off;
+	uint32_t boot_blkno[2];
+	char kernel[24], hostname[32];
+	char rootpartition, rwpartition;
+	struct partition part[8];
+	uint16_t checksum;
+} __attribute__((packed));
+
+static void die(const char *what)
+{
+	perror(what);
+	exit(1);
+}
+
+static uint64_t disk_size(int fd)
+{
+	struct stat st;
+	uint64_t size;
+
+	if (fstat(fd, &st))
+		die("stat");
+	if (!S_ISBLK(st.st_mode))
+		return st.st_size;
+	if (ioctl(fd, BLKGETSIZE64, &size))
+		die("BLKGETSIZE64");
+	return size;
+}
+
+static uint16_t label_sum(const void *data, size_t size)
+{
+	const uint8_t *p = data;
+	uint32_t sum = 0;
+	size_t i;
+
+	for (i = 0; i < size; i += 2)
+		sum += (p[i] << 8) + p[i + 1];
+	sum += sum >> 16;
+	return sum;
+}
+
+int main(int argc, char **argv)
+{
+	uint32_t total, boot_secs, front;
+	struct label l = {};
+	struct stat st;
+	int disk, image;
+	ssize_t len;
+	char *buf;
+
+	if (sizeof(l) != LABEL_SIZE || argc != 3) {
+		fprintf(stderr, "usage: %s DISK NEXTBOOT\n", argv[0]);
+		return 1;
+	}
+	disk = open(argv[1], O_RDWR);
+	if (disk < 0)
+		die(argv[1]);
+	image = open(argv[2], O_RDONLY);
+	if (image < 0 || fstat(image, &st))
+		die(argv[2]);
+
+	total = disk_size(disk) / SECSIZE;
+	boot_secs = (st.st_size + SECSIZE - 1) / SECSIZE;
+	front = BOOT_SECTOR + boot_secs;
+	if (front > 0x7fff || front >= total) {
+		fprintf(stderr, "image of %u KiB does not fit\n", boot_secs);
+		return 1;
+	}
+
+	l.version = htonl(LABEL_V3);
+	l.size = htonl(total - front);
+	strcpy(l.label, "Linux");
+	strcpy(l.name, "Linux");
+	strcpy(l.type, "fixed_rw_scsi");
+	l.secsize = htonl(SECSIZE);
+	l.ntracks = htonl(1);
+	l.nsectors = htonl(16);
+	l.ncylinders = htonl(total / 16);
+	l.rpm = htonl(3600);
+	l.front = htons(front);
+	l.boot_blkno[0] = htonl(BOOT_SECTOR);
+	l.boot_blkno[1] = htonl(-1);
+	strcpy(l.kernel, "nextboot");
+	strcpy(l.hostname, "linux");
+	l.rootpartition = 'a';
+	l.rwpartition = 'a';
+	memset(l.part, 0xff, sizeof(l.part));
+	l.part[0] = (struct partition){
+		.offset = 0, .size = htonl(total - front),
+		.bsize = htons(8192), .fsize = htons(1024), .opt = 't',
+		.cpg = htons(16), .density = htons(4096), .minfree = 5,
+		.type = "ext2",
+	};
+	strcpy(l.part[0].mountpt, "/");
+	l.checksum = htons(label_sum(&l, sizeof(l)));
+
+	if (pwrite(disk, &l, sizeof(l), 0) != sizeof(l))
+		die("label");
+
+	buf = malloc(st.st_size);
+	if (!buf)
+		die("malloc");
+	len = read(image, buf, st.st_size);
+	if (len != st.st_size)
+		die("read image");
+	if (pwrite(disk, buf, len, (off_t)BOOT_SECTOR * SECSIZE) != len)
+		die("boot image");
+	printf("%s: boot image %u KiB, partition a at %u KiB, %u KiB\n",
+	       argv[1], boot_secs, front, total - front);
+	return close(disk) ? 1 : 0;
+}
-- 
2.54.0


From f7cf08b8464ebca552d0df250dafbce355b6cd0d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 05:51:13 +0100
Subject: [PATCH 24/35] block: next_mo: Support two drives and the layout of
 the ROM
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The controller has a drive select bit, so register a disk for each drive and
share one tag between their queues, which run on the same controller and
buffer.

Sector 0 was at track 4096, but the ROM looks for the label at track 4149.
With it at the wrong place partitions could not line up on labeled disks.
Allow partitions as the label parser can now read them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/block/next_mo.c | 148 ++++++++++++++++++++++++++--------------
 1 file changed, 96 insertions(+), 52 deletions(-)

diff --git a/drivers/block/next_mo.c b/drivers/block/next_mo.c
index 5ebdfee7a538..17882c055aac 100644
--- a/drivers/block/next_mo.c
+++ b/drivers/block/next_mo.c
@@ -83,7 +83,8 @@
 /* Disk layout */
 #define MO_SECTOR_SIZE		1024
 #define MO_SEC_PER_TRACK	16
-#define MO_TRACK_OFFSET		4096
+/* Where the ROM looks for the label, the tracks before it are not for data */
+#define MO_TRACK_OFFSET		4149
 #define MO_TRACKS		(19819 - MO_TRACK_OFFSET)
 #define MO_SECTORS		(MO_TRACKS * MO_SEC_PER_TRACK)
 
@@ -94,18 +95,33 @@
 #define MO_CMD_TIMEOUT_MS	3000
 #define MO_OPER_TIMEOUT		(5 * HZ)
 #define MO_RETRIES		2
+#define MO_MAX_DRIVES		2
 
+struct next_mo_drive {
+	struct next_mo *mo;
+	struct gendisk *disk;
+	unsigned int unit;
+};
+
+/* The drives share the controller: their queues share one tag, so one runs at a time */
 struct next_mo {
 	struct device *dev;
 	void __iomem *regs;
-	struct gendisk *disk;
+	struct next_mo_drive drive[MO_MAX_DRIVES];
 	struct blk_mq_tag_set tag_set;
 	struct completion done;
 	void *buf;
 	dma_addr_t buf_dma;
 	u8 wait_mask;
+	u8 csr2;
 };
 
+static void next_mo_select(struct next_mo *mo, unsigned int unit)
+{
+	mo->csr2 = unit;
+	out_8(mo->regs + OSP_CSR2, mo->csr2);
+}
+
 static irqreturn_t next_mo_interrupt(int irq, void *dev_id)
 {
 	struct next_mo *mo = dev_id;
@@ -232,7 +248,7 @@ static int next_mo_pass(struct next_mo *mo, u16 head, u8 fmt, sector_t sector, i
 
 static void next_mo_dma_start(struct next_mo *mo, unsigned int len, u32 dir)
 {
-	out_8(mo->regs + OSP_CSR2, CSR2_CLR_BUF);
+	out_8(mo->regs + OSP_CSR2, mo->csr2 | CSR2_CLR_BUF);
 	nextdma_reset(NEXTDMA_DISK);
 	nextdma_reg_write(NEXTDMA_DISK, NEXTDMA_REG_NEXT, mo->buf_dma);
 	nextdma_reg_write(NEXTDMA_DISK, NEXTDMA_REG_LIMIT, mo->buf_dma + len);
@@ -281,7 +297,8 @@ static int next_mo_xfer(struct next_mo *mo, bool write, sector_t sector, int cou
 static blk_status_t next_mo_queue_rq(struct blk_mq_hw_ctx *hctx,
 				     const struct blk_mq_queue_data *bd)
 {
-	struct next_mo *mo = hctx->queue->queuedata;
+	struct next_mo_drive *drive = hctx->queue->queuedata;
+	struct next_mo *mo = drive->mo;
 	struct request *rq = bd->rq;
 	bool write = rq_data_dir(rq) == WRITE;
 	sector_t sector = blk_rq_pos(rq) >> (ilog2(MO_SECTOR_SIZE) - SECTOR_SHIFT);
@@ -295,6 +312,7 @@ static blk_status_t next_mo_queue_rq(struct blk_mq_hw_ctx *hctx,
 		return BLK_STS_IOERR;
 
 	blk_mq_start_request(rq);
+	next_mo_select(mo, drive->unit);
 
 	if (write) {
 		rq_for_each_segment(bvec, rq, iter) {
@@ -324,7 +342,7 @@ static const struct block_device_operations next_mo_fops = {
 	.owner		= THIS_MODULE,
 };
 
-static int next_mo_probe(struct platform_device *pdev)
+static int next_mo_add_drive(struct next_mo *mo, unsigned int unit)
 {
 	struct queue_limits lim = {
 		.logical_block_size	= MO_SECTOR_SIZE,
@@ -332,10 +350,74 @@ static int next_mo_probe(struct platform_device *pdev)
 		.max_hw_sectors		= MO_BUF_SIZE >> SECTOR_SHIFT,
 		.max_segments		= BLK_MAX_SEGMENTS,
 	};
-	struct next_mo *mo;
+	struct next_mo_drive *drive = &mo->drive[unit];
+	struct gendisk *disk;
 	u16 status = 0;
 	int err;
 
+	next_mo_select(mo, unit);
+
+	/* An absent drive does not complete commands */
+	if (next_mo_drive_cmd(mo, DRV_RESET_ATTN) || next_mo_status(mo, &status))
+		return -ENODEV;
+
+	if (status & DS_EMPTY) {
+		dev_info(mo->dev, "drive %u without a disk\n", unit);
+		return -ENODEV;
+	}
+	if (status & DS_STOPPED) {
+		err = next_mo_drive_cmd(mo, DRV_START_MOTOR);
+		if (err)
+			return err;
+	}
+	err = next_mo_drive_cmd(mo, DRV_RECAL);
+	if (err)
+		return err;
+
+	drive->mo = mo;
+	drive->unit = unit;
+	disk = blk_mq_alloc_disk(&mo->tag_set, &lim, drive);
+	if (IS_ERR(disk))
+		return PTR_ERR(disk);
+
+	disk->fops = &next_mo_fops;
+	disk->private_data = drive;
+	snprintf(disk->disk_name, sizeof(disk->disk_name), "mo%u", unit);
+	set_capacity(disk, (sector_t)MO_SECTORS << (ilog2(MO_SECTOR_SIZE) - SECTOR_SHIFT));
+	if (status & DS_WP)
+		set_disk_ro(disk, true);
+
+	err = add_disk(disk);
+	if (err) {
+		put_disk(disk);
+		return err;
+	}
+	drive->disk = disk;
+
+	dev_info(mo->dev, "drive %u: %u MB disk%s\n", unit, MO_SECTORS / 1024,
+		 status & DS_WP ? ", write protected" : "");
+	return 0;
+}
+
+static void next_mo_del_drives(struct next_mo *mo)
+{
+	unsigned int unit;
+
+	for (unit = 0; unit < MO_MAX_DRIVES; unit++) {
+		if (mo->drive[unit].disk) {
+			del_gendisk(mo->drive[unit].disk);
+			put_disk(mo->drive[unit].disk);
+		}
+	}
+	blk_mq_free_tag_set(&mo->tag_set);
+}
+
+static int next_mo_probe(struct platform_device *pdev)
+{
+	struct next_mo *mo;
+	unsigned int unit, found = 0;
+	int err;
+
 	/* There is no optical drive channel on Turbo models */
 	if (next_is_turbo())
 		return -ENODEV;
@@ -358,23 +440,6 @@ static int next_mo_probe(struct platform_device *pdev)
 	out_8(mo->regs + OSP_CSR2, CSR2_CLR_BUF);
 	out_8(mo->regs + OSP_CSR1, FMT_RESET);
 
-	/* An absent drive does not complete commands */
-	if (next_mo_drive_cmd(mo, DRV_RESET_ATTN) || next_mo_status(mo, &status))
-		return -ENODEV;
-
-	if (status & DS_EMPTY) {
-		dev_info(&pdev->dev, "drive without a disk\n");
-		return -ENODEV;
-	}
-	if (status & DS_STOPPED) {
-		err = next_mo_drive_cmd(mo, DRV_START_MOTOR);
-		if (err)
-			return err;
-	}
-	err = next_mo_drive_cmd(mo, DRV_RECAL);
-	if (err)
-		return err;
-
 	mo->buf = dmam_alloc_coherent(&pdev->dev, MO_BUF_SIZE, &mo->buf_dma, GFP_KERNEL);
 	if (!mo->buf)
 		return -ENOMEM;
@@ -388,41 +453,20 @@ static int next_mo_probe(struct platform_device *pdev)
 	if (err)
 		return err;
 
-	mo->disk = blk_mq_alloc_disk(&mo->tag_set, &lim, mo);
-	if (IS_ERR(mo->disk)) {
-		err = PTR_ERR(mo->disk);
-		goto err_tags;
-	}
-	mo->disk->flags |= GENHD_FL_NO_PART;
-	mo->disk->fops = &next_mo_fops;
-	mo->disk->private_data = mo;
-	strscpy(mo->disk->disk_name, "mo0", sizeof(mo->disk->disk_name));
-	set_capacity(mo->disk, (sector_t)MO_SECTORS << (ilog2(MO_SECTOR_SIZE) - SECTOR_SHIFT));
-	if (status & DS_WP)
-		set_disk_ro(mo->disk, true);
-
-	err = add_disk(mo->disk);
-	if (err)
-		goto err_disk;
+	for (unit = 0; unit < MO_MAX_DRIVES; unit++)
+		if (!next_mo_add_drive(mo, unit))
+			found++;
 
-	dev_info(&pdev->dev, "%u MB disk%s\n", MO_SECTORS / 1024,
-		 status & DS_WP ? ", write protected" : "");
+	if (!found) {
+		next_mo_del_drives(mo);
+		return -ENODEV;
+	}
 	return 0;
-
-err_disk:
-	put_disk(mo->disk);
-err_tags:
-	blk_mq_free_tag_set(&mo->tag_set);
-	return err;
 }
 
 static void next_mo_remove(struct platform_device *pdev)
 {
-	struct next_mo *mo = platform_get_drvdata(pdev);
-
-	del_gendisk(mo->disk);
-	put_disk(mo->disk);
-	blk_mq_free_tag_set(&mo->tag_set);
+	next_mo_del_drives(platform_get_drvdata(pdev));
 }
 
 static struct platform_driver next_mo_driver = {
