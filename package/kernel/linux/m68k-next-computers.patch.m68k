 arch/m68k/kernel/head.S                    |  76 ++++++-
 arch/m68k/kernel/setup_mm.c                |  23 ++
 arch/m68k/mac/config.c                     |  12 -
 arch/m68k/next/Makefile                    |   6 +
 arch/m68k/next/boot/Makefile               |  62 ++++++
 arch/m68k/next/boot/head.S                 |  60 +++++
 arch/m68k/next/boot/main.c                 | 248 +++++++++++++++++++++
 arch/m68k/next/boot/mkaout.c               |  62 ++++++
 arch/m68k/next/boot/nextboot.lds           |  15 ++
 arch/m68k/next/boot/payload.S              |   6 +
 arch/m68k/next/config.c                    | 158 +++++++++++++
