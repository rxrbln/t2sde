+#include <linux/platform_device.h>
 
 #include <asm/bootinfo.h>
 #include <asm/byteorder.h>
@@ -182,6 +183,8 @@ static void __init m68k_parse_bootinfo(const struct bi_record *record)
 				unknown = apollo_parse_bootinfo(record);
