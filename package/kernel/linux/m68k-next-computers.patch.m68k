diff --git a/arch/m68k/next/Makefile b/arch/m68k/next/Makefile
new file mode 100644
index 000000000000..19cfc9204f93
--- /dev/null
+++ b/arch/m68k/next/Makefile
@@ -0,0 +1,6 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Makefile for Linux arch/m68k/next source directory
+#
+
+obj-y		:= config.o ints.o reset.o time.o
diff --git a/arch/m68k/next/boot/Makefile b/arch/m68k/next/boot/Makefile
new file mode 100644
index 000000000000..e27aa2145be0
--- /dev/null
+++ b/arch/m68k/next/boot/Makefile
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Bootable image for the NeXT ROM: an OMAGIC a.out holding this loader and
+# the stripped kernel ELF. The loader is linked above the running kernel.
+#
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+#
+
+NEXTBOOT_CMDLINE ?= console=ttyS0,9600 console=tty0
+
+hostprogs	:= mkaout
+targets		:= head.o main.o payload.o nextboot.lds vmlinux.strip \
+		   nextboot.elf nextboot.bin nextboot
+
+# Room above the kernel for head.S page tables and bootinfo
+NEXT_RAM	:= 0x04000000
+NEXTBOOT_SLACK	:= 0x00200000
+
+kernel-end	 = $(shell $(NM) vmlinux | sed -n 's/^\([0-9a-f]*\) . _end$$/0x\1/p')
+
+KBUILD_CFLAGS	:= -m68030 -msoft-float -Os -std=gnu11 -Wall -ffreestanding \
+		   -fno-pic -fno-stack-protector -fno-asynchronous-unwind-tables \
+		   -fno-builtin -nostdinc \
+		   -I$(srctree)/arch/m68k/include/uapi -I$(srctree)/include/uapi \
+		   -I$(objtree)/arch/m68k/include/generated/uapi \
+		   -I$(objtree)/include/generated/uapi -D__KERNEL__
+KBUILD_AFLAGS	:= -m68030 -msoft-float -D__ASSEMBLY__ -D__ASSEMBLER__ \
+		   -I$(srctree)/arch/m68k/include/uapi
+KBUILD_CFLAGS_KERNEL	:=
+KBUILD_AFLAGS_KERNEL	:=
+
+CFLAGS_main.o	:= -DKERNEL_END=$(kernel-end) -DNEXT_RAM=$(NEXT_RAM) \
+		   -DNEXTBOOT_CMDLINE='"$(NEXTBOOT_CMDLINE)"'
+AFLAGS_payload.o := -DVMLINUX_STRIP='"$(obj)/vmlinux.strip"'
+
+$(obj)/payload.o: $(obj)/vmlinux.strip
+
+quiet_cmd_strip = STRIP   $@
+      cmd_strip = $(OBJCOPY) --strip-all vmlinux $@
+
+$(obj)/vmlinux.strip: vmlinux FORCE
+	$(call if_changed,strip)
+
+quiet_cmd_nextld = LD      $@
+      cmd_nextld = $(LD) -m m68kelf -T $(src)/nextboot.lds --no-warn-rwx-segments \
+		   --defsym=LOAD_ADDR=$$(printf 0x%x $$(( ($(NEXT_RAM) + $(kernel-end) + $(NEXTBOOT_SLACK)) & ~0xffff ))) \
+		   $(obj)/head.o $(obj)/main.o $(obj)/payload.o -o $@
+
+$(obj)/nextboot.elf: $(obj)/head.o $(obj)/main.o $(obj)/payload.o $(src)/nextboot.lds FORCE
+	$(call if_changed,nextld)
+
+quiet_cmd_nextbin = OBJCOPY $@
+      cmd_nextbin = $(OBJCOPY) -O binary $< $@
+
+$(obj)/nextboot.bin: $(obj)/nextboot.elf FORCE
+	$(call if_changed,nextbin)
+
+quiet_cmd_mkaout = MKAOUT  $@
+      cmd_mkaout = $(obj)/mkaout $< $$(printf 0x%s $$($(NM) $(obj)/nextboot.elf | sed -n 's/^\([0-9a-f]*\) . _start$$/\1/p')) $@
+
+$(obj)/nextboot: $(obj)/nextboot.bin $(obj)/mkaout FORCE
+	$(call if_changed,mkaout)
diff --git a/arch/m68k/next/boot/head.S b/arch/m68k/next/boot/head.S
new file mode 100644
index 000000000000..3df073f9a3fc
--- /dev/null
+++ b/arch/m68k/next/boot/head.S
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * NeXT ROM entry in supervisor state, its VBR table holds the mon_global pointer
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+	.section .text.start,"ax"
+	.globl	_start
+_start:
+	movew	#0x2700,%sr
+	movec	%vbr,%a0
+	movel	%a0@(4),%d2
+	lea	stack_top,%sp
+
+	lea	__bss_start,%a0
+	lea	__bss_end,%a1
+1:	cmpl	%a0,%a1
+	jls	2f
+	clrl	%a0@+
+	jra	1b
+2:
+	movel	%d2,%sp@-
+	jbsr	next_boot
+3:	jra	3b
+
+	/* void enter_kernel(unsigned long entry, int is_040) */
+	.globl	enter_kernel
+enter_kernel:
+	movel	%sp@(4),%a0
+	tstl	%sp@(8)
+	jeq	1f
+
+	.chip	68040
+	cpusha	%bc
+	moveq	#0,%d0
+	movec	%d0,%cacr
+	cinva	%bc
+	movec	%d0,%tc
+	pflusha
+	movec	%d0,%itt0
+	movec	%d0,%itt1
+	movec	%d0,%dtt0
+	movec	%d0,%dtt1
+	jmp	%a0@
+
+1:	.chip	68030
+	/* Disable and clear both caches */
+	movel	#0x0808,%d0
+	movec	%d0,%cacr
+	clrl	%sp@-
+	pmove	%sp@,%tc
+	pflusha
+	pmove	%sp@,%tt0
+	pmove	%sp@,%tt1
+	jmp	%a0@
+
+	.bss
+	.space	8192
+stack_top:
diff --git a/arch/m68k/next/boot/main.c b/arch/m68k/next/boot/main.c
new file mode 100644
index 000000000000..98a8b66ce6b6
--- /dev/null
+++ b/arch/m68k/next/boot/main.c
@@ -0,0 +1,248 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NeXT boot loader: place the kernel ELF, build bootinfo and start it.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/types.h>
+#include <linux/elf.h>
+#include <asm/bootinfo.h>
+#include <asm/bootinfo-next.h>
+
+/* Byte offsets into the ROM struct mon_global */
+#define MG_SIMM		0
+#define MG_BOOT_ARG	244
+#define MG_ETHERADDR	788
+#define MG_PUTC		734
+#define MG_MACHINE	936
+#define MG_BOARD_REV	937
+
+#define NR_SIMM		4
+#define SIMM_SIZE	0x03
+#define SIMM_16MB	0x01
+#define SIMM_4MB	0x02
+#define SIMM_1MB	0x03
+
+/* The ROM keeps its data at the very top of memory */
+#define ROM_RESERVED	0x2000
+
+#define CMDLINE_SIZE	256
+
+#define NR_CHUNKS	NR_SIMM
+
+extern const char payload_start[], payload_end[], _start[];
+void enter_kernel(unsigned long entry, int is_040) __attribute__((noreturn));
+
+static const char *mg;
+
+static void putc_rom(char c)
+{
+	void (*rom_putc)(int) = *(void (**)(int))(mg + MG_PUTC);
+
+	rom_putc(c);
+}
+
+static void puts_rom(const char *s)
+{
+	while (*s)
+		putc_rom(*s++);
+}
+
+static void put_hex(unsigned long v)
+{
+	int i;
+
+	for (i = 28; i >= 0; i -= 4)
+		putc_rom("0123456789abcdef"[(v >> i) & 15]);
+}
+
+static void *copy(void *d, const void *s, unsigned long n)
+{
+	char *dp = d;
+	const char *sp = s;
+
+	while (n--)
+		*dp++ = *sp++;
+	return d;
+}
+
+static void zero(void *d, unsigned long n)
+{
+	char *dp = d;
+
+	while (n--)
+		*dp++ = 0;
+}
+
+static unsigned long str_len(const char *s)
+{
+	unsigned long n = 0;
+
+	while (s[n])
+		n++;
+	return n;
+}
+
+static char *bi;
+
+static void bi_add(u16 tag, const void *data, unsigned long size)
+{
+	struct bi_record *rec = (struct bi_record *)bi;
+	u16 rec_size = (sizeof(*rec) + size + 3) & ~3;
+
+	rec->tag = tag;
+	rec->size = rec_size;
+	copy(rec->data, data, size);
+	bi += rec_size;
+}
+
+static void bi_add_u32(u16 tag, u32 v)
+{
+	bi_add(tag, &v, sizeof(v));
+}
+
+/* Size of every SIMM class per machine, each slot decodes the largest one */
+static void simm_sizes(unsigned int machine, unsigned long *m16, unsigned long *m4,
+		       unsigned long *m1)
+{
+	switch (machine) {
+	case NEXT_MACH_COLOR:
+		*m16 = 0x800000;
+		*m4 = 0x200000;
+		*m1 = 0x80000;
+		break;
+	case NEXT_MACH_TURBO:
+	case NEXT_MACH_TURBO_COLOR:
+	case NEXT_MACH_CUBE_TURBO:
+		*m16 = 0x2000000;
+		*m4 = 0x800000;
+		*m1 = 0x200000;
+		break;
+	default:
+		*m16 = 0x1000000;
+		*m4 = 0x400000;
+		*m1 = 0x100000;
+		break;
+	}
+}
+
+static unsigned int get_memory(unsigned int machine, struct mem_info *chunks)
+{
+	unsigned long m16, m4, m1;
+	unsigned int i, n = 0;
+
+	simm_sizes(machine, &m16, &m4, &m1);
+
+	for (i = 0; i < NR_SIMM; i++) {
+		unsigned long base = NEXT_RAM + i * m16, size;
+
+		switch (mg[MG_SIMM + i] & SIMM_SIZE) {
+		case SIMM_16MB:
+			size = m16;
+			break;
+		case SIMM_4MB:
+			size = m4;
+			break;
+		case SIMM_1MB:
+			size = m1;
+			break;
+		default:
+			continue;
+		}
+		if (n && chunks[n - 1].addr + chunks[n - 1].size == base)
+			chunks[n - 1].size += size;
+		else {
+			chunks[n].addr = base;
+			chunks[n].size = size;
+			n++;
+		}
+	}
+	if (n)
+		chunks[n - 1].size -= ROM_RESERVED;
+	return n;
+}
+
+void next_boot(const char *mon_global)
+{
+	const Elf32_Ehdr *eh = (const Elf32_Ehdr *)payload_start;
+	const Elf32_Phdr *ph;
+	struct mem_info chunks[NR_CHUNKS];
+	char cmdline[CMDLINE_SIZE];
+	const char *arg, *rec;
+	unsigned int machine, nchunks, i;
+	unsigned long len;
+	int is_040;
+
+	mg = mon_global;
+	machine = (unsigned char)mg[MG_MACHINE];
+	is_040 = machine != NEXT_MACH_CUBE030;
+
+	puts_rom("Linux nextboot, machine ");
+	put_hex(machine);
+	puts_rom("\n");
+
+	if (eh->e_ident[EI_MAG0] != ELFMAG0 || eh->e_ident[EI_MAG1] != ELFMAG1 ||
+	    eh->e_machine != EM_68K) {
+		puts_rom("nextboot: invalid kernel image\n");
+		return;
+	}
+
+	nchunks = get_memory(machine, chunks);
+	if (!nchunks) {
+		puts_rom("nextboot: no memory found\n");
+		return;
+	}
+
+	ph = (const Elf32_Phdr *)(payload_start + eh->e_phoff);
+	for (i = 0; i < eh->e_phnum; i++, ph++) {
+		char *dst;
+
+		if (ph->p_type != PT_LOAD)
+			continue;
+		dst = (char *)(NEXT_RAM + ph->p_vaddr);
+		if ((unsigned long)dst + ph->p_memsz > (unsigned long)_start) {
+			puts_rom("nextboot: kernel overlaps loader\n");
+			return;
+		}
+		copy(dst, payload_start + ph->p_offset, ph->p_filesz);
+		zero(dst + ph->p_filesz, ph->p_memsz - ph->p_filesz);
+	}
+
+	/* Bootinfo directly follows the kernel, see setup_arch() */
+	bi = (char *)(NEXT_RAM + KERNEL_END);
+	rec = bi;
+	bi_add_u32(BI_MACHTYPE, MACH_NEXT);
+	bi_add_u32(BI_CPUTYPE, is_040 ? CPU_68040 : CPU_68030);
+	bi_add_u32(BI_MMUTYPE, is_040 ? MMU_68040 : MMU_68030);
+	bi_add_u32(BI_FPUTYPE, is_040 ? FPU_68040 : FPU_68882);
+	for (i = 0; i < nchunks; i++)
+		bi_add(BI_MEMCHUNK, &chunks[i], sizeof(chunks[i]));
+
+	/* Arguments typed at the ROM monitor follow the built in default */
+	len = str_len(NEXTBOOT_CMDLINE);
+	copy(cmdline, NEXTBOOT_CMDLINE, len);
+	arg = *(const char **)(mg + MG_BOOT_ARG);
+	if (arg && *arg) {
+		unsigned long alen = str_len(arg);
+
+		if (len + alen + 2 <= sizeof(cmdline)) {
+			cmdline[len++] = ' ';
+			copy(cmdline + len, arg, alen);
+			len += alen;
+		}
+	}
+	cmdline[len++] = 0;
+	bi_add(BI_COMMAND_LINE, cmdline, len);
+
+	bi_add_u32(BI_NEXT_MACHINE, machine);
+	bi_add_u32(BI_NEXT_BOARD_REV, (unsigned char)mg[MG_BOARD_REV]);
+	bi_add(BI_NEXT_ETHADDR, *(const char **)(mg + MG_ETHERADDR), 6);
+	bi_add_u32(BI_LAST, 0);
+
+	puts_rom("Starting kernel, bootinfo ");
+	put_hex((unsigned long)rec);
+	puts_rom("\n");
+
+	enter_kernel(NEXT_RAM + eh->e_entry, is_040);
+}
diff --git a/arch/m68k/next/boot/mkaout.c b/arch/m68k/next/boot/mkaout.c
new file mode 100644
index 000000000000..a4f9e1428a9a
--- /dev/null
+++ b/arch/m68k/next/boot/mkaout.c
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Prepend the OMAGIC a.out header the NeXT ROM requires to a raw binary.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static void put_be32(unsigned char *p, uint32_t v)
+{
+	p[0] = v >> 24;
+	p[1] = v >> 16;
+	p[2] = v >> 8;
+	p[3] = v;
+}
+
+int main(int argc, char **argv)
+{
+	unsigned char hdr[32] = { 0 }, buf[65536];
+	FILE *in, *out;
+	long size;
+	size_t n;
+
+	if (argc != 4) {
+		fprintf(stderr, "usage: %s binary entry output\n", argv[0]);
+		return 1;
+	}
+
+	in = fopen(argv[1], "rb");
+	if (!in || fseek(in, 0, SEEK_END) || (size = ftell(in)) < 0) {
+		perror(argv[1]);
+		return 1;
+	}
+	rewind(in);
+
+	/* a_magic, a_text, a_data, a_bss, a_syms, a_entry, a_trsize, a_drsize */
+	put_be32(hdr, 0x00000107);
+	put_be32(hdr + 4, size);
+	put_be32(hdr + 20, strtoul(argv[2], NULL, 0));
+
+	out = fopen(argv[3], "wb");
+	if (!out || fwrite(hdr, sizeof(hdr), 1, out) != 1) {
+		perror(argv[3]);
+		return 1;
+	}
+	while ((n = fread(buf, 1, sizeof(buf), in)) > 0) {
+		if (fwrite(buf, 1, n, out) != n) {
+			perror(argv[3]);
+			return 1;
+		}
+	}
+	if (ferror(in) || fclose(out)) {
+		perror(argv[3]);
+		return 1;
+	}
+	fclose(in);
+	return 0;
+}
diff --git a/arch/m68k/next/boot/nextboot.lds b/arch/m68k/next/boot/nextboot.lds
new file mode 100644
index 000000000000..e2a5773d2137
--- /dev/null
+++ b/arch/m68k/next/boot/nextboot.lds
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+OUTPUT_FORMAT("elf32-m68k")
+OUTPUT_ARCH(m68k)
+ENTRY(_start)
+
+SECTIONS
+{
+	. = LOAD_ADDR;
+	.text : { *(.text.start) *(.text*) }
+	.rodata : { *(.rodata*) }
+	.data : { *(.data*) }
+	.bss : { __bss_start = .; *(.bss*) *(COMMON) . = ALIGN(4); __bss_end = .; }
+	.payload : ALIGN(16) { *(.payload) }
+	/DISCARD/ : { *(.comment) *(.note*) *(.eh_frame*) }
+}
diff --git a/arch/m68k/next/boot/payload.S b/arch/m68k/next/boot/payload.S
new file mode 100644
index 000000000000..025b5fd45c58
--- /dev/null
+++ b/arch/m68k/next/boot/payload.S
@@ -0,0 +1,6 @@
