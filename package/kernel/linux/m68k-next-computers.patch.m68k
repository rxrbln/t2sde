diff --git a/arch/m68k/Kbuild b/arch/m68k/Kbuild
index 7762af9f6def..6dd34a2754e8 100644
--- a/arch/m68k/Kbuild
+++ b/arch/m68k/Kbuild
@@ -18,3 +18,4 @@ obj-$(CONFIG_M68KFPU_EMU)	+= math-emu/
 obj-$(CONFIG_M68000)		+= 68000/
 obj-$(CONFIG_COLDFIRE)		+= coldfire/
 obj-$(CONFIG_VIRT)		+= virt/
+obj-$(CONFIG_NEXT)		+= next/
diff --git a/arch/m68k/Kconfig.machine b/arch/m68k/Kconfig.machine
index cff990c319cb..f0f1fc21a2e9 100644
--- a/arch/m68k/Kconfig.machine
+++ b/arch/m68k/Kconfig.machine
@@ -38,6 +38,17 @@ config MAC
 	  browse the documentation available at <http://www.mac.linux-m68k.org/>;
 	  otherwise say N.
 
+config NEXT
+	bool "NeXT support"
+	depends on MMU
+	select LEGACY_TIMER_TICK
+	help
+	  This option enables support for the NeXT 68030 and 68040 computers:
+	  NeXT Computer, NeXTcube, NeXTstation and NeXTstation Color.
+
+	  Say Y here to build a kernel for these machines, and build the
+	  "nextboot" target for an image the boot ROM can load.
+
 config APOLLO
 	bool "Apollo support"
 	depends on MMU
diff --git a/arch/m68k/Makefile b/arch/m68k/Makefile
index 0abcf994ce55..b02766af4ff5 100644
--- a/arch/m68k/Makefile
+++ b/arch/m68k/Makefile
@@ -124,6 +124,9 @@ else
 	$(KBZIP2) -1c vmlinux >vmlinux.bz2
 endif
 
+nextboot: vmlinux
+	$(Q)$(MAKE) $(build)=arch/m68k/next/boot arch/m68k/next/boot/nextboot
+
 CLEAN_FILES += vmlinux.gz vmlinux.bz2
 
 archheaders:
