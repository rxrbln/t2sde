From d3c730fc43e7a1646dc3509935851223181855ab Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 05:51:13 +0100
Subject: [PATCH 25/35] fbdev: Add NeXTdimension framebuffer driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Use the NeXTdimension board in a NeXTcube slot as a 32 bpp display.  The host
draws directly into the VRAM, the i860 is not used.  Boards are found by the
ID in their NBIC, which is probed as absent slots raise a bus error.

Only tested on the Previous emulator.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/next/config.c         |   4 +
 drivers/video/fbdev/Kconfig     |   8 ++
 drivers/video/fbdev/Makefile    |   1 +
 drivers/video/fbdev/nextdimfb.c | 204 ++++++++++++++++++++++++++++++++
 4 files changed, 217 insertions(+)
 create mode 100644 drivers/video/fbdev/nextdimfb.c

diff --git a/arch/m68k/next/config.c b/arch/m68k/next/config.c
index c12070b9717c..f3dc22d10c1c 100644
--- a/arch/m68k/next/config.c
+++ b/arch/m68k/next/config.c
@@ -218,6 +218,10 @@ static int __init next_platform_init(void)
 	platform_device_register_simple("leds-next", -1, NULL, 0);
 	platform_device_register_simple("next_mo", -1, NULL, 0);
 	platform_device_register_simple("nextlp", -1, NULL, 0);
+	/* Only the cubes have NeXTbus slots */
+	if (next_machine == NEXT_MACH_CUBE030 || next_machine == NEXT_MACH_CUBE ||
+	    next_machine == NEXT_MACH_CUBE_TURBO)
+		platform_device_register_simple("nextdimfb", -1, NULL, 0);
 
 	return 0;
 }
diff --git a/drivers/video/fbdev/Kconfig b/drivers/video/fbdev/Kconfig
index 33ca85d04c6a..1ba02b80e48f 100644
--- a/drivers/video/fbdev/Kconfig
+++ b/drivers/video/fbdev/Kconfig
@@ -198,6 +198,14 @@ config FB_Q40
 	default y
 	select FB_IOMEM_HELPERS
 
+config FB_NEXTDIMENSION
+	bool "NeXTdimension framebuffer support"
+	depends on (FB = y) && NEXT
+	select FB_IOMEM_HELPERS
+	help
+	  Support for the 32 bpp display of the NeXTdimension board in a
+	  NeXTcube. The i860 on the board is not used.
+
 config FB_NEXT
 	bool "NeXT framebuffer support"
 	depends on (FB = y) && NEXT
diff --git a/drivers/video/fbdev/Makefile b/drivers/video/fbdev/Makefile
index bb70b34e8f21..2516e26c9cab 100644
--- a/drivers/video/fbdev/Makefile
+++ b/drivers/video/fbdev/Makefile
@@ -65,6 +65,7 @@ obj-$(CONFIG_FB_XVR1000)          += sunxvr1000.o
 obj-$(CONFIG_FB_APOLLO)           += dnfb.o
 obj-$(CONFIG_FB_Q40)              += q40fb.o
 obj-$(CONFIG_FB_NEXT)             += nextfb.o
+obj-$(CONFIG_FB_NEXTDIMENSION)    += nextdimfb.o
 obj-$(CONFIG_FB_TGA)              += tgafb.o
 obj-$(CONFIG_FB_HP300)            += hpfb.o
 obj-$(CONFIG_FB_G364)             += g364fb.o
diff --git a/drivers/video/fbdev/nextdimfb.c b/drivers/video/fbdev/nextdimfb.c
new file mode 100644
index 000000000000..54cc2fc03ae4
--- /dev/null
+++ b/drivers/video/fbdev/nextdimfb.c
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NeXTdimension framebuffer: the 32 bpp display of the i860 board in a NeXTcube.
+ * The i860 and its firmware are not used, the host draws directly into the VRAM.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/fb.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include <asm/hwtest.h>
+
+/* A board takes two slots and shows up at the even one */
+#define ND_FIRST_SLOT		2
+#define ND_LAST_SLOT		6
+#define ND_MAX_BOARDS		3
+
+#define ND_NBIC_PAGE(slot)	(0xf0fff000UL | ((unsigned long)(slot) << 24))
+#define ND_NBIC_ID		0xff0	/* one ID byte in each long word */
+#define ND_ID			0xc0000001
+
+#define ND_BOARD(slot)		((unsigned long)(slot) << 28)
+#define ND_VRAM			0x0e000000
+#define ND_VRAM_SIZE		0x00400000
+#define ND_MC			0x0f800000
+#define ND_MC_SIZE		0x00004000
+#define ND_MC_VRAM		0x2000
+#define ND_MC_VRAM_ENABLE	0x00000001
+
+#define ND_WIDTH		1120
+#define ND_HEIGHT		832
+#define ND_LINE_LENGTH		((ND_WIDTH + 32) * 4)
+
+struct nextdimfb_par {
+	void __iomem *mc;
+	u32 pseudo_palette[16];
+};
+
+struct nextdimfb {
+	struct fb_info *info[ND_MAX_BOARDS];
+};
+
+static int nextdimfb_setcolreg(unsigned int regno, unsigned int red, unsigned int green,
+			       unsigned int blue, unsigned int transp, struct fb_info *info)
+{
+	if (regno >= 16)
+		return 1;
+
+	((u32 *)info->pseudo_palette)[regno] =
+		((red >> 8) << info->var.red.offset) |
+		((green >> 8) << info->var.green.offset) |
+		((blue >> 8) << info->var.blue.offset);
+	return 0;
+}
+
+static int nextdimfb_blank(int blank, struct fb_info *info)
+{
+	struct nextdimfb_par *par = info->par;
+	u32 vram = in_be32(par->mc + ND_MC_VRAM);
+
+	if (blank)
+		vram &= ~ND_MC_VRAM_ENABLE;
+	else
+		vram |= ND_MC_VRAM_ENABLE;
+	out_be32(par->mc + ND_MC_VRAM, vram);
+	return 0;
+}
+
+static const struct fb_ops nextdimfb_ops = {
+	.owner		= THIS_MODULE,
+	FB_DEFAULT_IOMEM_OPS,
+	.fb_setcolreg	= nextdimfb_setcolreg,
+	.fb_blank	= nextdimfb_blank,
+};
+
+static bool nextdimfb_present(unsigned int slot)
+{
+	void __iomem *nbic = ioremap(ND_NBIC_PAGE(slot), PAGE_SIZE);
+	u32 id = 0;
+	int i;
+
+	if (!nbic)
+		return false;
+	for (i = 0; i < 4; i++) {
+		void __iomem *reg = nbic + ND_NBIC_ID + i * 4;
+
+		if (!hwreg_present(reg)) {
+			iounmap(nbic);
+			return false;
+		}
+		id = (id << 8) | in_8(reg);
+	}
+	iounmap(nbic);
+	return id == ND_ID;
+}
+
+static struct fb_info *nextdimfb_add(struct device *dev, unsigned int slot)
+{
+	unsigned long board = ND_BOARD(slot);
+	struct nextdimfb_par *par;
+	struct fb_info *info;
+
+	info = framebuffer_alloc(sizeof(*par), dev);
+	if (!info)
+		return NULL;
+	par = info->par;
+
+	snprintf(info->fix.id, sizeof(info->fix.id), "nextdim%u", slot);
+	info->fix.smem_start = board + ND_VRAM;
+	info->fix.smem_len = ND_VRAM_SIZE;
+	info->fix.mmio_start = board + ND_MC;
+	info->fix.mmio_len = ND_MC_SIZE;
+	info->fix.type = FB_TYPE_PACKED_PIXELS;
+	info->fix.visual = FB_VISUAL_TRUECOLOR;
+	info->fix.line_length = ND_LINE_LENGTH;
+	info->fix.accel = FB_ACCEL_NONE;
+
+	info->var.xres = info->var.xres_virtual = ND_WIDTH;
+	info->var.yres = info->var.yres_virtual = ND_HEIGHT;
+	info->var.bits_per_pixel = 32;
+	info->var.red = (struct fb_bitfield){ .offset = 24, .length = 8 };
+	info->var.green = (struct fb_bitfield){ .offset = 16, .length = 8 };
+	info->var.blue = (struct fb_bitfield){ .offset = 8, .length = 8 };
+	info->var.transp = (struct fb_bitfield){ .offset = 0, .length = 8 };
+	info->var.activate = FB_ACTIVATE_NOW;
+	info->var.vmode = FB_VMODE_NONINTERLACED;
+	info->var.height = info->var.width = -1;
+
+	info->fbops = &nextdimfb_ops;
+	info->pseudo_palette = par->pseudo_palette;
+
+	par->mc = ioremap(board + ND_MC, ND_MC_SIZE);
+	info->screen_base = ioremap_wt(board + ND_VRAM, ND_VRAM_SIZE);
+	info->screen_size = ND_VRAM_SIZE;
+	if (!par->mc || !info->screen_base)
+		goto err;
+
+	nextdimfb_blank(FB_BLANK_UNBLANK, info);
+
+	if (register_framebuffer(info))
+		goto err;
+
+	fb_info(info, "NeXTdimension in slot %u, %ux%u, 32 bpp\n", slot, ND_WIDTH, ND_HEIGHT);
+	return info;
+err:
+	if (info->screen_base)
+		iounmap(info->screen_base);
+	if (par->mc)
+		iounmap(par->mc);
+	framebuffer_release(info);
+	return NULL;
+}
+
+static int nextdimfb_probe(struct platform_device *pdev)
+{
+	struct nextdimfb *nd;
+	unsigned int slot, found = 0;
+
+	nd = devm_kzalloc(&pdev->dev, sizeof(*nd), GFP_KERNEL);
+	if (!nd)
+		return -ENOMEM;
+	platform_set_drvdata(pdev, nd);
+
+	for (slot = ND_FIRST_SLOT; slot <= ND_LAST_SLOT; slot += 2) {
+		if (!nextdimfb_present(slot))
+			continue;
+		nd->info[found] = nextdimfb_add(&pdev->dev, slot);
+		if (nd->info[found])
+			found++;
+	}
+	return found ? 0 : -ENODEV;
+}
+
+static void nextdimfb_remove(struct platform_device *pdev)
+{
+	struct nextdimfb *nd = platform_get_drvdata(pdev);
+	unsigned int i;
+
+	for (i = 0; i < ND_MAX_BOARDS && nd->info[i]; i++) {
+		struct fb_info *info = nd->info[i];
+		struct nextdimfb_par *par = info->par;
+
+		unregister_framebuffer(info);
+		iounmap(info->screen_base);
+		iounmap(par->mc);
+		framebuffer_release(info);
+	}
+}
+
+static struct platform_driver nextdimfb_driver = {
+	.probe	= nextdimfb_probe,
+	.remove	= nextdimfb_remove,
+	.driver	= {
+		.name = "nextdimfb",
+	},
+};
+module_platform_driver(nextdimfb_driver);
+
+MODULE_DESCRIPTION("NeXTdimension framebuffer driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 8ae0b93b8f5f5e2c33bac3e911fb927c85171edb Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 05:51:13 +0100
Subject: [PATCH 26/35] m68k: next: Enable CD-ROM and NeXTdimension, document
 disk boot
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 Documentation/arch/m68k/next.rst | 44 +++++++++++++++++++++++++++-----
 arch/m68k/configs/next_defconfig |  4 +++
 2 files changed, 42 insertions(+), 6 deletions(-)

diff --git a/Documentation/arch/m68k/next.rst b/Documentation/arch/m68k/next.rst
index 7cbcb4460052..eb94f3e101df 100644
--- a/Documentation/arch/m68k/next.rst
+++ b/Documentation/arch/m68k/next.rst
@@ -34,7 +34,21 @@ monitor are added to it::
     NeXT> b en root=/dev/sda console=ttyS0,9600
 
 The loader needs memory for the kernel and for itself above it, as the image
-is not compressed.  Booting from a local disk is not implemented yet.
+is not compressed.
+
+To boot from a SCSI or optical disk, ``arch/m68k/next/boot/mkbootdisk`` writes
+a NeXT disk label to the start of a disk or image, stores the loader behind
+the label for the ROM and adds one partition over the rest of the disk, which
+holds the root file system.  An optical disk is written from a running Linux
+as the first sectors of ``mo0``, as its image format holds error correction
+codes::
+
+    mkbootdisk disk.img nextboot
+    NeXT> b sd root=/dev/sda1
+
+The NeXT label parser reads the partitions of such disks and of disks labeled
+by NeXTSTEP.  On optical disks sector 0 is track 4149, where the ROM looks for
+the label.  The loader does not fit on a floppy disk.
 
 Devices
 =======
@@ -52,14 +66,31 @@ MB8795 Ethernet        mb8795                          ``eth0``
 Sound                  snd-next                        ALSA
 Clock, NVRAM, power    rtc-next                        ``rtc0``, nvmem
 82077 floppy           floppy                          ``fd0``
-Optical disk           next_mo                         ``mo0``
+Optical disks          next_mo                         ``mo0``, ``mo1``
 DSP56001               dsp56k                          ``dsp56k``
 Laser printer          nextlp                          ``nextlp``
 Status LED             leds-next                       LED class
+NeXTdimension          nextdimfb                       ``fb1`` and up
 =====================  ==============================  ======================
 
-Not supported: the NeXTdimension board, the serial port DMA channels, and the
-sound input of the DSP serial port.
+SCSI CD-ROM drives work as ``sr0`` with the usual SCSI and ISO 9660 drivers.
+
+The NeXTdimension driver treats the board as a 32 bpp display in the slots of
+the NeXTcube.  The i860 keeps running its ROM, its own memory, the video input
+and the JPEG hardware are not used.  It relies on the ROM of the board to set
+up the Bt463 RAMDAC.  ``FBIOPUT_CON2FBMAP`` moves a console to the board.
+
+Some parts of the hardware are not used, the devices work without them:
+
+- Synchronous SCSI: the bus runs asynchronously.  NetBSD does the same, and
+  Previous cannot run the negotiation as it stops on the select with ATN and
+  stop command, so this could not be tested.
+- The DMA channels of the serial ports and the DSP host port, and the memory
+  to register channels: the drivers use programmed I/O.
+- The DSP serial port: it is set up by the program running on the DSP, which
+  is loaded through ``dsp56k``, so it needs no kernel driver.
+- Removable media: optical disks and floppies are expected in the drive when
+  the driver starts, ejecting a mounted disk is not handled.
 
 Notes on the hardware
 =====================
@@ -75,8 +106,9 @@ memory, or later packets overwrite it.
 
 Most of this was developed on the Previous emulator, which also documents
 much of the hardware.  To print on the emulator, set the file output directory
-of the printer.  The optical disk and printer engine sequences are based only
-on the emulator and are unverified on real hardware.
+of the printer.  The optical disk and printer engine sequences and the
+NeXTdimension driver are based only on the emulator and are unverified on real
+hardware.
 
 Testing
 =======
diff --git a/arch/m68k/configs/next_defconfig b/arch/m68k/configs/next_defconfig
index a6d2b5a5840b..15874f9ecda0 100644
--- a/arch/m68k/configs/next_defconfig
+++ b/arch/m68k/configs/next_defconfig
@@ -50,6 +50,7 @@ CONFIG_INPUT_ADBHID=y
 CONFIG_INPUT_MOUSEDEV=y
 CONFIG_FB=y
 CONFIG_FB_NEXT=y
+CONFIG_FB_NEXTDIMENSION=y
 CONFIG_FRAMEBUFFER_CONSOLE=y
 CONFIG_FONT_SUPPORT=y
 CONFIG_FONTS=y
@@ -80,3 +81,6 @@ CONFIG_PRINTK_TIME=y
 CONFIG_MAGIC_SYSRQ=y
 CONFIG_DEBUG_KERNEL=y
 CONFIG_PANIC_TIMEOUT=0
+CONFIG_BLK_DEV_SR=y
+CONFIG_ISO9660_FS=y
+CONFIG_JOLIET=y
-- 
2.54.0


From f4b154c240a754594b92acac93a1dfb6acb0811a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 06:52:25 +0100
Subject: [PATCH 27/35] dmaengine: Add NeXT memory to memory DMA driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The memory to register channel feeds the register to memory channel, which
copies aligned 16 byte bursts.  Turbo models do not have these channels.  A
finished channel only drops its interrupt on reset, clearing the complete bit
leaves it asserted.

Tested with dmatest on the Previous emulator only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/include/asm/next.h    |   4 +
 arch/m68k/include/asm/nextdma.h |   4 +
 arch/m68k/next/config.c         |   8 +-
 drivers/dma/Kconfig             |   8 +
 drivers/dma/Makefile            |   1 +
 drivers/dma/next-m2m.c          | 259 ++++++++++++++++++++++++++++++++
 6 files changed, 283 insertions(+), 1 deletion(-)
 create mode 100644 drivers/dma/next-m2m.c

diff --git a/arch/m68k/include/asm/next.h b/arch/m68k/include/asm/next.h
index 0d3ca6cbd57f..9f945f1c1184 100644
--- a/arch/m68k/include/asm/next.h
+++ b/arch/m68k/include/asm/next.h
@@ -90,6 +90,10 @@ static inline bool next_is_turbo(void)
 #define IRQ_NEXT_ENET_RX_DMA	NEXT_IRQ(27)
 #define IRQ_NEXT_ENET_TX_DMA	NEXT_IRQ(28)
 #define IRQ_NEXT_SCSI_DMA	NEXT_IRQ(26)
+#define IRQ_NEXT_R2M_DMA	NEXT_IRQ(18)
+#define IRQ_NEXT_M2R_DMA	NEXT_IRQ(19)
+#define IRQ_NEXT_DSP_DMA	NEXT_IRQ(20)
+#define IRQ_NEXT_SCC_DMA	NEXT_IRQ(21)
 #define IRQ_NEXT_TIMER		NEXT_IRQ(29)
 
 #endif /* !__ASSEMBLER__ */
diff --git a/arch/m68k/include/asm/nextdma.h b/arch/m68k/include/asm/nextdma.h
index 784eaf96ce65..ecb711f946ca 100644
--- a/arch/m68k/include/asm/nextdma.h
+++ b/arch/m68k/include/asm/nextdma.h
@@ -19,8 +19,12 @@
 #define NEXTDMA_DISK		0x050
 #define NEXTDMA_SOUND_IN	0x080
 #define NEXTDMA_PRINTER		0x090
+#define NEXTDMA_SCC		0x0c0
+#define NEXTDMA_DSP		0x0d0
 #define NEXTDMA_ENET_TX		0x110
 #define NEXTDMA_ENET_RX		0x150
+#define NEXTDMA_R2M		0x1c0
+#define NEXTDMA_M2R		0x1d0
 
 /* Status */
 #define NEXTDMA_ENABLE		0x01000000
diff --git a/arch/m68k/next/config.c b/arch/m68k/next/config.c
index f3dc22d10c1c..41bbf7e096a6 100644
--- a/arch/m68k/next/config.c
+++ b/arch/m68k/next/config.c
@@ -100,7 +100,7 @@ static void next_quiesce(void)
 {
 	static const unsigned int chans[] = {
 		NEXTDMA_SCSI, NEXTDMA_SOUND_OUT, NEXTDMA_DISK, NEXTDMA_SOUND_IN,
-		NEXTDMA_PRINTER, NEXTDMA_ENET_TX, NEXTDMA_ENET_RX,
+		NEXTDMA_PRINTER, NEXTDMA_ENET_TX, NEXTDMA_ENET_RX, NEXTDMA_DSP,
 	};
 	int i;
 
@@ -110,6 +110,11 @@ static void next_quiesce(void)
 		if (chans[i] != NEXTDMA_DISK || !next_is_turbo())
 			nextdma_reset(chans[i]);
 	}
+	/* Nor memory to memory channels */
+	if (!next_is_turbo()) {
+		nextdma_reset(NEXTDMA_R2M);
+		nextdma_reset(NEXTDMA_M2R);
+	}
 
 	out_8(next_dev(NEXT_ESP) + ESP_DMA_CTRL, ESP_CTRL_CLK20);
 	out_8(next_dev(NEXT_ESP) + ESP_CMD, ESP_CMD_RESET);
@@ -218,6 +223,7 @@ static int __init next_platform_init(void)
 	platform_device_register_simple("leds-next", -1, NULL, 0);
 	platform_device_register_simple("next_mo", -1, NULL, 0);
 	platform_device_register_simple("nextlp", -1, NULL, 0);
+	platform_device_register_simple("next-m2m", -1, NULL, 0);
 	/* Only the cubes have NeXTbus slots */
 	if (next_machine == NEXT_MACH_CUBE030 || next_machine == NEXT_MACH_CUBE ||
 	    next_machine == NEXT_MACH_CUBE_TURBO)
diff --git a/drivers/dma/Kconfig b/drivers/dma/Kconfig
index 01f96a8257e5..47cc23d9ab8c 100644
--- a/drivers/dma/Kconfig
+++ b/drivers/dma/Kconfig
@@ -500,6 +500,14 @@ config MXS_DMA
 	  Support the MXS DMA engine. This engine including APBH-DMA
 	  and APBX-DMA is integrated into some Freescale chips.
 
+config NEXT_M2M_DMA
+	bool "NeXT memory to memory DMA support"
+	depends on NEXT
+	select DMA_ENGINE
+	help
+	  Support for copying memory with the memory to register and register
+	  to memory DMA channels of NeXT computers.
+
 config NBPFAXI_DMA
 	tristate "Renesas Type-AXI NBPF DMA support"
 	select DMA_ENGINE
diff --git a/drivers/dma/Makefile b/drivers/dma/Makefile
index f62d12b08e15..28aede88a0b7 100644
--- a/drivers/dma/Makefile
+++ b/drivers/dma/Makefile
@@ -61,6 +61,7 @@ obj-$(CONFIG_MPC512X_DMA) += mpc512x_dma.o
 obj-$(CONFIG_MV_XOR) += mv_xor.o
 obj-$(CONFIG_MV_XOR_V2) += mv_xor_v2.o
 obj-$(CONFIG_MXS_DMA) += mxs-dma.o
+obj-$(CONFIG_NEXT_M2M_DMA) += next-m2m.o
 obj-$(CONFIG_NBPFAXI_DMA) += nbpfaxi.o
 obj-$(CONFIG_OWL_DMA) += owl-dma.o
 obj-$(CONFIG_PCH_DMA) += pch_dma.o
diff --git a/drivers/dma/next-m2m.c b/drivers/dma/next-m2m.c
new file mode 100644
index 000000000000..d6d93a56e1a0
--- /dev/null
+++ b/drivers/dma/next-m2m.c
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NeXT memory to memory DMA: the memory to register channel feeds the register
+ * to memory channel, which together copy aligned 16 byte bursts.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/dmaengine.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/list.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+
+#include <asm/nextdma.h>
+
+#include "dmaengine.h"
+
+struct next_m2m_desc {
+	struct dma_async_tx_descriptor txd;
+	struct list_head node;
+	dma_addr_t src, dst;
+	size_t len;
+	enum dmaengine_tx_result result;
+};
+
+struct next_m2m {
+	struct dma_device dma;
+	struct dma_chan chan;
+	spinlock_t lock;
+	struct list_head pending, done;
+	struct next_m2m_desc *active;
+	struct tasklet_struct tasklet;
+};
+
+static void next_m2m_stop(void)
+{
+	nextdma_reset(NEXTDMA_M2R);
+	nextdma_reset(NEXTDMA_R2M);
+}
+
+/* Called with the lock held */
+static void next_m2m_start(struct next_m2m *m2m)
+{
+	struct next_m2m_desc *desc;
+
+	if (m2m->active || list_empty(&m2m->pending))
+		return;
+
+	desc = list_first_entry(&m2m->pending, struct next_m2m_desc, node);
+	list_del(&desc->node);
+	m2m->active = desc;
+
+	next_m2m_stop();
+	nextdma_reg_write(NEXTDMA_M2R, NEXTDMA_REG_NEXT, desc->src);
+	nextdma_reg_write(NEXTDMA_M2R, NEXTDMA_REG_LIMIT, desc->src + desc->len);
+	nextdma_reg_write(NEXTDMA_R2M, NEXTDMA_REG_NEXT, desc->dst);
+	nextdma_reg_write(NEXTDMA_R2M, NEXTDMA_REG_LIMIT, desc->dst + desc->len);
+	nextdma_csr_write(NEXTDMA_R2M, NEXTDMA_SETENABLE | NEXTDMA_DEV2M);
+	nextdma_csr_write(NEXTDMA_M2R, NEXTDMA_SETENABLE | NEXTDMA_M2DEV);
+}
+
+static irqreturn_t next_m2r_interrupt(int irq, void *dev_id)
+{
+	if (!(nextdma_csr_read(NEXTDMA_M2R) & NEXTDMA_COMPLETE))
+		return IRQ_NONE;
+	/* A finished channel only drops its interrupt on reset */
+	nextdma_csr_write(NEXTDMA_M2R, NEXTDMA_RESET | NEXTDMA_CLRCOMPLETE);
+	return IRQ_HANDLED;
+}
+
+/* The copy is finished when the writing channel has reached its limit */
+static irqreturn_t next_r2m_interrupt(int irq, void *dev_id)
+{
+	struct next_m2m *m2m = dev_id;
+	struct next_m2m_desc *desc;
+	u32 csr = nextdma_csr_read(NEXTDMA_R2M) | nextdma_csr_read(NEXTDMA_M2R);
+
+	if (!(csr & NEXTDMA_COMPLETE))
+		return IRQ_NONE;
+
+	spin_lock(&m2m->lock);
+	next_m2m_stop();
+	desc = m2m->active;
+	m2m->active = NULL;
+	if (desc) {
+		desc->result = csr & NEXTDMA_BUSEXC ? DMA_TRANS_WRITE_FAILED : DMA_TRANS_NOERROR;
+		dma_cookie_complete(&desc->txd);
+		list_add_tail(&desc->node, &m2m->done);
+		tasklet_schedule(&m2m->tasklet);
+	}
+	next_m2m_start(m2m);
+	spin_unlock(&m2m->lock);
+	return IRQ_HANDLED;
+}
+
+static void next_m2m_tasklet(struct tasklet_struct *t)
+{
+	struct next_m2m *m2m = from_tasklet(m2m, t, tasklet);
+	struct next_m2m_desc *desc, *tmp;
+	unsigned long flags;
+	LIST_HEAD(done);
+
+	spin_lock_irqsave(&m2m->lock, flags);
+	list_splice_init(&m2m->done, &done);
+	spin_unlock_irqrestore(&m2m->lock, flags);
+
+	list_for_each_entry_safe(desc, tmp, &done, node) {
+		struct dmaengine_result res = { .result = desc->result };
+
+		list_del(&desc->node);
+		dmaengine_desc_get_callback_invoke(&desc->txd, &res);
+		dma_descriptor_unmap(&desc->txd);
+		dma_run_dependencies(&desc->txd);
+		kfree(desc);
+	}
+}
+
+static dma_cookie_t next_m2m_submit(struct dma_async_tx_descriptor *txd)
+{
+	struct next_m2m *m2m = container_of(txd->chan, struct next_m2m, chan);
+	struct next_m2m_desc *desc = container_of(txd, struct next_m2m_desc, txd);
+	unsigned long flags;
+	dma_cookie_t cookie;
+
+	spin_lock_irqsave(&m2m->lock, flags);
+	cookie = dma_cookie_assign(txd);
+	list_add_tail(&desc->node, &m2m->pending);
+	spin_unlock_irqrestore(&m2m->lock, flags);
+	return cookie;
+}
+
+static struct dma_async_tx_descriptor *
+next_m2m_prep_memcpy(struct dma_chan *chan, dma_addr_t dst, dma_addr_t src, size_t len,
+		     unsigned long flags)
+{
+	struct next_m2m_desc *desc;
+
+	if (!len || ((dst | src | len) & (NEXTDMA_ALIGN - 1)))
+		return NULL;
+
+	desc = kzalloc_obj(*desc, GFP_NOWAIT);
+	if (!desc)
+		return NULL;
+	dma_async_tx_descriptor_init(&desc->txd, chan);
+	desc->txd.tx_submit = next_m2m_submit;
+	desc->txd.flags = flags;
+	desc->src = src;
+	desc->dst = dst;
+	desc->len = len;
+	return &desc->txd;
+}
+
+static void next_m2m_issue_pending(struct dma_chan *chan)
+{
+	struct next_m2m *m2m = container_of(chan, struct next_m2m, chan);
+	unsigned long flags;
+
+	spin_lock_irqsave(&m2m->lock, flags);
+	next_m2m_start(m2m);
+	spin_unlock_irqrestore(&m2m->lock, flags);
+}
+
+static int next_m2m_terminate_all(struct dma_chan *chan)
+{
+	struct next_m2m *m2m = container_of(chan, struct next_m2m, chan);
+	struct next_m2m_desc *desc, *tmp;
+	unsigned long flags;
+	LIST_HEAD(drop);
+
+	spin_lock_irqsave(&m2m->lock, flags);
+	next_m2m_stop();
+	list_splice_init(&m2m->pending, &drop);
+	if (m2m->active) {
+		list_add_tail(&m2m->active->node, &drop);
+		m2m->active = NULL;
+	}
+	spin_unlock_irqrestore(&m2m->lock, flags);
+
+	list_for_each_entry_safe(desc, tmp, &drop, node) {
+		list_del(&desc->node);
+		kfree(desc);
+	}
+	return 0;
+}
+
+static int next_m2m_alloc_chan_resources(struct dma_chan *chan)
+{
+	dma_cookie_init(chan);
+	return 1;
+}
+
+static void next_m2m_free_chan_resources(struct dma_chan *chan)
+{
+	next_m2m_terminate_all(chan);
+}
+
+static int next_m2m_probe(struct platform_device *pdev)
+{
+	struct next_m2m *m2m;
+	struct dma_device *dma;
+	int err;
+
+	/* The Turbo DMA controller has no memory to memory channels */
+	if (next_is_turbo())
+		return -ENODEV;
+
+	err = dma_coerce_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (err)
+		return err;
+
+	m2m = devm_kzalloc(&pdev->dev, sizeof(*m2m), GFP_KERNEL);
+	if (!m2m)
+		return -ENOMEM;
+	spin_lock_init(&m2m->lock);
+	INIT_LIST_HEAD(&m2m->pending);
+	INIT_LIST_HEAD(&m2m->done);
+	tasklet_setup(&m2m->tasklet, next_m2m_tasklet);
+	next_m2m_stop();
+
+	err = devm_request_irq(&pdev->dev, IRQ_NEXT_M2R_DMA, next_m2r_interrupt, 0, "next-m2r", m2m);
+	if (err)
+		return err;
+	err = devm_request_irq(&pdev->dev, IRQ_NEXT_R2M_DMA, next_r2m_interrupt, 0, "next-r2m", m2m);
+	if (err)
+		return err;
+
+	dma = &m2m->dma;
+	dma->dev = &pdev->dev;
+	INIT_LIST_HEAD(&dma->channels);
+	dma_cap_set(DMA_MEMCPY, dma->cap_mask);
+	dma->copy_align = DMAENGINE_ALIGN_16_BYTES;
+	dma->device_alloc_chan_resources = next_m2m_alloc_chan_resources;
+	dma->device_free_chan_resources = next_m2m_free_chan_resources;
+	dma->device_prep_dma_memcpy = next_m2m_prep_memcpy;
+	dma->device_issue_pending = next_m2m_issue_pending;
+	dma->device_tx_status = dma_cookie_status;
+	dma->device_terminate_all = next_m2m_terminate_all;
+
+	m2m->chan.device = dma;
+	dma_cookie_init(&m2m->chan);
+	list_add_tail(&m2m->chan.device_node, &dma->channels);
+
+	return dmaenginem_async_device_register(dma);
+}
+
+static struct platform_driver next_m2m_driver = {
+	.probe	= next_m2m_probe,
+	.driver	= {
+		.name = "next-m2m",
+	},
+};
+module_platform_driver(next_m2m_driver);
+
+MODULE_DESCRIPTION("NeXT memory to memory DMA driver");
+MODULE_LICENSE("GPL");
-- 
2.54.0


From 21c7cb25a222155daff14420541099761f8ec661 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 06:52:25 +0100
Subject: [PATCH 28/35] m68k: dsp56k: Add DMA on NeXT, make the transmit word
 size settable
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Transfer multiples of the 16 byte burst of packed 24 bit words through the DMA
channel of the host port, the rest of a transfer through programmed I/O.

DSP56K_SET_TX_WSIZE is ioctl number 2, which is FIGETBSZ.  The VFS answers that
before the driver sees it, with a bad address error as the word size is not a
pointer, so the transmit word size could never be set.  Add a number which
reaches the driver and keep the old one in the driver.

Tested on the Previous emulator only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/include/asm/dsp56k.h |   2 +
 drivers/char/dsp56k.c          | 106 ++++++++++++++++++++++++++++++++-
 2 files changed, 106 insertions(+), 2 deletions(-)

diff --git a/arch/m68k/include/asm/dsp56k.h b/arch/m68k/include/asm/dsp56k.h
index 2d8c0c9f794b..0594c483d680 100644
--- a/arch/m68k/include/asm/dsp56k.h
+++ b/arch/m68k/include/asm/dsp56k.h
@@ -30,6 +30,8 @@ struct dsp56k_host_flags {
 /* ioctl command codes */
 #define DSP56K_UPLOAD	        1    /* Upload DSP binary program       */
 #define DSP56K_SET_TX_WSIZE	2    /* Host transmit word size (1-4)   */
+/* Number 2 is FIGETBSZ, which the VFS answers before it reaches the driver */
+#define DSP56K_SET_TX_WSIZE_NEW	_IO('8', 2)
 #define DSP56K_SET_RX_WSIZE	3    /* Host receive word size (1-4)    */
 #define DSP56K_HOST_FLAGS	4    /* Host flag registers             */
 #define DSP56K_HOST_CMD         5    /* Trig Host Command (0-31)        */
diff --git a/drivers/char/dsp56k.c b/drivers/char/dsp56k.c
index 1b0169cb352a..dead5c7c0af6 100644
--- a/drivers/char/dsp56k.c
+++ b/drivers/char/dsp56k.c
@@ -40,8 +40,12 @@
 #include <asm/atarihw.h>
 #include <asm/traps.h>
 #ifdef CONFIG_NEXT
+#include <linux/completion.h>
+#include <linux/interrupt.h>
+#include <asm/cacheflush.h>
 #include <asm/io.h>
 #include <asm/next.h>
+#include <asm/nextdma.h>
 #endif
 
 #include <asm/dsp56k.h>
@@ -259,6 +263,93 @@ static int dsp56k_upload(u_char __user *bin, int len)
 	return 0;
 }
 
+#ifdef CONFIG_NEXT
+#define DSP56K_ICR_HM0		0x20	/* DMA of 24 bit words */
+#define DSP56K_ICR_DMA		(DSP56K_ICR_HM0 | DSP56K_ICR_TREQ | DSP56K_ICR_RREQ)
+
+static DECLARE_COMPLETION(dsp56k_dma_done);
+static bool dsp56k_dma_ready;
+
+static irqreturn_t dsp56k_dma_interrupt(int irq, void *dev_id)
+{
+	if (!(nextdma_csr_read(NEXTDMA_DSP) & NEXTDMA_COMPLETE))
+		return IRQ_NONE;
+	/* A finished channel only drops its interrupt on reset */
+	nextdma_csr_write(NEXTDMA_DSP, NEXTDMA_RESET | NEXTDMA_CLRCOMPLETE);
+	complete(&dsp56k_dma_done);
+	return IRQ_HANDLED;
+}
+
+/* Returns the bytes moved, the channel transfers whole 16 byte bursts */
+static unsigned int dsp56k_dma(void *buf, unsigned int len, bool write)
+{
+	unsigned long phys = virt_to_phys(buf);
+	unsigned int done;
+
+	if (write)
+		cache_push(phys, len);
+	else
+		cache_clear(phys, len);
+
+	reinit_completion(&dsp56k_dma_done);
+	nextdma_reset(NEXTDMA_DSP);
+	nextdma_reg_write(NEXTDMA_DSP, NEXTDMA_REG_NEXT, phys);
+	nextdma_reg_write(NEXTDMA_DSP, NEXTDMA_REG_LIMIT, phys + len);
+	nextdma_csr_write(NEXTDMA_DSP, NEXTDMA_SETENABLE |
+			  (write ? NEXTDMA_M2DEV : NEXTDMA_DEV2M));
+	dsp56k_host_interface.icr = (dsp56k_host_interface.icr & ~DSP56K_ICR_DMA) |
+		DSP56K_ICR_HM0 | (write ? DSP56K_ICR_TREQ : DSP56K_ICR_RREQ);
+
+	if (wait_for_completion_timeout(&dsp56k_dma_done, dsp56k.timeout * HZ / 10 + HZ))
+		done = len;
+	else
+		done = nextdma_reg_read(NEXTDMA_DSP, NEXTDMA_REG_NEXT) - phys;
+
+	dsp56k_host_interface.icr &= ~DSP56K_ICR_DMA;
+	nextdma_reset(NEXTDMA_DSP);
+	if (!write)
+		cache_clear(phys, len);
+	return done;
+}
+
+static ssize_t dsp56k_dma_user(void __user *ubuf, size_t count, bool write)
+{
+	char *buf = (char *)__get_free_page(GFP_KERNEL);
+	size_t total = 0;
+	ssize_t ret = 0;
+
+	if (!buf)
+		return -ENOMEM;
+
+	while (count >= NEXTDMA_ALIGN) {
+		unsigned int n = min_t(size_t, count, PAGE_SIZE) & ~(NEXTDMA_ALIGN - 1);
+		unsigned int done;
+
+		if (write && copy_from_user(buf, ubuf + total, n)) {
+			ret = -EFAULT;
+			break;
+		}
+		done = dsp56k_dma(buf, n, write);
+		if (!write && copy_to_user(ubuf + total, buf, done)) {
+			ret = -EFAULT;
+			break;
+		}
+		total += done;
+		count -= done;
+		if (done < n)
+			break;
+	}
+	free_page((unsigned long)buf);
+	if (total)
+		return total;
+	return ret ?: -EIO;
+}
+
+/* Packed 24 bit words go through the DMA channel, the rest of a transfer through PIO */
+#define dsp56k_use_dma(wsize, count) \
+	(MACH_IS_NEXT && dsp56k_dma_ready && (wsize) == 3 && (count) >= NEXTDMA_ALIGN)
+#endif
+
 static ssize_t dsp56k_read(struct file *file, char __user *buf, size_t count,
 			   loff_t *ppos)
 {
@@ -275,6 +366,10 @@ static ssize_t dsp56k_read(struct file *file, char __user *buf, size_t count,
 		/* Don't do anything if nothing is to be done */
 		if (!count) return 0;
 
+#ifdef CONFIG_NEXT
+		if (dsp56k_use_dma(dsp56k.rx_wsize, count))
+			return dsp56k_dma_user(buf, count, false);
+#endif
 		n = 0;
 		switch (dsp56k.rx_wsize) {
 		case 1:  /* 8 bit */
@@ -337,6 +432,10 @@ static ssize_t dsp56k_write(struct file *file, const char __user *buf, size_t co
 		/* Don't do anything if nothing is to be done */
 		if (!count) return 0;
 
+#ifdef CONFIG_NEXT
+		if (dsp56k_use_dma(dsp56k.tx_wsize, count))
+			return dsp56k_dma_user((void __user *)buf, count, true);
+#endif
 		n = 0;
 		switch (dsp56k.tx_wsize) {
 		case 1:  /* 8 bit */
@@ -422,6 +521,7 @@ static long dsp56k_ioctl(struct file *file, unsigned int cmd,
 			break;
 		}
 		case DSP56K_SET_TX_WSIZE:
+		case DSP56K_SET_TX_WSIZE_NEW:
 			if (arg > 4 || arg < 1)
 				return -EINVAL;
 			mutex_lock(&dsp56k_mutex);
@@ -577,9 +677,11 @@ static int __init dsp56k_init_driver(void)
 	int err;
 
 #ifdef CONFIG_NEXT
-	if (MACH_IS_NEXT)
+	if (MACH_IS_NEXT) {
 		dsp56k_hi = (volatile struct DSP56K_HOST_INTERFACE *)next_dev(NEXT_DSP);
-	else
+		dsp56k_dma_ready = !request_irq(IRQ_NEXT_DSP_DMA, dsp56k_dma_interrupt, 0,
+						"dsp56k-dma", NULL);
+	} else
 #endif
 	if(!MACH_IS_ATARI || !ATARIHW_PRESENT(DSP56K)) {
 		printk("DSP56k driver: Hardware not present\n");
-- 
2.54.0


From dac7e801028a7de6f8ba297a5731c163e35668de Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 06:52:25 +0100
Subject: [PATCH 29/35] scsi: next_esp: Add a parameter for synchronous
 transfers
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

next_esp.sync=1 lets esp_scsi negotiate them.  This is off by default, as NetBSD
also leaves it off on this chip and it was only tested on the Previous emulator,
with an addition for the select with ATN and stop command.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/scsi/next_esp.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/scsi/next_esp.c b/drivers/scsi/next_esp.c
index cceebbcc7b93..10ea47c87bd6 100644
--- a/drivers/scsi/next_esp.c
+++ b/drivers/scsi/next_esp.c
@@ -220,6 +220,10 @@ static const struct esp_driver_ops next_esp_ops = {
 	.dma_error		= next_esp_dma_error,
 };
 
+static bool next_esp_sync;
+module_param_named(sync, next_esp_sync, bool, 0444);
+MODULE_PARM_DESC(sync, "Negotiate synchronous transfers, only tested on an emulator");
+
 static int next_esp_probe(struct platform_device *pdev)
 {
 	struct next_esp_priv *priv;
@@ -256,7 +260,9 @@ static int next_esp_probe(struct platform_device *pdev)
 	esp->ops = &next_esp_ops;
 	esp->regs = next_dev(NEXT_ESP);
 	esp->cfreq = 20000000;
-	esp->flags = ESP_FLAG_USE_FIFO | ESP_FLAG_NO_DMA_MAP | ESP_FLAG_DISABLE_SYNC;
+	esp->flags = ESP_FLAG_USE_FIFO | ESP_FLAG_NO_DMA_MAP;
+	if (!next_esp_sync)
+		esp->flags |= ESP_FLAG_DISABLE_SYNC;
 	esp->scsi_id = 7;
 	host->this_id = esp->scsi_id;
 	esp->scsi_id_mask = 1 << esp->scsi_id;
-- 
2.54.0


From 8650ccbfa1b51da2f7e1b144e1380f4c97ec866d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 06:52:25 +0100
Subject: [PATCH 30/35] serial: pmac_zilog: Add loopback and NeXT transmit DMA
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Honour TIOCM_LOOP.  With pmac_zilog.next_dma=1 one port at a time transmits
through the SCC DMA channel of NeXT computers.  The console stays on programmed
I/O as its writes poll the transmitter, and Turbo models have no such channel.

Only tested in loopback on the Previous emulator, which discards other DMA data.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/tty/serial/pmac_zilog.c | 114 ++++++++++++++++++++++++++++++++
 1 file changed, 114 insertions(+)

diff --git a/drivers/tty/serial/pmac_zilog.c b/drivers/tty/serial/pmac_zilog.c
index 27b05c275851..3a58fac973bc 100644
--- a/drivers/tty/serial/pmac_zilog.c
+++ b/drivers/tty/serial/pmac_zilog.c
@@ -63,6 +63,23 @@
 
 #include "pmac_zilog.h"
 
+#ifdef CONFIG_NEXT
+#include <linux/moduleparam.h>
+#include <asm/cacheflush.h>
+#include <asm/next.h>
+#include <asm/nextdma.h>
+#include <asm/setup.h>
+
+/* Transmit through the DMA channel the ports share, only tested on an emulator */
+static bool pmz_next_dma_on;
+module_param_named(next_dma, pmz_next_dma_on, bool, 0444);
+MODULE_PARM_DESC(next_dma, "Transmit through DMA on NeXT computers with an SCC channel");
+
+static struct uart_pmac_port *pmz_next_dma_owner;
+static char *pmz_next_dma_buf;
+static unsigned int pmz_next_dma_len;
+#endif
+
 MODULE_AUTHOR("Benjamin Herrenschmidt <benh@kernel.crashing.org>");
 MODULE_DESCRIPTION("Driver for the Mac and PowerMac serial ports.");
 MODULE_LICENSE("GPL");
@@ -332,11 +349,92 @@ static void pmz_status_handle(struct uart_pmac_port *uap)
 	uap->prev_status = status;
 }
 
+#ifdef CONFIG_NEXT
+/* Called with the port lock held */
+static bool pmz_next_dma_start(struct uart_pmac_port *uap)
+{
+	unsigned long phys;
+
+	/* Console writes poll the transmitter and stay on PIO */
+	if (!pmz_next_dma_buf || ZS_IS_CONS(uap))
+		return false;
+	if (pmz_next_dma_owner)
+		return pmz_next_dma_owner == uap;
+
+	pmz_next_dma_len = kfifo_out_peek(&uap->port.state->port.xmit_fifo, pmz_next_dma_buf,
+					  PAGE_SIZE);
+	if (!pmz_next_dma_len)
+		return false;
+
+	pmz_next_dma_owner = uap;
+	phys = virt_to_phys(pmz_next_dma_buf);
+	cache_push(phys, pmz_next_dma_len);
+	nextdma_reset(NEXTDMA_SCC);
+	nextdma_reg_write(NEXTDMA_SCC, NEXTDMA_REG_NEXT, phys);
+	nextdma_reg_write(NEXTDMA_SCC, NEXTDMA_REG_LIMIT, phys + pmz_next_dma_len);
+	nextdma_csr_write(NEXTDMA_SCC, NEXTDMA_SETENABLE | NEXTDMA_M2DEV);
+	uap->curregs[R1] |= WT_RDY_ENAB | WT_FN_RDYFN;
+	write_zsreg(uap, R1, uap->curregs[R1]);
+	return true;
+}
+
+/* Called with the port lock held */
+static void pmz_next_dma_stop(struct uart_pmac_port *uap)
+{
+	nextdma_reset(NEXTDMA_SCC);
+	uap->curregs[R1] &= ~(WT_RDY_ENAB | WT_FN_RDYFN);
+	write_zsreg(uap, R1, uap->curregs[R1]);
+	pmz_next_dma_owner = NULL;
+}
+
+static irqreturn_t pmz_next_dma_interrupt(int irq, void *dev_id)
+{
+	struct uart_pmac_port *uap = pmz_next_dma_owner;
+	unsigned long flags;
+
+	if (!(nextdma_csr_read(NEXTDMA_SCC) & NEXTDMA_COMPLETE))
+		return IRQ_NONE;
+
+	/* A finished channel only drops its interrupt on reset */
+	nextdma_csr_write(NEXTDMA_SCC, NEXTDMA_RESET | NEXTDMA_CLRCOMPLETE);
+	if (!uap)
+		return IRQ_HANDLED;
+
+	uart_port_lock_irqsave(&uap->port, &flags);
+	pmz_next_dma_stop(uap);
+	uart_xmit_advance(&uap->port, pmz_next_dma_len);
+	if (kfifo_len(&uap->port.state->port.xmit_fifo) < WAKEUP_CHARS)
+		uart_write_wakeup(&uap->port);
+	pmz_next_dma_start(uap);
+	uart_port_unlock_irqrestore(&uap->port, flags);
+	return IRQ_HANDLED;
+}
+
+static void pmz_next_dma_init(void)
+{
+	if (!pmz_next_dma_on || !MACH_IS_NEXT || next_is_turbo())
+		return;
+	pmz_next_dma_buf = (char *)__get_free_page(GFP_KERNEL);
+	if (pmz_next_dma_buf && request_irq(IRQ_NEXT_SCC_DMA, pmz_next_dma_interrupt, 0,
+					    "scc-dma", NULL)) {
+		free_page((unsigned long)pmz_next_dma_buf);
+		pmz_next_dma_buf = NULL;
+	}
+}
+#else
+static inline bool pmz_next_dma_start(struct uart_pmac_port *uap) { return false; }
+static inline void pmz_next_dma_init(void) { }
+#endif
+
 static void pmz_transmit_chars(struct uart_pmac_port *uap)
 {
 	struct tty_port *tport;
 	unsigned char ch;
 
+#ifdef CONFIG_NEXT
+	if (pmz_next_dma_owner == uap)
+		return;
+#endif
 	if (ZS_IS_CONS(uap)) {
 		unsigned char status = read_zsreg(uap, R0);
 
@@ -541,6 +639,13 @@ static void pmz_set_mctrl(struct uart_port *port, unsigned int mctrl)
 	uap->curregs[R5] &= ~clear_bits;
 
 	write_zsreg(uap, R5, uap->curregs[R5]);
+
+	if (mctrl & TIOCM_LOOP)
+		uap->curregs[R14] |= LOOPBAK;
+	else
+		uap->curregs[R14] &= ~LOOPBAK;
+	write_zsreg(uap, R14, uap->curregs[R14]);
+
 	pmz_debug("pmz_set_mctrl: set bits: %x, clear bits: %x -> %x\n",
 		  set_bits, clear_bits, uap->curregs[R5]);
 	zssync(uap);
@@ -598,6 +703,9 @@ static void pmz_start_tx(struct uart_port *port)
 	if (!(status & Tx_BUF_EMP))
 		return;
 
+	if (!port->x_char && pmz_next_dma_start(uap))
+		return;
+
 	/* Send the first character to jump-start the TX done
 	 * IRQ sending engine.
 	 */
@@ -922,6 +1030,10 @@ static void pmz_shutdown(struct uart_port *port)
 
 	uart_port_lock_irqsave(port, &flags);
 
+#ifdef CONFIG_NEXT
+	if (pmz_next_dma_owner == uap)
+		pmz_next_dma_stop(uap);
+#endif
 	/* Disable interrupt requests for the channel */
 	pmz_interrupt_control(uap, 0);
 
@@ -1791,6 +1903,8 @@ static int __init init_pmz(void)
 {
 	int rc, i;
 
+	pmz_next_dma_init();
+
 	/* 
 	 * First, we need to do a direct OF-based probe pass. We
 	 * do that because we want serial console up before the
-- 
2.54.0


From d50deec37ac8e20d7e0c4ff491fb42ea770d02b0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 06:52:25 +0100
Subject: [PATCH 31/35] block: next_mo: Support changing the disk
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Register a disk for connected drives without media, check the drive on open and
eject with CDROMEJECT.  A mutex now covers the controller, as status checks can
run next to the requests.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 drivers/block/next_mo.c | 125 +++++++++++++++++++++++++++++++++-------
 1 file changed, 103 insertions(+), 22 deletions(-)

diff --git a/drivers/block/next_mo.c b/drivers/block/next_mo.c
index 17882c055aac..adc1a01f07a0 100644
--- a/drivers/block/next_mo.c
+++ b/drivers/block/next_mo.c
@@ -10,6 +10,7 @@
  */
 
 #include <linux/blk-mq.h>
+#include <linux/cdrom.h>
 #include <linux/blkdev.h>
 #include <linux/completion.h>
 #include <linux/delay.h>
@@ -73,6 +74,7 @@
 #define DRV_ERASE_HEAD		0x4400
 #define DRV_RESET_ATTN		0x5000
 #define DRV_START_MOTOR		0x5300
+#define DRV_EJECT		0x5600
 #define DRV_SPIRAL_ON		0x5900
 #define DRV_SPIRAL_OFF		0x5a00
 
@@ -101,6 +103,8 @@ struct next_mo_drive {
 	struct next_mo *mo;
 	struct gendisk *disk;
 	unsigned int unit;
+	bool present;
+	bool changed;
 };
 
 /* The drives share the controller: their queues share one tag, so one runs at a time */
@@ -109,6 +113,7 @@ struct next_mo {
 	void __iomem *regs;
 	struct next_mo_drive drive[MO_MAX_DRIVES];
 	struct blk_mq_tag_set tag_set;
+	struct mutex lock;	/* the controller, its buffer and the media state */
 	struct completion done;
 	void *buf;
 	dma_addr_t buf_dma;
@@ -312,6 +317,12 @@ static blk_status_t next_mo_queue_rq(struct blk_mq_hw_ctx *hctx,
 		return BLK_STS_IOERR;
 
 	blk_mq_start_request(rq);
+	mutex_lock(&mo->lock);
+	if (!drive->present) {
+		mutex_unlock(&mo->lock);
+		blk_mq_end_request(rq, BLK_STS_MEDIUM);
+		return BLK_STS_OK;
+	}
 	next_mo_select(mo, drive->unit);
 
 	if (write) {
@@ -330,6 +341,7 @@ static blk_status_t next_mo_queue_rq(struct blk_mq_hw_ctx *hctx,
 		}
 	}
 
+	mutex_unlock(&mo->lock);
 	blk_mq_end_request(rq, errno_to_blk_status(err));
 	return BLK_STS_OK;
 }
@@ -338,8 +350,90 @@ static const struct blk_mq_ops next_mo_mq_ops = {
 	.queue_rq	= next_mo_queue_rq,
 };
 
+/* Follow the drive after a disk was inserted or ejected, called with the lock held */
+static void next_mo_refresh(struct next_mo_drive *drive)
+{
+	struct next_mo *mo = drive->mo;
+	u16 status = 0;
+
+	next_mo_select(mo, drive->unit);
+	next_mo_clear_attn(mo);
+	if (next_mo_status(mo, &status) || (status & DS_EMPTY)) {
+		if (drive->present) {
+			drive->present = false;
+			drive->changed = true;
+			set_capacity(drive->disk, 0);
+		}
+		return;
+	}
+	if (drive->present)
+		return;
+
+	if ((status & DS_STOPPED) && next_mo_drive_cmd(mo, DRV_START_MOTOR))
+		return;
+	if (next_mo_drive_cmd(mo, DRV_RECAL))
+		return;
+
+	drive->present = true;
+	drive->changed = true;
+	set_disk_ro(drive->disk, status & DS_WP);
+	set_capacity(drive->disk, (sector_t)MO_SECTORS << (ilog2(MO_SECTOR_SIZE) - SECTOR_SHIFT));
+	dev_info(mo->dev, "drive %u: %u MB disk%s\n", drive->unit, MO_SECTORS / 1024,
+		 status & DS_WP ? ", write protected" : "");
+}
+
+static unsigned int next_mo_check_events(struct gendisk *disk, unsigned int clearing)
+{
+	struct next_mo_drive *drive = disk->private_data;
+	unsigned int events;
+
+	mutex_lock(&drive->mo->lock);
+	next_mo_refresh(drive);
+	events = drive->changed ? DISK_EVENT_MEDIA_CHANGE : 0;
+	drive->changed = false;
+	mutex_unlock(&drive->mo->lock);
+	return events;
+}
+
+static int next_mo_open(struct gendisk *disk, blk_mode_t mode)
+{
+	struct next_mo_drive *drive = disk->private_data;
+
+	disk_check_media_change(disk);
+	if (!drive->present && !(mode & BLK_OPEN_NDELAY))
+		return -ENOMEDIUM;
+	return 0;
+}
+
+static int next_mo_ioctl(struct block_device *bdev, blk_mode_t mode, unsigned int cmd,
+			 unsigned long arg)
+{
+	struct next_mo_drive *drive = bdev->bd_disk->private_data;
+	struct next_mo *mo = drive->mo;
+	int err;
+
+	if (cmd != CDROMEJECT)
+		return -ENOTTY;
+	if (disk_openers(bdev->bd_disk) > 1)
+		return -EBUSY;
+
+	mutex_lock(&mo->lock);
+	next_mo_select(mo, drive->unit);
+	err = next_mo_drive_cmd(mo, DRV_EJECT);
+	if (!err) {
+		drive->present = false;
+		drive->changed = true;
+		set_capacity(drive->disk, 0);
+	}
+	mutex_unlock(&mo->lock);
+	return err;
+}
+
 static const struct block_device_operations next_mo_fops = {
 	.owner		= THIS_MODULE,
+	.open		= next_mo_open,
+	.ioctl		= next_mo_ioctl,
+	.check_events	= next_mo_check_events,
 };
 
 static int next_mo_add_drive(struct next_mo *mo, unsigned int unit)
@@ -361,19 +455,6 @@ static int next_mo_add_drive(struct next_mo *mo, unsigned int unit)
 	if (next_mo_drive_cmd(mo, DRV_RESET_ATTN) || next_mo_status(mo, &status))
 		return -ENODEV;
 
-	if (status & DS_EMPTY) {
-		dev_info(mo->dev, "drive %u without a disk\n", unit);
-		return -ENODEV;
-	}
-	if (status & DS_STOPPED) {
-		err = next_mo_drive_cmd(mo, DRV_START_MOTOR);
-		if (err)
-			return err;
-	}
-	err = next_mo_drive_cmd(mo, DRV_RECAL);
-	if (err)
-		return err;
-
 	drive->mo = mo;
 	drive->unit = unit;
 	disk = blk_mq_alloc_disk(&mo->tag_set, &lim, drive);
@@ -382,21 +463,20 @@ static int next_mo_add_drive(struct next_mo *mo, unsigned int unit)
 
 	disk->fops = &next_mo_fops;
 	disk->private_data = drive;
+	disk->events = DISK_EVENT_MEDIA_CHANGE;
 	snprintf(disk->disk_name, sizeof(disk->disk_name), "mo%u", unit);
-	set_capacity(disk, (sector_t)MO_SECTORS << (ilog2(MO_SECTOR_SIZE) - SECTOR_SHIFT));
-	if (status & DS_WP)
-		set_disk_ro(disk, true);
+	drive->disk = disk;
+
+	next_mo_refresh(drive);
+	if (!drive->present)
+		dev_info(mo->dev, "drive %u without a disk\n", unit);
 
 	err = add_disk(disk);
 	if (err) {
+		drive->disk = NULL;
 		put_disk(disk);
-		return err;
 	}
-	drive->disk = disk;
-
-	dev_info(mo->dev, "drive %u: %u MB disk%s\n", unit, MO_SECTORS / 1024,
-		 status & DS_WP ? ", write protected" : "");
-	return 0;
+	return err;
 }
 
 static void next_mo_del_drives(struct next_mo *mo)
@@ -431,6 +511,7 @@ static int next_mo_probe(struct platform_device *pdev)
 		return -ENOMEM;
 	mo->dev = &pdev->dev;
 	mo->regs = next_dev(NEXT_OSP);
+	mutex_init(&mo->lock);
 	init_completion(&mo->done);
 	platform_set_drvdata(pdev, mo);
 
-- 
2.54.0


From 7f35e54642b38d479cd5b766888d663b222bed26 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 06:52:25 +0100
Subject: [PATCH 32/35] m68k: next: Enable memory DMA, document the optional
 hardware modes
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 Documentation/arch/m68k/next.rst | 33 +++++++++++++++++++++-----------
 arch/m68k/configs/next_defconfig |  2 ++
 2 files changed, 24 insertions(+), 11 deletions(-)

diff --git a/Documentation/arch/m68k/next.rst b/Documentation/arch/m68k/next.rst
index eb94f3e101df..edc52544b2fa 100644
--- a/Documentation/arch/m68k/next.rst
+++ b/Documentation/arch/m68k/next.rst
@@ -80,17 +80,28 @@ the NeXTcube.  The i860 keeps running its ROM, its own memory, the video input
 and the JPEG hardware are not used.  It relies on the ROM of the board to set
 up the Bt463 RAMDAC.  ``FBIOPUT_CON2FBMAP`` moves a console to the board.
 
-Some parts of the hardware are not used, the devices work without them:
-
-- Synchronous SCSI: the bus runs asynchronously.  NetBSD does the same, and
-  Previous cannot run the negotiation as it stops on the select with ATN and
-  stop command, so this could not be tested.
-- The DMA channels of the serial ports and the DSP host port, and the memory
-  to register channels: the drivers use programmed I/O.
-- The DSP serial port: it is set up by the program running on the DSP, which
-  is loaded through ``dsp56k``, so it needs no kernel driver.
-- Removable media: optical disks and floppies are expected in the drive when
-  the driver starts, ejecting a mounted disk is not handled.
+Optional modes, which were only tested on the Previous emulator:
+
+- Synchronous SCSI: ``next_esp.sync=1`` negotiates up to 4 MB/s.  It is off by
+  default, as NetBSD also leaves it off on this chip.
+- Serial transmit DMA: ``pmac_zilog.next_dma=1`` uses the SCC channel for one
+  port at a time, not for the console.  Turbo models do not have this channel.
+  The emulator only delivers such data in local loopback (``TIOCM_LOOP``).
+- Memory copy DMA: ``next-m2m`` offers a dmaengine memcpy channel.  It needs 16
+  byte aligned addresses and lengths, and Turbo models do not have the channels.
+- DSP DMA: ``dsp56k`` uses the DMA channel for 16 byte multiples when the word
+  size is 3, the rest of a transfer through programmed I/O.  The old
+  ``DSP56K_SET_TX_WSIZE`` is the same number as ``FIGETBSZ`` and never reaches
+  the driver, use ``DSP56K_SET_TX_WSIZE_NEW``.
+
+Optical disks can be changed at run time: the driver checks the drive when
+``mo0`` is opened, and ``CDROMEJECT`` ejects the disk.
+
+Not supported:
+
+- The i860 of the NeXTdimension, its own memory, video input and JPEG hardware.
+- The DSP serial port needs no kernel driver, it is set up by the program
+  running on the DSP, which is loaded through ``dsp56k``.
 
 Notes on the hardware
 =====================
diff --git a/arch/m68k/configs/next_defconfig b/arch/m68k/configs/next_defconfig
index 15874f9ecda0..ff9e07400d57 100644
--- a/arch/m68k/configs/next_defconfig
+++ b/arch/m68k/configs/next_defconfig
@@ -49,6 +49,8 @@ CONFIG_ADB_NEXT=y
 CONFIG_INPUT_ADBHID=y
 CONFIG_INPUT_MOUSEDEV=y
 CONFIG_FB=y
+CONFIG_DMADEVICES=y
+CONFIG_NEXT_M2M_DMA=y
 CONFIG_FB_NEXT=y
 CONFIG_FB_NEXTDIMENSION=y
 CONFIG_FRAMEBUFFER_CONSOLE=y
-- 
2.54.0


From b42cf67bffdf0252c44a9a8fa1735851e60cf765 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 08:16:27 +0100
Subject: [PATCH 33/35] m68k: next: Read the DMA CSR out of line
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

GCC narrows a volatile read with a following bit test to a byte access, seen as
btst on the NeXTdimension registers, which are only implemented for 32 bits.
Keep the DMA CSR reads 32 bit too.  They passed either way on the emulator, real
hardware is untested.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 arch/m68k/include/asm/nextdma.h | 6 ++----
 arch/m68k/next/dma.c            | 6 ++++++
 2 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/arch/m68k/include/asm/nextdma.h b/arch/m68k/include/asm/nextdma.h
index ecb711f946ca..95cb0f649492 100644
--- a/arch/m68k/include/asm/nextdma.h
+++ b/arch/m68k/include/asm/nextdma.h
@@ -58,10 +58,8 @@ static inline void nextdma_csr_write(unsigned int chan, u32 val)
 	out_be32(next_io(chan), val);
 }
 
-static inline u32 nextdma_csr_read(unsigned int chan)
-{
-	return in_be32(next_io(chan));
-}
+/* Out of line: GCC would narrow a read with a bit test to a byte access */
+u32 nextdma_csr_read(unsigned int chan);
 
 static inline void nextdma_reg_write(unsigned int chan, int reg, u32 val)
 {
diff --git a/arch/m68k/next/dma.c b/arch/m68k/next/dma.c
index ed6882487f3c..24a51b976a17 100644
--- a/arch/m68k/next/dma.c
+++ b/arch/m68k/next/dma.c
@@ -17,6 +17,12 @@
 DEFINE_SPINLOCK(dma_spin_lock);
 EXPORT_SYMBOL(dma_spin_lock);
 
+u32 nextdma_csr_read(unsigned int chan)
+{
+	return in_be32(next_io(chan));
+}
+EXPORT_SYMBOL_GPL(nextdma_csr_read);
+
 u8 next_osp_gpo;
 EXPORT_SYMBOL_GPL(next_osp_gpo);
 
-- 
2.54.0


From d15f4aff910e074f64cb659ce17c7c9263f4059b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 08:16:27 +0100
Subject: [PATCH 34/35] fbdev: nextdimfb: Add RAMDAC setup and i860 control
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Set up the Bt463 with the register values of the board ROM and a linear palette,
once the ROM has finished as announced by the mask bit it sets before waiting.

Add /dev/nextdimN to run code on the i860: NEXTDIM_RESET restarts the ROM, write
and mmap reach the board memory, NEXTDIM_START signals the ROM to jump to it, and
poll and NEXTDIM_GET_EVENTS report interrupts from the i860.

Tested on the Previous emulator with a C program built with an i860 GCC, on a
NeXTcube and a NeXTcube Turbo.  The boot handshake comes from a trace and
disassembly of the board ROM, real hardware is untested.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 Documentation/arch/m68k/next.rst     |  23 +-
 arch/m68k/include/asm/next.h         |   1 +
 arch/m68k/include/uapi/asm/nextdim.h |  21 ++
 drivers/video/fbdev/Kconfig          |   2 +-
 drivers/video/fbdev/nextdimfb.c      | 328 ++++++++++++++++++++++++++-
 5 files changed, 365 insertions(+), 10 deletions(-)
 create mode 100644 arch/m68k/include/uapi/asm/nextdim.h

diff --git a/Documentation/arch/m68k/next.rst b/Documentation/arch/m68k/next.rst
index edc52544b2fa..36532ba676a4 100644
--- a/Documentation/arch/m68k/next.rst
+++ b/Documentation/arch/m68k/next.rst
@@ -75,10 +75,22 @@ NeXTdimension          nextdimfb                       ``fb1`` and up
 
 SCSI CD-ROM drives work as ``sr0`` with the usual SCSI and ISO 9660 drivers.
 
-The NeXTdimension driver treats the board as a 32 bpp display in the slots of
-the NeXTcube.  The i860 keeps running its ROM, its own memory, the video input
-and the JPEG hardware are not used.  It relies on the ROM of the board to set
-up the Bt463 RAMDAC.  ``FBIOPUT_CON2FBMAP`` moves a console to the board.
+The NeXTdimension driver offers the board as a 32 bpp display in the slots of
+the NeXTcube, and ``FBIOPUT_CON2FBMAP`` moves a console to it.  It repeats the
+RAMDAC setup of the board ROM with a linear palette.  ``/dev/nextdimN`` loads
+and runs code on the i860, see ``asm/nextdim.h``:
+
+- ``NEXTDIM_RESET`` restarts the ROM and waits for it to finish.
+- ``write`` and ``mmap`` access the board memory, which the i860 sees at
+  0xf8000000.  ``NEXTDIM_START`` makes the ROM jump to its start.
+- The i860 fetches 32 bit instructions with the words of each 64 bit pair
+  swapped: a word at offset ``n`` goes to ``n ^ 4`` from the host.
+- The ROM leaves data accesses big endian.  Clear ``EPSR.BE`` first for little
+  endian code, its data and the board registers then are at ``n ^ 4`` as well.
+- Setting bit 0 of ``CSR1`` at 0xff800010 interrupts the host, which ``poll``
+  waits for and ``NEXTDIM_GET_EVENTS`` counts.
+
+The board registers are 32 bit only, reads must not be narrowed by the compiler.
 
 Optional modes, which were only tested on the Previous emulator:
 
@@ -99,7 +111,8 @@ Optical disks can be changed at run time: the driver checks the drive when
 
 Not supported:
 
-- The i860 of the NeXTdimension, its own memory, video input and JPEG hardware.
+- The video input and JPEG hardware of the NeXTdimension, which the Previous
+  emulator also does not provide.
 - The DSP serial port needs no kernel driver, it is set up by the program
   running on the DSP, which is loaded through ``dsp56k``.
 
diff --git a/arch/m68k/include/asm/next.h b/arch/m68k/include/asm/next.h
index 9f945f1c1184..ac52784c2a64 100644
--- a/arch/m68k/include/asm/next.h
+++ b/arch/m68k/include/asm/next.h
@@ -90,6 +90,7 @@ static inline bool next_is_turbo(void)
 #define IRQ_NEXT_ENET_RX_DMA	NEXT_IRQ(27)
 #define IRQ_NEXT_ENET_TX_DMA	NEXT_IRQ(28)
 #define IRQ_NEXT_SCSI_DMA	NEXT_IRQ(26)
+#define IRQ_NEXT_REMOTE		NEXT_IRQ(16)
 #define IRQ_NEXT_R2M_DMA	NEXT_IRQ(18)
 #define IRQ_NEXT_M2R_DMA	NEXT_IRQ(19)
 #define IRQ_NEXT_DSP_DMA	NEXT_IRQ(20)
diff --git a/arch/m68k/include/uapi/asm/nextdim.h b/arch/m68k/include/uapi/asm/nextdim.h
new file mode 100644
index 000000000000..5fe459d2645b
--- /dev/null
+++ b/arch/m68k/include/uapi/asm/nextdim.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * NeXTdimension i860 control
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef _UAPI_ASM_M68K_NEXTDIM_H
+#define _UAPI_ASM_M68K_NEXTDIM_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+/* Restart the i860 in its ROM, which waits for NEXTDIM_START */
+#define NEXTDIM_RESET		_IO('N', 0x20)
+/* Let the ROM jump to the start of the board memory */
+#define NEXTDIM_START		_IO('N', 0x21)
+/* Get and clear the number of interrupts raised by the i860 */
+#define NEXTDIM_GET_EVENTS	_IOR('N', 0x22, __u32)
+
+#endif /* _UAPI_ASM_M68K_NEXTDIM_H */
diff --git a/drivers/video/fbdev/Kconfig b/drivers/video/fbdev/Kconfig
index 1ba02b80e48f..d0d065aa53b4 100644
--- a/drivers/video/fbdev/Kconfig
+++ b/drivers/video/fbdev/Kconfig
@@ -204,7 +204,7 @@ config FB_NEXTDIMENSION
 	select FB_IOMEM_HELPERS
 	help
 	  Support for the 32 bpp display of the NeXTdimension board in a
-	  NeXTcube. The i860 on the board is not used.
+	  NeXTcube, and a device to load and run code on its i860.
 
 config FB_NEXT
 	bool "NeXT framebuffer support"
diff --git a/drivers/video/fbdev/nextdimfb.c b/drivers/video/fbdev/nextdimfb.c
index 54cc2fc03ae4..3f843c738490 100644
--- a/drivers/video/fbdev/nextdimfb.c
+++ b/drivers/video/fbdev/nextdimfb.c
@@ -1,18 +1,30 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * NeXTdimension framebuffer: the 32 bpp display of the i860 board in a NeXTcube.
- * The i860 and its firmware are not used, the host draws directly into the VRAM.
+ * NeXTdimension: the 32 bpp display of the i860 board in a NeXTcube, which the
+ * host draws into directly, and a device to load and run code on the i860.
  *
  * Copyright (C) 2026 René Rebe <rene@exactco.de>
  */
 
+#include <linux/delay.h>
 #include <linux/fb.h>
+#include <linux/fs.h>
+#include <linux/interrupt.h>
 #include <linux/io.h>
 #include <linux/kernel.h>
+#include <linux/miscdevice.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/platform_device.h>
+#include <linux/poll.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
 
 #include <asm/hwtest.h>
+#include <asm/next.h>
+#include <asm/nextdim.h>
 
 /* A board takes two slots and shows up at the even one */
 #define ND_FIRST_SLOT		2
@@ -20,6 +32,9 @@
 #define ND_MAX_BOARDS		3
 
 #define ND_NBIC_PAGE(slot)	(0xf0fff000UL | ((unsigned long)(slot) << 24))
+#define ND_NBIC_INTSTATUS	0xfe8
+#define ND_NBIC_INTMASK		0xfec
+#define ND_NBIC_INTR		0x80
 #define ND_NBIC_ID		0xff0	/* one ID byte in each long word */
 #define ND_ID			0xc0000001
 
@@ -28,22 +43,158 @@
 #define ND_VRAM_SIZE		0x00400000
 #define ND_MC			0x0f800000
 #define ND_MC_SIZE		0x00004000
+#define ND_MC_CSR0		0x0000
+#define ND_MC_CSR1		0x0010
 #define ND_MC_VRAM		0x2000
 #define ND_MC_VRAM_ENABLE	0x00000001
 
+#define ND_CSR0_RESET		0x00000001
+#define ND_CSR0_CS8		0x00000002	/* the i860 boots from the 8 bit ROM */
+#define ND_CSR0_IMASK		0x00000004	/* set by the ROM before it waits */
+#define ND_CSR0_INT		0x00000008
+#define ND_CSR1_INT		0x00000001	/* raised by the i860 for the host */
+
+#define ND_ROM_TIMEOUT_MS	60000
+#define ND_ROM_POLL		(HZ / 5)
+
+#define ND_DRAM			0x08000000
+#define ND_DRAM_SIZE		0x04000000
+
+#define ND_DAC			0x0f200000
+#define ND_DAC_SIZE		0x00001000
+#define ND_DAC_ADDR_LOW		0x0
+#define ND_DAC_ADDR_HIGH	0x4
+#define ND_DAC_REG		0x8
+#define ND_DAC_PALETTE		0xc
+#define ND_DAC_WTT		0x300
+#define ND_DAC_WTT_ENTRIES	16
+#define ND_DAC_PALETTE_ENTRIES	512
+#define ND_DAC_CURSOR		0x20c
+#define ND_DAC_CURSOR_ENTRIES	4
+
 #define ND_WIDTH		1120
 #define ND_HEIGHT		832
 #define ND_LINE_LENGTH		((ND_WIDTH + 32) * 4)
 
 struct nextdimfb_par {
 	void __iomem *mc;
+	void __iomem *dac;
+	void __iomem *nbic;
+	void __iomem *dram;
+	unsigned long dram_phys;
+	struct miscdevice misc;
+	char name[16];
+	struct mutex lock;	/* i860 state */
+	wait_queue_head_t wait;
+	atomic_t events;
+	struct delayed_work dac_work;
+	unsigned int dac_polls;
 	u32 pseudo_palette[16];
 };
 
+/* The setup of the board ROM, except for a linear instead of its gamma palette */
+static const struct {
+	u16 reg;
+	u8 val;
+} nextdimfb_dac_regs[] = {
+	{ 0x201, 0x40 }, { 0x202, 0x00 }, { 0x203, 0x80 },	/* command */
+	{ 0x205, 0xff }, { 0x206, 0xff }, { 0x207, 0xff }, { 0x208, 0xff },	/* read mask */
+	{ 0x209, 0x00 }, { 0x20a, 0x00 }, { 0x20b, 0x00 }, { 0x20c, 0x00 },	/* blink mask */
+	{ 0x20d, 0x90 },
+};
+
 struct nextdimfb {
 	struct fb_info *info[ND_MAX_BOARDS];
 };
 
+/* The board registers are 32 bit only, GCC would narrow a tested read to a byte */
+static noinline u32 nextdimfb_readl(void __iomem *reg)
+{
+	return in_be32(reg);
+}
+
+static void nextdimfb_dac_write(struct nextdimfb_par *par, unsigned int reg, u8 val)
+{
+	out_be32(par->dac + reg, val << 24);
+}
+
+static void nextdimfb_dac_addr(struct nextdimfb_par *par, u16 addr)
+{
+	nextdimfb_dac_write(par, ND_DAC_ADDR_LOW, addr);
+	nextdimfb_dac_write(par, ND_DAC_ADDR_HIGH, addr >> 8);
+}
+
+static int nextdimfb_dac_init(struct nextdimfb_par *par)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(nextdimfb_dac_regs); i++) {
+		nextdimfb_dac_addr(par, nextdimfb_dac_regs[i].reg);
+		nextdimfb_dac_write(par, ND_DAC_REG, nextdimfb_dac_regs[i].val);
+	}
+
+	/* Each window type shows the 24 bit true color planes through the palette */
+	nextdimfb_dac_addr(par, ND_DAC_WTT);
+	for (i = 0; i < ND_DAC_WTT_ENTRIES; i++) {
+		nextdimfb_dac_write(par, ND_DAC_REG, 0x00);
+		nextdimfb_dac_write(par, ND_DAC_REG, 0x01);
+		nextdimfb_dac_write(par, ND_DAC_REG, 0x00);
+	}
+
+	nextdimfb_dac_addr(par, 0);
+	for (i = 0; i < ND_DAC_PALETTE_ENTRIES; i++) {
+		nextdimfb_dac_write(par, ND_DAC_PALETTE, i);
+		nextdimfb_dac_write(par, ND_DAC_PALETTE, i);
+		nextdimfb_dac_write(par, ND_DAC_PALETTE, i);
+	}
+	nextdimfb_dac_addr(par, ND_DAC_CURSOR);
+	for (i = 0; i < ND_DAC_CURSOR_ENTRIES * 3; i++)
+		nextdimfb_dac_write(par, ND_DAC_PALETTE, 0xff);
+
+	for (i = 0; i < ARRAY_SIZE(nextdimfb_dac_regs); i++) {
+		nextdimfb_dac_addr(par, nextdimfb_dac_regs[i].reg);
+		if ((nextdimfb_readl(par->dac + ND_DAC_REG) >> 24) != nextdimfb_dac_regs[i].val)
+			return -EIO;
+	}
+	return 0;
+}
+
+/* The ROM announces that it finished its setup by unmasking the host interrupt */
+static int nextdimfb_rom_wait(struct nextdimfb_par *par)
+{
+	unsigned int ms;
+
+	for (ms = 0; ms < ND_ROM_TIMEOUT_MS; ms += 20) {
+		if (nextdimfb_readl(par->mc + ND_MC_CSR0) & ND_CSR0_IMASK)
+			return 0;
+		msleep(20);
+	}
+	return -ETIMEDOUT;
+}
+
+/* The ROM takes a while after power on, the display can wait but the boot should not */
+static void nextdimfb_dac_work(struct work_struct *work)
+{
+	struct nextdimfb_par *par = container_of(to_delayed_work(work), struct nextdimfb_par,
+						 dac_work);
+	struct device *dev = par->misc.this_device;
+	int err;
+
+	mutex_lock(&par->lock);
+	if (nextdimfb_readl(par->mc + ND_MC_CSR0) & ND_CSR0_IMASK) {
+		err = nextdimfb_dac_init(par);
+		if (err)
+			dev_warn(dev, "RAMDAC setup failed\n");
+		else
+			dev_info(dev, "RAMDAC ready\n");
+	} else if (++par->dac_polls < ND_ROM_TIMEOUT_MS / jiffies_to_msecs(ND_ROM_POLL)) {
+		schedule_delayed_work(&par->dac_work, ND_ROM_POLL);
+	} else {
+		dev_warn(dev, "board ROM did not finish\n");
+	}
+	mutex_unlock(&par->lock);
+}
+
 static int nextdimfb_setcolreg(unsigned int regno, unsigned int red, unsigned int green,
 			       unsigned int blue, unsigned int transp, struct fb_info *info)
 {
@@ -60,7 +211,7 @@ static int nextdimfb_setcolreg(unsigned int regno, unsigned int red, unsigned in
 static int nextdimfb_blank(int blank, struct fb_info *info)
 {
 	struct nextdimfb_par *par = info->par;
-	u32 vram = in_be32(par->mc + ND_MC_VRAM);
+	u32 vram = nextdimfb_readl(par->mc + ND_MC_VRAM);
 
 	if (blank)
 		vram &= ~ND_MC_VRAM_ENABLE;
@@ -77,6 +228,138 @@ static const struct fb_ops nextdimfb_ops = {
 	.fb_blank	= nextdimfb_blank,
 };
 
+static struct nextdimfb_par *nextdim_par(struct file *file)
+{
+	return container_of(file->private_data, struct nextdimfb_par, misc);
+}
+
+static ssize_t nextdim_read(struct file *file, char __user *buf, size_t count, loff_t *ppos)
+{
+	struct nextdimfb_par *par = nextdim_par(file);
+	size_t chunk, done = 0;
+	void *tmp;
+
+	if (*ppos >= ND_DRAM_SIZE)
+		return 0;
+	count = min_t(size_t, count, ND_DRAM_SIZE - *ppos);
+
+	tmp = kmalloc(PAGE_SIZE, GFP_KERNEL);
+	if (!tmp)
+		return -ENOMEM;
+	while (done < count) {
+		chunk = min_t(size_t, count - done, PAGE_SIZE);
+		memcpy_fromio(tmp, par->dram + *ppos, chunk);
+		if (copy_to_user(buf + done, tmp, chunk)) {
+			kfree(tmp);
+			return done ?: -EFAULT;
+		}
+		*ppos += chunk;
+		done += chunk;
+	}
+	kfree(tmp);
+	return done;
+}
+
+static ssize_t nextdim_write(struct file *file, const char __user *buf, size_t count,
+			     loff_t *ppos)
+{
+	struct nextdimfb_par *par = nextdim_par(file);
+	size_t chunk, done = 0;
+	void *tmp;
+
+	if (*ppos >= ND_DRAM_SIZE)
+		return -ENOSPC;
+	count = min_t(size_t, count, ND_DRAM_SIZE - *ppos);
+
+	tmp = kmalloc(PAGE_SIZE, GFP_KERNEL);
+	if (!tmp)
+		return -ENOMEM;
+	while (done < count) {
+		chunk = min_t(size_t, count - done, PAGE_SIZE);
+		if (copy_from_user(tmp, buf + done, chunk)) {
+			kfree(tmp);
+			return done ?: -EFAULT;
+		}
+		memcpy_toio(par->dram + *ppos, tmp, chunk);
+		*ppos += chunk;
+		done += chunk;
+	}
+	kfree(tmp);
+	return done;
+}
+
+static int nextdim_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	struct nextdimfb_par *par = nextdim_par(file);
+
+	vma->vm_page_prot = pgprot_noncached(vma->vm_page_prot);
+	return vm_iomap_memory(vma, par->dram_phys, ND_DRAM_SIZE);
+}
+
+static __poll_t nextdim_poll(struct file *file, poll_table *wait)
+{
+	struct nextdimfb_par *par = nextdim_par(file);
+
+	poll_wait(file, &par->wait, wait);
+	return atomic_read(&par->events) ? EPOLLIN | EPOLLRDNORM : 0;
+}
+
+static long nextdim_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct nextdimfb_par *par = nextdim_par(file);
+	long ret = 0;
+
+	if (cmd == NEXTDIM_RESET)
+		cancel_delayed_work_sync(&par->dac_work);
+
+	mutex_lock(&par->lock);
+	switch (cmd) {
+	case NEXTDIM_RESET:
+		out_be32(par->mc + ND_MC_CSR0, ND_CSR0_CS8 | ND_CSR0_RESET);
+		ret = nextdimfb_rom_wait(par);
+		if (!ret)
+			ret = nextdimfb_dac_init(par);
+		break;
+	case NEXTDIM_START:
+		if (nextdimfb_readl(par->mc + ND_MC_CSR0) & ND_CSR0_IMASK)
+			out_be32(par->mc + ND_MC_CSR0,
+				 nextdimfb_readl(par->mc + ND_MC_CSR0) | ND_CSR0_INT);
+		else
+			ret = -EBUSY;
+		break;
+	case NEXTDIM_GET_EVENTS:
+		ret = put_user(atomic_xchg(&par->events, 0), (__u32 __user *)arg);
+		break;
+	default:
+		ret = -ENOTTY;
+	}
+	mutex_unlock(&par->lock);
+	return ret;
+}
+
+static const struct file_operations nextdim_fops = {
+	.owner		= THIS_MODULE,
+	.read		= nextdim_read,
+	.write		= nextdim_write,
+	.llseek		= default_llseek,
+	.mmap		= nextdim_mmap,
+	.poll		= nextdim_poll,
+	.unlocked_ioctl	= nextdim_ioctl,
+};
+
+static irqreturn_t nextdim_interrupt(int irq, void *dev_id)
+{
+	struct nextdimfb_par *par = dev_id;
+
+	if (!(in_8(par->nbic + ND_NBIC_INTSTATUS) & ND_NBIC_INTR))
+		return IRQ_NONE;
+
+	out_be32(par->mc + ND_MC_CSR1, 0);
+	atomic_inc(&par->events);
+	wake_up_interruptible(&par->wait);
+	return IRQ_HANDLED;
+}
+
 static bool nextdimfb_present(unsigned int slot)
 {
 	void __iomem *nbic = ioremap(ND_NBIC_PAGE(slot), PAGE_SIZE);
@@ -133,10 +416,16 @@ static struct fb_info *nextdimfb_add(struct device *dev, unsigned int slot)
 	info->fbops = &nextdimfb_ops;
 	info->pseudo_palette = par->pseudo_palette;
 
+	mutex_init(&par->lock);
+	init_waitqueue_head(&par->wait);
+	par->dram_phys = board + ND_DRAM;
 	par->mc = ioremap(board + ND_MC, ND_MC_SIZE);
+	par->dac = ioremap(board + ND_DAC, ND_DAC_SIZE);
+	par->nbic = ioremap(ND_NBIC_PAGE(slot), PAGE_SIZE);
+	par->dram = ioremap(par->dram_phys, ND_DRAM_SIZE);
 	info->screen_base = ioremap_wt(board + ND_VRAM, ND_VRAM_SIZE);
 	info->screen_size = ND_VRAM_SIZE;
-	if (!par->mc || !info->screen_base)
+	if (!par->mc || !par->dac || !par->nbic || !par->dram || !info->screen_base)
 		goto err;
 
 	nextdimfb_blank(FB_BLANK_UNBLANK, info);
@@ -144,11 +433,35 @@ static struct fb_info *nextdimfb_add(struct device *dev, unsigned int slot)
 	if (register_framebuffer(info))
 		goto err;
 
+	snprintf(par->name, sizeof(par->name), "nextdim%u", slot);
+	par->misc.minor = MISC_DYNAMIC_MINOR;
+	par->misc.name = par->name;
+	par->misc.fops = &nextdim_fops;
+	if (misc_register(&par->misc)) {
+		unregister_framebuffer(info);
+		goto err;
+	}
+
+	/* Our RAMDAC setup must not get mixed with the one of the ROM still running */
+	INIT_DELAYED_WORK(&par->dac_work, nextdimfb_dac_work);
+	schedule_delayed_work(&par->dac_work, 0);
+
+	if (request_irq(IRQ_NEXT_REMOTE, nextdim_interrupt, IRQF_SHARED, par->name, par))
+		dev_warn(dev, "slot %u: no interrupts from the i860\n", slot);
+	else
+		out_8(par->nbic + ND_NBIC_INTMASK, ND_NBIC_INTR);
+
 	fb_info(info, "NeXTdimension in slot %u, %ux%u, 32 bpp\n", slot, ND_WIDTH, ND_HEIGHT);
 	return info;
 err:
 	if (info->screen_base)
 		iounmap(info->screen_base);
+	if (par->dram)
+		iounmap(par->dram);
+	if (par->nbic)
+		iounmap(par->nbic);
+	if (par->dac)
+		iounmap(par->dac);
 	if (par->mc)
 		iounmap(par->mc);
 	framebuffer_release(info);
@@ -184,8 +497,15 @@ static void nextdimfb_remove(struct platform_device *pdev)
 		struct fb_info *info = nd->info[i];
 		struct nextdimfb_par *par = info->par;
 
+		cancel_delayed_work_sync(&par->dac_work);
+		out_8(par->nbic + ND_NBIC_INTMASK, 0);
+		free_irq(IRQ_NEXT_REMOTE, par);
+		misc_deregister(&par->misc);
 		unregister_framebuffer(info);
 		iounmap(info->screen_base);
+		iounmap(par->dram);
+		iounmap(par->nbic);
+		iounmap(par->dac);
 		iounmap(par->mc);
 		framebuffer_release(info);
 	}
-- 
2.54.0


From 3dc36d008db7cdfcfe75ea96be3a0a9c405a1de8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 3 Nov 2026 08:19:49 +0100
Subject: [PATCH 35/35] Documentation: m68k: next: Describe the Nitro board
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 Documentation/arch/m68k/next.rst | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/Documentation/arch/m68k/next.rst b/Documentation/arch/m68k/next.rst
index 36532ba676a4..b2f02456af09 100644
--- a/Documentation/arch/m68k/next.rst
+++ b/Documentation/arch/m68k/next.rst
@@ -106,6 +106,10 @@ Optional modes, which were only tested on the Previous emulator:
   ``DSP56K_SET_TX_WSIZE`` is the same number as ``FIGETBSZ`` and never reaches
   the driver, use ``DSP56K_SET_TX_WSIZE_NEW``.
 
+The 40 MHz Nitro board of Turbo models needs no driver.  The ROM sets up its
+cache controller at 0x02210000 but leaves the cache disabled, and Linux keeps it
+that way: how it behaves with DMA is unknown, and Previous only has a dummy.
+
 Optical disks can be changed at run time: the driver checks the drive when
 ``mo0`` is opened, and ``CDROMEJECT`` ejects the disk.
 
