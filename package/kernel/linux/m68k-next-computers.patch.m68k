+L(notnext):
+#endif /* CONFIG_NEXT */
+
 #ifdef CONFIG_HP300
 	is_not_hp300(L(nothp300))
 
@@ -1455,6 +1474,12 @@ L(mmu_fixup_done):
 	 */
 	movel	#0x80000000,L(iobase)
 1:
+#endif
+
+#ifdef CONFIG_NEXT
