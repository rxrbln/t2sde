+	movel	#NEXT_IO_VIRT,L(iobase)
+1:
 #endif
 
 	putc	'I'
@@ -2904,6 +2929,31 @@ func_start	serial_init,%d0/%d1/%a0/%a1
 4:
 #endif
 
+#ifdef CONFIG_NEXT
+	is_not_next(L(serial_init_not_next))
