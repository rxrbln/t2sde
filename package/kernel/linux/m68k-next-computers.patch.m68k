diff --git a/arch/m68k/include/asm/next.h b/arch/m68k/include/asm/next.h
new file mode 100644
index 000000000000..23389fd20cb9
--- /dev/null
+++ b/arch/m68k/include/asm/next.h
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * NeXT Computer, NeXTcube and NeXTstation hardware definitions
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef _ASM_M68K_NEXT_H
+#define _ASM_M68K_NEXT_H
+
+#include <asm/bootinfo.h>
+#include <asm/bootinfo-next.h>
+
+/* All of I/O space is mapped here by head.S */
+#define NEXT_IO_PHYS		0x02000000
+#define NEXT_IO_SIZE		0x00400000
+#define NEXT_IO_VIRT		0xf0000000
+
+/* Display memory */
+#define NEXT_MONO_VRAM		0x0b000000
+#define NEXT_COLOR_VRAM		0x2c000000
+#define NEXT_TURBO_VRAM		0x0c000000
+#define NEXT_VRAM_SIZE		0x00200000
+
+/* 68040 systems access most devices through the BMAP window */
+#define NEXT_BMAP_OFFSET	0x00100000
+
+/* System registers, relative to I/O space */
+#define NEXT_INTRSTAT		0x00007000
+#define NEXT_INTRMASK		0x00007800
+#define NEXT_SCR1		0x0000c000
+#define NEXT_SCR2		0x0000d000
+#define NEXT_MON		0x0000e000
+
+/* Devices, relative to the 68040 BMAP or 68030 I/O window */
+#define NEXT_ESP		0x00014000
+#define NEXT_TIMER		0x00016000
+#define NEXT_TIMER_CSR		0x00016004
+#define NEXT_SCC		0x00018000
+#define NEXT_SCC_CLK		0x00018004
+#define NEXT_C16_CMD		0x00018180
+#define NEXT_EVENTC		0x0001a000
+
+#ifndef __ASSEMBLER__
+
+#include <linux/types.h>
+
+extern unsigned long next_machine;
+extern unsigned long next_board_rev;
+extern u8 next_ethaddr[6];
+
+void next_init_IRQ(void);
+void next_sched_init(void);
+void next_rom_reset(unsigned long phys_stub);
+
+static inline void __iomem *next_io(unsigned long off)
+{
+	return (void __iomem *)(NEXT_IO_VIRT + off);
+}
+
+static inline void __iomem *next_dev(unsigned long off)
+{
+	return next_io(off + (next_machine == NEXT_MACH_CUBE030 ?
+			      0 : NEXT_BMAP_OFFSET));
+}
+
+static inline bool next_is_color(void)
+{
+	return next_machine == NEXT_MACH_COLOR ||
+	       next_machine == NEXT_MACH_TURBO_COLOR;
+}
+
+static inline bool next_is_turbo(void)
+{
+	return next_machine == NEXT_MACH_TURBO ||
+	       next_machine == NEXT_MACH_TURBO_COLOR ||
+	       next_machine == NEXT_MACH_CUBE_TURBO;
+}
+
+/* Interrupt status and mask bits map linearly to the Linux IRQ numbers */
+#define NEXT_IRQ_BASE		8
+#define NEXT_IRQ(bit)		(NEXT_IRQ_BASE + (bit))
+
+#define IRQ_NEXT_KEYMOUSE	NEXT_IRQ(3)
+#define IRQ_NEXT_ENET_RX	NEXT_IRQ(9)
+#define IRQ_NEXT_ENET_TX	NEXT_IRQ(10)
+#define IRQ_NEXT_SCSI		NEXT_IRQ(12)
+#define IRQ_NEXT_SCC		NEXT_IRQ(17)
+#define IRQ_NEXT_ENET_RX_DMA	NEXT_IRQ(27)
+#define IRQ_NEXT_ENET_TX_DMA	NEXT_IRQ(28)
+#define IRQ_NEXT_SCSI_DMA	NEXT_IRQ(26)
+#define IRQ_NEXT_TIMER		NEXT_IRQ(29)
+
+#endif /* !__ASSEMBLER__ */
+#endif /* _ASM_M68K_NEXT_H */
diff --git a/arch/m68k/include/asm/setup.h b/arch/m68k/include/asm/setup.h
index e4ec169f5c7d..55a688dac9d6 100644
--- a/arch/m68k/include/asm/setup.h
+++ b/arch/m68k/include/asm/setup.h
@@ -38,7 +38,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_MVME16x) || defined(CONFIG_BVME6000)               \
 	|| defined(CONFIG_HP300) || defined(CONFIG_Q40)                      \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147)                  \
-	|| defined(CONFIG_VIRT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
 #  define MACH_IS_AMIGA (m68k_machtype == MACH_AMIGA)
 #else
 #  define MACH_AMIGA_ONLY
@@ -52,7 +52,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_MVME16x) || defined(CONFIG_BVME6000)               \
 	|| defined(CONFIG_HP300) || defined(CONFIG_Q40)                      \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147)                  \
-	|| defined(CONFIG_VIRT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
 #  define MACH_IS_ATARI (m68k_machtype == MACH_ATARI)
 #else
 #  define MACH_ATARI_ONLY
@@ -66,7 +66,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_MVME16x) || defined(CONFIG_BVME6000)                 \
 	|| defined(CONFIG_HP300) || defined(CONFIG_Q40)                        \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147)                    \
-	|| defined(CONFIG_VIRT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
 #  define MACH_IS_MAC (m68k_machtype == MACH_MAC)
 #else
 #  define MACH_MAC_ONLY
@@ -88,7 +88,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_MVME16x) || defined(CONFIG_BVME6000)              \
 	|| defined(CONFIG_HP300) || defined(CONFIG_Q40)                     \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147)                 \
-	|| defined(CONFIG_VIRT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
 #  define MACH_IS_APOLLO (m68k_machtype == MACH_APOLLO)
 #else
 #  define MACH_APOLLO_ONLY
@@ -102,7 +102,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_BVME6000)               \
 	|| defined(CONFIG_HP300) || defined(CONFIG_Q40)                     \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME16x)                 \
-	|| defined(CONFIG_VIRT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
 #  define MACH_IS_MVME147 (m68k_machtype == MACH_MVME147)
 #else
 #  define MACH_MVME147_ONLY
@@ -116,7 +116,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_BVME6000)               \
 	|| defined(CONFIG_HP300) || defined(CONFIG_Q40)                     \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147)                 \
-	|| defined(CONFIG_VIRT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
 #  define MACH_IS_MVME16x (m68k_machtype == MACH_MVME16x)
 #else
 #  define MACH_MVME16x_ONLY
@@ -130,7 +130,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_MVME16x)                \
 	|| defined(CONFIG_HP300) || defined(CONFIG_Q40)                     \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147)                 \
-	|| defined(CONFIG_VIRT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
 #  define MACH_IS_BVME6000 (m68k_machtype == MACH_BVME6000)
 #else
 #  define MACH_BVME6000_ONLY
@@ -144,7 +144,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_MVME16x) \
 	|| defined(CONFIG_BVME6000) || defined(CONFIG_Q40) \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147) \
-	|| defined(CONFIG_VIRT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
 #  define MACH_IS_HP300 (m68k_machtype == MACH_HP300)
 #else
 #  define MACH_HP300_ONLY
@@ -158,7 +158,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_MVME16x)                \
 	|| defined(CONFIG_BVME6000) || defined(CONFIG_HP300)                \
 	|| defined(CONFIG_SUN3X) || defined(CONFIG_MVME147)                 \
-	|| defined(CONFIG_VIRT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
 #  define MACH_IS_Q40 (m68k_machtype == MACH_Q40)
 #else
 #  define MACH_Q40_ONLY
@@ -172,7 +172,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_MVME16x)                \
 	|| defined(CONFIG_BVME6000) || defined(CONFIG_HP300)                \
 	|| defined(CONFIG_Q40) || defined(CONFIG_MVME147)                   \
-	|| defined(CONFIG_VIRT)
+	|| defined(CONFIG_VIRT) || defined(CONFIG_NEXT)
 #  define MACH_IS_SUN3X (m68k_machtype == MACH_SUN3X)
 #else
 #  define CONFIG_SUN3X_ONLY
@@ -186,7 +186,7 @@ extern unsigned long m68k_machtype;
 	|| defined(CONFIG_APOLLO) || defined(CONFIG_MVME16x)                \
 	|| defined(CONFIG_BVME6000) || defined(CONFIG_HP300)                \
 	|| defined(CONFIG_Q40) || defined(CONFIG_SUN3X)                     \
-	|| defined(CONFIG_MVME147)
+	|| defined(CONFIG_MVME147) || defined(CONFIG_NEXT)
 #  define MACH_IS_VIRT (m68k_machtype == MACH_VIRT)
 #else
 #  define MACH_VIRT_ONLY
@@ -194,6 +194,20 @@ extern unsigned long m68k_machtype;
 #  define MACH_TYPE (MACH_VIRT)
 #endif
 
+#if !defined(CONFIG_NEXT)
+#  define MACH_IS_NEXT (0)
+#elif defined(CONFIG_AMIGA) || defined(CONFIG_MAC) || defined(CONFIG_ATARI) \
+	|| defined(CONFIG_APOLLO) || defined(CONFIG_MVME16x)                \
+	|| defined(CONFIG_BVME6000) || defined(CONFIG_HP300)                \
+	|| defined(CONFIG_Q40) || defined(CONFIG_SUN3X)                     \
+	|| defined(CONFIG_MVME147) || defined(CONFIG_VIRT)
+#  define MACH_IS_NEXT (m68k_machtype == MACH_NEXT)
+#else
+#  define MACH_NEXT_ONLY
+#  define MACH_IS_NEXT (1)
+#  define MACH_TYPE (MACH_NEXT)
+#endif
+
 #ifndef MACH_TYPE
 #  define MACH_TYPE (m68k_machtype)
 #endif
diff --git a/arch/m68k/include/uapi/asm/bootinfo-next.h b/arch/m68k/include/uapi/asm/bootinfo-next.h
new file mode 100644
index 000000000000..2382cb0c4dea
--- /dev/null
+++ b/arch/m68k/include/uapi/asm/bootinfo-next.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * asm/bootinfo-next.h -- NeXT-specific boot information definitions
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef _UAPI_ASM_M68K_BOOTINFO_NEXT_H
+#define _UAPI_ASM_M68K_BOOTINFO_NEXT_H
+
+#define BI_NEXT_MACHINE		0x8000	/* machine type (__be32) */
+#define BI_NEXT_BOARD_REV	0x8001	/* board revision (__be32) */
+#define BI_NEXT_ETHADDR		0x8002	/* ROM Ethernet address (__u8[6]) */
+
+/* ROM machine type */
+#define NEXT_MACH_CUBE030	0	/* NeXT Computer, 68030 */
+#define NEXT_MACH_STATION	1	/* NeXTstation */
+#define NEXT_MACH_CUBE		2	/* NeXTcube */
+#define NEXT_MACH_COLOR		3	/* NeXTstation Color */
+#define NEXT_MACH_TURBO		4	/* NeXTstation Turbo */
+#define NEXT_MACH_TURBO_COLOR	5	/* NeXTstation Turbo Color */
+#define NEXT_MACH_CUBE_TURBO	8	/* NeXTcube Turbo */
+
+#define NEXT_BOOTI_VERSION	MK_BI_VERSION(2, 0)
+
+#endif /* _UAPI_ASM_M68K_BOOTINFO_NEXT_H */
diff --git a/arch/m68k/include/uapi/asm/bootinfo.h b/arch/m68k/include/uapi/asm/bootinfo.h
index 28d2d44c08d0..ff3f9e3fc5ff 100644
--- a/arch/m68k/include/uapi/asm/bootinfo.h
+++ b/arch/m68k/include/uapi/asm/bootinfo.h
@@ -91,6 +91,7 @@ struct mem_info {
 #define MACH_M54XX		12
 #define MACH_M5441X		13
 #define MACH_VIRT		14
+#define MACH_NEXT		15
 
 
     /*
diff --git a/arch/m68k/kernel/head.S b/arch/m68k/kernel/head.S
index 502eeae49eaf..c326cc071bb9 100644
--- a/arch/m68k/kernel/head.S
+++ b/arch/m68k/kernel/head.S
@@ -260,6 +260,10 @@
 #include <asm/bootinfo-q40.h>
 #include <asm/bootinfo-virt.h>
 #include <asm/bootinfo-vme.h>
+#include <asm/bootinfo-next.h>
+#ifdef CONFIG_NEXT
+#  include <asm/next.h>
+#endif
 #include <asm/setup.h>
 #include <asm/entry.h>
 #include <asm/page.h>
@@ -532,6 +536,7 @@ func_define	putn,1
 #define is_not_q40(lab) cmpl &MACH_Q40,%pc@(m68k_machtype); jne lab
 #define is_not_sun3x(lab) cmpl &MACH_SUN3X,%pc@(m68k_machtype); jne lab
 #define is_not_virt(lab) cmpl &MACH_VIRT,%pc@(m68k_machtype); jne lab
+#define is_not_next(lab) cmpl &MACH_NEXT,%pc@(m68k_machtype); jne lab
 
 #define hasnt_leds(lab) cmpl &MACH_HP300,%pc@(m68k_machtype); \
 			jeq 42f; \
@@ -577,6 +582,7 @@ ENTRY(_stext)
 	.long	MACH_MAC, MAC_BOOTI_VERSION
 	.long	MACH_Q40, Q40_BOOTI_VERSION
 	.long	MACH_HP300, HP300_BOOTI_VERSION
+	.long	MACH_NEXT, NEXT_BOOTI_VERSION
 	.long	0
 1:	jra	__start
 
@@ -1042,6 +1048,19 @@ L(mmu_init_not_atari):
 L(notq40):
 #endif
 
