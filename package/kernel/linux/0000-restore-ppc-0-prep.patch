diff --git a/arch/powerpc/platforms/prep/residual.c b/arch/powerpc/platforms/prep/residual.c
new file mode 100644
index 000000000000..a2c26b485952
--- /dev/null
+++ b/arch/powerpc/platforms/prep/residual.c
@@ -0,0 +1,285 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * PReP residual data handling.
+ *
+ * The bootwrapper passes the firmware residual data in the device tree
+ * property /prep,residual-data, its length bounds all accesses here.
+ *
+ * Based on the former arch/ppc/platforms/residual.c by Cort Dougan and
+ * Gabriel Paubert.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/of.h>
+#include <linux/pci.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/unaligned.h>
+
+#include <asm/machdep.h>
+
+#include "prep.h"
+
+static_assert(offsetof(struct prep_residual, total_memory) == 504);
+static_assert(offsetof(struct prep_residual, pnp_heap) == 10764);
+static_assert(sizeof(struct prep_residual) == 27148);
+
+const struct prep_residual *prep_res;
+static u32 prep_res_len;
+static bool prep_noresidual __initdata;
+
+static int __init prep_noresidual_setup(char *str)
+{
+	prep_noresidual = true;
+	return 0;
+}
+early_param("noresidual", prep_noresidual_setup);
+
+void __init prep_residual_init(void)
+{
+	const void *p;
+	int len;
+
+	p = of_get_property(of_root, "prep,residual-data", &len);
+	if (!p || prep_noresidual)
+		return;
+
+	if (len < offsetof(struct prep_residual, devices)) {
+		pr_warn("PReP: residual data too short (%d bytes), ignored\n", len);
+		return;
+	}
+
+	prep_res = p;
+	prep_res_len = len;
+	pr_info("PReP: residual data v%u.%u, %u bytes, %u devices\n",
+		prep_res->version, prep_res->revision, len,
+		prep_res->actual_num_devices);
+}
+
+static u32 prep_residual_num_devices(void)
+{
+	u32 avail = (prep_res_len - offsetof(struct prep_residual, devices)) /
+		    sizeof(struct prep_device);
+
+	return min3(prep_res->actual_num_devices, avail,
+		    (u32)PREP_RES_MAX_DEVICES);
+}
+
+unsigned int prep_residual_num_memories(void)
+{
+	u32 avail;
+
+	if (!prep_res)
+		return 0;
+	avail = (prep_res_len - offsetof(struct prep_residual, simm_size)) /
+		sizeof(u32);
+	return min3(prep_res->actual_num_memories, avail,
+		    (u32)PREP_RES_MAX_MEMS);
+}
+
+static u32 prep_heap_size(void)
+{
+	u32 start = offsetof(struct prep_residual, pnp_heap);
+
+	return prep_res_len > start ? prep_res_len - start : 0;
+}
+
+/* Bounds checked length of the PnP packet at heap offset, 0 at the end. */
+static u32 prep_pnp_len(u32 offset)
+{
+	const u8 *p = prep_res->pnp_heap + offset;
+	u32 size = prep_heap_size(), len;
+
+	if (offset >= size)
+		return 0;
+	if (*p & PNP_TAG_LARGE) {
+		if (size - offset < 3)
+			return 0;
+		len = get_unaligned_le16(p + 1) + 3;
+	} else {
+		if (PNP_SMALL_NAME(*p) == PNP_SMALL_END)
+			return 0;
+		len = PNP_SMALL_LEN(*p) + 1;
+	}
+
+	return len <= size - offset ? len : 0;
+}
+
+/* n-th small packet with item name, or large vendor packet of PReP type */
+static const u8 *prep_pnp_find(u32 offset, bool large, u8 what, int n)
+{
+	u32 len;
+
+	for (; (len = prep_pnp_len(offset)); offset += len) {
+		const u8 *p = prep_res->pnp_heap + offset;
+
+		if (large) {
+			if (*p != PNP_LARGE_VENDOR || len < 4 || p[3] != what)
+				continue;
+		} else if ((*p & PNP_TAG_LARGE) || PNP_SMALL_NAME(*p) != what) {
+			continue;
+		}
+		if (!n--)
+			return p;
+	}
+
+	return NULL;
+}
+
+const struct prep_device *prep_residual_find_device(u32 bus_mask, int base,
+						    int sub, int iface, int n)
+{
+	u32 i, num;
+
+	if (!prep_res)
+		return NULL;
+
+	num = prep_residual_num_devices();
+	for (i = 0; i < num; i++) {
+		const struct prep_device_id *id = &prep_res->devices[i].id;
+
+		if ((id->bus_id & bus_mask) &&
+		    (base < 0 || id->base_type == base) &&
+		    (sub < 0 || id->sub_type == sub) &&
+		    (iface < 0 || id->interface == iface) &&
+		    !n--)
+			return &prep_res->devices[i];
+	}
+
+	return NULL;
+}
+
+/* Large vendor packet of the device's allocated resources, with length. */
+static const u8 *prep_device_vendor_pkt(const struct prep_device *dev, u8 type,
+					u32 *len)
+{
+	const u8 *pkt;
+
+	if (!dev || !dev->allocated_offset)
+		return NULL;
+	pkt = prep_pnp_find(dev->allocated_offset, true, type, 0);
+	if (pkt)
+		*len = get_unaligned_le16(pkt + 1) + 3;
+	return pkt;
+}
+
+bool __init prep_residual_pci_cfg(u32 *addr, u32 *data)
+{
+	const struct prep_device *hb;
+	const u8 *pkt;
+	u32 len;
+
+	hb = prep_residual_find_device(PREP_BUS_PROCESSOR, PREP_BASE_BRIDGE,
+				       PREP_SUB_PCI_BRIDGE, -1, 0);
+	if (!hb || (hb->id.interface != PREP_IF_PCI_INDIRECT &&
+		    hb->id.interface != PREP_IF_PCI_RS6K))
+		return false;
+
+	pkt = prep_device_vendor_pkt(hb, PREP_PKT_PCI_BRIDGE, &len);
+	if (!pkt || len < 4 + 12)
+		return false;
+
+	*addr = get_unaligned_le32(pkt + 4);
+	*data = get_unaligned_le32(pkt + 4 + 8);
+	return true;
+}
+
+/* ISA IRQ of a PCI device, 0 for none, -1 if not described. */
+int prep_residual_pci_irq(struct pci_dev *dev)
+{
+	const struct prep_device *bridge;
+	int i = 0;
+
+	while ((bridge = prep_residual_find_device(~0, PREP_BASE_BRIDGE,
+						   PREP_SUB_PCI_BRIDGE, -1, i++))) {
+		const u8 *pkt, *d;
+		u32 len, j;
+		u16 line;
+		u8 pin;
+
+		pkt = prep_device_vendor_pkt(bridge, PREP_PKT_PCI_BRIDGE, &len);
+		if (!pkt || len < 4 + 20)
+			continue;
+
+		d = pkt + 4;
+		if (d[16] != dev->bus->number)
+			continue;
+
+		/* 12 byte entries: slot, devfn, controller, buid, INTA-D */
+		for (j = 20; 4 + j + 12 <= len; j += 12) {
+			if (d[j + 1] != dev->devfn)
+				continue;
+
+			pci_read_config_byte(dev, PCI_INTERRUPT_PIN, &pin);
+			if (!pin || pin > 4)
+				return 0;
+			if (d[j + 2] != 1) {
+				pci_warn(dev, "PReP: interrupt controller type %u not supported\n",
+					 d[j + 2]);
+				return 0;
+			}
+			line = get_unaligned_le16(d + j + 4 + 2 * (pin - 1));
+			return line == 0xffff ? 0 : line & 0x7fff;
+		}
+	}
+
+	return -1;
+}
+
+/* Level triggered ISA IRQs requested by the allocated device resources. */
+u16 __init prep_residual_irq_level_mask(void)
+{
+	const struct prep_device *dev;
+	u16 mask = 0;
+	int i = 0;
+
+	while ((dev = prep_residual_find_device(~0, -1, -1, -1, i++))) {
+		const u8 *pkt;
+
+		if (!dev->allocated_offset)
+			continue;
+		pkt = prep_pnp_find(dev->allocated_offset, false, PNP_SMALL_IRQ, 0);
+		/* optional info byte: bit 2/3 high/low level sensitive */
+		if (pkt && PNP_SMALL_LEN(*pkt) >= 3 && (pkt[3] & 0x0c))
+			mask |= get_unaligned_le16(pkt + 1);
+	}
+
+	return mask;
+}
+
+/* PCI interrupt acknowledge address of the 8259, 0 to poll. */
+u32 __init prep_residual_isapic_addr(void)
+{
+	const struct prep_device *pic;
+	const u8 *pkt;
+	u32 len;
+
+	pic = prep_residual_find_device(~0, PREP_BASE_SYSTEM, PREP_SUB_PIC,
+					PREP_IF_ISA_PIC, 0);
+	pkt = prep_device_vendor_pkt(pic, PREP_PKT_ADDRESS, &len);
+	if (!pkt || len < 4 + 16)
+		return 0;
+
+	/* 32-bit system address of length 1 */
+	if (pkt[4] != 3 || pkt[5] != 32 || get_unaligned_le32(pkt + 4 + 12) != 1)
+		return 0;
+
+	return get_unaligned_le32(pkt + 4 + 4);
+}
+
+static int prep_residual_show(struct seq_file *m, void *v)
+{
+	seq_write(m, prep_res, prep_res_len);
+	return 0;
+}
+
+static int __init prep_residual_proc_init(void)
+{
+	if (prep_res)
+		proc_create_single("residual", 0444, NULL, prep_residual_show);
+	return 0;
+}
+machine_device_initcall(prep, prep_residual_proc_init);
diff --git a/arch/powerpc/platforms/prep/setup.c b/arch/powerpc/platforms/prep/setup.c
new file mode 100644
index 000000000000..d21681550f44
--- /dev/null
+++ b/arch/powerpc/platforms/prep/setup.c
@@ -0,0 +1,391 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * PReP (PowerPC Reference Platform) board setup.
+ *
+ * Based on the former arch/ppc/platforms/prep_setup.c (Linus Torvalds,
+ * Gary Thomas, Cort Dougan, Troy Benjegerdes, Hollis Blanchard) and
+ * arch/ppc/syslib/todc_time.c.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/ioport.h>
+#include <linux/irqdomain.h>
+#include <linux/kernel.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reboot.h>
+#include <linux/rtc/m48t59.h>
+#include <linux/seq_file.h>
+
+#include <asm/i8259.h>
+#include <asm/io.h>
+#include <asm/machdep.h>
+#include <asm/pci-bridge.h>
+#include <asm/processor.h>
+#include <asm/reg.h>
+#include <asm/time.h>
+#include <asm/udbg.h>
+
+#include "prep.h"
+
+int _prep_type;
+EXPORT_SYMBOL(_prep_type);
+
+/* the residual model is not necessarily NUL terminated */
+static char prep_model[sizeof(((struct prep_vpd *)0)->printable_model) + 1];
+
+/* useful ISA ports */
+#define PREP_SP92		0x92	/* system control port A */
+#define PREP_SYSCTL		0x81c
+#define PREP_MOT_L2_REG		0x823
+#define SIO_CONFIG_RA		0x398	/* PC87332 Super I/O index/data */
+#define SIO_CONFIG_RD		0x399
+
+/* IBM reference design */
+#define PREP_IBM_EQUIPMENT	0x80c
+#define PREP_IBM_PM1		0x82a	/* power management register 1 */
+#define PREP_IBM_PLANAR		0x852	/* planar ID */
+
+#define PREP_IBM_EQUIPMENT_SCSIFUSE	0x40
+#define PREP_IBM_EQUIPMENT_CPU		0x02
+
+/* planar IDs */
+#define PREP_IBM_SANDALFOOT	0xfc
+#define PREP_IBM_THINKPAD	0xff
+#define PREP_IBM_CAROLINA_FIRST	0xf0
+#define PREP_IBM_CAROLINA_LAST	0xf7
+#define PREP_IBM_TIGER1_FIRST	0xd1
+#define PREP_IBM_TIGER1_LAST	0xd5
+
+#define MK48T59_RTC_SECONDS	0x1ff9
+#define MC146818_RTC_SECONDS	0x00
+
+static void __noreturn prep_halt(void)
+{
+	local_irq_disable();
+	/* exceptions to the firmware */
+	mtmsr(mfmsr() | MSR_IP);
+	for (;;)
+		;
+}
+
+static void __noreturn prep_restart(char *cmd)
+{
+	local_irq_disable();
+	mtmsr(mfmsr() | MSR_IP);
+
+	/* soft reset through system control port A */
+	outb(inb(PREP_SP92) & ~1, PREP_SP92);
+	outb(inb(PREP_SP92) | 1, PREP_SP92);
+	for (;;)
+		;
+}
+
+/*
+ * On most IBM PReP the power management is a Signetics 87c750 behind the
+ * Utah component, written as a pair of nibbles to port 0x82a, see the IBM
+ * Carolina Technical Specification.
+ */
+static void utah_sig87c750_setbit(unsigned int bytenum, unsigned int bitnum,
+				  int value)
+{
+	u8 byte1 = 0x10, byte2 = 0x10;
+
+	/* the 750's '20.0' is accessed as '0.0' through Utah */
+	bytenum -= 20;
+
+	byte1 |= (!!value) << 2;
+	byte1 |= (bytenum >> 1) & 0x3;
+	byte2 |= (bytenum & 0x1) << 3;
+	byte2 |= bitnum & 0x7;
+
+	/* the controller needs time to recover after each nibble */
+	outb(byte1, PREP_IBM_PM1);
+	mb(); /* complete the write before the delay */
+	udelay(100);
+	outb(byte2, PREP_IBM_PM1);
+	mb(); /* complete the write before the delay */
+	udelay(100);
+}
+
+static int prep_sig750_power_off(struct sys_off_data *data)
+{
+	local_irq_disable();
+	mtmsr(mfmsr() | MSR_IP);
+	/* bit 21.5, "PMEXEC_OFF" */
+	utah_sig87c750_setbit(21, 5, 1);
+	for (;;)
+		;
+	return NOTIFY_DONE;
+}
+
+static void __init prep_ibm_setup(void)
+{
+	u8 planar = inb(PREP_IBM_PLANAR);
+
+	prep_ibm_planar = planar;
+	bool sig750 = true;
+	u8 l2 = 0x03;
+
+	pr_info("PReP: IBM planar ID %02x\n", planar);
+
+	if ((planar >= PREP_IBM_CAROLINA_FIRST && planar <= PREP_IBM_CAROLINA_LAST) ||
+	    (planar >= PREP_IBM_TIGER1_FIRST && planar <= PREP_IBM_TIGER1_LAST))
+		l2 = 0xc0;
+	else if (planar == PREP_IBM_THINKPAD)
+		sig750 = false;
+	else if (planar != PREP_IBM_SANDALFOOT && !prep_res)
+		l2 = 0xc0;	/* unknown without residual data, assume Carolina */
+	else if (planar != PREP_IBM_SANDALFOOT)
+		sig750 = false;
+
+	outb(inb(PREP_SYSCTL) | l2, PREP_SYSCTL);
+	if (sig750)
+		register_sys_off_handler(SYS_OFF_MODE_POWER_OFF,
+					 SYS_OFF_PRIO_PLATFORM,
+					 prep_sig750_power_off, NULL);
+}
+
+static void __init prep_setup_arch(void)
+{
+	u8 reg;
+
+	prep_residual_init();
+
+	/* assume Motorola without residual data, as for netboot */
+	if (prep_res && !strncmp(prep_res->vpd.printable_model, "IBM", 3))
+		_prep_type = _PREP_IBM;
+	else
+		_prep_type = _PREP_Motorola;
+
+	prep_map_isa_io();
+	if (!isa_io_base) {
+		pr_err("PReP: no ISA I/O space\n");
+		return;
+	}
+
+	/* floppy in PS/2 mode, written twice to take effect */
+	outb(0x09, SIO_CONFIG_RA);
+	reg = (inb(SIO_CONFIG_RD) & 0x3f) | 0x40;
+	outb(reg, SIO_CONFIG_RD);
+	outb(reg, SIO_CONFIG_RD);
+
+	if (_prep_type == _PREP_IBM) {
+		prep_ibm_setup();
+		if (prep_res) {
+			memcpy(prep_model, prep_res->vpd.printable_model,
+			       sizeof(prep_model) - 1);
+			prep_board_name = prep_model;
+		}
+	} else {
+		/* L2 enable as in the PReP reference implementation */
+		outb(inb(PREP_SYSCTL) | 0x3, PREP_SYSCTL);
+	}
+}
+
+static void __init prep_init_IRQ(void)
+{
+	struct device_node *np;
+	unsigned long intack;
+	u32 id;
+
+	np = of_find_compatible_node(NULL, NULL, "chrp,iic");
+	if (!np) {
+		pr_err("PReP: no i8259 in the device tree\n");
+		return;
+	}
+
+	if (prep_res) {
+		intack = prep_residual_isapic_addr();
+	} else {
+		/* Raven and Hawk have a different int-ack address, poll them */
+		id = prep_pci_host_id();
+		if (id == (PCI_VENDOR_ID_MOTOROLA | PCI_DEVICE_ID_MOTOROLA_RAVEN << 16) ||
+		    id == (PCI_VENDOR_ID_MOTOROLA | PCI_DEVICE_ID_MOTOROLA_HAWK << 16))
+			intack = 0;
+		else
+			intack = PREP_PCI_INTACK;
+	}
+
+	i8259_init(np, intack);
+	of_node_put(np);
+	/* PCI interrupt lines are mapped through the i8259 */
+	irq_set_default_domain(i8259_get_host());
+}
+
+static u8 prep_nvram_read(u32 addr)
+{
+	outb(addr, PREP_NVRAM_AS0);
+	outb(addr >> 8, PREP_NVRAM_AS1);
+	return inb(PREP_NVRAM_DATA);
+}
+
+static void prep_nvram_write(u32 addr, u8 val)
+{
+	outb(addr, PREP_NVRAM_AS0);
+	outb(addr >> 8, PREP_NVRAM_AS1);
+	outb(val, PREP_NVRAM_DATA);
+}
+
+static u8 prep_rtc_seconds(void)
+{
+	if (_prep_type == _PREP_IBM) {
+		outb(MC146818_RTC_SECONDS, 0x70);
+		return inb(0x71);
+	}
+	return prep_nvram_read(MK48T59_RTC_SECONDS) & 0x7f;
+}
+
+/* Count timebase ticks over one RTC second, 0 if the RTC does not tick. */
+static unsigned long __init prep_measure_tb_freq(void)
+{
+	u64 start;
+	long i;
+	u8 sec;
+
+	sec = prep_rtc_seconds();
+	for (i = 0; i < 10000000 && prep_rtc_seconds() == sec; i++)
+		;
+	if (i == 10000000)
+		return 0;
+	start = get_tb();
+	sec = prep_rtc_seconds();
+	for (i = 0; i < 10000000 && prep_rtc_seconds() == sec; i++)
+		;
+	if (i == 10000000)
+		return 0;
+
+	return get_tb() - start;
+}
+
+static void __init prep_calibrate_decr(void)
+{
+	struct device_node *cpu = of_find_node_by_type(NULL, "cpu");
+	bool have_tb = cpu && of_property_present(cpu, "timebase-frequency");
+	unsigned long freq;
+
+	of_node_put(cpu);
+	generic_calibrate_decr();
+	if (have_tb || !isa_io_base)
+		return;
+
+	freq = prep_measure_tb_freq();
+	if (freq) {
+		ppc_tb_freq = freq;
+		pr_info("PReP: timebase frequency %lu.%06lu MHz from RTC\n",
+			freq / 1000000, freq % 1000000);
+	}
+}
+
+static void prep_show_cpuinfo(struct seq_file *m)
+{
+	unsigned int i, n;
+
+	seq_printf(m, "machine\t\t: PReP %s\n", prep_board_name ?: "");
+
+	if (_prep_type == _PREP_IBM) {
+		u8 equip = inb(PREP_IBM_EQUIPMENT);
+
+		seq_printf(m, "upgrade cpu\t: %spresent\n",
+			   equip & PREP_IBM_EQUIPMENT_CPU ? "not " : "");
+		seq_printf(m, "scsi fuse\t: %s\n",
+			   equip & PREP_IBM_EQUIPMENT_SCSIFUSE ? "ok" : "bad");
+	} else {
+		static const char * const sizes[] = {
+			"512KiB", "256KiB", "1MiB", "none" };
+		static const char * const srams[] = {
+			"synchronous, pipelined, no parity",
+			"synchronous, parity, flow-through",
+			"asynchronous, no parity",
+			"asynchronous, parity" };
+		u8 l2 = inb(PREP_MOT_L2_REG);
+
+		seq_printf(m, "l2 cache\t: %s", sizes[l2 & 0x3]);
+		if ((l2 & 0x3) != 0x3)
+			seq_printf(m, ", parity %s SRAM: %s",
+				   l2 & 0x08 ? "enabled" : "disabled",
+				   srams[(l2 >> 6) & 0x3]);
+		seq_putc(m, '\n');
+	}
+
+	n = prep_residual_num_memories();
+	if (n) {
+		seq_puts(m, "simms\t\t:");
+		for (i = 0; i < n; i++) {
+			u32 size = prep_res->simm_size[i];
+
+			if (size)
+				seq_printf(m, " %u:%uM", i,
+					   size > 1024 ? size >> 20 : size);
+		}
+		seq_putc(m, '\n');
+	}
+}
+
+static u8 prep_m48t59_read(struct device *dev, u32 ofs)
+{
+	return prep_nvram_read(ofs);
+}
+
+static void prep_m48t59_write(struct device *dev, u32 ofs, u8 val)
+{
+	prep_nvram_write(ofs, val);
+}
+
+static struct m48t59_plat_data prep_m48t59_data = {
+	.read_byte	= prep_m48t59_read,
+	.write_byte	= prep_m48t59_write,
+	.type		= M48T59RTC_TYPE_M48T59,
+	/* the firmware keeps two year digits, as TODC we use 2000-2099 */
+	.yy_offset	= 100,
+};
+
+static int __init prep_add_devices(void)
+{
+	static const struct resource nvram_res =
+		DEFINE_RES_IO_NAMED(PREP_NVRAM_AS0, 4, "nvram");
+	struct resource rtc_res[] = {
+		DEFINE_RES_IO_NAMED(0x70, 2, "rtc"),
+		DEFINE_RES_IRQ(8),
+	};
+	struct platform_device *pd;
+
+	request_region(0x00, 0x20, "dma1");
+	request_region(0x40, 0x20, "timer");
+	request_region(0x80, 0x10, "dma page reg");
+	request_region(0xc0, 0x20, "dma2");
+
+	if (_prep_type == _PREP_IBM) {
+		pd = platform_device_register_simple("rtc_cmos", -1, rtc_res,
+						     ARRAY_SIZE(rtc_res));
+	} else {
+		/* the driver needs a mapping, the accessors use I/O ports */
+		prep_m48t59_data.ioaddr = ioport_map(PREP_NVRAM_AS0, 4);
+		pd = platform_device_register_resndata(NULL, "rtc-m48t59", -1,
+						       &nvram_res, 1,
+						       &prep_m48t59_data,
+						       sizeof(prep_m48t59_data));
+	}
+
+	return PTR_ERR_OR_ZERO(pd);
+}
+machine_device_initcall(prep, prep_add_devices);
+
+define_machine(prep) {
+	.name			= "PReP",
+	.compatible		= "prep",
+	.setup_arch		= prep_setup_arch,
+	.discover_phbs		= prep_discover_phbs,
+	.show_cpuinfo		= prep_show_cpuinfo,
+	.init_IRQ		= prep_init_IRQ,
+	.get_irq		= i8259_irq,
+	.pci_irq_fixup		= prep_pci_irq_fixup,
+	.calibrate_decr		= prep_calibrate_decr,
+	.restart		= prep_restart,
+	.halt			= prep_halt,
+	.progress		= udbg_progress,
+};
