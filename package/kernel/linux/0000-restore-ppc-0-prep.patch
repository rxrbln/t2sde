 fi
 
+# The PReP wrapper moves itself to its link address, keep it above the kernel bss
+if [ "$platform" = "prep" ]; then
+    kend=0x$(${CROSS}nm "$kernel" | grep ' _end$' | cut -d' ' -f1)
+    kbase=$(${CROSS}objdump -p "$kernel" | grep -m 1 LOAD | awk '{print $5}')
