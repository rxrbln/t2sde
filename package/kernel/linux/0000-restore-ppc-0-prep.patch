diff --git a/arch/powerpc/boot/dts/prep.dts b/arch/powerpc/boot/dts/prep.dts
new file mode 100644
index 000000000000..53d7608f7f19
--- /dev/null
+++ b/arch/powerpc/boot/dts/prep.dts
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * PReP (PowerPC Reference Platform) machines with i8259, PReP memory map.
+ *
+ * Memory, CPU clocks, the model and the firmware residual data are filled
+ * in by the dtbImage.prep bootwrapper.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+/dts-v1/;
+
+/ {
+	model = "PReP";
+	compatible = "prep";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial0 = &serial0;
+		serial1 = &serial1;
+		pci0 = &pci0;
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			device_type = "cpu";
+			reg = <0>;
+		};
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0 0>;
+	};
+
+	chosen {
+		stdout-path = &serial0;
+	};
+
+	pci0: pci@80000cf8 {
+		compatible = "prep-pci";
+		device_type = "pci";
+		#address-cells = <3>;
+		#size-cells = <2>;
+		/* indirect config address/data, may be overridden by residual data */
+		reg = <0x80000cf8 4 0x80000cfc 4>;
+		bus-range = <0 255>;
+		/* I/O at 0x80000000, memory at 0xc0000000, see PReP spec 6.1 */
+		ranges = <0x01000000 0 0x00000000 0x80000000 0 0x00800000
+			  0x02000000 0 0x00000000 0xc0000000 0 0x3f000000>;
+
+		isa {
+			compatible = "isa";
+			device_type = "isa";
+			#address-cells = <2>;
+			#size-cells = <1>;
+			ranges = <1 0 0x01000000 0 0 0x00010000
+				  0 0 0x02000000 0 0 0x01000000>;
+			interrupt-parent = <&i8259>;
+
+			i8259: interrupt-controller@i20 {
+				compatible = "pnpPNP,000", "chrp,iic";
+				device_type = "interrupt-controller";
+				reg = <1 0x20 2 1 0xa0 2 1 0x4d0 2>;
+				interrupt-controller;
+				#address-cells = <0>;
+				#interrupt-cells = <2>;
+			};
+
+			speaker@i61 {
+				compatible = "pnpPNP,100";
+				reg = <1 0x61 1>;
+			};
+
+			8042@i60 {
+				device_type = "8042";
+				reg = <1 0x60 1 1 0x64 1>;
+				interrupts = <1 3 12 3>;
+			};
+
+			serial0: serial@i3f8 {
+				device_type = "serial";
+				compatible = "pnpPNP,501", "ns16550";
+				reg = <1 0x3f8 8>;
+				virtual-reg = <0x800003f8>;
+				clock-frequency = <1843200>;
+				interrupts = <4 3>;
+			};
+
+			serial1: serial@i2f8 {
+				device_type = "serial";
+				compatible = "pnpPNP,501", "ns16550";
+				reg = <1 0x2f8 8>;
+				virtual-reg = <0x800002f8>;
+				clock-frequency = <1843200>;
+				interrupts = <3 3>;
+			};
+
+			fdc@i3f0 {
+				device_type = "fdc";
+				compatible = "pnpPNP,700";
+				reg = <1 0x3f0 8>;
+				interrupts = <6 3>;
+			};
+		};
+	};
+};
diff --git a/arch/powerpc/boot/mkprep.c b/arch/powerpc/boot/mkprep.c
new file mode 100644
index 000000000000..b4a6d0b0d1db
--- /dev/null
+++ b/arch/powerpc/boot/mkprep.c
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Make a PReP boot partition image from a raw binary bootwrapper, to be
+ * dd'd onto a type 0x41 PReP boot partition, a disk or a floppy.
+ *
+ * Based on the former arch/ppc/boot/utils/mkprep.c by Cort Dougan,
+ * Matt Porter and Peter Wahl.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define PREP_IMAGE_OFFSET	0x400
+#define PREP_PART_TABLE		0x1be
+#define PREP_BOOT_ACTIVE	0x80
+#define PREP_SYSTEM_PREP	0x41
+
+static void store_le32(unsigned int v, unsigned char *p)
+{
+	p[0] = v;
+	p[1] = v >> 8;
+	p[2] = v >> 16;
+	p[3] = v >> 24;
+}
+
+int main(int argc, char *argv[])
+{
+	unsigned char hdr[PREP_IMAGE_OFFSET], *pe = hdr + PREP_PART_TABLE;
+	unsigned char buf[4096];
+	FILE *in, *out;
+	long size;
+	size_t n;
+
+	if (argc != 3) {
+		fprintf(stderr, "usage: %s <binary> <prep-image>\n", argv[0]);
+		return 1;
+	}
+
+	in = fopen(argv[1], "rb");
+	if (!in || fseek(in, 0, SEEK_END)) {
+		perror(argv[1]);
+		return 1;
+	}
+	size = ftell(in);
+	if (size < 0 || fseek(in, 0, SEEK_SET)) {
+		perror(argv[1]);
+		return 1;
+	}
+	if (size > 0xffffffffL - PREP_IMAGE_OFFSET) {
+		fprintf(stderr, "%s: image too large\n", argv[1]);
+		return 1;
+	}
+
+	memset(hdr, 0, sizeof(hdr));
+
+	/* entry point and load image size, in the boot record ... */
+	store_le32(PREP_IMAGE_OFFSET, hdr);
+	store_le32(size + PREP_IMAGE_OFFSET, hdr + 4);
+
+	/* a single active PReP partition, CHS as for a 1.44MB floppy */
+	pe[0] = PREP_BOOT_ACTIVE;
+	pe[1] = 0;
+	pe[2] = 2;
+	pe[3] = 0;
+	pe[4] = PREP_SYSTEM_PREP;
+	pe[5] = 1;
+	pe[6] = 18;
+	pe[7] = 79;
+	/* the PowerStack requires the partition to start at sector 0 */
+	store_le32(0, pe + 8);
+	/* firmware may only read the image within the partition */
+	store_le32((size + PREP_IMAGE_OFFSET + 511) / 512, pe + 12);
+
+	hdr[510] = 0x55;
+	hdr[511] = 0xaa;
+
+	/* ... and again in the second sector */
+	memcpy(hdr + 512, hdr, 8);
+
+	out = fopen(argv[2], "wb");
+	if (!out) {
+		perror(argv[2]);
+		return 1;
+	}
+	if (fwrite(hdr, sizeof(hdr), 1, out) != 1)
+		goto write_error;
+
+	while ((n = fread(buf, 1, sizeof(buf), in)) > 0)
+		if (fwrite(buf, 1, n, out) != n)
+			goto write_error;
+	if (ferror(in)) {
+		perror(argv[1]);
+		return 1;
+	}
+
+	fclose(in);
+	if (fclose(out))
+		goto write_error;
+	return 0;
+
+write_error:
+	perror(argv[2]);
+	return 1;
+}
diff --git a/arch/powerpc/boot/prep-head.S b/arch/powerpc/boot/prep-head.S
new file mode 100644
index 000000000000..692dd6ad1555
--- /dev/null
+++ b/arch/powerpc/boot/prep-head.S
@@ -0,0 +1,205 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * PReP boot image entry.
+ *
+ * The firmware loads the image at an arbitrary address and enters it with
+ * r3 pointing to the residual data, usually in real mode.  Like the former
+ * arch/ppc/boot/simple/head.S and relocate.S we run with the data cache
+ * disabled, so ISA I/O at 0x80000000 is not cached in real mode.  The
+ * residual data is copied above the image and the wrapper, then the image
+ * is moved to its link address by a stub copied above both, and we enter
+ * the generic crt0 with r3 = residual copy (or 0) and r4 = first free byte.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include "ppc_asm.h"
+
+#define MSR_FP		0x2000
+#define MSR_IP		0x0040
+#define SPRN_HID0	1008
+#define HID0_ICE	0x8000
+#define HID0_DCE	0x4000
+#define HID0_ICFI	0x0800
+#define HID0_DCI	0x0400
+#define L1_LINE		32
+#define RES_MAX		0x00100000	/* sanity limit of the residual length */
+
+	.text
+	.globl	_zimage_start
+_zimage_start:
+	mr	r31,r3
+
+	/* r30 = runtime - link offset */
+	bcl	20,31,1f
+1:	mflr	r30
+	lis	r8,1b@ha
+	addi	r8,r8,1b@l
+	subf	r30,r8,r30
+
+	lis	r29,_start@ha		/* r29 = destination (link address) */
+	addi	r29,r29,_start@l
+	add	r28,r29,r30		/* r28 = source (load address) */
+	lis	r27,__bss_start@ha	/* r27 = image size, word aligned */
+	addi	r27,r27,__bss_start@l
+	subf	r27,r29,r27
+	addi	r27,r27,3
+	rlwinm	r27,r27,0,0,29
+
+	/* r26 = residual length, r31 = 0 if there is no usable residual data */
+	li	r26,0
+	cmpwi	r31,0
+	beq	2f
+	lwz	r26,0(r31)
+	cmpwi	r26,0
+	beq	2f
+	lis	r8,RES_MAX@h
+	cmplw	r26,r8
+	ble	3f
+2:	li	r31,0
+	li	r26,0
+3:
+	/* r25 = max(load end, link _end), page aligned */
+	add	r25,r28,r27
+	lis	r8,_end@ha
+	addi	r8,r8,_end@l
+	cmplw	r8,r25
+	ble	4f
+	mr	r25,r8
+4:	addi	r25,r25,4095
+	rlwinm	r25,r25,0,0,19
+
+	/* move behind the residual data only if it overlaps the copies */
+	add	r8,r31,r26
+	cmplw	r8,r25
+	ble	5f
+	add	r9,r25,r26
+	addi	r9,r9,4096
+	cmplw	r31,r9
+	bge	5f
+	addi	r25,r8,4095
+	rlwinm	r25,r25,0,0,19
+5:
+
+	/* r24 = residual copy */
+	li	r24,0
+	cmpwi	r26,0
+	beq	7f
+	mr	r24,r25
+	mtctr	r26
+	addi	r3,r31,-1
+	addi	r4,r24,-1
+6:	lbzu	r0,1(r3)
+	stbu	r0,1(r4)
+	bdnz	6b
+7:
+	/*
+	 * Real mode from here.  Open Firmware (e.g. OpenBIOS on the 40p)
+	 * enters with the MMU on and the residual data in its virtually
+	 * mapped heap, so it was copied above while still translated.
+	 */
+	li	r8,MSR_IP|MSR_FP
+	mtmsr	r8
+	isync
+
+	/* write back what may still be in the data cache */
+	mr	r3,r28
+	mr	r4,r27
+	bl	dflush
+	mr	r3,r24
+	mr	r4,r26
+	bl	dflush
+
+	/* invalidate and disable the L1 caches */
+	li	r11,0
+	ori	r11,r11,HID0_ICE|HID0_DCE|HID0_ICFI|HID0_DCI
+	mfspr	r8,SPRN_HID0
+	or	r9,r8,r11
+	andc	r10,r8,r11
+	sync
+	isync
+	mtspr	SPRN_HID0,r9
+	sync
+	isync
+	mtspr	SPRN_HID0,r10
+	sync
+	isync
+
+	/* r23 = mover stub copy, behind the residual copy */
+	add	r23,r25,r26
+	addi	r23,r23,L1_LINE-1
+	rlwinm	r23,r23,0,0,31-5
+	lis	r3,move_start@ha
+	addi	r3,r3,move_start@l
+	lis	r4,move_end@ha
+	addi	r4,r4,move_end@l
+	subf	r4,r3,r4
+	add	r3,r3,r30
+	srwi	r4,r4,2
+	mtctr	r4
+	addi	r3,r3,-4
+	addi	r4,r23,-4
+8:	lwzu	r0,4(r3)
+	stwu	r0,4(r4)
+	bdnz	8b
+	addi	r22,r4,4		/* r22 = first free byte */
+
+	/* the stub was written by data stores */
+	sync
+	isync
+	mtctr	r23
+	bctr
+
+/* r3 = start, r4 = length */
+dflush:
+	cmpwi	r4,0
+	beqlr
+	add	r4,r3,r4
+	rlwinm	r3,r3,0,0,31-5
+1:	dcbf	0,r3
+	addi	r3,r3,L1_LINE
+	cmplw	r3,r4
+	blt	1b
+	sync
+	blr
+
+/* Position independent: copy r27 bytes from r28 to r29, memmove style. */
+	.balign	4
+move_start:
+	cmplw	r28,r29
+	beq	3f
+	srwi	r0,r27,2
+	mtctr	r0
+	blt	2f
+	addi	r3,r28,-4
+	addi	r4,r29,-4
+1:	lwzu	r0,4(r3)
+	stwu	r0,4(r4)
+	bdnz	1b
+	b	3f
+2:	add	r3,r28,r27
+	add	r4,r29,r27
+1:	lwzu	r0,-4(r3)
+	stwu	r0,-4(r4)
+	bdnz	1b
+3:	/* enable the instruction cache, the data cache stays off */
+	mfspr	r8,SPRN_HID0
+	ori	r9,r8,HID0_ICE|HID0_ICFI
+	sync
+	isync
+	mtspr	SPRN_HID0,r9
+	isync
+	li	r10,HID0_ICFI
+	andc	r9,r9,r10
+	mtspr	SPRN_HID0,r9
+	isync
+
+	mr	r3,r24
+	mr	r4,r22
+	li	r5,0
+	lis	r8,_zimage_start_lib@ha
+	addi	r8,r8,_zimage_start_lib@l
+	mtctr	r8
+	bctr
+	.balign	4
+move_end:
diff --git a/arch/powerpc/boot/prep.c b/arch/powerpc/boot/prep.c
new file mode 100644
index 000000000000..72def965badb
--- /dev/null
+++ b/arch/powerpc/boot/prep.c
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * PReP (PowerPC Reference Platform) bootwrapper.
+ *
+ * Based on the former arch/ppc/boot/simple/misc-prep.c, mpc10x_memory.c
+ * and arch/ppc/syslib/prep_nvram.c (Gary Thomas, Cort Dougan, Tom Rini,
+ * Mark A. Greer, Corey Minyard).
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include "types.h"
+#include "ops.h"
+#include "io.h"
+#include "stdio.h"
+#include "../include/asm/prep-residual.h"
+
+BSS_STACK(8192);
+
+static struct prep_residual *res;
+static u32 res_len;
+static unsigned long mem_size;
+
+/* PReP NVRAM header, see the former include/asm-ppc/prep_nvram.h */
+struct prep_nvram_header {
+	u16	size;
+	u8	version;
+	u8	revision;
+	u16	crc1;
+	u16	crc2;
+	u8	last_os;
+	u8	endian;
+	u8	os_area_usage;
+	u8	pm_mode;
+	u8	restart_block[32];
+	u8	security[72];
+	u8	error_log[2][40];
+	u32	ge_address;
+	u32	ge_length;
+};
+
+#define PREP_NVRAM_MAX		0x8000
+
+static u8 isa_inb(unsigned int port)
+{
+	return in_8((u8 *)(PREP_ISA_IO_BASE + port));
+}
+
+static void isa_outb(unsigned int port, u8 val)
+{
+	out_8((u8 *)(PREP_ISA_IO_BASE + port), val);
+}
+
+static u32 pci_cfg_read32(u8 devfn, u8 off)
+{
+	out_le32((u32 *)PREP_PCI_CFG_ADDR, 0x80000000 | (devfn << 8) | (off & 0xfc));
+	return in_le32((u32 *)PREP_PCI_CFG_DATA);
+}
+
+/* Sum up the enabled MPC105/106/107 memory banks. */
+static unsigned long mpc10x_mem_size(void)
+{
+	u32 id = pci_cfg_read32(0, 0);
+	unsigned long total = 0;
+	u8 enables;
+	int i;
+
+	/* MPC105, MPC106, MPC107 */
+	if ((id & 0xffff) != 0x1057 ||
+	    ((id >> 16) != 1 && (id >> 16) != 2 && (id >> 16) != 4))
+		return 0;
+
+	enables = pci_cfg_read32(0, 0xa0) & 0xff;
+	for (i = 0; i < 8; i++) {
+		int bank = 4 * (i > 3), shift = (i & 3) * 8;
+		unsigned long start, end;
+
+		if (!(enables & (1 << i)))
+			continue;
+
+		start = (pci_cfg_read32(0, 0x80 + bank) >> shift) & 0xff;
+		start |= ((pci_cfg_read32(0, 0x88 + bank) >> shift) & 0x03) << 8;
+		end = (pci_cfg_read32(0, 0x90 + bank) >> shift) & 0xff;
+		end |= ((pci_cfg_read32(0, 0x98 + bank) >> shift) & 0x03) << 8;
+		total += ((end - start) + 1) << 20;
+	}
+
+	return total;
+}
+
+static u8 nvram_read(unsigned int addr)
+{
+	isa_outb(PREP_NVRAM_AS0, addr);
+	isa_outb(PREP_NVRAM_AS1, addr >> 8);
+	return isa_inb(PREP_NVRAM_DATA);
+}
+
+/* Look up a variable in the NVRAM global environment area. */
+static char *prep_nvram_get_var(const char *name)
+{
+	struct prep_nvram_header hdr;
+	unsigned int size, namelen = strlen(name), i;
+	u8 *p = (u8 *)&hdr;
+	char *ge, *cp;
+
+	for (i = 0; i < sizeof(hdr); i++)
+		p[i] = nvram_read(i);
+
+	size = res && res->vpd.nvram_size ? res->vpd.nvram_size : PREP_NVRAM_MAX;
+	if (!hdr.ge_length || hdr.ge_address < sizeof(hdr) ||
+	    hdr.ge_length > size || hdr.ge_address > size - hdr.ge_length)
+		return NULL;
+
+	ge = malloc(hdr.ge_length + 1);
+	if (!ge)
+		return NULL;
+	for (i = 0; i < hdr.ge_length; i++)
+		ge[i] = nvram_read(hdr.ge_address + i);
+	ge[hdr.ge_length] = '\0';
+
+	/* NUL separated name=value strings */
+	for (cp = ge; cp < ge + hdr.ge_length; cp += strlen(cp) + 1) {
+		if (!strncmp(cp, name, namelen) && cp[namelen] == '=')
+			return cp + namelen + 1;
+	}
+
+	free(ge);
+	return NULL;
+}
+
+/* Stop the onboard 21x4x of Motorola PPCBug, it may still DMA from netboot. */
+static void prep_mot_reset_tulip(void)
+{
+	u32 id = pci_cfg_read32(0x70, 0), bar;
+	u16 dev = id >> 16;
+
+	if ((id & 0xffff) != 0x1011 ||
+	    (dev != 0x0002 && dev != 0x0009 && dev != 0x0014 && dev != 0x0019))
+		return;
+
+	bar = pci_cfg_read32(0x70, 0x10);
+	if (!(bar & 1))
+		return;
+	out_le32((u32 *)(PREP_ISA_IO_BASE + (bar & ~3)), 1);
+}
+
+extern u32 __div64_32(u64 *dividend, u32 divisor);
+
+static u32 hz(u32 val)
+{
+	/* some firmware reports MHz */
+	return val && val <= 1024 ? val * 1000000 : val;
+}
+
+static void prep_fixups(void)
+{
+	void *root = finddevice("/");
+	void *chosen;
+	char *bootargs;
+
+	dt_fixup_memory(0, mem_size);
+
+	if (res) {
+		u32 cpu = hz(res->vpd.processor_hz);
+		u32 bus = hz(res->vpd.processor_bus_hz);
+		char model[sizeof(res->vpd.printable_model) + 1];
+
+		memcpy(model, res->vpd.printable_model, sizeof(model) - 1);
+		model[sizeof(model) - 1] = '\0';
+		printf("PReP residual data: %s, %d bytes\n\r", model, res_len);
+		if (model[0])
+			setprop_str(root, "model", model);
+
+		/* bus clocks per timebase tick * 1000, 0: assume 4 */
+		if (bus) {
+			u64 tb = (u64)bus * 1000;
+			u32 div = res->vpd.time_base_divisor ?: 4000;
+
+			__div64_32(&tb, div);
+			dt_fixup_cpu_clocks(cpu, tb, bus);
+		}
+
+		if (res->actual_num_cpus > 1)
+			printf("PReP: %d CPUs, SMP is not supported, using CPU 0\n\r",
+			       res->actual_num_cpus);
+
+		setprop(root, "prep,residual-data", res, res_len);
+	}
+
+	/* node offsets change with the properties added above */
+	chosen = finddevice("/chosen");
+	if (chosen && getprop(chosen, "bootargs", NULL, 0) <= 1) {
+		bootargs = prep_nvram_get_var("bootargs");
+		if (bootargs && bootargs[0])
+			setprop_str(chosen, "bootargs", bootargs);
+	}
+}
+
+void platform_init(unsigned long r3, unsigned long r4, unsigned long r5)
+{
+	unsigned long heap = (unsigned long)_end;
+
+	if (r3) {
+		res = (struct prep_residual *)r3;
+		res_len = res->residual_length;
+	}
+	if (r4 > heap)
+		heap = r4;
+	heap = (heap + 4095) & ~4095UL;
+
+	mem_size = mpc10x_mem_size();
+	if (!mem_size && res)
+		mem_size = res->total_memory;
+	if (!mem_size)
+		mem_size = 32 << 20;
+
+	if (res && res->vpd.firmware_supplier == PREP_FW_MOTOROLA &&
+	    (res->vpd.firmware_supports & PREP_FW_CONVENTIONAL))
+		prep_mot_reset_tulip();
+
+	/* no console yet, nothing sane to continue with */
+	if (heap >= mem_size)
+		exit();
+
+	simple_alloc_init((char *)heap, mem_size - heap, 32, 64);
+	fdt_init(_dtb_start);
+	platform_ops.fixups = prep_fixups;
+	serial_console_init();
+}
diff --git a/arch/powerpc/boot/wrapper b/arch/powerpc/boot/wrapper
index 25321ce262e8..f7616fd05093 100755
