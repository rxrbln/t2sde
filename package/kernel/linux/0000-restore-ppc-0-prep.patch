diff --git a/arch/powerpc/include/asm/prep-residual.h b/arch/powerpc/include/asm/prep-residual.h
new file mode 100644
index 000000000000..e9a6d4a4df35
--- /dev/null
+++ b/arch/powerpc/include/asm/prep-residual.h
@@ -0,0 +1,201 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * PReP residual data, passed by the firmware in r3 to the boot image.
+ *
+ * Layout per "IBM Power Personal Systems Architecture, Residual Data"
+ * (PPS-AR-FW0001), as used by the former arch/ppc PReP support.  Structure
+ * fields are in CPU byte order, PnP heap packets are little-endian.
+ *
+ * Shared by the bootwrapper and the kernel, so only uint*_t types are used.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+#ifndef _ASM_POWERPC_PREP_RESIDUAL_H
+#define _ASM_POWERPC_PREP_RESIDUAL_H
+
+#define PREP_RES_MAX_CPUS		32
+#define PREP_RES_MAX_MEMS		64
+#define PREP_RES_MAX_DEVICES		256
+#define PREP_RES_MAX_MEM_SEGS		64
+#define PREP_RES_PNP_HEAP_SIZE		(2 * PREP_RES_MAX_DEVICES * 32)
+
+/* struct prep_vpd firmware_supplier */
+#define PREP_FW_IBM			0x00
+#define PREP_FW_MOTOROLA		0x01
+#define PREP_FW_FIRMWORKS		0x02
+#define PREP_FW_BULL			0x03
+
+/* struct prep_vpd firmware_supports */
+#define PREP_FW_CONVENTIONAL		0x0001
+#define PREP_FW_OPENFIRMWARE		0x0002
+
+/* struct prep_device_id bus_id */
+#define PREP_BUS_ISA			0x0001
+#define PREP_BUS_EISA			0x0002
+#define PREP_BUS_PCI			0x0004
+#define PREP_BUS_PCMCIA			0x0008
+#define PREP_BUS_PNPISA			0x0010
+#define PREP_BUS_MCA			0x0020
+#define PREP_BUS_MX			0x0040
+#define PREP_BUS_PROCESSOR		0x0080
+#define PREP_BUS_VME			0x0100
+
+/* struct prep_device_id base_type, sub_type and interface */
+#define PREP_BASE_DISPLAY		0x03
+#define PREP_BASE_BRIDGE		0x06
+#define PREP_BASE_SYSTEM		0x08
+
+#define PREP_SUB_SVGA			0x01
+#define PREP_SUB_PCI_BRIDGE		0x04
+#define PREP_SUB_PIC			0x00
+#define PREP_SUB_OPERATOR_PANEL		0x08
+
+#define PREP_IF_PCI_DIRECT		0x00
+#define PREP_IF_PCI_INDIRECT		0x01
+#define PREP_IF_PCI_RS6K		0x02
+#define PREP_IF_ISA_PIC			0x01
+#define PREP_IF_MPIC			0x03
+#define PREP_IF_STATUS_LED		0x06
+
+/* PnP heap packet tags */
+#define PNP_TAG_LARGE			0x80
+#define PNP_SMALL_NAME(t)		(((t) >> 3) & 0x0f)
+#define PNP_SMALL_LEN(t)		((t) & 0x07)
+#define PNP_SMALL_IRQ			0x04
+#define PNP_SMALL_IO			0x08
+#define PNP_SMALL_VENDOR		0x0e
+#define PNP_SMALL_END			0x0f
+#define PNP_LARGE_VENDOR		0x84
+
+/* PReP specific large vendor packet types */
+#define PREP_PKT_L2_CACHE		2
+#define PREP_PKT_PCI_BRIDGE		3
+#define PREP_PKT_BRIDGE_XLATE		5
+#define PREP_PKT_BUS_SPEED		6
+#define PREP_PKT_SCSI			7
+#define PREP_PKT_ADDRESS		9
+#define PREP_PKT_ISA_ROUTING		10
+
+struct prep_vpd {
+	uint8_t  printable_model[32];
+	uint8_t  serial[16];
+	uint8_t  reserved[48];
+	uint32_t firmware_supplier;
+	uint32_t firmware_supports;
+	uint32_t nvram_size;
+	uint32_t num_simm_slots;
+	uint16_t endian_switch_method;
+	uint16_t spread_io_method;
+	uint32_t smp_iar;
+	uint32_t ram_err_log_offset;
+	uint32_t reserved5;
+	uint32_t reserved6;
+	uint32_t processor_hz;
+	uint32_t processor_bus_hz;
+	uint32_t reserved7;
+	uint32_t time_base_divisor;	/* bus clocks per timebase tick * 1000 */
+	uint32_t word_width;
+	uint32_t page_size;
+	uint32_t coherence_block_size;
+	uint32_t granule_size;
+	uint32_t cache_size;		/* L1 total, in KB */
+	uint32_t cache_attrib;
+	uint32_t cache_assoc;
+	uint32_t cache_line_size;
+	uint32_t i_cache_size;
+	uint32_t i_cache_assoc;
+	uint32_t i_cache_line_size;
+	uint32_t d_cache_size;
+	uint32_t d_cache_assoc;
+	uint32_t d_cache_line_size;
+	uint32_t tlb_size;
+	uint32_t tlb_attrib;
+	uint32_t tlb_assoc;
+	uint32_t i_tlb_size;
+	uint32_t i_tlb_assoc;
+	uint32_t d_tlb_size;
+	uint32_t d_tlb_assoc;
+	uint32_t extended_vpd;
+};
+
+struct prep_cpu {
+	uint32_t cpu_type;		/* PVR */
+	uint8_t  cpu_number;
+	uint8_t  cpu_state;
+	uint16_t reserved;
+};
+
+struct prep_mem_map {
+	uint32_t usage;
+	uint32_t base_page;
+	uint32_t page_count;
+};
+
+struct prep_device_id {
+	uint32_t bus_id;
+	uint32_t dev_id;		/* compressed EISA id, big-endian */
+	uint32_t serial_num;
+	uint32_t flags;
+	uint8_t  base_type;
+	uint8_t  sub_type;
+	uint8_t  interface;
+	uint8_t  spare;
+};
+
+/* PCI: bus number and devfn, ISA: slot and logical device */
+struct prep_bus_access {
+	uint8_t  bus;
+	uint8_t  devfn;
+	uint16_t reserved;
+};
+
+struct prep_device {
+	struct prep_device_id	id;
+	struct prep_bus_access	access;
+	/* offsets into pnp_heap */
+	uint32_t allocated_offset;
+	uint32_t possible_offset;
+	uint32_t compatible_offset;
+};
+
+struct prep_residual {
+	uint32_t		residual_length;
+	uint8_t			version;
+	uint8_t			revision;
+	uint16_t		ec;
+	struct prep_vpd		vpd;
+	uint16_t		max_num_cpus;
+	uint16_t		actual_num_cpus;
+	struct prep_cpu		cpus[PREP_RES_MAX_CPUS];
+	uint32_t		total_memory;
+	uint32_t		good_memory;
+	uint32_t		actual_num_mem_segs;
+	struct prep_mem_map	segs[PREP_RES_MAX_MEM_SEGS];
+	uint32_t		actual_num_memories;
+	uint32_t		simm_size[PREP_RES_MAX_MEMS];
+	uint32_t		actual_num_devices;
+	struct prep_device	devices[PREP_RES_MAX_DEVICES];
+	uint8_t			pnp_heap[PREP_RES_PNP_HEAP_SIZE];
+};
+
+/* PReP ISA I/O, ISA memory and PCI DMA windows */
+#define PREP_ISA_IO_BASE		0x80000000
+#define PREP_ISA_MEM_BASE		0xc0000000
+#define PREP_PCI_DRAM_OFFSET		0x80000000
+
+/* MPC105/106 address map A, PReP section 6.1.8 */
+#define PREP_PCI_CFG_ADDR		0x80000cf8
+#define PREP_PCI_CFG_DATA		0x80000cfc
+#define PREP_PCI_INTACK			0xbffffff0
+
+/* PReP NVRAM (MK48T59 on Motorola) index and data ports */
+#define PREP_NVRAM_AS0			0x74
+#define PREP_NVRAM_AS1			0x75
+#define PREP_NVRAM_DATA			0x77
+
+/* Motorola board identification ports */
+#define PREP_MOT_CPUTYPE_REG		0x800
+#define PREP_MOT_BOARDTYPE_REG		0x801
+#define PREP_MOT_BASETYPE_REG		0x803
+
+#endif /* _ASM_POWERPC_PREP_RESIDUAL_H */
