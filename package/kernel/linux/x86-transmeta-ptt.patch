From 0ecb7ce4b936345eadd854cde1ab215cb24cd9d8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Thu, 12 Nov 2026 13:19:54 +0100
Subject: [PATCH] platform/x86: transmeta-ptt: keygen as a boolean switch that
 reads the key state
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Machines with a BIOS option for persistent translation (the OQO 01+) let the
user enable PTT; other boards, e.g. the Fujitsu Futro S, have no such option
and leave CMS in state nokey. Make the keygen attribute behave like that
switch:

 - always present; reading it gives 1 when CMS has left state nokey (a valid
   PTT key in the boot ROM), else 0
 - writing takes the standard boolean input (kstrtobool); true makes CMS
   generate a key and program it into the boot ROM (command 0xe), false is
   rejected with -EINVAL, as CMS has no command to remove a key; with a
   valid key a write does nothing
 - writes still need the module parameter allow_keygen=1, else -EPERM

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: René Rebe <rene@exactco.de>
---
 .../ABI/testing/sysfs-driver-transmeta-ptt    | 20 ++++----
 Documentation/arch/x86/i386/transmeta-ptt.rst |  8 ++--
 drivers/platform/x86/transmeta-ptt.c          | 47 +++++++++++++------
 3 files changed, 49 insertions(+), 26 deletions(-)

diff --git a/Documentation/ABI/testing/sysfs-driver-transmeta-ptt b/Documentation/ABI/testing/sysfs-driver-transmeta-ptt
index 311cb23..847cc3e 100644
--- a/Documentation/ABI/testing/sysfs-driver-transmeta-ptt
+++ b/Documentation/ABI/testing/sysfs-driver-transmeta-ptt
@@ -69,11 +69,15 @@ Date:		November 2026
 KernelVersion:	7.2
 Contact:	René Rebe <rene@exactco.de>
 Description:
-		(WO, root only) Present only with the module parameter
-		allow_keygen=1 (default off). Writing the value
-		"program-boot-rom" makes CMS generate a new PTT key and
-		PROGRAM IT INTO THE BOOT ROM; any other value is rejected
-		with -EINVAL. The driver never generates a key by itself,
-		also not in state nokey. A failed ROM write can leave the
-		system unbootable; databases saved with an older key are no
-		longer accepted.
+		(RW, write root only) Reads 1 when the boot ROM holds a valid
+		PTT key (CMS left state nokey), else 0. Writing a true
+		boolean (kstrtobool: 1, y, on) makes CMS generate a new PTT
+		key and PROGRAM IT INTO THE BOOT ROM; this is the switch a
+		BIOS "persistent translation" option would set. Writes need
+		the module parameter allow_keygen=1 (default off, else
+		-EPERM); false is rejected with -EINVAL, as CMS has no
+		command to remove a key; with a valid key the write does
+		nothing. The driver never generates a key by itself, also not
+		in state nokey. A failed ROM write can leave the system
+		unbootable; databases saved with an older key are no longer
+		accepted.
diff --git a/Documentation/arch/x86/i386/transmeta-ptt.rst b/Documentation/arch/x86/i386/transmeta-ptt.rst
index b637feb..ba05c46 100644
--- a/Documentation/arch/x86/i386/transmeta-ptt.rst
+++ b/Documentation/arch/x86/i386/transmeta-ptt.rst
@@ -61,9 +61,11 @@ The attributes in ``/sys/class/misc/transmeta-ptt/`` are documented in
 	Limit what CMS marks for a save to the translations made while the
 	address space of this process runs (0 = all).
 ``keygen``
-	Only present with the module parameter ``allow_keygen=1``. Writing
-	``program-boot-rom`` makes CMS generate a new key and **program it
-	into the boot ROM**. The driver never does this on its own, also not
+	Reads 1 when the boot ROM holds a valid PTT key, else 0. Writing 1
+	(needs the module parameter ``allow_keygen=1``) makes CMS generate a
+	new key and **program it into the boot ROM**, the switch a BIOS
+	"persistent translation" option would set; 0 is rejected, a key
+	cannot be removed. The driver never does this on its own, also not
 	in state ``nokey``. A failed ROM write can leave the system
 	unbootable; databases saved with an older key are no longer
 	accepted.
diff --git a/drivers/platform/x86/transmeta-ptt.c b/drivers/platform/x86/transmeta-ptt.c
index 06645ac..ab318ba 100644
--- a/drivers/platform/x86/transmeta-ptt.c
+++ b/drivers/platform/x86/transmeta-ptt.c
@@ -93,12 +93,11 @@ static const char * const ptt_stat_names[PTT_STATS_WORDS] = {
 /* transfer buffer; CMS needs a linear address, no particular size */
 #define PTT_BUF_SIZE		SZ_64K
 
-#define PTT_KEYGEN_MAGIC	"program-boot-rom"
 
 static bool allow_keygen;
 module_param(allow_keygen, bool, 0444);
 MODULE_PARM_DESC(allow_keygen,
-		 "create the keygen attribute, which makes CMS program a new PTT key into the boot ROM (default: off)");
+		 "allow writing 1 to the keygen attribute, which makes CMS program a new PTT key into the boot ROM (default: off)");
 
 enum ptt_mode { PTT_CLOSED, PTT_READING, PTT_WRITING };
 
@@ -554,22 +553,49 @@ static ssize_t filter_pid_store(struct device *dev,
 }
 static DEVICE_ATTR_RW(filter_pid);
 
+/* a valid key: CMS left nokey (keygen pending counts as none) */
+static ssize_t keygen_show(struct device *dev, struct device_attribute *attr,
+			   char *buf)
+{
+	unsigned int st;
+	u32 edx;
+
+	guard(mutex)(&ptt.lock);
+	if (ptt_read_state(&edx))
+		return -EIO;
+	st = ptt_state_of(edx);
+	return sysfs_emit(buf, "%d\n", st != PTT_NOKEY && st != PTT_KEYGEN);
+}
+
 /*
- * Key generation writes the boot ROM: only on explicit request, with the
- * module parameter set and the magic value written, never implicitly.
+ * Key generation writes the boot ROM: only on an explicit 1, with the module
+ * parameter set, never implicitly; a key cannot be removed again.
  */
 static ssize_t keygen_store(struct device *dev, struct device_attribute *attr,
 			    const char *buf, size_t count)
 {
+	unsigned int st;
+	bool yes;
 	u32 res;
 	int ret;
 
-	if (!sysfs_streq(buf, PTT_KEYGEN_MAGIC))
+	ret = kstrtobool(buf, &yes);
+	if (ret)
+		return ret;
+	if (!yes)
 		return -EINVAL;
+	if (!allow_keygen)
+		return -EPERM;
 
 	guard(mutex)(&ptt.lock);
 	if (ptt.mode != PTT_CLOSED)
 		return -EBUSY;
+	ret = ptt_read_state(&res);
+	if (ret)
+		return ret;
+	st = ptt_state_of(res);
+	if (st != PTT_NOKEY && st != PTT_KEYGEN)
+		return count;
 	pr_warn("generating a PTT key, CMS programs it into the boot ROM\n");
 	ret = ptt_km(PTT_CMD_KEYGEN, NULL, 0, &res);
 	if (ret)
