+
+struct t2audio_msg {
+    void *data;
+    size_t size;
+    /* Host monotonic time at transport reception, before deferred processing. */
+    u64 received_ns;
+};
+
+struct __attribute__((packed)) t2audio_msg_header {
+    char tag[4];
+    u8 type;
+    t2audio_device_id_t device_id;
+};
+struct __attribute__((packed)) t2audio_msg_base {
+    u32 msg;
