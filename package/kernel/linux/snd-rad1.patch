diff --git a/include/sound/rad1.h b/include/sound/rad1.h
--- /dev/null
+++ b/include/sound/rad1.h
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * This file is subject to the terms and conditions of the GNU General Public
+ * License.  See the file "COPYING" in the main directory of this archive
+ * for more details.
+ *
+ * Copyright (C) 2004-2007 Stanislaw Skowronek <skylark@unaligned.org>
+ * Copyright (C) 2018-2025 René Rebe <rene@exactcode.de>
+ */
+
+#ifndef _SOUND_RAD1_H
+#define _SOUND_RAD1_H
+
+#include <linux/types.h>
+
+#define RAD1_ADATRX	0
+#define RAD1_AESRX	1
+#define RAD1_ADC	2
+#define RAD1_ADATSUBRX	3
+#define RAD1_AESSUBRX	4
+#define RAD1_ADATTX	5
+#define RAD1_AESTX	6
+#define RAD1_DAC	7
+#define RAD1_STATUS	8
+#define RAD1_PIPE_COUNT	9
+
+struct rad1_regs {
+	u32 pci_status;			/* 0x00000000 */
+	u32 adat_rx_msc_ust;		/* 0x00000004 */
+	u32 adat_rx_msc0_submsc;	/* 0x00000008 */
+	u32 aes_rx_msc_ust;		/* 0x0000000c */
+	u32 aes_rx_msc0_submsc;	/* 0x00000010 */
+	u32 adc_msc_ust;		/* 0x00000014 */
+	u32 adc_msc0_submsc;		/* 0x00000018 */
+	u32 adat_tx_msc_ust;		/* 0x0000001c */
+	u32 adat_tx_msc0_submsc;	/* 0x00000020 */
+	u32 aes_tx_msc_ust;		/* 0x00000024 */
+	u32 aes_tx_msc0_submsc;	/* 0x00000028 */
+	u32 dac_msc_ust;		/* 0x0000002c */
+	u32 ust_register;		/* 0x00000030 */
+	u32 gpio_status;		/* 0x00000034 */
+	u32 chip_status1;		/* 0x00000038 */
+	u32 chip_status0;		/* 0x0000003c */
+
+	u32 ust_clock_control;		/* 0x00000040 */
+	u32 adat_rx_control;		/* 0x00000044 */
+	u32 aes_rx_control;		/* 0x00000048 */
+	u32 adc_control;		/* 0x0000004c */
+	u32 adat_tx_control;		/* 0x00000050 */
+	u32 aes_tx_control;		/* 0x00000054 */
+	u32 dac_control;		/* 0x00000058 */
+	u32 status_timer;		/* 0x0000005c */
+
+	u32 _pad70[4];
+
+	u32 misc_control;		/* 0x00000070 */
+	u32 pci_holdoff;		/* 0x00000074 */
+	u32 pci_arb_control;		/* 0x00000078 */
+
+	/* RADICAL uses this offset for its master-clock mux. */
+	u32 volume_control;		/* 0x0000007c */
+
+	u32 reset;			/* 0x00000080 */
+
+	u32 gpio0;			/* 0x00000084 */
+	u32 gpio1;			/* 0x00000088 */
+	u32 gpio2;			/* 0x0000008c */
+	u32 gpio3;			/* 0x00000090 */
+
+	u32 _pada0[3];
+
+	u32 clockgen_ictl;		/* 0x000000a0 */
+	u32 clockgen_rem;		/* 0x000000a4 */
+	u32 freq_synth_mux_sel[4];	/* 0x000000a8 */
+	u32 mpll0_lock_control;		/* 0x000000b8 */
+	u32 mpll1_lock_control;		/* 0x000000bc */
+
+	u32 _pad400[208];
+
+	/* descriptor RAM */
+	struct {
+		u32 loadr;		/* 0x00000400 + 12*idx */
+		u32 hiadr;		/* 0x00000404 + 12*idx */
+		u32 control;		/* 0x00000408 + 12*idx */
+	} pci_descr[16];
+
+	/* running descriptors */
+	struct {
+		u32 loadr;
+		u32 control;
+	} pci_lc[9];
+	u32 pci_hiadr[9];
+
+	u32 _pad1000[693];
+
+	u32 adat_subcode_txa_u[24];	/* 0x00001000 */
+	u32 adat_subcode_txa_unused;	/* 0x00001060 */
+
+	u32 _pad1080[7];
+
+	u32 adat_subcode_txb_u[24];	/* 0x00001080 */
+	u32 adat_subcode_txb_unused;	/* 0x000010e0 */
+
+	u32 _pad1100[7];
+
+	u32 aes_subcode_txa_lu[6];	/* 0x00001100 */
+	u32 aes_subcode_txa_lc[6];	/* 0x00001118 */
+	u32 aes_subcode_txa_lv[6];	/* 0x00001130 */
+	u32 aes_subcode_txa_ru[6];	/* 0x00001148 */
+	u32 aes_subcode_txa_rc[6];	/* 0x00001160 */
+	u32 aes_subcode_txa_rv0[2];	/* 0x00001178 */
+	u32 aes_subcode_txb_lu[6];	/* 0x00001180 */
+	u32 aes_subcode_txb_lc[6];	/* 0x00001198 */
+	u32 aes_subcode_txb_lv[6];	/* 0x000011b0 */
+	u32 aes_subcode_txb_ru[6];	/* 0x000011c8 */
+	u32 aes_subcode_txb_rc[6];	/* 0x000011e0 */
+	u32 aes_subcode_txb_rv0[2];	/* 0x000011f8 */
+	u32 aes_subcode_txa_rv2[4];	/* 0x00001200 */
+	u32 aes_subcode_txb_rv2[4];	/* 0x00001210 */
+	u32 aes_subcode_tx_unused;	/* 0x00001220 */
+};
+
+#endif /* _SOUND_RAD1_H */
diff --git a/sound/pci/rad1.c b/sound/pci/rad1.c
--- /dev/null
+++ b/sound/pci/rad1.c
@@ -0,0 +1,1298 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * ALSA driver for SGI RAD and RADICAL audio.
+ * Copyright (C) 2004-2007 Stanislaw Skowronek <skylark@unaligned.org>
+ * Copyright (C) 2018-2025 René Rebe <rene@exactcode.de>
+ *
+ * Register sequences are derived from IRIX rad_dd.o. See
+ * analysis/rad-adat-comparison.md for the disassembly and remaining
+ * hardware validation requirements.
+ */
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pci.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/timer.h>
+#include <sound/control.h>
+#include <sound/core.h>
+#include <sound/initval.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/rad1.h>
+
+#define RAD1_DMA_ENABLE		BIT(0)
+#define RAD1_RX_OPTICAL		BIT(3)
+#define RAD1_OPTICAL_MASK		GENMASK(10, 9)
+#define RAD1_OPTICAL_ADAT		BIT(10)
+#define RAD1_ADAT_RX_CONDITION	BIT(6)
+#define RAD1_ADAT_RX_HOLD		BIT(6)
+#define RAD1_ADAT_RX_RESET	BIT(7)
+#define RAD1_DMA_COUNT_MASK	0xffffff80U
+#define RAD1_MSC_MASK		0x3fffU
+#define RAD1_DMA_ALIGNMENT	128
+#define RAD1_ADC_MIC_CONTROL	0x03000000U
+#define RAD1_ADC_LINE_CONTROL	0x05000000U
+#define RAD1_REV_RAD		12
+#define RAD1_REV_RADICAL		13
+#define RAD1_ROUTE_ADAT_SWITCH	BIT(0)
+#define RAD1_ROUTE_PLAYBACK	BIT(1)
+
+enum rad1_adat_rx_state {
+	RAD1_RX_UNCHECKED,
+	RAD1_RX_READY,
+	RAD1_RX_RECOVERING,
+};
+
+#define rad1_read(chip, reg) ioread32be(&(chip)->mmio->reg)
+#define rad1_write(chip, reg, value) iowrite32be((value), &(chip)->mmio->reg)
+
+struct rad1_pipe {
+	dma_addr_t dma_addr;
+	struct snd_pcm_substream *substream;
+	u32 control;		/* Control register without DMA enable. */
+	u32 buffer_bytes;
+	u32 period_bytes;
+	u32 position;
+	u32 period_progress;
+	bool opened;
+	bool prepared;
+	bool running;
+};
+
+struct snd_rad1 {
+	spinlock_t lock;		/* MMIO, pipe state, routing and reset shadow. */
+	struct mutex timer_mutex;
+	struct snd_card *card;
+	struct pci_dev *pci;
+	struct rad1_regs __iomem *mmio;
+	struct timer_list timer;
+	bool timer_paused;
+	bool shutting_down;
+	u8 revision_major;
+	enum rad1_adat_rx_state adat_rx_state;
+	unsigned long adat_retry_jiffies;
+	u32 reset;
+	u32 misc;
+	u32 attenuation;
+	u32 radical_mux;
+	u32 adat_msc;
+	u64 adat_time_ns;
+	struct snd_kcontrol *route_controls[2][2];
+	struct rad1_pipe pipes[RAD1_PIPE_COUNT];
+};
+
+static const unsigned int rad1_pcm_pipes[] = {
+	RAD1_ADC, RAD1_DAC, RAD1_AESRX, RAD1_AESTX,
+	RAD1_ADATRX, RAD1_ADATTX,
+};
+
+static bool rad1_has_analog(const struct snd_rad1 *chip)
+{
+	return chip->revision_major == RAD1_REV_RAD;
+}
+
+static unsigned int rad1_pipe_id(struct snd_pcm_substream *substream)
+{
+	static const unsigned int device_pipes[] = {
+		RAD1_DAC, RAD1_ADC, RAD1_AESTX, RAD1_AESRX, RAD1_ADATTX,
+	};
+	unsigned int pipe_id = device_pipes[substream->pcm->device];
+
+	if (pipe_id == RAD1_ADATTX && substream->stream == SNDRV_PCM_STREAM_CAPTURE)
+		return RAD1_ADATRX;
+	return pipe_id;
+}
+
+static u32 __iomem *rad1_control_reg(struct snd_rad1 *chip, unsigned int pipe_id)
+{
+	switch (pipe_id) {
+	case RAD1_ADC:
+		return &chip->mmio->adc_control;
+	case RAD1_DAC:
+		return &chip->mmio->dac_control;
+	case RAD1_AESRX:
+		return &chip->mmio->aes_rx_control;
+	case RAD1_AESTX:
+		return &chip->mmio->aes_tx_control;
+	case RAD1_ADATRX:
+		return &chip->mmio->adat_rx_control;
+	case RAD1_ADATTX:
+		return &chip->mmio->adat_tx_control;
+	default:
+		return NULL;
+	}
+}
+
+static bool rad1_timer_needed(struct snd_rad1 *chip)
+{
+	unsigned int i;
+
+	/* Keep recovering the input clock while an ADAT capture is open. */
+	if (chip->pipes[RAD1_ADATRX].opened)
+		return true;
+	for (i = 0; i < ARRAY_SIZE(rad1_pcm_pipes); i++)
+		if (chip->pipes[rad1_pcm_pipes[i]].running)
+			return true;
+	return false;
+}
+
+/* Caller holds chip->lock; a timer callback uses the same scheduling path. */
+static void rad1_arm_timer(struct snd_rad1 *chip)
+{
+	if (!chip->shutting_down && !chip->timer_paused && rad1_timer_needed(chip))
+		mod_timer(&chip->timer, jiffies + 1);
+}
+
+static int rad1_run_pipe(struct snd_rad1 *chip, unsigned int pipe_id, bool start)
+{
+	struct rad1_pipe *pipe = &chip->pipes[pipe_id];
+	u32 __iomem *reg = rad1_control_reg(chip, pipe_id);
+
+	if (!reg)
+		return -EINVAL;
+	if (start && (chip->shutting_down || !pipe->prepared))
+		return -EBADFD;
+	if (start && pipe_id == RAD1_ADATRX &&
+	    (rad1_read(chip, chip_status1) & RAD1_ADAT_RX_CONDITION))
+		return -ENOLINK;
+	pipe->running = start;
+	iowrite32be(pipe->control | (start ? RAD1_DMA_ENABLE : 0), reg);
+	/* Flush posted control writes before buffer ownership can change. */
+	ioread32be(reg);
+	if (!start)
+		ioread32be(reg);
+	rad1_arm_timer(chip);
+	return 0;
+}
+
+/* The count field represents a negative byte count in 128-byte units. */
+static u32 rad1_position(struct snd_rad1 *chip, unsigned int pipe_id)
+{
+	struct rad1_pipe *pipe = &chip->pipes[pipe_id];
+	u32 pos = pipe->buffer_bytes +
+		(rad1_read(chip, pci_lc[pipe_id].control) & RAD1_DMA_COUNT_MASK);
+
+	/* Count zero denotes the reload boundary, not a position past the ring. */
+	return pos < pipe->buffer_bytes ? pos : 0;
+}
+
+static void rad1_setup_dma(struct snd_rad1 *chip, unsigned int pipe_id)
+{
+	struct rad1_pipe *pipe = &chip->pipes[pipe_id];
+	u32 count = (-pipe->buffer_bytes & RAD1_DMA_COUNT_MASK) | (pipe_id << 3);
+
+	rad1_write(chip, pci_descr[pipe_id].hiadr, upper_32_bits(pipe->dma_addr));
+	rad1_write(chip, pci_descr[pipe_id].loadr, lower_32_bits(pipe->dma_addr));
+	rad1_write(chip, pci_descr[pipe_id].control, count);
+	rad1_write(chip, pci_hiadr[pipe_id], upper_32_bits(pipe->dma_addr));
+	rad1_write(chip, pci_lc[pipe_id].loadr, lower_32_bits(pipe->dma_addr));
+	rad1_write(chip, pci_lc[pipe_id].control, count);
+}
+
+/* IRIX rad_check_adat_rx: hold bit 6, pulse bit 7, release on condition clear. */
+static void rad1_adat_recover(struct snd_rad1 *chip, u32 status)
+{
+	bool bad = status & RAD1_ADAT_RX_CONDITION;
+
+	if (chip->shutting_down)
+		return;
+	if (chip->adat_rx_state == RAD1_RX_READY && bad)
+		chip->adat_rx_state = RAD1_RX_UNCHECKED;
+	if (chip->adat_rx_state == RAD1_RX_UNCHECKED) {
+		if (!bad) {
+			chip->adat_rx_state = RAD1_RX_READY;
+			return;
+		}
+		rad1_write(chip, reset, chip->reset | RAD1_ADAT_RX_HOLD |
+			   RAD1_ADAT_RX_RESET);
+		chip->reset |= RAD1_ADAT_RX_HOLD;
+		rad1_write(chip, reset, chip->reset);
+		chip->adat_rx_state = RAD1_RX_RECOVERING;
+		chip->adat_retry_jiffies = jiffies + msecs_to_jiffies(100);
+	} else if (chip->adat_rx_state == RAD1_RX_RECOVERING) {
+		if (!bad) {
+			chip->reset &= ~RAD1_ADAT_RX_HOLD;
+			rad1_write(chip, reset, chip->reset);
+			chip->adat_rx_state = RAD1_RX_READY;
+		} else if (time_after_eq(jiffies, chip->adat_retry_jiffies)) {
+			rad1_write(chip, reset, chip->reset | RAD1_ADAT_RX_RESET);
+			rad1_write(chip, reset, chip->reset);
+			chip->adat_retry_jiffies = jiffies + msecs_to_jiffies(100);
+		}
+	}
+}
+
+static u32 rad1_adat_msc(struct snd_rad1 *chip)
+{
+	/* IRIX rad_devinfo: 14-bit MSC at bits 31:18; rad_update_dev shifts it. */
+	return rad1_read(chip, adat_rx_msc_ust) >> 18;
+}
+
+static bool rad1_adat_rate_matches(unsigned int rate, u32 frames, u64 ns)
+{
+	u64 measured;
+
+	/* A 14-bit counter is unambiguous for this interval at <= 48 kHz. */
+	if (ns < 20 * NSEC_PER_MSEC || ns > 250 * NSEC_PER_MSEC)
+		return false;
+	measured = div_u64((u64)frames * NSEC_PER_SEC, ns);
+	return measured >= rate - rate / 100 && measured <= rate + rate / 100;
+}
+
+static void rad1_poll_timer(struct timer_list *timer)
+{
+	struct snd_rad1 *chip = timer_container_of(chip, timer, timer);
+	struct snd_pcm_substream *elapsed[ARRAY_SIZE(rad1_pcm_pipes)];
+	struct snd_pcm_substream *xrun = NULL;
+	unsigned int i, n = 0;
+	unsigned long flags;
+	u32 status, msc;
+	u64 now, interval;
+
+	spin_lock_irqsave(&chip->lock, flags);
+	if (chip->shutting_down)
+		goto unlock;
+	if (chip->pipes[RAD1_ADATRX].opened) {
+		struct rad1_pipe *pipe = &chip->pipes[RAD1_ADATRX];
+
+		status = rad1_read(chip, chip_status1);
+		rad1_adat_recover(chip, status);
+		if (pipe->running) {
+			msc = rad1_adat_msc(chip);
+			now = ktime_get_ns();
+			interval = now - chip->adat_time_ns;
+			if ((status & RAD1_ADAT_RX_CONDITION) ||
+			    (interval >= 100 * NSEC_PER_MSEC &&
+			     interval <= 250 * NSEC_PER_MSEC &&
+			     !rad1_adat_rate_matches(pipe->substream->runtime->rate,
+				(msc - chip->adat_msc) & RAD1_MSC_MASK, interval))) {
+				xrun = pipe->substream;
+				rad1_run_pipe(chip, RAD1_ADATRX, false);
+			}
+			if (interval >= 100 * NSEC_PER_MSEC) {
+				chip->adat_msc = msc;
+				chip->adat_time_ns = now;
+			}
+		}
+	}
+	for (i = 0; i < ARRAY_SIZE(rad1_pcm_pipes); i++) {
+		unsigned int pipe_id = rad1_pcm_pipes[i];
+		struct rad1_pipe *pipe = &chip->pipes[pipe_id];
+		u32 pos, delta;
+
+		if (!pipe->running || !pipe->substream)
+			continue;
+		pos = rad1_position(chip, pipe_id);
+		delta = (pos + pipe->buffer_bytes - pipe->position) % pipe->buffer_bytes;
+		pipe->position = pos;
+		pipe->period_progress += delta;
+		if (pipe->period_progress >= pipe->period_bytes) {
+			pipe->period_progress %= pipe->period_bytes;
+			elapsed[n++] = pipe->substream;
+		}
+	}
+	rad1_arm_timer(chip);
+unlock:
+	spin_unlock_irqrestore(&chip->lock, flags);
+	/* ALSA can invoke trigger/pointer here; never hold chip->lock. */
+	if (xrun)
+		snd_pcm_stop_xrun(xrun);
+	for (i = 0; i < n; i++)
+		snd_pcm_period_elapsed(elapsed[i]);
+}
+
+/* Quiesce in-flight notifications before ALSA frees/reuses a runtime. */
+static int rad1_sync_stop(struct snd_pcm_substream *substream)
+{
+	struct snd_rad1 *chip = snd_pcm_substream_chip(substream);
+	unsigned long flags;
+
+	mutex_lock(&chip->timer_mutex);
+	spin_lock_irqsave(&chip->lock, flags);
+	chip->timer_paused = true;
+	spin_unlock_irqrestore(&chip->lock, flags);
+	timer_delete_sync(&chip->timer);
+	spin_lock_irqsave(&chip->lock, flags);
+	chip->timer_paused = false;
+	rad1_arm_timer(chip);
+	spin_unlock_irqrestore(&chip->lock, flags);
+	mutex_unlock(&chip->timer_mutex);
+	return 0;
+}
+
+/* Preserve the original AES channel-status generation. */
+static long rad1_gcd(long x, long y)
+{
+	long t;
+
+	if (x < y) {
+		t = x;
+		x = y;
+		y = t;
+	}
+
+	while (y) {
+		t = y;
+		y = x % y;
+		x = t;
+	}
+
+	return x;
+}
+
+static void rad1_reduce_fraction(long *n, long *d, long max)
+{
+	long gcd = rad1_gcd(*n, *d);
+
+	if (unlikely(!gcd))
+		return;
+
+	*n /= gcd;
+	*d /= gcd;
+
+	/* Scale both terms to fit the hardware divider fields. */
+	while ((*n > max) || (*d > max)) {
+		*n >>= 1;
+		*d >>= 1;
+	}
+}
+
+static void rad1_write_aes_tx_subcode(struct snd_rad1 *chip, const u8 *sub_lc,
+				    const u8 *sub_rc)
+{
+	unsigned int i, j, lc[6], rc[6];
+
+	for (i = 0; i < 6; i++) {
+		lc[i] = 0;
+		rc[i] = 0;
+		for (j = 0; j < 4; j++) {
+			lc[i] |= (u32)sub_lc[i * 4 + j] << (j * 8);
+			rc[i] |= (u32)sub_rc[i * 4 + j] << (j * 8);
+		}
+	}
+
+	for (i = 0; i < 6; i++) {
+		rad1_write(chip, aes_subcode_txa_lu[i], 0x00000000);
+		rad1_write(chip, aes_subcode_txa_lc[i], lc[i]);
+		rad1_write(chip, aes_subcode_txa_lv[i], 0x00000000);
+		rad1_write(chip, aes_subcode_txa_ru[i], 0x00000000);
+		rad1_write(chip, aes_subcode_txa_rc[i], rc[i]);
+		rad1_write(chip, aes_subcode_txb_lu[i], 0x00000000);
+		rad1_write(chip, aes_subcode_txb_lc[i], lc[i]);
+		rad1_write(chip, aes_subcode_txb_lv[i], 0x00000000);
+		rad1_write(chip, aes_subcode_txb_ru[i], 0x00000000);
+		rad1_write(chip, aes_subcode_txb_rc[i], rc[i]);
+	}
+
+	for (i = 0; i < 2; i++) {
+		rad1_write(chip, aes_subcode_txa_rv0[i], 0x00000000);
+		rad1_write(chip, aes_subcode_txb_rv0[i], 0x00000000);
+	}
+
+	for (i = 0; i < 4; i++) {
+		rad1_write(chip, aes_subcode_txa_rv2[i], 0x00000000);
+		rad1_write(chip, aes_subcode_txb_rv2[i], 0x00000000);
+	}
+}
+
+static void rad1_set_aes_tx_subcode(struct snd_rad1 *chip, int rate)
+{
+	u8 lc[24] = {}, rc[24] = {};
+
+	lc[0] = 0x04;	/* PRO=0, !AUDIO=0, COPY=1, PRE=000, MODE=00 */
+	rc[0] = 0x04;
+	lc[1] = 0x01;	/* Laser Optical, CD IEC-908 */
+	rc[1] = 0x01;
+	lc[2] = 0x10;	/* SOURCE=0000, CHANNEL=0001 */
+	rc[2] = 0x20;	/* SOURCE=0000, CHANNEL=0010 */
+
+	/*
+	 * RAD1 systems have generally decent clock sources,
+	 * so we mark them as Level I
+	 */
+	switch (rate) {
+	case 32000:
+		lc[3] = 0x0c;	/* Level I, 32 kHz */
+		rc[3] = 0x0c;
+		break;
+	case 44100:
+		lc[3] = 0x00;	/* Level I, 44.1 kHz */
+		rc[3] = 0x00;
+		break;
+	case 48000:
+		lc[3] = 0x04;	/* Level I, 48 kHz */
+		rc[3] = 0x04;
+		break;
+	default:
+		/* Not a valid IEC-958 sample rate */
+		lc[3] = 0x10;	/* Level III, 44.1 kHz */
+		rc[3] = 0x10;
+	}
+	rad1_write_aes_tx_subcode(chip, lc, rc);
+}
+
+static int rad1_clockgen_id(struct snd_rad1 *chip, unsigned int pipe_id)
+{
+	switch (pipe_id) {
+	case RAD1_ADC:
+		return 0;
+	case RAD1_DAC:
+		return 1;
+	case RAD1_AESTX:
+		return rad1_has_analog(chip) ? 2 : 0;
+	case RAD1_ADATTX:
+		return rad1_has_analog(chip) ? 3 : 1;
+	default:
+		return -1; /* Digital inputs use recovered clocks. */
+	}
+}
+
+static void rad1_set_clock(struct snd_rad1 *chip, unsigned int cg, long rate)
+{
+	long base = !(176400 % rate) ? 176400 : 192000;
+	u32 muxsel = base == 192000;
+	long div, rem;
+	u32 flags;
+
+	rad1_reduce_fraction(&base, &rate, 0xffff);
+	div = base / rate;
+	rem = base % rate;
+	rad1_reduce_fraction(&rem, &rate, 0xffff);
+	flags = rem * 2 < rate ? 0x600 : 0x200;
+
+	chip->reset |= BIT(8 + cg);
+	rad1_write(chip, reset, chip->reset);
+	if (!rad1_has_analog(chip)) {
+		unsigned int synth_shift = cg ? 2 : 0;
+		unsigned int source_shift = cg ? 6 : 4;
+
+		/*
+		 * RADICAL aliases offset 0x7c to the master-clock mux, not volume.
+		 * IRIX rad_vl_set_clockgen_RADICAL selects this synth and source 0.
+		 */
+		chip->radical_mux &= ~((3U << synth_shift) | (3U << source_shift));
+		chip->radical_mux |= cg << synth_shift;
+		rad1_write(chip, volume_control, chip->radical_mux);
+	}
+	rad1_write(chip, freq_synth_mux_sel[3 - cg], muxsel);
+	rad1_write(chip, clockgen_rem, ((u32)rem << 16) | (0x10000 - rate));
+	rad1_write(chip, clockgen_ictl, flags | BIT(28 + cg) | (div - 1));
+	chip->reset &= ~BIT(8 + cg);
+	rad1_write(chip, reset, chip->reset);
+}
+
+static bool rad1_adat_route(struct snd_rad1 *chip, bool playback)
+{
+	return playback ? !!(chip->misc & RAD1_OPTICAL_ADAT) :
+		!!(chip->pipes[RAD1_ADATRX].control & RAD1_RX_OPTICAL);
+}
+
+static int rad1_set_route(struct snd_rad1 *chip, bool playback, bool adat)
+{
+	unsigned int aes = playback ? RAD1_AESTX : RAD1_AESRX;
+	unsigned int ad = playback ? RAD1_ADATTX : RAD1_ADATRX;
+
+	if (adat == rad1_adat_route(chip, playback))
+		return 0;
+	if (chip->pipes[aes].opened || chip->pipes[ad].opened)
+		return -EBUSY;
+	if (playback) {
+		chip->misc &= ~RAD1_OPTICAL_MASK;
+		if (adat)
+			chip->misc |= RAD1_OPTICAL_ADAT;
+		rad1_write(chip, misc_control, chip->misc);
+	} else {
+		chip->pipes[aes].control &= ~RAD1_RX_OPTICAL;
+		chip->pipes[ad].control &= ~RAD1_RX_OPTICAL;
+		if (adat)
+			chip->pipes[ad].control |= RAD1_RX_OPTICAL;
+		else
+			chip->pipes[aes].control |= RAD1_RX_OPTICAL;
+		iowrite32be(chip->pipes[aes].control, rad1_control_reg(chip, aes));
+		iowrite32be(chip->pipes[ad].control, rad1_control_reg(chip, ad));
+	}
+	return 1;
+}
+
+static void rad1_notify_route(struct snd_rad1 *chip, bool playback)
+{
+	unsigned int i;
+
+	for (i = 0; i < 2; i++)
+		if (chip->route_controls[playback][i])
+			snd_ctl_notify(chip->card, SNDRV_CTL_EVENT_MASK_VALUE,
+				       &chip->route_controls[playback][i]->id);
+}
+
+static void rad1_hw_init(struct snd_rad1 *chip)
+{
+	unsigned int cg, i;
+
+	rad1_write(chip, reset, 0xffffffff);
+	udelay(1000);
+	rad1_write(chip, reset, 0xffe3cffe);
+	rad1_write(chip, pci_holdoff, 0x08000010);
+	rad1_write(chip, pci_arb_control, 0x00fac688);
+	chip->pipes[RAD1_ADC].control = RAD1_ADC_MIC_CONTROL;
+	chip->pipes[RAD1_DAC].control = 0x20000000;
+	chip->pipes[RAD1_AESRX].control = 0x00000018;
+	chip->pipes[RAD1_ADATRX].control = 0xa0000000;
+	chip->pipes[RAD1_AESTX].control = rad1_has_analog(chip) ? 0x40000000 : 0;
+	chip->pipes[RAD1_ADATTX].control = rad1_has_analog(chip) ? 0x60000000 : 0x20000000;
+	for (i = 0; i < ARRAY_SIZE(rad1_pcm_pipes); i++) {
+		unsigned int pipe_id = rad1_pcm_pipes[i];
+
+		iowrite32be(chip->pipes[pipe_id].control, rad1_control_reg(chip, pipe_id));
+	}
+	if (!rad1_has_analog(chip)) {
+		rad1_write(chip, gpio0, 0);
+		rad1_write(chip, gpio1, 0);
+		rad1_write(chip, gpio2, 0);
+		rad1_write(chip, gpio3, 0);
+		rad1_write(chip, volume_control, 0);
+	} else {
+		rad1_write(chip, gpio3, 2);
+	}
+	rad1_write(chip, misc_control, 0x1500);
+	rad1_write(chip, mpll0_lock_control, 0x9fffffff);
+	rad1_write(chip, mpll1_lock_control, 0x9fffffff);
+	rad1_write(chip, reset, 0xffe3c0fe);
+	udelay(1000);
+	rad1_write(chip, clockgen_ictl, 0x02000001);
+	rad1_write(chip, reset, 0xffe24070);
+	udelay(1000);
+	chip->reset = 0xffe20000;
+	rad1_write(chip, reset, chip->reset);
+	if (rad1_has_analog(chip)) {
+		rad1_write(chip, gpio2, 2);
+		chip->attenuation = 0xd6d6d6d6;
+		rad1_write(chip, volume_control, chip->attenuation);
+	}
+	udelay(1000);
+	/* Preserve the existing RAD baseline; only bits 10:9 select optical TX. */
+	chip->misc = 0x1040;
+	rad1_write(chip, misc_control, chip->misc);
+	for (cg = 0; cg < (rad1_has_analog(chip) ? 4 : 2); cg++)
+		rad1_set_clock(chip, cg, 48000);
+	/*
+	 * IRIX writes 120 bytes per ADAT bank. Use explicit MMIO offsets,
+	 * including the observed padding, without overrunning the named arrays.
+	 */
+	for (i = 0; i < 30; i++) {
+		iowrite32be(0, (u8 __iomem *)chip->mmio + 0x1000 + i * 4);
+		iowrite32be(0, (u8 __iomem *)chip->mmio + 0x1080 + i * 4);
+	}
+	if (rad1_has_analog(chip))
+		rad1_write(chip, gpio1, 3);
+	fsleep(10000);
+}
+
+static const struct snd_pcm_hardware rad1_pcm_hw = {
+	.info = SNDRV_PCM_INFO_INTERLEAVED | SNDRV_PCM_INFO_MMAP |
+		SNDRV_PCM_INFO_MMAP_VALID | SNDRV_PCM_INFO_BLOCK_TRANSFER,
+#ifdef __BIG_ENDIAN
+	.formats = SNDRV_PCM_FMTBIT_S24_BE,
+#else
+	.formats = SNDRV_PCM_FMTBIT_S24_LE,
+#endif
+	.rates = SNDRV_PCM_RATE_CONTINUOUS | SNDRV_PCM_RATE_32000 |
+		SNDRV_PCM_RATE_44100 | SNDRV_PCM_RATE_48000,
+	.rate_min = 32000,
+	.rate_max = 48000,
+	.channels_min = 2,
+	.channels_max = 2,
+	.buffer_bytes_max = 1024 * 1024,
+	.period_bytes_min = 4096,
+	.period_bytes_max = 4096,
+	.periods_min = 4,
+	.periods_max = 256,
+};
+
+static int rad1_pcm_open(struct snd_pcm_substream *substream)
+{
+	struct snd_rad1 *chip = snd_pcm_substream_chip(substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	unsigned int pipe_id = rad1_pipe_id(substream);
+	bool adat = pipe_id == RAD1_ADATRX || pipe_id == RAD1_ADATTX;
+	unsigned long flags;
+	int err, route = 0;
+
+	runtime->hw = rad1_pcm_hw;
+	if (adat) {
+		runtime->hw.channels_min = 8;
+		runtime->hw.channels_max = 8;
+		/* Ensure at least one poll per minimum-sized ADAT period. */
+		runtime->hw.period_bytes_min = max_t(unsigned int, 4096,
+			roundup(DIV_ROUND_UP(48000 * 32, HZ), RAD1_DMA_ALIGNMENT));
+		runtime->hw.period_bytes_max = 65536;
+	}
+	if (pipe_id == RAD1_AESTX || pipe_id == RAD1_ADATTX)
+		runtime->hw.rates = SNDRV_PCM_RATE_32000 |
+			SNDRV_PCM_RATE_44100 | SNDRV_PCM_RATE_48000;
+	err = snd_pcm_hw_constraint_integer(runtime, SNDRV_PCM_HW_PARAM_PERIODS);
+	if (err < 0)
+		return err;
+	err = snd_pcm_hw_constraint_step(runtime, 0, SNDRV_PCM_HW_PARAM_PERIOD_BYTES,
+				 RAD1_DMA_ALIGNMENT);
+	if (err < 0)
+		return err;
+	err = snd_pcm_hw_constraint_step(runtime, 0, SNDRV_PCM_HW_PARAM_BUFFER_BYTES,
+				 RAD1_DMA_ALIGNMENT);
+	if (err < 0)
+		return err;
+	spin_lock_irqsave(&chip->lock, flags);
+	if (chip->shutting_down) {
+		err = -ENODEV;
+		goto unlock;
+	}
+	if (adat) {
+		route = rad1_set_route(chip, pipe_id == RAD1_ADATTX, true);
+		if (route < 0) {
+			err = route;
+			goto unlock;
+		}
+	}
+	chip->pipes[pipe_id].opened = true;
+	chip->pipes[pipe_id].substream = substream;
+	if (pipe_id == RAD1_ADATRX) {
+		rad1_adat_recover(chip, rad1_read(chip, chip_status1));
+		rad1_arm_timer(chip);
+	}
+	err = 0;
+unlock:
+	spin_unlock_irqrestore(&chip->lock, flags);
+	if (route > 0)
+		rad1_notify_route(chip, pipe_id == RAD1_ADATTX);
+	return err;
+}
+
+static int rad1_pcm_close(struct snd_pcm_substream *substream)
+{
+	struct snd_rad1 *chip = snd_pcm_substream_chip(substream);
+	unsigned int pipe_id = rad1_pipe_id(substream);
+	unsigned long flags;
+
+	spin_lock_irqsave(&chip->lock, flags);
+	rad1_run_pipe(chip, pipe_id, false);
+	chip->pipes[pipe_id].opened = false;
+	chip->pipes[pipe_id].prepared = false;
+	spin_unlock_irqrestore(&chip->lock, flags);
+	rad1_sync_stop(substream);
+	spin_lock_irqsave(&chip->lock, flags);
+	chip->pipes[pipe_id].substream = NULL;
+	spin_unlock_irqrestore(&chip->lock, flags);
+	return 0;
+}
+
+static int rad1_pcm_hw_free(struct snd_pcm_substream *substream)
+{
+	struct snd_rad1 *chip = snd_pcm_substream_chip(substream);
+	unsigned int pipe_id = rad1_pipe_id(substream);
+	unsigned long flags;
+
+	spin_lock_irqsave(&chip->lock, flags);
+	rad1_run_pipe(chip, pipe_id, false);
+	chip->pipes[pipe_id].prepared = false;
+	spin_unlock_irqrestore(&chip->lock, flags);
+	rad1_sync_stop(substream);
+	/* ALSA releases the managed buffer after this callback returns. */
+	return 0;
+}
+
+static int rad1_check_adat_rate(struct snd_rad1 *chip, unsigned int rate)
+{
+	unsigned long flags;
+	u32 status, before, after;
+	u64 start, ns;
+	unsigned int tries;
+
+	for (tries = 0; tries < 10; tries++) {
+		spin_lock_irqsave(&chip->lock, flags);
+		if (chip->shutting_down) {
+			spin_unlock_irqrestore(&chip->lock, flags);
+			return -ENODEV;
+		}
+		status = rad1_read(chip, chip_status1);
+		rad1_adat_recover(chip, status);
+		spin_unlock_irqrestore(&chip->lock, flags);
+		if (!(status & RAD1_ADAT_RX_CONDITION))
+			break;
+		msleep(20);
+	}
+	if (status & RAD1_ADAT_RX_CONDITION)
+		return -ENOLINK;
+	start = ktime_get_ns();
+	before = rad1_adat_msc(chip);
+	msleep(40);
+	spin_lock_irqsave(&chip->lock, flags);
+	if (chip->shutting_down) {
+		spin_unlock_irqrestore(&chip->lock, flags);
+		return -ENODEV;
+	}
+	after = rad1_adat_msc(chip);
+	ns = ktime_get_ns() - start;
+	status = rad1_read(chip, chip_status1);
+	spin_unlock_irqrestore(&chip->lock, flags);
+	if (status & RAD1_ADAT_RX_CONDITION)
+		return -ENOLINK;
+	if (!rad1_adat_rate_matches(rate, (after - before) & RAD1_MSC_MASK, ns))
+		return -EINVAL;
+	return 0;
+}
+
+static int rad1_pcm_prepare(struct snd_pcm_substream *substream)
+{
+	struct snd_rad1 *chip = snd_pcm_substream_chip(substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	unsigned int pipe_id = rad1_pipe_id(substream);
+	struct rad1_pipe *pipe = &chip->pipes[pipe_id];
+	unsigned long flags;
+	unsigned int bytes = frames_to_bytes(runtime, runtime->buffer_size);
+	unsigned int period = frames_to_bytes(runtime, runtime->period_size);
+	int cg = rad1_clockgen_id(chip, pipe_id), err = 0;
+
+	if (!bytes || !period || (bytes & (RAD1_DMA_ALIGNMENT - 1)) ||
+	    (period & (RAD1_DMA_ALIGNMENT - 1)) ||
+	    bytes % period || (runtime->dma_addr & (RAD1_DMA_ALIGNMENT - 1)))
+		return -EINVAL;
+	spin_lock_irqsave(&chip->lock, flags);
+	rad1_run_pipe(chip, pipe_id, false);
+	pipe->prepared = false;
+	spin_unlock_irqrestore(&chip->lock, flags);
+	rad1_sync_stop(substream);
+	if (pipe_id == RAD1_ADATRX) {
+		err = rad1_check_adat_rate(chip, runtime->rate);
+		if (err)
+			return err;
+	} else if (pipe_id == RAD1_AESRX) {
+		/* IRIX rad_cs8412_rate_table, including the 44,056 Hz code. */
+		static const unsigned int cs8412_rates[8] = {
+			0, 48000, 44100, 32000, 48000, 44100, 44056, 32000,
+		};
+		unsigned int code = (rad1_read(chip, chip_status0) >> 24) & 7;
+
+		if (!cs8412_rates[code])
+			return -ENOLINK;
+		if (runtime->rate != cs8412_rates[code])
+			return -EINVAL;
+	}
+	spin_lock_irqsave(&chip->lock, flags);
+	if (chip->shutting_down) {
+		err = -ENODEV;
+		goto unlock;
+	}
+	if (cg >= 0)
+		rad1_set_clock(chip, cg, runtime->rate);
+	if (pipe_id == RAD1_AESTX)
+		rad1_set_aes_tx_subcode(chip, runtime->rate);
+	pipe->dma_addr = runtime->dma_addr;
+	pipe->buffer_bytes = bytes;
+	pipe->period_bytes = period;
+	pipe->position = 0;
+	pipe->period_progress = 0;
+	rad1_setup_dma(chip, pipe_id);
+	pipe->prepared = true;
+unlock:
+	spin_unlock_irqrestore(&chip->lock, flags);
+	return err;
+}
+
+static int rad1_pcm_trigger(struct snd_pcm_substream *substream, int cmd)
+{
+	struct snd_rad1 *chip = snd_pcm_substream_chip(substream);
+	unsigned int pipe_id = rad1_pipe_id(substream);
+	unsigned long flags;
+	int err;
+
+	spin_lock_irqsave(&chip->lock, flags);
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+		if (pipe_id == RAD1_ADATRX) {
+			chip->adat_msc = rad1_adat_msc(chip);
+			chip->adat_time_ns = ktime_get_ns();
+		}
+		err = rad1_run_pipe(chip, pipe_id, true);
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+		err = rad1_run_pipe(chip, pipe_id, false);
+		break;
+	default:
+		err = -EINVAL;
+	}
+	spin_unlock_irqrestore(&chip->lock, flags);
+	return err;
+}
+
+static snd_pcm_uframes_t rad1_pcm_pointer(struct snd_pcm_substream *substream)
+{
+	struct snd_rad1 *chip = snd_pcm_substream_chip(substream);
+	unsigned int pipe_id = rad1_pipe_id(substream);
+	unsigned long flags;
+	snd_pcm_uframes_t frames = 0;
+
+	spin_lock_irqsave(&chip->lock, flags);
+	if (chip->pipes[pipe_id].prepared && !chip->shutting_down)
+		frames = bytes_to_frames(substream->runtime, rad1_position(chip, pipe_id));
+	spin_unlock_irqrestore(&chip->lock, flags);
+	return frames;
+}
+
+static const struct snd_pcm_ops rad1_pcm_ops = {
+	.open = rad1_pcm_open,
+	.close = rad1_pcm_close,
+	.ioctl = snd_pcm_lib_ioctl,
+	.hw_free = rad1_pcm_hw_free,
+	.prepare = rad1_pcm_prepare,
+	.trigger = rad1_pcm_trigger,
+	.sync_stop = rad1_sync_stop,
+	.pointer = rad1_pcm_pointer,
+};
+
+static int rad1_new_pcm(struct snd_rad1 *chip, unsigned int dev,
+			unsigned int pipe_id, const char *name)
+{
+	struct snd_pcm *pcm;
+	bool capture = pipe_id == RAD1_ADC || pipe_id == RAD1_AESRX || pipe_id == RAD1_ADATTX;
+	bool playback = pipe_id == RAD1_DAC || pipe_id == RAD1_AESTX || pipe_id == RAD1_ADATTX;
+	int err;
+
+	err = snd_pcm_new(chip->card, name, dev, playback, capture, &pcm);
+	if (err < 0)
+		return err;
+	pcm->private_data = chip;
+	strscpy(pcm->name, name, sizeof(pcm->name));
+	if (capture)
+		snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_CAPTURE, &rad1_pcm_ops);
+	if (playback)
+		snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_PLAYBACK, &rad1_pcm_ops);
+	return snd_pcm_set_managed_buffer_all(pcm, SNDRV_DMA_TYPE_DEV,
+					      &chip->pci->dev, 64 * 1024, 1024 * 1024);
+}
+
+static int rad1_volume_info(struct snd_kcontrol *ctl, struct snd_ctl_elem_info *info)
+{
+	info->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	info->count = 2;
+	info->value.integer.min = 0;
+	info->value.integer.max = 255;
+	return 0;
+}
+
+static int rad1_volume_get(struct snd_kcontrol *ctl, struct snd_ctl_elem_value *value)
+{
+	struct snd_rad1 *chip = snd_kcontrol_chip(ctl);
+	unsigned int shift = ctl->private_value * 16;
+	unsigned long flags;
+
+	spin_lock_irqsave(&chip->lock, flags);
+	value->value.integer.value[0] = (chip->attenuation >> shift) & 255;
+	value->value.integer.value[1] = (chip->attenuation >> (shift + 8)) & 255;
+	spin_unlock_irqrestore(&chip->lock, flags);
+	return 0;
+}
+
+static int rad1_volume_put(struct snd_kcontrol *ctl, struct snd_ctl_elem_value *value)
+{
+	struct snd_rad1 *chip = snd_kcontrol_chip(ctl);
+	long left = value->value.integer.value[0], right = value->value.integer.value[1];
+	unsigned int shift = ctl->private_value * 16;
+	unsigned long flags;
+	u32 volume;
+	int changed;
+
+	if (left < 0 || left > 255 || right < 0 || right > 255)
+		return -EINVAL;
+	spin_lock_irqsave(&chip->lock, flags);
+	volume = (chip->attenuation & ~(0xffffU << shift)) |
+		 ((u32)left << shift) | ((u32)right << (shift + 8));
+	changed = volume != chip->attenuation;
+	if (changed) {
+		chip->attenuation = volume;
+		rad1_write(chip, volume_control, volume);
+	}
+	spin_unlock_irqrestore(&chip->lock, flags);
+	return changed;
+}
+
+static int rad1_route_info(struct snd_kcontrol *ctl, struct snd_ctl_elem_info *info)
+{
+	static const char * const names[] = { "Optical", "Coaxial" };
+
+	if (ctl->private_value & RAD1_ROUTE_ADAT_SWITCH)
+		return snd_ctl_boolean_mono_info(ctl, info);
+	return snd_ctl_enum_info(info, 1, ARRAY_SIZE(names), names);
+}
+
+static int rad1_route_get(struct snd_kcontrol *ctl, struct snd_ctl_elem_value *value)
+{
+	struct snd_rad1 *chip = snd_kcontrol_chip(ctl);
+	unsigned long flags;
+	bool adat;
+
+	spin_lock_irqsave(&chip->lock, flags);
+	adat = rad1_adat_route(chip, !!(ctl->private_value & RAD1_ROUTE_PLAYBACK));
+	spin_unlock_irqrestore(&chip->lock, flags);
+	if (ctl->private_value & RAD1_ROUTE_ADAT_SWITCH)
+		value->value.integer.value[0] = adat;
+	else
+		value->value.enumerated.item[0] = adat;
+	return 0;
+}
+
+static int rad1_route_put(struct snd_kcontrol *ctl, struct snd_ctl_elem_value *value)
+{
+	struct snd_rad1 *chip = snd_kcontrol_chip(ctl);
+	bool playback = !!(ctl->private_value & RAD1_ROUTE_PLAYBACK);
+	long selection = ctl->private_value & RAD1_ROUTE_ADAT_SWITCH ?
+		value->value.integer.value[0] : value->value.enumerated.item[0];
+	unsigned long flags;
+	int changed;
+
+	if (selection < 0 || selection > 1)
+		return -EINVAL;
+	spin_lock_irqsave(&chip->lock, flags);
+	changed = rad1_set_route(chip, playback, selection);
+	spin_unlock_irqrestore(&chip->lock, flags);
+	if (changed > 0)
+		rad1_notify_route(chip, playback);
+	return changed;
+}
+
+static int rad1_adc_route_info(struct snd_kcontrol *ctl, struct snd_ctl_elem_info *info)
+{
+	static const char * const names[] = { "Mic", "Line" };
+
+	return snd_ctl_enum_info(info, 1, ARRAY_SIZE(names), names);
+}
+
+static int rad1_adc_route_get(struct snd_kcontrol *ctl, struct snd_ctl_elem_value *value)
+{
+	struct snd_rad1 *chip = snd_kcontrol_chip(ctl);
+	unsigned long flags;
+
+	spin_lock_irqsave(&chip->lock, flags);
+	value->value.enumerated.item[0] = chip->pipes[RAD1_ADC].control == RAD1_ADC_LINE_CONTROL;
+	spin_unlock_irqrestore(&chip->lock, flags);
+	return 0;
+}
+
+static int rad1_adc_route_put(struct snd_kcontrol *ctl, struct snd_ctl_elem_value *value)
+{
+	struct snd_rad1 *chip = snd_kcontrol_chip(ctl);
+	struct rad1_pipe *pipe = &chip->pipes[RAD1_ADC];
+	unsigned int selection = value->value.enumerated.item[0];
+	unsigned long flags;
+	u32 control;
+	int changed;
+
+	if (selection > 1)
+		return -EINVAL;
+	control = selection ? 0x05000000 : RAD1_ADC_MIC_CONTROL;
+	spin_lock_irqsave(&chip->lock, flags);
+	changed = pipe->control != control;
+	if (changed) {
+		pipe->control = control;
+		rad1_write(chip, adc_control, control | (pipe->running ? RAD1_DMA_ENABLE : 0));
+	}
+	spin_unlock_irqrestore(&chip->lock, flags);
+	return changed;
+}
+
+static const struct snd_kcontrol_new rad1_digital_controls[] = {
+	{
+		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name = "IEC958 Capture Routing",
+		.info = rad1_route_info,
+		.get = rad1_route_get,
+		.put = rad1_route_put,
+		.private_value = 0,
+	},
+	{
+		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name = "ADAT Capture Switch",
+		.info = rad1_route_info,
+		.get = rad1_route_get,
+		.put = rad1_route_put,
+		.private_value = RAD1_ROUTE_ADAT_SWITCH,
+	},
+	{
+		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name = "IEC958 Playback Routing",
+		.info = rad1_route_info,
+		.get = rad1_route_get,
+		.put = rad1_route_put,
+		.private_value = RAD1_ROUTE_PLAYBACK,
+	},
+	{
+		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name = "ADAT Playback Switch",
+		.info = rad1_route_info,
+		.get = rad1_route_get,
+		.put = rad1_route_put,
+		.private_value = RAD1_ROUTE_PLAYBACK | RAD1_ROUTE_ADAT_SWITCH,
+	},
+};
+
+static const struct snd_kcontrol_new rad1_analog_controls[] = {
+	{
+		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name = "Master Playback Volume",
+		.info = rad1_volume_info,
+		.get = rad1_volume_get,
+		.put = rad1_volume_put,
+		.private_value = 1,
+	},
+	{
+		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name = "Line Capture Volume",
+		.info = rad1_volume_info,
+		.get = rad1_volume_get,
+		.put = rad1_volume_put,
+	},
+	{
+		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name = "Line Capture Routing",
+		.info = rad1_adc_route_info,
+		.get = rad1_adc_route_get,
+		.put = rad1_adc_route_put,
+	},
+};
+
+static int rad1_add_controls(struct snd_rad1 *chip)
+{
+	unsigned int digital_count = ARRAY_SIZE(rad1_digital_controls);
+	unsigned int count = digital_count;
+	unsigned int i;
+	int err;
+
+	if (rad1_has_analog(chip))
+		count += ARRAY_SIZE(rad1_analog_controls);
+	for (i = 0; i < count; i++) {
+		const struct snd_kcontrol_new *definition;
+		struct snd_kcontrol *ctl;
+
+		definition = i < digital_count ? &rad1_digital_controls[i] :
+			&rad1_analog_controls[i - digital_count];
+		ctl = snd_ctl_new1(definition, chip);
+		err = snd_ctl_add(chip->card, ctl);
+		if (err < 0)
+			return err;
+		if (i < digital_count) {
+			bool playback = definition->private_value & RAD1_ROUTE_PLAYBACK;
+			bool adat_switch = definition->private_value & RAD1_ROUTE_ADAT_SWITCH;
+
+			chip->route_controls[playback][adat_switch] = ctl;
+		}
+	}
+	return 0;
+}
+
+static void rad1_shutdown(struct snd_rad1 *chip)
+{
+	unsigned long flags;
+	unsigned int i;
+
+	spin_lock_irqsave(&chip->lock, flags);
+	chip->shutting_down = true;
+	for (i = 0; i < ARRAY_SIZE(rad1_pcm_pipes); i++)
+		rad1_run_pipe(chip, rad1_pcm_pipes[i], false);
+	/* Stop bus mastering before ALSA releases coherent DMA buffers. */
+	rad1_write(chip, reset, 0xffffffff);
+	rad1_read(chip, reset);
+	spin_unlock_irqrestore(&chip->lock, flags);
+	timer_shutdown_sync(&chip->timer);
+	pci_clear_master(chip->pci);
+}
+
+static int rad1_dev_disconnect(struct snd_device *device)
+{
+	rad1_shutdown(device->device_data);
+	return 0;
+}
+
+static void rad1_free(struct snd_rad1 *chip)
+{
+	if (chip->mmio) {
+		rad1_shutdown(chip);
+		pci_iounmap(chip->pci, chip->mmio);
+	}
+	pci_release_regions(chip->pci);
+	pci_disable_device(chip->pci);
+	kfree(chip);
+}
+
+static int rad1_dev_free(struct snd_device *device)
+{
+	rad1_free(device->device_data);
+	return 0;
+}
+
+static int rad1_create(struct snd_card *card, struct pci_dev *pci,
+		       struct snd_rad1 **rchip)
+{
+	static const struct snd_device_ops ops = {
+		.dev_disconnect = rad1_dev_disconnect,
+		.dev_free = rad1_dev_free,
+	};
+	struct snd_rad1 *chip = NULL;
+	unsigned int revision_major = pci->revision >> 4;
+	int err;
+
+	*rchip = NULL;
+	if (revision_major != RAD1_REV_RAD && revision_major != RAD1_REV_RADICAL) {
+		dev_err(&pci->dev, "unsupported RAD revision %#x\n", pci->revision);
+		return -ENODEV;
+	}
+	err = pci_enable_device(pci);
+	if (err)
+		return err;
+	err = pci_request_regions(pci, "rad1");
+	if (err)
+		goto disable;
+	if (!(pci_resource_flags(pci, 0) & IORESOURCE_MEM) ||
+	    pci_resource_len(pci, 0) < sizeof(struct rad1_regs)) {
+		err = -ENODEV;
+		goto release;
+	}
+	err = dma_set_mask_and_coherent(&pci->dev, DMA_BIT_MASK(64));
+	if (err)
+		err = dma_set_mask_and_coherent(&pci->dev, DMA_BIT_MASK(32));
+	if (err)
+		goto release;
+	chip = kzalloc_obj(*chip);
+	if (!chip) {
+		err = -ENOMEM;
+		goto release;
+	}
+	chip->card = card;
+	chip->pci = pci;
+	chip->revision_major = revision_major;
+	spin_lock_init(&chip->lock);
+	mutex_init(&chip->timer_mutex);
+	timer_setup(&chip->timer, rad1_poll_timer, 0);
+	chip->mmio = pci_iomap(pci, 0, 0);
+	if (!chip->mmio) {
+		err = -ENOMEM;
+		goto free;
+	}
+	pci_write_config_byte(pci, PCI_LATENCY_TIMER, 64);
+	rad1_hw_init(chip);
+	pci_set_master(pci);
+	err = snd_device_new(card, SNDRV_DEV_LOWLEVEL, chip, &ops);
+	if (err)
+		goto free;
+	snd_card_set_dev(card, &pci->dev);
+	*rchip = chip;
+	return 0;
+free:
+	rad1_free(chip);
+	return err;
+release:
+	pci_release_regions(pci);
+disable:
+	pci_disable_device(pci);
+	return err;
+}
+
+static const struct pci_device_id rad1_ids[] = {
+	{ PCI_DEVICE(PCI_VENDOR_ID_SGI, PCI_DEVICE_ID_SGI_RAD1) },
+	{ }
+};
+MODULE_DEVICE_TABLE(pci, rad1_ids);
+
+static int card_index[SNDRV_CARDS] = SNDRV_DEFAULT_IDX;
+static char *id[SNDRV_CARDS] = SNDRV_DEFAULT_STR;
+static bool enable[SNDRV_CARDS] = SNDRV_DEFAULT_ENABLE_PNP;
+static unsigned int ndev;
+module_param_array_named(index, card_index, int, NULL, 0444);
+MODULE_PARM_DESC(index, "ALSA card index");
+module_param_array(id, charp, NULL, 0444);
+MODULE_PARM_DESC(id, "ALSA card ID");
+module_param_array(enable, bool, NULL, 0444);
+MODULE_PARM_DESC(enable, "Enable RAD audio card");
+
+static int rad1_probe(struct pci_dev *pci, const struct pci_device_id *pci_id)
+{
+	struct snd_card *card;
+	struct snd_rad1 *chip;
+	unsigned int slot = ndev;
+	int err;
+
+	if (slot >= SNDRV_CARDS)
+		return -ENODEV;
+	if (!enable[slot]) {
+		ndev++;
+		return -ENOENT;
+	}
+	err = snd_card_new(&pci->dev, card_index[slot], id[slot], THIS_MODULE, 0, &card);
+	if (err < 0)
+		return err;
+	err = rad1_create(card, pci, &chip);
+	if (err < 0)
+		goto fail;
+	card->private_data = chip;
+	strscpy(card->driver, "RAD1", sizeof(card->driver));
+	strscpy(card->shortname, "RAD Audio", sizeof(card->shortname));
+	snprintf(card->longname, sizeof(card->longname), "SGI RAD Audio at %pa",
+		 &pci->resource[0].start);
+	if (rad1_has_analog(chip)) {
+		err = rad1_new_pcm(chip, 0, RAD1_DAC, "RAD1 DAC");
+		if (err < 0)
+			goto fail;
+		err = rad1_new_pcm(chip, 1, RAD1_ADC, "RAD1 ADC");
+		if (err < 0)
+			goto fail;
+	}
+	err = rad1_new_pcm(chip, 2, RAD1_AESTX, "RAD1 AES Tx");
+	if (err < 0)
+		goto fail;
+	err = rad1_new_pcm(chip, 3, RAD1_AESRX, "RAD1 AES Rx");
+	if (err < 0)
+		goto fail;
+	err = rad1_new_pcm(chip, 4, RAD1_ADATTX, "RAD1 ADAT");
+	if (err < 0)
+		goto fail;
+	err = rad1_add_controls(chip);
+	if (err < 0)
+		goto fail;
+	err = snd_card_register(card);
+	if (err < 0)
+		goto fail;
+	pci_set_drvdata(pci, card);
+	ndev++;
+	return 0;
+fail:
+	if (chip)
+		rad1_shutdown(chip);
+	snd_card_free(card);
+	return err;
+}
+
+static void rad1_remove(struct pci_dev *pci)
+{
+	struct snd_card *card = pci_get_drvdata(pci);
+
+	rad1_shutdown(card->private_data);
+	snd_card_free(card);
+	pci_set_drvdata(pci, NULL);
+}
+
+static struct pci_driver rad1_driver = {
+	.name = "rad1",
+	.id_table = rad1_ids,
+	.probe = rad1_probe,
+	.remove = rad1_remove,
+};
+module_pci_driver(rad1_driver);
+
