Booting Ps3 instantly yields:

<4>SRR0 was: c0000000000971b4 should be: c0000000002d55c4
<4>SRR1 was: 8000000000008032 should be: 8000000000008032

Fix this by marking ssr regs clobbered for each lv1 call.

Signed-off-by: René Rebe <rene@exactcode.de>


--- a/arch/powerpc/include/asm/entry-common.h.vanilla	2026-11-17 16:13:42.478652499 +0100
+++ b/arch/powerpc/include/asm/entry-common.h	2026-11-17 16:13:59.299942950 +0100
@@ -42,6 +42,7 @@
 	return search_kernel_soft_mask_table(regs->nip);
 }
 
+__attribute__((always_inline))
 static inline void srr_regs_clobbered(void)
 {
 	local_paca->srr_valid = 0;
--- a/arch/powerpc/include/asm/lv1call.h.vanilla	2024-01-14 20:55:26.286402628 +0100
+++ b/arch/powerpc/include/asm/lv1call.h	2024-01-14 21:44:45.431525711 +0100
@@ -14,6 +14,7 @@
 
 #include <linux/types.h>
 #include <linux/export.h>
+#include <asm/interrupt.h>
 
 /* lv1 call declaration macros */
 
@@ -210,7 +211,7 @@
 #define LV1_CALL(name, in, out, num)                               \
   extern s64 _lv1_##name(LV1_##in##_IN_##out##_OUT_ARG_DECL);      \
   static inline int lv1_##name(LV1_##in##_IN_##out##_OUT_ARG_DECL) \
-    {return _lv1_##name(LV1_##in##_IN_##out##_OUT_ARGS);}
+    {srr_regs_clobbered(); return _lv1_##name(LV1_##in##_IN_##out##_OUT_ARGS);}
 #endif
 
 #endif /* !defined(__ASSEMBLY__) */
