 #include <linux/module.h>
 #include <linux/uaccess.h>
 
+/* Exception table entry for the instruction at the preceding local label 9 */
+#define EX(fixup)	"	.pushsection __ex_table,\"a\"\n	.align	4\n	.long	9b," #fixup "\n	.popsection\n"
+
+/*
+ * 32 bytes per iteration, the kernel pointer stays at the first byte not copied, a fault
+ * retries bytewise from there, callers need progress whenever the first byte is accessible
+ */
 unsigned long __generic_copy_from_user(void *to, const void __user *from,
 				       unsigned long n)
 {
-	unsigned long tmp, res;
+	void *end = to + n;
+	unsigned long tmp, cnt;
 
 	asm volatile ("\n"
-		"	tst.l	%0\n"
+		"	move.l	%[n],%[cnt]\n"
+		"	lsr.l	#5,%[cnt]\n"
 		"	jeq	2f\n"
-		"1:	"MOVES".l	(%1)+,%3\n"
-		"	move.l	%3,(%2)+\n"
-		"	subq.l	#1,%0\n"
+		"1:\n"
+		"9:	"MOVES".l	(%[from])+,%[tmp]\n"	EX(30f)
+		"	move.l	%[tmp],(%[to])+\n"
+		"9:	"MOVES".l	(%[from])+,%[tmp]\n"	EX(30f)
+		"	move.l	%[tmp],(%[to])+\n"
+		"9:	"MOVES".l	(%[from])+,%[tmp]\n"	EX(30f)
+		"	move.l	%[tmp],(%[to])+\n"
+		"9:	"MOVES".l	(%[from])+,%[tmp]\n"	EX(30f)
+		"	move.l	%[tmp],(%[to])+\n"
+		"9:	"MOVES".l	(%[from])+,%[tmp]\n"	EX(30f)
+		"	move.l	%[tmp],(%[to])+\n"
+		"9:	"MOVES".l	(%[from])+,%[tmp]\n"	EX(30f)
+		"	move.l	%[tmp],(%[to])+\n"
+		"9:	"MOVES".l	(%[from])+,%[tmp]\n"	EX(30f)
+		"	move.l	%[tmp],(%[to])+\n"
+		"9:	"MOVES".l	(%[from])+,%[tmp]\n"	EX(30f)
+		"	move.l	%[tmp],(%[to])+\n"
+		"	subq.l	#1,%[cnt]\n"
 		"	jne	1b\n"
-		"2:	btst	#1,%5\n"
+		"2:	moveq	#28,%[cnt]\n"
+		"	and.l	%[n],%[cnt]\n"
+		"	lsr.l	#2,%[cnt]\n"
 		"	jeq	4f\n"
-		"3:	"MOVES".w	(%1)+,%3\n"
-		"	move.w	%3,(%2)+\n"
-		"4:	btst	#0,%5\n"
-		"	jeq	6f\n"
-		"5:	"MOVES".b	(%1)+,%3\n"
-		"	move.b  %3,(%2)+\n"
-		"6:\n"
-		"	.section .fixup,\"ax\"\n"
+		"3:\n"
+		"9:	"MOVES".l	(%[from])+,%[tmp]\n"	EX(30f)
+		"	move.l	%[tmp],(%[to])+\n"
+		"	subq.l	#1,%[cnt]\n"
+		"	jne	3b\n"
+		"4:	btst	#1,%[n]\n"
+		"	jeq	5f\n"
+		"9:	"MOVES".w	(%[from])+,%[tmp]\n"	EX(30f)
+		"	move.w	%[tmp],(%[to])+\n"
+		"5:	btst	#0,%[n]\n"
+		"	jeq	7f\n"
+		"9:	"MOVES".b	(%[from])+,%[tmp]\n"	EX(30f)
+		"	move.b	%[tmp],(%[to])+\n"
+		"7:\n"
+		"	.pushsection .fixup,\"ax\"\n"
 		"	.even\n"
-		"10:	lsl.l	#2,%0\n"
-		"	btst	#1,%5\n"
-		"	jeq	8f\n"
-		"30:	addq.l	#2,%0\n"
-		"8:	btst	#0,%5\n"
-		"	jeq	6b\n"
-		"50:	addq.l	#1,%0\n"
-		"	jra	6b\n"
-		"	.previous\n"
-		"\n"
-		"	.section __ex_table,\"a\"\n"
-		"	.align	4\n"
-		"	.long	1b,10b\n"
-		"	.long	3b,30b\n"
-		"	.long	5b,50b\n"
-		"	.previous"
-		: "=d" (res), "+a" (from), "+a" (to), "=&d" (tmp)
-		: "0" (n / 4), "d" (n & 3));
+		"30:	move.l	%[to],%[from]\n"
+		"	sub.l	%[end],%[from]\n"
+		"	add.l	%[n],%[from]\n"
+		"	add.l	%[from0],%[from]\n"
+		"31:	cmp.l	%[end],%[to]\n"
+		"	jeq	7b\n"
+		"9:	"MOVES".b	(%[from])+,%[tmp]\n"	EX(7b)
+		"	move.b	%[tmp],(%[to])+\n"
+		"	jra	31b\n"
+		"	.popsection\n"
+		: [from] "+&a" (from), [to] "+&a" (to), [tmp] "=&d" (tmp), [cnt] "=&d" (cnt)
+		: [n] "d" (n), [end] "r" (end), [from0] "r" (from)
+		: "memory");
 
-	return res;
+	return end - to;
 }
 EXPORT_SYMBOL(__generic_copy_from_user);
 
