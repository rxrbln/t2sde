index 000000000000..ec4f92793b16
--- /dev/null
+++ b/drivers/video/fbdev/pdmfb.c
@@ -0,0 +1,930 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Frame buffer driver for the NuBus Power Macintosh PDM family (6100, 7100,
+ * 8100): the on-board DRAM video with monitor sense and mode setting, and
+ * the HPV (video direct slot) and AV cards in the display mode Mac OS left.
+ *
+ * Registers, monitor sense and mode tables follow MkLinux osfmk
+ * (video_pdm.c, video_hpv.c, video_av.c by Michael Burg); the mode timings
+ * and the low depth CLUT layout follow the MAME PDM/Sonora video emulation.
+ *
+ * The boot loader hands over the boot display with the BootX properties
+ * linux,bootx-{addr,width,height,depth,linebytes} on the display node: the
+ * on-board video node of the built-in device tree, or the HPV or AV card
+ * node BootX support creates by the frame buffer address.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/cleanup.h>
+#include <linux/delay.h>
+#include <linux/fb.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+
+/* on-board: CLUT DAC */
+#define DAC_ADDR		0x0
+#define DAC_DATA		0x1
+#define DAC_CTRL		0x2
+
+/* on-board: video control */
+#define VC_MODE			0x0
+#define VC_DEPTH		0x1
+#define VC_SENSE		0x2
+#define VC_MODE_BLANK		0x80	/* MAME only */
+
+#define SENSE_RESET		0x07
+#define SENSE_DRIVE_A		0x03
+#define SENSE_DRIVE_B		0x05
+#define SENSE_DRIVE_C		0x06
+
+/* HPV: 6 bit registers, the upper bits go through the overflow register */
+#define HPV_OVERFLOW		0x0f0
+#define HPV_INT_MASK		0x108
+#define HPV_INT_STATUS		0x110
+#define HPV_VBL_CLEAR		0x128
+#define HPV_CLUT_ADDR		0x207
+#define HPV_CLUT_DATA		0x237
+#define HPV_INT_VBL		0x01
+
+/* AV: control registers and CLUT */
+#define AV_VBL_STATUS		0x000
+#define AV_VBL_CLEAR		0x120
+#define AV_CLUT_ADDR		0x00
+#define AV_CLUT_DATA		0x10
+
+#define PDMFB_CLUT_SIZE		256
+#define PDMFB_VBL_TIMEOUT_US	100000
+
+enum pdm_display_type {
+	DISPLAY_NONE,
+	DISPLAY_12INCH,
+	DISPLAY_STANDARD,
+	DISPLAY_PORTRAIT,
+	DISPLAY_PORTRAIT_MONO,
+	DISPLAY_16INCH,
+	DISPLAY_19INCH,
+	DISPLAY_21INCH,
+	DISPLAY_21INCH_MONO,
+	DISPLAY_VGA,
+	DISPLAY_NTSC,
+	DISPLAY_PAL,
+	DISPLAY_MSB1,
+	DISPLAY_MSB2,
+	DISPLAY_MSB3,
+};
+
+enum pdm_screen_id {
+	SCREEN_512x384_60,
+	SCREEN_640x480_60_VGA,
+	SCREEN_640x480_67,
+	SCREEN_640x870_75,
+	SCREEN_832x624_75,
+};
+
+struct pdm_screen {
+	u8 value;		/* video mode register */
+	u8 maxdepth;
+	struct fb_videomode mode;
+};
+
+static const struct pdm_screen pdm_screens[] = {
+	[SCREEN_512x384_60] = { 0x02, 16,
+		{ "512x384-60", 60, 512, 384, 63826, 80, 16, 19, 1, 32, 3 } },
+	[SCREEN_640x480_60_VGA] = { 0x0b, 8,
+		{ "640x480-60", 60, 640, 480, 39722, 48, 16, 33, 10, 96, 2 } },
+	[SCREEN_640x480_67] = { 0x06, 16,
+		{ "640x480-67", 67, 640, 480, 31913, 112, 80, 39, 3, 64, 3 } },
+	[SCREEN_640x870_75] = { 0x01, 8,
+		{ "640x870-75", 75, 640, 870, 17457, 80, 32, 42, 3, 80, 3 } },
+	[SCREEN_832x624_75] = { 0x09, 8,
+		{ "832x624-75", 75, 832, 624, 17457, 224, 32, 39, 1, 64, 3 } },
+};
+
+/* pixel depth register value is the index, CLUT control the value */
+static const struct {
+	u8 depth;
+	u8 control;
+} pdm_depths[] = {
+	{ 1, 0x08 }, { 2, 0x09 }, { 4, 0x0a }, { 8, 0x0b }, { 16, 0x0c },
+};
+
+struct pdm_display {
+	const char *name;
+	const u8 *screens;	/* preferred first */
+	unsigned int nscreens;
+};
+
+#define PDM_SCREENS(...)					\
+	.screens = (const u8 []){ __VA_ARGS__ },		\
+	.nscreens = sizeof((const u8 []){ __VA_ARGS__ })
+
+static const struct pdm_display pdm_displays[] = {
+	[DISPLAY_NONE]		= { "no display" },
+	[DISPLAY_12INCH]	= { "12\" RGB", PDM_SCREENS(SCREEN_512x384_60) },
+	[DISPLAY_STANDARD]	= { "12\"/13\"/14\" RGB",
+				    PDM_SCREENS(SCREEN_640x480_67) },
+	[DISPLAY_PORTRAIT]	= { "15\" Portrait RGB",
+				    PDM_SCREENS(SCREEN_640x870_75) },
+	[DISPLAY_PORTRAIT_MONO]	= { "15\" Portrait Mono",
+				    PDM_SCREENS(SCREEN_640x870_75) },
+	[DISPLAY_16INCH]	= { "16\" RGB", PDM_SCREENS(SCREEN_832x624_75) },
+	[DISPLAY_19INCH]	= { "19\" RGB" },
+	[DISPLAY_21INCH]	= { "21\" RGB" },
+	[DISPLAY_21INCH_MONO]	= { "21\" Mono" },
+	[DISPLAY_VGA]		= { "VGA", PDM_SCREENS(SCREEN_640x480_60_VGA) },
+	[DISPLAY_NTSC]		= { "NTSC" },
+	[DISPLAY_PAL]		= { "PAL" },
+	[DISPLAY_MSB1]		= { "MultiScan Band-1",
+				    PDM_SCREENS(SCREEN_640x480_67,
+						SCREEN_512x384_60,
+						SCREEN_832x624_75) },
+	[DISPLAY_MSB2]		= { "MultiScan Band-2",
+				    PDM_SCREENS(SCREEN_832x624_75,
+						SCREEN_640x480_67) },
+	[DISPLAY_MSB3]		= { "MultiScan Band-3",
+				    PDM_SCREENS(SCREEN_832x624_75,
+						SCREEN_640x480_67) },
+};
+
+/* base sense code, extended sense code, display */
+static const u8 pdm_monitors[][3] = {
+	{ 0, 0x00, DISPLAY_21INCH },
+	{ 1, 0x14, DISPLAY_PORTRAIT_MONO },
+	{ 2, 0x21, DISPLAY_12INCH },
+	{ 3, 0x31, DISPLAY_21INCH },
+	{ 3, 0x34, DISPLAY_21INCH_MONO },
+	{ 3, 0x35, DISPLAY_21INCH_MONO },
+	{ 4, 0x0a, DISPLAY_NTSC },
+	{ 5, 0x1e, DISPLAY_PORTRAIT },
+	{ 6, 0x03, DISPLAY_MSB1 },
+	{ 6, 0x0b, DISPLAY_MSB2 },
+	{ 6, 0x23, DISPLAY_MSB3 },
+	{ 6, 0x2b, DISPLAY_STANDARD },
+	{ 7, 0x00, DISPLAY_PAL },
+	{ 7, 0x14, DISPLAY_NTSC },
+	{ 7, 0x17, DISPLAY_VGA },
+	{ 7, 0x2d, DISPLAY_16INCH },
+	{ 7, 0x30, DISPLAY_PAL },
+	{ 7, 0x3a, DISPLAY_19INCH },
+	{ 7, 0x3f, DISPLAY_NONE },
+};
+
+struct pdmfb_par;
+
+struct pdmfb_variant {
+	const char *name;
+	const struct fb_ops *ops;
+	unsigned int fb_index;		/* reg entry of the frame buffer */
+	int (*init)(struct pdmfb_par *par, struct platform_device *pdev);
+	/* writes the dirty CLUT range, called with the lock held */
+	void (*load_clut)(struct pdmfb_par *par);
+};
+
+struct pdmfb_par {
+	const struct pdmfb_variant *variant;
+	struct device *dev;
+	void __iomem *regs;
+	void __iomem *clut;
+	spinlock_t lock;
+	u8 cmap[PDMFB_CLUT_SIZE][3];
+	unsigned int dirty_lo, dirty_hi;
+	int irq;		/* on-board VBL, CLUT loaded in its handler */
+	struct fb_var_screeninfo boot_var;
+	u32 boot_linebytes;
+	bool has_boot_var;
+	/* on-board */
+	const struct pdm_display *display;
+	struct fb_videomode *modedb;
+	unsigned int modedb_len;
+	u8 mode_value, depth_index;
+	bool blanked;
+	u32 pseudo_palette[16];
+};
+
+static void pdmfb_set_format(struct fb_var_screeninfo *var, unsigned int bpp)
+{
+	var->bits_per_pixel = bpp;
+	var->transp.offset = var->transp.length = 0;
+	if (bpp <= 8) {
+		var->red.offset = var->green.offset = var->blue.offset = 0;
+		var->red.length = var->green.length = var->blue.length = bpp;
+	} else if (bpp == 16) {
+		/* x1r5g5b5 */
+		var->red.offset = 10;
+		var->green.offset = 5;
+		var->blue.offset = 0;
+		var->red.length = var->green.length = var->blue.length = 5;
+	} else {
+		/* x8r8g8b8 */
+		var->red.offset = 16;
+		var->green.offset = 8;
+		var->blue.offset = 0;
+		var->red.length = var->green.length = var->blue.length = 8;
+	}
+	var->red.msb_right = var->green.msb_right = var->blue.msb_right = 0;
+}
+
+static void pdmfb_update_fix(struct fb_info *info, u32 line_length)
+{
+	info->fix.visual = info->var.bits_per_pixel <= 8 ?
+			   FB_VISUAL_PSEUDOCOLOR : FB_VISUAL_TRUECOLOR;
+	info->fix.line_length = line_length;
+}
+
+/* boot display as BootX describes it on the display node */
+static bool pdmfb_get_boot_display(struct device_node *np, u32 *addr,
+				   struct fb_var_screeninfo *var,
+				   u32 *linebytes)
+{
+	u32 width, height, depth;
+
+	if (of_property_read_u32(np, "linux,bootx-addr", addr) ||
+	    of_property_read_u32(np, "linux,bootx-width", &width) ||
+	    of_property_read_u32(np, "linux,bootx-height", &height) ||
+	    of_property_read_u32(np, "linux,bootx-depth", &depth) ||
+	    of_property_read_u32(np, "linux,bootx-linebytes", linebytes))
+		return false;
+
+	if (depth == 15)
+		depth = 16;
+	if (!width || !height || *linebytes < width * depth / 8 ||
+	    !(depth == 1 || depth == 2 || depth == 4 || depth == 8 ||
+	      depth == 16 || depth == 32)) {
+		pr_warn("%pOF: invalid boot display %ux%u-%u, %u bytes per line\n",
+			np, width, height, depth, *linebytes);
+		return false;
+	}
+
+	memset(var, 0, sizeof(*var));
+	var->xres = var->xres_virtual = width;
+	var->yres = var->yres_virtual = height;
+	var->height = var->width = -1;
+	var->vmode = FB_VMODE_NONINTERLACED;
+	pdmfb_set_format(var, depth);
+	return true;
+}
+
+/* the CLUT index of a color register, low depths use the top CLUT bits */
+static unsigned int pdmfb_clut_index(struct fb_info *info, unsigned int regno)
+{
+	unsigned int bpp = info->var.bits_per_pixel;
+
+	return bpp < 8 ? (regno << (8 - bpp)) | (0xff >> bpp) : regno;
+}
+
+static void pdmfb_flush(struct pdmfb_par *par)
+{
+	if (par->dirty_lo > par->dirty_hi || par->irq > 0)
+		return;
+	par->variant->load_clut(par);
+}
+
+static void pdmfb_store(struct pdmfb_par *par, unsigned int index,
+			u16 red, u16 green, u16 blue)
+{
+	par->cmap[index][0] = red >> 8;
+	par->cmap[index][1] = green >> 8;
+	par->cmap[index][2] = blue >> 8;
+	par->dirty_lo = min(par->dirty_lo, index);
+	par->dirty_hi = max(par->dirty_hi, index);
+}
+
+static void pdmfb_clean(struct pdmfb_par *par)
+{
+	par->dirty_lo = PDMFB_CLUT_SIZE;
+	par->dirty_hi = 0;
+}
+
+static int pdmfb_setcolreg(unsigned int regno, unsigned int red,
+			   unsigned int green, unsigned int blue,
+			   unsigned int transp, struct fb_info *info)
+{
+	struct pdmfb_par *par = info->par;
+	struct fb_var_screeninfo *var = &info->var;
+	unsigned long flags;
+
+	if (info->fix.visual == FB_VISUAL_TRUECOLOR) {
+		if (regno >= 16)
+			return -EINVAL;
+		par->pseudo_palette[regno] =
+			(red >> (16 - var->red.length)) << var->red.offset |
+			(green >> (16 - var->green.length)) << var->green.offset |
+			(blue >> (16 - var->blue.length)) << var->blue.offset;
+		return 0;
+	}
+
+	if (regno >= 1U << var->bits_per_pixel)
+		return -EINVAL;
+
+	spin_lock_irqsave(&par->lock, flags);
+	pdmfb_store(par, pdmfb_clut_index(info, regno), red, green, blue);
+	pdmfb_flush(par);
+	spin_unlock_irqrestore(&par->lock, flags);
+	return 0;
+}
+
+static int pdmfb_setcmap(struct fb_cmap *cmap, struct fb_info *info)
+{
+	struct pdmfb_par *par = info->par;
+	unsigned int i, regno;
+	unsigned long flags;
+
+	if (info->fix.visual == FB_VISUAL_TRUECOLOR) {
+		for (i = 0; i < cmap->len && cmap->start + i < 16; i++)
+			pdmfb_setcolreg(cmap->start + i, cmap->red[i],
+					cmap->green[i], cmap->blue[i], 0, info);
+		return 0;
+	}
+
+	/* a whole palette is written in one vertical blank */
+	spin_lock_irqsave(&par->lock, flags);
+	for (i = 0; i < cmap->len; i++) {
+		regno = cmap->start + i;
+		if (regno >= 1U << info->var.bits_per_pixel)
+			break;
+		pdmfb_store(par, pdmfb_clut_index(info, regno), cmap->red[i],
+			    cmap->green[i], cmap->blue[i]);
+	}
+	pdmfb_flush(par);
+	spin_unlock_irqrestore(&par->lock, flags);
+	return 0;
+}
+
+/* only the display mode the boot loader handed over */
+static int pdmfb_boot_check_var(struct fb_var_screeninfo *var,
+				struct fb_info *info)
+{
+	struct pdmfb_par *par = info->par;
+	u32 activate = var->activate;
+
+	if (!par->has_boot_var || var->xres > par->boot_var.xres ||
+	    var->yres > par->boot_var.yres ||
+	    var->bits_per_pixel > par->boot_var.bits_per_pixel)
+		return -EINVAL;
+
+	*var = par->boot_var;
+	var->activate = activate;
+	return 0;
+}
+
+/* on-board video */
+
+static u8 pdm_sense_line(struct pdmfb_par *par, u8 drive)
+{
+	out_8(par->regs + VC_SENSE, drive);
+	udelay(3);
+	return (in_8(par->regs + VC_SENSE) >> 4) & 7;
+}
+
+static const struct pdm_display *pdm_sense_monitor(struct pdmfb_par *par)
+{
+	u8 sense, a, b, c, ext;
+	unsigned int i;
+
+	sense = pdm_sense_line(par, SENSE_RESET);
+	a = pdm_sense_line(par, SENSE_DRIVE_A);
+	b = pdm_sense_line(par, SENSE_DRIVE_B);
+	c = pdm_sense_line(par, SENSE_DRIVE_C);
+	pdm_sense_line(par, SENSE_RESET);
+
+	ext = ((a << 4) & 0x30) | ((b >> 2) << 3) | ((b & 1) << 2) |
+	      ((c >> 1) & 3);
+
+	for (i = 0; i < ARRAY_SIZE(pdm_monitors); i++)
+		if (pdm_monitors[i][0] == sense && pdm_monitors[i][1] == ext) {
+			dev_info(par->dev, "monitor sense %u/0x%02x: %s\n",
+				 sense, ext,
+				 pdm_displays[pdm_monitors[i][2]].name);
+			return &pdm_displays[pdm_monitors[i][2]];
+		}
+
+	dev_info(par->dev, "unknown monitor sense %u/0x%02x\n", sense, ext);
+	return NULL;
+}
+
+static int pdm_depth_index(unsigned int bpp)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(pdm_depths); i++)
+		if (pdm_depths[i].depth == bpp)
+			return i;
+	return -EINVAL;
+}
+
+/* a mode the controller can set for the sensed monitor */
+static const struct pdm_screen *pdm_screen_for_var(struct pdmfb_par *par,
+						   unsigned int xres,
+						   unsigned int yres,
+						   unsigned int bpp)
+{
+	const struct pdm_screen *s;
+	unsigned int i;
+
+	if (!par->display)
+		return NULL;
+	for (i = 0; i < par->display->nscreens; i++) {
+		s = &pdm_screens[par->display->screens[i]];
+		if (s->mode.xres == xres && s->mode.yres == yres &&
+		    bpp <= s->maxdepth)
+			return s;
+	}
+	return NULL;
+}
+
+static int pdmfb_onboard_check_var(struct fb_var_screeninfo *var,
+				   struct fb_info *info)
+{
+	struct pdmfb_par *par = info->par;
+	const struct pdm_screen *s;
+	unsigned int bpp;
+
+	bpp = var->bits_per_pixel;
+	bpp = bpp <= 1 ? 1 : bpp <= 2 ? 2 : bpp <= 4 ? 4 : bpp <= 8 ? 8 : 16;
+	s = pdm_screen_for_var(par, var->xres, var->yres, bpp);
+	if (!s || var->bits_per_pixel > 16 ||
+	    s->mode.xres * s->mode.yres * bpp / 8 > info->fix.smem_len)
+		return pdmfb_boot_check_var(var, info);
+
+	fb_videomode_to_var(var, &s->mode);
+	var->xoffset = var->yoffset = 0;
+	var->height = var->width = -1;
+	pdmfb_set_format(var, bpp);
+	return 0;
+}
+
+static void pdm_write_mode(struct pdmfb_par *par)
+{
+	out_8(par->regs + VC_MODE,
+	      par->mode_value | (par->blanked ? VC_MODE_BLANK : 0));
+}
+
+static int pdmfb_onboard_set_par(struct fb_info *info)
+{
+	struct pdmfb_par *par = info->par;
+	const struct pdm_screen *s;
+	unsigned long flags;
+	int index;
+
+	s = pdm_screen_for_var(par, info->var.xres, info->var.yres,
+			       info->var.bits_per_pixel);
+	index = pdm_depth_index(info->var.bits_per_pixel);
+
+	if (s && index >= 0) {
+		if (s->value != par->mode_value || index != par->depth_index) {
+			/* a boot mode we cannot set is gone from now on */
+			par->has_boot_var = false;
+			par->mode_value = s->value;
+			par->depth_index = index;
+			pdm_write_mode(par);
+			out_8(par->regs + VC_DEPTH, index);
+			udelay(2);
+			out_8(par->clut + DAC_CTRL, pdm_depths[index].control);
+			dev_dbg(par->dev, "mode %s, %u bpp\n", s->mode.name,
+				info->var.bits_per_pixel);
+		}
+		/* no line pitch register, lines are packed */
+		pdmfb_update_fix(info, info->var.xres *
+					info->var.bits_per_pixel / 8);
+	} else {
+		pdmfb_update_fix(info, par->boot_linebytes);
+	}
+
+	/* the CLUT index layout depends on the depth, 16 bpp leaves it alone */
+	if (info->fix.visual != FB_VISUAL_PSEUDOCOLOR)
+		return 0;
+	spin_lock_irqsave(&par->lock, flags);
+	par->dirty_lo = 0;
+	par->dirty_hi = PDMFB_CLUT_SIZE - 1;
+	pdmfb_flush(par);
+	spin_unlock_irqrestore(&par->lock, flags);
+	return 0;
+}
+
+static int pdmfb_onboard_blank(int blank, struct fb_info *info)
+{
+	struct pdmfb_par *par = info->par;
+
+	par->blanked = blank != FB_BLANK_UNBLANK;
+	if (par->mode_value != 0xff)
+		pdm_write_mode(par);
+	return 0;
+}
+
+static void pdm_load_clut(struct pdmfb_par *par)
+{
+	unsigned int i;
+
+	out_8(par->clut + DAC_ADDR, par->dirty_lo);
+	ndelay(260);
+	for (i = par->dirty_lo; i <= par->dirty_hi; i++) {
+		out_8(par->clut + DAC_DATA, par->cmap[i][0]);
+		out_8(par->clut + DAC_DATA, par->cmap[i][1]);
+		out_8(par->clut + DAC_DATA, par->cmap[i][2]);
+		ndelay(260);
+	}
+	pdmfb_clean(par);
+}
+
+static irqreturn_t pdmfb_vbl_irq(int irq, void *data)
+{
+	struct pdmfb_par *par = data;
+
+	spin_lock(&par->lock);
+	if (par->dirty_lo <= par->dirty_hi)
+		pdm_load_clut(par);
+	spin_unlock(&par->lock);
+	return IRQ_HANDLED;
+}
+
+static int pdm_init(struct pdmfb_par *par, struct platform_device *pdev)
+{
+	par->clut = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(par->clut))
+		return PTR_ERR(par->clut);
+	par->regs = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(par->regs))
+		return PTR_ERR(par->regs);
+
+	par->display = pdm_sense_monitor(par);
+	if (par->display && !par->display->nscreens)
+		par->display = NULL;
+	return 0;
+}
+
+/* the active mode as the video controller reports it */
+static bool pdm_get_hw_mode(struct pdmfb_par *par,
+			    struct fb_var_screeninfo *var)
+{
+	u8 value = in_8(par->regs + VC_MODE);
+	u8 control = in_8(par->clut + DAC_CTRL) & 0x7f;
+	const struct pdm_screen *s = NULL;
+	unsigned int i;
+	int index = -1;
+
+	for (i = 0; i < ARRAY_SIZE(pdm_screens); i++)
+		if (pdm_screens[i].value == value)
+			s = &pdm_screens[i];
+	for (i = 0; i < ARRAY_SIZE(pdm_depths); i++)
+		if (pdm_depths[i].control == control)
+			index = i;
+	if (!s || index < 0)
+		return false;
+
+	par->mode_value = value;
+	par->depth_index = index;
+	memset(var, 0, sizeof(*var));
+	fb_videomode_to_var(var, &s->mode);
+	var->height = var->width = -1;
+	pdmfb_set_format(var, pdm_depths[index].depth);
+	return true;
+}
+
+/* HPV */
+
+static void hpv_writereg(struct pdmfb_par *par, unsigned int reg, u16 value)
+{
+	out_8(par->regs + HPV_OVERFLOW, (value >> 6) & 0x3f);
+	out_8(par->regs + reg, value & 0x3f);
+}
+
+static u16 hpv_readreg(struct pdmfb_par *par, unsigned int reg)
+{
+	u16 value = in_8(par->regs + reg);
+
+	return value | in_8(par->regs + HPV_OVERFLOW) << 6;
+}
+
+static void hpv_load_clut(struct pdmfb_par *par)
+{
+	unsigned int i;
+	u16 status;
+
+	hpv_writereg(par, HPV_INT_MASK, HPV_INT_VBL);
+	in_8(par->regs + HPV_VBL_CLEAR);
+	if (read_poll_timeout_atomic(hpv_readreg, status,
+				     status & HPV_INT_VBL, 1,
+				     PDMFB_VBL_TIMEOUT_US, false,
+				     par, HPV_INT_STATUS))
+		dev_warn_once(par->dev, "no vertical blank\n");
+	hpv_writereg(par, HPV_INT_MASK, 0);
+
+	out_8(par->regs + HPV_CLUT_ADDR, par->dirty_lo);
+	for (i = par->dirty_lo; i <= par->dirty_hi; i++) {
+		out_8(par->regs + HPV_CLUT_DATA, par->cmap[i][0]);
+		out_8(par->regs + HPV_CLUT_DATA, par->cmap[i][1]);
+		out_8(par->regs + HPV_CLUT_DATA, par->cmap[i][2]);
+	}
+	pdmfb_clean(par);
+}
+
+static int hpv_init(struct pdmfb_par *par, struct platform_device *pdev)
+{
+	par->regs = devm_platform_ioremap_resource(pdev, 0);
+	return PTR_ERR_OR_ZERO(par->regs);
+}
+
+/* AV */
+
+static u8 av_vbl_status(struct pdmfb_par *par)
+{
+	return in_8(par->regs + AV_VBL_STATUS) & 1;
+}
+
+static void av_load_clut(struct pdmfb_par *par)
+{
+	unsigned int i;
+	u8 status;
+
+	out_8(par->regs + AV_VBL_CLEAR, 0);
+	out_8(par->regs + AV_VBL_CLEAR, 1);
+	if (read_poll_timeout_atomic(av_vbl_status, status, status, 1,
+				     PDMFB_VBL_TIMEOUT_US, false, par))
+		dev_warn_once(par->dev, "no vertical blank\n");
+
+	for (i = par->dirty_lo; i <= par->dirty_hi; i++) {
+		ndelay(260);
+		out_8(par->clut + AV_CLUT_ADDR, i);
+		out_8(par->clut + AV_CLUT_DATA, par->cmap[i][0]);
+		out_8(par->clut + AV_CLUT_DATA, par->cmap[i][1]);
+		out_8(par->clut + AV_CLUT_DATA, par->cmap[i][2]);
+		out_8(par->clut + AV_CLUT_DATA, 0);
+	}
+	pdmfb_clean(par);
+}
+
+static int av_init(struct pdmfb_par *par, struct platform_device *pdev)
+{
+	par->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(par->regs))
+		return PTR_ERR(par->regs);
+	par->clut = devm_platform_ioremap_resource(pdev, 1);
+	return PTR_ERR_OR_ZERO(par->clut);
+}
+
+static const struct fb_ops pdmfb_onboard_ops = {
+	.owner		= THIS_MODULE,
+	FB_DEFAULT_IOMEM_OPS,
+	.fb_check_var	= pdmfb_onboard_check_var,
+	.fb_set_par	= pdmfb_onboard_set_par,
+	.fb_setcolreg	= pdmfb_setcolreg,
+	.fb_setcmap	= pdmfb_setcmap,
+	.fb_blank	= pdmfb_onboard_blank,
+};
+
+static const struct fb_ops pdmfb_card_ops = {
+	.owner		= THIS_MODULE,
+	FB_DEFAULT_IOMEM_OPS,
+	.fb_check_var	= pdmfb_boot_check_var,
+	.fb_setcolreg	= pdmfb_setcolreg,
+	.fb_setcmap	= pdmfb_setcmap,
+};
+
+static const struct pdmfb_variant pdmfb_onboard = {
+	.name		= "PDM on-board",
+	.ops		= &pdmfb_onboard_ops,
+	.fb_index	= 2,
+	.init		= pdm_init,
+	.load_clut	= pdm_load_clut,
+};
+
+static const struct pdmfb_variant pdmfb_hpv = {
+	.name		= "PDM HPV",
+	.ops		= &pdmfb_card_ops,
+	.fb_index	= 1,
+	.init		= hpv_init,
+	.load_clut	= hpv_load_clut,
+};
+
+static const struct pdmfb_variant pdmfb_av = {
+	.name		= "PDM AV",
+	.ops		= &pdmfb_card_ops,
+	.fb_index	= 2,
+	.init		= av_init,
+	.load_clut	= av_load_clut,
+};
+
+static void pdmfb_release(void *data)
+{
+	framebuffer_release(data);
+}
+
+static void pdmfb_iounmap(void *data)
+{
+	iounmap((void __iomem *)data);
+}
+
+static int pdmfb_onboard_setup(struct fb_info *info, bool boot,
+			       const char *option)
+{
+	struct pdmfb_par *par = info->par;
+	struct fb_var_screeninfo var;
+	unsigned int i;
+	bool set_mode;
+	int ret;
+
+	par->mode_value = 0xff;
+	par->depth_index = 0xff;
+
+	if (par->display) {
+		par->modedb_len = par->display->nscreens;
+		par->modedb = devm_kcalloc(par->dev, par->modedb_len,
+					   sizeof(*par->modedb), GFP_KERNEL);
+		if (!par->modedb)
+			return -ENOMEM;
+		for (i = 0; i < par->modedb_len; i++)
+			par->modedb[i] =
+				pdm_screens[par->display->screens[i]].mode;
+		fb_videomode_to_modelist(par->modedb, par->modedb_len,
+					 &info->modelist);
+	}
+
+	if (pdm_get_hw_mode(par, &var) && !boot) {
+		par->boot_var = var;
+		par->boot_linebytes = var.xres * var.bits_per_pixel / 8;
+		par->has_boot_var = true;
+	}
+
+	set_mode = !par->has_boot_var || (option && *option);
+	if (set_mode) {
+		if (!par->modedb_len) {
+			dev_info(par->dev, "no supported monitor\n");
+			return -ENODEV;
+		}
+		if (!fb_find_mode(&var, info, option, par->modedb,
+				  par->modedb_len, NULL, 8))
+			return -EINVAL;
+	} else {
+		var = par->boot_var;
+	}
+
+	ret = info->fbops->fb_check_var(&var, info);
+	if (ret)
+		return ret;
+	info->var = var;
+	ret = pdmfb_onboard_set_par(info);
+	if (ret)
+		return ret;
+	if (set_mode)
+		fb_memset_io(info->screen_base, 0, info->fix.smem_len);
+	return 0;
+}
+
+static int pdmfb_probe(struct platform_device *pdev)
+{
+	const struct pdmfb_variant *variant;
+	struct device *dev = &pdev->dev;
+	struct fb_var_screeninfo boot_var;
+	u32 boot_addr, boot_linebytes;
+	struct pdmfb_par *par;
+	struct fb_info *info;
+	struct resource *fb;
+	char *option __free(kfree) = NULL;
+	bool boot;
+	int ret;
+
+	if (fb_get_options("pdmfb", &option))
+		return -ENODEV;
+
+	variant = device_get_match_data(dev);
+	fb = platform_get_resource(pdev, IORESOURCE_MEM, variant->fb_index);
+	if (!fb)
+		return -EINVAL;
+
+	boot = pdmfb_get_boot_display(dev->of_node, &boot_addr, &boot_var,
+				      &boot_linebytes);
+	if (boot && (boot_addr != fb->start ||
+		     boot_linebytes * boot_var.yres > resource_size(fb) ||
+		     (variant == &pdmfb_onboard &&
+		      boot_var.bits_per_pixel > 16))) {
+		dev_warn(dev, "ignoring boot display at 0x%08x\n", boot_addr);
+		boot = false;
+	}
+	if (!boot && variant != &pdmfb_onboard)
+		return -ENODEV;
+
+	info = framebuffer_alloc(sizeof(*par), dev);
+	if (!info)
+		return -ENOMEM;
+	ret = devm_add_action_or_reset(dev, pdmfb_release, info);
+	if (ret)
+		return ret;
+
+	par = info->par;
+	par->variant = variant;
+	par->dev = dev;
+	spin_lock_init(&par->lock);
+	pdmfb_clean(par);
+	if (boot) {
+		par->boot_var = boot_var;
+		par->boot_linebytes = boot_linebytes;
+		par->has_boot_var = true;
+	}
+
+	ret = variant->init(par, pdev);
+	if (ret)
+		return ret;
+
+	/* write-through: the video fetch reads memory, the CPU reads cached */
+	info->screen_base = ioremap_wt(fb->start, resource_size(fb));
+	if (!info->screen_base) {
+		dev_err(dev, "cannot map frame buffer %pR\n", fb);
+		return -ENOMEM;
+	}
+	ret = devm_add_action_or_reset(dev, pdmfb_iounmap,
+				       (void __force *)info->screen_base);
+	if (ret)
+		return ret;
+
+	strscpy(info->fix.id, variant->name, sizeof(info->fix.id));
+	info->fix.type = FB_TYPE_PACKED_PIXELS;
+	info->fix.accel = FB_ACCEL_NONE;
+	info->fix.smem_start = fb->start;
+	info->fix.smem_len = resource_size(fb);
+	info->fbops = variant->ops;
+	info->pseudo_palette = par->pseudo_palette;
+	INIT_LIST_HEAD(&info->modelist);
+
+	ret = fb_alloc_cmap(&info->cmap, PDMFB_CLUT_SIZE, 0);
+	if (ret)
+		return ret;
+
+	if (variant == &pdmfb_onboard) {
+		par->irq = platform_get_irq_optional(pdev, 0);
+		if (par->irq > 0) {
+			ret = devm_request_irq(dev, par->irq, pdmfb_vbl_irq, 0,
+					       "pdmfb VBL", par);
+			if (ret)
+				goto err_cmap;
+		}
+
+		ret = pdmfb_onboard_setup(info, boot, option);
+		if (ret)
+			goto err_cmap;
+	} else {
+		if (boot_var.bits_per_pixel < 8) {
+			dev_err(dev, "unsupported depth %u\n",
+				boot_var.bits_per_pixel);
+			ret = -EINVAL;
+			goto err_cmap;
+		}
+		info->var = boot_var;
+		pdmfb_update_fix(info, boot_linebytes);
+	}
+
+	ret = fb_set_cmap(&info->cmap, info);
+	if (ret)
+		goto err_cmap;
+
+	ret = register_framebuffer(info);
+	if (ret)
+		goto err_cmap;
+
+	platform_set_drvdata(pdev, info);
+	fb_info(info, "%s, %ux%u-%u at %pa%s\n", variant->name,
+		info->var.xres, info->var.yres, info->var.bits_per_pixel,
+		&info->fix.smem_start, boot ? " (boot display)" : "");
+	return 0;
+
+err_cmap:
+	fb_destroy_modelist(&info->modelist);
+	fb_dealloc_cmap(&info->cmap);
+	return ret;
+}
+
+static void pdmfb_remove(struct platform_device *pdev)
+{
+	struct fb_info *info = platform_get_drvdata(pdev);
+
+	unregister_framebuffer(info);
+	fb_dealloc_cmap(&info->cmap);
+}
+
+static const struct of_device_id pdmfb_of_match[] = {
+	{ .compatible = "apple,pdm-video", .data = &pdmfb_onboard },
+	{ .compatible = "apple,pdm-hpv", .data = &pdmfb_hpv },
+	{ .compatible = "apple,pdm-av", .data = &pdmfb_av },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, pdmfb_of_match);
+
+static struct platform_driver pdmfb_driver = {
+	.driver = {
+		.name = "pdmfb",
+		.of_match_table = pdmfb_of_match,
+	},
+	.probe = pdmfb_probe,
+	.remove = pdmfb_remove,
+};
+module_platform_driver(pdmfb_driver);
+
+MODULE_AUTHOR("René Rebe <rene@exactco.de>");
+MODULE_DESCRIPTION("NuBus Power Macintosh PDM frame buffer driver");
+MODULE_LICENSE("GPL");
