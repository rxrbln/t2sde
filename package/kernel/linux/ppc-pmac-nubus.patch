+	for (i = 1; i < acells; i++)
+		dt_push_token(0, mem_end);
+	dt_push_token(addr, mem_end);
+	for (i = 1; i < scells; i++)
+		dt_push_token(0, mem_end);
+	dt_push_token(size, mem_end);
