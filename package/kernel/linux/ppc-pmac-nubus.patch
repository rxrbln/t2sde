diff --git a/sound/ppc/amic_awacs.c b/sound/ppc/amic_awacs.c
new file mode 100644
index 000000000000..fb1c4eb4859c
--- /dev/null
+++ b/sound/ppc/amic_awacs.c
@@ -0,0 +1,843 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * AWACS sound of the PDM Power Macintosh (6100, 7100, 8100).
+ *
+ * The PDM AWACS has byte wide registers and transfers its samples to and
+ * from fixed buffers in the AMIC DMA area: output from two halves at
+ * 0x10000/0x12000, input to 0xc000/0xe000.  It plays or records one half
+ * while the other one is refilled and interrupts for every finished half.
+ * Both directions share the half size and the sample rate.  The driver
+ * copies whole ALSA periods between the ALSA buffer and the halves.
+ * Register usage follows MkLinux (osfmk awacs_pdm.c, awacs_pdm_hw.h) and
+ * MAME (awacs.cpp, macpdm.cpp); the codec registers are those of awacs.h.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/iopoll.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+#include <linux/workqueue.h>
+
+#include <sound/control.h>
+#include <sound/core.h>
+#include <sound/initval.h>
+#include <sound/pcm.h>
+
+#include <asm/amic_dma.h>
+#include <asm/io.h>
+
+#include "awacs.h"
+
+#define DRV_NAME		"amic-awacs"
+
+#define AW_CODEC_CTRL		0x00	/* 3 bytes: command, address/data */
+#define AW_CODEC_STAT		0x04	/* 3 bytes */
+#define AW_BUF_SIZE		0x08	/* 2 bytes, frames per half */
+#define AW_SOUND_CTRL		0x10	/* 2 bytes */
+#define AW_DMA_IN		0x14
+#define AW_DMA_OUT		0x18
+
+/* first codec control byte, the expand bit reads back set while busy */
+#define CODEC_EXPAND		0x80
+#define CODEC_COMMAND		0x40
+
+/* sound control: rate and output enable in the first byte */
+#define SC_OUT_ENABLE		0x01
+#define SC_RATE_SHIFT		1
+#define SC_RATE_MASK		(3 << SC_RATE_SHIFT)
+/* second byte: subframes; record enable as emulated by MAME */
+#define SC_IN_ENABLE		0x80
+#define SC_OUT_SUBFRAME0	0x04
+#define SC_IN_SUBFRAME0		0x00
+
+/* DMA in/out control: write 1 to clear the flags, enables are plain bits */
+#define DMA_IF1			0x80
+#define DMA_IF0			0x40
+#define DMA_FLAGS		0xf0
+#define DMA_IE_HALVES		0x0c
+
+#define BUF_SIZE_MAX		0x7fc	/* frames, multiple of 4 */
+#define FRAME_BYTES		4
+#define SENSE_POLL		(HZ / 2)
+
+#define AWACS_REGS		5
+#define DEFAULT_GAIN		0xbb
+#define DEFAULT_ATTEN		6
+
+static int index = SNDRV_DEFAULT_IDX1;
+static char *id = SNDRV_DEFAULT_STR1;
+module_param(index, int, 0444);
+MODULE_PARM_DESC(index, "Index value for the PDM AWACS.");
+module_param(id, charp, 0444);
+MODULE_PARM_DESC(id, "ID string for the PDM AWACS.");
+
+static const unsigned int awacs_rates[] = { 22050, 29400, 44100 };
+
+static const struct snd_pcm_hw_constraint_list awacs_rate_list = {
+	.count	= ARRAY_SIZE(awacs_rates),
+	.list	= awacs_rates,
+};
+
+struct amic_awacs;
+
+struct awacs_stream {
+	struct amic_awacs *chip;
+	struct snd_pcm_substream *substream;
+	struct amic_dma_buf buf;
+	void __iomem *half[2];
+	unsigned int dma_reg;
+	int irq;
+	unsigned int rate;	/* set while hw_params are in effect */
+	unsigned int period_frames;
+	ktime_t idle;		/* the hardware is done with the last half */
+	/* below protected by the PCM stream lock */
+	bool running;			/* also under the chip lock */
+	unsigned int next;		/* half the hardware finishes next */
+	bool queued[2];			/* half holds a period to play */
+	snd_pcm_uframes_t hw_off;	/* frames done by the hardware */
+	snd_pcm_uframes_t fill_ptr;	/* next frame to copy, as appl_ptr */
+};
+
+struct amic_awacs {
+	struct snd_card *card;
+	void __iomem *regs;
+	spinlock_t lock;	/* sound control, stream parameters */
+	struct awacs_stream stream[2];
+	u8 sc[2];
+
+	struct mutex codec_lock;	/* codec registers and their copy */
+	u16 codec[AWACS_REGS];
+	bool auto_mute;
+	int sense;
+	struct snd_kcontrol *master_sw;
+	struct snd_kcontrol *speaker_sw;
+	struct delayed_work sense_work;
+};
+
+static void awacs_write_sc(struct amic_awacs *chip)
+{
+	out_8(chip->regs + AW_SOUND_CTRL, chip->sc[0]);
+	out_8(chip->regs + AW_SOUND_CTRL + 1, chip->sc[1]);
+}
+
+static void awacs_codec_write(struct amic_awacs *chip, int reg, u16 val)
+{
+	u16 cmd = (reg << 12) | (val & MASK_EXMODEDATA);
+	u8 busy;
+
+	lockdep_assert_held(&chip->codec_lock);
+	chip->codec[reg] = val;
+	out_8(chip->regs + AW_CODEC_CTRL, CODEC_EXPAND | CODEC_COMMAND);
+	out_8(chip->regs + AW_CODEC_CTRL + 1, cmd >> 8);
+	out_8(chip->regs + AW_CODEC_CTRL + 2, cmd & 0xff);
+	/* MkLinux waits for the busy bit, a command takes one sample frame */
+	if (readx_poll_timeout_atomic(in_8, chip->regs + AW_CODEC_CTRL, busy,
+				      !(busy & CODEC_EXPAND), 1, 1000))
+		dev_warn_once(chip->card->dev, "codec command not taken\n");
+}
+
+static void awacs_codec_update(struct amic_awacs *chip, int reg, u16 mask,
+			       u16 val)
+{
+	val = (chip->codec[reg] & ~mask) | (val & mask);
+	if (val != chip->codec[reg])
+		awacs_codec_write(chip, reg, val);
+}
+
+/* like MkLinux, mute the speaker while headphones are plugged in */
+static bool awacs_apply_sense(struct amic_awacs *chip)
+{
+	u16 old = chip->codec[1];
+	int hp;
+
+	lockdep_assert_held(&chip->codec_lock);
+	hp = !!(in_8(chip->regs + AW_CODEC_STAT + 2) & MASK_HDPCONN);
+	if (hp == chip->sense)
+		return false;
+	chip->sense = hp;
+	awacs_codec_update(chip, 1, MASK_AMUTE | MASK_CMUTE,
+			   hp ? MASK_CMUTE : MASK_AMUTE);
+	return chip->codec[1] != old;
+}
+
+static void awacs_sense_work(struct work_struct *work)
+{
+	struct amic_awacs *chip = container_of(work, struct amic_awacs,
+					       sense_work.work);
+	bool changed = false;
+
+	scoped_guard(mutex, &chip->codec_lock) {
+		if (!chip->auto_mute)
+			return;
+		changed = awacs_apply_sense(chip);
+	}
+	if (changed) {
+		snd_ctl_notify(chip->card, SNDRV_CTL_EVENT_MASK_VALUE,
+			       &chip->master_sw->id);
+		snd_ctl_notify(chip->card, SNDRV_CTL_EVENT_MASK_VALUE,
+			       &chip->speaker_sw->id);
+	}
+	schedule_delayed_work(&chip->sense_work, SENSE_POLL);
+}
+
+/* PCM */
+
+static const struct snd_pcm_hardware awacs_pcm_hw = {
+	.info			= SNDRV_PCM_INFO_MMAP |
+				  SNDRV_PCM_INFO_MMAP_VALID |
+				  SNDRV_PCM_INFO_INTERLEAVED |
+				  SNDRV_PCM_INFO_BLOCK_TRANSFER |
+				  SNDRV_PCM_INFO_BATCH |
+				  SNDRV_PCM_INFO_SYNC_APPLPTR,
+	.formats		= SNDRV_PCM_FMTBIT_S16_BE,
+	.rates			= SNDRV_PCM_RATE_22050 | SNDRV_PCM_RATE_44100 |
+				  SNDRV_PCM_RATE_KNOT,
+	.rate_min		= 22050,
+	.rate_max		= 44100,
+	.channels_min		= 2,
+	.channels_max		= 2,
+	.buffer_bytes_max	= 64 * 1024,
+	.period_bytes_min	= 64 * FRAME_BYTES,
+	.period_bytes_max	= BUF_SIZE_MAX * FRAME_BYTES,
+	.periods_min		= 2,
+	.periods_max		= 1024,
+};
+
+static struct awacs_stream *awacs_stream(struct snd_pcm_substream *ss)
+{
+	struct amic_awacs *chip = snd_pcm_substream_chip(ss);
+
+	return &chip->stream[ss->stream];
+}
+
+/* rate and half size are common to both directions */
+static int awacs_rule_shared(struct snd_pcm_hw_params *params,
+			     struct snd_pcm_hw_rule *rule)
+{
+	struct awacs_stream *other = rule->private;
+	struct snd_interval v = { .integer = 1 };
+
+	scoped_guard(spinlock_irq, &other->chip->lock)
+		v.min = rule->var == SNDRV_PCM_HW_PARAM_RATE ?
+			other->rate : other->period_frames;
+	if (!v.min)
+		return 0;
+	v.max = v.min;
+	return snd_interval_refine(hw_param_interval(params, rule->var), &v);
+}
+
+static int awacs_pcm_open(struct snd_pcm_substream *ss)
+{
+	struct amic_awacs *chip = snd_pcm_substream_chip(ss);
+	struct awacs_stream *other = &chip->stream[!ss->stream];
+	struct snd_pcm_runtime *rt = ss->runtime;
+	int ret;
+
+	rt->hw = awacs_pcm_hw;
+	ret = snd_pcm_hw_constraint_list(rt, 0, SNDRV_PCM_HW_PARAM_RATE,
+					 &awacs_rate_list);
+	if (ret < 0)
+		return ret;
+	ret = snd_pcm_hw_constraint_integer(rt, SNDRV_PCM_HW_PARAM_PERIODS);
+	if (ret < 0)
+		return ret;
+	ret = snd_pcm_hw_constraint_step(rt, 0, SNDRV_PCM_HW_PARAM_PERIOD_SIZE,
+					 4);
+	if (ret < 0)
+		return ret;
+	ret = snd_pcm_hw_rule_add(rt, 0, SNDRV_PCM_HW_PARAM_RATE,
+				  awacs_rule_shared, other,
+				  SNDRV_PCM_HW_PARAM_RATE, -1);
+	if (ret < 0)
+		return ret;
+	ret = snd_pcm_hw_rule_add(rt, 0, SNDRV_PCM_HW_PARAM_PERIOD_SIZE,
+				  awacs_rule_shared, other,
+				  SNDRV_PCM_HW_PARAM_PERIOD_SIZE, -1);
+	if (ret < 0)
+		return ret;
+
+	guard(spinlock_irq)(&chip->lock);
+	awacs_stream(ss)->substream = ss;
+	return 0;
+}
+
+static int awacs_pcm_close(struct snd_pcm_substream *ss)
+{
+	struct amic_awacs *chip = snd_pcm_substream_chip(ss);
+
+	guard(spinlock_irq)(&chip->lock);
+	awacs_stream(ss)->substream = NULL;
+	return 0;
+}
+
+static int awacs_pcm_hw_params(struct snd_pcm_substream *ss,
+			       struct snd_pcm_hw_params *params)
+{
+	struct amic_awacs *chip = snd_pcm_substream_chip(ss);
+	struct awacs_stream *s = awacs_stream(ss);
+	struct awacs_stream *other = &chip->stream[!ss->stream];
+	unsigned int rate = params_rate(params);
+	unsigned int frames = params_period_size(params);
+
+	guard(spinlock_irq)(&chip->lock);
+	if (other->rate && (other->rate != rate ||
+			    other->period_frames != frames))
+		return -EBUSY;
+	s->rate = rate;
+	s->period_frames = frames;
+	return 0;
+}
+
+static int awacs_pcm_hw_free(struct snd_pcm_substream *ss)
+{
+	struct amic_awacs *chip = snd_pcm_substream_chip(ss);
+	struct awacs_stream *s = awacs_stream(ss);
+
+	guard(spinlock_irq)(&chip->lock);
+	s->rate = 0;
+	s->period_frames = 0;
+	return 0;
+}
+
+static int awacs_pcm_prepare(struct snd_pcm_substream *ss)
+{
+	struct amic_awacs *chip = snd_pcm_substream_chip(ss);
+	struct awacs_stream *s = awacs_stream(ss);
+	struct awacs_stream *other = &chip->stream[!ss->stream];
+	unsigned int i;
+	s64 delta;
+
+	for (i = 0; i < ARRAY_SIZE(awacs_rates); i++)
+		if (awacs_rates[i] == ss->runtime->rate)
+			break;
+	if (i == ARRAY_SIZE(awacs_rates))
+		return -EINVAL;
+
+	/* a stopped direction ends its half first (MAME), then restarts at half 0 */
+	delta = ktime_us_delta(s->idle, ktime_get());
+	if (delta > 0)
+		fsleep(delta);
+	memset_io(s->buf.cpu, 0, s->buf.size);
+	guard(spinlock_irq)(&chip->lock);
+	if (!other->running) {
+		chip->sc[0] = (chip->sc[0] & ~SC_RATE_MASK) |
+			      (i << SC_RATE_SHIFT);
+		awacs_write_sc(chip);
+		out_8(chip->regs + AW_BUF_SIZE, s->period_frames >> 8);
+		out_8(chip->regs + AW_BUF_SIZE + 1, s->period_frames & 0xff);
+	}
+	return 0;
+}
+
+/* application frames at fill_ptr, up to a period */
+static snd_pcm_uframes_t awacs_avail(struct snd_pcm_runtime *rt,
+				     struct awacs_stream *s)
+{
+	snd_pcm_sframes_t avail = rt->control->appl_ptr - s->fill_ptr;
+
+	if (avail < 0)
+		avail += rt->boundary;
+	if (avail > rt->buffer_size)
+		return 0;
+	return min_t(snd_pcm_uframes_t, avail, rt->period_size);
+}
+
+/* the period at fill_ptr is complete, or the stream drains */
+static bool awacs_period_ready(struct snd_pcm_runtime *rt,
+			       struct awacs_stream *s)
+{
+	return rt->state == SNDRV_PCM_STATE_DRAINING ||
+	       awacs_avail(rt, s) == rt->period_size;
+}
+
+static void awacs_advance(struct snd_pcm_runtime *rt, snd_pcm_uframes_t *ptr,
+			  snd_pcm_uframes_t wrap)
+{
+	*ptr += rt->period_size;
+	if (*ptr >= wrap)
+		*ptr -= wrap;
+}
+
+static void awacs_fill(struct awacs_stream *s, unsigned int half)
+{
+	struct snd_pcm_runtime *rt = s->substream->runtime;
+	snd_pcm_uframes_t off = s->fill_ptr % rt->buffer_size;
+	size_t len = frames_to_bytes(rt, awacs_avail(rt, s));
+	size_t period = frames_to_bytes(rt, rt->period_size);
+
+	/* silence beyond the application data, at the start or end */
+	memcpy_toio(s->half[half], rt->dma_area + frames_to_bytes(rt, off),
+		    len);
+	memset_io(s->half[half] + len, 0, period - len);
+	awacs_advance(rt, &s->fill_ptr, rt->boundary);
+	s->queued[half] = true;
+}
+
+/* playback half done: count it, refill it or silence it until data comes */
+static void awacs_play_done(struct awacs_stream *s, unsigned int half)
+{
+	struct snd_pcm_runtime *rt = s->substream->runtime;
+
+	awacs_advance(rt, &s->hw_off, rt->buffer_size);
+	s->queued[half] = false;
+	if (!s->queued[half ^ 1]) {
+		/* the hardware plays the silent half, skip its period */
+		awacs_advance(rt, &s->fill_ptr, rt->boundary);
+		s->queued[half ^ 1] = true;
+	}
+	if (awacs_period_ready(rt, s))
+		awacs_fill(s, half);
+	else
+		memset_io(s->half[half], 0, frames_to_bytes(rt, rt->period_size));
+}
+
+static void awacs_capture_done(struct awacs_stream *s, unsigned int half)
+{
+	struct snd_pcm_runtime *rt = s->substream->runtime;
+
+	memcpy_fromio(rt->dma_area + frames_to_bytes(rt, s->hw_off),
+		      s->half[half], frames_to_bytes(rt, rt->period_size));
+	awacs_advance(rt, &s->hw_off, rt->buffer_size);
+}
+
+static int awacs_pcm_trigger(struct snd_pcm_substream *ss, int cmd)
+{
+	struct amic_awacs *chip = snd_pcm_substream_chip(ss);
+	struct awacs_stream *s = awacs_stream(ss);
+	struct snd_pcm_runtime *rt = ss->runtime;
+	bool play = ss->stream == SNDRV_PCM_STREAM_PLAYBACK;
+	u8 *sc = play ? &chip->sc[0] : &chip->sc[1];
+	u8 enable = play ? SC_OUT_ENABLE : SC_IN_ENABLE;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+		s->next = 0;
+		s->hw_off = rt->status->hw_ptr % rt->buffer_size;
+		s->fill_ptr = rt->status->hw_ptr;
+		if (play) {
+			/* the first half plays at once, whatever is there */
+			awacs_fill(s, 0);
+			s->queued[1] = false;
+			if (awacs_period_ready(rt, s))
+				awacs_fill(s, 1);
+			else
+				memset_io(s->half[1], 0,
+					  frames_to_bytes(rt, rt->period_size));
+		}
+		scoped_guard(spinlock, &chip->lock) {
+			s->running = true;
+			out_8(chip->regs + s->dma_reg, DMA_FLAGS | DMA_IE_HALVES);
+			*sc |= enable;
+			awacs_write_sc(chip);
+		}
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+		scoped_guard(spinlock, &chip->lock) {
+			s->running = false;
+			s->idle = ktime_add_us(ktime_get(),
+					       div_u64((u64)rt->period_size *
+						       USEC_PER_SEC, rt->rate) +
+					       USEC_PER_MSEC);
+			*sc &= ~enable;
+			awacs_write_sc(chip);
+			out_8(chip->regs + s->dma_reg, DMA_FLAGS);
+		}
+		/* silence the rest of the half still playing */
+		if (play)
+			memset_io(s->buf.cpu, 0, s->buf.size);
+		return 0;
+	}
+	return -EINVAL;
+}
+
+/* fill the free playback half as soon as the application provides data */
+static int awacs_pcm_ack(struct snd_pcm_substream *ss)
+{
+	struct awacs_stream *s = awacs_stream(ss);
+	unsigned int half = s->next ^ 1;
+	u8 pending;
+
+	if (ss->stream != SNDRV_PCM_STREAM_PLAYBACK || !s->running ||
+	    s->queued[half] || !awacs_period_ready(ss->runtime, s))
+		return 0;
+	/* not if the hardware already moved on to it */
+	pending = in_8(s->chip->regs + s->dma_reg);
+	if (pending & (s->next ? DMA_IF1 : DMA_IF0))
+		return 0;
+	awacs_fill(s, half);
+	return 0;
+}
+
+static snd_pcm_uframes_t awacs_pcm_pointer(struct snd_pcm_substream *ss)
+{
+	return awacs_stream(ss)->hw_off;
+}
+
+static int awacs_pcm_sync_stop(struct snd_pcm_substream *ss)
+{
+	synchronize_irq(awacs_stream(ss)->irq);
+	return 0;
+}
+
+static const struct snd_pcm_ops awacs_pcm_ops = {
+	.open		= awacs_pcm_open,
+	.close		= awacs_pcm_close,
+	.hw_params	= awacs_pcm_hw_params,
+	.hw_free	= awacs_pcm_hw_free,
+	.prepare	= awacs_pcm_prepare,
+	.trigger	= awacs_pcm_trigger,
+	.sync_stop	= awacs_pcm_sync_stop,
+	.pointer	= awacs_pcm_pointer,
+	.ack		= awacs_pcm_ack,
+};
+
+static irqreturn_t awacs_dma_irq(int irq, void *dev_id)
+{
+	struct awacs_stream *s = dev_id;
+	struct amic_awacs *chip = s->chip;
+	struct snd_pcm_substream *ss;
+	bool running, periods = false;
+	u8 stat, done, bit;
+
+	scoped_guard(spinlock, &chip->lock) {
+		stat = in_8(chip->regs + s->dma_reg);
+		if (!(stat & DMA_FLAGS))
+			return IRQ_NONE;
+		running = s->running;
+		out_8(chip->regs + s->dma_reg, (stat & DMA_FLAGS) |
+		      (running ? DMA_IE_HALVES : 0));
+	}
+	/* the substream stays valid while running, see sync_stop */
+	if (!running)
+		return IRQ_HANDLED;
+
+	ss = s->substream;
+	snd_pcm_stream_lock(ss);
+	/* the flags tell which half is done, resynchronize on them */
+	done = s->running ? stat & (DMA_IF0 | DMA_IF1) : 0;
+	while (done) {
+		bit = s->next ? DMA_IF1 : DMA_IF0;
+		if (!(done & bit)) {
+			s->next ^= 1;
+			bit ^= DMA_IF0 | DMA_IF1;
+		}
+		if (ss->stream == SNDRV_PCM_STREAM_PLAYBACK)
+			awacs_play_done(s, s->next);
+		else
+			awacs_capture_done(s, s->next);
+		s->next ^= 1;
+		done &= ~bit;
+		periods = true;
+	}
+	if (periods)
+		snd_pcm_period_elapsed_under_stream_lock(ss);
+	snd_pcm_stream_unlock(ss);
+	return IRQ_HANDLED;
+}
+
+/* mixer: private_value is reg | shift << 8 | invert << 16 */
+
+#define AWACS_PV(reg, shift, inv)	((reg) | ((shift) << 8) | ((inv) << 16))
+#define PV_REG(pv)			((pv) & 0xff)
+#define PV_SHIFT(pv)			(((pv) >> 8) & 0xff)
+#define PV_INV(pv)			(((pv) >> 16) & 1)
+
+static int awacs_volume_info(struct snd_kcontrol *kc,
+			     struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 2;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = 15;
+	return 0;
+}
+
+/* left channel at the shift, right channel in the low four bits */
+static int awacs_volume_get(struct snd_kcontrol *kc,
+			    struct snd_ctl_elem_value *uc)
+{
+	struct amic_awacs *chip = snd_kcontrol_chip(kc);
+	unsigned long pv = kc->private_value;
+	unsigned int l, r;
+
+	scoped_guard(mutex, &chip->codec_lock) {
+		l = (chip->codec[PV_REG(pv)] >> PV_SHIFT(pv)) & 0xf;
+		r = chip->codec[PV_REG(pv)] & 0xf;
+	}
+	if (PV_INV(pv)) {
+		l = 15 - l;
+		r = 15 - r;
+	}
+	uc->value.integer.value[0] = l;
+	uc->value.integer.value[1] = r;
+	return 0;
+}
+
+static int awacs_volume_put(struct snd_kcontrol *kc,
+			    struct snd_ctl_elem_value *uc)
+{
+	struct amic_awacs *chip = snd_kcontrol_chip(kc);
+	unsigned long pv = kc->private_value;
+	long l = uc->value.integer.value[0];
+	long r = uc->value.integer.value[1];
+	u16 old;
+
+	if (l < 0 || l > 15 || r < 0 || r > 15)
+		return -EINVAL;
+	if (PV_INV(pv)) {
+		l = 15 - l;
+		r = 15 - r;
+	}
+	guard(mutex)(&chip->codec_lock);
+	old = chip->codec[PV_REG(pv)];
+	awacs_codec_update(chip, PV_REG(pv), 0xf << PV_SHIFT(pv) | 0xf,
+			   l << PV_SHIFT(pv) | r);
+	return old != chip->codec[PV_REG(pv)];
+}
+
+static int awacs_switch_get(struct snd_kcontrol *kc,
+			    struct snd_ctl_elem_value *uc)
+{
+	struct amic_awacs *chip = snd_kcontrol_chip(kc);
+	unsigned long pv = kc->private_value;
+
+	guard(mutex)(&chip->codec_lock);
+	uc->value.integer.value[0] =
+		((chip->codec[PV_REG(pv)] >> PV_SHIFT(pv)) & 1) ^ PV_INV(pv);
+	return 0;
+}
+
+static int awacs_switch_put(struct snd_kcontrol *kc,
+			    struct snd_ctl_elem_value *uc)
+{
+	struct amic_awacs *chip = snd_kcontrol_chip(kc);
+	unsigned long pv = kc->private_value;
+	u16 bit = BIT(PV_SHIFT(pv));
+	u16 old;
+
+	guard(mutex)(&chip->codec_lock);
+	old = chip->codec[PV_REG(pv)];
+	awacs_codec_update(chip, PV_REG(pv), bit,
+			   (!!uc->value.integer.value[0] ^ PV_INV(pv)) ? bit : 0);
+	return old != chip->codec[PV_REG(pv)];
+}
+
+#define AWACS_VOLUME(xname, reg, shift, inv) {				\
+	.iface = SNDRV_CTL_ELEM_IFACE_MIXER, .name = xname,		\
+	.info = awacs_volume_info, .get = awacs_volume_get,		\
+	.put = awacs_volume_put, .private_value = AWACS_PV(reg, shift, inv) }
+
+#define AWACS_SWITCH(xname, reg, shift, inv) {				\
+	.iface = SNDRV_CTL_ELEM_IFACE_MIXER, .name = xname,		\
+	.info = snd_ctl_boolean_mono_info, .get = awacs_switch_get,	\
+	.put = awacs_switch_put, .private_value = AWACS_PV(reg, shift, inv) }
+
+static int awacs_auto_mute_get(struct snd_kcontrol *kc,
+			       struct snd_ctl_elem_value *uc)
+{
+	struct amic_awacs *chip = snd_kcontrol_chip(kc);
+
+	guard(mutex)(&chip->codec_lock);
+	uc->value.integer.value[0] = chip->auto_mute;
+	return 0;
+}
+
+static int awacs_auto_mute_put(struct snd_kcontrol *kc,
+			       struct snd_ctl_elem_value *uc)
+{
+	struct amic_awacs *chip = snd_kcontrol_chip(kc);
+	bool on = uc->value.integer.value[0];
+
+	scoped_guard(mutex, &chip->codec_lock) {
+		if (on == chip->auto_mute)
+			return 0;
+		chip->auto_mute = on;
+		chip->sense = -1;
+	}
+	if (on)
+		mod_delayed_work(system_wq, &chip->sense_work, 0);
+	return 1;
+}
+
+static const struct snd_kcontrol_new awacs_controls[] = {
+	AWACS_VOLUME("Master Playback Volume", 2, 6, 1),
+	AWACS_VOLUME("Speaker Playback Volume", 4, 6, 1),
+	AWACS_VOLUME("Master Capture Volume", 0, 4, 0),
+	AWACS_SWITCH("Master Capture Switch", 1, SHIFT_LOOPTHRU, 0),
+	AWACS_SWITCH("CD Capture Switch", 0, SHIFT_MUX_CD, 0),
+	AWACS_SWITCH("Mic Capture Switch", 0, SHIFT_MUX_MIC, 0),
+	AWACS_SWITCH("Line Capture Switch", 0, SHIFT_MUX_LINE, 0),
+	AWACS_SWITCH("Mic Boost Capture Switch", 0, SHIFT_GAINLINE, 1),
+	{
+		.iface	= SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name	= "Auto Mute Switch",
+		.info	= snd_ctl_boolean_mono_info,
+		.get	= awacs_auto_mute_get,
+		.put	= awacs_auto_mute_put,
+	},
+};
+
+static const struct snd_kcontrol_new awacs_master_sw =
+	AWACS_SWITCH("Master Playback Switch", 1, SHIFT_HDMUTE, 1);
+static const struct snd_kcontrol_new awacs_speaker_sw =
+	AWACS_SWITCH("Speaker Playback Switch", 1, SHIFT_SPKMUTE, 1);
+
+static int awacs_mixer_new(struct amic_awacs *chip)
+{
+	struct snd_card *card = chip->card;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(awacs_controls); i++) {
+		ret = snd_ctl_add(card, snd_ctl_new1(&awacs_controls[i], chip));
+		if (ret < 0)
+			return ret;
+	}
+	chip->master_sw = snd_ctl_new1(&awacs_master_sw, chip);
+	ret = snd_ctl_add(card, chip->master_sw);
+	if (ret < 0)
+		return ret;
+	chip->speaker_sw = snd_ctl_new1(&awacs_speaker_sw, chip);
+	return snd_ctl_add(card, chip->speaker_sw);
+}
+
+/* initial setup as MkLinux: CD input with loop through, 22050 Hz */
+static void awacs_hw_init(struct amic_awacs *chip)
+{
+	chip->sc[0] = 0;
+	chip->sc[1] = SC_OUT_SUBFRAME0 | SC_IN_SUBFRAME0;
+	awacs_write_sc(chip);
+	out_8(chip->regs + AW_DMA_OUT, DMA_FLAGS);
+	out_8(chip->regs + AW_DMA_IN, DMA_FLAGS);
+
+	guard(mutex)(&chip->codec_lock);
+	awacs_codec_write(chip, 0, MASK_MUX_CD | DEFAULT_GAIN);
+	awacs_codec_write(chip, 1, MASK_LOOPTHRU | MASK_PAROUT0);
+	awacs_codec_write(chip, 2, DEFAULT_ATTEN << 6 | DEFAULT_ATTEN);
+	awacs_codec_write(chip, 4, DEFAULT_ATTEN << 6 | DEFAULT_ATTEN);
+	chip->auto_mute = true;
+	chip->sense = -1;
+	awacs_apply_sense(chip);
+}
+
+static void awacs_card_free(struct snd_card *card)
+{
+	struct amic_awacs *chip = card->private_data;
+
+	cancel_delayed_work_sync(&chip->sense_work);
+	scoped_guard(spinlock_irq, &chip->lock) {
+		chip->sc[0] &= ~SC_OUT_ENABLE;
+		chip->sc[1] &= ~SC_IN_ENABLE;
+		awacs_write_sc(chip);
+		out_8(chip->regs + AW_DMA_OUT, DMA_FLAGS);
+		out_8(chip->regs + AW_DMA_IN, DMA_FLAGS);
+	}
+}
+
+static int amic_awacs_probe(struct platform_device *pdev)
+{
+	static const char * const irq_names[] = { "out", "in" };
+	static const enum amic_dma_area areas[] = {
+		AMIC_DMA_SOUND_OUT, AMIC_DMA_SOUND_IN
+	};
+	static const unsigned int dma_regs[] = { AW_DMA_OUT, AW_DMA_IN };
+	struct device *dev = &pdev->dev;
+	struct amic_awacs *chip;
+	struct snd_card *card;
+	struct snd_pcm *pcm;
+	int i, irq, ret;
+
+	ret = snd_devm_card_new(dev, index, id, THIS_MODULE, sizeof(*chip),
+				&card);
+	if (ret < 0)
+		return ret;
+	chip = card->private_data;
+	chip->card = card;
+	spin_lock_init(&chip->lock);
+	mutex_init(&chip->codec_lock);
+	INIT_DELAYED_WORK(&chip->sense_work, awacs_sense_work);
+
+	chip->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(chip->regs))
+		return PTR_ERR(chip->regs);
+
+	BUILD_BUG_ON(SNDRV_PCM_STREAM_PLAYBACK != 0);
+	for (i = 0; i < 2; i++) {
+		struct awacs_stream *s = &chip->stream[i];
+
+		s->chip = chip;
+		s->dma_reg = dma_regs[i];
+		ret = devm_amic_dma_request(dev, areas[i], &s->buf);
+		if (ret)
+			return dev_err_probe(dev, ret, "no %s DMA buffer\n",
+					     irq_names[i]);
+		s->half[0] = s->buf.cpu;
+		s->half[1] = s->buf.cpu + s->buf.size / 2;
+	}
+
+	awacs_hw_init(chip);
+	card->private_free = awacs_card_free;
+
+	for (i = 0; i < 2; i++) {
+		irq = platform_get_irq_byname(pdev, irq_names[i]);
+		if (irq < 0)
+			return irq;
+		ret = devm_request_irq(dev, irq, awacs_dma_irq, 0,
+				       dev_name(dev), &chip->stream[i]);
+		if (ret)
+			return ret;
+		chip->stream[i].irq = irq;
+	}
+
+	ret = snd_pcm_new(card, "AWACS", 0, 1, 1, &pcm);
+	if (ret < 0)
+		return ret;
+	pcm->private_data = chip;
+	strscpy(pcm->name, "AWACS");
+	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_PLAYBACK, &awacs_pcm_ops);
+	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_CAPTURE, &awacs_pcm_ops);
+	snd_pcm_set_managed_buffer_all(pcm, SNDRV_DMA_TYPE_VMALLOC, NULL, 0, 0);
+
+	ret = awacs_mixer_new(chip);
+	if (ret < 0)
+		return ret;
+
+	strscpy(card->driver, "AMIC AWACS");
+	strscpy(card->shortname, "PDM AWACS");
+	strscpy(card->mixername, "AWACS");
+	snprintf(card->longname, sizeof(card->longname),
+		 "AWACS with AMIC DMA at %pOF", dev->of_node);
+
+	ret = snd_card_register(card);
+	if (ret < 0)
+		return ret;
+	schedule_delayed_work(&chip->sense_work, SENSE_POLL);
+	platform_set_drvdata(pdev, card);
+	return 0;
+}
