+		if (--depth == 0) {
+			if (!memory) {
+				bootx_dt_begin_node("memory", mem_end);
+				bootx_dt_add_prop("device_type", "memory",
+						  sizeof("memory"), mem_end);
+				bootx_add_memory_props(acells, scells, mem_end);
+				dt_push_token(OF_DT_END_NODE, mem_end);
+			}
+			if (!has_chosen) {
+				bootx_dt_begin_node("chosen", mem_end);
+				bootx_fdt_add_chosen_props(mem_end);
+				dt_push_token(OF_DT_END_NODE, mem_end);
+			}
+			if (video) {
+				bootx_dt_begin_node(video, mem_end);
+				bootx_dt_add_prop("device_type", "display",
+						  sizeof("display"), mem_end);
+				if (pdm_card)
+					bootx_add_pdm_video_props(acells,
+								  scells,
+								  mem_end);
+				bootx_add_display_props(0, mem_end, 1);
+				dt_push_token(OF_DT_END_NODE, mem_end);
+			}
+		}
+		dt_push_token(OF_DT_END_NODE, mem_end);
+	}
+}
