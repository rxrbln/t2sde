@@ -0,0 +1,665 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Am79C940 MACE Ethernet with AMIC DMA of the PDM Power Macintosh
+ * (6100, 7100, 8100).
+ *
+ * Receive DMA fills a ring of 256 byte pages in the AMIC DMA area: every
+ * frame starts on a page with an 8 byte header holding the MACE receive
+ * status, the AMIC advances the head page, the driver the tail page.
+ * Transmit DMA sends from two fixed 2 KB buffers; like MkLinux only one of
+ * them is used, MkLinux reports lock ups with both.  Register usage
+ * follows MkLinux (osfmk if_mace.c, enet_dma.h) and MAME (amic_enet.cpp).
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/bitrev.h>
+#include <linux/crc32.h>
+#include <linux/delay.h>
+#include <linux/etherdevice.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/netdevice.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/rtnetlink.h>
+#include <linux/workqueue.h>
+
+#include <asm/amic_dma.h>
+#include <asm/io.h>
+
+#include "mace.h"
+
+#define DRV_NAME		"amic-mace"
+
+/* AMIC Ethernet DMA registers, relative to the "rxdma" block */
+#define RCVCS			0x00
+#define RCVHP			0x08
+#define RCVTP			0x0c
+#define XMTBC_HI(set)		(0x1c + 0x10 * (set))
+#define XMTBC_LO(set)		(0x1d + 0x10 * (set))
+
+/* receive and transmit DMA control/status */
+#define DMA_IF			0x80
+#define DMA_OVERRUN		0x40
+#define DMA_IE			0x08
+#define DMA_RUN			0x02
+#define DMA_RST			0x01
+
+#define RX_PAGE			256
+#define RX_HDR			8
+#define TX_SET			1
+#define TX_SET_SIZE		0x800
+
+#define PROM_STRIDE		0x10
+#define PROM_BYTES		8
+
+#define BROKEN_ADDRCHG_REV	0x0941
+#define TX_TIMEOUT		(2 * HZ)
+
+struct amic_mace {
+	struct net_device *ndev;
+	struct mace __iomem *mace;
+	u8 __iomem *prom;
+	u8 __iomem *txdma;
+	u8 __iomem *rxdma;
+	struct amic_dma_buf rx, tx;
+	unsigned int rx_pages;
+	unsigned int tx_len;
+	bool rx_overrun;	/* stopped by OVERRUN, draining */
+	u16 chipid;
+	spinlock_t lock;	/* MACE and DMA registers, transmit buffer */
+	struct napi_struct napi;
+	struct work_struct reset_work;
+};
+
+static int amic_mace_read_prom(struct amic_mace *mp, u8 *addr)
+{
+	u8 v, sum = 0;
+	int i;
+
+	/* bit reversed bytes, all eight XOR to 0xff */
+	for (i = 0; i < PROM_BYTES; i++) {
+		v = bitrev8(in_8(mp->prom + 1 + i * PROM_STRIDE));
+		if (i < ETH_ALEN)
+			addr[i] = v;
+		sum ^= v;
+	}
+	return sum == 0xff ? 0 : -EIO;
+}
+
+/* load the physical address or the multicast filter */
+static void amic_mace_load_addr(struct amic_mace *mp, u8 which, const u8 *p)
+{
+	struct mace __iomem *mb = mp->mace;
+	int i, n = which == PHYADDR ? ETH_ALEN : 8;
+
+	if (mp->chipid == BROKEN_ADDRCHG_REV) {
+		out_8(&mb->iac, which);
+	} else {
+		out_8(&mb->iac, ADDRCHG | which);
+		/* pending while a frame is being received */
+		for (i = 0; i < 2000 && (in_8(&mb->iac) & ADDRCHG); i++)
+			udelay(1);
+	}
+	for (i = 0; i < n; i++)
+		out_8(which == PHYADDR ? &mb->padr : &mb->ladrf, p[i]);
+	if (mp->chipid != BROKEN_ADDRCHG_REV)
+		out_8(&mb->iac, 0);
+}
+
+/* call with the lock held, the caller restores MACCC */
+static void __amic_mace_set_rx_mode(struct amic_mace *mp)
+{
+	struct net_device *ndev = mp->ndev;
+	struct netdev_hw_addr *ha;
+	u8 filter[8] = {};
+	u32 crc;
+
+	if (ndev->flags & IFF_ALLMULTI) {
+		memset(filter, 0xff, sizeof(filter));
+	} else {
+		netdev_for_each_mc_addr(ha, ndev) {
+			crc = ether_crc_le(ETH_ALEN, ha->addr) >> 26;
+			filter[crc >> 3] |= BIT(crc & 7);
+		}
+	}
+	amic_mace_load_addr(mp, LOGADDR, filter);
+}
+
+static u8 amic_mace_maccc(struct amic_mace *mp)
+{
+	return ENXMT | ENRCV | (mp->ndev->flags & IFF_PROMISC ? PROM : 0);
+}
+
+static void amic_mace_set_rx_mode(struct net_device *ndev)
+{
+	struct amic_mace *mp = netdev_priv(ndev);
+	unsigned long flags;
+
+	if (!netif_running(ndev))
+		return;
+	spin_lock_irqsave(&mp->lock, flags);
+	__amic_mace_set_rx_mode(mp);
+	out_8(&mp->mace->maccc, amic_mace_maccc(mp));
+	spin_unlock_irqrestore(&mp->lock, flags);
+}
+
+static int amic_mace_set_mac_address(struct net_device *ndev, void *addr)
+{
+	struct amic_mace *mp = netdev_priv(ndev);
+	unsigned long flags;
+	int ret;
+
+	ret = eth_mac_addr(ndev, addr);
+	if (ret || !netif_running(ndev))
+		return ret;
+
+	spin_lock_irqsave(&mp->lock, flags);
+	amic_mace_load_addr(mp, PHYADDR, ndev->dev_addr);
+	out_8(&mp->mace->maccc, amic_mace_maccc(mp));
+	spin_unlock_irqrestore(&mp->lock, flags);
+	return 0;
+}
+
+static u8 amic_mace_utr(struct amic_mace *mp)
+{
+	return RTRD | (mp->ndev->features & NETIF_F_LOOPBACK ? LOOP_INT : 0);
+}
+
+static void amic_mace_reset(struct amic_mace *mp)
+{
+	struct mace __iomem *mb = mp->mace;
+	int i;
+
+	out_8(mp->rxdma + RCVCS, DMA_RST);
+	out_8(mp->txdma, DMA_RST);
+
+	out_8(&mb->maccc, 0);
+	out_8(&mb->biucc, SWRST);
+	for (i = 0; i < 200 && (in_8(&mb->biucc) & SWRST); i++)
+		udelay(10);
+	if (i == 200)
+		netdev_err(mp->ndev, "MACE does not leave reset\n");
+	out_8(&mb->imr, 0xff);
+	in_8(&mb->ir);
+}
+
+/* call with the lock held */
+static void amic_mace_hw_init(struct amic_mace *mp)
+{
+	struct mace __iomem *mb = mp->mace;
+	u8 __iomem *rx = mp->rxdma;
+
+	amic_mace_reset(mp);
+
+	out_8(&mb->utr, amic_mace_utr(mp));
+	out_8(&mb->biucc, XMTSP_64);
+	out_8(&mb->xmtfc, AUTO_PAD_XMIT);
+	out_8(&mb->rcvfc, 0);
+	out_8(&mb->fifocc, XMTFW_16 | RCVFW_64 | XMTFWU | RCVFWU);
+	out_8(&mb->plscc, PORTSEL_AUI);
+
+	amic_mace_load_addr(mp, PHYADDR, mp->ndev->dev_addr);
+	__amic_mace_set_rx_mode(mp);
+
+	out_8(rx + RCVCS, DMA_IF | DMA_OVERRUN);
+	out_8(mp->txdma, DMA_IF);
+	out_8(rx + RCVTP, in_8(rx + RCVHP));
+	mp->rx_overrun = false;
+	out_8(rx + RCVCS, DMA_RUN | DMA_IE);
+
+	out_8(&mb->maccc, amic_mace_maccc(mp));
+	/* receive is signalled by the DMA */
+	out_8(&mb->imr, RCVINT);
+}
+
+/* restart the receiver, MkLinux does this on any bad receive status */
+static void amic_mace_rx_reset(struct amic_mace *mp)
+{
+	struct mace __iomem *mb = mp->mace;
+	u8 __iomem *rx = mp->rxdma;
+	unsigned long flags;
+	u8 maccc;
+
+	spin_lock_irqsave(&mp->lock, flags);
+	maccc = in_8(&mb->maccc);
+	out_8(&mb->maccc, maccc & ~ENRCV);
+	out_8(rx + RCVCS, DMA_RST);
+	out_8(&mb->fifocc, (in_8(&mb->fifocc) & ~XMTFWU) | RCVFWU);
+	out_8(rx + RCVCS, DMA_IF | DMA_OVERRUN);
+	out_8(rx + RCVTP, in_8(rx + RCVHP));
+	mp->rx_overrun = false;
+	out_8(&mb->maccc, maccc);
+	out_8(rx + RCVCS, DMA_RUN);
+	spin_unlock_irqrestore(&mp->lock, flags);
+}
+
+static void amic_mace_rx_error(struct net_device *ndev, u16 status)
+{
+	DEV_STATS_INC(ndev, rx_errors);
+	if (status & RS_OFLO)
+		DEV_STATS_INC(ndev, rx_fifo_errors);
+	if (status & RS_CLSN)
+		DEV_STATS_INC(ndev, collisions);
+	if (status & RS_FRAMERR)
+		DEV_STATS_INC(ndev, rx_frame_errors);
+	if (status & RS_FCSERR)
+		DEV_STATS_INC(ndev, rx_crc_errors);
+	if (!(status & (RS_OFLO | RS_CLSN | RS_FRAMERR | RS_FCSERR)))
+		DEV_STATS_INC(ndev, rx_length_errors);
+}
+
+static int amic_mace_rx(struct amic_mace *mp, int budget, bool full)
+{
+	struct net_device *ndev = mp->ndev;
+	unsigned int ring = mp->rx_pages * RX_PAGE;
+	unsigned int tail, off, len, first;
+	struct sk_buff *skb;
+	int done = 0;
+	u16 status;
+
+	tail = in_8(mp->rxdma + RCVTP);
+	/* with OVERRUN set head == tail means the ring is full */
+	while (done < budget && (full || tail != in_8(mp->rxdma + RCVHP))) {
+		full = false;
+		off = tail * RX_PAGE;
+		status = tail < mp->rx_pages ? in_be16(mp->rx.cpu + off) : 0;
+		len = status & RS_COUNT;
+		if ((status & ~RS_COUNT) || len < ETH_HLEN + ETH_FCS_LEN) {
+			if (net_ratelimit())
+				netdev_dbg(ndev, "receive status %04x, restarting\n",
+					   status);
+			amic_mace_rx_error(ndev, status);
+			amic_mace_rx_reset(mp);
+			break;
+		}
+
+		len -= ETH_FCS_LEN;
+		skb = napi_alloc_skb(&mp->napi, len);
+		if (skb) {
+			/* the frame may wrap at the end of the ring */
+			off += RX_HDR;
+			first = min(len, ring - off);
+			memcpy_fromio(skb_put(skb, len), mp->rx.cpu + off, first);
+			if (len > first)
+				memcpy_fromio(skb->data + first, mp->rx.cpu,
+					      len - first);
+			skb->protocol = eth_type_trans(skb, ndev);
+			DEV_STATS_INC(ndev, rx_packets);
+			DEV_STATS_ADD(ndev, rx_bytes, len);
+			napi_gro_receive(&mp->napi, skb);
+		} else {
+			DEV_STATS_INC(ndev, rx_dropped);
+		}
+
+		tail = (tail + DIV_ROUND_UP(RX_HDR + len + ETH_FCS_LEN,
+					    RX_PAGE)) % mp->rx_pages;
+		out_8(mp->rxdma + RCVTP, tail);
+		done++;
+	}
+	return done;
+}
+
+static int amic_mace_poll(struct napi_struct *napi, int budget)
+{
+	struct amic_mace *mp = container_of(napi, struct amic_mace, napi);
+	u8 cs = in_8(mp->rxdma + RCVCS);
+	bool full = false;
+	int done;
+
+	/* head == tail is a full ring only before the first frame is taken */
+	if ((cs & DMA_OVERRUN) && !mp->rx_overrun) {
+		mp->rx_overrun = true;
+		full = true;
+	}
+	done = amic_mace_rx(mp, budget, full);
+	if (done < budget && napi_complete_done(napi, done)) {
+		/* the AMIC stops on a full ring, resume after it was drained */
+		cs = in_8(mp->rxdma + RCVCS) & DMA_OVERRUN;
+		if (cs)
+			DEV_STATS_INC(mp->ndev, rx_over_errors);
+		mp->rx_overrun = false;
+		out_8(mp->rxdma + RCVCS, cs | DMA_RUN | DMA_IE);
+	}
+	return done;
+}
+
+static irqreturn_t amic_mace_rxdma_irq(int irq, void *dev_id)
+{
+	struct amic_mace *mp = dev_id;
+	u8 cs = in_8(mp->rxdma + RCVCS);
+
+	if (!(cs & DMA_IF) || !(cs & DMA_IE))
+		return IRQ_NONE;
+
+	/* acknowledge, interrupts stay off until the ring is drained */
+	out_8(mp->rxdma + RCVCS, DMA_IF | (cs & DMA_RUN));
+	napi_schedule(&mp->napi);
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t amic_mace_txdma_irq(int irq, void *dev_id)
+{
+	struct amic_mace *mp = dev_id;
+	struct net_device *ndev = mp->ndev;
+	u8 cs;
+
+	spin_lock(&mp->lock);
+	cs = in_8(mp->txdma);
+	if (!(cs & DMA_IF) || !(cs & DMA_IE)) {
+		spin_unlock(&mp->lock);
+		return IRQ_NONE;
+	}
+
+	/* the frame is in the MACE FIFO, the buffer is free again */
+	out_8(mp->txdma, DMA_IF);
+	out_8(mp->rxdma + XMTBC_HI(TX_SET), 0);
+	out_8(mp->rxdma + XMTBC_LO(TX_SET), 0);
+	DEV_STATS_INC(ndev, tx_packets);
+	DEV_STATS_ADD(ndev, tx_bytes, mp->tx_len);
+	netif_wake_queue(ndev);
+	spin_unlock(&mp->lock);
+	return IRQ_HANDLED;
+}
+
+static void amic_mace_tx_status(struct net_device *ndev, u8 fs, u8 rc)
+{
+	if (fs & (ONE | MORE))
+		DEV_STATS_ADD(ndev, collisions, rc & RETRY_MASK);
+	if (!(fs & (UFLO | LCOL | LCAR | RTRY)))
+		return;
+
+	DEV_STATS_INC(ndev, tx_errors);
+	if (fs & LCAR)
+		DEV_STATS_INC(ndev, tx_carrier_errors);
+	if (fs & LCOL)
+		DEV_STATS_INC(ndev, tx_window_errors);
+	if (fs & RTRY)
+		DEV_STATS_INC(ndev, tx_aborted_errors);
+	if (fs & UFLO)
+		DEV_STATS_INC(ndev, tx_fifo_errors);
+}
+
+static irqreturn_t amic_mace_irq(int irq, void *dev_id)
+{
+	struct amic_mace *mp = dev_id;
+	struct net_device *ndev = mp->ndev;
+	struct mace __iomem *mb = mp->mace;
+	u8 ir, fs, rc;
+
+	spin_lock(&mp->lock);
+	ir = in_8(&mb->ir) & ~in_8(&mb->imr);
+	if (!ir) {
+		spin_unlock(&mp->lock);
+		return IRQ_NONE;
+	}
+
+	/* the counters clear on read */
+	if (ir & MPCO)
+		DEV_STATS_ADD(ndev, rx_missed_errors, 256);
+	DEV_STATS_ADD(ndev, rx_missed_errors, in_8(&mb->mpc));
+	if (ir & RNTPCO)
+		DEV_STATS_ADD(ndev, rx_length_errors, 256);
+	DEV_STATS_ADD(ndev, rx_length_errors, in_8(&mb->rntpc));
+	if (ir & RCVCCO)
+		DEV_STATS_ADD(ndev, collisions, 256);
+	DEV_STATS_ADD(ndev, collisions, in_8(&mb->rcvcc));
+	if (ir & CERR)
+		DEV_STATS_INC(ndev, tx_heartbeat_errors);
+	if (ir & (BABBLE | JABBER) && net_ratelimit())
+		netdev_warn(ndev, "%s\n", ir & BABBLE ? "babbling transmitter" :
+						     "jabbering transceiver");
+
+	/* the MACE holds the status of two frames, read XMTRC first */
+	while (in_8(&mb->pr) & XMTSV) {
+		rc = in_8(&mb->xmtrc);
+		fs = in_8(&mb->xmtfs);
+		amic_mace_tx_status(ndev, fs, rc);
+	}
+	spin_unlock(&mp->lock);
+	return IRQ_HANDLED;
+}
+
+static netdev_tx_t amic_mace_start_xmit(struct sk_buff *skb,
+					struct net_device *ndev)
+{
+	struct amic_mace *mp = netdev_priv(ndev);
+	unsigned long flags;
+	unsigned int len;
+
+	if (skb_put_padto(skb, ETH_ZLEN)) {
+		DEV_STATS_INC(ndev, tx_dropped);
+		return NETDEV_TX_OK;
+	}
+	len = skb->len;
+	if (len > TX_SET_SIZE) {
+		DEV_STATS_INC(ndev, tx_dropped);
+		dev_kfree_skb_any(skb);
+		return NETDEV_TX_OK;
+	}
+
+	spin_lock_irqsave(&mp->lock, flags);
+	netif_stop_queue(ndev);
+	memcpy_toio(mp->tx.cpu + TX_SET * TX_SET_SIZE, skb->data, len);
+	out_8(mp->rxdma + XMTBC_HI(TX_SET), len >> 8);
+	out_8(mp->rxdma + XMTBC_LO(TX_SET), len & 0xff);
+	mp->tx_len = len;
+	out_8(mp->txdma, DMA_RUN | DMA_IE);
+	spin_unlock_irqrestore(&mp->lock, flags);
+
+	skb_tx_timestamp(skb);
+	dev_consume_skb_any(skb);
+	return NETDEV_TX_OK;
+}
+
+static int amic_mace_open(struct net_device *ndev)
+{
+	struct amic_mace *mp = netdev_priv(ndev);
+	unsigned long flags;
+
+	napi_enable(&mp->napi);
+	spin_lock_irqsave(&mp->lock, flags);
+	amic_mace_hw_init(mp);
+	spin_unlock_irqrestore(&mp->lock, flags);
+
+	/* the AAUI port has no link indication */
+	netif_carrier_on(ndev);
+	netif_start_queue(ndev);
+	return 0;
+}
+
+static int amic_mace_stop(struct net_device *ndev)
+{
+	struct amic_mace *mp = netdev_priv(ndev);
+	unsigned long flags;
+
+	netif_stop_queue(ndev);
+	napi_disable(&mp->napi);
+	spin_lock_irqsave(&mp->lock, flags);
+	amic_mace_reset(mp);
+	spin_unlock_irqrestore(&mp->lock, flags);
+	netif_carrier_off(ndev);
+	return 0;
+}
+
+static void amic_mace_reset_work(struct work_struct *work)
+{
+	struct amic_mace *mp = container_of(work, struct amic_mace,
+					    reset_work);
+	struct net_device *ndev = mp->ndev;
+	unsigned long flags;
+
+	rtnl_lock();
+	if (netif_running(ndev)) {
+		netif_tx_disable(ndev);
+		napi_disable(&mp->napi);
+		spin_lock_irqsave(&mp->lock, flags);
+		amic_mace_hw_init(mp);
+		spin_unlock_irqrestore(&mp->lock, flags);
+		napi_enable(&mp->napi);
+		netif_wake_queue(ndev);
+	}
+	rtnl_unlock();
+}
+
+static void amic_mace_tx_timeout(struct net_device *ndev, unsigned int txq)
+{
+	struct amic_mace *mp = netdev_priv(ndev);
+
+	netdev_err(ndev, "transmit timeout (DMA %02x, FIFO frames %02x), resetting\n",
+		   in_8(mp->txdma), in_8(&mp->mace->fifofc));
+	DEV_STATS_INC(ndev, tx_errors);
+	schedule_work(&mp->reset_work);
+}
+
+static int amic_mace_set_features(struct net_device *ndev,
+				  netdev_features_t features)
+{
+	struct amic_mace *mp = netdev_priv(ndev);
+	struct mace __iomem *mb = mp->mace;
+	unsigned long flags;
+	u8 maccc;
+
+	if (!((ndev->features ^ features) & NETIF_F_LOOPBACK))
+		return 0;
+
+	ndev->features = features;
+	if (!netif_running(ndev))
+		return 0;
+
+	spin_lock_irqsave(&mp->lock, flags);
+	maccc = in_8(&mb->maccc);
+	out_8(&mb->maccc, 0);
+	out_8(&mb->utr, amic_mace_utr(mp));
+	out_8(&mb->maccc, maccc);
+	spin_unlock_irqrestore(&mp->lock, flags);
+	return 0;
+}
+
+static const struct net_device_ops amic_mace_netdev_ops = {
+	.ndo_open		= amic_mace_open,
+	.ndo_stop		= amic_mace_stop,
+	.ndo_start_xmit		= amic_mace_start_xmit,
+	.ndo_tx_timeout		= amic_mace_tx_timeout,
+	.ndo_set_rx_mode	= amic_mace_set_rx_mode,
+	.ndo_set_mac_address	= amic_mace_set_mac_address,
+	.ndo_set_features	= amic_mace_set_features,
+	.ndo_validate_addr	= eth_validate_addr,
+};
+
+static int amic_mace_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	static const char * const irq_names[] = { "mace", "rxdma", "txdma" };
+	static const irq_handler_t handlers[] = {
+		amic_mace_irq, amic_mace_rxdma_irq, amic_mace_txdma_irq
+	};
+	struct net_device *ndev;
+	struct amic_mace *mp;
+	u8 addr[ETH_ALEN];
+	int i, irq, ret;
+
+	ndev = devm_alloc_etherdev(dev, sizeof(*mp));
+	if (!ndev)
+		return -ENOMEM;
+	SET_NETDEV_DEV(ndev, dev);
+	mp = netdev_priv(ndev);
+	mp->ndev = ndev;
+	spin_lock_init(&mp->lock);
+	INIT_WORK(&mp->reset_work, amic_mace_reset_work);
+
+	mp->mace = devm_platform_ioremap_resource_byname(pdev, "mace");
+	if (IS_ERR((void __force *)mp->mace))
+		return PTR_ERR((void __force *)mp->mace);
+	mp->prom = devm_platform_ioremap_resource_byname(pdev, "prom");
+	if (IS_ERR(mp->prom))
+		return PTR_ERR(mp->prom);
+	mp->txdma = devm_platform_ioremap_resource_byname(pdev, "txdma");
+	if (IS_ERR(mp->txdma))
+		return PTR_ERR(mp->txdma);
+	mp->rxdma = devm_platform_ioremap_resource_byname(pdev, "rxdma");
+	if (IS_ERR(mp->rxdma))
+		return PTR_ERR(mp->rxdma);
+
+	ret = devm_amic_dma_request(dev, AMIC_DMA_ENET_RX, &mp->rx);
+	if (ret)
+		return dev_err_probe(dev, ret, "no receive DMA buffer\n");
+	ret = devm_amic_dma_request(dev, AMIC_DMA_ENET_TX, &mp->tx);
+	if (ret)
+		return dev_err_probe(dev, ret, "no transmit DMA buffer\n");
+	mp->rx_pages = mp->rx.size / RX_PAGE;
+
+	mp->chipid = in_8(&mp->mace->chipid_hi) << 8 |
+		     in_8(&mp->mace->chipid_lo);
+
+	if (amic_mace_read_prom(mp, addr) || !is_valid_ether_addr(addr)) {
+		dev_warn(dev, "invalid address PROM %pM, using a random address\n",
+			 addr);
+		eth_hw_addr_random(ndev);
+	} else {
+		eth_hw_addr_set(ndev, addr);
+	}
+
+	amic_mace_reset(mp);
+
+	for (i = 0; i < ARRAY_SIZE(irq_names); i++) {
+		irq = platform_get_irq_byname(pdev, irq_names[i]);
+		if (irq < 0)
+			return irq;
+		ret = devm_request_irq(dev, irq, handlers[i], 0,
+				       dev_name(dev), mp);
+		if (ret)
+			return ret;
+		if (!i)
+			ndev->irq = irq;
+	}
+
+	ndev->netdev_ops = &amic_mace_netdev_ops;
+	ndev->watchdog_timeo = TX_TIMEOUT;
+	ndev->hw_features = NETIF_F_LOOPBACK;
+	ndev->priv_flags |= IFF_LIVE_ADDR_CHANGE;
+	netif_napi_add(ndev, &mp->napi, amic_mace_poll);
+	netif_carrier_off(ndev);
+
+	platform_set_drvdata(pdev, ndev);
+	ret = register_netdev(ndev);
+	if (ret) {
+		netif_napi_del(&mp->napi);
+		return ret;
+	}
+
+	netdev_info(ndev, "MACE %04x, address %pM, DMA rx %pad tx %pad\n",
+		    mp->chipid, ndev->dev_addr, &mp->rx.dma, &mp->tx.dma);
+	return 0;
+}
+
+static void amic_mace_remove(struct platform_device *pdev)
+{
+	struct net_device *ndev = platform_get_drvdata(pdev);
+	struct amic_mace *mp = netdev_priv(ndev);
+
+	unregister_netdev(ndev);
+	cancel_work_sync(&mp->reset_work);
+	netif_napi_del(&mp->napi);
+}
+
+static const struct of_device_id amic_mace_of_match[] = {
+	{ .compatible = "apple,amic-mace" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, amic_mace_of_match);
+
+static struct platform_driver amic_mace_driver = {
+	.probe	= amic_mace_probe,
+	.remove	= amic_mace_remove,
+	.driver	= {
+		.name		= DRV_NAME,
+		.of_match_table	= amic_mace_of_match,
+	},
+};
+module_platform_driver(amic_mace_driver);
+
+MODULE_AUTHOR("René Rebe <rene@exactco.de>");
+MODULE_DESCRIPTION("PDM Power Macintosh MACE Ethernet with AMIC DMA");
+MODULE_LICENSE("GPL");
