+	       fdt->dt_strings_size);
+	bootx_dt_strend = *mem_end = *mem_end + fdt->dt_strings_size;
+
+	bootx_dt_need_string("device_type", mem_end);
+	bootx_dt_need_string("compatible", mem_end);
+	bootx_dt_need_string("reg", mem_end);
+	bootx_dt_need_string("bootargs", mem_end);
+	bootx_dt_need_string("linux,bootx", mem_end);
+	bootx_dt_need_string("linux,bootx-machine-id", mem_end);
+	bootx_dt_need_string("linux,initrd-start", mem_end);
+	bootx_dt_need_string("linux,initrd-end", mem_end);
+	bootx_dt_need_string("linux,boot-display", mem_end);
+	bootx_dt_need_string("linux,opened", mem_end);
