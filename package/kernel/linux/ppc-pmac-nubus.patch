+# 603 kernel for the Performa 5200/6200 and the M2 PowerBooks (5300, 1400,
+# Duo 2300), on top of nubus_pmac_defconfig; PPC_PMAC for the M2 PMU
+# CONFIG_PPC_BOOK3S_601 is not set
+CONFIG_PPC_PMAC=y
+CONFIG_ADB_PMU=y
+CONFIG_ATA=y
+CONFIG_PATA_OF_PLATFORM=y
+CONFIG_MAC_SCSI=y
+CONFIG_SCSI_PERFORMA_ESP=y
+CONFIG_FB_VALKYRIE=y
