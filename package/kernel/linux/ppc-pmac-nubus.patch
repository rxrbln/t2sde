+	{ }
+};
+MODULE_DEVICE_TABLE(of, amic_awacs_of_match);
+
+static struct platform_driver amic_awacs_driver = {
+	.probe	= amic_awacs_probe,
+	.driver	= {
+		.name		= DRV_NAME,
+		.of_match_table	= amic_awacs_of_match,
+	},
+};
+module_platform_driver(amic_awacs_driver);
+
+MODULE_AUTHOR("René Rebe <rene@exactco.de>");
+MODULE_DESCRIPTION("PDM Power Macintosh AWACS sound with AMIC DMA");
+MODULE_LICENSE("GPL");
diff --git a/sound/ppc/primetime_asc.c b/sound/ppc/primetime_asc.c
new file mode 100644
index 000000000000..2e1b4816321c
--- /dev/null
+++ b/sound/ppc/primetime_asc.c
@@ -0,0 +1,461 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple Sound Chip (ASC) of the PrimeTime II I/O ASIC in the Performa/Power
+ * Macintosh 5200/6200.
+ *
+ * The ASC plays unsigned 8-bit samples from a 1 KB FIFO per channel (A
+ * left, B right), written byte by byte at the FIFO address, and interrupts
+ * through the pseudo VIA2 (CB1) when channel B drops below half full.  The
+ * driver then copies the next 512 frames from the ALSA buffer into both
+ * FIFOs by CPU, converting the sample format.  The EASC variant (version
+ * 0xb0, which MAME emulates for PrimeTime II) plays at 44.1 kHz and steps
+ * through the FIFOs at lower rates with its sample rate converter; other
+ * variants are driven at the fixed 22254.5 Hz Macintosh rate, which is not
+ * verified on PrimeTime II hardware.  Register usage follows MAME (asc.cpp,
+ * iosb.cpp) and arch/m68k/mac/macboing.c.  Recording and the DFAC II
+ * volume/input control (Cuda I2C) are not supported, the firmware settings
+ * of the DFAC II are kept.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+
+#include <sound/core.h>
+#include <sound/initval.h>
+#include <sound/pcm.h>
+
+#define DRV_NAME		"primetime-asc"
+
+#define ASC_FIFO_A		0x000
+#define ASC_FIFO_B		0x400
+#define ASC_VERSION		0x800
+#define ASC_MODE		0x801
+#define ASC_FIFO_MODE		0x803
+#define ASC_FIFO_STAT		0x804
+#define ASC_PLAY_REC_A		0x80a
+#define EASC_SRC_A		0xf04	/* 2 bytes */
+#define EASC_FIFO_CTRL_A	0xf08
+#define ASC_IRQ_CTRL_A		0xf09
+#define EASC_SRC_B		0xf24
+#define EASC_FIFO_CTRL_B	0xf28
+#define ASC_IRQ_CTRL_B		0xf29
+
+#define MODE_FIFO		0x01
+#define FIFO_CLEAR		0x80
+#define STAT_HALF_B		0x04	/* channel B below half full */
+#define STAT_EMPTY_B		0x08	/* channel B empty (or full) */
+#define FIFO_CTRL_SRC		0x80
+#define IRQ_DISABLE		0x01
+
+#define VERSION_EASC		0xb0
+#define EASC_RATE		44100
+#define MAC_RATE		22254
+#define FIFO_SIZE		1024
+#define FIFO_HALF		(FIFO_SIZE / 2)
+#define SILENCE			0x80
+#define MAX_QUEUE		(4 * FIFO_SIZE)	/* per interrupt */
+
+static int index = SNDRV_DEFAULT_IDX1;
+static char *id = SNDRV_DEFAULT_STR1;
+module_param(index, int, 0444);
+MODULE_PARM_DESC(index, "Index value for the PrimeTime ASC.");
+module_param(id, charp, 0444);
+MODULE_PARM_DESC(id, "ID string for the PrimeTime ASC.");
+
+struct primetime_asc {
+	struct snd_card *card;
+	void __iomem *regs;
+	int irq;
+	bool easc;
+	u8 version;
+
+	spinlock_t lock;	/* hardware and the state below */
+	struct snd_pcm_substream *substream;
+	bool running;			/* the FIFOs play the ALSA buffer */
+	bool feeding;			/* the FIFO interrupt is enabled */
+	unsigned int silence;		/* frames of silence still to queue */
+	/* below also protected by the PCM stream lock while running */
+	snd_pcm_uframes_t pos;		/* next frame to queue, as appl_ptr */
+	snd_pcm_uframes_t period_pos;	/* frames queued of the period */
+	u8 fifo[2][FIFO_HALF];
+};
+
+static void asc_clear_fifos(struct primetime_asc *chip)
+{
+	out_8(chip->regs + ASC_FIFO_MODE, FIFO_CLEAR);
+	out_8(chip->regs + ASC_FIFO_MODE, 0);
+}
+
+static void asc_stop_irq(struct primetime_asc *chip)
+{
+	out_8(chip->regs + ASC_IRQ_CTRL_B, IRQ_DISABLE);
+	chip->feeding = false;
+}
+
+static void asc_write_fifos(struct primetime_asc *chip)
+{
+	writesb(chip->regs + ASC_FIFO_A, chip->fifo[0], FIFO_HALF);
+	writesb(chip->regs + ASC_FIFO_B, chip->fifo[1], FIFO_HALF);
+}
+
+static void asc_queue_silence(struct primetime_asc *chip)
+{
+	memset(chip->fifo, SILENCE, sizeof(chip->fifo));
+	asc_write_fifos(chip);
+	chip->silence -= min_t(unsigned int, chip->silence, FIFO_HALF);
+}
+
+static u8 asc_sample(const u8 *p, snd_pcm_format_t format)
+{
+	int v;
+
+	switch (format) {
+	case SNDRV_PCM_FORMAT_U8:
+		return p[0];
+	case SNDRV_PCM_FORMAT_S8:
+		return p[0] ^ 0x80;
+	case SNDRV_PCM_FORMAT_S16_BE:
+		v = (s16)be16_to_cpup((const __be16 *)p);
+		break;
+	default:
+		v = (s16)le16_to_cpup((const __le16 *)p);
+		break;
+	}
+	/* round to 8 bits */
+	v = min((v + 0x80) >> 8, 127);
+	return v ^ 0x80;
+}
+
+/* queues half a FIFO from the ALSA buffer, silence beyond the application data */
+static void asc_queue(struct primetime_asc *chip, struct snd_pcm_runtime *rt)
+{
+	unsigned int width = snd_pcm_format_physical_width(rt->format) / 8;
+	snd_pcm_sframes_t avail = rt->control->appl_ptr - chip->pos;
+	snd_pcm_uframes_t off = chip->pos % rt->buffer_size;
+	unsigned int i, n;
+	const u8 *p;
+
+	if (avail < 0)
+		avail += rt->boundary;
+	n = avail > rt->buffer_size ? 0 : min_t(snd_pcm_sframes_t, avail, FIFO_HALF);
+	for (i = 0; i < n; i++) {
+		p = rt->dma_area + frames_to_bytes(rt, off);
+		chip->fifo[0][i] = asc_sample(p, rt->format);
+		chip->fifo[1][i] = rt->channels > 1 ?
+				   asc_sample(p + width, rt->format) :
+				   chip->fifo[0][i];
+		if (++off == rt->buffer_size)
+			off = 0;
+	}
+	memset(chip->fifo[0] + n, SILENCE, FIFO_HALF - n);
+	memset(chip->fifo[1] + n, SILENCE, FIFO_HALF - n);
+	asc_write_fifos(chip);
+
+	chip->pos += FIFO_HALF;
+	if (chip->pos >= rt->boundary)
+		chip->pos -= rt->boundary;
+	chip->period_pos += FIFO_HALF;
+}
+
+static irqreturn_t asc_irq(int irq, void *dev_id)
+{
+	struct primetime_asc *chip = dev_id;
+	struct snd_pcm_substream *ss = NULL;
+	bool elapsed = false;
+	unsigned int chunks, queued = 0;
+	u8 stat;
+
+	scoped_guard(spinlock, &chip->lock) {
+		if (!chip->feeding)
+			return IRQ_NONE;
+		if (chip->running)
+			ss = chip->substream;
+	}
+	/* the substream stays valid while running, see sync_stop */
+	if (ss)
+		snd_pcm_stream_lock(ss);
+	spin_lock(&chip->lock);
+	/*
+	 * The interrupt is edge latched in VIA2: refill until channel B is
+	 * above half full, the final status read releases the ASC interrupt.
+	 */
+	while (chip->feeding) {
+		stat = in_8(chip->regs + ASC_FIFO_STAT);
+		if (!(stat & STAT_HALF_B))
+			break;
+		if (queued >= MAX_QUEUE) {
+			dev_err_ratelimited(chip->card->dev,
+					    "FIFO stays below half full\n");
+			asc_stop_irq(chip);
+			break;
+		}
+		/* below half and empty: there is room for the whole FIFO */
+		for (chunks = stat & STAT_EMPTY_B ? 2 : 1; chunks; chunks--) {
+			if (ss && chip->running) {
+				asc_queue(chip, ss->runtime);
+			} else if (chip->running || chip->silence) {
+				asc_queue_silence(chip);
+			} else {
+				asc_stop_irq(chip);
+				break;
+			}
+			queued += FIFO_HALF;
+		}
+	}
+	if (ss && chip->running &&
+	    chip->period_pos >= ss->runtime->period_size) {
+		chip->period_pos %= ss->runtime->period_size;
+		elapsed = true;
+	}
+	spin_unlock(&chip->lock);
+	if (elapsed)
+		snd_pcm_period_elapsed_under_stream_lock(ss);
+	if (ss)
+		snd_pcm_stream_unlock(ss);
+	return IRQ_HANDLED;
+}
+
+/* PCM */
+
+static const struct snd_pcm_hardware asc_pcm_hw = {
+	.info			= SNDRV_PCM_INFO_MMAP |
+				  SNDRV_PCM_INFO_MMAP_VALID |
+				  SNDRV_PCM_INFO_INTERLEAVED |
+				  SNDRV_PCM_INFO_BLOCK_TRANSFER |
+				  SNDRV_PCM_INFO_BATCH,
+	.formats		= SNDRV_PCM_FMTBIT_U8 | SNDRV_PCM_FMTBIT_S8 |
+				  SNDRV_PCM_FMTBIT_S16_BE |
+				  SNDRV_PCM_FMTBIT_S16_LE,
+	.channels_min		= 1,
+	.channels_max		= 2,
+	.buffer_bytes_max	= 128 * 1024,
+	.period_bytes_min	= FIFO_HALF,
+	.period_bytes_max	= 64 * 1024,
+	.periods_min		= 2,
+	.periods_max		= 1024,
+};
+
+static int asc_pcm_open(struct snd_pcm_substream *ss)
+{
+	struct primetime_asc *chip = snd_pcm_substream_chip(ss);
+	struct snd_pcm_runtime *rt = ss->runtime;
+	int ret;
+
+	rt->hw = asc_pcm_hw;
+	if (chip->easc) {
+		rt->hw.rates = SNDRV_PCM_RATE_CONTINUOUS |
+			       SNDRV_PCM_RATE_8000_44100;
+		rt->hw.rate_min = 8000;
+		rt->hw.rate_max = EASC_RATE;
+	} else {
+		rt->hw.rates = SNDRV_PCM_RATE_KNOT;
+		rt->hw.rate_min = MAC_RATE;
+		rt->hw.rate_max = MAC_RATE;
+	}
+	ret = snd_pcm_hw_constraint_integer(rt, SNDRV_PCM_HW_PARAM_PERIODS);
+	if (ret < 0)
+		return ret;
+	/* a period takes at least one refill, the FIFO runs a period ahead */
+	ret = snd_pcm_hw_constraint_minmax(rt, SNDRV_PCM_HW_PARAM_PERIOD_SIZE,
+					   FIFO_HALF, UINT_MAX);
+	if (ret < 0)
+		return ret;
+	ret = snd_pcm_hw_constraint_minmax(rt, SNDRV_PCM_HW_PARAM_BUFFER_SIZE,
+					   2 * FIFO_SIZE, UINT_MAX);
+	if (ret < 0)
+		return ret;
+
+	guard(spinlock_irq)(&chip->lock);
+	chip->substream = ss;
+	return 0;
+}
+
+static int asc_pcm_close(struct snd_pcm_substream *ss)
+{
+	struct primetime_asc *chip = snd_pcm_substream_chip(ss);
+
+	guard(spinlock_irq)(&chip->lock);
+	chip->substream = NULL;
+	return 0;
+}
+
+static int asc_pcm_prepare(struct snd_pcm_substream *ss)
+{
+	struct primetime_asc *chip = snd_pcm_substream_chip(ss);
+	unsigned int rate = ss->runtime->rate;
+	u16 step;
+	u8 ctrl;
+
+	if (!chip->easc)
+		return 0;
+	/* 16.16 FIFO step per 44.1 kHz output sample, minus one */
+	step = DIV_ROUND_CLOSEST(rate << 16, EASC_RATE) - 1;
+	ctrl = rate < EASC_RATE ? FIFO_CTRL_SRC : 0;
+
+	guard(spinlock_irq)(&chip->lock);
+	out_8(chip->regs + EASC_SRC_A, step >> 8);
+	out_8(chip->regs + EASC_SRC_A + 1, step & 0xff);
+	out_8(chip->regs + EASC_SRC_B, step >> 8);
+	out_8(chip->regs + EASC_SRC_B + 1, step & 0xff);
+	out_8(chip->regs + EASC_FIFO_CTRL_A, ctrl);
+	out_8(chip->regs + EASC_FIFO_CTRL_B, ctrl);
+	return 0;
+}
+
+static int asc_pcm_trigger(struct snd_pcm_substream *ss, int cmd)
+{
+	struct primetime_asc *chip = snd_pcm_substream_chip(ss);
+	struct snd_pcm_runtime *rt = ss->runtime;
+
+	guard(spinlock)(&chip->lock);
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+		chip->pos = rt->status->hw_ptr;
+		chip->period_pos = chip->pos % rt->period_size;
+		chip->running = true;
+		/* a FIFO still playing silence is refilled by the interrupt */
+		if (!chip->feeding) {
+			asc_clear_fifos(chip);
+			asc_queue(chip, rt);
+			chip->feeding = true;
+			out_8(chip->regs + ASC_IRQ_CTRL_B, 0);
+		}
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+		/* the queued frames play out, followed by a FIFO of silence */
+		chip->running = false;
+		chip->silence = FIFO_SIZE;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static snd_pcm_uframes_t asc_pcm_pointer(struct snd_pcm_substream *ss)
+{
+	struct primetime_asc *chip = snd_pcm_substream_chip(ss);
+	struct snd_pcm_runtime *rt = ss->runtime;
+
+	/* at least half a FIFO is queued beyond the pointer */
+	rt->delay = FIFO_HALF;
+	return chip->pos % rt->buffer_size;
+}
+
+static int asc_pcm_sync_stop(struct snd_pcm_substream *ss)
+{
+	struct primetime_asc *chip = snd_pcm_substream_chip(ss);
+
+	synchronize_irq(chip->irq);
+	return 0;
+}
+
+static const struct snd_pcm_ops asc_pcm_ops = {
+	.open		= asc_pcm_open,
+	.close		= asc_pcm_close,
+	.prepare	= asc_pcm_prepare,
+	.trigger	= asc_pcm_trigger,
+	.sync_stop	= asc_pcm_sync_stop,
+	.pointer	= asc_pcm_pointer,
+};
+
+static void asc_hw_init(struct primetime_asc *chip)
+{
+	out_8(chip->regs + ASC_IRQ_CTRL_A, IRQ_DISABLE);
+	out_8(chip->regs + ASC_IRQ_CTRL_B, IRQ_DISABLE);
+	out_8(chip->regs + ASC_MODE, MODE_FIFO);
+	out_8(chip->regs + ASC_PLAY_REC_A, 0);
+	if (chip->easc) {
+		out_8(chip->regs + EASC_FIFO_CTRL_A, 0);
+		out_8(chip->regs + EASC_FIFO_CTRL_B, 0);
+	}
+	/* start from silence, the FIFOs play out and stay idle */
+	asc_clear_fifos(chip);
+	chip->silence = FIFO_SIZE;
+	while (chip->silence)
+		asc_queue_silence(chip);
+}
+
+static void asc_card_free(struct snd_card *card)
+{
+	struct primetime_asc *chip = card->private_data;
+
+	guard(spinlock_irq)(&chip->lock);
+	asc_stop_irq(chip);
+}
+
+static int primetime_asc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct primetime_asc *chip;
+	struct snd_card *card;
+	struct snd_pcm *pcm;
+	int ret;
+
+	ret = snd_devm_card_new(dev, index, id, THIS_MODULE, sizeof(*chip),
+				&card);
+	if (ret < 0)
+		return ret;
+	chip = card->private_data;
+	chip->card = card;
+	spin_lock_init(&chip->lock);
+
+	chip->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(chip->regs))
+		return PTR_ERR(chip->regs);
+	chip->irq = platform_get_irq(pdev, 0);
+	if (chip->irq < 0)
+		return chip->irq;
+
+	chip->version = in_8(chip->regs + ASC_VERSION);
+	chip->easc = chip->version == VERSION_EASC;
+	asc_hw_init(chip);
+	card->private_free = asc_card_free;
+
+	ret = devm_request_irq(dev, chip->irq, asc_irq, 0, dev_name(dev), chip);
+	if (ret)
+		return ret;
+
+	ret = snd_pcm_new(card, "ASC", 0, 1, 0, &pcm);
+	if (ret < 0)
+		return ret;
+	pcm->private_data = chip;
+	strscpy(pcm->name, "ASC");
+	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_PLAYBACK, &asc_pcm_ops);
+	snd_pcm_set_managed_buffer_all(pcm, SNDRV_DMA_TYPE_VMALLOC, NULL, 0, 0);
+
+	strscpy(card->driver, "PrimeTime ASC");
+	strscpy(card->shortname, "PrimeTime ASC");
+	snprintf(card->longname, sizeof(card->longname),
+		 "Apple Sound Chip version 0x%02x at %pOF, %s", chip->version,
+		 dev->of_node, chip->easc ? "8000-44100 Hz" : "22254 Hz");
+
+	ret = snd_card_register(card);
+	if (ret < 0)
+		return ret;
+	platform_set_drvdata(pdev, card);
+	return 0;
+}
+
+static const struct of_device_id primetime_asc_of_match[] = {
+	{ .compatible = "apple,primetime-asc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, primetime_asc_of_match);
+
+static struct platform_driver primetime_asc_driver = {
+	.probe	= primetime_asc_probe,
+	.driver	= {
+		.name		= DRV_NAME,
+		.of_match_table	= primetime_asc_of_match,
+	},
+};
+module_platform_driver(primetime_asc_driver);
+
+MODULE_AUTHOR("René Rebe <rene@exactco.de>");
+MODULE_DESCRIPTION("Performa 5200/6200 PrimeTime II Apple Sound Chip");
+MODULE_LICENSE("GPL");
