+static const void * __init bootx_nubus_dtb(u32 arch, u32 id)
+{
+	switch (arch) {
+	case BOOT_ARCH_NUBUS_PDM:
+		return __dtb_nubus_pdm_begin;
+	case BOOT_ARCH_NUBUS_PERFORMA:
+		return __dtb_nubus_performa_begin;
+	case BOOT_ARCH_NUBUS_POWERBOOK:
+		/* M2 (Whitney) only, not the 68k PowerBook 500 PPC upgrades */
+		if (id == 124)
+			return __dtb_nubus_m2_2300_begin;
+		if (id == 128 || id == 310)
+			return __dtb_nubus_m2_begin;
+		break;
+	}
+	return NULL;
+}
+
+/* lowest page aligned RAM at or above @from with @need bytes in one bank */
+static unsigned long __init bootx_find_ram(boot_infos_t *bi, unsigned long from,
+					   unsigned long need)
+{
+	u32 i, n = min_t(u32, bi->physMemoryMapSize, MAX_MEM_MAP_SIZE);
+	unsigned long best = 0;
+
+	for (i = 0; i < n; i++) {
+		unsigned long base = bi->physMemoryMap[i].physAddr;
+		unsigned long end = base + bi->physMemoryMap[i].size;
+		unsigned long p = PAGE_ALIGN(max(base, from));
+
+		if (p < end && end - p >= need && (!best || p < best))
+			best = p;
+	}
+	return best;
+}
+
+/*
+ * Sort and merge the DRAM banks: the kernel limits its early allocations
+ * to the first memory range.
+ */
+static u32 __init bootx_nubus_memory(boot_infos_t *bi)
+{
+	boot_info_map_entry_t *map = bi->physMemoryMap, tmp;
+	u32 i, j, n = 0, count;
+
+	count = min_t(u32, bi->physMemoryMapSize, MAX_MEM_MAP_SIZE);
+	for (i = 0; i < count; i++) {
+		if (!map[i].size)
+			continue;
+		tmp = map[i];
+		for (j = n; j > 0 && map[j - 1].physAddr > tmp.physAddr; j--)
+			map[j] = map[j - 1];
+		map[j] = tmp;
+		n++;
+	}
+	for (i = 1, j = 0; i < n; i++) {
+		if (map[j].physAddr + map[j].size == map[i].physAddr)
+			map[j].size += map[i].size;
+		else
+			map[++j] = map[i];
+	}
+	bi->physMemoryMapSize = n ? j + 1 : 0;
+	return bi->physMemoryMapSize;
+}
+
+static const void * __init bootx_nubus_find_dtb(boot_infos_t *bi)
+{
+	const struct boot_param_header *fdt;
+	u32 i, arch = 0;
+
+	if (!BOOT_INFO_IS_V4_COMPATIBLE(bi)) {
+		bootx_printf(" !!! NuBus needs boot info version 4\n");
+		return NULL;
+	}
+	for (i = 0; i < ARRAY_SIZE(bootx_nubus_machines); i++)
+		if (bootx_nubus_machines[i].id == bi->machineID)
+			arch = bootx_nubus_machines[i].arch;
+	if (!arch) {
+		bootx_printf(" !!! Unknown NuBus machine ID 0x%x\n",
+			     bi->machineID);
+		return NULL;
+	}
+	if ((bi->architecture & BOOT_ARCH_NUBUS_CLASS) &&
+	    !(bi->architecture & arch))
+		bootx_printf("WARNING: architecture 0x%x does not match machine ID 0x%x\n",
+			     bi->architecture, bi->machineID);
+
+	fdt = bootx_nubus_dtb(arch, bi->machineID);
+	if (!fdt) {
+		bootx_printf(" !!! No device tree for NuBus machine ID 0x%x\n",
+			     bi->machineID);
+		return NULL;
+	}
+	if (fdt->magic != OF_DT_HEADER || fdt->version < OF_DT_VERSION) {
+		bootx_printf(" !!! Invalid built-in device tree\n");
+		return NULL;
+	}
+	if (!bootx_nubus_memory(bi)) {
+		bootx_printf(" !!! No physical memory map\n");
+		return NULL;
+	}
+	return fdt;
+}
