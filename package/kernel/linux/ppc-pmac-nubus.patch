new file mode 100644
index 000000000000..71d78bb571f5
--- /dev/null
+++ b/drivers/scsi/amic_esp.c
@@ -0,0 +1,392 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ESP front-end for the NCR 53C94 and 53CF94 SCSI controllers of the NuBus
+ * Power Macintosh PDM family (6100, 7100, 8100) using the AMIC DMA channels.
+ *
+ * Based on the MkLinux osfmk scsi_amic.c and scsi_53C94_hdw.c.  The AMIC
+ * moves 16-bit words from the 53C9x into a 64-bit buffer and writes whole
+ * quadwords to 8-byte aligned memory; a partially filled quadword is only
+ * written out by a flush, again as a whole quadword.  Transfers therefore go
+ * through a per controller bounce buffer, which also keeps the caches in sync
+ * as MkLinux treats AMIC DMA as not cache coherent.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/sizes.h>
+
+#include <asm/cacheflush.h>
+
+#include <scsi/scsi_host.h>
+
+#include "esp_scsi.h"
+
+#define DRV_MODULE_NAME		"amic_esp"
+
+/* AMIC SCSI DMA control, from the big-endian bit numbers of MkLinux */
+#define AMIC_DMA_RESET		0x01
+#define AMIC_DMA_RUN		0x02
+#define AMIC_DMA_FLUSH		0x10
+#define AMIC_DMA_DIR		0x40	/* memory to SCSI */
+
+#define AMIC_DMA_TIMEOUT_US	10000
+#define AMIC_ESP_BOUNCE_SIZE	SZ_64K
+/* MkLinux keeps the 16-bit transfer count clear of the 0 = 64K encoding */
+#define AMIC_ESP_MAX_XFER	(SZ_64K - SZ_4K)
+
+/* DMA config 3 of MkLinux: threshold 8, alternate DMA, save residual byte */
+#define AMIC_ESP_DMA_CFG3	(ESP_CONFIG3_TEM | ESP_CONFIG3_ADMA | \
+				 ESP_CONFIG3_SRB)
+
+struct amic_esp_priv {
+	struct esp *esp;
+	void __iomem *dma_base;
+	void __iomem *dma_ctrl;
+	void *bounce;
+	dma_addr_t bounce_dma;
+	u8 *buf;
+	u32 len;
+	bool to_mem;
+	bool error;
+};
+
+static bool dma = true;
+module_param(dma, bool, 0444);
+MODULE_PARM_DESC(dma, "use AMIC DMA (default), otherwise programmed I/O");
+
+static inline struct amic_esp_priv *amic_esp_priv(struct esp *esp)
+{
+	return dev_get_drvdata(esp->dev);
+}
+
+static void amic_esp_write8(struct esp *esp, u8 val, unsigned long reg)
+{
+	out_8(esp->regs + reg * 16, val);
+}
+
+static u8 amic_esp_read8(struct esp *esp, unsigned long reg)
+{
+	return in_8(esp->regs + reg * 16);
+}
+
+#define esp_read8(REG)		amic_esp_read8(esp, REG)
+#define esp_write8(VAL, REG)	amic_esp_write8(esp, VAL, REG)
+
+static int amic_esp_irq_pending(struct esp *esp)
+{
+	return !!(esp_read8(ESP_STATUS) & ESP_STAT_INTR);
+}
+
+static u32 amic_esp_dma_length_limit(struct esp *esp, u32 dma_addr,
+				     u32 dma_len)
+{
+	return min_t(u32, dma_len, AMIC_ESP_MAX_XFER);
+}
+
+static int amic_dma_wait_clear(struct amic_esp_priv *p, u8 bits)
+{
+	int i;
+
+	for (i = 0; i < AMIC_DMA_TIMEOUT_US; i++) {
+		if (!(in_8(p->dma_ctrl) & bits))
+			return 0;
+		udelay(1);
+	}
+	dev_err(p->esp->dev, "AMIC DMA timeout, ctrl %02x\n",
+		in_8(p->dma_ctrl));
+	p->error = true;
+	return -ETIMEDOUT;
+}
+
+static void amic_dma_stop(struct amic_esp_priv *p)
+{
+	out_8(p->dma_ctrl, in_8(p->dma_ctrl) & ~AMIC_DMA_RUN);
+	amic_dma_wait_clear(p, AMIC_DMA_RUN);
+}
+
+static void amic_esp_reset_dma(struct esp *esp)
+{
+	struct amic_esp_priv *p = amic_esp_priv(esp);
+
+	out_8(p->dma_ctrl, AMIC_DMA_RESET);
+	amic_dma_wait_clear(p, AMIC_DMA_RUN);
+	p->len = 0;
+}
+
+static void amic_esp_dma_drain(struct esp *esp)
+{
+	struct amic_esp_priv *p = amic_esp_priv(esp);
+	u32 resid = 0, fifo, done;
+
+	if (!p->len || !p->to_mem)
+		return;
+
+	/* write out the partially filled quadword */
+	out_8(p->dma_ctrl, in_8(p->dma_ctrl) | AMIC_DMA_FLUSH);
+	amic_dma_wait_clear(p, AMIC_DMA_FLUSH);
+	amic_dma_stop(p);
+
+	if (!(esp->sreg & ESP_STAT_TCNT))
+		resid = esp_read8(ESP_TCLOW) | (esp_read8(ESP_TCMED) << 8);
+	resid = min(resid, p->len);
+	fifo = esp_read8(ESP_FFLAGS) & ESP_FF_FBYTES;
+	done = p->len - resid - min(fifo, p->len - resid);
+
+	flush_dcache_range((unsigned long)p->bounce,
+			   (unsigned long)p->bounce + ALIGN(done, 8));
+	memcpy(p->buf, p->bounce, done);
+
+	/* an odd last byte stays in the FIFO with 16-bit DMA */
+	while (done < p->len - resid)
+		p->buf[done++] = esp_read8(ESP_FDATA);
+	p->len = 0;
+}
+
+static void amic_esp_dma_invalidate(struct esp *esp)
+{
+	struct amic_esp_priv *p = amic_esp_priv(esp);
+
+	amic_dma_stop(p);
+	esp_write8(esp->prev_cfg3, ESP_CFG3);
+	p->len = 0;
+}
+
+static void amic_esp_send_dma_cmd(struct esp *esp, u32 addr, u32 esp_count,
+				  u32 dma_count, int write, u8 cmd)
+{
+	struct amic_esp_priv *p = amic_esp_priv(esp);
+	u32 phys = p->bounce_dma;
+
+	p->buf = (u8 *)(uintptr_t)addr;
+	p->len = dma_count;
+	p->to_mem = write;
+	p->error = false;
+
+	if (!write)
+		memcpy(p->bounce, p->buf, dma_count);
+	/* write back the data to send, drop cached lines over received data */
+	flush_dcache_range((unsigned long)p->bounce,
+			   (unsigned long)p->bounce + ALIGN(dma_count, 8));
+
+	out_8(p->dma_ctrl, in_8(p->dma_ctrl) | AMIC_DMA_RESET);
+	amic_dma_wait_clear(p, AMIC_DMA_RUN);
+	out_8(p->dma_base + 0, phys >> 24);
+	out_8(p->dma_base + 1, phys >> 16);
+	out_8(p->dma_base + 2, phys >> 8);
+	out_8(p->dma_base + 3, phys);
+	/* run before the command so the FIFO drains while still in data phase */
+	out_8(p->dma_ctrl, write ? AMIC_DMA_RUN : AMIC_DMA_DIR | AMIC_DMA_RUN);
+
+	esp_write8(esp->prev_cfg3 | AMIC_ESP_DMA_CFG3, ESP_CFG3);
+	esp_write8(esp_count & 0xff, ESP_TCLOW);
+	esp_write8((esp_count >> 8) & 0xff, ESP_TCMED);
+	scsi_esp_cmd(esp, cmd);
+}
+
+static int amic_esp_dma_error(struct esp *esp)
+{
+	return amic_esp_priv(esp)->error;
+}
+
+static const struct esp_driver_ops amic_esp_dma_ops = {
+	.esp_write8	  = amic_esp_write8,
+	.esp_read8	  = amic_esp_read8,
+	.irq_pending	  = amic_esp_irq_pending,
+	.dma_length_limit = amic_esp_dma_length_limit,
+	.reset_dma	  = amic_esp_reset_dma,
+	.dma_drain	  = amic_esp_dma_drain,
+	.dma_invalidate	  = amic_esp_dma_invalidate,
+	.send_dma_cmd	  = amic_esp_send_dma_cmd,
+	.dma_error	  = amic_esp_dma_error,
+};
+
+static void amic_esp_pio_nop(struct esp *esp)
+{
+}
+
+static int amic_esp_pio_error(struct esp *esp)
+{
+	return esp->send_cmd_error;
+}
+
+static const struct esp_driver_ops amic_esp_pio_ops = {
+	.esp_write8	  = amic_esp_write8,
+	.esp_read8	  = amic_esp_read8,
+	.irq_pending	  = amic_esp_irq_pending,
+	.dma_length_limit = amic_esp_dma_length_limit,
+	.reset_dma	  = amic_esp_pio_nop,
+	.dma_drain	  = amic_esp_pio_nop,
+	.dma_invalidate	  = amic_esp_pio_nop,
+	.send_dma_cmd	  = esp_send_pio_cmd,
+	.dma_error	  = amic_esp_pio_error,
+};
+
+/* FIFO loopback as in MkLinux, only 8100 class machines have the 53CF94 */
+static bool amic_esp_present(struct esp *esp)
+{
+	bool ok;
+
+	esp_write8(ESP_CMD_FLUSH, ESP_CMD);
+	udelay(100);
+	esp_write8(0x55, ESP_FDATA);
+	esp_write8(0xaa, ESP_FDATA);
+	ok = (esp_read8(ESP_FFLAGS) & ESP_FF_FBYTES) == 2 &&
+	     esp_read8(ESP_FDATA) == 0x55 && esp_read8(ESP_FDATA) == 0xaa;
+	esp_write8(ESP_CMD_FLUSH, ESP_CMD);
+	return ok;
+}
+
+static int amic_esp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct amic_esp_priv *p;
+	struct Scsi_Host *host;
+	struct esp *esp;
+	u32 cfreq;
+	int err;
+
+	if (of_property_read_u32(dev->of_node, "clock-frequency", &cfreq))
+		return dev_err_probe(dev, -EINVAL, "no clock-frequency\n");
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	host = scsi_host_alloc(&scsi_esp_template, sizeof(struct esp));
+	if (!host)
+		return -ENOMEM;
+	host->max_id = 8;
+
+	esp = shost_priv(host);
+	esp->host = host;
+	esp->dev = dev;
+	esp->cfreq = cfreq;
+	esp->scsi_id = 7;
+	host->this_id = esp->scsi_id;
+	esp->scsi_id_mask = BIT(esp->scsi_id);
+	p->esp = esp;
+	dev_set_drvdata(dev, p);
+
+	esp->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(esp->regs)) {
+		err = PTR_ERR(esp->regs);
+		goto fail_host;
+	}
+	esp->fifo_reg = esp->regs + ESP_FDATA * 16;
+
+	if (!amic_esp_present(esp)) {
+		err = -ENODEV;
+		goto fail_host;
+	}
+
+	if (dma) {
+		p->dma_base = devm_platform_ioremap_resource(pdev, 1);
+		p->dma_ctrl = devm_platform_ioremap_resource(pdev, 2);
+		if (IS_ERR(p->dma_base) || IS_ERR(p->dma_ctrl)) {
+			dev_warn(dev, "no AMIC DMA registers\n");
+			p->dma_base = NULL;
+		}
+	}
+
+	if (p->dma_base) {
+		err = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+		if (err)
+			goto fail_host;
+		p->bounce = dma_alloc_coherent(dev, AMIC_ESP_BOUNCE_SIZE,
+					       &p->bounce_dma, GFP_KERNEL);
+		if (!p->bounce) {
+			err = -ENOMEM;
+			goto fail_host;
+		}
+		esp->dma_regs = p->dma_ctrl;
+		esp->ops = &amic_esp_dma_ops;
+		amic_esp_reset_dma(esp);
+	} else {
+		esp->ops = &amic_esp_pio_ops;
+		/* PIO leaves the transfer counter untouched */
+		esp_write8(0, ESP_TCLOW);
+		esp_write8(0, ESP_TCMED);
+	}
+
+	/* the core passes virtual addresses, all transfers are bounced or PIO */
+	esp->flags = ESP_FLAG_NO_DMA_MAP | ESP_FLAG_USE_FIFO |
+		     ESP_FLAG_DISABLE_SYNC;
+
+	esp->command_block = kzalloc(16, GFP_KERNEL);
+	if (!esp->command_block) {
+		err = -ENOMEM;
+		goto fail_bounce;
+	}
+	esp->command_block_dma = (uintptr_t)esp->command_block;
+
+	err = platform_get_irq(pdev, 0);
+	if (err < 0)
+		goto fail_cmd;
+	host->irq = err;
+	err = request_irq(host->irq, scsi_esp_intr, 0, DRV_MODULE_NAME, esp);
+	if (err)
+		goto fail_cmd;
+
+	dev_info(dev, "%s\n", p->dma_base ? "AMIC DMA" : "PIO");
+
+	err = scsi_esp_register(esp);
+	if (err)
+		goto fail_irq;
+	return 0;
+
+fail_irq:
+	free_irq(host->irq, esp);
+fail_cmd:
+	kfree(esp->command_block);
+fail_bounce:
+	if (p->bounce)
+		dma_free_coherent(dev, AMIC_ESP_BOUNCE_SIZE, p->bounce,
+				  p->bounce_dma);
+fail_host:
+	scsi_host_put(host);
+	return err;
+}
+
+static void amic_esp_remove(struct platform_device *pdev)
+{
+	struct amic_esp_priv *p = platform_get_drvdata(pdev);
+	struct esp *esp = p->esp;
+
+	scsi_esp_unregister(esp);
+	free_irq(esp->host->irq, esp);
+	if (p->bounce) {
+		amic_esp_reset_dma(esp);
+		dma_free_coherent(esp->dev, AMIC_ESP_BOUNCE_SIZE, p->bounce,
+				  p->bounce_dma);
+	}
+	kfree(esp->command_block);
+	scsi_host_put(esp->host);
+}
+
+static const struct of_device_id amic_esp_match[] = {
+	{ .compatible = "apple,amic-esp" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, amic_esp_match);
+
+static struct platform_driver amic_esp_driver = {
+	.probe	= amic_esp_probe,
+	.remove	= amic_esp_remove,
+	.driver	= {
+		.name		= DRV_MODULE_NAME,
+		.of_match_table	= amic_esp_match,
+	},
+};
+module_platform_driver(amic_esp_driver);
+
+MODULE_DESCRIPTION("NuBus Power Macintosh 53C94/53CF94 ESP SCSI driver");
+MODULE_AUTHOR("René Rebe <rene@exactco.de>");
+MODULE_LICENSE("GPL");
