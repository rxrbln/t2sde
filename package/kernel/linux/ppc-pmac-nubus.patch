diff --git a/arch/powerpc/platforms/nubus/setup.c b/arch/powerpc/platforms/nubus/setup.c
new file mode 100644
index 000000000000..4f7420335b48
--- /dev/null
+++ b/arch/powerpc/platforms/nubus/setup.c
@@ -0,0 +1,349 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NuBus Power Macintosh setup.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/adb.h>
+#include <linux/cuda.h>
+#include <linux/extable.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pmu.h>
+#include <linux/reboot.h>
+#include <linux/seq_file.h>
+
+#include <asm/cputable.h>
+#include <asm/early_ioremap.h>
+#include <asm/hwtest.h>
+#include <asm/machdep.h>
+#include <asm/pmac_feature.h>
+#include <asm/time.h>
+#include <asm/udbg.h>
+
+#include "nubus.h"
+
+#ifndef CONFIG_PPC_PMAC
+sys_ctrler_t sys_ctrler = SYS_CTRLER_UNKNOWN;
+EXPORT_SYMBOL(sys_ctrler);
+#endif
+
+/* the Z85C30 console ports, set up before the serial driver probes */
+static struct resource scc_a_rsrcs[2], scc_b_rsrcs[2];
+
+struct platform_device scc_a_pdev = {
+	.name		= "scc",
+	.id		= 0,
+};
+EXPORT_SYMBOL(scc_a_pdev);
+
+struct platform_device scc_b_pdev = {
+	.name		= "scc",
+	.id		= 1,
+};
+EXPORT_SYMBOL(scc_b_pdev);
+
+static void __init nubus_pmac_scc_init(void)
+{
+	struct device_node *np;
+	struct resource r;
+	int irq;
+
+	np = of_find_compatible_node(NULL, NULL, "apple,nubus-escc");
+	if (!np)
+		return;
+	irq = irq_of_parse_and_map(np, 0);
+	if (of_address_to_resource(np, 0, &r) || !irq) {
+		of_node_put(np);
+		return;
+	}
+	of_node_put(np);
+
+	/* channel B control at +0, channel A control at +2 */
+	scc_a_rsrcs[0] = DEFINE_RES_MEM(r.start + 2, 1);
+	scc_b_rsrcs[0] = DEFINE_RES_MEM(r.start, 1);
+	scc_a_rsrcs[1] = DEFINE_RES_IRQ(irq);
+	scc_b_rsrcs[1] = DEFINE_RES_IRQ(irq);
+	scc_a_pdev.resource = scc_a_rsrcs;
+	scc_a_pdev.num_resources = ARRAY_SIZE(scc_a_rsrcs);
+	scc_b_pdev.resource = scc_b_rsrcs;
+	scc_b_pdev.num_resources = ARRAY_SIZE(scc_b_rsrcs);
+}
+
+static int __init nubus_pmac_scc_register(void)
+{
+	if (!scc_a_pdev.num_resources)
+		return 0;
+	platform_device_register(&scc_a_pdev);
+	platform_device_register(&scc_b_pdev);
+	return 0;
+}
+machine_arch_initcall(nubus_pmac, nubus_pmac_scc_register);
+
+static const struct of_device_id nubus_pmac_bus_ids[] __initconst = {
+	{ .compatible = "simple-bus", },
+	{},
+};
+
+static int __init nubus_pmac_declare_devices(void)
+{
+	return of_platform_bus_probe(NULL, nubus_pmac_bus_ids, NULL);
+}
+machine_device_initcall(nubus_pmac, nubus_pmac_declare_devices);
+
+static void __init nubus_pmac_setup_arch(void)
+{
+	if (IS_ENABLED(CONFIG_PPC_UDBG_SCC_NUBUS))
+		udbg_scc_nubus_init();
+	amic_dma_reserve();
+}
+
+/* VIA timer 1 counts at C7M/10 on all NuBus Power Macintoshes */
+#define VIA_T1_HZ	783360
+#define VIA_RS		0x200
+#define VIA_T1CL	(4 * VIA_RS)
+#define VIA_T1CH	(5 * VIA_RS)
+#define VIA_T1LL	(6 * VIA_RS)
+#define VIA_T1LH	(7 * VIA_RS)
+#define VIA_ACR		(11 * VIA_RS)
+#define VIA_IFR		(13 * VIA_RS)
+#define VIA_T1_CONT	0x40
+#define VIA_T1_MODE	0xc0
+#define VIA_T1_INT	0x40
+
+/* measure the timebase of 603/604 machines over 10 ms of VIA timer 1 */
+static bool __init nubus_pmac_via_calibrate(void)
+{
+	unsigned int count = VIA_T1_HZ / 100, dstart, dend;
+	struct device_node *np;
+	struct resource r;
+	u8 __iomem *via;
+
+	np = of_find_node_by_name(NULL, "via-cuda");
+	if (!np)
+		np = of_find_node_by_name(NULL, "via-pmu");
+	if (!np || of_address_to_resource(np, 0, &r)) {
+		of_node_put(np);
+		return false;
+	}
+	of_node_put(np);
+	via = early_ioremap(r.start, resource_size(&r));
+	if (!via)
+		return false;
+
+	out_8(via + VIA_ACR, (in_8(via + VIA_ACR) & ~VIA_T1_MODE) | VIA_T1_CONT);
+	out_8(via + VIA_T1CH, 2);
+	out_8(via + VIA_T1LL, count);
+	out_8(via + VIA_T1LH, count >> 8);
+	while (!(in_8(via + VIA_IFR) & VIA_T1_INT))
+		;
+	dstart = get_dec();
+	in_8(via + VIA_T1CL);
+	while (!(in_8(via + VIA_IFR) & VIA_T1_INT))
+		;
+	dend = get_dec();
+	early_iounmap((void __force *)via, resource_size(&r));
+
+	ppc_tb_freq = (dstart - dend) * 100;
+	pr_info("NuBus PowerMac: timebase %lu Hz measured with VIA timer 1\n",
+		ppc_tb_freq);
+	return true;
+}
+
+static void __init nubus_pmac_calibrate_decr(void)
+{
+	struct device_node *cpu = of_find_node_by_type(NULL, "cpu");
+	u32 clock;
+
+	/* the 601 RTC is fixed in the device tree, the 603 timebase is bus/4 */
+	if (of_property_present(cpu, "timebase-frequency") ||
+	    !nubus_pmac_via_calibrate()) {
+		generic_calibrate_decr();
+	} else if (!of_property_read_u32(cpu, "clock-frequency", &clock)) {
+		ppc_proc_freq = clock;
+	}
+	of_node_put(cpu);
+}
+
+static unsigned int nubus_pmac_no_irq(void)
+{
+	return 0;
+}
+
+static void __init nubus_pmac_init_IRQ(void)
+{
+	struct device_node *np;
+
+	static const struct of_device_id pics[] = {
+		{ .compatible = "apple,amic-pic", .data = amic_pic_init },
+		{ .compatible = "apple,capella-pic", .data = iosb_pic_init },
+		{ .compatible = "apple,m2-pic", .data = iosb_pic_init },
+		{}
+	};
+	const struct of_device_id *match;
+	int (*init)(struct device_node *np);
+
+	np = of_find_matching_node_and_match(NULL, pics, &match);
+	init = match ? match->data : NULL;
+	if (np && init && !init(np)) {
+		ppc_md.get_irq = init == amic_pic_init ? amic_get_irq :
+							 iosb_get_irq;
+	} else {
+		pr_err("NuBus PowerMac: no supported interrupt controller\n");
+		ppc_md.get_irq = nubus_pmac_no_irq;
+	}
+	of_node_put(np);
+
+	nubus_pmac_scc_init();
+	if (IS_ENABLED(CONFIG_ADB_CUDA))
+		find_via_cuda();
+	if (IS_ENABLED(CONFIG_ADB_PMU))
+		find_via_pmu();
+}
+
+extern const char hwreg_present_end[];
+
+/* recover the machine check of a hwreg_present() probe */
+static bool hwreg_machine_check(struct pt_regs *regs)
+{
+	const struct exception_table_entry *entry;
+
+	if (regs->nip < (unsigned long)hwreg_present ||
+	    regs->nip >= (unsigned long)hwreg_present_end)
+		return false;
+
+	entry = search_exception_tables(regs->nip);
+	if (!entry)
+		return false;
+
+	regs_set_recoverable(regs);
+	regs_set_return_ip(regs, extable_fixup(entry));
+	return true;
+}
+
+static int nubus_pmac_machine_check(struct pt_regs *regs)
+{
+	if (hwreg_machine_check(regs))
+		return 1;
+
+	return cur_cpu_spec->machine_check ? cur_cpu_spec->machine_check(regs) : 0;
+}
+
+static void nubus_pmac_show_cpuinfo(struct seq_file *m)
+{
+	struct device_node *root = of_find_node_by_path("/");
+	const char *model = NULL;
+
+	if (root)
+		of_property_read_string(root, "model", &model);
+	seq_printf(m, "machine\t\t: %s\n", model ?: "NuBus Power Macintosh");
+	of_node_put(root);
+}
+
+static bool nubus_pmac_has_cuda(void)
+{
+	return IS_ENABLED(CONFIG_ADB_CUDA) && sys_ctrler == SYS_CTRLER_CUDA;
+}
+
+static bool nubus_pmac_has_pmu(void)
+{
+	return IS_ENABLED(CONFIG_ADB_PMU) && sys_ctrler == SYS_CTRLER_PMU;
+}
+
+static void __noreturn nubus_pmac_cuda_cmd(u8 cmd)
+{
+#ifdef CONFIG_ADB_CUDA
+	struct adb_request req;
+
+	cuda_request(&req, NULL, 2, CUDA_PACKET, cmd);
+	for (;;)
+		cuda_poll();
+#else
+	for (;;)
+		;
+#endif
+}
+
+static void __noreturn nubus_pmac_halt(void)
+{
+	local_irq_disable();
+	for (;;)
+		;
+}
+
+static void __noreturn nubus_pmac_restart(char *cmd)
+{
+	local_irq_disable();
+	if (nubus_pmac_has_cuda())
+		nubus_pmac_cuda_cmd(CUDA_RESET_SYSTEM);
+	if (nubus_pmac_has_pmu())
+		pmu_restart();
+	nubus_pmac_halt();
+}
+
+static void __noreturn nubus_pmac_power_off(void)
+{
+	local_irq_disable();
+	if (nubus_pmac_has_cuda())
+		nubus_pmac_cuda_cmd(CUDA_POWERDOWN);
+	if (nubus_pmac_has_pmu())
+		pmu_shutdown();
+	nubus_pmac_halt();
+}
+
+#if defined(CONFIG_ADB_CUDA) || defined(CONFIG_ADB_PMU)
+static time64_t nubus_pmac_get_boot_time(void)
+{
+	if (nubus_pmac_has_cuda())
+		return cuda_get_time();
+	if (nubus_pmac_has_pmu())
+		return pmu_get_time();
+	return 0;
+}
+
+static void nubus_pmac_get_rtc_time(struct rtc_time *tm)
+{
+	rtc_time64_to_tm(nubus_pmac_get_boot_time(), tm);
+}
+
+static int nubus_pmac_set_rtc_time(struct rtc_time *tm)
+{
+	if (nubus_pmac_has_cuda())
+		return cuda_set_rtc_time(tm);
+	if (nubus_pmac_has_pmu())
+		return pmu_set_rtc_time(tm);
+	return -ENODEV;
+}
+#endif
+
+static int __init nubus_pmac_late_init(void)
+{
+	if (!pm_power_off)
+		pm_power_off = nubus_pmac_power_off;
+	return 0;
+}
+machine_late_initcall(nubus_pmac, nubus_pmac_late_init);
+
+define_machine(nubus_pmac) {
+	.name			= "NuBus PowerMac",
+	.compatible		= "apple,nubus-pmac",
+	.setup_arch		= nubus_pmac_setup_arch,
+	.show_cpuinfo		= nubus_pmac_show_cpuinfo,
+	.init_IRQ		= nubus_pmac_init_IRQ,
+	.machine_check_exception = nubus_pmac_machine_check,
+	.calibrate_decr		= nubus_pmac_calibrate_decr,
+#if defined(CONFIG_ADB_CUDA) || defined(CONFIG_ADB_PMU)
+	.get_boot_time		= nubus_pmac_get_boot_time,
+	.get_rtc_time		= nubus_pmac_get_rtc_time,
+	.set_rtc_time		= nubus_pmac_set_rtc_time,
+#endif
+	.restart		= nubus_pmac_restart,
+	.halt			= nubus_pmac_halt,
+	.progress		= udbg_progress,
+};
diff --git a/arch/powerpc/platforms/nubus/udbg_scc.c b/arch/powerpc/platforms/nubus/udbg_scc.c
new file mode 100644
index 000000000000..8f828be913e6
--- /dev/null
+++ b/arch/powerpc/platforms/nubus/udbg_scc.c
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * udbg for the Z85C30 SCC of the NuBus Power Macintosh.
+ *
+ * The SCC is a byte device at even addresses: channel B control at +0,
+ * channel A control at +2, the data registers 4 bytes after control.
+ * Based on arch/powerpc/platforms/powermac/udbg_scc.c and the "pre_pci"
+ * support of the nubus-pmac project.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+
+#include <asm/early_ioremap.h>
+#include <asm/udbg.h>
+
+#include "nubus.h"
+
+#define SCC_TXRDY	4
+#define SCC_RXRDY	1
+
+static u8 __iomem *sccc;
+static u8 __iomem *sccd;
+static void __iomem *scc_early;
+static struct resource scc_res;
+
+static void udbg_scc_nubus_putc(char c)
+{
+	while (!(in_8(sccc) & SCC_TXRDY))
+		;
+	out_8(sccd, c);
+	if (c == '\n')
+		udbg_scc_nubus_putc('\r');
+}
+
+static int udbg_scc_nubus_getc_poll(void)
+{
+	if (in_8(sccc) & SCC_RXRDY)
+		return in_8(sccd);
+	return -1;
+}
+
+static int udbg_scc_nubus_getc(void)
+{
+	while (!(in_8(sccc) & SCC_RXRDY))
+		;
+	return in_8(sccd);
+}
+
+void __init udbg_scc_nubus_init(void)
+{
+	static u8 inittab[] = {
+		9, 0xc0,	/* hardware reset */
+		4, 0x44,	/* x16 clock, 1 stop */
+		3, 0xc0,	/* rx 8 bits */
+		5, 0x60,	/* tx 8 bits */
+		11, 0x50,	/* clocks = br gen */
+		12, 0,		/* baud rate divisor, low */
+		13, 0,		/* high */
+		14, 1,		/* baud rate gen enable, src=rtxc */
+		3, 0xc1,	/* rx enable */
+		5, 0xea,	/* tx enable, assert DTR & RTS */
+	};
+	struct device_node *np;
+	u32 clk = 3686400, speed = 9600, tc;
+	unsigned int i;
+	int err;
+
+	np = of_find_compatible_node(NULL, NULL, "apple,nubus-escc");
+	if (!np)
+		return;
+	of_property_read_u32(np, "clock-frequency", &clk);
+	of_property_read_u32(np, "current-speed", &speed);
+	err = of_address_to_resource(np, 0, &scc_res);
+	of_node_put(np);
+	if (err)
+		return;
+
+	/* slab is not up yet, remapped by udbg_scc_nubus_remap() */
+	scc_early = early_ioremap(scc_res.start, resource_size(&scc_res));
+	if (!scc_early)
+		return;
+
+	/* channel A, the modem port */
+	sccc = scc_early + 2;
+	sccd = sccc + 4;
+
+	/* baud rate generator time constant for x16 clock mode */
+	tc = clk / (2 * 16 * speed) - 2;
+	inittab[11] = tc & 0xff;
+	inittab[13] = tc >> 8;
+
+	in_8(sccc);	/* reset the register pointer */
+	for (i = 0; i < sizeof(inittab); i++)
+		out_8(sccc, inittab[i]);
+
+	udbg_putc = udbg_scc_nubus_putc;
+	udbg_getc = udbg_scc_nubus_getc;
+	udbg_getc_poll = udbg_scc_nubus_getc_poll;
+	register_early_udbg_console();
+}
+
+static int __init udbg_scc_nubus_remap(void)
+{
+	void __iomem *base;
+
+	if (!scc_early)
+		return 0;
+
+	base = ioremap(scc_res.start, resource_size(&scc_res));
+	if (WARN_ON(!base))
+		return -ENOMEM;
+
+	sccc = base + 2;
+	sccd = sccc + 4;
+	early_iounmap(scc_early, resource_size(&scc_res));
+	scc_early = NULL;
+	return 0;
+}
+early_initcall(udbg_scc_nubus_remap);
diff --git a/arch/powerpc/platforms/powermac/Makefile b/arch/powerpc/platforms/powermac/Makefile
index cf85f0662d0d..7d965c337d43 100644
--- a/arch/powerpc/platforms/powermac/Makefile
+++ b/arch/powerpc/platforms/powermac/Makefile
@@ -13,6 +13,7 @@ ifdef CONFIG_FUNCTION_TRACER
 CFLAGS_REMOVE_bootx_init.o = $(CC_FLAGS_FTRACE)
 endif
 
+ifdef CONFIG_PPC_PMAC
 obj-y				+= pic.o setup.o time.o feature.o pci.o \
 				   sleep.o low_i2c.o cache.o pfunc_core.o \
