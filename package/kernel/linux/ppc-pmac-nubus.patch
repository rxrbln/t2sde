diff --git a/drivers/scsi/performa_esp.c b/drivers/scsi/performa_esp.c
new file mode 100644
index 000000000000..abd83d6607d1
--- /dev/null
+++ b/drivers/scsi/performa_esp.c
@@ -0,0 +1,334 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ESP front-end for the NCR 53C96 of the Power Macintosh/Performa 5200/6200
+ * family (F108, PrimeTime II "TurboSCSI" pseudo DMA).
+ *
+ * MkLinux drives the controller by programmed I/O, which is the default.
+ * As on the Quadra 630 (mac_esp) the 16-bit DMA handshake of the 53C96 can
+ * also be served by CPU accesses to the pseudo DMA port, which the I/O
+ * controller holds off until DREQ.  To never stall on a target that changed
+ * phase or disconnected, the port is only accessed for the bytes resp. the
+ * space the FIFO flags report.  An odd last received byte is kept in the
+ * FIFO (save residual byte) and read from the FIFO register.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/sizes.h>
+
+#include <scsi/scsi_host.h>
+
+#include "esp_scsi.h"
+
+#define DRV_MODULE_NAME		"performa_esp"
+
+#define PERFORMA_ESP_FIFO_SIZE	16
+#define PERFORMA_ESP_TIMEOUT_US	500000
+#define PERFORMA_ESP_MAX_XFER	(SZ_64K - SZ_4K)
+
+struct performa_esp_priv {
+	struct esp *esp;
+	void __iomem *pdma;
+	u8 *buf;
+	u32 len;
+	u32 done;
+	bool to_mem;
+	bool error;
+};
+
+static bool pdma;
+module_param(pdma, bool, 0444);
+MODULE_PARM_DESC(pdma, "use pseudo DMA, default programmed I/O");
+
+static inline struct performa_esp_priv *performa_esp_priv(struct esp *esp)
+{
+	return dev_get_drvdata(esp->dev);
+}
+
+static void performa_esp_write8(struct esp *esp, u8 val, unsigned long reg)
+{
+	out_8(esp->regs + reg * 16, val);
+}
+
+static u8 performa_esp_read8(struct esp *esp, unsigned long reg)
+{
+	return in_8(esp->regs + reg * 16);
+}
+
+#define esp_read8(REG)		performa_esp_read8(esp, REG)
+#define esp_write8(VAL, REG)	performa_esp_write8(esp, VAL, REG)
+
+static int performa_esp_irq_pending(struct esp *esp)
+{
+	return !!(esp_read8(ESP_STATUS) & ESP_STAT_INTR);
+}
+
+static u32 performa_esp_dma_length_limit(struct esp *esp, u32 dma_addr,
+					 u32 dma_len)
+{
+	return min_t(u32, dma_len, PERFORMA_ESP_MAX_XFER);
+}
+
+static void performa_esp_reset_dma(struct esp *esp)
+{
+	performa_esp_priv(esp)->len = 0;
+}
+
+/* move the bytes still in the FIFO, at most up to the received count */
+static void performa_esp_dma_drain(struct esp *esp)
+{
+	struct performa_esp_priv *p = performa_esp_priv(esp);
+	u32 resid = 0, fifo;
+
+	if (!p->len || !p->to_mem)
+		return;
+
+	if (!(esp->sreg & ESP_STAT_TCNT))
+		resid = esp_read8(ESP_TCLOW) | (esp_read8(ESP_TCMED) << 8);
+	resid = min(resid, p->len);
+	fifo = esp_read8(ESP_FFLAGS) & ESP_FF_FBYTES;
+	while (fifo-- && p->done < p->len - resid)
+		p->buf[p->done++] = esp_read8(ESP_FDATA);
+	if (p->done != p->len - resid) {
+		dev_err(esp->dev, "data in: %u of %u bytes moved\n", p->done,
+			p->len - resid);
+		p->error = true;
+	}
+	p->len = 0;
+}
+
+static void performa_esp_dma_invalidate(struct esp *esp)
+{
+	esp_write8(esp->prev_cfg3, ESP_CFG3);
+	performa_esp_priv(esp)->len = 0;
+}
+
+static void performa_esp_send_dma_cmd(struct esp *esp, u32 addr, u32 esp_count,
+				      u32 dma_count, int write, u8 cmd)
+{
+	struct performa_esp_priv *p = performa_esp_priv(esp);
+	unsigned int timeout = PERFORMA_ESP_TIMEOUT_US;
+	u8 *buf = (u8 *)(uintptr_t)addr;
+	u32 left = dma_count, n;
+
+	p->buf = buf;
+	p->len = dma_count;
+	p->to_mem = write;
+	p->error = false;
+
+	if (write)
+		esp_write8(esp->prev_cfg3 | ESP_CONFIG3_SRB, ESP_CFG3);
+	else
+		scsi_esp_cmd(esp, ESP_CMD_FLUSH);
+	esp_write8(esp_count & 0xff, ESP_TCLOW);
+	esp_write8((esp_count >> 8) & 0xff, ESP_TCMED);
+	scsi_esp_cmd(esp, cmd);
+
+	while (left) {
+		n = esp_read8(ESP_FFLAGS) & ESP_FF_FBYTES;
+		/* received bytes resp. free space, DREQ needs a word of it */
+		if (!write)
+			n = PERFORMA_ESP_FIFO_SIZE - n;
+
+		if (n >= 2 && left >= 2) {
+			n = min(n, left) >> 1;
+			left -= n << 1;
+			for (; n; n--, buf += 2) {
+				if (write) {
+					u16 w = in_be16(p->pdma);
+
+					buf[0] = w >> 8;
+					buf[1] = w;
+				} else {
+					out_be16(p->pdma, buf[0] << 8 | buf[1]);
+				}
+			}
+			timeout = PERFORMA_ESP_TIMEOUT_US;
+			continue;
+		}
+		if (!write && n >= 2) {
+			out_8(p->pdma, *buf++);
+			left--;
+			continue;
+		}
+		/* the odd last byte is read from the FIFO by the drain */
+		if (write && left == 1)
+			break;
+		if (esp_read8(ESP_STATUS) & ESP_STAT_INTR)
+			break;
+		if (!--timeout) {
+			dev_err(esp->dev, "pseudo DMA timeout, %u of %u bytes left\n",
+				left, dma_count);
+			p->error = true;
+			break;
+		}
+		udelay(1);
+	}
+	p->done = dma_count - left;
+}
+
+static int performa_esp_dma_error(struct esp *esp)
+{
+	return performa_esp_priv(esp)->error;
+}
+
+static const struct esp_driver_ops performa_esp_pdma_ops = {
+	.esp_write8	  = performa_esp_write8,
+	.esp_read8	  = performa_esp_read8,
+	.irq_pending	  = performa_esp_irq_pending,
+	.dma_length_limit = performa_esp_dma_length_limit,
+	.reset_dma	  = performa_esp_reset_dma,
+	.dma_drain	  = performa_esp_dma_drain,
+	.dma_invalidate	  = performa_esp_dma_invalidate,
+	.send_dma_cmd	  = performa_esp_send_dma_cmd,
+	.dma_error	  = performa_esp_dma_error,
+};
+
+static void performa_esp_pio_nop(struct esp *esp)
+{
+}
+
+static int performa_esp_pio_error(struct esp *esp)
+{
+	return esp->send_cmd_error;
+}
+
+static const struct esp_driver_ops performa_esp_pio_ops = {
+	.esp_write8	  = performa_esp_write8,
+	.esp_read8	  = performa_esp_read8,
+	.irq_pending	  = performa_esp_irq_pending,
+	.dma_length_limit = performa_esp_dma_length_limit,
+	.reset_dma	  = performa_esp_pio_nop,
+	.dma_drain	  = performa_esp_pio_nop,
+	.dma_invalidate	  = performa_esp_pio_nop,
+	.send_dma_cmd	  = esp_send_pio_cmd,
+	.dma_error	  = performa_esp_pio_error,
+};
+
+static int performa_esp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct performa_esp_priv *p;
+	struct Scsi_Host *host;
+	struct esp *esp;
+	u32 cfreq;
+	int err;
+
+	if (of_property_read_u32(dev->of_node, "clock-frequency", &cfreq))
+		return dev_err_probe(dev, -EINVAL, "no clock-frequency\n");
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	host = scsi_host_alloc(&scsi_esp_template, sizeof(struct esp));
+	if (!host)
+		return -ENOMEM;
+	host->max_id = 8;
+
+	esp = shost_priv(host);
+	esp->host = host;
+	esp->dev = dev;
+	esp->cfreq = cfreq;
+	esp->scsi_id = 7;
+	host->this_id = esp->scsi_id;
+	esp->scsi_id_mask = BIT(esp->scsi_id);
+	p->esp = esp;
+	dev_set_drvdata(dev, p);
+
+	esp->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(esp->regs)) {
+		err = PTR_ERR(esp->regs);
+		goto fail_host;
+	}
+	esp->fifo_reg = esp->regs + ESP_FDATA * 16;
+
+	if (pdma) {
+		p->pdma = devm_platform_ioremap_resource(pdev, 1);
+		if (IS_ERR(p->pdma)) {
+			dev_warn(dev, "no pseudo DMA port\n");
+			p->pdma = NULL;
+		}
+	}
+
+	if (p->pdma) {
+		esp->ops = &performa_esp_pdma_ops;
+	} else {
+		esp->ops = &performa_esp_pio_ops;
+		/* PIO leaves the transfer counter untouched */
+		esp_write8(0, ESP_TCLOW);
+		esp_write8(0, ESP_TCMED);
+	}
+
+	/* the core passes virtual addresses, the CPU moves all data */
+	esp->flags = ESP_FLAG_NO_DMA_MAP | ESP_FLAG_USE_FIFO |
+		     ESP_FLAG_DISABLE_SYNC;
+
+	esp->command_block = kzalloc(16, GFP_KERNEL);
+	if (!esp->command_block) {
+		err = -ENOMEM;
+		goto fail_host;
+	}
+	esp->command_block_dma = (uintptr_t)esp->command_block;
+
+	err = platform_get_irq(pdev, 0);
+	if (err < 0)
+		goto fail_cmd;
+	host->irq = err;
+	err = request_irq(host->irq, scsi_esp_intr, 0, DRV_MODULE_NAME, esp);
+	if (err)
+		goto fail_cmd;
+
+	dev_info(dev, "%s\n", p->pdma ? "pseudo DMA" : "PIO");
+
+	err = scsi_esp_register(esp);
+	if (err)
+		goto fail_irq;
+	return 0;
+
+fail_irq:
+	free_irq(host->irq, esp);
+fail_cmd:
+	kfree(esp->command_block);
+fail_host:
+	scsi_host_put(host);
+	return err;
+}
+
+static void performa_esp_remove(struct platform_device *pdev)
+{
+	struct performa_esp_priv *p = platform_get_drvdata(pdev);
+	struct esp *esp = p->esp;
+
+	scsi_esp_unregister(esp);
+	free_irq(esp->host->irq, esp);
+	kfree(esp->command_block);
+	scsi_host_put(esp->host);
+}
+
+static const struct of_device_id performa_esp_match[] = {
+	{ .compatible = "apple,performa-esp" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, performa_esp_match);
+
+static struct platform_driver performa_esp_driver = {
+	.probe	= performa_esp_probe,
+	.remove	= performa_esp_remove,
+	.driver	= {
+		.name		= DRV_MODULE_NAME,
+		.of_match_table	= performa_esp_match,
+	},
+};
+module_platform_driver(performa_esp_driver);
+
+MODULE_DESCRIPTION("Performa 5200/6200 53C96 ESP SCSI driver");
+MODULE_AUTHOR("René Rebe <rene@exactco.de>");
+MODULE_LICENSE("GPL");
