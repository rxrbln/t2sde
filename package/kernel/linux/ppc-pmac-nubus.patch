+static void swim3_clear_intr(struct floppy_state *fs)
+{
+	swim3_out(fs, SW_INTR_ENABLE, 0);
+	swim3_in(fs, SW_INTR);
+	swim3_in(fs, SW_ERROR);
+}
+
+static void swim3_init_state(struct floppy_state *fs)
+{
+	fs->state = idle;
+	fs->cur_cyl = -1;
+	fs->cur_sector = -1;
+	fs->secpercyl = 36;
+	fs->secpertrack = 18;
+	fs->total_secs = 2880;
+	init_waitqueue_head(&fs->wait);
+}
+
+#ifdef CONFIG_PPC_PMAC
+/*
+ * XXX: this is a horrible hack, but at least allows ppc32 to get
+ * out of defining virt_to_bus, and this driver out of using the
+ * deprecated block layer bounce buffering for highmem addresses
+ * for no good reason.
+ */
+static unsigned long swim3_phys_to_bus(phys_addr_t paddr)
+{
+	return paddr + PCI_DRAM_OFFSET;
+}
+
+static phys_addr_t swim3_bio_phys(struct bio *bio)
+{
+	return page_to_phys(bio_page(bio)) + bio_offset(bio);
+}
+
+static inline void init_dma(struct dbdma_cmd *cp, int cmd,
+			    phys_addr_t paddr, int count)
+{
+	cp->req_count = cpu_to_le16(count);
+	cp->command = cpu_to_le16(cmd);
+	cp->phy_addr = cpu_to_le32(swim3_phys_to_bus(paddr));
+	cp->xfer_status = 0;
+}
+
+
+static void swim3_dbdma_prepare(struct floppy_state *fs, struct request *req,
+				int n)
+{
+	struct dbdma_cmd *cp = fs->dma_cmd;
+	struct dbdma_regs __iomem *dr = fs->dma;
+
+	out_le32(&dr->cmdptr, swim3_phys_to_bus(virt_to_phys(cp)));
+	if (rq_data_dir(req) == WRITE) {
+		/* Set up 3 dma commands: write preamble, data, postamble */
+		init_dma(cp, OUTPUT_MORE, virt_to_phys(write_preamble),
+			 sizeof(write_preamble));
+		++cp;
+		init_dma(cp, OUTPUT_MORE, swim3_bio_phys(req->bio), 512);
+		++cp;
+		init_dma(cp, OUTPUT_LAST, virt_to_phys(write_postamble),
+			sizeof(write_postamble));
+	} else {
+		init_dma(cp, INPUT_LAST, swim3_bio_phys(req->bio), n * 512);
+	}
+	++cp;
+	out_le16(&cp->command, DBDMA_STOP);
+}
+
+static void swim3_dbdma_start(struct floppy_state *fs, bool write)
+{
+	out_le32(&fs->dma->control, (RUN << 16) | RUN);
+}
+
+static int swim3_dbdma_finish(struct floppy_state *fs, struct request *req,
+			      bool error)
+{
+	struct dbdma_cmd *cp = fs->dma_cmd;
+	int n, stat, resid;
+
+	if (rq_data_dir(req) == WRITE)
+		++cp;
+	/*
+	 * Check that the main data transfer has finished.
+	 * On writing, the swim3 sometimes doesn't use
+	 * up all the bytes of the postamble, so we can still
+	 * see DMA active here.  That doesn't matter as long
+	 * as all the sector data has been transferred.
+	 */
+	if (!error && cp->xfer_status == 0) {
+		/* wait a little while for DMA to complete */
+		for (n = 0; n < 100; ++n) {
+			if (cp->xfer_status != 0)
+				break;
+			udelay(1);
+			barrier();
+		}
+	}
+	/* turn off DMA */
+	out_le32(&fs->dma->control, (RUN | PAUSE) << 16);
+	stat = le16_to_cpu(cp->xfer_status);
+	resid = le16_to_cpu(cp->res_count);
+	if (!error && ((stat & ACTIVE) == 0 || resid != 0)) {
+		swim3_err("fd dma error: stat=%x resid=%d\n", stat, resid);
+		return -EIO;
+	}
+	return resid;
+}
+
+static void swim3_dbdma_abort(struct floppy_state *fs)
+{
+	struct dbdma_regs __iomem *dr = fs->dma;
+	int n;
+
+	out_le32(&dr->control, RUN << 16);
+	/* We must wait a bit for dbdma to stop */
+	for (n = 0; (in_le32(&dr->status) & ACTIVE) && n < 1000; n++)
+		udelay(1);
+}
+
+static const struct swim3_dma_ops swim3_dbdma_ops = {
+	.prepare	= swim3_dbdma_prepare,
+	.start		= swim3_dbdma_start,
+	.finish		= swim3_dbdma_finish,
+	.abort		= swim3_dbdma_abort,
+};
