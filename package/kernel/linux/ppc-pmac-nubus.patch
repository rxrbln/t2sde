+/* the built-in device trees only describe the on-board video */
+static const u32 * __init bootx_fdt_find_display(const void *dtb,
+						 const u32 *root)
+{
+	const u32 *p, *addr;
+	int len;
+
+	for (p = root; (p = bootx_fdt_find_type(dtb, p, "display")); ) {
+		addr = bootx_fdt_getprop(dtb, p, "address", &len);
+		if (!addr || (len == 4 &&
+			      *addr == (u32)bootx_info->dispDeviceBase))
+			return p;
+	}
+	return NULL;
+}
+
+static void __init bootx_add_memory_props(u32 acells, u32 scells,
+					  unsigned long *mem_end)
+{
+	boot_infos_t *bi = bootx_info;
+	u32 i, j, n, banks = 0;
+
+	n = min_t(u32, bi->physMemoryMapSize, MAX_MEM_MAP_SIZE);
+	for (i = 0; i < n; i++)
+		if (bi->physMemoryMap[i].size)
+			banks++;
+	if (!bootx_dt_add_prop_head("reg", banks * (acells + scells) * 4,
+				    mem_end))
+		return;
+	for (i = 0; i < n; i++) {
+		if (!bi->physMemoryMap[i].size)
+			continue;
+		for (j = 1; j < acells; j++)
+			dt_push_token(0, mem_end);
+		dt_push_token(bi->physMemoryMap[i].physAddr, mem_end);
+		for (j = 1; j < scells; j++)
+			dt_push_token(0, mem_end);
+		dt_push_token(bi->physMemoryMap[i].size, mem_end);
+	}
+}
