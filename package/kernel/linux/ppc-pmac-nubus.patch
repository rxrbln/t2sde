+/*
+ * Copy the built-in tree, replacing the memory, /chosen and boot display
+ * properties and adding the nodes it lacks.
+ */
+static void __init bootx_fdt_build_struct(const void *dtb,
+					  unsigned long *mem_end)
+{
+	const struct boot_param_header *fdt = dtb;
+	const char *strings = dtb + fdt->off_dt_strings;
+	const u32 *root = dtb + fdt->off_dt_struct;
+	const u32 *memory, *display = NULL, *p;
+	const char *video = NULL, *name;
+	u32 acells, scells, base;
+	enum { NONE, MEMORY, CHOSEN, DISPLAY } node = NONE;
+	bool has_chosen = false, pdm_card = false;
+	int depth = 0;
+
+	acells = bootx_fdt_cells(dtb, root, "#address-cells", 2);
+	scells = bootx_fdt_cells(dtb, root, "#size-cells", 1);
+	memory = bootx_fdt_find_type(dtb, root, "memory");
+
+	base = (u32)bootx_info->dispDeviceBase;
+	if (base) {
+		video = bootx_nubus_card_video(base);
+		pdm_card = video &&
+			   bootx_fdt_is_compatible(dtb, root, "apple,pdm");
+		if (!video)
+			display = bootx_fdt_find_display(dtb, root);
+		if (!video && !display)
+			video = "video";
+	}
+
+	for (p = root; *p != OF_DT_END; p = bootx_fdt_next(p)) {
+		if (*p == OF_DT_PROP) {
+			name = strings + p[2];
+			if (node == MEMORY && !strcmp(name, "reg"))
+				continue;
+			if (node == CHOSEN &&
+			    (!strcmp(name, "bootargs") ||
+			     !strncmp(name, "linux,initrd-", 13)))
+				continue;
+			bootx_dt_add_prop(name, p + 3, p[1], mem_end);
+			continue;
+		}
+		if (*p != OF_DT_BEGIN_NODE && *p != OF_DT_END_NODE)
+			continue;
+
+		/* properties end at the first child or the end of a node */
+		if (node == MEMORY)
+			bootx_add_memory_props(acells, scells, mem_end);
+		else if (node == CHOSEN)
+			bootx_fdt_add_chosen_props(mem_end);
+		else if (node == DISPLAY)
+			bootx_add_display_props(0, mem_end, 1);
+		node = NONE;
+
+		if (*p == OF_DT_BEGIN_NODE) {
+			name = (const char *)(p + 1);
+			bootx_dt_begin_node(name, mem_end);
+			if (p == memory) {
+				node = MEMORY;
+			} else if (p == display) {
+				node = DISPLAY;
+			} else if (depth == 1 && !strcmp(name, "chosen")) {
+				node = CHOSEN;
+				has_chosen = true;
+			}
+			depth++;
+			continue;
+		}
