+/*
+ * The PDM HPV and AV card registers (MkLinux video_hpv.c, video_av.c) and
+ * the boot frame buffer; a Radius card at 0xfb000000 gets no driver node.
+ */
+static void __init bootx_add_pdm_video_props(u32 acells, u32 scells,
+					     unsigned long *mem_end)
+{
+	boot_infos_t *bi = bootx_info;
+	u32 base = (u32)bi->dispDeviceBase;
+	u32 fb_size = bi->dispDeviceRowBytes *
+		      (bi->dispDeviceRect[3] - bi->dispDeviceRect[1]);
+	const char *compat;
+	int n;
+
+	if (base == 0xfb000000)
+		return;
+	if (base >= 0xf0000000) {
+		compat = "apple,pdm-hpv";
+		n = 2;
+	} else {
+		compat = "apple,pdm-av";
+		n = 3;
+	}
+	bootx_dt_add_prop("compatible", compat, strlen(compat) + 1, mem_end);
+	if (!bootx_dt_add_prop_head("reg", n * (acells + scells) * 4, mem_end))
+		return;
+	if (n == 2) {
+		bootx_add_reg(0xfec00000, 0x1000, acells, scells, mem_end);
+	} else {
+		bootx_add_reg(0xe0036000, 0x1000, acells, scells, mem_end);
+		bootx_add_reg(0xe0f30000, 0x20, acells, scells, mem_end);
+	}
+	bootx_add_reg(bootx_disp_addr(), fb_size, acells, scells, mem_end);
