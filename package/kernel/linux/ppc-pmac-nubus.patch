diff --git a/arch/powerpc/boot/dts/nubus-m2.dts b/arch/powerpc/boot/dts/nubus-m2.dts
new file mode 100644
index 000000000000..9430057ad5ce
--- /dev/null
+++ b/arch/powerpc/boot/dts/nubus-m2.dts
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NuBus Power Macintosh, M2 PowerBooks with Baboon IDE (5300, 1400, 2300;
+ * Whitney I/O).  The memory size and the timebase are set by the boot
+ * loader resp. measured by the kernel.
+ *
+ * Addresses from MkLinux (osfmk powermac_m2.h) and the 2001 nubus-pmac
+ * NuBusPowerBook.dts.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+/dts-v1/;
+
+/ {
+	model = "PowerBook 5300/1400/2300";
+	compatible = "apple,m2", "apple,nubus-pmac";
+	interrupt-parent = <&pic>;
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			device_type = "cpu";
+			reg = <0>;
+			d-cache-line-size = <32>;
+			i-cache-line-size = <32>;
+		};
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0 0>;
+	};
+
+	chosen {
+		stdout-path = &scc;
+	};
+
+	whitney-io {
+		compatible = "apple,whitney-io", "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * M2 ICR, VIA1, pseudo VIA2, Baboon interrupt flags; hwirq 4 SCC,
+		 * 7 NMI, 8-14 VIA1 (10 PMU shift register, 12 PMU CB1), 16-22 VIA2,
+		 * 24-30 slots, 32-34 Baboon (32 media bay IDE, 33 internal IDE)
+		 */
+		pic: interrupt-controller@50f2a003 {
+			compatible = "apple,m2-pic";
+			reg = <0x50f2a003 0x1>, <0x50f00000 0x2000>,
+			      <0x50f02000 0x2000>, <0x50f1a0d9 0x1>;
+			interrupt-controller;
+			#interrupt-cells = <1>;
+			/* Baboon cascade slot bit, 0 on the Duo 2300 */
+			apple,baboon-slot = <3>;
+		};
+
+		/*
+		 * PMU on the VIA1 shift register, handshake on VIA2 port B;
+		 * interrupts: shift register, CB1
+		 */
+		via-pmu@50f00000 {
+			compatible = "apple,m2-pmu";
+			device_type = "pmu";
+			reg = <0x50f00000 0x4000>;
+			interrupts = <10>, <12>;
+		};
+
+		/* Z85C30, byte registers at even addresses */
+		scc: serial@50f04000 {
+			compatible = "apple,nubus-escc";
+			reg = <0x50f04000 0x8>;
+			interrupts = <4>;
+			clock-frequency = <3686400>;
+			current-speed = <9600>;
+		};
+
+		/*
+		 * NCR 5380 at register stride 16, pseudo DMA with DRQ handshake
+		 * (as the m68k LC); interrupt in VIA2, the DRQ (hwirq 16) unused
+		 */
+		scsi@50f10000 {
+			compatible = "apple,m2-ncr5380";
+			reg = <0x50f10000 0x2000>, <0x50f06000 0x2000>;
+			interrupts = <19>;
+		};
+
+		/*
+		 * Baboon ATA ports, task file at stride 4, control at +0x38,
+		 * 16 bit data (MkLinux wd.c, the nubus-pmac nbpmacide)
+		 */
+		ata@50f1a000 {
+			compatible = "apple,baboon-ata", "ata-generic";
+			reg = <0x50f1a000 0x38>, <0x50f1a038 0x4>;
+			reg-shift = <2>;
+			ata-generic,use16bit;
+			interrupts = <33>;
+		};
+
+		/* expansion (media) bay */
+		ata@50f1a080 {
+			compatible = "apple,baboon-ata", "ata-generic";
+			reg = <0x50f1a080 0x38>, <0x50f1a0b8 0x4>;
+			reg-shift = <2>;
+			ata-generic,use16bit;
+			interrupts = <32>;
+		};
+	};
+};
diff --git a/arch/powerpc/boot/dts/nubus-pdm.dts b/arch/powerpc/boot/dts/nubus-pdm.dts
new file mode 100644
index 000000000000..da82beaccc28
--- /dev/null
+++ b/arch/powerpc/boot/dts/nubus-pdm.dts
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NuBus Power Macintosh, PDM (Piltdown Man) family: 6100, 7100, 8100,
+ * Workgroup Server 6150, 8150, 9150.  The memory size is set by the boot
+ * loader.
+ *
+ * Based on the NuBusPowerMac.dts of the nubus-pmac project.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+/dts-v1/;
+
+/ {
+	model = "Power Macintosh (PDM)";
+	compatible = "apple,pdm", "apple,nubus-pmac";
+	interrupt-parent = <&pic>;
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			device_type = "cpu";
+			reg = <0>;
+			clock-frequency = <80000000>;
+			bus-frequency = <40000000>;
+			/* the 601 RTC and decrementer count nanoseconds */
+			timebase-frequency = <1000000000>;
+			d-cache-line-size = <32>;
+			i-cache-line-size = <32>;
+		};
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0 0>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* the on-board video scans main memory from this fixed address */
+		vram: framebuffer@100000 {
+			reg = <0x100000 0x96000>;
+			no-map;
+		};
+	};
+
+	chosen {
+		stdout-path = &scc;
+	};
+
+	amic-io {
+		compatible = "apple,amic-io", "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * AMIC interrupt control and the pseudo VIA2, hwirq numbers as in
+		 * MkLinux: 0-5 ICR, 16-22 VIA2, 26-30 NuBus slots/VBL, 32-38 DMA,
+		 * 40-41 audio DMA
+		 */
+		pic: interrupt-controller@50f2a000 {
+			compatible = "apple,amic-pic";
+			reg = <0x50f2a000 0x10>, <0x50f26000 0x20>;
+			interrupt-controller;
+			#interrupt-cells = <1>;
+		};
+
+		via-cuda@50f00000 {
+			compatible = "apple,pdm-cuda";
+			device_type = "cuda";
+			reg = <0x50f00000 0x2000>;
+			interrupts = <0>;
+		};
+
+		/*
+		 * 53C94 and, on the 8100 only, the fast 53CF94 (probed like
+		 * MkLinux does), registers at a 16 byte stride; AMIC DMA
+		 * base address and control registers of the channel
+		 */
+		scsi@50f10000 {
+			compatible = "apple,amic-esp";
+			reg = <0x50f10000 0x100>, <0x50f32000 0x4>,
+			      <0x50f32008 0x1>;
+			interrupts = <19>;
+			clock-frequency = <20000000>;
+		};
+
+		scsi@50f11000 {
+			compatible = "apple,amic-esp";
+			reg = <0x50f11000 0x100>, <0x50f32004 0x4>,
+			      <0x50f32009 0x1>;
+			interrupts = <22>;
+			clock-frequency = <40000000>;
+		};
+
+		/* Z85C30, byte registers at even addresses */
+		scc: serial@50f04000 {
+			compatible = "apple,nubus-escc";
+			reg = <0x50f04000 0x8>;
+			interrupts = <2>;
+			clock-frequency = <3686400>;
+			current-speed = <9600>;
+		};
+
+		/*
+		 * On-board video: CLUT DAC, video control and the DRAM frame
+		 * buffer (HMC vbase clear), vertical blank interrupt.  BootX
+		 * support adds the boot display properties.  The HPV and AV
+		 * cards are not described here: BootX support creates their
+		 * nodes when Mac OS used one as the boot display.
+		 */
+		video@50f24000 {
+			compatible = "apple,pdm-video";
+			device_type = "display";
+			reg = <0x50f24000 0x4>, <0x50f28000 0x8>,
+			      <0x00100000 0x96000>;
+			interrupts = <30>;
+		};
+
+		/* base address of the 256 KB DMA buffer area */
+		amic-dma@50f31000 {
+			compatible = "apple,amic-dma";
+			reg = <0x50f31000 0x4>;
+		};
+
+		/*
+		 * Am79C940 MACE with the MAC address PROM, the AMIC transmit DMA
+		 * control and the receive DMA control, ring pointers and transmit
+		 * byte counts
+		 */
+		ethernet@50f0a000 {
+			compatible = "apple,amic-mace";
+			reg = <0x50f0a000 0x200>, <0x50f08000 0x80>,
+			      <0x50f31c20 0x1>, <0x50f32028 0x30>;
+			reg-names = "mace", "prom", "txdma", "rxdma";
+			interrupts = <3>, <36>, <37>;
+			interrupt-names = "mace", "rxdma", "txdma";
+		};
+
+		/* AWACS, sound DMA from the AMIC area, output and input DMA interrupts */
+		sound@50f14000 {
+			compatible = "apple,amic-awacs";
+			reg = <0x50f14000 0x20>;
+			interrupts = <41>, <40>;
+			interrupt-names = "out", "in";
+		};
+
+		/*
+		 * SWIM3, registers at a 512 byte stride, and the AMIC floppy DMA
+		 * address, byte count and control registers
+		 */
+		floppy@50f16000 {
+			compatible = "apple,amic-swim3";
+			reg = <0x50f16000 0x2000>, <0x50f32060 0x10>;
+			interrupts = <21>, <38>;
+			interrupt-names = "swim3", "dma";
+		};
+	};
+
+	/*
+	 * BART NuBus controller.  The children are the NuBus slots by their
+	 * standard slot space address 0xFs000000, slots B-E have an interrupt
+	 * in the VIA2 slot register.  The 6100 PDS adapter is slot E, the 7100
+	 * and 8100 have slots C-E (MAME macpdm.cpp).
+	 */
+	nubus@f0000000 {
+		compatible = "apple,pdm-nubus", "apple,nubus";
+		reg = <0xf0000000 0x80>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0xfb000000 0xfb000000 0x04000000>;
+
+		slot@fb000000 {
+			reg = <0xfb000000 0x01000000>;
+			interrupts = <26>;
+		};
+
+		slot@fc000000 {
+			reg = <0xfc000000 0x01000000>;
+			interrupts = <27>;
+		};
+
+		slot@fd000000 {
+			reg = <0xfd000000 0x01000000>;
+			interrupts = <28>;
+		};
+
+		slot@fe000000 {
+			reg = <0xfe000000 0x01000000>;
+			interrupts = <29>;
+		};
+	};
+};
diff --git a/arch/powerpc/boot/dts/nubus-performa.dts b/arch/powerpc/boot/dts/nubus-performa.dts
new file mode 100644
index 000000000000..db99c6d38368
--- /dev/null
+++ b/arch/powerpc/boot/dts/nubus-performa.dts
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NuBus Power Macintosh, Performa/Power Macintosh 5200/6200 family
+ * ("Cordyceps": Capella bridge, PrimeTime II, F108).  The memory size and
+ * the timebase are set by the boot loader resp. measured by the kernel.
+ *
+ * Addresses from MkLinux (osfmk powermac_performa.h), the 6200 ROM decoder
+ * table and MAME.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+/dts-v1/;
+
+/ {
+	model = "Power Macintosh 5200/6200";
+	compatible = "apple,performa-5200", "apple,nubus-pmac";
+	interrupt-parent = <&pic>;
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			device_type = "cpu";
+			reg = <0>;
+			clock-frequency = <75000000>;
+			bus-frequency = <37500000>;
+			d-cache-line-size = <32>;
+			i-cache-line-size = <32>;
+		};
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0 0>;
+	};
+
+	chosen {
+		stdout-path = &scc;
+	};
+
+	primetime-io {
+		compatible = "apple,primetime-io", "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * Capella IPL/acknowledge, VIA1, pseudo VIA2; hwirq 1 Cuda (VIA1),
+		 * 4 SCC, 7 NMI, 16-22 VIA2, 24-30 slots (28 ATA, 30 VBL)
+		 */
+		pic: interrupt-controller@53000000 {
+			compatible = "apple,capella-pic";
+			reg = <0x53000000 0x28>, <0x50f00000 0x2000>,
+			      <0x50f02000 0x2000>;
+			interrupt-controller;
+			#interrupt-cells = <1>;
+		};
+
+		via-cuda@50f00000 {
+			compatible = "apple,performa-cuda";
+			device_type = "cuda";
+			reg = <0x50f00000 0x2000>;
+			interrupts = <1>;
+		};
+
+		/* Z85C30 in the F108, byte registers at even addresses */
+		scc: serial@50f0c020 {
+			compatible = "apple,nubus-escc";
+			reg = <0x50f0c020 0x8>;
+			interrupts = <4>;
+			clock-frequency = <3686400>;
+			current-speed = <9600>;
+		};
+
+		/* NCR 53C96 in the F108, PrimeTime II pseudo DMA port */
+		scsi@50f10000 {
+			compatible = "apple,performa-esp";
+			reg = <0x50f10000 0x100>, <0x50f10100 0x4>;
+			interrupts = <19>;
+			clock-frequency = <16500000>;
+		};
+
+		/* F108 ATA, task file at a 4 byte stride */
+		ata@50f1a000 {
+			compatible = "apple,f108-ata", "ata-generic";
+			reg = <0x50f1a000 0x20>, <0x50f1a038 0x4>;
+			reg-shift = <2>;
+			interrupts = <28>;
+		};
+
+		/* Apple Sound Chip FIFOs, interrupt on VIA2 CB1 */
+		sound@50f14000 {
+			compatible = "apple,primetime-asc";
+			reg = <0x50f14000 0x1000>;
+			interrupts = <20>;
+		};
+
+		/* frame buffer, CLUT, registers */
+		valkyrie@f9000000 {
+			compatible = "apple,valkyrie";
+			reg = <0xf9000000 0x100000>, <0x50f24000 0x1000>,
+			      <0x50f2a000 0x1000>;
+			interrupts = <30>;
+		};
+	};
+};
