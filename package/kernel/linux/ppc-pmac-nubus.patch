@@ -1256,28 +1256,41 @@ config KERNEL_START_BOOL
 
 	  Say N here unless you know what you are doing.
 
+# book3s/32 derives the kernel base from PAGE_OFFSET and PHYSICAL_START
 config KERNEL_START
 	hex "Virtual address of kernel base" if KERNEL_START_BOOL
+	depends on !PPC_BOOK3S_32
 	default PAGE_OFFSET if PAGE_OFFSET_BOOL
-	default "0xc2000000" if CRASH_DUMP && !NONSTATIC_KERNEL
 	default "0xc0000000"
 
 config PHYSICAL_START_BOOL
 	bool "Set physical address where the kernel is loaded"
-	depends on ADVANCED_OPTIONS && FLATMEM && PPC_85xx
+	depends on FLATMEM
+	depends on (ADVANCED_OPTIONS && PPC_85xx) || \
+		   (PPC_BOOK3S_32 && !SMP && !CRASH_DUMP)
+	default y if PPC_NUBUS_PMAC
 	help
 	  This gives the physical address where the kernel is loaded.
 
+	  On book3s/32 the kernel is then linked at PAGE_OFFSET plus this
+	  address, the RAM below it remains usable and exceptions are
+	  redirected from the vectors at 0.  This keeps fixed low memory
+	  ranges, like the frame buffer of the NuBus Power Macintosh PDM,
+	  free of the kernel image.
+
 	  Say N here unless you know what you are doing.
 
 config PHYSICAL_START
 	hex "Physical address where the kernel is loaded" if PHYSICAL_START_BOOL
+	range 0x0 0x02000000 if PPC_BOOK3S_32
 	default "0x02000000" if PPC_BOOK3S && CRASH_DUMP && !NONSTATIC_KERNEL
+	default "0x00200000" if PPC_BOOK3S_32 && PHYSICAL_START_BOOL
 	default "0x00000000"
 
 config PHYSICAL_ALIGN
 	hex
 	default "0x04000000" if PPC_85xx
+	default "0x00200000" if PPC_BOOK3S_32
 	help
 	  This value puts the alignment restrictions on physical address
 	  where kernel is loaded and run from. Kernel is compiled for an
