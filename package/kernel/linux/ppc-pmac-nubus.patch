diff --git a/arch/powerpc/include/asm/amic_dma.h b/arch/powerpc/include/asm/amic_dma.h
new file mode 100644
index 000000000000..7d6b91cf7060
--- /dev/null
+++ b/arch/powerpc/include/asm/amic_dma.h
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DMA buffer area of the PDM (Power Macintosh 6100/7100/8100) AMIC.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+#ifndef _ASM_POWERPC_AMIC_DMA_H
+#define _ASM_POWERPC_AMIC_DMA_H
+
+#include <linux/types.h>
+
+struct device;
+
+/* fixed sub-buffers of the 256 KB area the AMIC DMA base register selects */
+enum amic_dma_area {
+	AMIC_DMA_ENET_RX,	/* 0x00000, 48 KB ring of 256 byte pages */
+	AMIC_DMA_SOUND_IN,	/* 0x0c000, two 8 KB halves */
+	AMIC_DMA_SOUND_OUT,	/* 0x10000, two 8 KB halves */
+	AMIC_DMA_ENET_TX,	/* 0x14000, two 2 KB transmit sets */
+	AMIC_DMA_FLOPPY,	/* 0x15000, offset chosen by software */
+	AMIC_DMA_SCC_B_TX,	/* 0x20000 */
+	AMIC_DMA_SCC_A_RX,	/* 0x22000 */
+	AMIC_DMA_SCC_A_TX,	/* 0x24000 */
+	AMIC_DMA_SCC_B_RX,	/* 0x26000 */
+	AMIC_DMA_NR_AREAS
+};
+
+struct amic_dma_buf {
+	void __iomem *cpu;	/* uncached, use the _io accessors */
+	dma_addr_t dma;		/* address as seen by the AMIC */
+	size_t size;
+};
+
+int amic_dma_request(enum amic_dma_area area, struct amic_dma_buf *buf);
+void amic_dma_release(enum amic_dma_area area);
+int devm_amic_dma_request(struct device *dev, enum amic_dma_area area,
+			  struct amic_dma_buf *buf);
+
+#endif /* _ASM_POWERPC_AMIC_DMA_H */
