diff --git a/arch/powerpc/platforms/nubus/amic.c b/arch/powerpc/platforms/nubus/amic.c
new file mode 100644
index 000000000000..da4ed94b4177
--- /dev/null
+++ b/arch/powerpc/platforms/nubus/amic.c
@@ -0,0 +1,275 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Interrupt controller of the PDM (Power Macintosh 6100/7100/8100) AMIC
+ * I/O controller.
+ *
+ * The AMIC interrupt control register (ICR) collects VIA1, the pseudo VIA2
+ * (with the NuBus slot and VBL sub-register), SCC, MACE, the DMA channels
+ * and NMI.  Only the VIA2 sources can be masked in hardware.  The hwirq
+ * numbering follows MkLinux (osfmk interrupt_pdm.c) and the nubus-pmac
+ * device trees:
+ *
+ *   0-5    ICR: VIA1, VIA2 (cascade), SCC, MACE, DMA (cascade), NMI
+ *   16-22  VIA2 IFR: SCSI-A DRQ, slot (cascade), SCSI-B DRQ, SCSI-A,
+ *          sound, SWIM3, SCSI-B
+ *   24-30  VIA2 slot IFR (active low): 26-29 NuBus slots B-E, 30 VBL
+ *   32-38  DMA IFR: SCC-B RX/TX, SCC-A RX/TX, MACE RX/TX, SWIM3
+ *   40-41  audio DMA: in, out
+ *
+ * VIA1 is owned by the Cuda driver, which masks its sources itself.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/irqdomain.h>
+#include <linux/irq_work.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/spinlock.h>
+
+#include <asm/io.h>
+
+#include "nubus.h"
+
+#define ICR		0x0
+#define DMA_IFR		0x8
+#define DMA_AUDIO	0xa
+#define ICR_ACK		0x80
+#define ICR_LATCH	0x40
+#define ICR_VIA2	0x02
+#define ICR_DMA		0x10
+
+#define VIA2_SIFR	0x02
+#define VIA2_IFR	0x03
+#define VIA2_SIER	0x12
+#define VIA2_IER	0x13
+#define VIA_SET		0x80
+#define VIA2_SLOT	0x02
+#define SLOT_VBL	0x40
+
+#define HW_ICR		0
+#define HW_VIA2		16
+#define HW_SLOT		24
+#define HW_DMA		32
+#define HW_AUDIO	40
+#define AMIC_NR_IRQS	48
+
+static void __iomem *amic_icr;
+static void __iomem *amic_via2;
+static struct irq_domain *amic_domain;
+static DEFINE_RAW_SPINLOCK(amic_lock);
+/* software enable masks of the sources without a hardware mask */
+static u8 amic_icr_en, amic_dma_en, amic_audio_en;
+/*
+ * The ICR runs in level mode as in MkLinux.  While a disabled source without
+ * a hardware mask is asserted, it is switched to latched mode (interrupt on
+ * a change of the sources, acknowledge with the mode bit set; MAME) so that
+ * this source does not interrupt continuously.
+ */
+static bool amic_latched;
+static struct irq_work amic_rescan_work;
+
+static u8 amic_icr_mode(void)
+{
+	return ICR_ACK | (amic_latched ? ICR_LATCH : 0);
+}
+
+static bool amic_masked_pending(u8 icr)
+{
+	if (icr & 0x3f & ~amic_icr_en & ~(ICR_VIA2 | ICR_DMA))
+		return true;
+	if (!(icr & ICR_DMA))
+		return false;
+	return (in_8(amic_icr + DMA_AUDIO) & 3 & ~amic_audio_en) ||
+	       (in_8(amic_icr + DMA_IFR) & 0x7f & ~amic_dma_en);
+}
+
+static void amic_mask(struct irq_data *d)
+{
+	unsigned int hw = irqd_to_hwirq(d);
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&amic_lock, flags);
+	if (hw < HW_VIA2)
+		amic_icr_en &= ~BIT(hw - HW_ICR);
+	else if (hw < HW_SLOT)
+		out_8(amic_via2 + VIA2_IER, BIT(hw - HW_VIA2));
+	else if (hw < HW_DMA)
+		out_8(amic_via2 + VIA2_SIER, BIT(hw - HW_SLOT));
+	else if (hw < HW_AUDIO)
+		amic_dma_en &= ~BIT(hw - HW_DMA);
+	else
+		amic_audio_en &= ~BIT(hw - HW_AUDIO);
+	raw_spin_unlock_irqrestore(&amic_lock, flags);
+}
+
+static void amic_unmask(struct irq_data *d)
+{
+	unsigned int hw = irqd_to_hwirq(d);
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&amic_lock, flags);
+	if (hw >= HW_VIA2 && hw < HW_SLOT) {
+		out_8(amic_via2 + VIA2_IER, VIA_SET | BIT(hw - HW_VIA2));
+	} else if (hw >= HW_SLOT && hw < HW_DMA) {
+		out_8(amic_via2 + VIA2_SIER, VIA_SET | BIT(hw - HW_SLOT));
+		out_8(amic_via2 + VIA2_IER, VIA_SET | VIA2_SLOT);
+	} else {
+		if (hw < HW_VIA2)
+			amic_icr_en |= BIT(hw - HW_ICR);
+		else if (hw < HW_AUDIO)
+			amic_dma_en |= BIT(hw - HW_DMA);
+		else
+			amic_audio_en |= BIT(hw - HW_AUDIO);
+		/* back to level mode once no disabled source is asserted any more */
+		if (amic_latched && !amic_masked_pending(in_8(amic_icr + ICR))) {
+			amic_latched = false;
+			out_8(amic_icr + ICR, amic_icr_mode());
+			irq_work_queue(&amic_rescan_work);
+		}
+	}
+	raw_spin_unlock_irqrestore(&amic_lock, flags);
+}
+
+static void amic_eoi(struct irq_data *d)
+{
+	unsigned int hw = irqd_to_hwirq(d);
+
+	/* only the VBL flag of the slot register is writable */
+	if (hw == HW_SLOT + 6)
+		out_8(amic_via2 + VIA2_SIFR, SLOT_VBL);
+	out_8(amic_icr + ICR, amic_icr_mode());
+	/* latched mode does not interrupt again for sources still asserted */
+	if (amic_latched)
+		irq_work_queue(&amic_rescan_work);
+}
+
+static struct irq_chip amic_chip = {
+	.name		= "AMIC",
+	.irq_mask	= amic_mask,
+	.irq_unmask	= amic_unmask,
+	.irq_eoi	= amic_eoi,
+};
+
+static bool amic_valid_hwirq(irq_hw_number_t hw)
+{
+	return hw <= 5 || (hw >= HW_VIA2 && hw <= HW_VIA2 + 6) ||
+	       (hw >= HW_SLOT + 2 && hw <= HW_SLOT + 6) ||
+	       (hw >= HW_DMA && hw <= HW_DMA + 6) ||
+	       hw == HW_AUDIO || hw == HW_AUDIO + 1;
+}
+
+static int amic_host_map(struct irq_domain *h, unsigned int virq,
+			 irq_hw_number_t hw)
+{
+	/* the cascades are decoded in amic_get_irq() */
+	if (!amic_valid_hwirq(hw) || hw == 1 || hw == 4 ||
+	    hw == HW_VIA2 + 1)
+		return -EINVAL;
+
+	irq_set_status_flags(virq, IRQ_LEVEL);
+	irq_set_chip_and_handler(virq, &amic_chip, handle_fasteoi_irq);
+	return 0;
+}
+
+static const struct irq_domain_ops amic_host_ops = {
+	.map	= amic_host_map,
+	.xlate	= irq_domain_xlate_onecell,
+};
+
+static unsigned int amic_find(irq_hw_number_t base, u8 bits)
+{
+	return irq_find_mapping(amic_domain, base + __ffs(bits));
+}
+
+static unsigned int amic_decode(u8 icr)
+{
+	u8 bits;
+
+	if (icr & ICR_VIA2) {
+		bits = in_8(amic_via2 + VIA2_IFR) & in_8(amic_via2 + VIA2_IER);
+		if (bits & VIA2_SLOT) {
+			u8 slot = ~in_8(amic_via2 + VIA2_SIFR) &
+				  in_8(amic_via2 + VIA2_SIER) & 0x7c;
+
+			if (slot)
+				return amic_find(HW_SLOT, slot);
+		}
+		bits &= 0x7f & ~VIA2_SLOT;
+		if (bits)
+			return amic_find(HW_VIA2, bits);
+	}
+
+	if (icr & ICR_DMA) {
+		bits = in_8(amic_icr + DMA_AUDIO) & amic_audio_en;
+		if (bits)
+			return amic_find(HW_AUDIO, bits);
+		bits = in_8(amic_icr + DMA_IFR) & amic_dma_en;
+		if (bits)
+			return amic_find(HW_DMA, bits);
+	}
+
+	bits = icr & amic_icr_en & 0x3f;
+	if (bits)
+		return amic_find(HW_ICR, bits);
+	return 0;
+}
+
+unsigned int amic_get_irq(void)
+{
+	u8 icr = in_8(amic_icr + ICR);
+	unsigned int virq;
+
+	if (amic_latched)
+		out_8(amic_icr + ICR, amic_icr_mode());
+	virq = amic_decode(icr);
+	if (virq)
+		return virq;
+
+	if (!amic_latched && amic_masked_pending(icr))
+		amic_latched = true;
+	out_8(amic_icr + ICR, amic_icr_mode());
+	return 0;
+}
+
+static void amic_rescan(struct irq_work *work)
+{
+	unsigned long flags;
+	unsigned int virq;
+
+	local_irq_save(flags);
+	while ((virq = amic_decode(in_8(amic_icr + ICR))))
+		generic_handle_irq(virq);
+	local_irq_restore(flags);
+}
+
+int __init amic_pic_init(struct device_node *np)
+{
+	amic_icr = of_iomap(np, 0);
+	amic_via2 = of_iomap(np, 1);
+	if (!amic_icr || !amic_via2) {
+		pr_err("AMIC: cannot map %pOF\n", np);
+		return -ENOMEM;
+	}
+
+	/* level mode, acknowledge; mask and clear all VIA2 sources */
+	out_8(amic_icr + ICR, ICR_ACK);
+	out_8(amic_via2 + VIA2_IER, 0x7f);
+	out_8(amic_via2 + VIA2_IFR, 0x7f);
+	out_8(amic_via2 + VIA2_SIER, 0x7f);
+	out_8(amic_via2 + VIA2_SIFR, 0x7f);
+
+	init_irq_work(&amic_rescan_work, amic_rescan);
+	amic_domain = irq_domain_create_linear(of_fwnode_handle(np),
+					       AMIC_NR_IRQS, &amic_host_ops,
+					       NULL);
+	if (!amic_domain)
+		return -ENOMEM;
+	irq_set_default_domain(amic_domain);
+
+	pr_info("AMIC interrupt controller at %pOF\n", np);
+	return 0;
+}
diff --git a/arch/powerpc/platforms/nubus/amic_dma.c b/arch/powerpc/platforms/nubus/amic_dma.c
new file mode 100644
index 000000000000..1dd51bb16919
--- /dev/null
+++ b/arch/powerpc/platforms/nubus/amic_dma.c
@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DMA buffer area of the PDM AMIC.
+ *
+ * The AMIC DMA base register (0x50f31000) selects one 256 KB, 256 KB
+ * aligned area of physical memory.  Ethernet, sound, floppy and SCC DMA
+ * use fixed offsets inside it (MkLinux powermac_pdm.h and enet_dma.h,
+ * MAME amic_enet.cpp and macpdm.cpp).  The area is allocated once at boot
+ * and handed out per channel.  AMIC DMA is not coherent with the 601
+ * cache (MkLinux maps the area uncached and copies with bcopy_nc), so the
+ * CPU accesses it through an uncached mapping only.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/device.h>
+#include <linux/export.h>
+#include <linux/init.h>
+#include <linux/memblock.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+
+#include <asm/amic_dma.h>
+#include <asm/cacheflush.h>
+#include <asm/io.h>
+#include <asm/machdep.h>
+
+#include "nubus.h"
+
+#define AMIC_DMA_SIZE	SZ_256K
+
+static const struct {
+	u32 offset;
+	u32 size;
+} amic_dma_layout[AMIC_DMA_NR_AREAS] = {
+	[AMIC_DMA_ENET_RX]	= { 0x00000, 0xc000 },
+	[AMIC_DMA_SOUND_IN]	= { 0x0c000, 0x4000 },
+	[AMIC_DMA_SOUND_OUT]	= { 0x10000, 0x4000 },
+	[AMIC_DMA_ENET_TX]	= { 0x14000, 0x1000 },
+	/* MkLinux marks the floppy offset as a guess, the pointer stays below 0x20000 */
+	[AMIC_DMA_FLOPPY]	= { 0x15000, 0xb000 },
+	[AMIC_DMA_SCC_B_TX]	= { 0x20000, 0x2000 },
+	[AMIC_DMA_SCC_A_RX]	= { 0x22000, 0x2000 },
+	[AMIC_DMA_SCC_A_TX]	= { 0x24000, 0x2000 },
+	[AMIC_DMA_SCC_B_RX]	= { 0x26000, 0x2000 },
+};
+
+static phys_addr_t amic_dma_phys;
+static void __iomem *amic_dma_virt;
+static unsigned long amic_dma_busy;
+
+void __init amic_dma_reserve(void)
+{
+	struct device_node *np;
+	void *va;
+
+	np = of_find_compatible_node(NULL, NULL, "apple,amic-dma");
+	if (!np)
+		return;
+	of_node_put(np);
+
+	va = memblock_alloc(AMIC_DMA_SIZE, AMIC_DMA_SIZE);
+	if (!va) {
+		pr_err("AMIC DMA: cannot reserve %u KB\n", AMIC_DMA_SIZE / SZ_1K);
+		return;
+	}
+	amic_dma_phys = __pa(va);
+}
+
+static int __init amic_dma_init(void)
+{
+	unsigned int i, npages = AMIC_DMA_SIZE >> PAGE_SHIFT;
+	struct device_node *np;
+	struct page **pages;
+	void __iomem *base;
+	void *va;
+
+	if (!amic_dma_phys)
+		return 0;
+
+	np = of_find_compatible_node(NULL, NULL, "apple,amic-dma");
+	base = of_iomap(np, 0);
+	of_node_put(np);
+	if (!base)
+		return -ENOMEM;
+
+	pages = kmalloc_array(npages, sizeof(*pages), GFP_KERNEL);
+	if (!pages) {
+		iounmap(base);
+		return -ENOMEM;
+	}
+	for (i = 0; i < npages; i++)
+		pages[i] = pfn_to_page(PHYS_PFN(amic_dma_phys) + i);
+	/* write back the cached alias (memblock zeroed it) before DMA */
+	flush_dcache_range((unsigned long)__va(amic_dma_phys),
+			   (unsigned long)__va(amic_dma_phys) + AMIC_DMA_SIZE);
+	va = vmap(pages, npages, VM_MAP, pgprot_noncached(PAGE_KERNEL));
+	kfree(pages);
+	if (!va) {
+		iounmap(base);
+		return -ENOMEM;
+	}
+	amic_dma_virt = (void __force __iomem *)va;
+
+	/* byte wise, as MkLinux programs it */
+	for (i = 0; i < 4; i++)
+		out_8(base + i, (u32)amic_dma_phys >> (24 - 8 * i));
+	iounmap(base);
+
+	pr_info("AMIC DMA: buffer area at 0x%08llx\n",
+		(unsigned long long)amic_dma_phys);
+	return 0;
+}
+machine_arch_initcall(nubus_pmac, amic_dma_init);
+
+int amic_dma_request(enum amic_dma_area area, struct amic_dma_buf *buf)
+{
+	if (area >= AMIC_DMA_NR_AREAS)
+		return -EINVAL;
+	if (!amic_dma_virt)
+		return -ENODEV;
+	if (test_and_set_bit(area, &amic_dma_busy))
+		return -EBUSY;
+
+	buf->cpu = amic_dma_virt + amic_dma_layout[area].offset;
+	buf->dma = amic_dma_phys + amic_dma_layout[area].offset;
+	buf->size = amic_dma_layout[area].size;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(amic_dma_request);
+
+void amic_dma_release(enum amic_dma_area area)
+{
+	if (area < AMIC_DMA_NR_AREAS)
+		clear_bit(area, &amic_dma_busy);
+}
+EXPORT_SYMBOL_GPL(amic_dma_release);
+
+static void amic_dma_devm_release(void *data)
+{
+	amic_dma_release((enum amic_dma_area)(unsigned long)data);
+}
+
+int devm_amic_dma_request(struct device *dev, enum amic_dma_area area,
+			  struct amic_dma_buf *buf)
+{
+	int ret = amic_dma_request(area, buf);
+
+	if (ret)
+		return ret;
+	return devm_add_action_or_reset(dev, amic_dma_devm_release,
+					(void *)(unsigned long)area);
+}
+EXPORT_SYMBOL_GPL(devm_amic_dma_request);
diff --git a/arch/powerpc/platforms/nubus/bus.c b/arch/powerpc/platforms/nubus/bus.c
new file mode 100644
index 000000000000..102235eecf9a
--- /dev/null
+++ b/arch/powerpc/platforms/nubus/bus.c
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NuBus slots of the NuBus Power Macintosh.
+ *
+ * The slot space is not accessible at its NuBus address 0xFs000000 as on
+ * m68k.  The slots are the children of the "apple,nubus" device tree node,
+ * addressed by their NuBus slot space address, with their interrupt; each
+ * is ioremapped for probing.  Probing an empty slot raises a machine check.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/io.h>
+#include <linux/nubus.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+
+
+#include "nubus.h"
+
+#define NUBUS_SLOT_SPACE(slot)	(0xF0000000 | ((slot) << 24))
+
+bool nubus_present(void)
+{
+	struct device_node *np;
+	bool present;
+
+	np = of_find_compatible_node(NULL, NULL, "apple,nubus");
+	present = np && of_device_is_available(np);
+	of_node_put(np);
+	return present;
+}
+
+static struct device_node *nubus_slot_node(int slot)
+{
+	struct device_node *bus, *np;
+	u32 addr;
+
+	bus = of_find_compatible_node(NULL, NULL, "apple,nubus");
+	if (!bus)
+		return NULL;
+
+	for_each_child_of_node(bus, np)
+		if (!of_property_read_u32_index(np, "reg", 0, &addr) &&
+		    addr == NUBUS_SLOT_SPACE(slot))
+			break;
+
+	of_node_put(bus);
+	return np;
+}
+
+void *nubus_map_slot(int slot)
+{
+	struct device_node *np = nubus_slot_node(slot);
+	void __iomem *addr = NULL;
+	struct resource r;
+
+	if (!np)
+		return NULL;
+
+	if (of_address_to_resource(np, 0, &r) ||
+	    resource_size(&r) != NUBUS_SLOT_SIZE)
+		pr_err("%pOF: invalid NuBus slot space\n", np);
+	else
+		addr = ioremap(r.start, NUBUS_SLOT_SIZE);
+
+	of_node_put(np);
+	return (void __force *)addr;
+}
+
+void nubus_unmap_slot(void *addr)
+{
+	iounmap((void __iomem __force *)addr);
+}
+
+int nubus_slot_irq(int slot)
+{
+	struct device_node *np = nubus_slot_node(slot);
+	unsigned int irq;
+
+	if (!np)
+		return 0;
+
+	irq = irq_of_parse_and_map(np, 0);
+	of_node_put(np);
+	return irq;
+}
+EXPORT_SYMBOL(nubus_slot_irq);
diff --git a/arch/powerpc/platforms/nubus/hwtest.S b/arch/powerpc/platforms/nubus/hwtest.S
new file mode 100644
index 000000000000..55e485170539
--- /dev/null
+++ b/arch/powerpc/platforms/nubus/hwtest.S
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Probe a byte register that raises a machine check (TEA) when absent, like
+ * an empty NuBus slot.  The load is followed by the twi/isync sequence of
+ * the recoverable I/O accessors, so the machine check is taken inside the
+ * exception table covered range and recovered by hwreg_machine_check() or
+ * the generic check_io_access().
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/export.h>
+#include <asm/ppc_asm.h>
+
+_GLOBAL(hwreg_present)
+	sync
+0:	lbz	r4,0(r3)
+1:	twi	0,r4,0
+2:	isync
+3:	nop
+	li	r3,1
+	blr
+4:	li	r3,0
+	blr
+	EX_TABLE(0b, 4b)
+	EX_TABLE(1b, 4b)
+	EX_TABLE(2b, 4b)
+	EX_TABLE(3b, 4b)
+	.globl	hwreg_present_end
+hwreg_present_end:
+EXPORT_SYMBOL(hwreg_present)
diff --git a/arch/powerpc/platforms/nubus/iosb_pic.c b/arch/powerpc/platforms/nubus/iosb_pic.c
new file mode 100644
index 000000000000..0c2e58a4e728
--- /dev/null
+++ b/arch/powerpc/platforms/nubus/iosb_pic.c
@@ -0,0 +1,325 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Interrupt controller of the Performa 5200/6200 (Capella bridge, PrimeTime
+ * I/O) and the M2 PowerBooks 5300/1400/2300/500 (Whitney I/O).
+ *
+ * Both keep the 68k Macintosh interrupt structure: the sources raise a 68k
+ * interrupt priority level (1 VIA1, 2 VIA2, 4 SCC, 7 NMI), which the Capella
+ * resp. the M2 interrupt control register (ICR) turn into the PowerPC
+ * external interrupt.  The CPU interrupt is latched and acknowledged at the
+ * top level, so all pending sources are dispatched in one pass.  VIA2 is a
+ * pseudo VIA with the 6522 register stride; the NuBus/slot interrupts are
+ * its port A (active low), the M2 Baboon IDE/media bay flags cascade on
+ * slot C.  References: MkLinux osfmk interrupt_performa.c/interrupt_m2.c,
+ * the 2001 nubus-pmac M2 driver (Takashi Oe), MAME capella/iosb/pseudovia.
+ *
+ * hwirq numbers:
+ *   1, 4, 7  IPL 1 (VIA1 as a whole, for Cuda), 4 (SCC), 7 (NMI)
+ *   8-14     VIA1 IFR bits (PMU: 10 shift register, 12 CB1)
+ *   16-22    VIA2 IFR bits: 16 SCSI DRQ, 17 slot (cascade), 19 SCSI,
+ *            20 sound, 21 floppy, 22 SCSI 1
+ *   24-30    slots: Performa 28 ATA, 29 slot E, 30 VBL; M2 24 PCMCIA,
+ *            25 CSC, 26 modem, 27 Baboon (cascade), 29 internal expansion
+ *   32-34    Baboon: 32 media bay IDE, 33 internal IDE, 34 media bay; it
+ *            cascades on slot 27 or the slot bit given by apple,baboon-slot
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/irqdomain.h>
+#include <linux/irq_work.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/spinlock.h>
+
+#include <asm/io.h>
+
+#include "nubus.h"
+
+#define VIA_IFR		0x1a00
+#define VIA_IER		0x1c00
+#define VIA_ANH		0x1e00
+#define VIA_SET		0x80
+#define VIA_ANY		0x80
+#define VIA2_SLOT	0x02
+
+#define CAPELLA_ACK	0x1f
+#define CAPELLA_IPL	0x27
+#define M2_PENDING	0x80
+#define M2_ACK		0x80
+
+#define HW_LEVEL	0
+#define HW_VIA1		8
+#define HW_VIA2		16
+#define HW_SLOT		24
+#define HW_BABOON	32
+#define HW_CASCADE	(IOSB_NR_IRQS - 1)
+#define IOSB_NR_IRQS	40
+#define SLOT_BABOON	3	/* 5300, 1400; the Duo 2300 uses slot bit 0 */
+
+struct iosb_pic {
+	void __iomem *top;
+	void __iomem *via1;
+	void __iomem *via2;
+	void __iomem *baboon;
+	bool capella;
+	u32 baboon_slot;
+	struct irq_domain *domain;
+	unsigned int cascade_virq;
+	/* software enables of the sources without a hardware mask */
+	u8 level_en, slot_en, baboon_en;
+};
+
+static struct iosb_pic iosb;
+static DEFINE_RAW_SPINLOCK(iosb_lock);
+static struct irq_work iosb_rescan_work;
+
+static u8 *iosb_soft_mask(unsigned int hw, u8 *bit)
+{
+	if (hw < HW_VIA1) {
+		*bit = BIT(hw - HW_LEVEL);
+		return &iosb.level_en;
+	}
+	if (hw >= HW_BABOON) {
+		*bit = BIT(hw - HW_BABOON);
+		return &iosb.baboon_en;
+	}
+	if (hw >= HW_SLOT) {
+		*bit = BIT(hw - HW_SLOT);
+		return &iosb.slot_en;
+	}
+	return NULL;
+}
+
+static u8 iosb_level(void);
+
+/* live state of a source without a hardware mask */
+static bool iosb_soft_asserted(unsigned int hw)
+{
+	if (hw < HW_VIA1)
+		return hw == 1 ? in_8(iosb.via1 + VIA_IFR) & VIA_ANY :
+				 iosb_level() == hw;
+	if (hw >= HW_BABOON)
+		return in_8(iosb.baboon) & BIT(hw - HW_BABOON);
+	return ~in_8(iosb.via2 + VIA_ANH) & BIT(hw - HW_SLOT);
+}
+
+static void iosb_set(struct irq_data *d, bool on)
+{
+	unsigned int hw = irqd_to_hwirq(d);
+	unsigned long flags;
+	u8 *en, bit;
+
+	raw_spin_lock_irqsave(&iosb_lock, flags);
+	en = iosb_soft_mask(hw, &bit);
+	if (en) {
+		*en = on ? *en | bit : *en & ~bit;
+		/*
+		 * A level source asserted while masked does not interrupt again
+		 * (the summary flag is consumed, level IRQs are not resent)
+		 */
+		if (on && iosb_soft_asserted(hw))
+			irq_work_queue(&iosb_rescan_work);
+	} else if (hw < HW_VIA2)
+		out_8(iosb.via1 + VIA_IER, (on ? VIA_SET : 0) | BIT(hw - HW_VIA1));
+	else
+		out_8(iosb.via2 + VIA_IER, (on ? VIA_SET : 0) | BIT(hw - HW_VIA2));
+	raw_spin_unlock_irqrestore(&iosb_lock, flags);
+}
+
+static void iosb_mask(struct irq_data *d)
+{
+	iosb_set(d, false);
+}
+
+static void iosb_unmask(struct irq_data *d)
+{
+	iosb_set(d, true);
+}
+
+static void iosb_ack(struct irq_data *d)
+{
+	unsigned int hw = irqd_to_hwirq(d);
+
+	/* clear the latched flags (CB1, SR, sound); level sources reassert */
+	if (hw >= HW_VIA1 && hw < HW_VIA2)
+		out_8(iosb.via1 + VIA_IFR, BIT(hw - HW_VIA1));
+	else if (hw >= HW_VIA2 && hw < HW_SLOT)
+		out_8(iosb.via2 + VIA_IFR, BIT(hw - HW_VIA2));
+	else if (hw >= HW_BABOON)
+		/* latched, cleared by writing 0 like the nubus-pmac nbpmacide */
+		out_8(iosb.baboon, in_8(iosb.baboon) & ~BIT(hw - HW_BABOON));
+}
+
+static struct irq_chip iosb_chip = {
+	.name		= "IOSB",
+	.irq_mask	= iosb_mask,
+	.irq_unmask	= iosb_unmask,
+	.irq_ack	= iosb_ack,
+};
+
+static bool iosb_valid_hwirq(irq_hw_number_t hw)
+{
+	if (hw == 1 || hw == 4 || hw == 7)
+		return true;
+	if ((hw >= HW_VIA1 && hw <= HW_VIA1 + 6) ||
+	    (hw >= HW_VIA2 && hw <= HW_VIA2 + 6 && hw != HW_VIA2 + 1))
+		return true;
+	if (hw >= HW_SLOT && hw <= HW_SLOT + 6)
+		return !(iosb.baboon && hw == HW_SLOT + iosb.baboon_slot);
+	return iosb.baboon && hw >= HW_BABOON && hw <= HW_BABOON + 2;
+}
+
+static int iosb_host_map(struct irq_domain *h, unsigned int virq,
+			 irq_hw_number_t hw)
+{
+	if (hw == HW_CASCADE)
+		return 0;
+	if (!iosb_valid_hwirq(hw))
+		return -EINVAL;
+
+	irq_set_status_flags(virq, IRQ_LEVEL);
+	irq_set_chip_and_handler(virq, &iosb_chip, handle_level_irq);
+	return 0;
+}
+
+static const struct irq_domain_ops iosb_host_ops = {
+	.map	= iosb_host_map,
+	.xlate	= irq_domain_xlate_onecell,
+};
+
+static u8 iosb_level(void)
+{
+	if (iosb.capella)
+		return ~in_8(iosb.top + CAPELLA_IPL) & 7;
+	return in_8(iosb.top) & 7;
+}
+
+/* next pending enabled source in 68k priority order, or -1 */
+static int iosb_next(void)
+{
+	u8 level = iosb_level(), bits, slots;
+
+	if (level == 7 && (iosb.level_en & BIT(7)))
+		return 7;
+	if (level == 4 && (iosb.level_en & BIT(4)))
+		return 4;
+
+	bits = in_8(iosb.via2 + VIA_IFR) & in_8(iosb.via2 + VIA_IER) & 0x7f;
+	/*
+	 * The slot flag latches a slot line becoming active (6522 CA1): clear
+	 * it before the scan, which also finds lines active since earlier.
+	 */
+	if (bits & VIA2_SLOT)
+		out_8(iosb.via2 + VIA_IFR, VIA2_SLOT);
+	slots = ~in_8(iosb.via2 + VIA_ANH) & 0x7f;
+	if (iosb.baboon && (slots & BIT(iosb.baboon_slot))) {
+		u8 flags = in_8(iosb.baboon) & 7 & iosb.baboon_en;
+
+		if (flags)
+			return HW_BABOON + __ffs(flags);
+	}
+	slots &= iosb.slot_en;
+	if (slots)
+		return HW_SLOT + __ffs(slots);
+	bits &= ~VIA2_SLOT;
+	if (bits)
+		return HW_VIA2 + __ffs(bits);
+
+	/* VIA1 handed over as a whole (Cuda) or decoded bit by bit (PMU) */
+	if (irq_find_mapping(iosb.domain, 1)) {
+		if (!(iosb.level_en & BIT(1)))
+			return -1;
+		return (in_8(iosb.via1 + VIA_IFR) & VIA_ANY) ? 1 : -1;
+	}
+	bits = in_8(iosb.via1 + VIA_IFR) & in_8(iosb.via1 + VIA_IER) & 0x7f;
+	if (bits)
+		return HW_VIA1 + __ffs(bits);
+
+	return -1;
+}
+
+static void iosb_dispatch(void)
+{
+	int hw;
+
+	/* an unmapped source cannot be serviced, leave it pending */
+	while ((hw = iosb_next()) >= 0)
+		if (generic_handle_domain_irq(iosb.domain, hw))
+			break;
+}
+
+static void iosb_cascade(struct irq_desc *desc)
+{
+	iosb_dispatch();
+}
+
+static void iosb_rescan(struct irq_work *work)
+{
+	unsigned long flags;
+
+	local_irq_save(flags);
+	iosb_dispatch();
+	local_irq_restore(flags);
+}
+
+unsigned int iosb_get_irq(void)
+{
+	/* acknowledge first: any later change of the sources interrupts again */
+	if (iosb.capella) {
+		out_8(iosb.top + CAPELLA_ACK, 0);
+		(void)in_8(iosb.top + CAPELLA_ACK);
+	} else if (in_8(iosb.top) & M2_PENDING) {
+		out_8(iosb.top, M2_ACK);
+	}
+	return iosb.cascade_virq;
+}
+
+int __init iosb_pic_init(struct device_node *np)
+{
+	iosb.capella = of_device_is_compatible(np, "apple,capella-pic");
+	iosb.top = of_iomap(np, 0);
+	iosb.via1 = of_iomap(np, 1);
+	iosb.via2 = of_iomap(np, 2);
+	/* M2 with Baboon (5300, 1400, 2300) */
+	iosb.baboon = of_iomap(np, 3);
+	iosb.baboon_slot = SLOT_BABOON;
+	of_property_read_u32(np, "apple,baboon-slot", &iosb.baboon_slot);
+	if (iosb.baboon_slot > 6) {
+		pr_err("IOSB PIC: invalid Baboon slot %u\n", iosb.baboon_slot);
+		return -EINVAL;
+	}
+	if (!iosb.top || !iosb.via1 || !iosb.via2) {
+		pr_err("IOSB PIC: cannot map %pOF\n", np);
+		return -ENOMEM;
+	}
+
+	out_8(iosb.via1 + VIA_IER, 0x7f);
+	out_8(iosb.via1 + VIA_IFR, 0x7f);
+	out_8(iosb.via2 + VIA_IER, 0x7f);
+	out_8(iosb.via2 + VIA_IFR, 0x7f);
+	/* the slot interrupts have no mask register, they are always routed */
+	out_8(iosb.via2 + VIA_IER, VIA_SET | VIA2_SLOT);
+
+	init_irq_work(&iosb_rescan_work, iosb_rescan);
+	iosb.domain = irq_domain_create_linear(of_fwnode_handle(np),
+					       IOSB_NR_IRQS, &iosb_host_ops,
+					       NULL);
+	if (!iosb.domain)
+		return -ENOMEM;
+	irq_set_default_domain(iosb.domain);
+
+	iosb.cascade_virq = irq_create_mapping(iosb.domain, HW_CASCADE);
+	if (!iosb.cascade_virq)
+		return -ENOMEM;
+	irq_set_chip_and_handler_name(iosb.cascade_virq, &dummy_irq_chip,
+				      iosb_cascade, "cascade");
+
+	iosb_get_irq();
+	pr_info("%s interrupt controller at %pOF\n",
+		iosb.capella ? "Capella" : "M2", np);
+	return 0;
+}
diff --git a/arch/powerpc/platforms/nubus/nubus.h b/arch/powerpc/platforms/nubus/nubus.h
