diff --git a/arch/powerpc/include/asm/vdso/timebase.h b/arch/powerpc/include/asm/vdso/timebase.h
index e9245f86a46c..133e39e57bec 100644
--- a/arch/powerpc/include/asm/vdso/timebase.h
+++ b/arch/powerpc/include/asm/vdso/timebase.h
@@ -12,7 +12,28 @@
  * We use __powerpc64__ here because we want the compat VDSO to use the 32-bit
  * version below in the else case of the ifdef.
  */
-#if defined(__powerpc64__) && (defined(CONFIG_PPC_CELL) || defined(CONFIG_PPC_E500))
+#ifdef CONFIG_PPC_BOOK3S_601
+/*
+ * The 601 has an RTC instead of a timebase, RTCU counts seconds and RTCL
+ * nanoseconds.  Provide it as a 64-bit nanosecond "timebase" counting at
+ * 1 GHz, as the 601 decrementer also counts in nanoseconds.
+ */
+static __always_inline u64 get_rtc(void)
+{
+	unsigned int hi, lo, hi2;
+
+	do {
+		asm volatile("mfspr %0, %3; mfspr %1, %4; mfspr %2, %3"
+			     : "=r" (hi), "=r" (lo), "=r" (hi2)
+			     : "i" (SPRN_RTCU), "i" (SPRN_RTCL));
+	} while (hi2 != hi);
+	return (u64)hi * 1000000000 + lo;
+}
+
+#define mftb()		((unsigned long)get_rtc())
+#define mftbu()		((unsigned long)(get_rtc() >> 32))
+
+#elif defined(__powerpc64__) && (defined(CONFIG_PPC_CELL) || defined(CONFIG_PPC_E500))
 #define mftb()		({unsigned long rval;				\
 			asm volatile(					\
 				"90:	mfspr %0, %2;\n"		\
@@ -31,7 +52,8 @@
 				     "=r" (rval) : "i" (SPRN_TBRL)); rval;})
 #endif /* !CONFIG_PPC_CELL */
 
-#if defined(CONFIG_PPC_8xx)
+#if defined(CONFIG_PPC_BOOK3S_601)
+#elif defined(CONFIG_PPC_8xx)
 #define mftbu()		({unsigned long rval;	\
 			asm volatile("mftbu %0" : "=r" (rval)); rval;})
 #else
@@ -47,6 +69,10 @@ static __always_inline u64 get_tb(void)
 {
 	unsigned int tbhi, tblo, tbhi2;
 
+#ifdef CONFIG_PPC_BOOK3S_601
+	return get_rtc();
+#endif
+
 	/*
 	 * We use __powerpc64__ here not CONFIG_PPC64 because we want the compat
 	 * VDSO to use the 32-bit compatible version in the while loop below.
diff --git a/arch/powerpc/kernel/btext.c b/arch/powerpc/kernel/btext.c
index b23dddfce26d..bbee9f2d40d5 100644
--- a/arch/powerpc/kernel/btext.c
+++ b/arch/powerpc/kernel/btext.c
@@ -93,10 +93,18 @@ void __init btext_prepare_BAT(void)
 		boot_text_mapped = 0;
 		return;
 	}
-	lowbits = addr & ~0xFF000000UL;
-	addr &= 0xFF000000UL;
-	disp_BAT[0] = vaddr | (BL_16M<<2) | 2;
-	disp_BAT[1] = addr | (_PAGE_NO_CACHE | _PAGE_GUARDED | BPP_RW);
+	if (IS_ENABLED(CONFIG_PPC_BOOK3S_601)) {
+		/* unified 601 BAT, 8M maximum, valid bit in the lower half */
+		lowbits = addr & ~0xFF800000UL;
+		addr &= 0xFF800000UL;
+		disp_BAT[0] = vaddr | (_PAGE_NO_CACHE | PP_RWXX) | 4;
+		disp_BAT[1] = addr | BL_8M | 0x40;
+	} else {
+		lowbits = addr & ~0xFF000000UL;
+		addr &= 0xFF000000UL;
+		disp_BAT[0] = vaddr | (BL_16M<<2) | 2;
+		disp_BAT[1] = addr | (_PAGE_NO_CACHE | _PAGE_GUARDED | BPP_RW);
+	}
 	logicalDisplayBase = (void *) (vaddr + lowbits);
 }
 #endif
