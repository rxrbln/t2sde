From c4622648e456d122d5938de9bd2372c548442556 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Tue, 22 Sep 2026 21:37:52 -0400
Subject: [PATCH] drm/i915/fbdev: Discard BIOS framebuffers with mismatched
 dimensions

---
 drivers/gpu/drm/i915/display/intel_fbdev.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_fbdev.c b/drivers/gpu/drm/i915/display/intel_fbdev.c
index db0e36dd8722..2de4034178f2 100644
--- a/drivers/gpu/drm/i915/display/intel_fbdev.c
+++ b/drivers/gpu/drm/i915/display/intel_fbdev.c
@@ -271,9 +271,9 @@ static bool bios_fb_ok(const struct intel_framebuffer *fb,
 	int depth = fb->base.format->depth;
 	int bpp = fb->base.format->cpp[0] * 8;
 
-	if (sizes->fb_width > width || sizes->fb_height > height) {
+	if (sizes->fb_width != width || sizes->fb_height != height) {
 		drm_dbg_kms(display->drm,
-			    "BIOS fb too small (%dx%d), we require (%dx%d), releasing it\n",
+			    "BIOS fb dimensions invalid (%dx%d), we require (%dx%d), releasing it\n",
 			    width, height, sizes->fb_width, sizes->fb_height);
 		return false;
 	}
-- 
2.47.3

