-static int snd_cs4231_probe(struct device *dev, unsigned int n)
+/* IBM CHRP RS/6000 43P CS4236B: like the firmware audio init, raise XCTL0
+   for the internal speaker amplifier and unmute MOUT driving it.  */
+static const struct snd_kcontrol_new snd_cs4231_ibm_speaker =
+	WSS_SINGLE("Speaker Playback Switch", 0, CS4231_PIN_CTRL, 6, 1, 0);
+
+static int snd_cs4231_ibm_speaker_init(struct device *dev,
+				       struct snd_wss *chip)
+{
+	struct device_node *np = of_node_get(dev->of_node);
+	bool ibm;
+
+	/* ISA probing by module parameters has no node of its own */
+	if (!np)
+		np = of_find_compatible_node(NULL, "sound", "IBM0017");
+	ibm = of_device_is_compatible(np, "IBM0017");
+	of_node_put(np);
+	if (!ibm)
+		return 0;
+
+	scoped_guard(spinlock_irqsave, &chip->reg_lock) {
+		snd_wss_out(chip, CS4231_PIN_CTRL,
+			    chip->image[CS4231_PIN_CTRL] | CS4231_XCTL0);
+		snd_wss_out(chip, CS4231_MONO_CTRL,
+			    chip->image[CS4231_MONO_CTRL] & ~CS4231_MONO_OUT_MUTE);
+	}
+
+	return snd_ctl_add(chip->card,
+			   snd_ctl_new1(&snd_cs4231_ibm_speaker, chip));
+}
+
