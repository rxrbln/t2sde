+			     int dma1, int dma2)
 {
 	struct snd_card *card;
 	struct snd_wss *chip;
 	int error;
 
-	error = snd_devm_card_new(dev, index[n], id[n], THIS_MODULE, 0, &card);
+	error = snd_devm_card_new(dev, idx, xid, THIS_MODULE, 0, &card);
 	if (error < 0)
 		return error;
 
-	error = snd_wss_create(card, port[n], -1, irq[n], dma1[n], dma2[n],
+	error = snd_wss_create(card, port, -1, irq, dma1, dma2,
 			WSS_HW_DETECT, 0, &chip);
 	if (error < 0)
 		return error;
@@ -97,29 +132,32 @@ static int snd_cs4231_probe(struct devic
 	strscpy(card->driver, "CS4231", sizeof(card->driver));
 	strscpy(card->shortname, chip->pcm->name, sizeof(card->shortname));
 
-	if (dma2[n] < 0)
+	if (dma2 < 0)
 		scnprintf(card->longname, sizeof(card->longname),
 			  "%s at 0x%lx, irq %d, dma %d",
-			  chip->pcm->name, chip->port, irq[n], dma1[n]);
+			  chip->pcm->name, chip->port, irq, dma1);
 	else
 		scnprintf(card->longname, sizeof(card->longname),
 			  "%s at 0x%lx, irq %d, dma %d&%d",
-			  chip->pcm->name, chip->port, irq[n], dma1[n], dma2[n]);
+			  chip->pcm->name, chip->port, irq, dma1, dma2);
 
 	error = snd_wss_mixer(chip);
 	if (error < 0)
 		return error;
 
+	error = snd_cs4231_ibm_speaker_init(dev, chip);
+	if (error < 0)
+		return error;
+
 	error = snd_wss_timer(chip, 0);
 	if (error < 0)
 		return error;
 
-	if (mpu_port[n] > 0 && mpu_port[n] != SNDRV_AUTO_PORT) {
-		if (mpu_irq[n] == SNDRV_AUTO_IRQ)
-			mpu_irq[n] = -1;
+	if (mpu_port > 0 && mpu_port != SNDRV_AUTO_PORT) {
+		if (mpu_irq == SNDRV_AUTO_IRQ)
+			mpu_irq = -1;
 		if (snd_mpu401_uart_new(card, 0, MPU401_HW_CS4232,
-					mpu_port[n], 0, mpu_irq[n],
-					NULL) < 0)
+					mpu_port, 0, mpu_irq, NULL) < 0)
 			dev_warn(dev, "MPU401 not detected\n");
 	}
 
@@ -131,6 +169,12 @@ static int snd_cs4231_probe(struct devic
 	return 0;
 }
 
+static int snd_cs4231_probe(struct device *dev, unsigned int n)
+{
+	return snd_cs4231_create(dev, index[n], id[n], port[n], mpu_port[n],
+				 irq[n], mpu_irq[n], dma1[n], dma2[n]);
