+/* devices for the drivers of ISA sound nodes, which have no legacy probing */
+static int __init chrp_isa_sound_devices(void)
+{
+	struct device_node *isa, *np;
+
+	for_each_node_by_type(isa, "isa")
+		for_each_child_of_node(isa, np)
+			if (of_node_is_type(np, "sound"))
+				of_platform_device_create(np, NULL, NULL);
+	return 0;
+}
+machine_device_initcall(chrp, chrp_isa_sound_devices);
