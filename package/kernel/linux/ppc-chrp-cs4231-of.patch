 {
@@ -165,4 +209,93 @@ static struct isa_driver snd_cs4231_driv
 	}
 };
 
-module_isa_driver(snd_cs4231_driver, SNDRV_CARDS);
+#ifdef CONFIG_OF
+/* the ISA "dma" property has 5 cells per channel, the channel first */
+#define OF_ISA_DMA_CELLS	5
+
+static int snd_cs4231_of_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	int irq, n, play, capt = -1;
+	struct resource *res;
+	u32 chan[2];
+
+	res = platform_get_resource(pdev, IORESOURCE_IO, 0);
+	if (!res)
+		return -ENODEV;
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	n = of_property_count_u32_elems(np, "dma");
+	if (n < OF_ISA_DMA_CELLS || n % OF_ISA_DMA_CELLS)
+		return dev_err_probe(&pdev->dev, -EINVAL, "invalid dma property\n");
+	n /= OF_ISA_DMA_CELLS;
+	for (int i = 0; i < min(n, 2); i++)
+		of_property_read_u32_index(np, "dma", i * OF_ISA_DMA_CELLS,
+					   &chan[i]);
+	/* IBM CHRP firmware lists the capture channel first (7043-150) */
+	if (n > 1) {
+		capt = chan[0];
+		play = chan[1];
+	} else {
+		play = chan[0];
+	}
+
+	return snd_cs4231_create(&pdev->dev, SNDRV_DEFAULT_IDX1,
+				 SNDRV_DEFAULT_STR1, res->start,
+				 SNDRV_AUTO_PORT, irq, SNDRV_AUTO_IRQ,
+				 play, capt);
+}
+
+static const struct of_device_id snd_cs4231_of_match[] = {
+	{ .compatible = "pnpPNP,b007" },	/* Windows Sound System */
+	{ .compatible = "CRUS,CS4236B" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, snd_cs4231_of_match);
+
+static struct platform_driver snd_cs4231_of_driver = {
+	.probe		= snd_cs4231_of_probe,
+	.driver		= {
+		.name		= DEV_NAME "-of",
+		.of_match_table	= snd_cs4231_of_match,
+	},
+};
+#endif
+
+static bool snd_cs4231_isa_registered;
+
+static int __init alsa_card_cs4231_init(void)
+{
+	bool isa = !IS_ENABLED(CONFIG_OF);
+	int err = 0;
+
+	/* with Open Firmware, ISA cards are only probed when given a port */
+	for (int i = 0; i < SNDRV_CARDS && !isa; i++)
+		isa = port[i] != SNDRV_AUTO_PORT;
+	if (isa) {
+		err = isa_register_driver(&snd_cs4231_driver, SNDRV_CARDS);
+		if (err < 0)
+			return err;
+		snd_cs4231_isa_registered = true;
+	}
+#ifdef CONFIG_OF
+	err = platform_driver_register(&snd_cs4231_of_driver);
+	if (err < 0 && snd_cs4231_isa_registered)
+		isa_unregister_driver(&snd_cs4231_driver);
+#endif
+	return err;
+}
+
+static void __exit alsa_card_cs4231_exit(void)
+{
+#ifdef CONFIG_OF
+	platform_driver_unregister(&snd_cs4231_of_driver);
+#endif
+	if (snd_cs4231_isa_registered)
+		isa_unregister_driver(&snd_cs4231_driver);
+}
+
+module_init(alsa_card_cs4231_init);
+module_exit(alsa_card_cs4231_exit);
