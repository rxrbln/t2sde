diff --git a/drivers/net/ethernet/i825xx/magicst2_82596.c b/drivers/net/ethernet/i825xx/magicst2_82596.c
new file mode 100644
index 000000000000..635d47fc7918
--- /dev/null
+++ b/drivers/net/ethernet/i825xx/magicst2_82596.c
@@ -0,0 +1,636 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Intel 82596 Ethernet on the Samsung i860 MAGIC Station II.
+ *
+ * The 82596 (linear mode) is a bus master on DRAM, but its 32-bit data bus
+ * is wired to the low half of the 64-bit memory bus: chip address =
+ * physical address / 2, and each chip word is the low word of a CPU
+ * doubleword. lib82596 assumes contiguous descriptors, so this driver
+ * keeps all chip structures in an uncached window and reaches every chip
+ * word through stride-aware accessors. Frames use simplified descriptors
+ * with the whole frame in the data area (configure byte 3 = 0x2e).
+ *
+ * Registers (base 0x1c000e00): +0x00 channel attention, +0x10 PORT
+ * (low 16 bits, then high 16 bits), +0x18 interrupt clear. IRQ 14.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/delay.h>
+#include <linux/etherdevice.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/netdevice.h>
+#include <linux/platform_device.h>
+#include <linux/skbuff.h>
+#include <linux/vmalloc.h>
+#include <linux/unaligned.h>
+#include <asm/cacheflush.h>
+
+#define DRV_NAME	"magicst2-82596"
+
+#define REG_CA		0x00
+#define REG_PORT	0x10
+#define REG_IRQ_CLR	0x18
+
+#define PORT_RESET	0
+#define PORT_ALT_SCP	2
+
+/* chip space layout (chip byte offsets) */
+#define CHIP_SIZE	0x8000
+#define OFF_SCP		0x0000
+#define OFF_ISCP	0x0010
+#define OFF_SCB		0x0020
+#define OFF_CMD		0x0060		/* configure / IA setup */
+#define OFF_TX		0x0080
+#define FRAME_SIZE	0x0600		/* descriptor + 1520 data bytes */
+#define DATA_SIZE	(FRAME_SIZE - 16)
+#define OFF_RX		(OFF_TX + FRAME_SIZE)
+#define N_RX		((CHIP_SIZE - OFF_RX) / FRAME_SIZE)
+
+/* SCB */
+#define SCB_STATUS	0
+#define SCB_CMD		2
+#define SCB_CBL		4
+#define SCB_RFA		8
+#define SCB_TON		36
+#define SCB_TOFF	38
+
+#define STAT_CX		0x8000
+#define STAT_FR		0x4000
+#define STAT_CNA	0x2000
+#define STAT_RNR	0x1000
+#define STAT_ACK	0xf000
+#define RUS_MASK	0x00f0
+#define RUS_READY	0x0040
+
+#define CUC_START	0x0100
+#define RUC_START	0x0010
+#define RUC_ABORT	0x0040
+#define CUC_ABORT	0x0400
+
+/* command blocks and receive frame descriptors */
+#define CB_STATUS	0
+#define CB_CMD		2
+#define CB_LINK		4
+#define CB_PARAM	8
+#define CB_TBD		8
+#define CB_COUNT	12
+#define CB_DATA		16
+
+#define C_DONE		0x8000
+#define C_OK		0x2000
+#define CMD_EL		0x8000
+#define CMD_SUSP	0x4000
+#define CMD_INTR	0x2000
+#define CMD_IA		1
+#define CMD_CONFIGURE	2
+#define CMD_TX		4
+#define COUNT_EOF	0x8000
+#define COUNT_MASK	0x3fff
+
+#define CHIP_NULL	0xffffffff
+
+/* RFD status error bits */
+#define RFD_CRC		0x0800
+#define RFD_ALIGN	0x0400
+#define RFD_OVERRUN	0x0100
+#define RFD_SHORT	0x0080
+
+static const u8 i596_config[14] = {
+	0x8e, 0xc8, 0x80, 0x2e, 0x00, 0x60, 0x00, 0xf2,
+	0x00, 0x00, 0x40, 0xff, 0x00, 0x7f,
+};
+#define CFG_LOOPBACK_BYTE	3
+#define CFG_INT_LOOPBACK	0x40
+#define CFG_PROMISC_BYTE	8
+#define CFG_PROMISC		0x01
+
+struct ms2_lan {
+	struct net_device *dev;
+	void __iomem *regs;
+	void *shm;		/* uncached CPU view, 2 * CHIP_SIZE bytes */
+	void *shm_pages;	/* linear map view, only for freeing */
+	u32 chip_base;		/* chip address of shm */
+	unsigned int rx_head;
+	struct sk_buff *tx_skb;
+	spinlock_t lock;
+};
+
+/* chip word n lives in the low half of CPU doubleword n */
+static inline void __iomem *lan_ptr(struct ms2_lan *lp, u32 off)
+{
+	return (void __iomem *)(lp->shm + ((off & ~3U) << 1) + (off & 3));
+}
+
+static inline void lan_w32(struct ms2_lan *lp, u32 off, u32 v)
+{
+	__raw_writel(v, lan_ptr(lp, off));
+}
+
+static inline u32 lan_r32(struct ms2_lan *lp, u32 off)
+{
+	return __raw_readl(lan_ptr(lp, off));
+}
+
+static inline void lan_w16(struct ms2_lan *lp, u32 off, u16 v)
+{
+	__raw_writew(v, lan_ptr(lp, off));
+}
+
+static inline u16 lan_r16(struct ms2_lan *lp, u32 off)
+{
+	return __raw_readw(lan_ptr(lp, off));
+}
+
+static inline u32 lan_chip(struct ms2_lan *lp, u32 off)
+{
+	return lp->chip_base + off;
+}
+
+static void lan_put_data(struct ms2_lan *lp, u32 off, const u8 *src,
+			 unsigned int len)
+{
+	unsigned int i;
+
+	for (i = 0; i + 4 <= len; i += 4)
+		lan_w32(lp, off + i, get_unaligned_le32(src + i));
+	for (; i < len; i++)
+		__raw_writeb(src[i], lan_ptr(lp, off + i));
+}
+
+static void lan_get_data(struct ms2_lan *lp, u8 *dst, u32 off,
+			 unsigned int len)
+{
+	unsigned int i;
+
+	for (i = 0; i + 4 <= len; i += 4)
+		put_unaligned_le32(lan_r32(lp, off + i), dst + i);
+	for (; i < len; i++)
+		dst[i] = __raw_readb(lan_ptr(lp, off + i));
+}
+
+static void lan_ca(struct ms2_lan *lp)
+{
+	wmb();
+	writel(1, lp->regs + REG_CA);
+}
+
+static void lan_port(struct ms2_lan *lp, u32 cmd)
+{
+	writel(cmd & 0xffff, lp->regs + REG_PORT);
+	udelay(10);
+	writel(cmd >> 16, lp->regs + REG_PORT);
+	udelay(10);
+}
+
+/* The SCB command field reads 0 once the chip has accepted a command. */
+static int lan_wait_scb(struct ms2_lan *lp)
+{
+	int i;
+
+	for (i = 0; i < 10000; i++) {
+		if (!lan_r16(lp, OFF_SCB + SCB_CMD))
+			return 0;
+		udelay(5);
+	}
+	netdev_err(lp->dev, "SCB command timeout, status %04x\n",
+		   lan_r16(lp, OFF_SCB + SCB_STATUS));
+	return -ETIMEDOUT;
+}
+
+static int lan_scb_cmd(struct ms2_lan *lp, u16 cmd)
+{
+	int ret = lan_wait_scb(lp);
+
+	lan_w16(lp, OFF_SCB + SCB_CMD, cmd);
+	lan_ca(lp);
+	return ret;
+}
+
+/* Run one action command at OFF_CMD and wait for it to complete. */
+static int lan_action(struct ms2_lan *lp, u16 cmd, const u8 *param,
+		      unsigned int len)
+{
+	int i;
+
+	lan_w16(lp, OFF_CMD + CB_STATUS, 0);
+	lan_w16(lp, OFF_CMD + CB_CMD, CMD_EL | cmd);
+	lan_w32(lp, OFF_CMD + CB_LINK, CHIP_NULL);
+	lan_put_data(lp, OFF_CMD + CB_PARAM, param, len);
+	lan_w32(lp, OFF_SCB + SCB_CBL, lan_chip(lp, OFF_CMD));
+	if (lan_scb_cmd(lp, CUC_START))
+		return -ETIMEDOUT;
+
+	for (i = 0; i < 10000; i++) {
+		u16 status = lan_r16(lp, OFF_CMD + CB_STATUS);
+
+		if (status & C_DONE) {
+			/* acknowledge CX/CNA only: FR/RNR stay for the interrupt */
+			lan_scb_cmd(lp, lan_r16(lp, OFF_SCB + SCB_STATUS) &
+					(STAT_CX | STAT_CNA));
+			return (status & C_OK) ? 0 : -EIO;
+		}
+		udelay(10);
+	}
+	netdev_err(lp->dev, "command %d timeout\n", cmd);
+	return -ETIMEDOUT;
+}
+
+static int lan_configure(struct ms2_lan *lp)
+{
+	u8 cfg[sizeof(i596_config)];
+
+	memcpy(cfg, i596_config, sizeof(cfg));
+	if (lp->dev->features & NETIF_F_LOOPBACK)
+		cfg[CFG_LOOPBACK_BYTE] |= CFG_INT_LOOPBACK;
+	if (lp->dev->flags & IFF_PROMISC)
+		cfg[CFG_PROMISC_BYTE] |= CFG_PROMISC;
+	return lan_action(lp, CMD_CONFIGURE, cfg, sizeof(cfg));
+}
+
+static u32 rfd_off(unsigned int n)
+{
+	return OFF_RX + n * FRAME_SIZE;
+}
+
+static void lan_init_rx(struct ms2_lan *lp)
+{
+	unsigned int n;
+
+	for (n = 0; n < N_RX; n++) {
+		u32 rfd = rfd_off(n);
+
+		lan_w16(lp, rfd + CB_STATUS, 0);
+		lan_w16(lp, rfd + CB_CMD, n == N_RX - 1 ? CMD_EL : 0);
+		lan_w32(lp, rfd + CB_LINK, lan_chip(lp, rfd_off((n + 1) % N_RX)));
+		lan_w32(lp, rfd + CB_TBD, CHIP_NULL);
+		lan_w16(lp, rfd + CB_COUNT, 0);
+		lan_w16(lp, rfd + CB_COUNT + 2, DATA_SIZE);
+	}
+	lp->rx_head = 0;
+}
+
+static int lan_start_rx(struct ms2_lan *lp)
+{
+	lan_w32(lp, OFF_SCB + SCB_RFA, lan_chip(lp, rfd_off(lp->rx_head)));
+	return lan_scb_cmd(lp, RUC_START);
+}
+
+static int lan_hw_init(struct ms2_lan *lp)
+{
+	struct net_device *dev = lp->dev;
+	int i, ret;
+
+	lan_port(lp, PORT_RESET);
+	udelay(100);
+
+	memset(lp->shm, 0, 2 * CHIP_SIZE);
+	lan_w32(lp, OFF_SCP, 0x005c0000);	/* SYSBUS: linear mode */
+	lan_w32(lp, OFF_SCP + 8, lan_chip(lp, OFF_ISCP));
+	lan_w32(lp, OFF_ISCP, 1);		/* busy */
+	lan_w32(lp, OFF_ISCP + 4, lan_chip(lp, OFF_SCB));
+	lan_w32(lp, OFF_SCB + SCB_CBL, CHIP_NULL);
+	lan_w32(lp, OFF_SCB + SCB_RFA, CHIP_NULL);
+
+	lan_port(lp, lan_chip(lp, OFF_SCP) | PORT_ALT_SCP);
+	lan_ca(lp);
+
+	for (i = 0; i < 10000 && (lan_r32(lp, OFF_ISCP) & 0xff); i++)
+		udelay(10);
+	if (lan_r32(lp, OFF_ISCP) & 0xff) {
+		netdev_err(dev, "82596 initialisation timeout\n");
+		return -ETIMEDOUT;
+	}
+	lan_scb_cmd(lp, lan_r16(lp, OFF_SCB + SCB_STATUS) & STAT_ACK);
+
+	ret = lan_configure(lp);
+	if (!ret)
+		ret = lan_action(lp, CMD_IA, dev->dev_addr, ETH_ALEN);
+	if (ret) {
+		netdev_err(dev, "82596 setup failed (%d)\n", ret);
+		return ret;
+	}
+
+	lan_init_rx(lp);
+	return lan_start_rx(lp);
+}
+
+static void lan_rx(struct ms2_lan *lp)
+{
+	struct net_device *dev = lp->dev;
+
+	for (;;) {
+		u32 rfd = rfd_off(lp->rx_head);
+		u32 prev = rfd_off((lp->rx_head + N_RX - 1) % N_RX);
+		u16 status = lan_r16(lp, rfd + CB_STATUS);
+		unsigned int len;
+		struct sk_buff *skb;
+
+		if (!(status & C_DONE))
+			break;
+
+		len = lan_r16(lp, rfd + CB_COUNT) & COUNT_MASK;
+		if ((status & C_OK) && len >= ETH_HLEN) {
+			skb = netdev_alloc_skb(dev, len + NET_IP_ALIGN);
+			if (skb) {
+				skb_reserve(skb, NET_IP_ALIGN);
+				lan_get_data(lp, skb_put(skb, len), rfd + CB_DATA, len);
+				skb->protocol = eth_type_trans(skb, dev);
+				netif_rx(skb);
+				dev->stats.rx_packets++;
+				dev->stats.rx_bytes += len;
+			} else {
+				dev->stats.rx_dropped++;
+			}
+		} else {
+			dev->stats.rx_errors++;
+			if (status & RFD_CRC)
+				dev->stats.rx_crc_errors++;
+			if (status & RFD_ALIGN)
+				dev->stats.rx_frame_errors++;
+			if (status & RFD_OVERRUN)
+				dev->stats.rx_over_errors++;
+			if (status & RFD_SHORT)
+				dev->stats.rx_length_errors++;
+		}
+
+		/* this RFD becomes the end of the list */
+		lan_w16(lp, rfd + CB_STATUS, 0);
+		lan_w16(lp, rfd + CB_COUNT, 0);
+		lan_w16(lp, rfd + CB_CMD, CMD_EL);
+		lan_w16(lp, prev + CB_CMD, 0);
+		lp->rx_head = (lp->rx_head + 1) % N_RX;
+	}
+}
+
+static irqreturn_t lan_interrupt(int irq, void *dev_id)
+{
+	struct net_device *dev = dev_id;
+	struct ms2_lan *lp = netdev_priv(dev);
+	u16 status;
+
+	spin_lock(&lp->lock);
+	writel(0, lp->regs + REG_IRQ_CLR);
+	lan_wait_scb(lp);
+	status = lan_r16(lp, OFF_SCB + SCB_STATUS);
+	if (status & STAT_ACK)
+		lan_scb_cmd(lp, status & STAT_ACK);
+
+	if (status & (STAT_FR | STAT_RNR))
+		lan_rx(lp);
+	if ((status & STAT_RNR) || ((status & RUS_MASK) != RUS_READY &&
+				    netif_running(dev)))
+		lan_start_rx(lp);
+
+	if (lp->tx_skb && (lan_r16(lp, OFF_TX + CB_STATUS) & C_DONE)) {
+		if (lan_r16(lp, OFF_TX + CB_STATUS) & C_OK) {
+			dev->stats.tx_packets++;
+			dev->stats.tx_bytes += lp->tx_skb->len;
+		} else {
+			dev->stats.tx_errors++;
+		}
+		dev_consume_skb_irq(lp->tx_skb);
+		lp->tx_skb = NULL;
+		netif_wake_queue(dev);
+	}
+	spin_unlock(&lp->lock);
+	return IRQ_HANDLED;
+}
+
+static netdev_tx_t lan_start_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	struct ms2_lan *lp = netdev_priv(dev);
+	unsigned long flags;
+	unsigned int len;
+
+	if (skb_put_padto(skb, ETH_ZLEN))
+		return NETDEV_TX_OK;
+	len = skb->len;
+	if (len > DATA_SIZE) {
+		dev->stats.tx_dropped++;
+		dev_kfree_skb_any(skb);
+		return NETDEV_TX_OK;
+	}
+
+	spin_lock_irqsave(&lp->lock, flags);
+	netif_stop_queue(dev);
+	lp->tx_skb = skb;
+	lan_w16(lp, OFF_TX + CB_STATUS, 0);
+	lan_w16(lp, OFF_TX + CB_CMD, CMD_EL | CMD_INTR | CMD_TX);
+	lan_w32(lp, OFF_TX + CB_LINK, CHIP_NULL);
+	lan_w32(lp, OFF_TX + CB_TBD, CHIP_NULL);
+	lan_w16(lp, OFF_TX + CB_COUNT, len | COUNT_EOF);
+	lan_put_data(lp, OFF_TX + CB_DATA, skb->data, len);
+	lan_w32(lp, OFF_SCB + SCB_CBL, lan_chip(lp, OFF_TX));
+	lan_scb_cmd(lp, CUC_START);
+	spin_unlock_irqrestore(&lp->lock, flags);
+
+	netif_trans_update(dev);
+	return NETDEV_TX_OK;
+}
+
+static void lan_tx_timeout(struct net_device *dev, unsigned int txqueue)
+{
+	struct ms2_lan *lp = netdev_priv(dev);
+	unsigned long flags;
+
+	netdev_warn(dev, "transmit timeout, status %04x\n",
+		    lan_r16(lp, OFF_SCB + SCB_STATUS));
+	spin_lock_irqsave(&lp->lock, flags);
+	if (lp->tx_skb) {
+		dev_kfree_skb_any(lp->tx_skb);
+		lp->tx_skb = NULL;
+		dev->stats.tx_errors++;
+	}
+	lan_hw_init(lp);
+	spin_unlock_irqrestore(&lp->lock, flags);
+	netif_wake_queue(dev);
+}
+
+static int lan_open(struct net_device *dev)
+{
+	struct ms2_lan *lp = netdev_priv(dev);
+	int ret;
+
+	ret = request_irq(dev->irq, lan_interrupt, 0, dev->name, dev);
+	if (ret)
+		return ret;
+	ret = lan_hw_init(lp);
+	if (ret) {
+		free_irq(dev->irq, dev);
+		return ret;
+	}
+	netif_start_queue(dev);
+	return 0;
+}
+
+static int lan_stop(struct net_device *dev)
+{
+	struct ms2_lan *lp = netdev_priv(dev);
+
+	netif_stop_queue(dev);
+	lan_port(lp, PORT_RESET);
+	free_irq(dev->irq, dev);
+	if (lp->tx_skb) {
+		dev_kfree_skb(lp->tx_skb);
+		lp->tx_skb = NULL;
+	}
+	return 0;
+}
+
+/* Re-run Configure; the CU is idle while no frame is in flight. */
+static void lan_reconfigure(struct net_device *dev)
+{
+	struct ms2_lan *lp = netdev_priv(dev);
+	unsigned long flags;
+
+	if (!netif_running(dev))
+		return;
+	spin_lock_irqsave(&lp->lock, flags);
+	if (!lp->tx_skb && lan_configure(lp))
+		netdev_warn(dev, "reconfiguration failed\n");
+	spin_unlock_irqrestore(&lp->lock, flags);
+}
+
+static void lan_set_rx_mode(struct net_device *dev)
+{
+	lan_reconfigure(dev);
+}
+
+static int lan_set_features(struct net_device *dev, netdev_features_t features)
+{
+	netdev_features_t changed = dev->features ^ features;
+
+	dev->features = features;
+	if (changed & NETIF_F_LOOPBACK)
+		lan_reconfigure(dev);
+	return 0;
+}
+
+static const struct net_device_ops lan_netdev_ops = {
+	.ndo_open		= lan_open,
+	.ndo_stop		= lan_stop,
+	.ndo_start_xmit		= lan_start_xmit,
+	.ndo_tx_timeout		= lan_tx_timeout,
+	.ndo_set_rx_mode	= lan_set_rx_mode,
+	.ndo_set_features	= lan_set_features,
+	.ndo_set_mac_address	= eth_mac_addr,
+	.ndo_validate_addr	= eth_validate_addr,
+};
+
+/* 64 KB of contiguous memory, used through an uncached mapping only. */
+static int lan_alloc_shm(struct ms2_lan *lp)
+{
+	unsigned int n = (2 * CHIP_SIZE) >> PAGE_SHIFT, i;
+	struct page **pages;
+	struct page *page;
+
+	lp->shm_pages = alloc_pages_exact(2 * CHIP_SIZE, GFP_KERNEL | __GFP_ZERO);
+	if (!lp->shm_pages)
+		return -ENOMEM;
+	/* no dirty lines of the cached alias may be written back later */
+	flush_cache_all();
+
+	pages = kmalloc_array(n, sizeof(*pages), GFP_KERNEL);
+	if (!pages)
+		goto err;
+	page = virt_to_page(lp->shm_pages);
+	for (i = 0; i < n; i++)
+		pages[i] = page + i;
+	lp->shm = vmap(pages, n, VM_MAP, pgprot_noncached(PAGE_KERNEL));
+	kfree(pages);
+	if (!lp->shm)
+		goto err;
+	lp->chip_base = virt_to_phys(lp->shm_pages) >> 1;
+	return 0;
+err:
+	free_pages_exact(lp->shm_pages, 2 * CHIP_SIZE);
+	return -ENOMEM;
+}
+
+static void lan_free_shm(struct ms2_lan *lp)
+{
+	vunmap(lp->shm);
+	free_pages_exact(lp->shm_pages, 2 * CHIP_SIZE);
+}
+
+static int lan_probe(struct platform_device *pdev)
+{
+	struct resource *regs, *mac;
+	void __iomem *nvram;
+	struct net_device *dev;
+	struct ms2_lan *lp;
+	u8 addr[ETH_ALEN];
+	int irq, i, ret;
+
+	regs = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	mac = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	irq = platform_get_irq(pdev, 0);
+	if (!regs || !mac || irq < 0)
+		return -ENODEV;
+
+	dev = devm_alloc_etherdev(&pdev->dev, sizeof(*lp));
+	if (!dev)
+		return -ENOMEM;
+	SET_NETDEV_DEV(dev, &pdev->dev);
+	lp = netdev_priv(dev);
+	lp->dev = dev;
+	spin_lock_init(&lp->lock);
+
+	lp->regs = devm_ioremap(&pdev->dev, regs->start, resource_size(regs));
+	nvram = devm_ioremap(&pdev->dev, mac->start, resource_size(mac));
+	if (!lp->regs || !nvram)
+		return -ENOMEM;
+
+	/* MAC address: NVRAM, one byte per 8-byte location */
+	for (i = 0; i < ETH_ALEN; i++)
+		addr[i] = readb(nvram + 8 * i);
+	if (is_valid_ether_addr(addr)) {
+		eth_hw_addr_set(dev, addr);
+	} else {
+		dev_warn(&pdev->dev, "invalid NVRAM MAC address %pM\n", addr);
+		eth_hw_addr_random(dev);
+	}
+
+	ret = lan_alloc_shm(lp);
+	if (ret)
+		return ret;
+
+	dev->irq = irq;
+	dev->netdev_ops = &lan_netdev_ops;
+	dev->hw_features |= NETIF_F_LOOPBACK;
+	dev->watchdog_timeo = HZ;
+	lan_port(lp, PORT_RESET);
+
+	ret = register_netdev(dev);
+	if (ret) {
+		lan_free_shm(lp);
+		return ret;
+	}
+	platform_set_drvdata(pdev, dev);
+	netdev_info(dev, "82596 at %pa, IRQ %d, MAC %pM\n", &regs->start, irq,
+		    dev->dev_addr);
+	return 0;
+}
+
+static void lan_remove(struct platform_device *pdev)
+{
+	struct net_device *dev = platform_get_drvdata(pdev);
+
+	unregister_netdev(dev);
+	lan_free_shm(netdev_priv(dev));
+}
+
+static struct platform_driver lan_driver = {
+	.probe	= lan_probe,
+	.remove	= lan_remove,
+	.driver	= {
+		.name	= DRV_NAME,
+	},
+};
+module_platform_driver(lan_driver);
+
+MODULE_DESCRIPTION("Samsung MAGIC Station II 82596 Ethernet");
+MODULE_LICENSE("GPL");
diff --git a/drivers/rtc/rtc-msm6242.c b/drivers/rtc/rtc-msm6242.c
index 80e364baac53..021c8d678f8c 100644
--- a/drivers/rtc/rtc-msm6242.c
+++ b/drivers/rtc/rtc-msm6242.c
@@ -3,6 +3,7 @@
  *  Oki MSM6242 RTC Driver
  *
  *  Copyright 2009 Geert Uytterhoeven
+ *  Copyright (C) 2026 René Rebe <rene@exactco.de>
  *
  *  Based on the A2000 TOD code in arch/m68k/amiga/config.c
  *  Copyright (C) 1993 Hamish Macdonald
@@ -15,6 +16,7 @@
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/platform_data/rtc-msm6242.h>
 #include <linux/rtc.h>
 #include <linux/slab.h>
 
@@ -72,20 +74,21 @@ enum {
 
 
 struct msm6242_priv {
-	u32 __iomem *regs;
+	void __iomem *regs;
+	unsigned int stride;		/* bytes per register */
 	struct rtc_device *rtc;
 };
 
 static inline unsigned int msm6242_read(struct msm6242_priv *priv,
 				       unsigned int reg)
 {
-	return __raw_readl(&priv->regs[reg]) & 0xf;
+	return __raw_readl(priv->regs + reg * priv->stride) & 0xf;
 }
 
 static inline void msm6242_write(struct msm6242_priv *priv, unsigned int val,
 				unsigned int reg)
 {
-	__raw_writel(val, &priv->regs[reg]);
+	__raw_writel(val, priv->regs + reg * priv->stride);
 }
 
 static void msm6242_lock(struct msm6242_priv *priv)
@@ -189,6 +192,7 @@ static const struct rtc_class_ops msm6242_rtc_ops = {
 static int __init msm6242_rtc_probe(struct platform_device *pdev)
 {
 	struct resource *res;
+	const struct msm6242_platform_data *pdata;
 	struct msm6242_priv *priv;
 	struct rtc_device *rtc;
 
@@ -200,6 +204,9 @@ static int __init msm6242_rtc_probe(struct platform_device *pdev)
 	if (!priv)
 		return -ENOMEM;
 
+	/* registers are 32 bits apart unless the platform says otherwise */
+	pdata = dev_get_platdata(&pdev->dev);
+	priv->stride = 4 << (pdata ? pdata->reg_shift : 0);
 	priv->regs = devm_ioremap(&pdev->dev, res->start, resource_size(res));
 	if (!priv->regs)
 		return -ENOMEM;
