diff --git a/drivers/scsi/magicst2.c b/drivers/scsi/magicst2.c
new file mode 100644
index 000000000000..75ceb5152428
--- /dev/null
+++ b/drivers/scsi/magicst2.c
@@ -0,0 +1,228 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung i860 MAGIC Station II WD33C93A SCSI glue.
+ *
+ * The WD33C93A (indirect register access at 0x1c000a00/0x1c000a08, IRQ 13)
+ * transfers data with 82380 DMA channel 1 into the DMA buffer SRAM; the CPU
+ * bounces it to and from memory. As all data passes the SRAM, the whole
+ * remaining scatter-gather list is presented to the wd33c93 core as one
+ * segment: one DMA per command, and the chip is only resumed in the data
+ * phase after a disconnect.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/scatterlist.h>
+#include <asm/i860-dma.h>
+
+#include <scsi/scsi.h>
+#include <scsi/scsi_cmnd.h>
+#include <scsi/scsi_device.h>
+#include <scsi/scsi_eh.h>
+#include <scsi/scsi_host.h>
+
+#include "wd33c93.h"
+
+#define CAN_QUEUE	16
+#define CMD_PER_LUN	2
+
+struct magicst2_scsi {
+	struct WD33C93_hostdata wh;	/* must be first */
+	size_t dma_len;
+};
+
+/* per-command data; the wd33c93 core uses the scsi_pointer at the start */
+struct magicst2_cmd {
+	struct scsi_pointer scp;
+	size_t offset;			/* bytes of the data phase done */
+};
+
+static inline struct magicst2_cmd *magicst2_cmd(struct scsi_cmnd *cmd)
+{
+	return scsi_cmd_priv(cmd);
+}
+
+/* Copy len bytes at offset skip of the command's data to or from the SRAM. */
+static void magicst2_sg_copy(struct scsi_cmnd *cmd, size_t skip, size_t len,
+			     bool to_sram)
+{
+	struct sg_mapping_iter miter;
+	unsigned long sram = I860_SRAM_SCSI;
+
+	sg_miter_start(&miter, scsi_sglist(cmd), scsi_sg_count(cmd),
+		       SG_MITER_ATOMIC |
+		       (to_sram ? SG_MITER_FROM_SG : SG_MITER_TO_SG));
+	if (sg_miter_skip(&miter, skip)) {
+		while (len && sg_miter_next(&miter)) {
+			size_t n = min(miter.length, len);
+
+			if (to_sram)
+				i860_sram_write(sram, miter.addr, n);
+			else
+				i860_sram_read(miter.addr, sram, n);
+			sram += n;
+			len -= n;
+		}
+	}
+	sg_miter_stop(&miter);
+}
+
+static enum scsi_qc_status magicst2_queuecommand(struct Scsi_Host *instance,
+						 struct scsi_cmnd *cmd)
+{
+	magicst2_cmd(cmd)->offset = 0;
+	return wd33c93_queuecommand(instance, cmd);
+}
+
+static irqreturn_t magicst2_scsi_intr(int irq, void *data)
+{
+	struct Scsi_Host *instance = data;
+	unsigned long flags;
+
+	spin_lock_irqsave(&instance->host_lock, flags);
+	wd33c93_intr(instance);
+	spin_unlock_irqrestore(&instance->host_lock, flags);
+	return IRQ_HANDLED;
+}
+
+static int magicst2_dma_setup(struct scsi_cmnd *cmd, int dir_in)
+{
+	struct scsi_pointer *scsi_pointer = WD33C93_scsi_pointer(cmd);
+	struct magicst2_scsi *hdata = shost_priv(cmd->device->host);
+	size_t offset = magicst2_cmd(cmd)->offset;
+	size_t len = scsi_bufflen(cmd) - offset;
+
+	/* max_sectors keeps commands within the SRAM partition */
+	if (!len || len > I860_SRAM_SCSI_SIZE)
+		return 1;
+
+	/* the core programs the WD33C93 count from this_residual */
+	scsi_pointer->this_residual = len;
+	scsi_pointer->buffers_residual = 0;
+	if (!dir_in)
+		magicst2_sg_copy(cmd, offset, len, true);
+	hdata->wh.dma_dir = dir_in;
+	hdata->dma_len = len;
+	i860_dma_start(I860_DMA_SCSI, I860_SRAM_SCSI, len, !dir_in);
+	return 0;
+}
+
+static void magicst2_dma_stop(struct Scsi_Host *instance,
+			      struct scsi_cmnd *cmd, int status)
+{
+	struct magicst2_scsi *hdata = shost_priv(instance);
+	struct magicst2_cmd *mcmd = magicst2_cmd(cmd);
+	size_t done;
+
+	i860_dma_stop(I860_DMA_SCSI);
+	if (!hdata->dma_len)
+		return;
+	/* this_residual is updated from the WD33C93 count after we return */
+	done = hdata->dma_len - min(i860_dma_residue(I860_DMA_SCSI),
+				    hdata->dma_len);
+	if (hdata->wh.dma_dir)
+		magicst2_sg_copy(cmd, mcmd->offset, done, false);
+	mcmd->offset += done;
+	hdata->dma_len = 0;
+}
+
+static const struct scsi_host_template magicst2_scsi_template = {
+	.module			= THIS_MODULE,
+	.proc_name		= "magicst2",
+	.name			= "MAGIC Station II WD33C93A SCSI",
+	.queuecommand		= magicst2_queuecommand,
+	.eh_abort_handler	= wd33c93_abort,
+	.eh_host_reset_handler	= wd33c93_host_reset,
+	.show_info		= wd33c93_show_info,
+	.write_info		= wd33c93_write_info,
+	.can_queue		= CAN_QUEUE,
+	.this_id		= 7,
+	.sg_tablesize		= SG_ALL,
+	.cmd_per_lun		= CMD_PER_LUN,
+	.max_sectors		= I860_SRAM_SCSI_SIZE / 512,
+	.cmd_size		= sizeof(struct magicst2_cmd),
+};
+
+static int magicst2_scsi_probe(struct platform_device *pdev)
+{
+	struct Scsi_Host *instance;
+	struct magicst2_scsi *hdata;
+	struct resource *res;
+	wd33c93_regs regs;
+	void __iomem *base;
+	int irq, error, i;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	irq = platform_get_irq(pdev, 0);
+	if (!res || irq < 0)
+		return -ENODEV;
+	base = devm_ioremap(&pdev->dev, res->start, resource_size(res));
+	if (!base)
+		return -ENOMEM;
+
+	instance = scsi_host_alloc(&magicst2_scsi_template, sizeof(*hdata));
+	if (!instance)
+		return -ENOMEM;
+	instance->irq = irq;
+	instance->base = res->start;
+
+	/* address/aux status at +0, data at +8 */
+	regs.SASR = (volatile unsigned char *)base;
+	regs.SCMD = (volatile unsigned char *)(base + 8);
+
+	hdata = shost_priv(instance);
+	hdata->wh.no_sync = 0xff;
+	hdata->wh.fast = 0;
+	hdata->wh.dma_mode = CTRL_BURST;
+	wd33c93_init(instance, regs, magicst2_dma_setup, magicst2_dma_stop,
+		     WD33C93_FS_8_10);
+	/*
+	 * The bus runs asynchronously, as with the firmware and the Stardent
+	 * kernel: skip the SDTR exchange, which costs the first command its data.
+	 */
+	for (i = 0; i < 8; i++)
+		hdata->wh.sync_stat[i] = SS_SET;
+
+	error = request_irq(irq, magicst2_scsi_intr, 0, "wd33c93", instance);
+	if (error)
+		goto err_put;
+
+	error = scsi_add_host(instance, &pdev->dev);
+	if (error)
+		goto err_irq;
+	platform_set_drvdata(pdev, instance);
+	scsi_scan_host(instance);
+	return 0;
+
+err_irq:
+	free_irq(irq, instance);
+err_put:
+	scsi_host_put(instance);
+	return error;
+}
+
+static void magicst2_scsi_remove(struct platform_device *pdev)
+{
+	struct Scsi_Host *instance = platform_get_drvdata(pdev);
+
+	scsi_remove_host(instance);
+	free_irq(instance->irq, instance);
+	scsi_host_put(instance);
+}
+
+static struct platform_driver magicst2_scsi_driver = {
+	.probe	= magicst2_scsi_probe,
+	.remove	= magicst2_scsi_remove,
+	.driver	= {
+		.name	= "magicst2-scsi",
+	},
+};
+module_platform_driver(magicst2_scsi_driver);
+
+MODULE_DESCRIPTION("Samsung MAGIC Station II WD33C93A SCSI");
+MODULE_LICENSE("GPL");
diff --git a/include/linux/platform_data/rtc-msm6242.h b/include/linux/platform_data/rtc-msm6242.h
new file mode 100644
index 000000000000..e085fce08289
--- /dev/null
+++ b/include/linux/platform_data/rtc-msm6242.h
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef __LINUX_PLATFORM_DATA_RTC_MSM6242_H
+#define __LINUX_PLATFORM_DATA_RTC_MSM6242_H
+
+struct msm6242_platform_data {
+	/* register n is at n * (4 << reg_shift); 0 without platform data */
+	unsigned int reg_shift;
+};
+
+#endif
