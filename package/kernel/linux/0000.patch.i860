diff --git a/arch/i860/Kconfig b/arch/i860/Kconfig
new file mode 100644
index 000000000000..3e267f3b8a09
--- /dev/null
+++ b/arch/i860/Kconfig
@@ -0,0 +1,92 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Intel i860 (Samsung MAGIC Station II)
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+#
+
+config I860
+	def_bool y
+	select ARCH_32BIT_OFF_T
+	select ARCH_MIGHT_HAVE_PC_SERIO
+	select ARCH_NO_PREEMPT
+	select CPU_NO_EFFICIENT_FFS
+	select GENERIC_ATOMIC64
+	select GENERIC_CPU_DEVICES
+	select GENERIC_ENTRY
+	select GENERIC_SCHED_CLOCK
+	select GENERIC_IRQ_PROBE
+	select GENERIC_IRQ_SHOW
+	select GENERIC_IRQ_MULTI_HANDLER
+	select GENERIC_IOREMAP
+	select GENERIC_SMP_IDLE_THREAD
+	select HAVE_ARCH_TRACEHOOK
+	select HAVE_GENERIC_TIF_BITS
+	select HAVE_PAGE_SIZE_4KB
+	select HAVE_SYSCALL_TRACEPOINTS
+	select LOCK_MM_AND_FIND_VMA
+	select MMU_GATHER_NO_RANGE
+	select MODULES_USE_ELF_RELA
+	select NEED_DMA_MAP_STATE
+	select TRACE_IRQFLAGS_SUPPORT
+
+config MMU
+	def_bool y
+
+config GENERIC_CSUM
+	def_bool y
+
+config GENERIC_HWEIGHT
+	def_bool y
+
+config GENERIC_CALIBRATE_DELAY
+	def_bool y
+
+config NO_IOPORT_MAP
+	def_bool y
+
+config STACKTRACE_SUPPORT
+	def_bool n
+
+config LOCKDEP_SUPPORT
+	def_bool n
+
+config ARCH_MAY_HAVE_PC_FDC
+	def_bool y
+
+config NR_CPUS
+	int
+	default "1"
+
+config PGTABLE_LEVELS
+	int
+	default 2
+
+menu "Processor type and features"
+
+config I860_MAGICST2
+	def_bool y
+	help
+	  Samsung i860 MAGIC Station II: i860XR, Intel 82380, WD33C93,
+	  82077 floppy, 82596 LAN, 16450 UARTs and DRAM at the top of the
+	  physical address space.
+
+config I860_KERNEL_BASE
+	hex "Kernel load and link address"
+	default 0xff800000
+	help
+	  Physical (= virtual) address the kernel image is loaded to. The
+	  default is the start of the smallest (8 MB) DRAM configuration.
+
+source "kernel/Kconfig.hz"
+
+config CMDLINE
+	string "Default kernel command line"
+	default "console=tty0 console=ttyS0,9600"
+
+config CMDLINE_FORCE
+	bool "Always use the default kernel command line"
+	default y
+	help
+	  The boot loader does not pass a command line yet.
+
+endmenu
