diff --git a/arch/i860/include/asm/irqflags.h b/arch/i860/include/asm/irqflags.h
new file mode 100644
index 000000000000..66217dfeb865
--- /dev/null
+++ b/arch/i860/include/asm/irqflags.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _ASM_I860_IRQFLAGS_H
+#define _ASM_I860_IRQFLAGS_H
+
+#include <asm/i860.h>
+
+static inline unsigned long arch_local_save_flags(void)
+{
+	return i860_ld_c(psr);
+}
+
+static inline void arch_local_irq_restore(unsigned long flags)
+{
+	unsigned long psr = i860_ld_c(psr);
+
+	i860_st_c(psr, (psr & ~PSR_IM) | (flags & PSR_IM));
+}
+
+static inline unsigned long arch_local_irq_save(void)
+{
+	unsigned long psr = i860_ld_c(psr);
+
+	i860_st_c(psr, psr & ~PSR_IM);
+	return psr;
+}
+
+static inline void arch_local_irq_disable(void)
+{
+	i860_st_c(psr, i860_ld_c(psr) & ~PSR_IM);
+}
+
+static inline void arch_local_irq_enable(void)
+{
+	i860_st_c(psr, i860_ld_c(psr) | PSR_IM);
+}
+
+static inline int arch_irqs_disabled_flags(unsigned long flags)
+{
+	return !(flags & PSR_IM);
+}
+
+static inline int arch_irqs_disabled(void)
+{
+	return arch_irqs_disabled_flags(arch_local_save_flags());
+}
+
+#endif
diff --git a/arch/i860/include/asm/linkage.h b/arch/i860/include/asm/linkage.h
