diff --git a/arch/i860/include/asm/entry-common.h b/arch/i860/include/asm/entry-common.h
new file mode 100644
index 000000000000..fe0bbd6d0c38
--- /dev/null
+++ b/arch/i860/include/asm/entry-common.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _ASM_I860_ENTRY_COMMON_H
+#define _ASM_I860_ENTRY_COMMON_H
+
+#include <linux/sched/task_stack.h>
+#include <asm/thread_info.h>
+
+static __always_inline bool on_thread_stack(void)
+{
+	return !((current_stack_pointer ^ (unsigned long)task_stack_page(current)) &
+		 ~(THREAD_SIZE - 1));
+}
+
+#endif
diff --git a/arch/i860/include/asm/floppy.h b/arch/i860/include/asm/floppy.h
new file mode 100644
index 000000000000..6471699ed231
--- /dev/null
+++ b/arch/i860/include/asm/floppy.h
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * 82077 floppy controller on the MAGIC Station II: registers at
+ * 0x1c000c00 + 8 * n, IRQ 15, 82380 DMA channel 0 through the DMA buffer
+ * SRAM. floppy_interrupt() calls fd_disable_dma() first, which copies a
+ * completed read back from the SRAM.
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+#ifndef _ASM_I860_FLOPPY_H
+#define _ASM_I860_FLOPPY_H
+
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <asm/i860-dma.h>
+
+/* floppy.c's FLOPPY_IRQ/FLOPPY_DMA parameters do not apply: both are fixed */
+#define I860_FLOPPY_IRQ	15
+#define FDC_PHYS	0x1c000c00
+
+/* fdc_state[].address only has to be valid; the registers are fixed */
+static int FDC1 = 0x3f0;
+
+#define N_FDC		1
+#define N_DRIVE		8
+#define FLOPPY0_TYPE	4	/* 1.44 MB, 3.5" */
+#define FLOPPY1_TYPE	0
+
+#define fd_inb(base, reg)		readb(I860_IO(FDC_PHYS) + ((reg) << 3))
+#define fd_outb(value, base, reg)	writeb(value, I860_IO(FDC_PHYS) + ((reg) << 3))
+
+#define fd_request_dma()	((void)FLOPPY_DMA, 0)
+#define fd_free_dma()		do { } while (0)
+#define fd_enable_irq()		enable_irq(I860_FLOPPY_IRQ)
+#define fd_disable_irq()	disable_irq(I860_FLOPPY_IRQ)
+#define fd_free_irq()		free_irq(I860_FLOPPY_IRQ, NULL)
+#define fd_get_dma_residue()	i860_dma_residue(I860_DMA_FLOPPY)
+
+static inline int fd_request_irq(void)
+{
+	(void)FLOPPY_IRQ;
+	(void)virtual_dma_port;
+	return request_irq(I860_FLOPPY_IRQ, floppy_interrupt, 0, "floppy", NULL);
+}
+
+static char *fd_dma_buf;
+static size_t fd_dma_len;
+static bool fd_dma_read;
+
+static inline void fd_disable_dma(void)
+{
+	size_t done;
+
+	i860_dma_stop(I860_DMA_FLOPPY);
+	if (fd_dma_buf && fd_dma_read) {
+		done = fd_dma_len - min(i860_dma_residue(I860_DMA_FLOPPY), fd_dma_len);
+		i860_sram_read(fd_dma_buf, I860_SRAM_FLOPPY, done);
+	}
+	fd_dma_buf = NULL;
+}
+
+static inline int fd_dma_setup(char *addr, unsigned long size, int mode, int io)
+{
+	if (size > I860_SRAM_FLOPPY_SIZE)
+		return -EINVAL;
+	fd_dma_read = mode == DMA_MODE_READ;
+	if (!fd_dma_read)
+		i860_sram_write(I860_SRAM_FLOPPY, addr, size);
+	fd_dma_buf = addr;
+	fd_dma_len = size;
+	i860_dma_start(I860_DMA_FLOPPY, I860_SRAM_FLOPPY, size, !fd_dma_read);
+	return 0;
+}
+#define fd_dma_setup fd_dma_setup
+
+#define EXTRA_FLOPPY_PARAMS
+
+#endif
diff --git a/arch/i860/include/asm/i860-dma.h b/arch/i860/include/asm/i860-dma.h
new file mode 100644
index 000000000000..1a223df167b3
--- /dev/null
+++ b/arch/i860/include/asm/i860-dma.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * 82380 DMA on the MAGIC Station II: fly-by transfers between a device and
+ * the 256 KB DMA buffer SRAM at 0x18000000, which holds one 32-bit word
+ * per 8 CPU bytes. Data is bounced between memory and the SRAM by the CPU.
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+#ifndef _ASM_I860_I860_DMA_H
+#define _ASM_I860_I860_DMA_H
+
+#include <linux/types.h>
+
+#define I860_DMA_FLOPPY		0
+#define I860_DMA_SCSI		1
+
+/* SRAM partition (DMA byte offsets), as in the Stardent kernel */
+#define I860_SRAM_SCSI		0x00000
+#define I860_SRAM_SCSI_SIZE	0x30000
+#define I860_SRAM_FLOPPY	0x30000
+#define I860_SRAM_FLOPPY_SIZE	0x08000
+
+void i860_dma_start(unsigned int ch, unsigned long sram, size_t len,
+		    bool to_device);
+void i860_dma_stop(unsigned int ch);
+size_t i860_dma_residue(unsigned int ch);
+void i860_sram_write(unsigned long sram, const void *buf, size_t len);
+void i860_sram_read(void *buf, unsigned long sram, size_t len);
+
+#endif
diff --git a/arch/i860/include/asm/i860.h b/arch/i860/include/asm/i860.h
new file mode 100644
index 000000000000..01f1672d45de
--- /dev/null
+++ b/arch/i860/include/asm/i860.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Intel i860 control registers and fixed kernel layout.
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+#ifndef _ASM_I860_I860_H
+#define _ASM_I860_I860_H
+
+#include <linux/const.h>
+
+/* psr */
+#define PSR_BR		0x00000001
+#define PSR_BW		0x00000002
+#define PSR_CC		0x00000004
+#define PSR_LCC		0x00000008
+#define PSR_IM		0x00000010
+#define PSR_PIM		0x00000020
+#define PSR_U		0x00000040
+#define PSR_PU		0x00000080
+#define PSR_IT		0x00000100
+#define PSR_IN		0x00000200
+#define PSR_IAT		0x00000400
+#define PSR_DAT		0x00000800
+#define PSR_FT		0x00001000
+#define PSR_DS		0x00002000
+#define PSR_DIM		0x00004000
+#define PSR_KNF		0x00008000
+#define PSR_TRAPS	0x00001f00
+
+/* epsr */
+#define EPSR_TYPE	0x000000ff
+#define EPSR_IL		0x00002000
+#define EPSR_WP		0x00004000
+#define EPSR_INT	0x00020000
+#define EPSR_BE		0x00800000
+#define EPSR_OF		0x01000000
+#define EPSR_TYPE_XP	2
+
+/* dirbase */
+#define DIRBASE_ATE	0x00000001
+#define DIRBASE_ITI	0x00000020
+#define DIRBASE_CS8	0x00000080
+#define DIRBASE_RB	0x00000300
+#define DIRBASE_RC	0x00000c00
+#define DIRBASE_RC_FLUSH 0x00000800
+#define DIRBASE_DTB	0xfffff000
+
+/* fsr */
+#define FSR_FZ		0x00000001
+#define FSR_TI		0x00000002
+#define FSR_RM		0x0000000c
+#define FSR_U		0x00000010
+#define FSR_FTE		0x00000020
+#define FSR_RESULT	0x0000ee00	/* M and A underflow, overflow, inexact */
+#define FSR_SI		0x00000080
+#define FSR_SE		0x00000100
+
+/*
+ * The CPU enters every trap at virtual 0xffffff00 with no free register.
+ * The last page holds the vector and scratch words that the entry code
+ * reaches as negative offsets from r0.
+ */
+#define I860_TRAP_PAGE		_AC(0xfffff000, UL)
+#define I860_TRAP_VECTOR	_AC(0xffffff00, UL)
+#define I860_TRAP_VECTOR_MAX	0xb0
+#define SCR_KSP		-4	/* top of the current kernel stack */
+#define SCR_PSR		-8
+#define SCR_R2		-12
+#define SCR_R1		-16
+#define SCR_EXIT	-20
+
+/* DRAM is identity mapped: virtual = physical. */
+#define I860_LOWMEM_BASE	_AC(0xfc000000, UL)
+
+/* Physical 0x1c000000-0x1fffffff (82380, SCSI, FDC, LAN, RTC, UART, NVRAM) */
+#define I860_IO_PHYS		_AC(0x1c000000, UL)
+#define I860_IO_SIZE		_AC(0x04000000, UL)
+#define I860_IO_VIRT		_AC(0xf8000000, UL)
+
+#define I860_VMALLOC_START	_AC(0xe0000000, UL)
+#define I860_VMALLOC_END	I860_IO_VIRT
+
+#ifndef __ASSEMBLER__
+
+#define i860_ld_c(reg)							\
+({									\
+	unsigned long __v;						\
+	asm volatile("ld.c %%" #reg ",%0" : "=r" (__v));		\
+	__v;								\
+})
+
+#define i860_st_c(reg, v)						\
+	asm volatile("st.c %0,%%" #reg : : "r" ((unsigned long)(v)) : "memory")
+
+#endif
+
+#endif
diff --git a/arch/i860/include/asm/io.h b/arch/i860/include/asm/io.h
