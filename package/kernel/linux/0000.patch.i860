diff --git a/arch/i860/include/asm/tlbflush.h b/arch/i860/include/asm/tlbflush.h
new file mode 100644
index 000000000000..f87663f9e2e2
--- /dev/null
+++ b/arch/i860/include/asm/tlbflush.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * The i860XR TLB can only be invalidated as a whole (dirbase.ITI, which
+ * also invalidates the instruction cache).
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+#ifndef _ASM_I860_TLBFLUSH_H
+#define _ASM_I860_TLBFLUSH_H
+
+#ifndef __ASSEMBLER__
+
+struct mm_struct;
+struct vm_area_struct;
+
+extern void local_flush_tlb_all(void);
+
+#define flush_tlb_all()			local_flush_tlb_all()
+#define flush_tlb_mm(mm)		local_flush_tlb_all()
+#define flush_tlb_page(vma, addr)	local_flush_tlb_all()
+/* mprotect to executable: fetches read memory, not the data cache */
+#define flush_tlb_range(vma, s, e)				\
+	do {							\
+		if ((vma)->vm_flags & VM_EXEC)			\
+			i860_flush_dcache_all();		\
+		local_flush_tlb_all();				\
+	} while (0)
+#define flush_tlb_kernel_range(s, e)	local_flush_tlb_all()
+
+#endif
+
+#endif
diff --git a/arch/i860/include/asm/traps.h b/arch/i860/include/asm/traps.h
new file mode 100644
index 000000000000..b572a17e74c8
--- /dev/null
+++ b/arch/i860/include/asm/traps.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _ASM_I860_TRAPS_H
+#define _ASM_I860_TRAPS_H
+
+#include <linux/linkage.h>
+#include <linux/types.h>
+
+struct pt_regs;
+struct task_struct;
+
+void die(const char *str, struct pt_regs *regs, long err);
+int fixup_exception(struct pt_regs *regs);
+void i860_do_page_fault(struct pt_regs *regs, unsigned long addr,
+			bool write, bool fetch);
+bool i860_decode_access(struct pt_regs *regs, u32 insn, unsigned long *addr,
+			unsigned int *size, bool *write);
+void i860_set_kernel_stack(unsigned long top);
+void i860_trap_init(void);
+extern unsigned long i860_irq_seq;
+asmlinkage void i860_handle_trap(struct pt_regs *regs);
+asmlinkage void i860_ret_from_fork(struct task_struct *prev,
+				   struct pt_regs *regs,
+				   int (*fn)(void *), void *fn_arg);
+
+bool i860_fp_result_pending(unsigned long fsr);
+void i860_fp_result(struct pt_regs *regs);
+int i860_fp_source(struct pt_regs *regs, u32 insn);
+
+#endif
diff --git a/arch/i860/include/asm/uaccess.h b/arch/i860/include/asm/uaccess.h
new file mode 100644
index 000000000000..edd302d371b3
--- /dev/null
+++ b/arch/i860/include/asm/uaccess.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * User space shares the address space with the kernel, so user accesses
+ * are plain loads and stores; faults are resolved through __ex_table.
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+#ifndef _ASM_I860_UACCESS_H
+#define _ASM_I860_UACCESS_H
+
+#include <linux/types.h>
+
+/* Return the number of bytes not copied. */
+extern unsigned long __copy_user(void *to, const void *from, unsigned long n);
+extern unsigned long __clear_user_asm(void __user *to, unsigned long n);
+
+static inline unsigned long
+raw_copy_from_user(void *to, const void __user *from, unsigned long n)
+{
+	return __copy_user(to, (__force const void *)from, n);
+}
+
+static inline unsigned long
+raw_copy_to_user(void __user *to, const void *from, unsigned long n)
+{
+	return __copy_user((__force void *)to, from, n);
+}
+
+#define INLINE_COPY_FROM_USER
+#define INLINE_COPY_TO_USER
+
+#define __clear_user __clear_user_asm
+
+#include <asm-generic/uaccess.h>
+
+#endif
