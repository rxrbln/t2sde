+#define sys_rt_sigreturn sys_rt_sigreturn
+
+#include <asm-generic/syscalls.h>
+
+#endif
diff --git a/arch/i860/include/asm/thread_info.h b/arch/i860/include/asm/thread_info.h
new file mode 100644
index 000000000000..9b9b66fe1b04
--- /dev/null
+++ b/arch/i860/include/asm/thread_info.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _ASM_I860_THREAD_INFO_H
+#define _ASM_I860_THREAD_INFO_H
+
+#include <asm/page.h>
+
+#define THREAD_SIZE_ORDER	1
+#define THREAD_SIZE		(PAGE_SIZE << THREAD_SIZE_ORDER)
+
+#ifndef __ASSEMBLER__
+
+#include <asm/processor.h>
+
+/* At the bottom of the kernel stack. */
+struct thread_info {
+	struct task_struct	*task;
+	unsigned long		flags;
+	unsigned long		syscall_work;
+	int			preempt_count;
+	__u32			cpu;
+};
+
+#define INIT_THREAD_INFO(tsk)			\
+{						\
+	.task		= &tsk,			\
+	.flags		= 0,			\
+	.cpu		= 0,			\
+	.preempt_count	= INIT_PREEMPT_COUNT,	\
+}
+
+register unsigned long current_stack_pointer asm("sp");
+
+static inline struct thread_info *current_thread_info(void)
+{
+	return (struct thread_info *)
+		(current_stack_pointer & ~(THREAD_SIZE - 1));
+}
+
+#endif
+
+#define HAVE_TIF_RESTORE_SIGMASK
+#include <asm-generic/thread_info_tif.h>
+
+#endif
