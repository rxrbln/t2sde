+
+#include <linux/types.h>
+#include <asm/i860.h>
+#include <asm/pgtable.h>
+
+/* On-board devices sit in the static window at I860_IO_VIRT. */
+#define I860_IO(phys)	((void __iomem *)((phys) - I860_IO_PHYS + I860_IO_VIRT))
+
+#define ioremap_prot ioremap_prot
+#define iounmap iounmap
+
+#include <asm-generic/io.h>
+
+#endif
