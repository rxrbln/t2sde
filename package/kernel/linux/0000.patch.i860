diff --git a/tools/include/nolibc/arch-i860.h b/tools/include/nolibc/arch-i860.h
new file mode 100644
index 000000000000..66837301b213
--- /dev/null
+++ b/tools/include/nolibc/arch-i860.h
@@ -0,0 +1,159 @@
+/* SPDX-License-Identifier: LGPL-2.1 OR MIT */
+/*
+ * Intel i860 specific definitions for NOLIBC
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#ifndef _NOLIBC_ARCH_I860_H
+#define _NOLIBC_ARCH_I860_H
+
+#include "compiler.h"
+#include "crt.h"
+
+/*
+ * Syscalls for i860:
+ *   - the system call is performed by "trap r0,r0,r0"
+ *   - syscall number is passed in r28 (changed by restart_syscall)
+ *   - arguments are in r16-r21
+ *   - the return value is in r16
+ *   - all other registers are preserved
+ */
+
+#define _NOLIBC_SYSCALL_CLOBBERLIST "memory"
+
+#define __nolibc_syscall0(num)                                                \
+({                                                                            \
+	register long _num __asm__ ("r28") = (num);                           \
+	register long _ret __asm__ ("r16");                                   \
+									      \
+	__asm__ volatile (                                                    \
+		"trap %%r0,%%r0,%%r0\n"                                       \
+		: "=r"(_ret), "+r"(_num)                                      \
+		:                                                             \
+		: _NOLIBC_SYSCALL_CLOBBERLIST                                 \
+	);                                                                    \
+	_ret;                                                                 \
+})
+
+#define __nolibc_syscall1(num, arg1)                                          \
+({                                                                            \
+	register long _num __asm__ ("r28") = (num);                           \
+	register long _arg1 __asm__ ("r16") = (long)(arg1);                   \
+									      \
+	__asm__ volatile (                                                    \
+		"trap %%r0,%%r0,%%r0\n"                                       \
+		: "+r"(_arg1), "+r"(_num)                                     \
+		:                                                             \
+		: _NOLIBC_SYSCALL_CLOBBERLIST                                 \
+	);                                                                    \
+	_arg1;                                                                \
+})
+
+#define __nolibc_syscall2(num, arg1, arg2)                                    \
+({                                                                            \
+	register long _num __asm__ ("r28") = (num);                           \
+	register long _arg1 __asm__ ("r16") = (long)(arg1);                   \
+	register long _arg2 __asm__ ("r17") = (long)(arg2);                   \
+									      \
+	__asm__ volatile (                                                    \
+		"trap %%r0,%%r0,%%r0\n"                                       \
+		: "+r"(_arg1), "+r"(_num)                                     \
+		: "r"(_arg2)                                                  \
+		: _NOLIBC_SYSCALL_CLOBBERLIST                                 \
+	);                                                                    \
+	_arg1;                                                                \
+})
+
+#define __nolibc_syscall3(num, arg1, arg2, arg3)                              \
+({                                                                            \
+	register long _num __asm__ ("r28") = (num);                           \
+	register long _arg1 __asm__ ("r16") = (long)(arg1);                   \
+	register long _arg2 __asm__ ("r17") = (long)(arg2);                   \
+	register long _arg3 __asm__ ("r18") = (long)(arg3);                   \
+									      \
+	__asm__ volatile (                                                    \
+		"trap %%r0,%%r0,%%r0\n"                                       \
+		: "+r"(_arg1), "+r"(_num)                                     \
+		: "r"(_arg2), "r"(_arg3)                                      \
+		: _NOLIBC_SYSCALL_CLOBBERLIST                                 \
+	);                                                                    \
+	_arg1;                                                                \
+})
+
+#define __nolibc_syscall4(num, arg1, arg2, arg3, arg4)                        \
+({                                                                            \
+	register long _num __asm__ ("r28") = (num);                           \
+	register long _arg1 __asm__ ("r16") = (long)(arg1);                   \
+	register long _arg2 __asm__ ("r17") = (long)(arg2);                   \
+	register long _arg3 __asm__ ("r18") = (long)(arg3);                   \
+	register long _arg4 __asm__ ("r19") = (long)(arg4);                   \
+									      \
+	__asm__ volatile (                                                    \
+		"trap %%r0,%%r0,%%r0\n"                                       \
+		: "+r"(_arg1), "+r"(_num)                                     \
+		: "r"(_arg2), "r"(_arg3), "r"(_arg4)                          \
+		: _NOLIBC_SYSCALL_CLOBBERLIST                                 \
+	);                                                                    \
+	_arg1;                                                                \
+})
+
+#define __nolibc_syscall5(num, arg1, arg2, arg3, arg4, arg5)                  \
+({                                                                            \
+	register long _num __asm__ ("r28") = (num);                           \
+	register long _arg1 __asm__ ("r16") = (long)(arg1);                   \
+	register long _arg2 __asm__ ("r17") = (long)(arg2);                   \
+	register long _arg3 __asm__ ("r18") = (long)(arg3);                   \
+	register long _arg4 __asm__ ("r19") = (long)(arg4);                   \
+	register long _arg5 __asm__ ("r20") = (long)(arg5);                   \
+									      \
+	__asm__ volatile (                                                    \
+		"trap %%r0,%%r0,%%r0\n"                                       \
+		: "+r"(_arg1), "+r"(_num)                                     \
+		: "r"(_arg2), "r"(_arg3), "r"(_arg4), "r"(_arg5)              \
+		: _NOLIBC_SYSCALL_CLOBBERLIST                                 \
+	);                                                                    \
+	_arg1;                                                                \
+})
+
+#define __nolibc_syscall6(num, arg1, arg2, arg3, arg4, arg5, arg6)            \
+({                                                                            \
+	register long _num __asm__ ("r28") = (num);                           \
+	register long _arg1 __asm__ ("r16") = (long)(arg1);                   \
+	register long _arg2 __asm__ ("r17") = (long)(arg2);                   \
+	register long _arg3 __asm__ ("r18") = (long)(arg3);                   \
+	register long _arg4 __asm__ ("r19") = (long)(arg4);                   \
+	register long _arg5 __asm__ ("r20") = (long)(arg5);                   \
+	register long _arg6 __asm__ ("r21") = (long)(arg6);                   \
+									      \
+	__asm__ volatile (                                                    \
+		"trap %%r0,%%r0,%%r0\n"                                       \
+		: "+r"(_arg1), "+r"(_num)                                     \
+		: "r"(_arg2), "r"(_arg3), "r"(_arg4), "r"(_arg5),             \
+		  "r"(_arg6)                                                  \
+		: _NOLIBC_SYSCALL_CLOBBERLIST                                 \
+	);                                                                    \
+	_arg1;                                                                \
+})
+
+#ifndef NOLIBC_NO_RUNTIME
+/* startup code */
+void _start_wrapper(void);
+void __attribute__((weak,noreturn))
+__nolibc_entrypoint __nolibc_no_stack_protector
+_start_wrapper(void)
+{
+	__asm__ volatile (
+		".global _start\n"           /* The C function will have a prologue, */
+		".type _start, @function\n"  /* corrupting "sp"                      */
+		".weak _start\n"
+		"_start:\n"
+		"mov %r0,%fp\n"              /* terminate frame pointer chains       */
+		"call _start_c\n"            /* transfer to c runtime                */
+		"mov %sp,%r16\n"             /* delay slot: sp is arg1 of _start_c   */
+		".size _start, .-_start\n"
+	);
+	__nolibc_entrypoint_epilogue();
+}
+#endif /* NOLIBC_NO_RUNTIME */
+
+#endif /* _NOLIBC_ARCH_I860_H */
