diff --git a/arch/i860/include/asm/cache.h b/arch/i860/include/asm/cache.h
new file mode 100644
index 000000000000..605b8bc81931
--- /dev/null
+++ b/arch/i860/include/asm/cache.h
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _ASM_I860_CACHE_H
+#define _ASM_I860_CACHE_H
+
+#define L1_CACHE_SHIFT	5
+#define L1_CACHE_BYTES	(1 << L1_CACHE_SHIFT)
+
+#endif
diff --git a/arch/i860/include/asm/cacheflush.h b/arch/i860/include/asm/cacheflush.h
new file mode 100644
index 000000000000..673cc6177d11
--- /dev/null
+++ b/arch/i860/include/asm/cacheflush.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * The i860XR data cache (8 KB, 2-way, 32-byte lines; XP: 16 KB, 4-way) is
+ * virtually tagged without address-space IDs, and only a whole-cache
+ * write-back by set and way exists: one way spans a page, so even a single
+ * page needs all of it. The gain is in flushing less often, see cacheflush.c.
+ * Instruction cache and TLB are invalidated together through dirbase.ITI.
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+#ifndef _ASM_I860_CACHEFLUSH_H
+#define _ASM_I860_CACHEFLUSH_H
+
+#include <linux/mm_types.h>
+
+void i860_flush_dcache_all(void);
+void local_flush_tlb_all(void);
+
+/* write back the data cache, then drop stale instructions and TLB entries */
+static inline void i860_flush_icache_all(void)
+{
+	i860_flush_dcache_all();
+	local_flush_tlb_all();
+}
+
+#define flush_cache_all()			i860_flush_dcache_all()
+#define flush_cache_mm(mm)			i860_flush_dcache_all()
+#define flush_cache_dup_mm(mm)			i860_flush_dcache_all()
+#define flush_cache_range(vma, start, end)	i860_flush_dcache_all()
+#define flush_cache_page(vma, vmaddr, pfn)	i860_flush_dcache_all()
+#define flush_cache_vmap(start, end)		i860_flush_dcache_all()
+#define flush_cache_vunmap(start, end)		i860_flush_dcache_all()
+
+#define ARCH_IMPLEMENTS_FLUSH_DCACHE_PAGE 1
+void flush_dcache_folio(struct folio *folio);
+#define flush_dcache_folio flush_dcache_folio
+void flush_dcache_page(struct page *page);
+
+#define flush_icache_range(start, end)		i860_flush_icache_all()
+#define flush_icache_user_page(vma, page, addr, len) i860_flush_icache_all()
+
+#define copy_to_user_page(vma, page, vaddr, dst, src, len)	\
+	do {							\
+		memcpy(dst, src, len);				\
+		i860_flush_icache_all();			\
+	} while (0)
+
+#define copy_from_user_page(vma, page, vaddr, dst, src, len)	\
+	do {							\
+		i860_flush_dcache_all();			\
+		memcpy(dst, src, len);				\
+	} while (0)
+
+#include <asm-generic/cacheflush.h>
+
+#endif
diff --git a/arch/i860/include/asm/dma.h b/arch/i860/include/asm/dma.h
new file mode 100644
index 000000000000..9c67dae12c57
--- /dev/null
+++ b/arch/i860/include/asm/dma.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _ASM_I860_DMA_H
+#define _ASM_I860_DMA_H
+
+#include <linux/irqflags.h>
+
+#define MAX_DMA_ADDRESS		PAGE_OFFSET
+
+/* used by floppy.c to tell the transfer direction */
+#define DMA_MODE_READ		0x44
+#define DMA_MODE_WRITE		0x48
+
+/* no ISA DMA: the floppy driver only needs the lock helpers */
+static inline unsigned long claim_dma_lock(void)
+{
+	unsigned long flags;
+
+	local_irq_save(flags);
+	return flags;
+}
+
+static inline void release_dma_lock(unsigned long flags)
+{
+	local_irq_restore(flags);
+}
+
+#endif
