+#ifndef _ASM_I860_STRING_H
+#define _ASM_I860_STRING_H
+
+/* arch/i860/lib: 128-bit fld.q/fst.q transfers */
+#define __HAVE_ARCH_MEMCPY
+#define __HAVE_ARCH_MEMMOVE
+#define __HAVE_ARCH_MEMSET
+
