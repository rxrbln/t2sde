diff --git a/arch/i860/include/asm/switch_to.h b/arch/i860/include/asm/switch_to.h
new file mode 100644
index 000000000000..bc0e5e1498a6
--- /dev/null
+++ b/arch/i860/include/asm/switch_to.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _ASM_I860_SWITCH_TO_H
+#define _ASM_I860_SWITCH_TO_H
+
+struct task_struct;
+
+extern struct task_struct *__switch_to(struct task_struct *prev,
+				       struct task_struct *next);
+
+#define switch_to(prev, next, last)		\
+	do {					\
+		(last) = __switch_to(prev, next); \
+	} while (0)
+
+#endif
diff --git a/arch/i860/include/asm/syscall.h b/arch/i860/include/asm/syscall.h
new file mode 100644
index 000000000000..813a4d5b7152
--- /dev/null
+++ b/arch/i860/include/asm/syscall.h
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Syscall ABI: trap r0,r0,r0 with the number in r28 and the arguments in
+ * r16-r21; the result comes back in r16.
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+#ifndef _ASM_I860_SYSCALL_H
+#define _ASM_I860_SYSCALL_H
+
+#include <uapi/linux/audit.h>
+#include <linux/err.h>
+#include <linux/sched.h>
+#include <asm/ptrace.h>
+
+#define I860_SYSCALL_NR_REG	28
+#define I860_SYSCALL_ARG_REG	16
+
+extern void * const sys_call_table[];
+
+static inline int syscall_get_nr(struct task_struct *task,
+				 struct pt_regs *regs)
+{
+	return regs->syscallno;
+}
+
+static inline void syscall_set_nr(struct task_struct *task,
+				  struct pt_regs *regs, int nr)
+{
+	regs->syscallno = nr;
+}
+
+static inline void syscall_rollback(struct task_struct *task,
+				    struct pt_regs *regs)
+{
+	regs->user.gpr[16] = regs->orig_r16;
+}
+
+static inline long syscall_get_error(struct task_struct *task,
+				     struct pt_regs *regs)
+{
+	unsigned long error = regs->user.gpr[16];
+
+	return IS_ERR_VALUE(error) ? error : 0;
+}
+
+static inline long syscall_get_return_value(struct task_struct *task,
+					    struct pt_regs *regs)
+{
+	return regs->user.gpr[16];
+}
+
+static inline void syscall_set_return_value(struct task_struct *task,
+					    struct pt_regs *regs,
+					    int error, long val)
+{
+	regs->user.gpr[16] = (long)error ?: val;
+}
+
+static inline void syscall_get_arguments(struct task_struct *task,
+					 struct pt_regs *regs,
+					 unsigned long *args)
+{
+	args[0] = regs->orig_r16;
+	memcpy(&args[1], &regs->user.gpr[I860_SYSCALL_ARG_REG + 1],
+	       5 * sizeof(args[0]));
+}
+
+static inline void syscall_set_arguments(struct task_struct *task,
+					 struct pt_regs *regs,
+					 const unsigned long *args)
+{
+	regs->orig_r16 = args[0];
+	memcpy(&regs->user.gpr[I860_SYSCALL_ARG_REG], args,
+	       6 * sizeof(args[0]));
+}
+
+static inline int syscall_get_arch(struct task_struct *task)
+{
+	return AUDIT_ARCH_I860;
+}
+
+static inline bool arch_syscall_is_vdso_sigreturn(struct pt_regs *regs)
+{
+	return false;
+}
+
+#endif
