diff --git a/arch/i860/include/asm/mmu_context.h b/arch/i860/include/asm/mmu_context.h
new file mode 100644
index 000000000000..dedea452f233
--- /dev/null
+++ b/arch/i860/include/asm/mmu_context.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _ASM_I860_MMU_CONTEXT_H
+#define _ASM_I860_MMU_CONTEXT_H
+
+#include <linux/mm_types.h>
+#include <asm/cacheflush.h>
+#include <asm/pgtable.h>
+
+extern void i860_set_pgd(pgd_t *pgd);
+
+static inline void switch_mm(struct mm_struct *prev, struct mm_struct *next,
+			     struct task_struct *tsk)
+{
+	/* virtually tagged cache: write back while the old mapping is live */
+	if (prev != next) {
+		i860_flush_dcache_all();
+		i860_set_pgd(next->pgd);
+	}
+}
+
+#include <asm-generic/mm_hooks.h>
+#include <asm-generic/mmu_context.h>
+
+#endif
diff --git a/arch/i860/include/asm/page.h b/arch/i860/include/asm/page.h
new file mode 100644
index 000000000000..014f98b01ac2
--- /dev/null
+++ b/arch/i860/include/asm/page.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _ASM_I860_PAGE_H
+#define _ASM_I860_PAGE_H
+
+#include <linux/const.h>
+#include <vdso/page.h>
+#include <asm/i860.h>
+
+#define PAGE_OFFSET		I860_LOWMEM_BASE
+
+#ifndef __ASSEMBLER__
+
+#include <linux/pfn.h>
+
+/* Lowest DRAM page: the bank layout is only known at boot. */
+extern unsigned long i860_pfn_offset;
+#define ARCH_PFN_OFFSET		i860_pfn_offset
+
+#define clear_page(page)	memset((page), 0, PAGE_SIZE)
+#define copy_page(to, from)	memcpy((to), (from), PAGE_SIZE)
+
+#define clear_user_page(page, vaddr, pg)			\
+	do { (void)(vaddr); (void)(pg); clear_page(page); } while (0)
+#define copy_user_page(to, from, vaddr, pg)			\
+	do { (void)(vaddr); (void)(pg); copy_page(to, from); } while (0)
+
+typedef struct { unsigned long pte; } pte_t;
+typedef struct { unsigned long pgd; } pgd_t;
+typedef struct { unsigned long pgprot; } pgprot_t;
+typedef struct page *pgtable_t;
+
+#define pte_val(x)	((x).pte)
+#define pgd_val(x)	((x).pgd)
+#define pgprot_val(x)	((x).pgprot)
+
+#define __pte(x)	((pte_t) { (x) })
+#define __pgd(x)	((pgd_t) { (x) })
+#define __pgprot(x)	((pgprot_t) { (x) })
+
+#define __pa(x)		((unsigned long)(x))
+#define __va(x)		((void *)(unsigned long)(x))
+
+#define pfn_to_kaddr(pfn)	__va((pfn) << PAGE_SHIFT)
+#define virt_to_pfn(kaddr)	(__pa(kaddr) >> PAGE_SHIFT)
+#define virt_to_page(kaddr)	pfn_to_page(virt_to_pfn(kaddr))
+#define page_to_virt(page)	pfn_to_kaddr(page_to_pfn(page))
+#define virt_addr_valid(kaddr)						\
+	((unsigned long)(kaddr) >= PAGE_OFFSET &&			\
+	 pfn_valid(virt_to_pfn(kaddr)))
+
+#define VMA_DATA_DEFAULT_FLAGS	VMA_DATA_FLAGS_NON_EXEC
+
+#include <asm-generic/memory_model.h>
+#include <asm-generic/getorder.h>
+
+#endif /* __ASSEMBLER__ */
+
+#endif
diff --git a/arch/i860/include/asm/pgalloc.h b/arch/i860/include/asm/pgalloc.h
new file mode 100644
index 000000000000..f4ac76c55798
--- /dev/null
+++ b/arch/i860/include/asm/pgalloc.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _ASM_I860_PGALLOC_H
+#define _ASM_I860_PGALLOC_H
+
+#include <linux/mm.h>
+#include <asm/pgtable.h>
+
+#define __HAVE_ARCH_PTE_ALLOC_ONE_KERNEL
+#define __HAVE_ARCH_PTE_ALLOC_ONE
+#define __HAVE_ARCH_PGD_FREE
+#include <asm-generic/pgalloc.h>
+
+/* The hardware walks page tables in memory: keep them uncached. */
+static inline pte_t *pte_alloc_one_kernel_noprof(struct mm_struct *mm)
+{
+	pte_t *pte = __pte_alloc_one_kernel_noprof(mm);
+
+	if (pte)
+		i860_set_cacheable(pte, false);
+	return pte;
+}
+#define pte_alloc_one_kernel(...) alloc_hooks(pte_alloc_one_kernel_noprof(__VA_ARGS__))
+
+static inline pgtable_t pte_alloc_one_noprof(struct mm_struct *mm)
+{
+	pgtable_t pte = __pte_alloc_one_noprof(mm, GFP_PGTABLE_USER);
+
+	if (pte)
+		i860_set_cacheable(page_address(pte), false);
+	return pte;
+}
+#define pte_alloc_one(...) alloc_hooks(pte_alloc_one_noprof(__VA_ARGS__))
+
+static inline void pgd_free(struct mm_struct *mm, pgd_t *pgd)
+{
+	i860_set_cacheable(pgd, true);
+	__pgd_free(mm, pgd);
+}
+
+static inline void pmd_populate_kernel(struct mm_struct *mm, pmd_t *pmd,
+				       pte_t *pte)
+{
+	set_pmd(pmd, __pmd(__pa(pte) | _PAGE_TABLE));
+}
+
+static inline void pmd_populate(struct mm_struct *mm, pmd_t *pmd,
+				pgtable_t pte)
+{
+	set_pmd(pmd, __pmd(page_to_phys(pte) | _PAGE_TABLE));
+}
+
+extern pgd_t *pgd_alloc(struct mm_struct *mm);
+
+#define __pte_free_tlb(tlb, pte, addr)				\
+	do {							\
+		i860_set_cacheable(page_address(pte), true);	\
+		tlb_remove_ptdesc((tlb), page_ptdesc(pte));	\
+	} while (0)
+
+#endif
diff --git a/arch/i860/include/asm/pgtable.h b/arch/i860/include/asm/pgtable.h
new file mode 100644
index 000000000000..ea346c9f9872
--- /dev/null
+++ b/arch/i860/include/asm/pgtable.h
@@ -0,0 +1,168 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * i860 two-level page tables: 1024 PDEs of 4 MB, 1024 PTEs of 4 KB.
+ * The hardware walks them physically, sets A, and traps writes to pages
+ * with D clear, so dirty tracking is done in software.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+#ifndef _ASM_I860_PGTABLE_H
+#define _ASM_I860_PGTABLE_H
+
+#include <asm/page.h>
+#include <asm-generic/pgtable-nopmd.h>
+#include <asm/i860.h>
+
+#define _PAGE_PRESENT	0x001
+#define _PAGE_RW	0x002
+#define _PAGE_USER	0x004
+#define _PAGE_WT	0x008
+#define _PAGE_CD	0x010
+#define _PAGE_ACCESSED	0x020
+#define _PAGE_DIRTY	0x040
+/* bits 9-11 are free for software */
+#define _PAGE_PROTNONE	0x200
+#define _PAGE_SWP_EXCLUSIVE 0x400
+
+/*
+ * Memory is cached (see asm/cacheflush.h for the maintenance rules).
+ * The page-table walker reads memory, so page-table pages are uncached
+ * in the linear map (i860_set_cacheable).
+ */
+#define _PAGE_CACHE	0
+
+#define _PAGE_TABLE	(_PAGE_PRESENT | _PAGE_RW | _PAGE_USER | \
+			 _PAGE_ACCESSED | _PAGE_DIRTY | _PAGE_CD)
+#define _PAGE_CHG_MASK	(PAGE_MASK | _PAGE_ACCESSED | _PAGE_DIRTY)
+
+#define PAGE_NONE	__pgprot(_PAGE_PROTNONE | _PAGE_ACCESSED | _PAGE_CACHE)
+#define PAGE_SHARED	__pgprot(_PAGE_PRESENT | _PAGE_RW | _PAGE_USER | \
+				 _PAGE_ACCESSED | _PAGE_CACHE)
+#define PAGE_COPY	__pgprot(_PAGE_PRESENT | _PAGE_USER | \
+				 _PAGE_ACCESSED | _PAGE_CACHE)
+#define PAGE_READONLY	PAGE_COPY
+#define PAGE_KERNEL	__pgprot(_PAGE_PRESENT | _PAGE_RW | _PAGE_ACCESSED | \
+				 _PAGE_DIRTY | _PAGE_CACHE)
+#define PAGE_KERNEL_RO	__pgprot(_PAGE_PRESENT | _PAGE_ACCESSED | \
+				 _PAGE_DIRTY | _PAGE_CACHE)
+#define PAGE_KERNEL_NOCACHE __pgprot(pgprot_val(PAGE_KERNEL) | _PAGE_CD)
+#define _PAGE_IOREMAP	(_PAGE_PRESENT | _PAGE_RW | _PAGE_ACCESSED | \
+			 _PAGE_DIRTY | _PAGE_CD)
+
+#define PTRS_PER_PGD	1024
+#define PTRS_PER_PTE	1024
+#define PGDIR_SHIFT	22
+#define PGDIR_SIZE	(1UL << PGDIR_SHIFT)
+#define PGDIR_MASK	(~(PGDIR_SIZE - 1))
+#define USER_PTRS_PER_PGD	(TASK_SIZE / PGDIR_SIZE)
+#define FIRST_USER_ADDRESS	0UL
+
+#define VMALLOC_START	I860_VMALLOC_START
+#define VMALLOC_END	I860_VMALLOC_END
+
+#ifndef __ASSEMBLER__
+
+#include <asm/tlbflush.h>
+
+extern pgd_t swapper_pg_dir[PTRS_PER_PGD];
+
+static inline int pte_none(pte_t pte)		{ return !pte_val(pte); }
+static inline int pte_present(pte_t pte)
+{
+	return pte_val(pte) & (_PAGE_PRESENT | _PAGE_PROTNONE);
+}
+static inline int pte_write(pte_t pte)		{ return pte_val(pte) & _PAGE_RW; }
+static inline int pte_dirty(pte_t pte)		{ return pte_val(pte) & _PAGE_DIRTY; }
+static inline int pte_young(pte_t pte)		{ return pte_val(pte) & _PAGE_ACCESSED; }
+
+#define PTE_BIT_FUNC(fn, op) \
+	static inline pte_t pte_##fn(pte_t pte) { pte_val(pte) op; return pte; }
+
+PTE_BIT_FUNC(wrprotect, &= ~_PAGE_RW);
+PTE_BIT_FUNC(mkwrite_novma, |= _PAGE_RW);
+PTE_BIT_FUNC(mkclean, &= ~_PAGE_DIRTY);
+PTE_BIT_FUNC(mkdirty, |= _PAGE_DIRTY);
+PTE_BIT_FUNC(mkold, &= ~_PAGE_ACCESSED);
+PTE_BIT_FUNC(mkyoung, |= _PAGE_ACCESSED);
+
+static inline pte_t pte_modify(pte_t pte, pgprot_t newprot)
+{
+	return __pte((pte_val(pte) & _PAGE_CHG_MASK) |
+		     (pgprot_val(newprot) & ~_PAGE_CHG_MASK));
+}
+
+#define PFN_PTE_SHIFT		PAGE_SHIFT
+#define pte_pfn(pte)		(pte_val(pte) >> PAGE_SHIFT)
+#define pfn_pte(pfn, prot)	__pte(((pfn) << PAGE_SHIFT) | pgprot_val(prot))
+#define pte_page(pte)		pfn_to_page(pte_pfn(pte))
+
+static inline void set_pte(pte_t *ptep, pte_t pte)
+{
+	*ptep = pte;
+}
+
+static inline void pte_clear(struct mm_struct *mm, unsigned long addr,
+			     pte_t *ptep)
+{
+	set_pte(ptep, __pte(0));
+}
+
+static inline int pmd_none(pmd_t pmd)		{ return !pmd_val(pmd); }
+static inline int pmd_present(pmd_t pmd)	{ return pmd_val(pmd) & _PAGE_PRESENT; }
+static inline int pmd_bad(pmd_t pmd)
+{
+	return (pmd_val(pmd) & ~PAGE_MASK) != _PAGE_TABLE;
+}
+static inline void set_pmd(pmd_t *pmdp, pmd_t pmd)	{ *pmdp = pmd; }
+static inline void pmd_clear(pmd_t *pmdp)	{ set_pmd(pmdp, __pmd(0)); }
+
+#define pmd_pfn(pmd)		(pmd_val(pmd) >> PAGE_SHIFT)
+#define pmd_page(pmd)		pfn_to_page(pmd_pfn(pmd))
+
+static inline unsigned long pmd_page_vaddr(pmd_t pmd)
+{
+	return (unsigned long)__va(pmd_val(pmd) & PAGE_MASK);
+}
+
+#define pgprot_noncached(prot)	__pgprot(pgprot_val(prot) | _PAGE_CD)
+#define pgprot_writecombine	pgprot_noncached
+
+/* Swap entries: P = PROTNONE = 0, type in bits 1-5, offset in bits 12-31. */
+#define __swp_type(x)		(((x).val >> 1) & 0x1f)
+#define __swp_offset(x)		((x).val >> PAGE_SHIFT)
+#define __swp_entry(type, offset) \
+	((swp_entry_t) { ((type) << 1) | ((offset) << PAGE_SHIFT) })
+#define __pte_to_swp_entry(pte)	((swp_entry_t) { pte_val(pte) })
+#define __swp_entry_to_pte(x)	((pte_t) { (x).val })
+
+static inline bool pte_swp_exclusive(pte_t pte)
+{
+	return pte_val(pte) & _PAGE_SWP_EXCLUSIVE;
+}
+
+static inline pte_t pte_swp_mkexclusive(pte_t pte)
+{
+	pte_val(pte) |= _PAGE_SWP_EXCLUSIVE;
+	return pte;
+}
+
+static inline pte_t pte_swp_clear_exclusive(pte_t pte)
+{
+	pte_val(pte) &= ~_PAGE_SWP_EXCLUSIVE;
+	return pte;
+}
+
+struct vm_fault;
+struct vm_area_struct;
+
+void i860_set_cacheable(void *addr, bool cacheable);
+void i860_flush_dcache_all(void);
+
+void update_mmu_cache_range(struct vm_fault *vmf, struct vm_area_struct *vma,
+			    unsigned long addr, pte_t *ptep, unsigned int nr);
+#define update_mmu_cache(vma, addr, ptep) \
+	update_mmu_cache_range(NULL, vma, addr, ptep, 1)
+
+#endif /* __ASSEMBLER__ */
+
+#endif
diff --git a/arch/i860/include/asm/processor.h b/arch/i860/include/asm/processor.h
new file mode 100644
index 000000000000..3c7cebe73117
--- /dev/null
+++ b/arch/i860/include/asm/processor.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _ASM_I860_PROCESSOR_H
+#define _ASM_I860_PROCESSOR_H
+
+#include <asm/i860.h>
+#include <asm/page.h>
+
+#define TASK_SIZE		I860_VMALLOC_START
+#define TASK_SIZE_MAX		TASK_SIZE
+#define STACK_TOP		TASK_SIZE
+#define STACK_TOP_MAX		STACK_TOP
+#define TASK_UNMAPPED_BASE	(PAGE_ALIGN(TASK_SIZE / 3))
+
+#ifndef __ASSEMBLER__
+
+#include <linux/compiler.h>
+
+struct task_struct;
+struct pt_regs;
+
+/* Callee-saved state lives in the switch frame on the kernel stack. */
+struct thread_struct {
+	unsigned long ksp;
+};
+
+#define INIT_THREAD	{ }
+
+#define task_pt_regs(tsk) \
+	((struct pt_regs *)(task_stack_page(tsk) + THREAD_SIZE) - 1)
+
+#define KSTK_EIP(tsk)	(task_pt_regs(tsk)->user.fir)
+#define KSTK_ESP(tsk)	(task_pt_regs(tsk)->user.gpr[2])
+
+void start_thread(struct pt_regs *regs, unsigned long pc, unsigned long sp);
+unsigned long __get_wchan(struct task_struct *p);
+
+#define cpu_relax()	barrier()
+
+#endif
+
+#endif
diff --git a/arch/i860/include/asm/ptrace.h b/arch/i860/include/asm/ptrace.h
new file mode 100644
index 000000000000..ec25164b7267
--- /dev/null
+++ b/arch/i860/include/asm/ptrace.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _ASM_I860_PTRACE_H
+#define _ASM_I860_PTRACE_H
+
+#include <uapi/asm/ptrace.h>
+#include <asm/i860.h>
+
+/* user thread pointer register of the Linux ABI */
+#define I860_TP_REG	30
+
+#ifndef __ASSEMBLER__
+
+/* Trap frame; the size keeps the stack 16-byte aligned for fst.q. */
+struct pt_regs {
+	struct user_regs_struct user;
+	unsigned long orig_r16;
+	long syscallno;
+	/* the last FP pipeline stages, popped at entry for a result exception */
+	unsigned long fp_m3[2];
+	unsigned long fp_a3[2];
+	unsigned long pad[2];
+};
+
+#define user_mode(regs)		(((regs)->user.psr & PSR_PU) != 0)
+#define instruction_pointer(regs) ((regs)->user.fir)
+#define user_stack_pointer(regs) ((regs)->user.gpr[2])
+#define profile_pc(regs)	instruction_pointer(regs)
+#define regs_return_value(regs)	((regs)->user.gpr[16])
+
+static inline bool regs_irqs_disabled(struct pt_regs *regs)
+{
+	return !(regs->user.psr & PSR_PIM);
+}
+
+#define current_pt_regs()	task_pt_regs(current)
+
+#endif
+
+#endif
