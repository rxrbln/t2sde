diff --git a/arch/i860/Makefile b/arch/i860/Makefile
new file mode 100644
index 000000000000..e8f8b50deeac
--- /dev/null
+++ b/arch/i860/Makefile
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Intel i860 architecture Makefile
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+#
+
+KBUILD_DEFCONFIG := magicst2_defconfig
+
+LIBGCC		:= $(shell $(CC) $(KBUILD_CFLAGS) -print-libgcc-file-name)
+
+KBUILD_CFLAGS	+= -pipe -D__linux__ -fno-pic
+KBUILD_AFLAGS	+= -fno-pic
+LDFLAGS_vmlinux	+= -N
+
+libs-y		+= arch/i860/lib/ $(LIBGCC)
+
+boot := arch/i860/boot
+
+all: vmlinux.bin
+
+PHONY += vmlinux.bin bootdisk
+
+vmlinux.bin: vmlinux
+	$(Q)$(MAKE) $(build)=$(boot) $(boot)/$@
+
+bootdisk: vmlinux.bin
+	$(Q)$(MAKE) $(build)=$(boot) $(boot)/bootdisk.img
+
+archclean:
+	$(Q)$(MAKE) $(clean)=$(boot)
+
+define archhelp
+  echo  '* vmlinux.bin	- Raw kernel image (arch/$(ARCH)/boot/vmlinux.bin)'
+  echo  '  bootdisk	- SCSI disk image with boot block and kernel'
+endef
diff --git a/arch/i860/boot/Makefile b/arch/i860/boot/Makefile
new file mode 100644
index 000000000000..6d2a312797c8
--- /dev/null
+++ b/arch/i860/boot/Makefile
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+#
+
+targets := vmlinux.bin bootblock.o bootblock.elf bootblock.bin bootdisk.img
+
+OBJCOPYFLAGS_vmlinux.bin := -O binary -R .note -R .comment -S
+
+$(obj)/vmlinux.bin: vmlinux FORCE
+	$(call if_changed,objcopy)
+
+# The kernel follows the boot block on the disk.
+kernel_sectors = $(shell echo $$(( ($$(stat -c %s $(obj)/vmlinux.bin) + 511) / 512 )))
+
+AFLAGS_bootblock.o = -DKERNEL_LBA=1 -DKERNEL_SECTORS=$(kernel_sectors) \
+		     -DKERNEL_LOAD=$(CONFIG_I860_KERNEL_BASE) \
+		     -DKERNEL_ENTRY=$(CONFIG_I860_KERNEL_BASE)
+
+$(obj)/bootblock.o: $(obj)/vmlinux.bin
+
+quiet_cmd_bootblock = LD      $@
+      cmd_bootblock = $(LD) $(call ld-option,--no-warn-rwx-segments) -N \
+		      -Ttext 0xffff8000 -e _start -o $@ $<
+
+$(obj)/bootblock.elf: $(obj)/bootblock.o FORCE
+	$(call if_changed,bootblock)
+
+OBJCOPYFLAGS_bootblock.bin := -O binary
+
+$(obj)/bootblock.bin: $(obj)/bootblock.elf FORCE
+	$(call if_changed,objcopy)
+	@test $$(stat -c %s $@) -le 512 || { echo "$@ exceeds 512 bytes"; false; }
+
+quiet_cmd_bootdisk = DISK    $@
+      cmd_bootdisk = rm -f $@; \
+		     dd if=$(obj)/bootblock.bin of=$@ bs=512 conv=sync status=none && \
+		     dd if=$(obj)/vmlinux.bin of=$@ bs=512 seek=1 conv=sync,notrunc status=none && \
+		     truncate -s %1M $@
+
+$(obj)/bootdisk.img: $(obj)/bootblock.bin $(obj)/vmlinux.bin FORCE
+	$(call if_changed,bootdisk)
diff --git a/arch/i860/boot/bootblock.S b/arch/i860/boot/bootblock.S
new file mode 100644
index 000000000000..21811732209a
--- /dev/null
+++ b/arch/i860/boot/bootblock.S
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * SCSI disk boot block for the Samsung MAGIC Station II ROM monitor.
+ * The ROM loads LBA 0 to 0xffff8000 and enters it in supervisor mode with
+ * the firmware page tables, interrupts off and r1 = return to the monitor.
+ * It reads the kernel with the ROM disk service, stops the LAN controller
+ * and masks the 82380 interrupt banks, then enters the kernel.
+ *
+ * ROM ABI: vector table at 0xfffe0000, arguments in r16-r27, result in
+ * r16, r1-r15 preserved.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#define ROM_HD_READ	0x04
+#define ROM_PUTS	0x3c
+#define ROM_LAN_INIT	0x40
+#define CHUNK		64		/* blocks per read: the DMA SRAM holds 256 KB */
+
+	.text
+	.globl	_start
+_start:
+	mov	%r1,%r15
+	orh	0xfffe,%r0,%r14			/* ROM vectors */
+	orh	[msg_load]@h,%r0,%r16
+	or	[msg_load]@l,%r16,%r16
+	ld.l	ROM_PUTS(%r14),%r31
+	calli	%r31
+	nop
+
+	orh	[KERNEL_LBA]@h,%r0,%r4
+	or	[KERNEL_LBA]@l,%r4,%r4		/* next LBA */
+	orh	[KERNEL_SECTORS]@h,%r0,%r5
+	or	[KERNEL_SECTORS]@l,%r5,%r5	/* blocks left */
+	orh	[KERNEL_LOAD]@h,%r0,%r6
+	or	[KERNEL_LOAD]@l,%r6,%r6		/* destination */
+
+1:	bte	0,%r5,3f
+	mov	%r5,%r7
+	subs	CHUNK,%r5,%r0			/* CC = left > CHUNK */
+	bnc	2f
+	or	CHUNK,%r0,%r7
+2:	mov	%r6,%r16
+	mov	%r4,%r17
+	mov	%r7,%r18
+	ld.l	ROM_HD_READ(%r14),%r31
+	calli	%r31
+	nop
+	btne	0,%r16,9f
+	addu	%r7,%r4,%r4
+	subs	%r5,%r7,%r5
+	shl	9,%r7,%r7
+	br	1b
+	addu	%r7,%r6,%r6
+
+	/* lan_init(0, io, nvram, 0x20) only resets the 82596 */
+3:	mov	%r0,%r16
+	orh	0x1c00,%r0,%r17
+	orh	0x1f00,%r0,%r18
+	or	0x20,%r0,%r19
+	ld.l	ROM_LAN_INIT(%r14),%r31
+	calli	%r31
+	nop
+
+	orh	0x1c00,%r0,%r4
+	or	0xff,%r0,%r5
+	st.b	%r5,0x260(%r4)			/* bank A IMR */
+	st.b	%r5,0x240(%r4)			/* bank B IMR */
+	st.b	%r5,0x340(%r4)			/* bank C IMR */
+
+	orh	[KERNEL_ENTRY]@h,%r0,%r4
+	or	[KERNEL_ENTRY]@l,%r4,%r4
+	mov	%r0,%r16
+	bri	%r4
+	nop
+
+9:	orh	[msg_err]@h,%r0,%r16
+	or	[msg_err]@l,%r16,%r16
+	ld.l	ROM_PUTS(%r14),%r31
+	calli	%r31
+	nop
+	bri	%r15
+	nop
+
+msg_load:
+	.ascii	"Loading Linux...\r\n\0"
+msg_err:
+	.ascii	"Disk read error\r\n\0"
