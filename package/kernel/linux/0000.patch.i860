diff --git a/arch/i860/kernel/asm-offsets.c b/arch/i860/kernel/asm-offsets.c
new file mode 100644
index 000000000000..ab2857b8a4aa
--- /dev/null
+++ b/arch/i860/kernel/asm-offsets.c
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#define COMPILE_OFFSETS
+
+#include <linux/kbuild.h>
+#include <linux/sched.h>
+#include <linux/stddef.h>
+#include <asm/ptrace.h>
+
+int main(void)
+{
+	DEFINE(PT_SIZE, sizeof(struct pt_regs));
+	DEFINE(PT_GPR, offsetof(struct pt_regs, user.gpr));
+	DEFINE(PT_FPR, offsetof(struct pt_regs, user.fpr));
+	DEFINE(PT_PSR, offsetof(struct pt_regs, user.psr));
+	DEFINE(PT_EPSR, offsetof(struct pt_regs, user.epsr));
+	DEFINE(PT_FIR, offsetof(struct pt_regs, user.fir));
+	DEFINE(PT_FSR, offsetof(struct pt_regs, user.fsr));
+	DEFINE(PT_FP_M3, offsetof(struct pt_regs, fp_m3));
+	DEFINE(PT_FP_A3, offsetof(struct pt_regs, fp_a3));
+	BLANK();
+	DEFINE(TASK_THREAD_KSP, offsetof(struct task_struct, thread.ksp));
+	DEFINE(TASK_STACK, offsetof(struct task_struct, stack));
+	return 0;
+}
diff --git a/arch/i860/kernel/dma.c b/arch/i860/kernel/dma.c
new file mode 100644
index 000000000000..d15ce39fee63
--- /dev/null
+++ b/arch/i860/kernel/dma.c
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * 82380 DMA channels and the DMA buffer SRAM (see asm/i860-dma.h).
+ * Register sequence as in the firmware's dma_init/dma_setup.
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/export.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/spinlock.h>
+#include <asm/i860-dma.h>
+
+#define ISP_BASE	0x1c000000
+#define SRAM_BASE	0x18000000
+#define SRAM_WINDOW	0x80000
+
+#define DMA_CMD1	0x010	/* 08h write: command I ch0-3, read: status */
+#define DMA_CMD1_HI	0x190	/* C8h command I ch4-7 */
+#define DMA_MASK	0x410	/* 0Ah mask set/reset */
+#define DMA_MODE1	0x610	/* 0Bh mode I */
+#define DMA_CLRFF	0x018	/* 0Ch clear byte pointer flip-flop */
+#define DMA_BUSSIZE	0x030	/* 18h */
+#define DMA_CMD2	0x430	/* 1Ah command II ch0-3 */
+#define DMA_CMD2_HI	0x5b0	/* DAh command II ch4-7 */
+#define DMA_MODE2	0x630	/* 1Bh mode II */
+
+#define MODE1_TO_MEMORY	0x04	/* demand mode, device -> memory */
+#define MODE1_TO_DEVICE	0x08	/* demand mode, memory -> device */
+
+struct i860_dma_regs {
+	u16 target_lo;		/* A0-A15, byte pointer pair */
+	u16 target_mid;		/* A16-A23 */
+	u16 target_hi;		/* A24-A31 */
+	u16 count_lo;		/* B0-B15, byte pointer pair */
+	u16 count_hi;		/* B16-B23 */
+	u16 requester_lo;	/* requester A0-A15 */
+	u16 requester_hi;	/* requester A16-A31 */
+};
+
+static const struct i860_dma_regs dma_regs[] = {
+	[0] = { 0x000, 0x708, 0x020, 0x200, 0x220, 0x120, 0x320 },
+	[1] = { 0x400, 0x700, 0x420, 0x600, 0x620, 0x520, 0x720 },
+};
+
+static void __iomem *isp;
+static void __iomem *sram;
+static DEFINE_SPINLOCK(dma_lock);
+static u8 dma_tc;		/* TC bits; reading the status clears them all */
+
+static void dma_wr2(u16 reg, unsigned long val)
+{
+	writeb(val & 0xff, isp + reg);
+	writeb((val >> 8) & 0xff, isp + reg);
+}
+
+void i860_dma_start(unsigned int ch, unsigned long sram_off, size_t len,
+		    bool to_device)
+{
+	const struct i860_dma_regs *r = &dma_regs[ch];
+	unsigned long flags;
+
+	spin_lock_irqsave(&dma_lock, flags);
+	writeb(ch | 4, isp + DMA_MASK);
+	dma_tc |= readb(isp + DMA_CMD1);
+	dma_tc &= ~BIT(ch);
+	/* the transfer ends when the count decrements past zero */
+	writeb(0, isp + DMA_CLRFF);
+	dma_wr2(r->count_lo, len - 1);
+	writeb(((len - 1) >> 16) & 0xff, isp + r->count_hi);
+	writeb(0, isp + DMA_CLRFF);
+	dma_wr2(r->target_lo, sram_off);
+	writeb((sram_off >> 16) & 0xff, isp + r->target_mid);
+	writeb(0, isp + r->target_hi);
+	writeb((to_device ? MODE1_TO_DEVICE : MODE1_TO_MEMORY) | ch,
+	       isp + DMA_MODE1);
+	writeb(ch, isp + DMA_MASK);
+	spin_unlock_irqrestore(&dma_lock, flags);
+}
+EXPORT_SYMBOL_GPL(i860_dma_start);
+
+void i860_dma_stop(unsigned int ch)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&dma_lock, flags);
+	writeb(ch | 4, isp + DMA_MASK);
+	spin_unlock_irqrestore(&dma_lock, flags);
+}
+EXPORT_SYMBOL_GPL(i860_dma_stop);
+
+/* Bytes not transferred, 0 after terminal count. */
+size_t i860_dma_residue(unsigned int ch)
+{
+	const struct i860_dma_regs *r = &dma_regs[ch];
+	unsigned long flags;
+	size_t count;
+
+	spin_lock_irqsave(&dma_lock, flags);
+	dma_tc |= readb(isp + DMA_CMD1);
+	if (dma_tc & BIT(ch)) {
+		spin_unlock_irqrestore(&dma_lock, flags);
+		return 0;
+	}
+	writeb(0, isp + DMA_CLRFF);
+	count = readb(isp + r->count_lo);
+	count |= readb(isp + r->count_lo) << 8;
+	count |= readb(isp + r->count_hi) << 16;
+	spin_unlock_irqrestore(&dma_lock, flags);
+	return (count + 1) & 0xffffff;
+}
+EXPORT_SYMBOL_GPL(i860_dma_residue);
+
+/* SRAM byte n is at CPU offset (n / 4) * 8 + n % 4. */
+static inline void __iomem *sram_addr(unsigned long off)
+{
+	return sram + ((off & ~3UL) << 1) + (off & 3);
+}
+
+void i860_sram_write(unsigned long off, const void *buf, size_t len)
+{
+	const u8 *p = buf;
+
+	if (!((off | (unsigned long)p) & 3)) {
+		for (; len >= 4; len -= 4, off += 4, p += 4)
+			__raw_writel(*(const u32 *)p, sram_addr(off));
+	}
+	for (; len; len--, off++, p++)
+		__raw_writeb(*p, sram_addr(off));
+	wmb();
+}
+EXPORT_SYMBOL_GPL(i860_sram_write);
+
+void i860_sram_read(void *buf, unsigned long off, size_t len)
+{
+	u8 *p = buf;
+
+	rmb();
+	if (!((off | (unsigned long)p) & 3)) {
+		for (; len >= 4; len -= 4, off += 4, p += 4)
+			*(u32 *)p = __raw_readl(sram_addr(off));
+	}
+	for (; len; len--, off++, p++)
+		*p = __raw_readb(sram_addr(off));
+}
+EXPORT_SYMBOL_GPL(i860_sram_read);
+
+static int __init i860_dma_init(void)
+{
+	unsigned int ch;
+
+	isp = ioremap(ISP_BASE, 0x1000);
+	sram = ioremap(SRAM_BASE, SRAM_WINDOW);
+	if (!isp || !sram)
+		return -ENOMEM;
+
+	writeb(0x00, isp + DMA_CMD1);
+	writeb(0x04, isp + DMA_CMD1_HI);	/* group 4-7 disabled */
+	writeb(0x0f, isp + DMA_CMD2);
+	writeb(0x0f, isp + DMA_CMD2_HI);
+	for (ch = 0; ch < ARRAY_SIZE(dma_regs); ch++) {
+		writeb(ch | 4, isp + DMA_MASK);
+		writeb(0x50 | ch, isp + DMA_MODE2);	/* fly-by, I/O requester, memory target */
+		writeb(0xf0 | ch, isp + DMA_BUSSIZE);	/* 8-bit requester and target */
+		writeb(0, isp + DMA_CLRFF);
+		dma_wr2(dma_regs[ch].requester_lo, 0);
+		dma_wr2(dma_regs[ch].requester_hi, 0);
+	}
+	return 0;
+}
+arch_initcall(i860_dma_init);
diff --git a/arch/i860/kernel/early_printk.c b/arch/i860/kernel/early_printk.c
new file mode 100644
index 000000000000..f1f1c6f4fded
--- /dev/null
+++ b/arch/i860/kernel/early_printk.c
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Polled boot console on UART A (16450, registers at stride 8).
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <asm/setup.h>
+
+#define UART_A_PHYS	0x1e000600
+#define UART_REG(n)	((n) << 3)
+#define UART_THR	UART_REG(0)
+#define UART_DLL	UART_REG(0)
+#define UART_DLM	UART_REG(1)
+#define UART_IER	UART_REG(1)
+#define UART_LCR	UART_REG(3)
+#define UART_MCR	UART_REG(4)
+#define UART_LSR	UART_REG(5)
+#define UART_LSR_THRE	0x20
+
+static void __iomem *early_uart;
+
+static void early_uart_putc(char c)
+{
+	while (!(readb(early_uart + UART_LSR) & UART_LSR_THRE))
+		;
+	writeb(c, early_uart + UART_THR);
+}
+
+static void early_uart_write(struct console *con, const char *s,
+			     unsigned int n)
+{
+	while (n--) {
+		if (*s == '\n')
+			early_uart_putc('\r');
+		early_uart_putc(*s++);
+	}
+}
+
+static struct console early_uart_console = {
+	.name	= "early",
+	.write	= early_uart_write,
+	.flags	= CON_PRINTBUFFER | CON_BOOT,
+	.index	= -1,
+};
+
+/*
+ * First call: the firmware identity mapping is live; set 9600 8N1 (the
+ * firmware leaves 7N1 for its host link). Second call, after
+ * paging_init: switch to the kernel I/O window.
+ */
+void __init i860_early_console_init(void)
+{
+	if (early_uart) {
+		early_uart = I860_IO(UART_A_PHYS);
+		return;
+	}
+	early_uart = (void __iomem *)UART_A_PHYS;
+	writeb(0x00, early_uart + UART_IER);
+	writeb(0x83, early_uart + UART_LCR);
+	writeb(12, early_uart + UART_DLL);
+	writeb(0, early_uart + UART_DLM);
+	writeb(0x03, early_uart + UART_LCR);
+	writeb(0x03, early_uart + UART_MCR);
+	register_console(&early_uart_console);
+}
diff --git a/arch/i860/kernel/entry.S b/arch/i860/kernel/entry.S
new file mode 100644
index 000000000000..aa6286e3e953
--- /dev/null
+++ b/arch/i860/kernel/entry.S
@@ -0,0 +1,248 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * i860 trap entry/exit and context switch.
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/linkage.h>
+#include <asm/asm-offsets.h>
+#include <asm/i860.h>
+#include <asm/thread_info.h>
+
+#define GPR(n)	(PT_GPR + 4 * (n))
+#define FPR(n)	(PT_FPR + 4 * (n))
+
+	.text
+
+/*
+ * Copied to the trap vector at 0xffffff00. On entry U = IM = 0 and no
+ * register is free, so r1, r2 and psr go to scratch words in the trap page.
+ * The trap bits are cleared before the first bri, which would otherwise
+ * be a trap return.
+ */
+	.align	8
+ENTRY(i860_trap_vector)
+	/* as the Stardent kernel: let the pipelines settle */
+	nop
+	nop
+	nop
+	nop
+	nop
+	nop
+	nop
+	nop
+	st.l	%r1,SCR_R1(%r0)
+	st.l	%r2,SCR_R2(%r0)
+	ld.c	%psr,%r1
+	st.l	%r1,SCR_PSR(%r0)
+	/* KNF stays in the saved psr: live, it would kill a kernel FP instruction */
+	andnot	PSR_TRAPS | PSR_KNF,%r1,%r1
+	st.c	%r1,%psr
+	and	PSR_PU,%r1,%r0
+	bc	1f
+	ld.l	SCR_KSP(%r0),%r2	/* from user mode: kernel stack */
+1:	orh	[i860_trap_entry]@h,%r0,%r1
+	or	[i860_trap_entry]@l,%r1,%r1
+	bri	%r1
+	nop
+ENTRY(i860_trap_vector_end)
+
+ENTRY(i860_trap_entry)
+	andnot	15,%r2,%r2
+	adds	-PT_SIZE,%r2,%r2
+	st.l	%r3,GPR(3)(%r2)
+	st.l	%r4,GPR(4)(%r2)
+	st.l	%r5,GPR(5)(%r2)
+	st.l	%r6,GPR(6)(%r2)
+	st.l	%r7,GPR(7)(%r2)
+	st.l	%r8,GPR(8)(%r2)
+	st.l	%r9,GPR(9)(%r2)
+	st.l	%r10,GPR(10)(%r2)
+	st.l	%r11,GPR(11)(%r2)
+	st.l	%r12,GPR(12)(%r2)
+	st.l	%r13,GPR(13)(%r2)
+	st.l	%r14,GPR(14)(%r2)
+	st.l	%r15,GPR(15)(%r2)
+	st.l	%r16,GPR(16)(%r2)
+	st.l	%r17,GPR(17)(%r2)
+	st.l	%r18,GPR(18)(%r2)
+	st.l	%r19,GPR(19)(%r2)
+	st.l	%r20,GPR(20)(%r2)
+	st.l	%r21,GPR(21)(%r2)
+	st.l	%r22,GPR(22)(%r2)
+	st.l	%r23,GPR(23)(%r2)
+	st.l	%r24,GPR(24)(%r2)
+	st.l	%r25,GPR(25)(%r2)
+	st.l	%r26,GPR(26)(%r2)
+	st.l	%r27,GPR(27)(%r2)
+	st.l	%r28,GPR(28)(%r2)
+	st.l	%r29,GPR(29)(%r2)
+	st.l	%r30,GPR(30)(%r2)
+	st.l	%r31,GPR(31)(%r2)
+	st.l	%r0,GPR(0)(%r2)
+	ld.l	SCR_R1(%r0),%r4
+	st.l	%r4,GPR(1)(%r2)
+	ld.l	SCR_R2(%r0),%r4
+	st.l	%r4,GPR(2)(%r2)
+	ld.l	SCR_PSR(%r0),%r4
+	st.l	%r4,PT_PSR(%r2)
+	/* only the first read of fir after a trap returns the trap address */
+	ld.c	%fir,%r4
+	st.l	%r4,PT_FIR(%r2)
+	ld.c	%epsr,%r4
+	st.l	%r4,PT_EPSR(%r2)
+	ld.c	%fsr,%r4
+	st.l	%r4,PT_FSR(%r2)
+	/* kernel FP state: round to nearest, no FP traps, also for the saves here */
+	st.c	%r0,%fsr
+	fst.q	%f0,FPR(0)(%r2)
+	fst.q	%f4,FPR(4)(%r2)
+	fst.q	%f8,FPR(8)(%r2)
+	fst.q	%f12,FPR(12)(%r2)
+	fst.q	%f16,FPR(16)(%r2)
+	fst.q	%f20,FPR(20)(%r2)
+	fst.q	%f24,FPR(24)(%r2)
+	fst.q	%f28,FPR(28)(%r2)
+	/* a pending result exception: its value is in the last pipeline stages */
+	and	FSR_FTE,%r4,%r0
+	bc	1f
+	and	FSR_RESULT,%r4,%r0
+	bc	1f
+	pfmul.ss %f0,%f0,%f16
+	pfadd.ss %f0,%f0,%f18
+	fst.d	%f16,PT_FP_M3(%r2)
+	fst.d	%f18,PT_FP_A3(%r2)
+	pfmul.ss %f0,%f0,%f0
+	pfmul.ss %f0,%f0,%f0
+	pfadd.ss %f0,%f0,%f0
+	pfadd.ss %f0,%f0,%f0
+1:	mov	%r0,%fp
+	call	i860_handle_trap
+	mov	%r2,%r16
+
+/* r2 = pt_regs; interrupts are disabled */
+ENTRY(ret_from_exception)
+	ld.c	%psr,%r4
+	andnot	PSR_IM,%r4,%r4
+	st.c	%r4,%psr
+	ld.l	PT_FSR(%r2),%r4
+	fld.q	FPR(0)(%r2),%f0
+	fld.q	FPR(4)(%r2),%f4
+	fld.q	FPR(8)(%r2),%f8
+	fld.q	FPR(12)(%r2),%f12
+	fld.q	FPR(16)(%r2),%f16
+	fld.q	FPR(20)(%r2),%f20
+	fld.q	FPR(24)(%r2),%f24
+	fld.q	FPR(28)(%r2),%f28
+	st.c	%r4,%fsr
+	ld.l	GPR(3)(%r2),%r3
+	ld.l	GPR(4)(%r2),%r4
+	ld.l	GPR(5)(%r2),%r5
+	ld.l	GPR(6)(%r2),%r6
+	ld.l	GPR(7)(%r2),%r7
+	ld.l	GPR(8)(%r2),%r8
+	ld.l	GPR(9)(%r2),%r9
+	ld.l	GPR(10)(%r2),%r10
+	ld.l	GPR(11)(%r2),%r11
+	ld.l	GPR(12)(%r2),%r12
+	ld.l	GPR(13)(%r2),%r13
+	ld.l	GPR(14)(%r2),%r14
+	ld.l	GPR(15)(%r2),%r15
+	ld.l	GPR(16)(%r2),%r16
+	ld.l	GPR(17)(%r2),%r17
+	ld.l	GPR(18)(%r2),%r18
+	ld.l	GPR(19)(%r2),%r19
+	ld.l	GPR(20)(%r2),%r20
+	ld.l	GPR(21)(%r2),%r21
+	ld.l	GPR(22)(%r2),%r22
+	ld.l	GPR(23)(%r2),%r23
+	ld.l	GPR(24)(%r2),%r24
+	ld.l	GPR(25)(%r2),%r25
+	ld.l	GPR(26)(%r2),%r26
+	ld.l	GPR(27)(%r2),%r27
+	ld.l	GPR(28)(%r2),%r28
+	ld.l	GPR(29)(%r2),%r29
+	ld.l	GPR(30)(%r2),%r30
+	ld.l	GPR(31)(%r2),%r31
+	/*
+	 * With a trap bit set in psr, bri returns from the trap (U = PU,
+	 * IM = PIM). Its delay slot still runs in supervisor mode and
+	 * reloads r1 from the trap page.
+	 */
+	ld.l	PT_PSR(%r2),%r1
+	or	PSR_IT,%r1,%r1
+	st.c	%r1,%psr
+	ld.l	GPR(1)(%r2),%r1
+	st.l	%r1,SCR_EXIT(%r0)
+	ld.l	PT_FIR(%r2),%r1
+	ld.l	GPR(2)(%r2),%r2
+	ld.l	SCR_EXIT(%r0),%r0
+	bri	%r1
+	ld.l	SCR_EXIT(%r0),%r1
+
+/*
+ * struct task_struct *__switch_to(prev = r16, next = r17)
+ * Saves the callee-saved state in a frame on the old kernel stack.
+ */
+#define SW_SIZE	80
+ENTRY(__switch_to)
+	adds	-SW_SIZE,%sp,%sp
+	st.l	%r1,0(%sp)
+	st.l	%fp,4(%sp)
+	st.l	%r4,8(%sp)
+	st.l	%r5,12(%sp)
+	st.l	%r6,16(%sp)
+	st.l	%r7,20(%sp)
+	st.l	%r8,24(%sp)
+	st.l	%r9,28(%sp)
+	st.l	%r10,32(%sp)
+	st.l	%r11,36(%sp)
+	st.l	%r12,40(%sp)
+	st.l	%r13,44(%sp)
+	st.l	%r14,48(%sp)
+	st.l	%r15,52(%sp)
+	fst.l	%f2,56(%sp)
+	fst.l	%f3,60(%sp)
+	fst.l	%f4,64(%sp)
+	fst.l	%f5,68(%sp)
+	fst.l	%f6,72(%sp)
+	fst.l	%f7,76(%sp)
+	st.l	%sp,TASK_THREAD_KSP(%r16)
+	ld.l	TASK_THREAD_KSP(%r17),%sp
+	ld.l	TASK_STACK(%r17),%r18
+	addu	THREAD_SIZE,%r18,%r18
+	st.l	%r18,SCR_KSP(%r0)
+	ld.l	0(%sp),%r1
+	ld.l	4(%sp),%fp
+	ld.l	8(%sp),%r4
+	ld.l	12(%sp),%r5
+	ld.l	16(%sp),%r6
+	ld.l	20(%sp),%r7
+	ld.l	24(%sp),%r8
+	ld.l	28(%sp),%r9
+	ld.l	32(%sp),%r10
+	ld.l	36(%sp),%r11
+	ld.l	40(%sp),%r12
+	ld.l	44(%sp),%r13
+	ld.l	48(%sp),%r14
+	ld.l	52(%sp),%r15
+	fld.l	56(%sp),%f2
+	fld.l	60(%sp),%f3
+	fld.l	64(%sp),%f4
+	fld.l	68(%sp),%f5
+	fld.l	72(%sp),%f6
+	fld.l	76(%sp),%f7
+	bri	%r1
+	adds	SW_SIZE,%sp,%sp
+
+/*
+ * First return of a new task, from __switch_to: r16 = prev, sp = pt_regs,
+ * r4 = kernel thread function or 0, r5 = its argument.
+ */
+ENTRY(ret_from_fork)
+	mov	%sp,%r17
+	mov	%r4,%r18
+	call	i860_ret_from_fork
+	mov	%r5,%r19
+	br	ret_from_exception
+	nop
diff --git a/arch/i860/kernel/fpemu.c b/arch/i860/kernel/fpemu.c
new file mode 100644
index 000000000000..c09d487b81d4
--- /dev/null
+++ b/arch/i860/kernel/fpemu.c
@@ -0,0 +1,552 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Floating-point traps, after the protocol of the Stardent SVR4 kernel handler
+ * (no manual was available, see the project's tmp/notes/fp-trap.md).
+ *
+ * Source exception: an operand is NaN, infinity or denormal, or frcp/frsqr has
+ * no result. fir is the unexecuted instruction: emulate it here and set PSR.KNF,
+ * which kills it on resume. Result exception: the instruction ran earlier, fir is
+ * a later one; the entry code popped the value with the exponent wrapped into
+ * fp_m3 and fp_a3, RR names the register it was meant for.
+ *
+ * Everything is masked: the default IEEE result, no SIGFPE, as SVR4 does by
+ * default. Integer arithmetic only, this runs on the kernel side of user FP state.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/bits.h>
+#include <linux/kernel.h>
+#include <linux/ptrace.h>
+#include <linux/types.h>
+#include <asm/i860.h>
+#include <asm/traps.h>
+
+#define FSR_RM_SHIFT	2
+#define RM_NEAREST	0
+#define RM_DOWN		1
+#define RM_UP		2
+#define RM_CHOP		3
+
+#define FSR_MU		0x00000200
+#define FSR_MO		0x00000400
+#define FSR_MI		0x00000800
+#define FSR_MA		0x00001000
+#define FSR_AU		0x00002000
+#define FSR_AO		0x00004000
+#define FSR_AI		0x00008000
+#define FSR_AA		0x00010000
+#define FSR_RR_SHIFT	17
+#define FSR_RR		0x003e0000
+#define FSR_AE_SHIFT	22
+#define FSR_MRP		0x10000000
+#define FSR_ARP		0x20000000
+
+/* A number being worked on: value = m * 2^(exp - 62), bit 62 of m set */
+enum fp_class { FP_ZERO, FP_NORMAL, FP_INF, FP_NAN };
+
+struct fp_num {
+	enum fp_class cls;
+	bool sign;
+	int exp;
+	u64 m;
+	u64 raw;	/* NaN: the value as a double */
+};
+
+static const struct fp_fmt {
+	int bias, p;	/* exponent bias, significand bits with the hidden one */
+} fmt_s = { 127, 24 }, fmt_d = { 1023, 53 };
+
+static u64 get_reg(const struct pt_regs *regs, unsigned int r, bool dbl)
+{
+	if (dbl)
+		return regs->user.fpr[r & ~1u] | ((u64)regs->user.fpr[r | 1] << 32);
+	return regs->user.fpr[r];
+}
+
+static void set_reg(struct pt_regs *regs, unsigned int r, bool dbl, u64 v)
+{
+	if (r < 2)			/* f0 and f1 read as zero */
+		return;
+	if (dbl) {
+		regs->user.fpr[r & ~1u] = (u32)v;
+		regs->user.fpr[r | 1] = v >> 32;
+	} else {
+		regs->user.fpr[r] = (u32)v;
+	}
+}
+
+static struct fp_num unpack(u64 raw, bool dbl)
+{
+	struct fp_num n = { .raw = raw };
+	u64 frac;
+	int e;
+
+	if (dbl) {
+		n.sign = raw >> 63;
+		e = (raw >> 52) & 0x7ff;
+		frac = raw & GENMASK_ULL(51, 0);
+		if (e == 0x7ff) {
+			n.cls = frac ? FP_NAN : FP_INF;
+			return n;
+		}
+		if (!e && !frac)
+			return n;
+		n.m = e ? frac | BIT_ULL(52) : frac;
+		n.exp = (e ? e : 1) - 1023;
+		n.m <<= 10;
+	} else {
+		n.sign = (raw >> 31) & 1;
+		e = (raw >> 23) & 0xff;
+		frac = raw & GENMASK_ULL(22, 0);
+		if (e == 0xff) {
+			n.cls = frac ? FP_NAN : FP_INF;
+			/* as a double, quieted later */
+			n.raw = ((u64)n.sign << 63) | GENMASK_ULL(62, 52) | (frac << 29);
+			return n;
+		}
+		if (!e && !frac)
+			return n;
+		n.m = e ? frac | BIT_ULL(23) : frac;
+		n.exp = (e ? e : 1) - 127;
+		n.m <<= 39;
+	}
+	n.cls = FP_NORMAL;
+	while (!(n.m & BIT_ULL(62))) {
+		n.m <<= 1;
+		n.exp--;
+	}
+	return n;
+}
+
+static u64 make_inf(bool sign, bool dbl)
+{
+	return dbl ? ((u64)sign << 63) | GENMASK_ULL(62, 52)
+		   : ((u64)sign << 31) | GENMASK_ULL(30, 23);
+}
+
+static u64 make_max(bool sign, bool dbl)
+{
+	return dbl ? ((u64)sign << 63) | GENMASK_ULL(62, 53) | GENMASK_ULL(51, 0)
+		   : ((u64)sign << 31) | GENMASK_ULL(30, 24) | GENMASK_ULL(22, 0);
+}
+
+static u64 make_nan(bool dbl)
+{
+	return dbl ? 0xfff8000000000000ULL : 0xffc00000ULL;
+}
+
+static u64 overflow_value(bool sign, bool dbl, int rm)
+{
+	switch (rm) {
+	case RM_DOWN:
+		return sign ? make_inf(sign, dbl) : make_max(sign, dbl);
+	case RM_UP:
+		return sign ? make_max(sign, dbl) : make_inf(sign, dbl);
+	case RM_CHOP:
+		return make_max(sign, dbl);
+	default:
+		return make_inf(sign, dbl);
+	}
+}
+
+/* Add one to the kept bits? LOST holds the dropped bits, HALF the first of them */
+static bool fp_round_up(bool sign, bool odd, u64 lost, u64 half, int rm)
+{
+	switch (rm) {
+	case RM_NEAREST:
+		return lost > half || (lost == half && odd);
+	case RM_DOWN:
+		return sign && lost;
+	case RM_UP:
+		return !sign && lost;
+	default:
+		return false;
+	}
+}
+
+static u64 shift_sticky(u64 m, unsigned int n)
+{
+	if (n >= 64)
+		return m != 0;
+	return (m >> n) | ((m & (BIT_ULL(n) - 1)) != 0);
+}
+
+/* Round and pack M * 2^(EXP - 62), bit 62 of M set. FZ flushes underflow to +0 */
+static u64 pack(bool sign, int exp, u64 m, bool dbl, int rm, bool fz)
+{
+	const struct fp_fmt *f = dbl ? &fmt_d : &fmt_s;
+	unsigned int drop = 63 - f->p;
+	int be = exp + f->bias;
+	u64 lost, half, mant;
+
+	if (be <= 0) {
+		if (fz)
+			return 0;
+		/* subnormal: more bits drop, the exponent field stays 0 */
+		m = shift_sticky(m, 1 - be);
+		be = 0;
+	}
+	half = BIT_ULL(drop - 1);
+	lost = m & (BIT_ULL(drop) - 1);
+	mant = m >> drop;
+	if (fp_round_up(sign, mant & 1, lost, half, rm))
+		mant++;
+	if (mant >> f->p) {		/* carried out: one bit more */
+		mant >>= 1;
+		be++;
+	}
+	if (be == 0 && mant >> (f->p - 1))
+		be = 1;			/* rounded up to the smallest normal */
+	if (be >= 2 * f->bias + 1)
+		return overflow_value(sign, dbl, rm);
+
+	mant &= BIT_ULL(f->p - 1) - 1;
+	return ((u64)sign << (dbl ? 63 : 31)) | ((u64)be << (f->p - 1)) | mant;
+}
+
+static u64 nan_result(const struct fp_num *n, bool dbl)
+{
+	u64 q = n->raw | BIT_ULL(51);	/* quieted, the raw form is a double */
+
+	if (dbl)
+		return q;
+	return ((q >> 63) << 31) | GENMASK_ULL(30, 23) | ((q >> 29) & GENMASK_ULL(22, 0));
+}
+
+static u64 do_add(struct fp_num a, struct fp_num b, bool sub, bool dbl, int rm, bool fz)
+{
+	u64 m;
+	int exp;
+	bool sign;
+
+	if (sub)
+		b.sign = !b.sign;
+	if (a.cls == FP_NAN)
+		return nan_result(&a, dbl);
+	if (b.cls == FP_NAN)
+		return nan_result(&b, dbl);
+	if (a.cls == FP_INF || b.cls == FP_INF) {
+		if (a.cls == FP_INF && b.cls == FP_INF && a.sign != b.sign)
+			return make_nan(dbl);
+		return make_inf(a.cls == FP_INF ? a.sign : b.sign, dbl);
+	}
+	if (a.cls == FP_ZERO && b.cls == FP_ZERO) {
+		sign = a.sign == b.sign ? a.sign : rm == RM_DOWN;
+		return (u64)sign << (dbl ? 63 : 31);
+	}
+	if (a.cls == FP_ZERO)
+		a = b;
+	else if (b.cls != FP_ZERO) {
+		if (a.exp < b.exp || (a.exp == b.exp && a.m < b.m))
+			swap(a, b);
+		/* one guard bit below the sticky: m moves down one */
+		exp = a.exp;
+		a.m >>= 1;
+		b.m = shift_sticky(b.m >> 1, a.exp - b.exp);
+		if (a.sign == b.sign) {
+			m = a.m + b.m;
+		} else {
+			m = a.m - b.m;
+			if (!m)
+				return (u64)(rm == RM_DOWN) << (dbl ? 63 : 31);
+		}
+		a.m = m;
+		a.exp = exp + 1;
+		while (!(a.m & BIT_ULL(62))) {
+			a.m <<= 1;
+			a.exp--;
+		}
+	}
+	return pack(a.sign, a.exp, a.m, dbl, rm, fz);
+}
+
+static u64 do_mul(const struct fp_num *a, const struct fp_num *b, bool dbl, int rm, bool fz)
+{
+	bool sign = a->sign != b->sign;
+	u64 al = (u32)a->m, ah = a->m >> 32, bl = (u32)b->m, bh = b->m >> 32;
+	u64 ll, lh, hl, hh, mid, hi, lo, m;
+	int exp;
+
+	if (a->cls == FP_NAN)
+		return nan_result(a, dbl);
+	if (b->cls == FP_NAN)
+		return nan_result(b, dbl);
+	if (a->cls == FP_INF || b->cls == FP_INF) {
+		if (a->cls == FP_ZERO || b->cls == FP_ZERO)
+			return make_nan(dbl);
+		return make_inf(sign, dbl);
+	}
+	if (a->cls == FP_ZERO || b->cls == FP_ZERO)
+		return (u64)sign << (dbl ? 63 : 31);
+
+	ll = al * bl;
+	lh = al * bh;
+	hl = ah * bl;
+	hh = ah * bh;
+	mid = (ll >> 32) + (u32)lh + (u32)hl;
+	lo = (mid << 32) | (u32)ll;
+	hi = hh + (lh >> 32) + (hl >> 32) + (mid >> 32);
+
+	/* two bits 62 multiplied: the product's top bit is 124 or 125 */
+	exp = a->exp + b->exp;
+	if (hi & BIT_ULL(61)) {		/* bit 125 */
+		m = (hi << 1) | (lo >> 63);
+		lo <<= 1;
+		exp++;
+	} else {
+		m = (hi << 2) | (lo >> 62);
+		lo <<= 2;
+	}
+	return pack(sign, exp, m | (lo != 0), dbl, rm, fz);
+}
+
+/* frcp: the hardware gives only an approximation, the exact value is fine */
+static u64 do_frcp(const struct fp_num *a, bool dbl, int rm, bool fz)
+{
+	u64 rem = BIT_ULL(62), q = 0;
+	int i, exp = -a->exp;
+
+	if (a->cls == FP_NAN)
+		return nan_result(a, dbl);
+	if (a->cls == FP_ZERO)
+		return make_inf(a->sign, dbl);
+	if (a->cls == FP_INF)
+		return (u64)a->sign << (dbl ? 63 : 31);
+
+	for (i = 0; i <= 62; i++) {
+		q <<= 1;
+		if (rem >= a->m) {
+			rem -= a->m;
+			q |= 1;
+		}
+		rem <<= 1;
+	}
+	while (!(q & BIT_ULL(62))) {
+		q <<= 1;
+		exp--;
+	}
+	return pack(a->sign, exp, q | (rem != 0), dbl, rm, fz);
+}
+
+/* frsqr: 1 / sqrt(x), also an approximation in hardware */
+static u64 do_frsqr(const struct fp_num *a, bool dbl, int rm, bool fz)
+{
+	struct fp_num r = { .cls = FP_NORMAL };
+	u64 v, root = 0, bit = BIT_ULL(62), m;
+	int exp = a->exp;
+
+	if (a->cls == FP_NAN)
+		return nan_result(a, dbl);
+	if (a->cls == FP_ZERO)
+		return make_inf(false, dbl);
+	if (a->sign)
+		return make_nan(dbl);
+	if (a->cls == FP_INF)
+		return 0;
+
+	/* the square root of m with 31 significant bits is plenty */
+	m = a->m;
+	if (exp & 1) {
+		v = m >> 1;
+		exp++;
+	} else {
+		v = m;
+	}
+	while (bit > v)
+		bit >>= 2;
+	while (bit) {
+		if (v >= root + bit) {
+			v -= root + bit;
+			root = (root >> 1) + bit;
+		} else {
+			root >>= 1;
+		}
+		bit >>= 2;
+	}
+	r.m = root;
+	r.exp = (exp - 62) / 2 + 62;	/* exp - 62 is even */
+	while (!(r.m & BIT_ULL(62))) {
+		r.m <<= 1;
+		r.exp--;
+	}
+	return do_frcp(&r, dbl, rm, fz);
+}
+
+/* To the low 32 bits: fix rounds by RM, ftrunc chops */
+static u64 do_fix(const struct fp_num *a, bool dbl, int rm)
+{
+	u64 mant, lost, half;
+	int shift;
+
+	if (a->cls == FP_NAN || a->cls == FP_INF)
+		return make_nan(true);
+	if (a->cls == FP_ZERO)
+		return 0;
+
+	shift = 62 - a->exp;
+	if (shift <= 0)
+		return make_nan(true);
+	if (shift > 63) {
+		mant = 0;
+		lost = 1;
+		half = BIT_ULL(63);
+	} else {
+		mant = a->m >> shift;
+		lost = a->m & (BIT_ULL(shift) - 1);
+		half = BIT_ULL(shift - 1);
+	}
+	if (fp_round_up(a->sign, mant & 1, lost, half, rm))
+		mant++;
+	return (u32)(a->sign ? -(s64)mant : (s64)mant);
+}
+
+/* a > b; both are not NaN */
+static bool fp_greater(const struct fp_num *a, const struct fp_num *b)
+{
+	int mag;
+
+	if (a->cls == FP_ZERO && b->cls == FP_ZERO)
+		return false;
+	if (a->cls != FP_ZERO && b->cls != FP_ZERO && a->sign != b->sign)
+		return b->sign;
+	if (a->cls == FP_ZERO)
+		return b->sign;
+	if (b->cls == FP_ZERO)
+		return !a->sign;
+
+	if (a->cls == FP_INF || b->cls == FP_INF)
+		mag = (a->cls == FP_INF) - (b->cls == FP_INF);
+	else if (a->exp != b->exp)
+		mag = a->exp > b->exp ? 1 : -1;
+	else
+		mag = a->m == b->m ? 0 : a->m > b->m ? 1 : -1;
+	return a->sign ? mag < 0 : mag > 0;
+}
+
+/*
+ * Pending result exception: the value popped at entry, RR its register. Mask
+ * status bits follow the hardware, per pipeline unit.
+ */
+bool i860_fp_result_pending(unsigned long fsr)
+{
+	return (fsr & FSR_FTE) &&
+	       ((fsr & (FSR_MU | FSR_MO | FSR_AU | FSR_AO)) ||
+		((fsr & FSR_TI) && (fsr & (FSR_MI | FSR_AI))));
+}
+
+/* The value has a wrapped exponent. Return it as a denormal, rounded by RM */
+static u64 denormalize(u64 val, bool dbl, bool adder, unsigned long fsr, int rm)
+{
+	unsigned int ebits = dbl ? (val >> 52) & 0x7ff : (val >> 23) & 0xff;
+	bool sign = dbl ? val >> 63 : (val >> 31) & 1;
+	u64 m = dbl ? (val & GENMASK_ULL(51, 0)) | BIT_ULL(52)
+		    : (val & GENMASK_ULL(22, 0)) | BIT_ULL(23);
+	int e = ebits;
+
+	/* single: the adder has 3 more bits in AE, a product is always in range */
+	if (!dbl)
+		e |= (adder ? (fsr >> FSR_AE_SHIFT) & 7 : 7) << 8;
+	if (ebits || (!dbl && adder && e))
+		e -= 2048;
+	else
+		e = 0;
+
+	/* e is the biased exponent, zero or below */
+	m <<= dbl ? 10 : 39;
+	return pack(sign, e - (dbl ? 1023 : 127), m, dbl, rm, false);
+}
+
+void i860_fp_result(struct pt_regs *regs)
+{
+	unsigned long fsr = regs->user.fsr;
+	unsigned int rr = (fsr & FSR_RR) >> FSR_RR_SHIFT;
+	int rm = (fsr >> FSR_RM_SHIFT) & 3;
+	u64 m3 = regs->fp_m3[0] | ((u64)regs->fp_m3[1] << 32);
+	u64 a3 = regs->fp_a3[0] | ((u64)regs->fp_a3[1] << 32);
+	bool mdbl = fsr & FSR_MRP, adbl = fsr & FSR_ARP;
+
+	if (fsr & FSR_MO)
+		set_reg(regs, rr, mdbl, overflow_value(mdbl ? m3 >> 63 : (m3 >> 31) & 1, mdbl, rm));
+	else if (fsr & FSR_MU)
+		set_reg(regs, rr, mdbl, denormalize(m3, mdbl, false, fsr, rm));
+	if (fsr & FSR_AO)
+		set_reg(regs, rr, adbl, overflow_value(adbl ? a3 >> 63 : (a3 >> 31) & 1, adbl, rm));
+	else if (fsr & FSR_AU)
+		set_reg(regs, rr, adbl, denormalize(a3, adbl, true, fsr, rm));
+
+	/* an inexact result is only recorded once: TI off, as for a masked one */
+	regs->user.fsr = fsr & ~(FSR_TI | FSR_MU | FSR_MO | FSR_MI | FSR_MA | FSR_AU | FSR_AO |
+				 FSR_AI | FSR_AA | FSR_MRP | FSR_ARP | FSR_RR);
+}
+
+/* Source exception on the instruction INSN: result in the registers or CC */
+int i860_fp_source(struct pt_regs *regs, u32 insn)
+{
+	unsigned long fsr = regs->user.fsr;
+	unsigned int op = insn & 0x7f, fdest = (insn >> 16) & 31;
+	unsigned int fsrc1 = (insn >> 11) & 31, fsrc2 = (insn >> 21) & 31;
+	bool s = insn & 0x100, r = insn & 0x80, fz = fsr & FSR_FZ;
+	int rm = (fsr >> FSR_RM_SHIFT) & 3;
+	struct fp_num a = unpack(get_reg(regs, fsrc1, s), s);
+	struct fp_num b = unpack(get_reg(regs, fsrc2, s), s);
+	u64 res;
+
+	/* the compares have only a pipelined format */
+	if ((insn & 0x400) && op != 0x34 && op != 0x35)
+		return -EOPNOTSUPP;
+
+	switch (op) {
+	case 0x20:
+		res = do_mul(&a, &b, r, rm, fz);
+		break;
+	case 0x22:
+		res = do_frcp(&b, r, rm, fz);
+		break;
+	case 0x23:
+		res = do_frsqr(&b, r, rm, fz);
+		break;
+	case 0x30:
+	case 0x31:
+		res = do_add(a, b, op & 1, r, rm, fz);
+		break;
+	case 0x32:
+		res = do_fix(&a, r, rm);
+		break;
+	case 0x3a:
+		res = do_fix(&a, r, RM_CHOP);
+		break;
+	case 0x33:
+		switch (a.cls) {
+		case FP_NAN:
+			res = nan_result(&a, r);
+			break;
+		case FP_INF:
+			res = make_inf(a.sign, r);
+			break;
+		case FP_ZERO:
+			res = (u64)a.sign << (r ? 63 : 31);
+			break;
+		default:
+			res = pack(a.sign, a.exp, a.m, r, rm, fz);
+		}
+		break;
+	case 0x34:
+	case 0x35: {
+		bool cc = false;
+
+		if (a.cls != FP_NAN && b.cls != FP_NAN) {
+			if (op == 0x34)
+				cc = fp_greater(&a, &b);
+			else
+				cc = !fp_greater(&a, &b) && !fp_greater(&b, &a);
+		}
+		regs->user.psr = cc ? regs->user.psr | PSR_CC : regs->user.psr & ~PSR_CC;
+		return 0;
+	}
+	default:
+		return -EOPNOTSUPP;
+	}
+	set_reg(regs, fdest, r, res);
+	return 0;
+}
diff --git a/arch/i860/kernel/head.S b/arch/i860/kernel/head.S
new file mode 100644
index 000000000000..013e315c030c
--- /dev/null
+++ b/arch/i860/kernel/head.S
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Kernel entry from the boot block: supervisor mode, interrupts off, the
+ * firmware page tables (identity, uncached) still active.
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/linkage.h>
+#include <asm/asm-offsets.h>
+#include <asm/i860.h>
+#include <asm/thread_info.h>
+
+	__HEAD
+ENTRY(_start)
+	st.c	%r0,%psr
+	st.c	%r0,%fsr
+	/* supervisor writes honour read-only pages (copy-on-write) */
+	ld.c	%epsr,%r4
+	or	EPSR_WP,%r4,%r4
+	st.c	%r4,%epsr
+
+	orh	[init_thread_union]@h,%r0,%sp
+	or	[init_thread_union]@l,%sp,%sp
+	addu	THREAD_SIZE-PT_SIZE,%sp,%sp
+	mov	%r0,%fp
+
+	orh	[__bss_start]@h,%r0,%r4
+	or	[__bss_start]@l,%r4,%r4
+	orh	[__bss_stop]@h,%r0,%r5
+	or	[__bss_stop]@l,%r5,%r5
+	br	2f
+	nop
+1:	st.l	%r0,0(%r4)
+	addu	4,%r4,%r4
+2:	subs	%r4,%r5,%r0		/* CC = r4 < r5 */
+	bc	1b
+
+	call	start_kernel
+	nop
+3:	br	3b
+	nop
diff --git a/arch/i860/kernel/irq.c b/arch/i860/kernel/irq.c
new file mode 100644
index 000000000000..ef2a656f09d6
--- /dev/null
+++ b/arch/i860/kernel/irq.c
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Intel 82380 interrupt controller: three 8259A-style banks, internally
+ * cascaded C -> B IR2 -> A IR2 -> CPU INT, level triggered. Each IRQ has a
+ * vector register; it is programmed with the IRQ number, which one load
+ * from 0x1c000800 (interrupt acknowledge) returns.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/irqchip/chained_irq.h>
+
+#define ISP_BASE	0x1c000000
+#define ISP_INTA	0x800
+
+#define BANK_A	0
+#define BANK_B	1
+#define BANK_C	2
+#define NBANKS	3
+#define CASCADE_LINE	2
+
+static const u16 cmd_port[NBANKS]  = { 0x060, 0x040, 0x140 };
+static const u16 imr_port[NBANKS]  = { 0x260, 0x240, 0x340 };
+static const u16 icw2_port[NBANKS] = { 0x460, 0x440, 0x540 };
+
+/* vector register offsets; slot 2 is IRQ1.5 ("ICW2 written") */
+static const s16 vector_port[NR_IRQS] = {
+	0x070, 0x270, 0x470, 0x670, 0x078,    -1,    -1, 0x678,
+	0x050, 0x250,    -1, 0x650, 0x058, 0x258, 0x458, 0x658,
+	0x150, 0x350, 0x550, 0x750, 0x158, 0x358, 0x558, 0x758,
+};
+
+static void __iomem *isp;
+static u8 imr[NBANKS] = {
+	0xff & ~BIT(CASCADE_LINE), 0xff & ~BIT(CASCADE_LINE), 0xff
+};
+
+static void i82380_write_imr(unsigned int bank)
+{
+	writeb(imr[bank], isp + imr_port[bank]);
+}
+
+static void i82380_mask(struct irq_data *d)
+{
+	unsigned int irq = d->irq;
+
+	imr[irq >> 3] |= BIT(irq & 7);
+	i82380_write_imr(irq >> 3);
+}
+
+static void i82380_unmask(struct irq_data *d)
+{
+	unsigned int irq = d->irq;
+
+	imr[irq >> 3] &= ~BIT(irq & 7);
+	i82380_write_imr(irq >> 3);
+}
+
+/* Specific EOI for the level, then for the cascade lines above it. */
+static void i82380_eoi(unsigned int irq)
+{
+	unsigned int bank = irq >> 3;
+
+	writeb(0x60 | (irq & 7), isp + cmd_port[bank]);
+	while (bank-- > BANK_A)
+		writeb(0x60 | CASCADE_LINE, isp + cmd_port[bank]);
+}
+
+static void i82380_mask_ack(struct irq_data *d)
+{
+	i82380_mask(d);
+	i82380_eoi(d->irq);
+}
+
+static struct irq_chip i82380_chip = {
+	.name		= "82380",
+	.irq_mask	= i82380_mask,
+	.irq_unmask	= i82380_unmask,
+	.irq_mask_ack	= i82380_mask_ack,
+};
+
+/* The lowest priority level reads as 7 when no request is in service. */
+static bool i82380_spurious(unsigned int irq)
+{
+	unsigned int bank = irq >> 3;
+
+	if ((irq & 7) != 7)
+		return false;
+	if (readb(isp + cmd_port[bank]) & 0x80)	/* ISR (OCW3 0x0b) */
+		return false;
+	while (bank-- > BANK_A)
+		writeb(0x20, isp + cmd_port[bank]);
+	return true;
+}
+
+static void i82380_handle_irq(struct pt_regs *regs)
+{
+	unsigned int irq = readl(isp + ISP_INTA) & 0xff;
+
+	if (irq >= NR_IRQS || i82380_spurious(irq))
+		return;
+	generic_handle_irq(irq);
+}
+
+void __init init_IRQ(void)
+{
+	unsigned int irq, bank;
+
+	isp = ioremap(ISP_BASE, 0x1000);
+
+	for (bank = BANK_A; bank < NBANKS; bank++)
+		writeb(0xff, isp + imr_port[bank]);
+
+	for (irq = 0; irq < NR_IRQS; irq++)
+		if (vector_port[irq] >= 0)
+			writeb(irq, isp + vector_port[irq]);
+
+	for (bank = BANK_A; bank < NBANKS; bank++) {
+		writeb(0x1a, isp + cmd_port[bank]);	/* ICW1: level, single, no ICW4 */
+		writeb(0x08, isp + imr_port[bank]);	/* ICW2 */
+		readb(isp + icw2_port[bank]);		/* clears the IRQ1.5 request */
+		writeb(0x0b, isp + cmd_port[bank]);	/* OCW3: read ISR */
+		i82380_write_imr(bank);
+	}
+
+	for (irq = 0; irq < NR_IRQS; irq++) {
+		if ((irq == CASCADE_LINE) || (irq == 8 + CASCADE_LINE))
+			continue;
+		irq_set_chip_and_handler(irq, &i82380_chip, handle_level_irq);
+	}
+
+	set_handle_irq(i82380_handle_irq);
+}
diff --git a/arch/i860/kernel/process.c b/arch/i860/kernel/process.c
new file mode 100644
index 000000000000..0ee65f98be7b
--- /dev/null
+++ b/arch/i860/kernel/process.c
@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#include <linux/entry-common.h>
+#include <linux/pm.h>
+#include <linux/ptrace.h>
+#include <linux/reboot.h>
+#include <linux/sched.h>
+#include <linux/sched/debug.h>
+#include <linux/sched/task.h>
+#include <linux/sched/task_stack.h>
+#include <linux/uaccess.h>
+#include <asm/i860.h>
+#include <asm/traps.h>
+
+void (*pm_power_off)(void);
+EXPORT_SYMBOL(pm_power_off);
+
+/* Layout of the frame __switch_to pops (entry.S SW_SIZE). */
+struct switch_frame {
+	unsigned long r1, fp;
+	unsigned long r4_r15[12];
+	unsigned long f2_f7[6];
+};
+
+asmlinkage void ret_from_fork(void);
+
+asmlinkage void i860_ret_from_fork(struct task_struct *prev,
+				   struct pt_regs *regs,
+				   int (*fn)(void *), void *fn_arg)
+{
+	schedule_tail(prev);
+	if (unlikely(fn)) {
+		fn(fn_arg);
+		/* kernel_execve() succeeded: return to the new user image */
+	}
+	syscall_exit_to_user_mode(regs);
+}
+
+int copy_thread(struct task_struct *p, const struct kernel_clone_args *args)
+{
+	unsigned long clone_flags = args->flags;
+	unsigned long usp = args->stack;
+	struct pt_regs *childregs = task_pt_regs(p);
+	struct switch_frame *sw = (struct switch_frame *)childregs - 1;
+
+	memset(sw, 0, sizeof(*sw));
+	sw->r1 = (unsigned long)ret_from_fork;
+
+	if (unlikely(args->fn)) {
+		memset(childregs, 0, sizeof(*childregs));
+		childregs->user.psr = PSR_IT;
+		sw->r4_r15[0] = (unsigned long)args->fn;
+		sw->r4_r15[1] = (unsigned long)args->fn_arg;
+	} else {
+		*childregs = *current_pt_regs();
+		childregs->user.gpr[16] = 0;
+		if (usp)
+			childregs->user.gpr[2] = usp;
+		if (clone_flags & CLONE_SETTLS)
+			childregs->user.gpr[I860_TP_REG] = args->tls;
+	}
+
+	p->thread.ksp = (unsigned long)sw;
+	return 0;
+}
+
+void start_thread(struct pt_regs *regs, unsigned long pc, unsigned long sp)
+{
+	memset(regs, 0, sizeof(*regs));
+	/* return from a trap into user mode with interrupts on */
+	regs->user.psr = PSR_IT | PSR_PU | PSR_PIM;
+	regs->user.fir = pc;
+	/* FP traps for IEEE results with gradual underflow, round to nearest */
+	regs->user.fsr = FSR_FTE;
+	regs->user.gpr[2] = sp;
+}
+
+void flush_thread(void)
+{
+}
+
+unsigned long __get_wchan(struct task_struct *p)
+{
+	unsigned long fp, pc;
+	int count = 0;
+
+	fp = ((struct switch_frame *)p->thread.ksp)->fp;
+	do {
+		if (fp < (unsigned long)task_stack_page(p) ||
+		    fp >= (unsigned long)task_stack_page(p) + THREAD_SIZE - 8)
+			return 0;
+		pc = ((unsigned long *)fp)[1];
+		if (!in_sched_functions(pc))
+			return pc;
+		fp = ((unsigned long *)fp)[0];
+	} while (count++ < 16);
+	return 0;
+}
+
+void arch_cpu_idle(void)
+{
+	unsigned long seq = READ_ONCE(i860_irq_seq), tmp;
+
+	raw_local_irq_enable();
+	/* no halt instruction: wait for an interrupt to have run */
+	asm volatile("1:	ld.l	0(%1),%0\n"
+		     "	bte	%0,%2,1b"
+		     : "=&r" (tmp) : "r" (&i860_irq_seq), "r" (seq));
+}
+
+void machine_restart(char *cmd)
+{
+	local_irq_disable();
+	pr_emerg("System restart not supported, halting\n");
+	for (;;)
+		;
+}
+
+void machine_halt(void)
+{
+	local_irq_disable();
+	for (;;)
+		;
+}
+
+void machine_power_off(void)
+{
+	if (pm_power_off)
+		pm_power_off();
+	machine_halt();
+}
diff --git a/arch/i860/kernel/ptrace.c b/arch/i860/kernel/ptrace.c
new file mode 100644
index 000000000000..44f939c298b0
--- /dev/null
+++ b/arch/i860/kernel/ptrace.c
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#include <linux/ptrace.h>
+#include <linux/regset.h>
+#include <linux/sched.h>
+#include <linux/sched/task_stack.h>
+#include <linux/elf.h>
+
+enum i860_regset {
+	REGSET_GPR,
+};
+
+static int gpr_get(struct task_struct *target,
+		   const struct user_regset *regset, struct membuf to)
+{
+	return membuf_write(&to, &task_pt_regs(target)->user,
+			    sizeof(struct user_regs_struct));
+}
+
+static int gpr_set(struct task_struct *target,
+		   const struct user_regset *regset, unsigned int pos,
+		   unsigned int count, const void *kbuf, const void __user *ubuf)
+{
+	struct pt_regs *regs = task_pt_regs(target);
+	struct user_regs_struct uregs = regs->user;
+	int ret;
+
+	ret = user_regset_copyin(&pos, &count, &kbuf, &ubuf, &uregs, 0,
+				 sizeof(uregs));
+	if (ret)
+		return ret;
+	/* the trap state in psr stays under kernel control */
+	memcpy(regs->user.gpr, uregs.gpr, sizeof(uregs.gpr));
+	memcpy(regs->user.fpr, uregs.fpr, sizeof(uregs.fpr));
+	regs->user.gpr[0] = 0;
+	regs->user.fir = uregs.fir;
+	regs->user.fsr = uregs.fsr;
+	return 0;
+}
+
+static const struct user_regset i860_regsets[] = {
+	[REGSET_GPR] = {
+		USER_REGSET_NOTE_TYPE(PRSTATUS),
+		.n = ELF_NGREG,
+		.size = sizeof(elf_greg_t),
+		.align = sizeof(elf_greg_t),
+		.regset_get = gpr_get,
+		.set = gpr_set,
+	},
+};
+
+static const struct user_regset_view user_i860_view = {
+	.name = "i860",
+	.e_machine = EM_860,
+	.regsets = i860_regsets,
+	.n = ARRAY_SIZE(i860_regsets),
+};
+
+const struct user_regset_view *task_user_regset_view(struct task_struct *task)
+{
+	return &user_i860_view;
+}
+
+void ptrace_disable(struct task_struct *child)
+{
+}
+
+long arch_ptrace(struct task_struct *child, long request, unsigned long addr,
+		 unsigned long data)
+{
+	return ptrace_request(child, request, addr, data);
+}
diff --git a/arch/i860/kernel/setup.c b/arch/i860/kernel/setup.c
new file mode 100644
index 000000000000..ab2295fd4975
--- /dev/null
+++ b/arch/i860/kernel/setup.c
@@ -0,0 +1,268 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung i860 MAGIC Station II setup.
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/console.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/memblock.h>
+#include <linux/of_fdt.h>
+#include <linux/platform_data/rtc-msm6242.h>
+#include <linux/platform_data/simplefb.h>
+#include <linux/platform_device.h>
+#include <linux/sched/task.h>
+#include <linux/seq_file.h>
+#include <linux/serial_8250.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+#include <asm/i860.h>
+#include <asm/io.h>
+#include <asm/sections.h>
+#include <asm/setup.h>
+#include <asm/traps.h>
+
+unsigned long i860_pfn_offset;
+
+/* Firmware page tables, data, stack and code; unused once we own the MMU. */
+#define I860_FW_START	0xfffae000UL
+
+#define NVRAM_MEMSIZE	0x1f000000UL	/* reset code: 1/2/4/8 = 8/16/32/64 MB */
+
+/*
+ * DRAM ends at 4 GB. The last page (trap vector) is left out of memblock
+ * so that no memory range or high_memory wraps to 0.
+ */
+static void __init i860_add_bank(unsigned long base, unsigned long size)
+{
+	if (base + (size - 1) == ~0UL)
+		size -= PAGE_SIZE;
+	memblock_add(base, size);
+}
+
+static void __init i860_add_memory(void)
+{
+	u8 code = *(volatile u8 *)NVRAM_MEMSIZE & 0x0f;
+	int i;
+
+	switch (code) {
+	case 1:
+		i860_add_bank(0xff800000, SZ_8M);
+		break;
+	case 2:
+		i860_add_bank(0xff000000, SZ_16M);
+		break;
+	case 4:
+		/* large modules in bank H only: A23 = 1 */
+		for (i = 0; i < 4; i++)
+			i860_add_bank(0xfc800000 + i * SZ_16M, SZ_8M);
+		break;
+	case 8:
+		i860_add_bank(0xfc000000, SZ_64M);
+		break;
+	default:
+		pr_warn("NVRAM memory size code %x unknown, assuming 8 MB\n",
+			code);
+		i860_add_bank(0xff800000, SZ_8M);
+		break;
+	}
+}
+
+void __init arch_zone_limits_init(unsigned long *max_zone_pfns)
+{
+	max_zone_pfns[ZONE_NORMAL] = max_low_pfn;
+}
+
+void __init setup_arch(char **cmdline_p)
+{
+	i860_trap_init();
+	i860_early_console_init();
+
+	strscpy(boot_command_line, CONFIG_CMDLINE, COMMAND_LINE_SIZE);
+	*cmdline_p = boot_command_line;
+
+	setup_initial_init_mm(_stext, _etext, _edata, _end);
+
+	i860_add_memory();
+	memblock_reserve(__pa_symbol(_text), _end - _text);
+	memblock_reserve(I860_FW_START, I860_TRAP_PAGE - I860_FW_START);
+
+	parse_early_param();
+	memblock_allow_resize();
+
+	min_low_pfn = PFN_UP(memblock_start_of_DRAM());
+	max_low_pfn = max_pfn = PFN_DOWN(memblock_end_of_DRAM());
+	i860_pfn_offset = min_low_pfn;
+
+	paging_init();
+	i860_early_console_init();
+
+	/* the firmware wrote cached data there; write it back first */
+	i860_flush_dcache_all();
+	memblock_phys_free(I860_FW_START, I860_TRAP_PAGE - I860_FW_START);
+
+	memblock_dump_all();
+}
+
+static struct plat_serial8250_port i860_uart_data[] = {
+	{
+		.mapbase	= 0x1e000600,
+		.membase	= I860_IO(0x1e000600),
+		.irq		= 19,
+		.uartclk	= 1843200,
+		.regshift	= 3,
+		.iotype		= UPIO_MEM,
+		.flags		= UPF_BOOT_AUTOCONF | UPF_SKIP_TEST,
+	},
+	{
+		.mapbase	= 0x1e000700,
+		.membase	= I860_IO(0x1e000700),
+		.uartclk	= 1843200,
+		.regshift	= 3,
+		.iotype		= UPIO_MEM,
+		.flags		= UPF_BOOT_AUTOCONF | UPF_SKIP_TEST,
+	},
+	{ },
+};
+
+static struct platform_device i860_uart = {
+	.name	= "serial8250",
+	.id	= PLAT8250_DEV_PLATFORM,
+	.dev	= {
+		.platform_data	= i860_uart_data,
+	},
+};
+
+/* MSM6242-type RTC: one nibble register per 8 bytes */
+static struct resource i860_rtc_res[] = {
+	DEFINE_RES_MEM(0x1e000000, 0x80),
+};
+
+static struct msm6242_platform_data i860_rtc_data = {
+	.reg_shift	= 1,
+};
+
+static struct resource i860_scsi_res[] = {
+	DEFINE_RES_MEM(0x1c000a00, 0x10),
+	DEFINE_RES_IRQ(13),
+};
+
+/* 82596 registers, NVRAM MAC address (one byte per 8 bytes), IRQ */
+static struct resource i860_lan_res[] = {
+	DEFINE_RES_MEM(0x1c000e00, 0x20),
+	DEFINE_RES_MEM(0x1f008000, 0x30),
+	DEFINE_RES_IRQ(14),
+};
+
+/*
+ * Frame buffer: 32 bpp at physical 0, 2048-pixel pitch, 1280 x 1024 shown
+ * (the firmware programs the TMS34020 timing). Each byte lane goes through
+ * its own Bt459 palette: byte 0 red, 1 green, 2 blue.
+ */
+#define I860_FB_PHYS		0x00000000
+#define I860_FB_SIZE		0x00800000
+#define I860_RAMDAC_PHYS	0x04000000
+#define BT459_ADDR_LO		0x00
+#define BT459_ADDR_HI		0x10
+#define BT459_PALETTE		0x30
+
+static struct resource i860_fb_res[] = {
+	DEFINE_RES_MEM(I860_FB_PHYS, I860_FB_SIZE),
+};
+
+static struct simplefb_platform_data i860_fb_data = {
+	.width	= 1280,
+	.height	= 1024,
+	.stride	= 2048 * 4,
+	.format	= "x8b8g8r8",
+};
+
+/* identity palettes in all four RAMDACs: 32-bit writes reach every lane */
+static int __init i860_ramdac_init(void)
+{
+	void __iomem *dac = ioremap(I860_RAMDAC_PHYS, 0x40);
+	unsigned int i;
+
+	if (!dac)
+		return -ENOMEM;
+	writel(0, dac + BT459_ADDR_LO);
+	writel(0, dac + BT459_ADDR_HI);
+	for (i = 0; i < 256; i++) {
+		writel(i * 0x01010101, dac + BT459_PALETTE);
+		writel(i * 0x01010101, dac + BT459_PALETTE);
+		writel(i * 0x01010101, dac + BT459_PALETTE);
+	}
+	iounmap(dac);
+	return 0;
+}
+
+static int __init i860_devices_init(void)
+{
+	struct platform_device *pdev;
+
+	platform_device_register(&i860_uart);
+
+	pdev = platform_device_register_resndata(NULL, "rtc-msm6242", -1,
+			i860_rtc_res, ARRAY_SIZE(i860_rtc_res),
+			&i860_rtc_data, sizeof(i860_rtc_data));
+	if (IS_ERR(pdev))
+		pr_err("RTC registration failed\n");
+
+	pdev = platform_device_register_simple("magicst2-scsi", -1,
+			i860_scsi_res, ARRAY_SIZE(i860_scsi_res));
+	if (IS_ERR(pdev))
+		pr_err("SCSI registration failed\n");
+
+	pdev = platform_device_register_simple("magicst2-82596", -1,
+			i860_lan_res, ARRAY_SIZE(i860_lan_res));
+	if (IS_ERR(pdev))
+		pr_err("LAN registration failed\n");
+
+	if (!i860_ramdac_init()) {
+		pdev = platform_device_register_resndata(NULL,
+				"simple-framebuffer", 0,
+				i860_fb_res, ARRAY_SIZE(i860_fb_res),
+				&i860_fb_data, sizeof(i860_fb_data));
+		if (IS_ERR(pdev))
+			pr_err("frame buffer registration failed\n");
+	}
+	return 0;
+}
+arch_initcall(i860_devices_init);
+
+static int show_cpuinfo(struct seq_file *m, void *v)
+{
+	unsigned long epsr = i860_ld_c(epsr);
+
+	seq_printf(m, "cpu\t\t: Intel i860%s\n",
+		   (epsr & EPSR_TYPE) == EPSR_TYPE_XP ? "XP" : "XR");
+	seq_printf(m, "epsr\t\t: %08lx\n", epsr);
+	seq_printf(m, "machine\t\t: Samsung MAGIC Station II\n");
+	seq_printf(m, "BogoMIPS\t: %lu.%02lu\n",
+		   loops_per_jiffy / (500000 / HZ),
+		   (loops_per_jiffy / (5000 / HZ)) % 100);
+	return 0;
+}
+
+static void *c_start(struct seq_file *m, loff_t *pos)
+{
+	return *pos < 1 ? (void *)1 : NULL;
+}
+
+static void *c_next(struct seq_file *m, void *v, loff_t *pos)
+{
+	++*pos;
+	return NULL;
+}
+
+static void c_stop(struct seq_file *m, void *v)
+{
+}
+
+const struct seq_operations cpuinfo_op = {
+	.start	= c_start,
+	.next	= c_next,
+	.stop	= c_stop,
+	.show	= show_cpuinfo,
+};
diff --git a/arch/i860/kernel/signal.c b/arch/i860/kernel/signal.c
new file mode 100644
index 000000000000..5a1f55c52713
--- /dev/null
+++ b/arch/i860/kernel/signal.c
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#include <linux/entry-common.h>
+#include <linux/resume_user_mode.h>
+#include <linux/sched/signal.h>
+#include <linux/signal.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <asm/cacheflush.h>
+#include <asm/syscall.h>
+#include <asm/ucontext.h>
+#include <asm/unistd.h>
+
+struct rt_sigframe {
+	struct siginfo info;
+	struct ucontext uc;
+	u32 retcode[4];
+};
+
+/* Writable user registers; psr keeps the kernel controlled bits. */
+#define PSR_USER_MASK	(PSR_CC | PSR_KNF | PSR_LCC)
+
+static int restore_sigcontext(struct pt_regs *regs,
+			      struct sigcontext __user *sc)
+{
+	struct user_regs_struct uregs;
+
+	if (__copy_from_user(&uregs, &sc->regs, sizeof(uregs)))
+		return -EFAULT;
+
+	memcpy(regs->user.gpr, uregs.gpr, sizeof(uregs.gpr));
+	memcpy(regs->user.fpr, uregs.fpr, sizeof(uregs.fpr));
+	regs->user.gpr[0] = 0;
+	regs->user.fir = uregs.fir;
+	regs->user.fsr = uregs.fsr;
+	regs->user.psr = (regs->user.psr & ~PSR_USER_MASK) |
+			 (uregs.psr & PSR_USER_MASK);
+	regs->syscallno = -1;
+	return 0;
+}
+
+SYSCALL_DEFINE0(rt_sigreturn)
+{
+	struct pt_regs *regs = current_pt_regs();
+	struct rt_sigframe __user *frame;
+	sigset_t set;
+
+	current->restart_block.fn = do_no_restart_syscall;
+
+	frame = (struct rt_sigframe __user *)regs->user.gpr[2];
+	if (!access_ok(frame, sizeof(*frame)))
+		goto badframe;
+	if (__copy_from_user(&set, &frame->uc.uc_sigmask, sizeof(set)))
+		goto badframe;
+	set_current_blocked(&set);
+
+	if (restore_sigcontext(regs, &frame->uc.uc_mcontext))
+		goto badframe;
+	if (restore_altstack(&frame->uc.uc_stack))
+		goto badframe;
+
+	return regs->user.gpr[16];
+
+badframe:
+	force_sig(SIGSEGV);
+	return 0;
+}
+
+static int setup_rt_frame(struct ksignal *ksig, sigset_t *set,
+			  struct pt_regs *regs)
+{
+	struct rt_sigframe __user *frame;
+	unsigned long sp = sigsp(regs->user.gpr[2], ksig);
+	unsigned long ret;
+	int err = 0;
+
+	/* 16-byte aligned, below the interrupted frame */
+	frame = (struct rt_sigframe __user *)((sp - sizeof(*frame)) & ~15UL);
+	if (!access_ok(frame, sizeof(*frame)))
+		return -EFAULT;
+
+	if (ksig->ka.sa.sa_flags & SA_SIGINFO)
+		err |= copy_siginfo_to_user(&frame->info, &ksig->info);
+
+	err |= __put_user(0, &frame->uc.uc_flags);
+	err |= __put_user(NULL, &frame->uc.uc_link);
+	err |= __save_altstack(&frame->uc.uc_stack, regs->user.gpr[2]);
+	err |= __copy_to_user(&frame->uc.uc_mcontext.regs, &regs->user,
+			      sizeof(regs->user));
+	err |= __put_user(set->sig[0], &frame->uc.uc_mcontext.oldmask);
+	err |= __copy_to_user(&frame->uc.uc_sigmask, set, sizeof(*set));
+
+	if (ksig->ka.sa.sa_flags & SA_RESTORER) {
+		ret = (unsigned long)ksig->ka.sa.sa_restorer;
+	} else {
+		/* or __NR_rt_sigreturn,r0,r28; trap r0,r0,r0; nop; nop */
+		err |= __put_user(0xe41c0000 | __NR_rt_sigreturn,
+				  &frame->retcode[0]);
+		err |= __put_user(0x44000000, &frame->retcode[1]);
+		err |= __put_user(0xa0000000, &frame->retcode[2]);
+		err |= __put_user(0xa0000000, &frame->retcode[3]);
+		ret = (unsigned long)frame->retcode;
+		flush_icache_range(ret, ret + sizeof(frame->retcode));
+	}
+	if (err)
+		return -EFAULT;
+
+	regs->user.gpr[1] = ret;
+	regs->user.gpr[2] = (unsigned long)frame;
+	regs->user.gpr[16] = ksig->sig;
+	regs->user.gpr[17] = (unsigned long)&frame->info;
+	regs->user.gpr[18] = (unsigned long)&frame->uc;
+	regs->user.fir = (unsigned long)ksig->ka.sa.sa_handler;
+	/* a killed FP instruction is for the interrupted code, in the frame */
+	regs->user.psr &= ~PSR_KNF;
+	return 0;
+}
+
+void arch_do_signal_or_restart(struct pt_regs *regs)
+{
+	struct ksignal ksig;
+	bool in_syscall = regs->syscallno >= 0;
+	long ret = regs->user.gpr[16];
+
+	if (get_signal(&ksig)) {
+		if (in_syscall) {
+			switch (ret) {
+			case -ERESTART_RESTARTBLOCK:
+			case -ERESTARTNOHAND:
+				regs->user.gpr[16] = -EINTR;
+				break;
+			case -ERESTARTSYS:
+				if (!(ksig.ka.sa.sa_flags & SA_RESTART)) {
+					regs->user.gpr[16] = -EINTR;
+					break;
+				}
+				fallthrough;
+			case -ERESTARTNOINTR:
+				regs->user.gpr[16] = regs->orig_r16;
+				regs->user.fir -= 4;
+				break;
+			}
+			regs->syscallno = -1;
+		}
+		signal_setup_done(setup_rt_frame(&ksig, sigmask_to_save(), regs),
+				  &ksig, 0);
+		return;
+	}
+
+	if (in_syscall) {
+		switch (ret) {
+		case -ERESTARTNOHAND:
+		case -ERESTARTSYS:
+		case -ERESTARTNOINTR:
+			regs->user.gpr[16] = regs->orig_r16;
+			regs->user.fir -= 4;
+			break;
+		case -ERESTART_RESTARTBLOCK:
+			regs->user.gpr[16] = regs->orig_r16;
+			regs->user.gpr[I860_SYSCALL_NR_REG] = __NR_restart_syscall;
+			regs->user.fir -= 4;
+			break;
+		}
+		regs->syscallno = -1;
+	}
+
+	restore_saved_sigmask();
+}
diff --git a/arch/i860/kernel/syscall_table.c b/arch/i860/kernel/syscall_table.c
new file mode 100644
index 000000000000..11d38f5a6f92
--- /dev/null
+++ b/arch/i860/kernel/syscall_table.c
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#include <linux/syscalls.h>
+#include <linux/unistd.h>
+#include <asm/syscall.h>
+#include <asm/syscalls.h>
+
+#define __SYSCALL(nr, call) [nr] = (call),
+#define __SYSCALL_WITH_COMPAT(nr, native, compat) __SYSCALL(nr, native)
+
+#define sys_mmap2 sys_mmap_pgoff
+
+void * const sys_call_table[__NR_syscalls] = {
+	[0 ... __NR_syscalls - 1] = sys_ni_syscall,
+#include <asm/syscall_table_32.h>
+};
diff --git a/arch/i860/kernel/time.c b/arch/i860/kernel/time.c
new file mode 100644
index 000000000000..b87094143c59
--- /dev/null
+++ b/arch/i860/kernel/time.c
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * 82380 counter 0 (499.2 kHz, inferred from the Stardent kernel) drives
+ * IRQ8 through an edge-detect flip-flop, for clock events. Counter 3 runs
+ * free as the clocksource: its output goes to IRQ0, which stays masked. Its
+ * 16 bits wrap every 131 ms, and printing to the serial console can hold off
+ * interrupts for longer, so the count is extended in software on every read.
+ * Time then only loses a wrap, it cannot get stuck inside one. No NO_HZ: the
+ * i860 has no halt, idle spins anyway.
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/clockchips.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/sched_clock.h>
+#include <linux/time.h>
+
+#define PIT_COUNTER0	0x080
+#define PIT_COUNTER3	0x088
+#define PIT_CONTROL	0x680
+#define PIT_CONTROL2	0x688
+#define PIT_PORT61	0x2c0	/* write only: D6 gates counter 3 */
+#define PIT_IRQ		8
+#define PIT_CLOCK	499200
+
+static void __iomem *pit;
+
+static int pit_set_periodic(struct clock_event_device *evt)
+{
+	unsigned int count = DIV_ROUND_CLOSEST(PIT_CLOCK, HZ);
+
+	writeb(0x34, pit + PIT_CONTROL);	/* counter 0, LSB/MSB, mode 2 */
+	writeb(count & 0xff, pit + PIT_COUNTER0);
+	writeb(count >> 8, pit + PIT_COUNTER0);
+	return 0;
+}
+
+static int pit_set_oneshot(struct clock_event_device *evt)
+{
+	/* mode 4: a pulse, so every expiry gives the edge that IRQ8 detects */
+	writeb(0x38, pit + PIT_CONTROL);
+	return 0;
+}
+
+static int pit_next_event(unsigned long delta, struct clock_event_device *evt)
+{
+	writeb(delta & 0xff, pit + PIT_COUNTER0);
+	writeb(delta >> 8, pit + PIT_COUNTER0);
+	return 0;
+}
+
+static int pit_shutdown(struct clock_event_device *evt)
+{
+	writeb(0x30, pit + PIT_CONTROL);	/* mode 0, no count: idle */
+	return 0;
+}
+
+static struct clock_event_device pit_clockevent = {
+	.name			= "82380",
+	.features		= CLOCK_EVT_FEAT_PERIODIC | CLOCK_EVT_FEAT_ONESHOT,
+	.rating			= 200,
+	.set_state_periodic	= pit_set_periodic,
+	.set_state_oneshot	= pit_set_oneshot,
+	.set_next_event		= pit_next_event,
+	.set_state_shutdown	= pit_shutdown,
+	.tick_resume		= pit_set_periodic,
+};
+
+static irqreturn_t pit_interrupt(int irq, void *dev_id)
+{
+	struct clock_event_device *evt = dev_id;
+
+	evt->event_handler(evt);
+	return IRQ_HANDLED;
+}
+
+/* Two byte reads and the extension: nothing may read the counter in between. */
+static notrace u64 pit_count(void)
+{
+	static u64 total;
+	static u16 last;
+	unsigned long flags;
+	unsigned int count;
+	u16 now;
+
+	local_irq_save(flags);
+	writeb(0x00, pit + PIT_CONTROL2);	/* latch counter 3 */
+	count = readb(pit + PIT_COUNTER3);
+	count |= readb(pit + PIT_COUNTER3) << 8;
+	now = -count;
+	total += (u16)(now - last);
+	last = now;
+	local_irq_restore(flags);
+	return total;
+}
+
+static u64 pit_clocksource_read(struct clocksource *cs)
+{
+	return pit_count();
+}
+
+static struct clocksource pit_clocksource = {
+	.name	= "82380",
+	.rating	= 300,
+	.read	= pit_clocksource_read,
+	.mask	= CLOCKSOURCE_MASK(64),
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+};
+
+void __init time_init(void)
+{
+	pit = ioremap(0x1c000000, 0x1000);
+
+	writeb(0x34, pit + PIT_CONTROL2);	/* counter 3: LSB/MSB, mode 2 */
+	writeb(0, pit + PIT_COUNTER3);		/* the full 16 bits */
+	writeb(0, pit + PIT_COUNTER3);
+	writeb(0x40, pit + PIT_PORT61);		/* gate it, leave the speaker off */
+	clocksource_register_hz(&pit_clocksource, PIT_CLOCK);
+	sched_clock_register(pit_count, 64, PIT_CLOCK);
+
+	pit_clockevent.cpumask = cpumask_of(0);
+	/* half a wrap at most, so that a wait cannot hide one from the extension */
+	clockevents_config_and_register(&pit_clockevent, PIT_CLOCK, 0x10, 0x7fff);
+
+	if (request_irq(PIT_IRQ, pit_interrupt, IRQF_TIMER, "timer",
+			&pit_clockevent))
+		pr_err("82380: cannot request timer IRQ\n");
+}
diff --git a/arch/i860/kernel/traps.c b/arch/i860/kernel/traps.c
new file mode 100644
index 000000000000..dc650da7fa2c
--- /dev/null
+++ b/arch/i860/kernel/traps.c
@@ -0,0 +1,403 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * i860 trap dispatch. The CPU has a single trap vector; the cause is in
+ * the saved psr. The i860 reports no fault address, so data access traps
+ * decode the faulting load or store.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/entry-common.h>
+#include <linux/extable.h>
+#include <linux/irq.h>
+#include <linux/kdebug.h>
+#include <linux/nospec.h>
+#include <linux/ptrace.h>
+#include <linux/sched/debug.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/task_stack.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <asm/cacheflush.h>
+#include <asm/i860.h>
+#include <asm/syscall.h>
+#include <asm/traps.h>
+
+typedef long (*syscall_fn_t)(unsigned long, unsigned long, unsigned long,
+			     unsigned long, unsigned long, unsigned long);
+
+static inline unsigned long reg(struct pt_regs *regs, unsigned int n)
+{
+	return n ? regs->user.gpr[n] : 0;
+}
+
+void show_regs(struct pt_regs *regs)
+{
+	int i;
+
+	show_regs_print_info(KERN_DEFAULT);
+	pr_info("fir %08lx psr %08lx epsr %08lx fsr %08lx\n",
+		regs->user.fir, regs->user.psr, regs->user.epsr,
+		regs->user.fsr);
+	for (i = 0; i < 32; i += 4)
+		pr_info("r%-2d %08lx %08lx %08lx %08lx\n", i, reg(regs, i),
+			regs->user.gpr[i + 1], regs->user.gpr[i + 2],
+			regs->user.gpr[i + 3]);
+}
+
+void die(const char *str, struct pt_regs *regs, long err)
+{
+	console_verbose();
+	pr_emerg("%s: %04lx\n", str, err & 0xffff);
+	show_regs(regs);
+	if (!user_mode(regs))
+		show_stack(NULL, (unsigned long *)regs->user.gpr[2], KERN_EMERG);
+	make_task_dead(SIGSEGV);
+}
+
+/* Effective address and direction of the load/store at fir. */
+bool i860_decode_access(struct pt_regs *regs, u32 insn, unsigned long *addr,
+			unsigned int *size, bool *write)
+{
+	unsigned int op = insn >> 26;
+	unsigned int src1 = (insn >> 11) & 31;
+	unsigned int src2 = (insn >> 21) & 31;
+	bool imm = insn & 0x04000000;
+	long off = (s16)insn;
+	static const unsigned char fsizes[4] = { 8, 4, 16, 4 };
+
+	switch (op) {
+	case 0x00: case 0x01: case 0x04: case 0x05:	/* ld.{b,s,l} */
+		*size = (op & 4) ? ((insn & 1) ? 4 : 2) : 1;
+		*write = false;
+		break;
+	case 0x03: case 0x07:				/* st.{b,s,l} */
+		*size = (op & 4) ? ((insn & 1) ? 4 : 2) : 1;
+		off = (s16)(((insn >> 5) & 0xf800) | (insn & 0x7ff));
+		*write = true;
+		break;
+	case 0x08: case 0x09: case 0x18: case 0x19:	/* fld, pfld */
+		*size = fsizes[(insn >> 1) & 3];
+		*write = false;
+		break;
+	case 0x0a: case 0x0b:				/* fst */
+		*size = fsizes[(insn >> 1) & 3];
+		*write = true;
+		break;
+	case 0x0f:					/* pst.d */
+		*size = 8;
+		*write = true;
+		break;
+	case 0x0d:					/* flush */
+		*size = 32;
+		*write = false;
+		break;
+	default:
+		return false;
+	}
+
+	if (imm || op == 0x03 || op == 0x07 || op == 0x0f || op == 0x0d)
+		*addr = (off & ~(long)(*size - 1)) + reg(regs, src2);
+	else
+		*addr = reg(regs, src1) + reg(regs, src2);
+	return true;
+}
+
+static bool i860_get_insn(struct pt_regs *regs, unsigned long pc, u32 *insn)
+{
+	if (user_mode(regs))
+		return !get_user(*insn, (u32 __user *)pc);
+	return !get_kernel_nofault(*insn, (u32 *)pc);
+}
+
+/*
+ * A faulting instruction in a branch delay slot leaves fir at the slot;
+ * resume at the branch so that it is taken again. bla must also have its
+ * increment undone.
+ */
+static void i860_fixup_delay_slot(struct pt_regs *regs)
+{
+	unsigned long pc = regs->user.fir - 4;
+	unsigned int op;
+	u32 insn;
+
+	if (!i860_get_insn(regs, pc, &insn))
+		return;
+
+	op = insn >> 26;
+	switch (op) {
+	case 0x2d: {					/* bla */
+		unsigned int src1 = (insn >> 11) & 31;
+		unsigned int src2 = (insn >> 21) & 31;
+
+		if (src2)
+			regs->user.gpr[src2] -= reg(regs, src1);
+		break;
+	}
+	case 0x10: case 0x1a: case 0x1b: case 0x1d: case 0x1f:
+		break;
+	case 0x13:					/* core escape */
+		if ((insn & 0x1f) != 2)			/* calli */
+			return;
+		break;
+	default:
+		return;
+	}
+	regs->user.fir = pc;
+	regs->user.psr &= ~PSR_DIM;
+}
+
+#define I860_INSN_LOCK	0x4c000001	/* core escape 1 */
+#define I860_INSN_TRAP	0x44000000	/* trap r0,r0,r0 */
+#define I860_INSN_BREAK	0x44010000	/* trap r0,r0,r1 */
+#define I860_LOCK_MAX	32		/* instructions inside lock/unlock */
+
+/*
+ * A trap inside a lock/unlock sequence (EPSR.IL) broke the bus lock:
+ * resume at the lock instruction so that the sequence runs again as a
+ * whole, e.g. the load and store of a compare-and-swap.
+ */
+static bool i860_lock_restart(struct pt_regs *regs)
+{
+	unsigned long pc = regs->user.fir;
+	u32 insn;
+	int i;
+
+	if (!(regs->user.epsr & EPSR_IL))
+		return false;
+	/* the sequence, its lock and unlock and the access after the unlock */
+	for (i = 0; i < I860_LOCK_MAX + 3; i++, pc -= 4) {
+		if (!i860_get_insn(regs, pc, &insn))
+			break;
+		if (insn == I860_INSN_LOCK) {
+			regs->user.fir = pc;
+			return true;
+		}
+	}
+	return false;
+}
+
+static void i860_syscall(struct pt_regs *regs)
+{
+	long nr = regs->user.gpr[I860_SYSCALL_NR_REG];
+
+	regs->user.fir += 4;
+	regs->orig_r16 = regs->user.gpr[16];
+	regs->syscallno = nr;
+	regs->user.gpr[16] = -ENOSYS;
+
+	if (likely(syscall_enter_from_user_mode_randomize_stack(regs, &nr)) &&
+	    nr >= 0 && nr < NR_syscalls) {
+		syscall_fn_t fn;
+
+		fn = sys_call_table[array_index_nospec(nr, NR_syscalls)];
+		regs->user.gpr[16] = fn(regs->orig_r16, regs->user.gpr[17],
+					regs->user.gpr[18], regs->user.gpr[19],
+					regs->user.gpr[20], regs->user.gpr[21]);
+	}
+	syscall_exit_to_user_mode(regs);
+}
+
+static void i860_trap_insn(struct pt_regs *regs)
+{
+	u32 insn = 0;
+
+	/* IT with EPSR.IL: a lock sequence ran past its 32 instructions */
+	if (user_mode(regs) && (regs->user.epsr & EPSR_IL)) {
+		irqentry_enter_from_user_mode(regs);
+		force_sig_fault(SIGILL, ILL_ILLOPN, (void __user *)regs->user.fir);
+		irqentry_exit_to_user_mode(regs);
+		return;
+	}
+	/* only a traced process has breakpoints: others save the read of the insn */
+	if (user_mode(regs) && unlikely(current->ptrace) &&
+	    i860_get_insn(regs, regs->user.fir, &insn) && insn == I860_INSN_BREAK) {
+		irqentry_enter_from_user_mode(regs);
+		force_sig_fault(SIGTRAP, TRAP_BRKPT, (void __user *)regs->user.fir);
+		irqentry_exit_to_user_mode(regs);
+		return;
+	}
+	if (user_mode(regs)) {
+		i860_syscall(regs);
+		return;
+	}
+	i860_get_insn(regs, regs->user.fir, &insn);
+	die("kernel trap instruction", regs, insn);
+}
+
+static void i860_access_trap(struct pt_regs *regs, bool fetch)
+{
+	irqentry_state_t state = irqentry_enter(regs);
+	unsigned long fault_pc = regs->user.fir;
+	unsigned long addr = fault_pc;
+	unsigned int size = 4;
+	bool write = false;
+	bool restart = i860_lock_restart(regs);
+	u32 insn;
+
+	/* no lock to go back to: continuing would silently lose atomicity */
+	if (user_mode(regs) && (regs->user.epsr & EPSR_IL) && !restart) {
+		force_sig_fault(SIGILL, ILL_ILLOPN, (void __user *)fault_pc);
+		goto out;
+	}
+	if (!fetch) {
+		if (!i860_get_insn(regs, fault_pc, &insn) ||
+		    !i860_decode_access(regs, insn, &addr, &size, &write)) {
+			if (user_mode(regs))
+				force_sig_fault(SIGILL, ILL_ILLOPC,
+						(void __user *)regs->user.fir);
+			else
+				die("data access trap at unknown instruction",
+				    regs, 0);
+			goto out;
+		}
+		if (addr & (size - 1)) {
+			if (user_mode(regs))
+				force_sig_fault(SIGBUS, BUS_ADRALN,
+						(void __user *)addr);
+			else if (!fixup_exception(regs))
+				die("unaligned kernel access", regs, addr);
+			goto out;
+		}
+	}
+	/* also for a fetch: the page of the slot may be the one that faulted */
+	if (!restart)
+		i860_fixup_delay_slot(regs);
+	i860_do_page_fault(regs, addr, write, fetch);
+out:
+	local_irq_disable();
+	irqentry_exit(regs, state);
+}
+
+/*
+ * A source exception, or only a result exception that is already handled. A
+ * compare in the delay slot of bc.t or bnc.t would change the CC that the branch
+ * tests when rerun: it was taken, or the slot would not run, so go to its target.
+ */
+static void i860_fp_trap(struct pt_regs *regs)
+{
+	irqentry_state_t state = irqentry_enter(regs);
+	unsigned long fir = regs->user.fir;
+	u32 insn, prev = 0;
+
+	if (!user_mode(regs)) {
+		die("kernel floating point trap", regs, regs->user.fsr);
+	} else if (!(regs->user.fsr & FSR_SE)) {
+		/* the result exception was handled on entry */
+	} else if (!i860_get_insn(regs, fir, &insn)) {
+		force_sig_fault(SIGFPE, FPE_FLTINV, (void __user *)fir);
+	} else if (insn >> 26 != 0x12) {
+		regs->user.fsr &= ~FSR_SE;	/* stale */
+	} else if (regs->user.psr & PSR_DIM) {
+		force_sig_fault(SIGFPE, FPE_FLTINV, (void __user *)fir);
+	} else if (i860_fp_source(regs, insn)) {
+		force_sig_fault(SIGFPE, FPE_FLTINV, (void __user *)fir);
+	} else {
+		unsigned int op = insn & 0x7f;
+
+		regs->user.fsr &= ~FSR_SE;
+		i860_get_insn(regs, fir - 4, &prev);
+		if ((op == 0x34 || op == 0x35) &&
+		    (prev >> 26 == 0x1d || prev >> 26 == 0x1f)) {
+			/* lbroff: 26 bits of words from after the branch */
+			regs->user.fir = fir + (((s32)(prev << 6) >> 6) << 2);
+		} else {
+			regs->user.psr |= PSR_KNF;
+			i860_fixup_delay_slot(regs);
+		}
+	}
+	irqentry_exit(regs, state);
+}
+
+unsigned long i860_irq_seq;
+
+static void i860_interrupt(struct pt_regs *regs)
+{
+	irqentry_state_t state = irqentry_enter(regs);
+	struct pt_regs *old_regs;
+
+	WRITE_ONCE(i860_irq_seq, i860_irq_seq + 1);
+
+	/* in case hardware interrupts on a slot; SVR4 fixes up after every user trap */
+	pagefault_disable();
+	i860_fixup_delay_slot(regs);
+	pagefault_enable();
+	irq_enter_rcu();
+	old_regs = set_irq_regs(regs);
+	handle_arch_irq(regs);
+	set_irq_regs(old_regs);
+	irq_exit_rcu();
+	irqentry_exit(regs, state);
+}
+
+/*
+ * Several trap bits can be set at once. The interrupt line is level
+ * triggered, so a pending IN re-traps after the other cause is handled.
+ */
+asmlinkage void i860_handle_trap(struct pt_regs *regs)
+{
+	unsigned long psr = regs->user.psr;
+
+	regs->syscallno = -1;
+	/* the saved epsr keeps IL for the handlers; clear the live bit */
+	if (regs->user.epsr & EPSR_IL)
+		i860_st_c(epsr, i860_ld_c(epsr) & ~EPSR_IL);
+
+	/* before any other cause: it stays pending and its status is popped */
+	if (user_mode(regs) && i860_fp_result_pending(regs->user.fsr))
+		i860_fp_result(regs);
+
+	if (psr & PSR_IT)
+		i860_trap_insn(regs);
+	else if (psr & PSR_IAT)
+		i860_access_trap(regs, true);
+	else if (psr & PSR_DAT)
+		i860_access_trap(regs, false);
+	else if (psr & PSR_FT)
+		i860_fp_trap(regs);
+	else if (psr & PSR_IN)
+		i860_interrupt(regs);
+	else
+		die("trap without cause", regs, psr);
+}
+
+extern char i860_trap_vector[], i860_trap_vector_end[];
+
+void i860_set_kernel_stack(unsigned long top)
+{
+	*(volatile unsigned long *)(I860_TRAP_PAGE + PAGE_SIZE + SCR_KSP) = top;
+}
+
+/* Called first thing in setup_arch, while the firmware MMU set-up is live. */
+void __init i860_trap_init(void)
+{
+	size_t len = i860_trap_vector_end - i860_trap_vector;
+
+	BUG_ON(len > I860_TRAP_VECTOR_MAX);
+	i860_set_kernel_stack((unsigned long)task_stack_page(current) +
+			      THREAD_SIZE);
+	memcpy((void *)I860_TRAP_VECTOR, i860_trap_vector, len);
+	flush_icache_range(I860_TRAP_VECTOR, I860_TRAP_VECTOR + len);
+}
+
+void show_stack(struct task_struct *task, unsigned long *sp,
+		const char *loglvl)
+{
+	unsigned long fp, pc;
+	int depth = 0;
+
+	if (!task)
+		task = current;
+	if (task == current)
+		fp = (unsigned long)__builtin_frame_address(0);
+	else
+		fp = *(unsigned long *)(task->thread.ksp + 4);
+
+	printk("%sCall trace:\n", loglvl);
+	while (depth++ < 32 && fp &&
+	       object_is_on_stack((void *)fp) && !(fp & 3)) {
+		pc = ((unsigned long *)fp)[1];
+		printk("%s [<%08lx>] %pS\n", loglvl, pc, (void *)pc);
+		fp = ((unsigned long *)fp)[0];
+	}
+}
diff --git a/arch/i860/kernel/vmlinux.lds.S b/arch/i860/kernel/vmlinux.lds.S
new file mode 100644
index 000000000000..fa586436f5d8
--- /dev/null
+++ b/arch/i860/kernel/vmlinux.lds.S
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#include <asm/page.h>
+#include <asm-generic/vmlinux.lds.h>
+#include <asm/cache.h>
+#include <asm/thread_info.h>
+
+OUTPUT_FORMAT("elf32-i860-little", "elf32-i860", "elf32-i860-little")
+OUTPUT_ARCH(i860)
+ENTRY(_start)
+
+jiffies = jiffies_64;
+
+SECTIONS
+{
+	. = CONFIG_I860_KERNEL_BASE;
+
+	_text = .;
+	_stext = .;
+	HEAD_TEXT_SECTION
+	.text : {
+		TEXT_TEXT
+		SCHED_TEXT
+		LOCK_TEXT
+		IRQENTRY_TEXT
+		SOFTIRQENTRY_TEXT
+		KPROBES_TEXT
+		*(.fixup)
+	} =0
+	_etext = .;
+
+	EXCEPTION_TABLE(L1_CACHE_BYTES)
+
+	. = ALIGN(PAGE_SIZE);
+	__init_begin = .;
+	INIT_TEXT_SECTION(PAGE_SIZE)
+	INIT_DATA_SECTION(PAGE_SIZE)
+	PERCPU_SECTION(L1_CACHE_BYTES)
+	__init_end = .;
+
+	_sdata = .;
+	RO_DATA(PAGE_SIZE)
+	RW_DATA(L1_CACHE_BYTES, PAGE_SIZE, THREAD_SIZE)
+	_edata = .;
+
+	BSS_SECTION(0, PAGE_SIZE, 4)
+	_end = .;
+
+	STABS_DEBUG
+	DWARF_DEBUG
+	MODINFO
+	ELF_DETAILS
+
+	DISCARDS
+}
diff --git a/arch/i860/lib/Makefile b/arch/i860/lib/Makefile
new file mode 100644
index 000000000000..8b5d06907f39
--- /dev/null
+++ b/arch/i860/lib/Makefile
@@ -0,0 +1,6 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+#
+
+lib-y	:= usercopy.o delay.o memcpy.o memset.o
diff --git a/arch/i860/lib/delay.c b/arch/i860/lib/delay.c
new file mode 100644
index 000000000000..71185657dc64
--- /dev/null
+++ b/arch/i860/lib/delay.c
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#include <linux/delay.h>
+#include <linux/export.h>
+#include <linux/param.h>
+#include <linux/types.h>
+
+void __delay(unsigned long loops)
+{
+	if (!loops)
+		return;
+	asm volatile("1:\tadds -1,%0,%0\n\tbtne 0,%0,1b" : "+r" (loops));
+}
+EXPORT_SYMBOL(__delay);
+
+void __const_udelay(unsigned long xloops)
+{
+	u64 loops = (u64)xloops * loops_per_jiffy * HZ;
+
+	__delay(loops >> 32);
+}
+EXPORT_SYMBOL(__const_udelay);
+
+void __udelay(unsigned long usecs)
+{
+	__const_udelay(usecs * 0x10c7UL);
+}
+EXPORT_SYMBOL(__udelay);
+
+void __ndelay(unsigned long nsecs)
+{
+	__const_udelay(nsecs * 5UL);
+}
+EXPORT_SYMBOL(__ndelay);
diff --git a/arch/i860/lib/memcpy.S b/arch/i860/lib/memcpy.S
new file mode 100644
index 000000000000..d1b25cd38877
--- /dev/null
+++ b/arch/i860/lib/memcpy.S
@@ -0,0 +1,309 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * memcpy/memmove with 128-bit fld.q/fst.q transfers.
+ *
+ * Mutually 16-byte aligned buffers move in 64-byte blocks of four quad
+ * loads and stores, 8 or 4-byte aligned ones in 32-byte blocks of doublewords
+ * or words, and the others word wise with shifts. Only the caller-saved FP
+ * registers f8-f23 are used. No auto-increment
+ * addressing: every access can fault and be re-executed (vmalloc PDE
+ * sync).
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/linkage.h>
+
+	.text
+
+/* void *memcpy(void *dst = r16, const void *src = r17, size_t n = r18) */
+ENTRY(memcpy)
+	mov	%r16,%r19		/* r19 = d, r16 is returned */
+.Lfwd:
+	xor	%r19,%r17,%r20
+	subu	15,%r18,%r0		/* CC = n < 16 */
+	bc	.Lfsmall
+	and	15,%r20,%r0		/* CC = d, s equally aligned mod 16 */
+	bnc	.Lf8
+
+	/* bytes up to a 16-byte boundary */
+.Lfhead16:
+	and	15,%r19,%r0
+	bc	.Lfq
+	ld.b	0(%r17),%r20
+	st.b	%r20,0(%r19)
+	addu	1,%r17,%r17
+	addu	1,%r19,%r19
+	br	.Lfhead16
+	adds	-1,%r18,%r18
+
+.Lfq:
+	subu	63,%r18,%r0		/* CC = n < 64 */
+	bc	.Lfq16
+.Lfq64:
+	fld.q	0(%r17),%f8
+	fld.q	16(%r17),%f12
+	fld.q	32(%r17),%f16
+	fld.q	48(%r17),%f20
+	fst.q	%f8,0(%r19)
+	fst.q	%f12,16(%r19)
+	fst.q	%f16,32(%r19)
+	fst.q	%f20,48(%r19)
+	addu	64,%r17,%r17
+	addu	64,%r19,%r19
+	adds	-64,%r18,%r18
+	subu	63,%r18,%r0
+	bnc	.Lfq64
+.Lfq16:
+	subu	15,%r18,%r0
+	bc	.Lfbytes
+	fld.q	0(%r17),%f8
+	fst.q	%f8,0(%r19)
+	addu	16,%r17,%r17
+	addu	16,%r19,%r19
+	br	.Lfq16
+	adds	-16,%r18,%r18
+
+	/* doublewords */
+.Lf8:
+	and	7,%r20,%r0		/* CC = equally aligned mod 8 */
+	bnc	.Lf4
+.Lfhead8:
+	and	7,%r19,%r0
+	bc	.Lfd32
+	ld.b	0(%r17),%r20
+	st.b	%r20,0(%r19)
+	addu	1,%r17,%r17
+	addu	1,%r19,%r19
+	br	.Lfhead8
+	adds	-1,%r18,%r18
+.Lfd32:
+	subu	31,%r18,%r0		/* CC = n < 32 */
+	bc	.Lfd
+	fld.d	0(%r17),%f8
+	fld.d	8(%r17),%f10
+	fld.d	16(%r17),%f12
+	fld.d	24(%r17),%f14
+	fst.d	%f8,0(%r19)
+	fst.d	%f10,8(%r19)
+	fst.d	%f12,16(%r19)
+	fst.d	%f14,24(%r19)
+	addu	32,%r17,%r17
+	addu	32,%r19,%r19
+	br	.Lfd32
+	adds	-32,%r18,%r18
+.Lfd:
+	subu	7,%r18,%r0		/* CC = n < 8 */
+	bc	.Lfbytes
+	fld.d	0(%r17),%f8
+	fst.d	%f8,0(%r19)
+	addu	8,%r17,%r17
+	addu	8,%r19,%r19
+	br	.Lfd
+	adds	-8,%r18,%r18
+
+	/* words */
+.Lfsmall:
+	subu	3,%r18,%r0		/* CC = n < 4 */
+	bc	.Lfbytes
+.Lf4:
+	and	3,%r20,%r0		/* CC = equally aligned mod 4 */
+	bnc	.Lfmerge
+.Lfhead4:
+	and	3,%r19,%r0
+	bc	.Lfw32
+	ld.b	0(%r17),%r20
+	st.b	%r20,0(%r19)
+	addu	1,%r17,%r17
+	addu	1,%r19,%r19
+	br	.Lfhead4
+	adds	-1,%r18,%r18
+.Lfw32:
+	subu	31,%r18,%r0		/* CC = n < 32 */
+	bc	.Lfw
+	ld.l	0(%r17),%r20
+	ld.l	4(%r17),%r21
+	ld.l	8(%r17),%r22
+	ld.l	12(%r17),%r23
+	ld.l	16(%r17),%r24
+	ld.l	20(%r17),%r25
+	ld.l	24(%r17),%r26
+	ld.l	28(%r17),%r27
+	st.l	%r20,0(%r19)
+	st.l	%r21,4(%r19)
+	st.l	%r22,8(%r19)
+	st.l	%r23,12(%r19)
+	st.l	%r24,16(%r19)
+	st.l	%r25,20(%r19)
+	st.l	%r26,24(%r19)
+	st.l	%r27,28(%r19)
+	addu	32,%r17,%r17
+	addu	32,%r19,%r19
+	br	.Lfw32
+	adds	-32,%r18,%r18
+.Lfw:
+	subu	3,%r18,%r0		/* CC = n < 4 */
+	bc	.Lfbytes
+	ld.l	0(%r17),%r20
+	st.l	%r20,0(%r19)
+	addu	4,%r17,%r17
+	addu	4,%r19,%r19
+	br	.Lfw
+	adds	-4,%r18,%r18
+
+	/*
+	 * Different alignment mod 4: aligned words of the source, shifted into
+	 * place. Only words holding bytes to copy are read, so no fault past
+	 * the end of the source.
+	 */
+.Lfmerge:
+	subu	15,%r18,%r0		/* CC = n < 16 */
+	bc	.Lfbytes
+.Lfmhead:
+	and	3,%r19,%r0
+	bc	.Lfmgo
+	ld.b	0(%r17),%r20
+	st.b	%r20,0(%r19)
+	addu	1,%r17,%r17
+	addu	1,%r19,%r19
+	br	.Lfmhead
+	adds	-1,%r18,%r18
+.Lfmgo:
+	and	3,%r17,%r21
+	shl	3,%r21,%r21		/* bits to shift right */
+	or	32,%r0,%r22
+	subu	%r22,%r21,%r22		/* bits to shift left */
+	andnot	3,%r17,%r17
+	ld.l	0(%r17),%r20
+.Lfm16:
+	subu	15,%r18,%r0		/* CC = n < 16 */
+	bc	.Lfmend
+	ld.l	4(%r17),%r23
+	ld.l	8(%r17),%r24
+	ld.l	12(%r17),%r25
+	ld.l	16(%r17),%r26
+	shr	%r21,%r20,%r20
+	shl	%r22,%r23,%r27
+	or	%r27,%r20,%r20
+	st.l	%r20,0(%r19)
+	shr	%r21,%r23,%r23
+	shl	%r22,%r24,%r27
+	or	%r27,%r23,%r23
+	st.l	%r23,4(%r19)
+	shr	%r21,%r24,%r24
+	shl	%r22,%r25,%r27
+	or	%r27,%r24,%r24
+	st.l	%r24,8(%r19)
+	shr	%r21,%r25,%r25
+	shl	%r22,%r26,%r27
+	or	%r27,%r25,%r25
+	st.l	%r25,12(%r19)
+	mov	%r26,%r20
+	addu	16,%r17,%r17
+	addu	16,%r19,%r19
+	br	.Lfm16
+	adds	-16,%r18,%r18
+.Lfmend:
+	shr	3,%r21,%r21
+	addu	%r21,%r17,%r17		/* back to the next byte to copy */
+
+.Lfbytes:
+	bte	0,%r18,.Ldone
+1:	ld.b	0(%r17),%r20
+	st.b	%r20,0(%r19)
+	addu	1,%r17,%r17
+	addu	1,%r19,%r19
+	adds	-1,%r18,%r18
+	btne	0,%r18,1b
+.Ldone:
+	bri	%r1
+	nop
+ENDPROC(memcpy)
+
+/* void *memmove(void *dst = r16, const void *src = r17, size_t n = r18) */
+ENTRY(memmove)
+	mov	%r16,%r19
+	subu	%r17,%r16,%r0		/* CC = d <= s: forward copy is safe */
+	bc	.Lfwd
+	addu	%r18,%r17,%r21		/* s + n */
+	subu	%r16,%r21,%r0		/* CC = s + n <= d: no overlap */
+	bc	.Lfwd
+
+	/* overlapping with d > s: copy backwards from the end */
+	addu	%r18,%r16,%r19		/* r19 = d end, r17 = s end */
+	mov	%r21,%r17
+	subu	15,%r18,%r0
+	bc	.Lbbytes
+	xor	%r19,%r17,%r20
+	and	15,%r20,%r0
+	bnc	.Lb4
+
+.Lbhead16:
+	and	15,%r19,%r0
+	bc	.Lbq
+	ld.b	-1(%r17),%r20
+	st.b	%r20,-1(%r19)
+	adds	-1,%r17,%r17
+	adds	-1,%r19,%r19
+	br	.Lbhead16
+	adds	-1,%r18,%r18
+.Lbq:
+	subu	63,%r18,%r0
+	bc	.Lbq16
+.Lbq64:
+	fld.q	-16(%r17),%f8
+	fld.q	-32(%r17),%f12
+	fld.q	-48(%r17),%f16
+	fld.q	-64(%r17),%f20
+	fst.q	%f8,-16(%r19)
+	fst.q	%f12,-32(%r19)
+	fst.q	%f16,-48(%r19)
+	fst.q	%f20,-64(%r19)
+	adds	-64,%r17,%r17
+	adds	-64,%r19,%r19
+	adds	-64,%r18,%r18
+	subu	63,%r18,%r0
+	bnc	.Lbq64
+.Lbq16:
+	subu	15,%r18,%r0
+	bc	.Lbbytes
+	fld.q	-16(%r17),%f8
+	fst.q	%f8,-16(%r19)
+	adds	-16,%r17,%r17
+	adds	-16,%r19,%r19
+	br	.Lbq16
+	adds	-16,%r18,%r18
+
+.Lb4:
+	and	3,%r20,%r0
+	bnc	.Lbbytes
+.Lbhead4:
+	and	3,%r19,%r0
+	bc	.Lbw
+	ld.b	-1(%r17),%r20
+	st.b	%r20,-1(%r19)
+	adds	-1,%r17,%r17
+	adds	-1,%r19,%r19
+	br	.Lbhead4
+	adds	-1,%r18,%r18
+.Lbw:
+	subu	3,%r18,%r0
+	bc	.Lbbytes
+	ld.l	-4(%r17),%r20
+	st.l	%r20,-4(%r19)
+	adds	-4,%r17,%r17
+	adds	-4,%r19,%r19
+	br	.Lbw
+	adds	-4,%r18,%r18
+
+.Lbbytes:
+	bte	0,%r18,2f
+1:	ld.b	-1(%r17),%r20
+	st.b	%r20,-1(%r19)
+	adds	-1,%r17,%r17
+	adds	-1,%r19,%r19
+	adds	-1,%r18,%r18
+	btne	0,%r18,1b
+2:	bri	%r1
+	nop
+ENDPROC(memmove)
diff --git a/arch/i860/lib/memset.S b/arch/i860/lib/memset.S
new file mode 100644
index 000000000000..f65bae255cd1
--- /dev/null
+++ b/arch/i860/lib/memset.S
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * memset with 128-bit fst.q stores of a pattern held in f8-f11.
+ * No auto-increment addressing, so every store can fault and be
+ * re-executed.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/linkage.h>
+
+	.text
+
+/* void *memset(void *s = r16, int c = r17, size_t n = r18) */
+ENTRY(memset)
+	mov	%r16,%r19		/* r19 = cursor, r16 is returned */
+	and	0xff,%r17,%r17
+	shl	8,%r17,%r20
+	or	%r20,%r17,%r17
+	shl	16,%r17,%r20
+	or	%r20,%r17,%r17		/* byte replicated into a word */
+	subu	15,%r18,%r0		/* CC = n < 16 */
+	bc	.Lbytes
+
+.Lhead:
+	and	15,%r19,%r0
+	bc	.Lq
+	st.b	%r17,0(%r19)
+	addu	1,%r19,%r19
+	br	.Lhead
+	adds	-1,%r18,%r18
+
+.Lq:
+	ixfr	%r17,%f8
+	ixfr	%r17,%f9
+	ixfr	%r17,%f10
+	ixfr	%r17,%f11
+	subu	63,%r18,%r0		/* CC = n < 64 */
+	bc	.Lq16
+.Lq64:
+	fst.q	%f8,0(%r19)
+	fst.q	%f8,16(%r19)
+	fst.q	%f8,32(%r19)
+	fst.q	%f8,48(%r19)
+	addu	64,%r19,%r19
+	adds	-64,%r18,%r18
+	subu	63,%r18,%r0
+	bnc	.Lq64
+.Lq16:
+	subu	15,%r18,%r0
+	bc	.Lwords
+	fst.q	%f8,0(%r19)
+	addu	16,%r19,%r19
+	br	.Lq16
+	adds	-16,%r18,%r18
+
+	/* the cursor is 16-byte aligned here */
+.Lwords:
+	subu	3,%r18,%r0		/* CC = n < 4 */
+	bc	.Lbytes
+	st.l	%r17,0(%r19)
+	addu	4,%r19,%r19
+	br	.Lwords
+	adds	-4,%r18,%r18
+
+.Lbytes:
+	bte	0,%r18,2f
+1:	st.b	%r17,0(%r19)
+	addu	1,%r19,%r19
+	adds	-1,%r18,%r18
+	btne	0,%r18,1b
+2:	bri	%r1
+	nop
+ENDPROC(memset)
diff --git a/arch/i860/lib/usercopy.S b/arch/i860/lib/usercopy.S
new file mode 100644
index 000000000000..a2fcdba3c6e2
--- /dev/null
+++ b/arch/i860/lib/usercopy.S
@@ -0,0 +1,124 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * User copies; every access that can fault has an __ex_table entry that
+ * returns the number of bytes not copied (at most one 16-byte block more
+ * than the exact count). Mutually 16-byte aligned buffers move with
+ * fld.q/fst.q. No auto-increment addressing: a resolved fault re-executes
+ * the access.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/linkage.h>
+
+#define EX(insn, fixup)				\
+	.section __ex_table,"a";		\
+	.long	insn, fixup;			\
+	.previous
+
+	.text
+
+/* unsigned long __copy_user(void *to = r16, const void *from = r17, n = r18) */
+ENTRY(__copy_user)
+	mov	%r16,%r19
+	subu	15,%r18,%r0		/* CC = n < 16 */
+	bc	.Lbytes
+	xor	%r19,%r17,%r20
+	and	15,%r20,%r0		/* CC = equally aligned mod 16 */
+	bnc	.Lw4
+
+.Lhead16:
+	and	15,%r19,%r0
+	bc	.Lq
+1:	ld.b	0(%r17),%r20
+2:	st.b	%r20,0(%r19)
+	addu	1,%r17,%r17
+	addu	1,%r19,%r19
+	br	.Lhead16
+	adds	-1,%r18,%r18
+.Lq:
+	subu	15,%r18,%r0
+	bc	.Lbytes
+3:	fld.q	0(%r17),%f8
+4:	fst.q	%f8,0(%r19)
+	addu	16,%r17,%r17
+	addu	16,%r19,%r19
+	br	.Lq
+	adds	-16,%r18,%r18
+
+.Lw4:
+	and	3,%r20,%r0		/* CC = equally aligned mod 4 */
+	bnc	.Lbytes
+.Lhead4:
+	and	3,%r19,%r0
+	bc	.Lw
+5:	ld.b	0(%r17),%r20
+6:	st.b	%r20,0(%r19)
+	addu	1,%r17,%r17
+	addu	1,%r19,%r19
+	br	.Lhead4
+	adds	-1,%r18,%r18
+.Lw:
+	subu	3,%r18,%r0
+	bc	.Lbytes
+7:	ld.l	0(%r17),%r20
+8:	st.l	%r20,0(%r19)
+	addu	4,%r17,%r17
+	addu	4,%r19,%r19
+	br	.Lw
+	adds	-4,%r18,%r18
+
+.Lbytes:
+	bte	0,%r18,.Ldone
+9:	ld.b	0(%r17),%r20
+10:	st.b	%r20,0(%r19)
+	addu	1,%r17,%r17
+	addu	1,%r19,%r19
+	adds	-1,%r18,%r18
+	btne	0,%r18,9b
+.Ldone:
+	bri	%r1
+	mov	%r18,%r16
+
+	EX(1b, .Ldone)
+	EX(2b, .Ldone)
+	EX(3b, .Ldone)
+	EX(4b, .Ldone)
+	EX(5b, .Ldone)
+	EX(6b, .Ldone)
+	EX(7b, .Ldone)
+	EX(8b, .Ldone)
+	EX(9b, .Ldone)
+	EX(10b, .Ldone)
+
+/* unsigned long __clear_user_asm(void *to = r16, unsigned long n = r17) */
+ENTRY(__clear_user_asm)
+	subu	7,%r17,%r0		/* CC = n < 8 */
+	bc	.Lcbytes
+.Lchead:
+	and	7,%r16,%r0
+	bc	.Lcd
+11:	st.b	%r0,0(%r16)
+	addu	1,%r16,%r16
+	br	.Lchead
+	adds	-1,%r17,%r17
+.Lcd:
+	subu	7,%r17,%r0
+	bc	.Lcbytes
+12:	fst.d	%f0,0(%r16)		/* f0/f1 read as zero */
+	addu	8,%r16,%r16
+	br	.Lcd
+	adds	-8,%r17,%r17
+.Lcbytes:
+	bte	0,%r17,.Lcdone
+13:	st.b	%r0,0(%r16)
+	addu	1,%r16,%r16
+	adds	-1,%r17,%r17
+	btne	0,%r17,13b
+.Lcdone:
+	bri	%r1
+	mov	%r17,%r16
+
+	EX(11b, .Lcdone)
+	EX(12b, .Lcdone)
+	EX(13b, .Lcdone)
diff --git a/arch/i860/mm/Makefile b/arch/i860/mm/Makefile
new file mode 100644
index 000000000000..a30dd829afca
--- /dev/null
+++ b/arch/i860/mm/Makefile
@@ -0,0 +1,6 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+#
+
+obj-y	:= init.o fault.o cache.o cacheflush.o extable.o
diff --git a/arch/i860/mm/cache.S b/arch/i860/mm/cache.S
new file mode 100644
index 000000000000..2bb393ef198a
--- /dev/null
+++ b/arch/i860/mm/cache.S
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * i860 TLB, instruction and data cache control.
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/linkage.h>
+#include <asm/i860.h>
+
+	.text
+
+/* void i860_set_pgd(pgd_t *pgd): new page directory, TLB invalidated */
+ENTRY(i860_set_pgd)
+	orh	[i860_current_pgd]@ha,%r0,%r31
+	st.l	%r16,[i860_current_pgd]@l(%r31)
+	ld.c	%dirbase,%r17
+	and	0x00df,%r17,%r17	/* keep DPS/BL/LB, drop DTB, ITI, RB, RC */
+	or	%r16,%r17,%r17
+	or	DIRBASE_ITI | DIRBASE_ATE,%r17,%r17
+	st.c	%r17,%dirbase
+	nop
+	nop
+	nop
+	nop
+	nop
+	nop
+	bri	%r1
+	nop
+
+/* Invalidate the TLB and the instruction cache. */
+ENTRY(local_flush_tlb_all)
+	ld.c	%psr,%r16
+	andnot	PSR_IM,%r16,%r17
+	st.c	%r17,%psr
+	ld.c	%dirbase,%r17
+	or	DIRBASE_ITI,%r17,%r17
+	st.c	%r17,%dirbase
+	nop
+	nop
+	nop
+	nop
+	nop
+	nop
+	st.c	%r16,%psr
+	bri	%r1
+	nop
+
+/*
+ * Write back and invalidate the whole data cache: for each way (RB) flush
+ * the 128 lines with dirbase.RC = 2, after the Intel reference routine.
+ * The ixfr before each flush is the firmware's workaround for the XR.
+ * The XR has 2 ways, the XP 4.
+ */
+ENTRY(i860_flush_dcache_all)
+	mov	%r1,%r28
+	ld.c	%psr,%r29
+	andnot	PSR_IM,%r29,%r30
+	st.c	%r30,%psr
+	ld.c	%epsr,%r27
+	and	EPSR_TYPE,%r27,%r27
+	or	2,%r0,%r26
+	xor	EPSR_TYPE_XP,%r27,%r0
+	bnc	1f
+	or	4,%r0,%r26
+1:	ld.c	%dirbase,%r25
+	andnot	DIRBASE_RB | DIRBASE_RC | DIRBASE_ITI,%r25,%r25
+	mov	%r0,%r24
+2:	or	DIRBASE_RC_FLUSH,%r25,%r23
+	or	%r24,%r23,%r23
+	st.c	%r23,%dirbase
+	orh	[_stext]@h,%r0,%r21
+	or	[_stext]@l,%r21,%r21
+	adds	-32,%r21,%r21
+	or	127,%r0,%r20
+	adds	-1,%r0,%r19
+	ld.l	32(%r21),%r31
+	shl	0,%r31,%r31
+	bla	%r19,%r20,3f
+	nop
+3:	ixfr	%r0,%f0
+	bla	%r19,%r20,3b
+	flush	32(%r21)++
+	ld.l	-512(%r21),%r0
+	addu	0x100,%r24,%r24
+	adds	-1,%r26,%r26
+	btne	%r0,%r26,2b
+	st.c	%r25,%dirbase
+	st.c	%r29,%psr
+	bri	%r28
+	nop
diff --git a/arch/i860/mm/cacheflush.c b/arch/i860/mm/cacheflush.c
new file mode 100644
index 000000000000..8b052df49e8f
--- /dev/null
+++ b/arch/i860/mm/cacheflush.c
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Fewer data cache flushes and dirbase.ITI. The kernel writes pages through
+ * the linear map, and the virtual tags hide those lines from a user mapping.
+ * PG_arch_1 set: the page has no such lines. So a page written while nobody
+ * has it mapped, like file data read from disk, is flushed when it gets mapped.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+
+#include <linux/mm.h>
+#include <linux/pagemap.h>
+#include <asm/cacheflush.h>
+#include <asm/tlbflush.h>
+
+#define PG_dcache_clean	PG_arch_1
+
+void flush_dcache_folio(struct folio *folio)
+{
+	if (folio_flush_mapping(folio) && !folio_mapped(folio)) {
+		clear_bit(PG_dcache_clean, &folio->flags.f);
+		return;
+	}
+	i860_flush_dcache_all();
+}
+
+void flush_dcache_page(struct page *page)
+{
+	flush_dcache_folio(page_folio(page));
+}
+
+void update_mmu_cache_range(struct vm_fault *vmf, struct vm_area_struct *vma,
+			    unsigned long addr, pte_t *ptep, unsigned int nr)
+{
+	pte_t pte = ptep_get(ptep);
+	unsigned long pfn = pte_pfn(pte);
+
+	if (pfn_valid(pfn) &&
+	    !test_and_set_bit(PG_dcache_clean, &page_folio(pfn_to_page(pfn))->flags.f))
+		i860_flush_dcache_all();
+
+	/*
+	 * Faults are not cached in the TLB, and instructions of an earlier
+	 * mapping went with the ITI when it was unmapped. So only a change
+	 * of a present entry needs one.
+	 */
+	if (!vmf || pte_present(vmf->orig_pte))
+		local_flush_tlb_all();
+}
diff --git a/arch/i860/mm/extable.c b/arch/i860/mm/extable.c
new file mode 100644
index 000000000000..89e326af2ec6
--- /dev/null
+++ b/arch/i860/mm/extable.c
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#include <linux/extable.h>
+#include <linux/ptrace.h>
+#include <asm/traps.h>
+
+int fixup_exception(struct pt_regs *regs)
+{
+	const struct exception_table_entry *e;
+
+	e = search_exception_tables(regs->user.fir);
+	if (!e)
+		return 0;
+	regs->user.fir = e->fixup;
+	return 1;
+}
diff --git a/arch/i860/mm/fault.c b/arch/i860/mm/fault.c
new file mode 100644
index 000000000000..5d904a5bf7ab
--- /dev/null
+++ b/arch/i860/mm/fault.c
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#include <linux/extable.h>
+#include <linux/mm.h>
+#include <linux/perf_event.h>
+#include <linux/sched/signal.h>
+#include <linux/uaccess.h>
+#include <asm/mmu_context.h>
+#include <asm/traps.h>
+
+extern pgd_t *i860_current_pgd;
+
+/* Kernel PDEs added after a pgd was copied (vmalloc) are synced lazily. */
+static bool i860_vmalloc_fault(unsigned long addr)
+{
+	unsigned int idx = pgd_index(addr);
+	pgd_t *pgd = i860_current_pgd + idx;
+	pgd_t *pgd_k = swapper_pg_dir + idx;
+
+	if (!pgd_val(*pgd_k) || pgd_val(*pgd))
+		return false;
+	*pgd = *pgd_k;
+	local_flush_tlb_all();
+	return true;
+}
+
+static void i860_kernel_fault(struct pt_regs *regs, unsigned long addr)
+{
+	if (fixup_exception(regs))
+		return;
+	pr_alert("Unable to handle kernel %s at virtual address %08lx\n",
+		 addr < PAGE_SIZE ? "NULL pointer dereference" : "paging request",
+		 addr);
+	die("Oops", regs, 0);
+}
+
+void i860_do_page_fault(struct pt_regs *regs, unsigned long addr,
+			bool write, bool fetch)
+{
+	struct mm_struct *mm = current->mm;
+	struct vm_area_struct *vma;
+	unsigned int flags = FAULT_FLAG_DEFAULT;
+	vm_fault_t fault;
+	int code = SEGV_MAPERR;
+
+	if (!user_mode(regs) && addr >= VMALLOC_START && addr < VMALLOC_END) {
+		if (!i860_vmalloc_fault(addr))
+			i860_kernel_fault(regs, addr);
+		return;
+	}
+
+	if (!regs_irqs_disabled(regs))
+		local_irq_enable();
+
+	if (faulthandler_disabled() || !mm) {
+		if (!user_mode(regs))
+			i860_kernel_fault(regs, addr);
+		else
+			force_sig_fault(SIGSEGV, code, (void __user *)addr);
+		return;
+	}
+
+	if (user_mode(regs))
+		flags |= FAULT_FLAG_USER;
+	if (write)
+		flags |= FAULT_FLAG_WRITE;
+	if (fetch)
+		flags |= FAULT_FLAG_INSTRUCTION;
+
+	perf_sw_event(PERF_COUNT_SW_PAGE_FAULTS, 1, regs, addr);
+
+retry:
+	vma = lock_mm_and_find_vma(mm, addr, regs);
+	if (unlikely(!vma))
+		goto bad_area_nosemaphore;
+
+	code = SEGV_ACCERR;
+	if (write) {
+		if (!(vma->vm_flags & VM_WRITE))
+			goto bad_area;
+	} else if (!(vma->vm_flags & (VM_READ | VM_EXEC | VM_WRITE))) {
+		goto bad_area;
+	}
+
+	fault = handle_mm_fault(vma, addr, flags, regs);
+
+	if (fault_signal_pending(fault, regs)) {
+		if (!user_mode(regs))
+			i860_kernel_fault(regs, addr);
+		return;
+	}
+
+	if (fault & VM_FAULT_COMPLETED)
+		return;
+
+	if (unlikely(fault & VM_FAULT_ERROR)) {
+		mmap_read_unlock(mm);
+		if (fault & VM_FAULT_OOM) {
+			if (!user_mode(regs))
+				i860_kernel_fault(regs, addr);
+			else
+				pagefault_out_of_memory();
+			return;
+		}
+		if (!user_mode(regs)) {
+			i860_kernel_fault(regs, addr);
+			return;
+		}
+		if (fault & VM_FAULT_SIGBUS)
+			force_sig_fault(SIGBUS, BUS_ADRERR, (void __user *)addr);
+		else
+			force_sig_fault(SIGSEGV, code, (void __user *)addr);
+		return;
+	}
+
+	if (fault & VM_FAULT_RETRY) {
+		flags |= FAULT_FLAG_TRIED;
+		goto retry;
+	}
+
+	mmap_read_unlock(mm);
+	return;
+
+bad_area:
+	mmap_read_unlock(mm);
+bad_area_nosemaphore:
+	if (user_mode(regs)) {
+		force_sig_fault(SIGSEGV, code, (void __user *)addr);
+		return;
+	}
+	i860_kernel_fault(regs, addr);
+}
diff --git a/arch/i860/mm/init.c b/arch/i860/mm/init.c
new file mode 100644
index 000000000000..358aeb68fae2
--- /dev/null
+++ b/arch/i860/mm/init.c
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+
+#include <linux/init.h>
+#include <linux/memblock.h>
+#include <linux/mm.h>
+#include <linux/pgtable.h>
+#include <asm/i860.h>
+#include <asm/io.h>
+#include <asm/mmu_context.h>
+#include <asm/pgalloc.h>
+#include <asm/setup.h>
+
+pgd_t swapper_pg_dir[PTRS_PER_PGD] __page_aligned_bss;
+
+pgd_t *i860_current_pgd = swapper_pg_dir;
+
+/* On-board I/O mapped statically into the window at I860_IO_VIRT. */
+static const struct {
+	unsigned long phys, size;
+} i860_io_regions[] = {
+	{ 0x1c000000, 0x1000 },		/* 82380, SCSI, FDC, LAN */
+	{ 0x1e000000, 0x1000 },		/* RTC, UARTs, keyboard, POST */
+	{ 0x1f000000, 0x10000 },	/* NVRAM */
+};
+
+static pte_t * __init i860_pte(unsigned long va)
+{
+	pgd_t *pgd = swapper_pg_dir + pgd_index(va);
+	pte_t *pte;
+
+	if (!pgd_val(*pgd)) {
+		pte = memblock_alloc_or_panic(PAGE_SIZE, PAGE_SIZE);
+		*pgd = __pgd(__pa(pte) | _PAGE_TABLE);
+	}
+	pte = (pte_t *)__va(pgd_val(*pgd) & PAGE_MASK);
+	return pte + ((va >> PAGE_SHIFT) & (PTRS_PER_PTE - 1));
+}
+
+static void __init i860_map(unsigned long va, unsigned long pa,
+			    unsigned long size, pgprot_t prot)
+{
+	for (; size; size -= PAGE_SIZE, va += PAGE_SIZE, pa += PAGE_SIZE)
+		set_pte(i860_pte(va), pfn_pte(pa >> PAGE_SHIFT, prot));
+}
+
+static pte_t *i860_linear_pte(unsigned long va)
+{
+	pgd_t *pgd = swapper_pg_dir + pgd_index(va);
+
+	return (pte_t *)__va(pgd_val(*pgd) & PAGE_MASK) +
+	       ((va >> PAGE_SHIFT) & (PTRS_PER_PTE - 1));
+}
+
+/*
+ * Change the caching of one lowmem page in the linear map. Cached data is
+ * written back before the page becomes uncached; an uncached page leaves
+ * no lines behind.
+ */
+void i860_set_cacheable(void *addr, bool cacheable)
+{
+	pte_t *pte = i860_linear_pte((unsigned long)addr);
+	unsigned long val = pte_val(*pte);
+
+	if (!!(val & _PAGE_CD) == !cacheable)
+		return;
+	if (!cacheable)
+		i860_flush_dcache_all();
+	set_pte(pte, __pte(cacheable ? val & ~_PAGE_CD : val | _PAGE_CD));
+	local_flush_tlb_all();
+}
+
+void __init paging_init(void)
+{
+	phys_addr_t start, end;
+	u64 i;
+	int r;
+
+	for_each_mem_range(i, &start, &end)
+		i860_map(start, start, end - start, PAGE_KERNEL);
+	/* the trap vector page is not part of memblock */
+	i860_map(I860_TRAP_PAGE, I860_TRAP_PAGE, PAGE_SIZE, PAGE_KERNEL);
+
+	for (r = 0; r < ARRAY_SIZE(i860_io_regions); r++)
+		i860_map((unsigned long)I860_IO(i860_io_regions[r].phys),
+			 i860_io_regions[r].phys, i860_io_regions[r].size,
+			 __pgprot(_PAGE_IOREMAP));
+
+	/*
+	 * The page directory and tables are walked in memory. This still runs
+	 * on the uncached firmware mapping, so the stores reach memory.
+	 */
+	set_pte(i860_linear_pte((unsigned long)swapper_pg_dir),
+		__pte(pte_val(*i860_linear_pte((unsigned long)swapper_pg_dir)) |
+		      _PAGE_CD));
+	for (r = 0; r < PTRS_PER_PGD; r++) {
+		unsigned long table = pgd_val(swapper_pg_dir[r]) & PAGE_MASK;
+		pte_t *pte;
+
+		if (!table)
+			continue;
+		pte = i860_linear_pte(table);
+		set_pte(pte, __pte(pte_val(*pte) | _PAGE_CD));
+	}
+
+	/* write back the firmware's cached data while its mapping is live */
+	i860_flush_dcache_all();
+	i860_set_pgd(swapper_pg_dir);
+}
+
+void __iomem *ioremap_prot(phys_addr_t phys, size_t size, pgprot_t prot)
+{
+	int r;
+
+	for (r = 0; r < ARRAY_SIZE(i860_io_regions); r++)
+		if (phys >= i860_io_regions[r].phys &&
+		    phys + size <= i860_io_regions[r].phys +
+				   i860_io_regions[r].size)
+			return I860_IO(phys);
+	return generic_ioremap_prot(phys, size, prot);
+}
+EXPORT_SYMBOL(ioremap_prot);
+
+void iounmap(volatile void __iomem *addr)
+{
+	unsigned long va = (unsigned long)addr;
+
+	if (va >= I860_IO_VIRT && va < I860_IO_VIRT + I860_IO_SIZE)
+		return;
+	generic_iounmap(addr);
+}
+EXPORT_SYMBOL(iounmap);
+
+pgd_t *pgd_alloc(struct mm_struct *mm)
+{
+	pgd_t *pgd = __pgd_alloc(mm, 0);
+
+	if (pgd) {
+		memcpy(pgd + USER_PTRS_PER_PGD,
+		       swapper_pg_dir + USER_PTRS_PER_PGD,
+		       (PTRS_PER_PGD - USER_PTRS_PER_PGD) * sizeof(pgd_t));
+		i860_set_cacheable(pgd, false);
+	}
+	return pgd;
+}
+
+static const pgprot_t protection_map[16] = {
+	[VM_NONE]					= PAGE_NONE,
+	[VM_READ]					= PAGE_READONLY,
+	[VM_WRITE]					= PAGE_COPY,
+	[VM_WRITE | VM_READ]				= PAGE_COPY,
+	[VM_EXEC]					= PAGE_READONLY,
+	[VM_EXEC | VM_READ]				= PAGE_READONLY,
+	[VM_EXEC | VM_WRITE]				= PAGE_COPY,
+	[VM_EXEC | VM_WRITE | VM_READ]			= PAGE_COPY,
+	[VM_SHARED]					= PAGE_NONE,
+	[VM_SHARED | VM_READ]				= PAGE_READONLY,
+	[VM_SHARED | VM_WRITE]				= PAGE_SHARED,
+	[VM_SHARED | VM_WRITE | VM_READ]		= PAGE_SHARED,
+	[VM_SHARED | VM_EXEC]				= PAGE_READONLY,
+	[VM_SHARED | VM_EXEC | VM_READ]			= PAGE_READONLY,
+	[VM_SHARED | VM_EXEC | VM_WRITE]		= PAGE_SHARED,
+	[VM_SHARED | VM_EXEC | VM_WRITE | VM_READ]	= PAGE_SHARED,
+};
+DECLARE_VM_GET_PAGE_PROT
diff --git a/drivers/input/serio/i8042-i860io.h b/drivers/input/serio/i8042-i860io.h
new file mode 100644
index 000000000000..0005c9044bdc
--- /dev/null
+++ b/drivers/input/serio/i8042-i860io.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * i8042 on the Samsung i860 MAGIC Station II: data at 0x1e000a00,
+ * status/command at 0x1e000a08, keyboard IRQ 18. No AUX (mouse) port is
+ * known to be wired.
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ */
+#ifndef _I8042_I860IO_H
+#define _I8042_I860IO_H
+
+#include <linux/io.h>
+
+#define I8042_KBD_PHYS_DESC "i8042/serio0"
+#define I8042_AUX_PHYS_DESC "i8042/serio1"
+#define I8042_MUX_PHYS_DESC "i8042/serio%d"
+
+#define I8042_KBD_IRQ	18
+#define I8042_AUX_IRQ	18
+
+#define I8042_DATA_REG		0x1e000a00
+#define I8042_COMMAND_REG	0x1e000a08
+#define I8042_STATUS_REG	0x1e000a08
+
+static inline int i8042_read_data(void)
+{
+	return readb(I860_IO(I8042_DATA_REG));
+}
+
+static inline int i8042_read_status(void)
+{
+	return readb(I860_IO(I8042_STATUS_REG));
+}
+
+static inline void i8042_write_data(int val)
+{
+	writeb(val, I860_IO(I8042_DATA_REG));
+}
+
+static inline void i8042_write_command(int val)
+{
+	writeb(val, I860_IO(I8042_COMMAND_REG));
+}
+
+static inline int i8042_platform_init(void)
+{
+	i8042_noaux = true;
+	return 0;
+}
+
+static inline void i8042_platform_exit(void)
+{
+}
+
+#endif
diff --git a/drivers/input/serio/i8042.h b/drivers/input/serio/i8042.h
index 5f61672d55b7..3f58d025bf22 100644
--- a/drivers/input/serio/i8042.h
+++ b/drivers/input/serio/i8042.h
@@ -5,6 +5,7 @@
 
 /*
  *  Copyright (c) 1999-2002 Vojtech Pavlik
