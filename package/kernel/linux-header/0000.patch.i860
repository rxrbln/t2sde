+generic-y += ucontext.h
diff --git a/arch/i860/include/uapi/asm/byteorder.h b/arch/i860/include/uapi/asm/byteorder.h
new file mode 100644
index 000000000000..fa7cfa69b7b1
--- /dev/null
+++ b/arch/i860/include/uapi/asm/byteorder.h
@@ -0,0 +1,8 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _UAPI_ASM_I860_BYTEORDER_H
+#define _UAPI_ASM_I860_BYTEORDER_H
+
+#include <linux/byteorder/little_endian.h>
+
+#endif
diff --git a/arch/i860/include/uapi/asm/ptrace.h b/arch/i860/include/uapi/asm/ptrace.h
new file mode 100644
index 000000000000..3e0250e4c30f
--- /dev/null
+++ b/arch/i860/include/uapi/asm/ptrace.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _UAPI_ASM_I860_PTRACE_H
+#define _UAPI_ASM_I860_PTRACE_H
+
+#define PTRACE_SYSEMU			31
+#define PTRACE_SYSEMU_SINGLESTEP	32
+
+#ifndef __ASSEMBLER__
+
+/* Register state as saved on a trap; the layout is shared with sigcontext. */
+struct user_regs_struct {
+	unsigned long gpr[32];		/* r0 slot is unused */
+	unsigned long fpr[32];		/* f0/f1 read as zero */
+	unsigned long psr;
+	unsigned long epsr;
+	unsigned long fir;		/* resume address */
+	unsigned long fsr;
+};
+
+#endif
+
+#endif
diff --git a/arch/i860/include/uapi/asm/sigcontext.h b/arch/i860/include/uapi/asm/sigcontext.h
new file mode 100644
index 000000000000..5d5c3e6c755a
--- /dev/null
+++ b/arch/i860/include/uapi/asm/sigcontext.h
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#ifndef _UAPI_ASM_I860_SIGCONTEXT_H
+#define _UAPI_ASM_I860_SIGCONTEXT_H
+
+#include <asm/ptrace.h>
+
+struct sigcontext {
+	struct user_regs_struct regs;
+	unsigned long oldmask;
+};
+
+#endif
