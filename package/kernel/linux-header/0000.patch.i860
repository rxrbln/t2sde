From: René Rebe <rene@exactco.de>
Subject: [PATCH] i860: add the UAPI headers

Only the UAPI headers of the i860 port, for building a toolchain and libc, and the arch Makefile, Kconfig, defconfig and syscall ABI list that oldconfig and headers_install need. No kernel code or drivers.

Against upstream commit 36aad21d50d1af3f6954bb0c988257a908202477 (Merge tag 'ksmbd-for-7.4-rc1-part2' of git://git.kernel.org/pub/scm/linux/kernel/git/linkinjeon/smb).
Branch i860 at 011d393ab3b2.

Signed-off-by: René Rebe <rene@exactco.de>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/i860/Kconfig                       | 94 +++++++++++++++++++++++++
 arch/i860/Kconfig.debug                 |  1 +
 arch/i860/Makefile                      | 35 +++++++++
 arch/i860/configs/magicst2_defconfig    | 76 ++++++++++++++++++++
 arch/i860/include/uapi/asm/Kbuild       |  3 +
 arch/i860/include/uapi/asm/byteorder.h  |  8 +++
 arch/i860/include/uapi/asm/ptrace.h     | 23 ++++++
 arch/i860/include/uapi/asm/sigcontext.h | 13 ++++
 arch/i860/include/uapi/asm/signal.h     | 10 +++
 arch/i860/include/uapi/asm/unistd.h     |  3 +
 arch/i860/kernel/Makefile.syscalls      |  3 +
 include/uapi/linux/audit.h              |  2 +
 12 files changed, 271 insertions(+)

diff --git a/arch/i860/Kconfig b/arch/i860/Kconfig
new file mode 100644
index 000000000000..f7d298ea91c0
--- /dev/null
+++ b/arch/i860/Kconfig
@@ -0,0 +1,94 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Intel i860 (Samsung MAGIC Station II)
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+#
+
+config I860
+	def_bool y
+	select ARCH_32BIT_OFF_T
+	select ARCH_MIGHT_HAVE_PC_SERIO
+	select ARCH_NO_PREEMPT
+	select CPU_NO_EFFICIENT_FFS
+	select GENERIC_ATOMIC64
+	select GENERIC_CPU_DEVICES
+	select GENERIC_ENTRY
+	select GENERIC_SCHED_CLOCK
+	select GENERIC_IRQ_PROBE
+	select GENERIC_IRQ_SHOW
+	select GENERIC_IRQ_MULTI_HANDLER
+	select GENERIC_IOREMAP
+	select GENERIC_SMP_IDLE_THREAD
+	select HAVE_ARCH_TRACEHOOK
+	select HAVE_MOD_ARCH_SPECIFIC
+	select MODULES_USE_ELF_RELA
+	select HAVE_GENERIC_TIF_BITS
+	select HAVE_PAGE_SIZE_4KB
+	select HAVE_SYSCALL_TRACEPOINTS
+	select LOCK_MM_AND_FIND_VMA
+	select MMU_GATHER_NO_RANGE
+	select MODULES_USE_ELF_RELA
+	select NEED_DMA_MAP_STATE
+	select TRACE_IRQFLAGS_SUPPORT
+
+config MMU
+	def_bool y
+
+config GENERIC_CSUM
+	def_bool y
+
+config GENERIC_HWEIGHT
+	def_bool y
+
+config GENERIC_CALIBRATE_DELAY
+	def_bool y
+
+config NO_IOPORT_MAP
+	def_bool y
+
+config STACKTRACE_SUPPORT
+	def_bool n
+
+config LOCKDEP_SUPPORT
+	def_bool n
+
+config ARCH_MAY_HAVE_PC_FDC
+	def_bool y
+
+config NR_CPUS
+	int
+	default "1"
+
+config PGTABLE_LEVELS
+	int
+	default 2
+
+menu "Processor type and features"
+
+config I860_MAGICST2
+	def_bool y
+	help
+	  Samsung i860 MAGIC Station II: i860XR, Intel 82380, WD33C93,
+	  82077 floppy, 82596 LAN, 16450 UARTs and DRAM at the top of the
+	  physical address space.
+
+config I860_KERNEL_BASE
+	hex "Kernel load and link address"
+	default 0xff800000
+	help
+	  Physical (= virtual) address the kernel image is loaded to. The
+	  default is the start of the smallest (8 MB) DRAM configuration.
+
+source "kernel/Kconfig.hz"
+
+config CMDLINE
+	string "Default kernel command line"
+	default "console=tty0 console=ttyS0,9600"
+
+config CMDLINE_FORCE
+	bool "Always use the default kernel command line"
+	default y
+	help
+	  The boot loader does not pass a command line yet.
+
+endmenu
diff --git a/arch/i860/Kconfig.debug b/arch/i860/Kconfig.debug
new file mode 100644
index 000000000000..f66554cd5c45
--- /dev/null
+++ b/arch/i860/Kconfig.debug
@@ -0,0 +1 @@
+# SPDX-License-Identifier: GPL-2.0
diff --git a/arch/i860/Makefile b/arch/i860/Makefile
new file mode 100644
index 000000000000..e8f8b50deeac
--- /dev/null
+++ b/arch/i860/Makefile
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Intel i860 architecture Makefile
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+#
+
+KBUILD_DEFCONFIG := magicst2_defconfig
+
+LIBGCC		:= $(shell $(CC) $(KBUILD_CFLAGS) -print-libgcc-file-name)
+
+KBUILD_CFLAGS	+= -pipe -D__linux__ -fno-pic
+KBUILD_AFLAGS	+= -fno-pic
+LDFLAGS_vmlinux	+= -N
+
+libs-y		+= arch/i860/lib/ $(LIBGCC)
+
+boot := arch/i860/boot
+
+all: vmlinux.bin
+
+PHONY += vmlinux.bin bootdisk
+
+vmlinux.bin: vmlinux
+	$(Q)$(MAKE) $(build)=$(boot) $(boot)/$@
+
+bootdisk: vmlinux.bin
+	$(Q)$(MAKE) $(build)=$(boot) $(boot)/bootdisk.img
+
+archclean:
+	$(Q)$(MAKE) $(clean)=$(boot)
+
+define archhelp
+  echo  '* vmlinux.bin	- Raw kernel image (arch/$(ARCH)/boot/vmlinux.bin)'
+  echo  '  bootdisk	- SCSI disk image with boot block and kernel'
+endef
