+# SPDX-License-Identifier: GPL-2.0
diff --git a/arch/i860/Makefile b/arch/i860/Makefile
new file mode 100644
index 000000000000..c95c1f645272
--- /dev/null
+++ b/arch/i860/Makefile
@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Intel i860 architecture Makefile
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+#
+
+KBUILD_DEFCONFIG := magicst2_defconfig
+
+LIBGCC		:= $(shell $(CC) $(KBUILD_CFLAGS) -print-libgcc-file-name)
+
+KBUILD_CFLAGS	+= -pipe -D__linux__ -fno-pic
+# show_stack walks the frame pointers; these come after the -fomit-frame-pointer of the top Makefile
+KBUILD_CFLAGS_KERNEL	+= -fno-omit-frame-pointer
+KBUILD_CFLAGS_MODULE	+= -fno-omit-frame-pointer
+KBUILD_AFLAGS	+= -fno-pic
+LDFLAGS_vmlinux	+= -N
+
+libs-y		+= arch/i860/lib/ $(LIBGCC)
+
+boot := arch/i860/boot
+
+ifeq ($(KBUILD_EXTMOD),)
+PHONY += vdso_prepare
+vdso_prepare: prepare0
+	$(Q)$(MAKE) $(build)=arch/i860/kernel/vdso include/generated/vdso-offsets.h
+
+prepare: vdso_prepare
+endif
+
+all: vmlinux.bin
+
+PHONY += vmlinux.bin bootdisk
+
+vmlinux.bin: vmlinux
+	$(Q)$(MAKE) $(build)=$(boot) $(boot)/$@
+
+bootdisk: vmlinux.bin
+	$(Q)$(MAKE) $(build)=$(boot) $(boot)/bootdisk.img
+
+archclean:
+	$(Q)$(MAKE) $(clean)=$(boot)
+
+define archhelp
+  echo  '* vmlinux.bin	- Raw kernel image (arch/$(ARCH)/boot/vmlinux.bin)'
+  echo  '  bootdisk	- SCSI disk image with boot block and kernel'
+endef
