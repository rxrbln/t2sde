[F] CROSS

[L] MIT
[V] 1.27.1

[D] 0e3e8ea921f390fd77ec89dcb1d303dc1914a2b6cdf4ea82e311d34e go-delve-v1.27.1.tar.gz https://github.com/go-delve/delve/archive/v1.27.1/

. $base/package/*/*/go-conf.in

export CGO_ENABLED=1
GCC_WRAPPER_BYPASS=1
xsrcdir=delve-$ver
rungo=
var_append makeopt ' ' build
hook_add postmake 5 'install -Dvm 755 dlv $root$bindir/'
