[V] 1.27.2

[D] f6d437bf2aab0e2a67b0b5cd71b9d110fbdadd70d83ff54f055bcfa0 go-delve-v1.27.2.tar.gz https://github.com/go-delve/delve/archive/v1.27.2/

. $base/package/*/*/go-conf.in

export CGO_ENABLED=1
GCC_WRAPPER_BYPASS=1
xsrcdir=delve-$ver
rungo=
var_append makeopt ' ' build
hook_add postmake 5 'install -Dvm 755 dlv $root$bindir/'
