+
+/*
+ * C_On_Im(...) defines a constraint set with <n> outputs and <m> inputs.
+ * Each operand should be a sequence of constraint letters as defined by
+ * tcg-target-con-str.h; the constraint combination is inclusive or.
+ */
+C_O0_I1(r)
+C_O0_I2(r, r)
+C_O0_I2(r, rIN)
+C_O0_I2(q, q)
+C_O0_I2(w, r)
+C_O0_I3(q, q, q)
+C_O0_I3(Q, p, q)
+C_O0_I4(r, r, rI, rI)
+C_O0_I4(Q, p, q, q)
+C_O1_I1(r, q)
+C_O1_I1(r, r)
+C_O1_I1(w, r)
+C_O1_I1(w, w)
+C_O1_I1(w, wr)
+C_O1_I2(r, 0, rZ)
+C_O1_I2(r, q, q)
+C_O1_I2(r, r, r)
