Link the found Xrandr and X11 libraries, not their bare names.

--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -287,11 +287,12 @@ endif (NOT MINI18N_INCLUDE_DIR STREQUAL
 # xrandr
 if (NOT APPLE)
 	find_library(XRANDR_LIBRARY Xrandr)
+	find_library(X11_LIBRARY X11)
 	if(XRANDR_LIBRARY)
 		add_definitions(-DHAVE_LIBXRANDR=1)
 		set(yabause_SOURCES ${yabause_SOURCES} scr-x.c)
 		set(yabause_HEADERS ${yabause_HEADERS} screen.h)
-		set(YABAUSE_LIBRARIES ${YABAUSE_LIBRARIES} Xrandr X11)
+		set(YABAUSE_LIBRARIES ${YABAUSE_LIBRARIES} ${XRANDR_LIBRARY} ${X11_LIBRARY})
 	endif()
 endif()
 
