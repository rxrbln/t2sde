The rst2html5 command is the one of the rst2html5 package, use the docutils
rst2html5 writer via a wrapper.

--- libvirt-12.9.0.orig/docs/meson.build
+++ libvirt-12.9.0/docs/meson.build
@@ -171,7 +171,7 @@ docs_qemu_api_xml = docs_api_generated[2
 docs_admin_api_xml = docs_api_generated[3]
 
 docs_programs_groups = [
-  { 'name': 'rst2html5', 'prog': [ 'rst2html5', 'rst2html5.py', 'rst2html5-3' ] },
+  { 'name': 'rst2html5', 'prog': [ 'rst2html5-docutils.py', 'rst2html5', 'rst2html5.py', 'rst2html5-3' ] },
   { 'name': 'rst2man', 'prog': [ 'rst2man', 'rst2man.py', 'rst2man-3' ] },
 ]
 
--- libvirt-12.9.0.orig/docs/rst2html5-docutils.py
+++ libvirt-12.9.0/docs/rst2html5-docutils.py
@@ -0,0 +1,5 @@
+#!/usr/bin/env python3
+
+from docutils.core import rst2html5
+
+rst2html5()
