diff --git a/src/cpu/core_dynrec/risc_mips64.h b/src/cpu/core_dynrec/risc_mips64.h
new file mode 100644
--- /dev/null
+++ b/src/cpu/core_dynrec/risc_mips64.h
@@ -0,0 +1,1314 @@
+/*
