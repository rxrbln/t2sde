+// ADC/SBB, with an inline evaluated carry passed to func_cf if possible
+static void dyn_carry_op_gencall(void* simple,void* func,void* simple_cf,void* func_cf,Bitu ftype) {
+	AcquireFlags(FLAG_CF);
+#if defined(DRC_USE_INLINE_CARRY)
+	DRC_PTR_SIZE_IM slow;
+	if (dyn_carry_to_reg(drc_flags_type_guess,FC_OP3,slow)) {
+		InvalidateFlagsPartially(simple_cf,ftype|DRC_FTYPE_CF);
+		gen_call_function_raw(func_cf);
+		DRC_PTR_SIZE_IM done=gen_create_jump();
+		gen_fill_branch(slow);
+		gen_call_function_raw(func);
+		gen_fill_jump(done);
+		return;
+	}
+#endif
+	InvalidateFlagsPartially(simple,ftype);
+	gen_call_function_raw(func);
+}
