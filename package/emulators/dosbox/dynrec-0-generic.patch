+		case 1: gen_mov_byte_from_reg_low(reg,&val.byte[BL_INDEX]); break;
+		case 2: gen_mov_word_from_reg(reg,&val.word[W_INDEX],false); break;
+		default: gen_mov_word_from_reg(reg,&val.dword[DW_INDEX],true); break;
+	}
