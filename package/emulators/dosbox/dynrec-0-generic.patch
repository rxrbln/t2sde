+// branch to the returned location if lflags.type differs from type
+static DRC_PTR_SIZE_IM dyn_lflags_type_differs(HostReg reg,Bitu type) {
+	// lflags.type is a Bitu, compare its lower 32bit
+#if defined(WORDS_BIGENDIAN)
+	gen_mov_word_to_reg(reg,(Bit8u*)&lflags.type+sizeof(lflags.type)-4,true);
+#else
+	gen_mov_word_to_reg(reg,&lflags.type,true);
+#endif
+	gen_add_imm(reg,(Bit32u)(-(Bit32s)type));
+	return gen_create_branch_on_nonzero(reg,true);
+}
+
+#endif
