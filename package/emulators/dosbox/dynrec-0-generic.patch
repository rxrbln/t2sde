+void CacheBlockDynRec::Unlink(Bitu ind) {
+	if (link[ind].to==&link_blocks[ind]) return;
+	// not linked to the standard linkcode, find the block that links to this block
+	CacheBlockDynRec * * wherelink=&link[ind].to->link[ind].from;
+	while (*wherelink != this && *wherelink) {
+		wherelink = &(*wherelink)->link[ind].next;
+	}
+	// now remove the link
+	if(*wherelink)
+		*wherelink = (*wherelink)->link[ind].next;
+	else {
+		LOG(LOG_CPU,LOG_ERROR)("Cache anomaly. please investigate");
+	}
+	ResetLink(ind);
+}
+
+void CacheBlockDynRec::ResetLink(Bitu ind) {
+	link[ind].to=&link_blocks[ind];
+	link[ind].next=0;
+#if defined(DRC_USE_LINK_PATCH)
+	if (link[ind].patched) {
+		gen_link_unpatch(link[ind].site,link[ind].saved);
+		link[ind].patched=false;
+	}
+#endif
+}
