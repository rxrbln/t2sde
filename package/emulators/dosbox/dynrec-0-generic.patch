+#if defined(DRC_USE_INLINE_CARRY)
+// evaluate CF of the guessed last flags operation into reg, slow is set to
+// the branch taken if lflags.type differs at runtime; TEMP_REG_DRC is destroyed
+static bool dyn_carry_to_reg(Bitu type,HostReg reg,DRC_PTR_SIZE_IM & slow) {
+	enum { CF_SUB, CF_ADD, CF_ZERO, CF_FLAGS } cl;
+	Bitu size;
+	switch (type) {
+		case t_CMPb: case t_SUBb: cl=CF_SUB; size=1; break;
+		case t_CMPw: case t_SUBw: cl=CF_SUB; size=2; break;
+		case t_CMPd: case t_SUBd: cl=CF_SUB; size=4; break;
+		case t_ADDb: cl=CF_ADD; size=1; break;
+		case t_ADDw: cl=CF_ADD; size=2; break;
+		case t_ADDd: cl=CF_ADD; size=4; break;
+		case t_ANDb: case t_ORb: case t_XORb: case t_TESTb:
+		case t_ANDw: case t_ORw: case t_XORw: case t_TESTw:
+		case t_ANDd: case t_ORd: case t_XORd: case t_TESTd: cl=CF_ZERO; size=4; break;
+		// the carry is kept in reg_flags
+		case t_UNKNOWN: case t_INCb: case t_INCw: case t_INCd:
+		case t_DECb: case t_DECw: case t_DECd: cl=CF_FLAGS; size=4; break;
+		default: return false;
+	}
+	slow=dyn_lflags_type_differs(reg,type);
+	switch (cl) {
+		case CF_SUB:
+			dyn_load_lflag(reg,lflags.var1,size,false);
+			dyn_load_lflag(TEMP_REG_DRC,lflags.var2,size,false);
+			gen_set_condition(reg,reg,TEMP_REG_DRC,DRC_COND_LU);
+			break;
+		case CF_ADD:
+			dyn_load_lflag(reg,lflags.res,size,false);
+			dyn_load_lflag(TEMP_REG_DRC,lflags.var1,size,false);
+			gen_set_condition(reg,reg,TEMP_REG_DRC,DRC_COND_LU);
+			break;
+		case CF_FLAGS:
+			gen_mov_word_to_reg(reg,DRC_LOW32(reg_flags),true);
+			gen_and_imm(reg,FLAG_CF);
+			break;
+		default:
+			gen_mov_dword_to_reg_imm(reg,0);
+			break;
+	}
+	return true;
+}
+#endif
