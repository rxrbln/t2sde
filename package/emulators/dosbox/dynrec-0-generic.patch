+// store the flags type, done after the call stanza as it is harmless if the
+// stanza is replaced by the simple function: all flags are set again later
+static void dyn_store_lflags_type(Bitu type) {
+	gen_mov_dword_to_reg_imm(TEMP_REG_DRC,(Bit32u)type);
+	gen_mov_word_from_reg(TEMP_REG_DRC,DRC_LOW32(lflags.type),true);
+}
+
+// extend the result, done after the call stanza as the simple function
+// result is the same when extended again
+static void dyn_extend_result(Bitu size) {
+	if (size==1) gen_extend_byte(false,FC_RETOP);
+	else if (size==2) gen_extend_word(false,FC_RETOP);
+	else gen_canonical_dword(FC_RETOP);
+}
+
+// flag-setting dual operation inline in place of the call to the full function,
+// within the call stanza that is replaced when the flags are not needed
+static bool dyn_dop_flags_inline(DrcAluOp op,Bitu size,Bitu type,bool result) {
+	Bit8u * start=cache.pos;
+	dyn_store_lflag(FC_OP1,lflags.var1,size);
+	dyn_store_lflag(FC_OP2,lflags.var2,size);
+	gen_alu_op(op,FC_RETOP,FC_OP1,FC_OP2);
+	dyn_store_lflag(FC_RETOP,lflags.res,size);
+	if (!gen_close_call_stanza(start)) {
+		cache.pos=start;
+		return false;
+	}
+	if (result) dyn_extend_result(size);
+	dyn_store_lflags_type(type);
+	drc_next_call_patchable=false;
+	return true;
+}
+
+// flag-setting shift inline, a zero count keeps the operand and all flags
+static bool dyn_shift_flags_inline(DrcShiftOp op,Bitu size,Bitu type) {
+	Bit8u * start=cache.pos;
+	// a zero count branches over everything with the operand as result
+	DRC_PTR_SIZE_IM skip=gen_branch_zero_keep(FC_OP2,FC_RETOP,FC_OP1);
+	dyn_store_lflag(FC_OP1,lflags.var1,size);
+	gen_mov_byte_from_reg_low(FC_OP2,&lflags.var2.byte[BL_INDEX]);
+	gen_shift_op(op,FC_RETOP,FC_OP1,FC_OP2,size);
+	if (!gen_close_call_stanza(start)) {
+		cache.pos=start;
+		return false;
+	}
+	dyn_extend_result(size);
+	dyn_store_lflag(FC_RETOP,lflags.res,size);
+	dyn_store_lflags_type(type);
+	gen_fill_branch(skip);
+	drc_next_call_patchable=false;
+	return true;
+}
+#endif
