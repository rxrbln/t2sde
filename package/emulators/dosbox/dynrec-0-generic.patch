+// flag-setting shift, replaceable by simple when the flags are not needed
+static void dyn_shift_flags_call(void* simple,void* func,Bitu type,DrcShiftOp op,Bitu size) {
+	InvalidateFlagsPartially(simple,type);
+#if defined(DRC_USE_INLINE_FLAGS_OPS)
+	if (dyn_shift_flags_inline(op,size,type)) return;
+#endif
+	gen_call_function_raw(func);
+}
