  *  it under the terms of the GNU General Public License as published by
@@ -414,6 +415,61 @@ public:
 		}
 		writeCache<Bit32u>( addr, val );
 	}
+	template <bool fill>
+	static INLINE Bit8u blockByte(const Bit8u * src,Bit32u val,Bitu size,Bitu i) {
+		return fill ? (Bit8u)(val >> ((i & (size-1)) * 8)) : src[i];
+	}
+	// write a run of bytes; the chained layout keeps each aligned group of
+	// 4 bytes together in vga.mem.linear, at a stride of 16 bytes
+	template <bool fill>
+	void writeBlock(PhysPt addr,const Bit8u * src,Bit32u val,Bitu size,Bitu len) {
+		PhysPt phys = PAGING_GetPhysicalAddress(addr);
+		PhysPt start = CHECKED((phys & vgapages.mask) + vga.svga.bank_write_full);
+		if (((phys & vgapages.mask) + len - 1 != ((phys + len - 1) & vgapages.mask)) ||
+			(CHECKED(start + len - 1) != start + len - 1)) {
+			// the run wraps, write it byte by byte
+			for (Bitu i=0;i<len;i++) {
+				PhysPt a = CHECKED(((phys+i) & vgapages.mask) + vga.svga.bank_write_full);
+				Bit8u b = blockByte<fill>(src,val,size,i);
+				MEM_CHANGED( a );
+				writeHandler<Bit8u>( a, b );
+				writeCache<Bit8u>( a, b );
+			}
+			return;
+		}
+#ifdef VGA_KEEP_CHANGES
+		for (PhysPt a=start;a<start+len;a+=1<<VGA_CHANGE_SHIFT) MEM_CHANGED( a );
+		MEM_CHANGED( start + len - 1 );
+#endif
+		Bitu i=0;
+		for (;i<len && ((start+i) & 3);i++)
+			writeHandler<Bit8u>( start+i, blockByte<fill>(src,val,size,i) );
+		if (i+4<=len) {
+			Bit8u group[4];
+			if (fill) for (Bitu k=0;k<4;k++) group[k]=blockByte<true>(src,val,size,i+k);
+			for (;i+4<=len;i+=4)
+				memcpy( &vga.mem.linear[(start+i)<<2], fill ? group : src+i, 4 );
+		}
+		for (;i<len;i++)
+			writeHandler<Bit8u>( start+i, blockByte<fill>(src,val,size,i) );
+		// the cache is linear, the first line is replicated
+		Bit8u * cache = &vga.fastmem[start];
+		if (!fill) memcpy( cache, src, len );
+		else if (size == 1) memset( cache, (Bit8u)val, len );
+		else for (i=0;i<len;i++) cache[i] = blockByte<true>(src,val,size,i);
+		if (GCC_UNLIKELY(start < 320)) {
+			Bitu first = 320 - start < len ? 320 - start : len;
+			memcpy( cache + 64*1024, cache, first );
+		}
+	}
+	bool writeblock(PhysPt addr,const Bit8u * src,Bitu len) {
+		writeBlock<false>( addr, src, 0, 1, len );
+		return true;
+	}
+	bool fillblock(PhysPt addr,Bit32u val,Bitu size,Bitu len) {
+		writeBlock<true>( addr, NULL, val, size, len );
+		return true;
+	}
 };
 
