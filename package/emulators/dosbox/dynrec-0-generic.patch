+// INC/DEC keep the carry, which is evaluated before the call stanza and
+// stored to reg_flags inside it; that code is skipped with the simple function
+static void dyn_incdec_call(void* simple,void* func,Bitu type,bool inc,Bitu size) {
+#if defined(DRC_USE_INLINE_FLAGS_OPS) && defined(DRC_USE_INLINE_CARRY)
+	Bit8u * pre=cache.pos;
+	DRC_PTR_SIZE_IM slow;
+	if (dyn_carry_to_reg(drc_flags_type_guess,FC_OP3,slow)) {
+		HostReg one=RegParams[3];
+		gen_mov_dword_to_reg_imm(one,1);
+		gen_alu_op(DRC_ALU_XOR,FC_OP3,FC_OP3,one);
+		gen_mov_dword_to_reg_imm(FC_OP2,inc ? 1 : 0xffffffff);
+		InvalidateFlagsPartially(simple,type);
+		Bit8u * start=cache.pos;
+		// reg_flags = (reg_flags | CF) ^ !carry
+		gen_mov_word_to_reg(TEMP_REG_DRC,DRC_LOW32(reg_flags),true);
+		gen_alu_op(DRC_ALU_OR,TEMP_REG_DRC,TEMP_REG_DRC,one);
+		gen_alu_op(DRC_ALU_XOR,TEMP_REG_DRC,TEMP_REG_DRC,FC_OP3);
+		gen_mov_word_from_reg(TEMP_REG_DRC,DRC_LOW32(reg_flags),true);
+		dyn_store_lflag(FC_OP1,lflags.var1,size);
+		gen_alu_op(DRC_ALU_ADD,FC_RETOP,FC_OP1,FC_OP2);
+		if (gen_close_call_stanza(start)) {
+			mf_functions[mf_functions_num-1].pre=pre;
+			dyn_extend_result(size);
+			dyn_store_lflag(FC_RETOP,lflags.res,size);
+			dyn_store_lflags_type(type);
+			drc_next_call_patchable=false;
+			DRC_PTR_SIZE_IM done=gen_create_jump();
+			gen_fill_branch(slow);
