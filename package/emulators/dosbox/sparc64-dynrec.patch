+// backends may emit an inline access for memory with a direct host pointer,
+// the returned jump skips the generic code handling all remaining cases
+#if defined(DRC_USE_INLINE_MEMORY)
+#define DRC_MEM_FAST(fast) DRC_PTR_SIZE_IM mem_done=fast
