+#if defined(DRC_USE_INLINE_FLAGS)
+// load a lazy flags value of size bytes, sign or zero extended
+static void dyn_load_lflag(HostReg reg,GenReg32 & val,Bitu size,bool sign) {
+	switch (size) {
+		case 1:
+			gen_mov_byte_to_reg_low(reg,&val.byte[BL_INDEX]);
+			gen_extend_byte(sign,reg);
+			break;
+		case 2:
+			gen_mov_word_to_reg(reg,&val.word[W_INDEX],false);
+			gen_extend_word(sign,reg);
+			break;
+		default:
+			gen_mov_word_to_reg(reg,&val.dword[DW_INDEX],true);
+			break;
+	}
+}
+
+// evaluate the condition inline for the guessed type of the last flags
+// operation, the generic function is called if lflags.type differs
+static bool dyn_branchflag_inline(BranchTypes btype,void* func) {
+	enum { CL_CMP, CL_LOGIC, CL_RES } cl;
+	Bitu type=drc_flags_type_guess;
+	Bitu size;
+	switch (type) {
+		case t_CMPb: case t_SUBb: cl=CL_CMP; size=1; break;
+		case t_CMPw: case t_SUBw: cl=CL_CMP; size=2; break;
+		case t_CMPd: case t_SUBd: cl=CL_CMP; size=4; break;
+		case t_ANDb: case t_ORb: case t_XORb: case t_TESTb: cl=CL_LOGIC; size=1; break;
+		case t_ANDw: case t_ORw: case t_XORw: case t_TESTw: cl=CL_LOGIC; size=2; break;
+		case t_ANDd: case t_ORd: case t_XORd: case t_TESTd: cl=CL_LOGIC; size=4; break;
+		case t_ADDb: case t_ADCb: case t_SBBb: case t_INCb: case t_DECb:
+		case t_NEGb: case t_SHLb: case t_SHRb: case t_SARb: cl=CL_RES; size=1; break;
+		case t_ADDw: case t_ADCw: case t_SBBw: case t_INCw: case t_DECw:
+		case t_NEGw: case t_SHLw: case t_SHRw: case t_SARw: cl=CL_RES; size=2; break;
+		case t_ADDd: case t_ADCd: case t_SBBd: case t_INCd: case t_DECd:
+		case t_NEGd: case t_SHLd: case t_SHRd: case t_SARd: cl=CL_RES; size=4; break;
+		default: return false;
+	}
+	DrcCond cond;
+	bool sign=false;
+	switch (btype) {
+		case BR_Z: cond=DRC_COND_E; break;
+		case BR_NZ: cond=DRC_COND_NE; break;
+		case BR_B: cond=DRC_COND_LU; break;
+		case BR_NB: cond=DRC_COND_GEU; break;
+		case BR_BE: cond=DRC_COND_LEU; break;
+		case BR_NBE: cond=DRC_COND_GU; break;
+		case BR_L: cond=DRC_COND_L; sign=true; break;
+		case BR_NL: cond=DRC_COND_GE; sign=true; break;
+		case BR_LE: cond=DRC_COND_LE; sign=true; break;
+		case BR_NLE: cond=DRC_COND_G; sign=true; break;
+		case BR_S: cond=DRC_COND_NEG; sign=true; break;
+		case BR_NS: cond=DRC_COND_POS; sign=true; break;
+		default: return false;
+	}
+	// with only the result known CF and OF are not available
+	if (cl==CL_RES && btype!=BR_Z && btype!=BR_NZ && btype!=BR_S && btype!=BR_NS) return false;
+
+	// lflags.type is a Bitu, compare its lower 32bit
+#if defined(WORDS_BIGENDIAN)
+	gen_mov_word_to_reg(FC_OP1,(Bit8u*)&lflags.type+sizeof(lflags.type)-4,true);
+#else
+	gen_mov_word_to_reg(FC_OP1,&lflags.type,true);
+#endif
+	gen_add_imm(FC_OP1,(Bit32u)(-(Bit32s)type));
+	DRC_PTR_SIZE_IM slow=gen_create_branch_on_nonzero(FC_OP1,true);
+
+	// subtraction operands compare as the flags of the subtraction, all
+	// others compare the result against zero with cleared CF and OF
+	if (cl==CL_CMP && btype!=BR_S && btype!=BR_NS) {
+		dyn_load_lflag(FC_OP1,lflags.var1,size,sign);
+		dyn_load_lflag(FC_OP2,lflags.var2,size,sign);
+	} else {
+		dyn_load_lflag(FC_OP1,lflags.res,size,true);
+		gen_mov_dword_to_reg_imm(FC_OP2,0);
+	}
+	gen_set_condition(FC_RETOP,FC_OP1,FC_OP2,cond);
+	DRC_PTR_SIZE_IM done=gen_create_jump();
+	gen_fill_branch(slow);
+	gen_call_function_raw(func);
+	gen_fill_jump(done);
+	return true;
+}
+#endif
+
+static void dyn_branchflag_to_reg(BranchTypes btype) {
+	void* func=dyn_branchflag_function(btype);
+#if defined(DRC_USE_INLINE_FLAGS)
+	if (dyn_branchflag_inline(btype,func)) return;
+#endif
+	gen_call_function_raw(func);
 }
 
 
