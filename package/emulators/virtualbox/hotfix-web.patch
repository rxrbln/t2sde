--- VirtualBox-7.2.14/configure.vanilla	2026-07-23 23:59:55.314547277 +0300
+++ VirtualBox-7.2.14/configure	2026-07-24 00:04:12.487832988 +0300
@@ -111,6 +111,7 @@
 WITH_LIBVORBIS=1
 WITH_LIBTPMS=1
 WITH_LIBLZMA=1
+WITH_WEB=1
 BUILD_LIBXML2=
 BUILD_LIBCURL=
 BUILD_LIBSSL=
@@ -2738,6 +2738,10 @@
       [ $WITH_OPENGL -eq 1 ] && WITH_OPENGL=0
       ;;
     --enable-webservice)
+      WITH_WEB=1
+      ;;
+    --disable-webservice)
+      WITH_WEB=0
       ;;
     --enable-vnc)
       WITH_VNC=1
@@ -3076,9 +3077,10 @@
 
 [ -n "$SETUP_WINE" ] && setup_wine
 
-if [ $ONLY_ADDITIONS -eq 0 ]; then
+if [ $ONLY_ADDITIONS -eq 0 -a $WITH_WEB -eq 1 ]; then
   check_gsoap
 else
+  log_failure "webservice disabeled"
   cnf_append "VBOX_WITH_WEBSERVICES" ""
 fi
 
