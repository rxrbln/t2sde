Use /dev/spu as the spufs mount point instead of /spu.

Signed-off-by: René Rebe <rene@exactco.de>

--- a/spebase/create.c
+++ b/spebase/create.c
@@ -33,6 +33,8 @@
 #include "create.h"
 #include "spebase.h"
 
+#define SPUFS_PATH "/dev/spu"
+
 
 struct fd_attr {
 	const char *name;
@@ -246,10 +248,10 @@ spe_context_ptr_t _base_spe_context_crea
 
 	/* Make the SPUFS directory for the SPE */
 	if (gctx == NULL)
-		sprintf(pathname, "/spu/spethread-%i-%lu",
+		sprintf(pathname, SPUFS_PATH "/spethread-%i-%lu",
 			getpid(), (unsigned long)spe);
 	else
-		sprintf(pathname, "/spu/%s/spethread-%i-%lu",
+		sprintf(pathname, SPUFS_PATH "/%s/spethread-%i-%lu",
 			gctx->base_private->gangname, getpid(),
 			(unsigned long)spe);
 
@@ -385,7 +387,7 @@ spe_gang_context_ptr_t _base_spe_gang_co
 
 	sprintf(gctx->base_private->gangname, "gang-%i-%lu", getpid(),
 			(unsigned long)gctx);
-	sprintf(pathname, "/spu/%s", gctx->base_private->gangname);
+	sprintf(pathname, SPUFS_PATH "/%s", gctx->base_private->gangname);
 
 	gctx->base_private->fd_gang_dir = spu_create(pathname, SPU_CREATE_GANG,
 				S_IRUSR | S_IWUSR | S_IXUSR);
