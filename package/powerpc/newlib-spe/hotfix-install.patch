Create the multilib install directory before installing the libgloss
crt objects, avoiding a parallel install race with newlib.

Signed-off-by: René Rebe <rene@exactco.de>

--- a/libgloss/spu/Makefile.in	2026-11-19 18:09:56.992701633 +0100
+++ b/libgloss/spu/Makefile.in	2026-11-19 18:09:57.000703200 +0100
@@ -150,6 +150,7 @@ distclean maintainer-clean realclean: cl
 
 .PHONY: install info install-info clean-info
 install:
+	mkdir -p $(DESTDIR)/${tooldir}/lib${MULTISUBDIR}
 	for outputs in ${OUTPUTS}; do\
 	 ${INSTALL_DATA} $${outputs} $(DESTDIR)/${tooldir}/lib${MULTISUBDIR}/$${outputs}; \
 	done
