[D] a99809ff16803a3645a11a05630a259db06fc0c5a0aec85cd52ba571 swift-6.4.3-RELEASE-ubuntu24.04.tar.gz https://download.swift.org/swift-6.4.3-release/ubuntu2404/swift-6.4.3-RELEASE/
[D] ea73fe6cd11340fd7967ab5c34ffdff21de8c9a3b72c4f8cbb399fa0 swift-6.4.3-RELEASE-ubuntu24.04-aarch64.tar.gz https://download.swift.org/swift-6.4.3-release/ubuntu2404-aarch64/swift-6.4.3-RELEASE/

autoextract=0 createprefix=0 runcmake=0 runmake=0
[ $prefix_auto = 1 ] && prefix=opt/swift && set_confopt

# all sources side by side as build-script expects, the swift.org toolchain
# only as the host compiler to bootstrap the compiler parts written in Swift
swift_extract() {
	local f x d seed=ubuntu24.04
	[ $arch = arm64 ] && seed=$seed-aarch64
	mkdir -p $builddir/swift-project
	cd $builddir/swift-project
	for f in $(match_source_file -p .); do
		x=${f##*/} d=${x%-*}
		case $x in
		*-RELEASE-$seed.tar.gz) d=seed ;;
		*-RELEASE-*) continue ;;
		esac
		mkdir -p $d
		tar $taropt $f -C $d --strip-components=1
	done
}
hook_add customextract 5 swift_extract

swift_build() {
	local llvmtarget=X86 x gccdir=$(dirname $(gcc -print-libgcc-file-name))
	[ $arch = arm64 ] && llvmtarget=AArch64
	# the seed links libtinfo, which is part of libncursesw here
	mkdir -p $builddir/seed-lib
	ln -sf $(pkgprefix libdir ncurses)/libncursesw.so.6 $builddir/seed-lib/libtinfo.so.6
	# its lld needs libxml2.so.2, use the system one
	ln -sf $(type -p ld.lld) $builddir/swift-project/seed/usr/bin/ld.lld
	# and its clang does not know the T2 gcc triple
	for x in clang clang++; do
		echo "--gcc-install-dir=$gccdir" > $builddir/swift-project/seed/usr/bin/$x.cfg
	done
	x=$builddir/swift-project/seed/usr/bin/swift-frontend
	[ -e $x.real ] || mv $x $x.real
	cat > $x <<-EOF
	#!/bin/bash
	[ "\$1" = -frontend ] && shift && set -- -frontend -Xcc --gcc-install-dir=$gccdir "\$@"
	exec -a "\$0" $x.real "\$@"
	EOF
	chmod +x $x
	CC=clang CXX=clang++ LD_LIBRARY_PATH=$builddir/seed-lib PATH=$builddir/swift-project/seed/usr/bin:$PATH \
	swift/utils/build-script \
		--release --no-assertions --bootstrapping=hosttools --build-subdir=t2 \
		--jobs=$SDECFG_PARALLEL --relocate-xdg-cache-home-under-build-subdir \
		--host-cc=$(type -p clang) --host-cxx=$(type -p clang++) --use-linker=lld \
		--llvm-targets-to-build=$llvmtarget --skip-build-benchmarks \
		--llbuild --swiftpm --swift-driver --swift-testing --swift-testing-macros \
		--xctest --foundation --libdispatch \
		--install-llvm --install-swift --install-llbuild --install-swiftpm \
		--install-swift-driver --install-swiftsyntax --install-swift-testing \
		--install-swift-testing-macros --install-xctest --install-foundation \
		--install-libdispatch --install-prefix=/$prefix/usr --install-destdir=${root:-/} \
		--swift-install-components='autolink-driver;compiler;clang-resource-dir-symlink;libexec;stdlib;swift-remote-mirror;sdk-overlay;static-mirror-lib;toolchain-tools;license;sourcekit-inproc' \
		--llvm-install-components='llvm-ar;llvm-nm;llvm-ranlib;llvm-cov;llvm-profdata;llvm-objdump;llvm-objcopy;llvm-symbolizer;IndexStore;clang;clang-resource-headers;builtins;runtimes;lld;LTO;clang-features-file' || return
	# swiftpm finds the toolchain as <toolchain>/usr/bin/swiftc, only the swift
	# tools in the PATH, not the toolchain's own clang and lld
	mkdir -p $root/$prefix/bin
	for x in $root/$prefix/usr/bin/swift*; do
		ln -sf ../usr/bin/${x##*/} $root/$prefix/bin/
	done
}
hook_add inmake 5 swift_build
