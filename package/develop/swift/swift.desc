var_append cmakeopt ' ' -DSWIFT_INCLUDE_TOOLS=NO
var_append cmakeopt ' ' "-DLLVM_DIR=$(pkgprefix libdir llvm)/cmake/llvm -DLLVM_BUILD_LIBRARY_DIR=$(pkgprefix libdir llvm)"
var_append cmakeopt ' ' -DSWIFT_NATIVE_CLANG_TOOLS_PATH=$(pkgprefix bindir clang)
var_append cmakeopt ' ' -DSWIFT_ENABLE_DISPATCH=FALSE
