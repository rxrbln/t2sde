Only use distcc pump when --distcc is requested, not whenever pump is installed.

--- a/swift/utils/swift_build_support/swift_build_support/products/cmake_product.py
+++ b/swift/utils/swift_build_support/swift_build_support/products/cmake_product.py
@@ -31,7 +31,7 @@ class CMakeProduct(product.Product):
         _cmake = cmake.CMake(self.args, self.toolchain,
                              prefer_native_toolchain)
 
-        if self.toolchain.distcc_pump:
+        if self.args.distcc and self.toolchain.distcc_pump:
             cmake_build.append(self.toolchain.distcc_pump)
         cmake_build.extend([self.toolchain.cmake, "--build"])
 
@@ -59,7 +59,7 @@ class CMakeProduct(product.Product):
             open(os.path.join(query_dir, "cache-v2"), 'a').close()
 
             env = None
-            if self.toolchain.distcc:
+            if self.args.distcc and self.toolchain.distcc:
                 env = {
                     "DISTCC_HOSTS": "localhost,lzo,cpp"
                 }
@@ -87,7 +87,7 @@ class CMakeProduct(product.Product):
         cmake_build = []
         _cmake = cmake.CMake(self.args, self.toolchain)
 
-        if self.toolchain.distcc_pump:
+        if self.args.distcc and self.toolchain.distcc_pump:
             cmake_build.append(self.toolchain.distcc_pump)
 
         # If we are verbose...
@@ -120,7 +120,7 @@ class CMakeProduct(product.Product):
         assert self.toolchain.cmake is not None
         cmake_build = []
 
-        if self.toolchain.distcc_pump:
+        if self.args.distcc and self.toolchain.distcc_pump:
             cmake_build.append(self.toolchain.distcc_pump)
         cmake_args = [self.toolchain.cmake, "--build", self.build_dir, "--"]
         cmake_build.extend(cmake_args + install_targets)
