[I] WebAssembly runtime

[T] WasmEdge is a lightweight, high-performance, and extensible WebAssembly
[T] runtime for cloud native, edge, and decentralized applications. It powers
[T] serverless apps, embedded functions, microservices, smart contracts, and
[T] IoT devices.

[U] https://wasmedge.org/

[A] WasmEdge
[M] andrei32

[C] extra/base
[F] CROSS

[L] APL
[V] 0.18.1

[D] 6ba618755b0ccefb36a27506eb1e201e573c66ec44b6112a20e53c1c wasmedge-0.18.1.tar.gz https://github.com/WasmEdge/WasmEdge/archive/0.18.1/

var_append cmakeopt ' ' -DBUILD_SHARED_LIBS=OFF
case $arch in
	x86-64|arm64|riscv64|arm|s390x) ;;
	*) var_append cmakeopt ' ' -DWASMEDGE_USE_LLVM=OFF ;;
esac
