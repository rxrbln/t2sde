[CV-GROUP] llvm-project
[D] f4974ba23211e538b35ee0e72ed9f1e76bd4f135e44aa289dd2e020f llvm-project-23.1.0.src.tar.xz https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.0/

# TODO: sync w/ wasi-libc
[ $prefix_auto = 1 ] && prefix=opt/wasi && set_confopt

runmake=0 rungpepinstall=0

. $base/package/*/*/wasi.in

export DESTDIR=$root
export CC=clang CXX=clang++ # LD=clang
export CFLAGS="-fno-exceptions --sysroot=$root/$prefix"
export CXXFLAGS="-fno-exceptions --sysroot=$root/$prefix"

cmakeopt=
var_append cmakeopt ' ' "-DUNIX=ON \
-DCMAKE_TOOLCHAIN_FILE=$confdir/../wasi-libc/wasi-sdk.cmake \
-DCMAKE_C_COMPILER_WORKS=ON -DCMAKE_CXX_COMPILER_WORKS=ON \
-DCMAKE_STAGING_PREFIX=/opt/wasi"

var_append cmakeopt ' ' "-DLIBCXX_ABI_VERSION=2 \
-DLIBCXX_CXX_ABI=libcxxabi \
-DLIBCXX_ENABLE_EXCEPTIONS=OFF \
-DLIBCXX_ENABLE_FILESYSTEM=ON \
-DLIBCXX_ENABLE_SHARED=OFF \
-DLIBCXX_ENABLE_THREADS=OFF \
-DLIBCXX_USE_COMPILER_RT=YES \
-DLIBCXX_HAS_MUSL_LIBC=ON \
-DLIBCXX_INCLUDE_BENCHMARKS=OFF \
-DLIBCXX_LIBDIR_SUFFIX=/wasm32-wasip1"

var_append cmakeopt ' ' "-DLIBCXXABI_ENABLE_EXCEPTIONS=OFF \
-DLIBCXXABI_ENABLE_PIC=OFF \
-DLIBCXXABI_ENABLE_SHARED=OFF \
-DLIBCXXABI_ENABLE_THREADS=OFF \
-DLIBCXXABI_USE_LLVM_UNWINDER=OFF \
-DLIBCXXABI_USE_COMPILER_RT=ON \
-DLIBCXXABI_LIBDIR_SUFFIX=/wasm32-wasip1 \
-DLIBCXXABI_INCLUDE_TESTS=OFF \
-DLIBCXXABI_SILENT_TERMINATE:BOOL=ON"

# since llvm-23 in-tree libcxxabi targets require a unified runtimes build
build_libcxx() {
	eval cmake -B objs $cmakeopt \
		"-DLLVM_ENABLE_RUNTIMES='libcxx;libcxxabi'" runtimes
	cmake --build objs
	cmake --install objs
}
hook_add inmake 5 build_libcxx
