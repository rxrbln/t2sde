diff --git a/ld/testsuite/ld-i860/tls-static.d b/ld/testsuite/ld-i860/tls-static.d
new file mode 100644
index 00000000000..874aae67afc
--- /dev/null
+++ b/ld/testsuite/ld-i860/tls-static.d
@@ -0,0 +1,11 @@
+#source: tls.s
+#ld: -static -e f
+#objdump: -s -j .got
+#name: i860 TLS GOT entries in a static link
+
+.*: +file format .*
+
+Contents of section \.got:
+ [0-9a-f]+ 00000000 00000000 00000000 01000000 .*
+ [0-9a-f]+ 04000000 fcffffff 01000000 00000000 .*
+ [0-9a-f]+ f4ffffff +.*
diff --git a/ld/testsuite/ld-i860/tls.s b/ld/testsuite/ld-i860/tls.s
new file mode 100644
index 00000000000..717c9a50fa4
--- /dev/null
+++ b/ld/testsuite/ld-i860/tls.s
@@ -0,0 +1,20 @@
+	.section .tdata,"awT",@progbits
+	.globl	gtd
+	.type	gtd,@object
+gtd:	.long	0x1234
+ltd:	.long	0x5678
+	.section .tbss,"awT",@nobits
+ltb:	.long	0
+	.text
+	.globl	f
+f:
+	orh	[gtd]@tlsgd@h,%r0,%r31
+	or	[gtd]@tlsgd@l,%r31,%r31
+	orh	[ltd]@tlsgd@h,%r0,%r31
+	or	[ltd]@tlsgd@l,%r31,%r31
+	orh	[gtd]@gottpoff@ha,%r0,%r31
+	addu	%r15,%r31,%r31
+	ld.l	[gtd]@gottpoff@l(%r31),%r16
+	orh	[ltb]@gottpoff@ha,%r0,%r31
+	addu	%r15,%r31,%r31
+	ld.l	[ltb]@gottpoff@l(%r31),%r16
