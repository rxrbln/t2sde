+# This tests the XP-only instructions:
+#  ldint.x, ldio.x, stio.x, scyc.b, pfld.q
+# And control registers:
+#  %bear, %ccr, %p0, %p1, %p2, %p3
+
+	.text
+
+	# XP-only control registers
+	ld.c	%bear,%r31
+	ld.c	%bear,%r0
+	ld.c	%ccr,%r5
+	ld.c	%ccr,%r30
+	ld.c	%p0,%r10
