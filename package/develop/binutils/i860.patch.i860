+#define elf_backend_reloc_type_class		i860_reloc_type_class
+#define elf_backend_copy_indirect_symbol	i860_copy_indirect_symbol
+#define elf_backend_create_dynamic_sections	_bfd_elf_create_dynamic_sections
+#define elf_backend_adjust_dynamic_symbol	i860_adjust_dynamic_symbol
+#define elf_backend_late_size_sections		i860_late_size_sections
+#define elf_backend_finish_dynamic_symbol	i860_finish_dynamic_symbol
+#define elf_backend_finish_dynamic_sections	i860_finish_dynamic_sections
+#define bfd_elf32_bfd_link_hash_table_create	i860_link_hash_table_create
+#define bfd_elf32_bfd_reloc_type_lookup		elf32_i860_reloc_type_lookup
+#define bfd_elf32_bfd_reloc_name_lookup	elf32_i860_reloc_name_lookup
+#define bfd_elf32_bfd_is_local_label_name	elf32_i860_is_local_label_name
+
+#include "elf32-target.h"
