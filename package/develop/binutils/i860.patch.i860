+    targ_defvec=i860_elf32_le_vec
+    targ_selvecs="i860_elf32_vec i860_elf32_le_vec"
+    ;;
+  i860-*-sysv4* | i860-*-elf*)
+    targ_defvec=i860_elf32_vec
+    ;;
