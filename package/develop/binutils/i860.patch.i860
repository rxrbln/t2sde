new file mode 100644
index 00000000000..d43d73e46a3
--- /dev/null
+++ b/gas/testsuite/gas/i860/dual02-err.l
@@ -0,0 +1,2 @@
+.*: Assembler messages:
+.*:7: Error: 'd\.fadd\.ss' must be 8-byte aligned
diff --git a/gas/testsuite/gas/i860/dual02-err.s b/gas/testsuite/gas/i860/dual02-err.s
new file mode 100644
index 00000000000..05d1835c062
--- /dev/null
+++ b/gas/testsuite/gas/i860/dual02-err.s
@@ -0,0 +1,9 @@
+# Dual-mode pairs must be aligned on an 8-byte boundary.  This tests
+# that an error is reported if not properly aligned.
+
+	.text
+	.align 8
+	nop
+	d.fadd.ss	%f3,%f5,%f7
+	addu	%r4,%r5,%r6
+
