diff --git a/ld/configure.tgt b/ld/configure.tgt
index 60b62e69c08..8dad857967c 100644
--- a/ld/configure.tgt
+++ b/ld/configure.tgt
@@ -1,6 +1,7 @@
 # configure.tgt
 #
 #   Copyright (C) 2013-2026 Free Software Foundation, Inc.
+#   Copyright (C) 2026 René Rebe <rene@exactco.de>
 #
 # This file is free software; you can redistribute it and/or modify
 # it under the terms of the GNU General Public License as published by
@@ -70,7 +71,9 @@ if test "${ac_default_ld_warn_execstack}" = 2; then
       # The HPPA port needs to support older kernels that
       # use executable stacks for signals and syscalls.
       # Many MIPS targets use executable stacks.
+      # The i860 MMU has no execute permission for an executable stack to add.
     hppa*-*-* | \
+    i860-*-* | \
     mips*-*-*)
       ac_default_ld_warn_execstack=0
       ;;
@@ -428,6 +431,9 @@ i[3-7]86-*-chaos)	targ_emul=elf_i386_chaos
 ia16-*-elf*)		targ_emul=elf_i386
 			targ_extra_emuls=i386msdos
 			;;
+i860-stardent-sysv4* | i860-stardent-elf* | i860-*-linux*)
+			targ_emul=elf32_i860
+			;;
 ia64-*-elf*)		targ_emul=elf64_ia64
 			;;
 ia64-*-freebsd* | ia64-*-kfreebsd*-gnu)
diff --git a/ld/emulparams/elf32_i860.sh b/ld/emulparams/elf32_i860.sh
new file mode 100644
index 00000000000..a3803ac6a3d
--- /dev/null
+++ b/ld/emulparams/elf32_i860.sh
@@ -0,0 +1,24 @@
+# A work in progress...
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+SCRIPT_NAME=elf
+TEMPLATE_NAME=generic
+EXTRA_EM_FILE=genelf
+OUTPUT_FORMAT="elf32-i860-little"
+BIG_OUTPUT_FORMAT="elf32-i860"
+LITTLE_OUTPUT_FORMAT="elf32-i860-little"
+NO_REL_RELOCS=yes
+TEXT_START_ADDR=0
+PAGE_SIZE=0x1000
+MAXPAGESIZE="CONSTANT (MAXPAGESIZE)"
+ARCH=i860
+
+case "$target" in
+  i860-*-linux*)
+    TEMPLATE_NAME=elf
+    EXTRA_EM_FILE=
+    TEXT_START_ADDR=0x10000
+    GENERATE_SHLIB_SCRIPT=yes
+    GENERATE_PIE_SCRIPT=yes
+    COMMONPAGESIZE="CONSTANT (COMMONPAGESIZE)"
+    ;;
+esac
