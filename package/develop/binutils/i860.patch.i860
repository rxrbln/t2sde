diff --git a/gas/testsuite/gas/i860/regress01.s b/gas/testsuite/gas/i860/regress01.s
new file mode 100644
index 00000000000..002c3bdc467
--- /dev/null
+++ b/gas/testsuite/gas/i860/regress01.s
@@ -0,0 +1,19 @@
+# Test fst.* with and without auto-increment.
+
+	.text
+
+        fst.l   %f16,-16(%sp)
+        fst.l   %f20,-16(%sp)
+        fst.l   %f24,-16(%sp)
+
+        fst.l   %f16,-16(%sp)++
+        fst.l   %f20,-16(%sp)++
+        fst.l   %f24,-16(%sp)++
+
+        fst.q   %f16,-16(%sp)
+        fst.q   %f20,-16(%sp)
+        fst.q   %f24,-16(%sp)
+
+        fst.q   %f16,-16(%sp)++
+        fst.q   %f20,-16(%sp)++
+        fst.q   %f24,-16(%sp)++
