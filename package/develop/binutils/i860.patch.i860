+	andnot	%r18,%r19,%r20
+	andnot	%r21,%r22,%r23
+	andnot	%r24,%r25,%r26
+	andnot	%r27,%r28,%r29
+	andnot	%r30,%r31,%r0
+
+	or	%r0,%r1,%r2
+	or	%r3,%r4,%r5
+	or	%r6,%r7,%r8
+	or	%r9,%r10,%r11
+	or	%r12,%r13,%r14
+	or	%r15,%r16,%r17
+	or	%r18,%r19,%r20
+	or	%r21,%r22,%r23
+	or	%r24,%r25,%r26
+	or	%r27,%r28,%r29
+	or	%r30,%r31,%r0
+
+	xor	%r0,%r1,%r2
+	xor	%r3,%r4,%r5
+	xor	%r6,%r7,%r8
+	xor	%r9,%r10,%r11
+	xor	%r12,%r13,%r14
+	xor	%r15,%r16,%r17
+	xor	%r18,%r19,%r20
+	xor	%r21,%r22,%r23
+	xor	%r24,%r25,%r26
+	xor	%r27,%r28,%r29
+	xor	%r30,%r31,%r0
+
+	# Immediate forms (all)
+	and	0,%r1,%r2
+	and	8192,%r4,%r5
+	and	5109,%r7,%r8
+	and	32768,%r10,%r11
+	and	65000,%r13,%r14
