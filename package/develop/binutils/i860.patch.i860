+	andh	5110,%r7,%r8
+	andh	32769,%r10,%r11
+	andh	65001,%r13,%r14
+	andh	65535,%r16,%r17
+	andh	0xffff,%r19,%r20
+	andh	0xabcd,%r22,%r23
+	andh	0x1234,%r25,%r26
+	andh	0x0,%r28,%r29
+	andh	0x3,%r31,%r0
+
+	andnot	0,%r1,%r2
+	andnot	8192,%r4,%r5
+	andnot	5109,%r7,%r8
+	andnot	32768,%r10,%r11
+	andnot	65000,%r13,%r14
+	andnot	65535,%r16,%r17
+	andnot	0xffff,%r19,%r20
+	andnot	0xabcd,%r22,%r23
+	andnot	0x1234,%r25,%r26
+	andnot	0x0,%r28,%r29
+	andnot	0x3,%r31,%r0
+
+	andnoth	1,%r1,%r2
+	andnoth	8193,%r4,%r5
+	andnoth	5110,%r7,%r8
+	andnoth	32769,%r10,%r11
+	andnoth	65001,%r13,%r14
+	andnoth	65535,%r16,%r17
+	andnoth	0xffff,%r19,%r20
+	andnoth	0xabcd,%r22,%r23
+	andnoth	0x1234,%r25,%r26
+	andnoth	0x0,%r28,%r29
+	andnoth	0x3,%r31,%r0
+
+	or	0,%r1,%r2
+	or	1,%r4,%r5
+	or	2,%r7,%r8
