diff --git a/ld/testsuite/ld-i860/shared-plt.d b/ld/testsuite/ld-i860/shared-plt.d
new file mode 100644
index 00000000000..cca0f57943b
--- /dev/null
+++ b/ld/testsuite/ld-i860/shared-plt.d
@@ -0,0 +1,19 @@
+#source: shared.s
+#ld: -shared
+#objdump: -d -j .plt
+#name: i860 PLT entry
+
+.*: +file format .*
+
+
+Disassembly of section \.plt:
+
+[0-9a-f]+ <\.plt>:
+ +[0-9a-f]+:	00 00 3c a0 	shl	%r0,%r1,%r28
+ +[0-9a-f]+:	01 00 00 6c 	call	.*
+ +[0-9a-f]+:	00 00 00 a0 	shl	%r0,%r0,%r0
+ +[0-9a-f]+:	.. .. 1f ec 	orh	.*,%r0,%r31
+ +[0-9a-f]+:	00 08 ff 83 	addu	%r1,%r31,%r31
+ +[0-9a-f]+:	.. .. ff 17 	ld\.l	.*\(%r31\),%r31
+ +[0-9a-f]+:	00 f8 00 40 	bri	%r31
+ +[0-9a-f]+:	00 00 81 a3 	shl	%r0,%r28,%r1
diff --git a/ld/testsuite/ld-i860/shared-relocs.d b/ld/testsuite/ld-i860/shared-relocs.d
new file mode 100644
index 00000000000..a73ecd1a76f
--- /dev/null
+++ b/ld/testsuite/ld-i860/shared-relocs.d
@@ -0,0 +1,14 @@
+#source: shared.s
+#ld: -shared
+#readelf: -r --wide
+#name: i860 shared library dynamic relocations
+
+Relocation section '\.rela\.dyn' at offset 0x[0-9a-f]+ contains 3 entries:
+ *Offset +Info +Type +Sym\. *Value +Symbol's Name \+ Addend
+[0-9a-f]+ +[0-9a-f]+ +R_860_RELATIVE +[0-9a-f]+
+[0-9a-f]+ +[0-9a-f]+ +R_860_32 +[0-9a-f]+ +gdata \+ 0
+[0-9a-f]+ +[0-9a-f]+ +R_860_GLOB_DAT +[0-9a-f]+ +gdata \+ 0
+
+Relocation section '\.rela\.plt' at offset 0x[0-9a-f]+ contains 1 entry:
+ *Offset +Info +Type +Sym\. *Value +Symbol's Name \+ Addend
+[0-9a-f]+ +[0-9a-f]+ +R_860_JUMP_SLOT +[0-9a-f]+ +bar \+ 0
diff --git a/ld/testsuite/ld-i860/shared.s b/ld/testsuite/ld-i860/shared.s
new file mode 100644
index 00000000000..14ba2c9684b
--- /dev/null
+++ b/ld/testsuite/ld-i860/shared.s
@@ -0,0 +1,32 @@
+	.text
+	.globl	foo
+	.type	foo,@function
+foo:
+	call	1f
+	nop
+1:	orh	[_GLOBAL_OFFSET_TABLE_]@pc@ha,%r0,%r15
+	adds	[_GLOBAL_OFFSET_TABLE_+4]@pc@l,%r15,%r15
+	addu	%r1,%r15,%r15
+	orh	[gdata]@got@ha,%r0,%r31
+	addu	%r15,%r31,%r31
+	ld.l	[gdata]@got@l(%r31),%r16
+	orh	[ldata]@gotoff@h,%r0,%r31
+	or	[ldata]@gotoff@l,%r31,%r31
+	addu	%r15,%r31,%r17
+	br	bar@plt
+	nop
+	.size	foo,.-foo
+	.globl	bar
+	.type	bar,@function
+bar:
+	bri	%r1
+	nop
+	.size	bar,.-bar
+	.data
+	.globl	gdata
+	.type	gdata,@object
+	.size	gdata,4
+gdata:	.long	40
+ldata:	.long	1
+ptr:	.long	gdata
+	.long	ldata
diff --git a/ld/testsuite/ld-i860/static-got.d b/ld/testsuite/ld-i860/static-got.d
