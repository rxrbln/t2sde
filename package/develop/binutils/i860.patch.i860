+
+static unsigned char elf_code_to_howto_index[R_860_max + 1];
+
+static reloc_howto_type *
+lookup_howto (unsigned int rtype)
+{
+  static int initialized = 0;
+  int i;
+  int howto_tbl_size = (int) (sizeof (elf32_i860_howto_table)
+			/ sizeof (elf32_i860_howto_table[0]));
+
+  if (! initialized)
+    {
+      initialized = 1;
+      memset (elf_code_to_howto_index, 0xff,
+	      sizeof (elf_code_to_howto_index));
+      for (i = 0; i < howto_tbl_size; i++)
+	elf_code_to_howto_index[elf32_i860_howto_table[i].type] = i;
+    }
+
+  if (rtype >= R_860_max)
+    return NULL;
+  i = elf_code_to_howto_index[rtype];
+  if (i >= howto_tbl_size)
+    return 0;
+  return elf32_i860_howto_table + i;
+}
+
+/* Given a BFD reloc, return the matching HOWTO structure.  */
+static reloc_howto_type *
+elf32_i860_reloc_type_lookup (bfd *abfd ATTRIBUTE_UNUSED,
+			      bfd_reloc_code_real_type code)
+{
+  unsigned int rtype;
+
+  switch (code)
+    {
+    case BFD_RELOC_NONE:
+      rtype = R_860_NONE;
+      break;
+    case BFD_RELOC_32:
+      rtype = R_860_32;
+      break;
+    case BFD_RELOC_860_COPY:
+      rtype = R_860_COPY;
+      break;
+    case BFD_RELOC_860_GLOB_DAT:
+      rtype = R_860_GLOB_DAT;
+      break;
+    case BFD_RELOC_860_JUMP_SLOT:
+      rtype = R_860_JUMP_SLOT;
+      break;
+    case BFD_RELOC_860_RELATIVE:
+      rtype = R_860_RELATIVE;
+      break;
+    case BFD_RELOC_860_PC26:
+      rtype = R_860_PC26;
+      break;
+    case BFD_RELOC_860_PLT26:
+      rtype = R_860_PLT26;
+      break;
+    case BFD_RELOC_860_PC16:
+      rtype = R_860_PC16;
+      break;
+    case BFD_RELOC_860_LOW0:
+      rtype = R_860_LOW0;
+      break;
+    case BFD_RELOC_860_SPLIT0:
+      rtype = R_860_SPLIT0;
+      break;
+    case BFD_RELOC_860_LOW1:
+      rtype = R_860_LOW1;
+      break;
+    case BFD_RELOC_860_SPLIT1:
+      rtype = R_860_SPLIT1;
+      break;
+    case BFD_RELOC_860_LOW2:
+      rtype = R_860_LOW2;
+      break;
+    case BFD_RELOC_860_SPLIT2:
+      rtype = R_860_SPLIT2;
+      break;
+    case BFD_RELOC_860_LOW3:
+      rtype = R_860_LOW3;
+      break;
+    case BFD_RELOC_860_LOGOT0:
+      rtype = R_860_LOGOT0;
+      break;
+    case BFD_RELOC_860_SPGOT0:
+      rtype = R_860_SPGOT0;
+      break;
+    case BFD_RELOC_860_LOGOT1:
+      rtype = R_860_LOGOT1;
+      break;
+    case BFD_RELOC_860_SPGOT1:
+      rtype = R_860_SPGOT1;
+      break;
+    case BFD_RELOC_860_LOGOTOFF0:
+      rtype = R_860_LOGOTOFF0;
+      break;
+    case BFD_RELOC_860_SPGOTOFF0:
+      rtype = R_860_SPGOTOFF0;
+      break;
+    case BFD_RELOC_860_LOGOTOFF1:
+      rtype = R_860_LOGOTOFF1;
+      break;
+    case BFD_RELOC_860_SPGOTOFF1:
+      rtype = R_860_SPGOTOFF1;
+      break;
+    case BFD_RELOC_860_LOGOTOFF2:
+      rtype = R_860_LOGOTOFF2;
+      break;
+    case BFD_RELOC_860_LOGOTOFF3:
+      rtype = R_860_LOGOTOFF3;
+      break;
+    case BFD_RELOC_860_LOPC:
+      rtype = R_860_LOPC;
+      break;
+    case BFD_RELOC_860_HIGHADJ:
+      rtype = R_860_HIGHADJ;
+      break;
+    case BFD_RELOC_860_HAGOT:
+      rtype = R_860_HAGOT;
+      break;
+    case BFD_RELOC_860_HAGOTOFF:
+      rtype = R_860_HAGOTOFF;
+      break;
+    case BFD_RELOC_860_HAPC:
+      rtype = R_860_HAPC;
+      break;
+    case BFD_RELOC_860_HIGH:
+      rtype = R_860_HIGH;
+      break;
+    case BFD_RELOC_860_HIGOT:
+      rtype = R_860_HIGOT;
+      break;
+    case BFD_RELOC_860_HIGOTOFF:
+      rtype = R_860_HIGOTOFF;
+      break;
+    case BFD_RELOC_860_TLS_GD_HI:
+      rtype = R_860_TLS_GD_HI;
+      break;
+    case BFD_RELOC_860_TLS_GD_LO:
+      rtype = R_860_TLS_GD_LO;
+      break;
+    case BFD_RELOC_860_TLS_IE_HA:
+      rtype = R_860_TLS_IE_HA;
+      break;
+    case BFD_RELOC_860_TLS_IE_LO1:
+      rtype = R_860_TLS_IE_LO1;
+      break;
+    case BFD_RELOC_860_TLS_IE_ABS_HA:
+      rtype = R_860_TLS_IE_ABS_HA;
+      break;
+    case BFD_RELOC_860_TLS_IE_ABS_LO1:
+      rtype = R_860_TLS_IE_ABS_LO1;
+      break;
+    case BFD_RELOC_860_TLS_LE_HI:
+      rtype = R_860_TLS_LE_HI;
+      break;
+    case BFD_RELOC_860_TLS_LE_LO:
+      rtype = R_860_TLS_LE_LO;
+      break;
+    default:
+      rtype = 0;
+      break;
+    }
+  return lookup_howto (rtype);
+}
+
+static reloc_howto_type *
+elf32_i860_reloc_name_lookup (bfd *abfd ATTRIBUTE_UNUSED,
+			      const char *r_name)
+{
+  unsigned int i;
+
+  for (i = 0;
+       i < (sizeof (elf32_i860_howto_table)
+	    / sizeof (elf32_i860_howto_table[0]));
+       i++)
+    if (elf32_i860_howto_table[i].name != NULL
+	&& strcasecmp (elf32_i860_howto_table[i].name, r_name) == 0)
+      return &elf32_i860_howto_table[i];
+
+  return NULL;
+}
+
+/* Given a ELF reloc, return the matching HOWTO structure.  */
+static bool
+elf32_i860_info_to_howto_rela (bfd *abfd,
+			       arelent *bfd_reloc,
+			       Elf_Internal_Rela *elf_reloc)
+{
+  unsigned int r_type = ELF32_R_TYPE (elf_reloc->r_info);
+
+  bfd_reloc->howto = lookup_howto (r_type);
+  if (bfd_reloc->howto == NULL)
+    {
+      /* xgettext:c-format */
+      _bfd_error_handler (_("%pB: unsupported relocation type %#x"),
+			  abfd, r_type);
+      bfd_set_error (bfd_error_bad_value);
+      return false;
+    }
+  return true;
+}
+
+/* Specialized relocation handler for R_860_SPLITn.  These relocations
+   involves a 16-bit field that is split into two contiguous parts.  */
+static bfd_reloc_status_type
+elf32_i860_relocate_splitn (bfd *input_bfd,
+			    Elf_Internal_Rela *rello,
+			    bfd_byte *contents,
+			    bfd_vma value)
+{
+  bfd_vma insn;
+  reloc_howto_type *howto;
+  howto = lookup_howto ((unsigned) ELF32_R_TYPE (rello->r_info));
+  insn = bfd_get_32 (input_bfd, contents + rello->r_offset);
+
+  /* Relocate.  */
+  value += rello->r_addend;
+
+  /* Separate the fields and insert.  */
+  value = (((value & 0xf800) << 5) | (value & 0x7ff)) & howto->dst_mask;
+  insn = (insn & ~howto->dst_mask) | value;
+
+  bfd_put_32 (input_bfd, insn, contents + rello->r_offset);
+  return bfd_reloc_ok;
+}
+
+/* Specialized relocation handler for R_860_PC16.  This relocation
+   involves a 16-bit, PC-relative field that is split into two contiguous
+   parts.  */
+static bfd_reloc_status_type
+elf32_i860_relocate_pc16 (bfd *input_bfd,
+			  asection *input_section,
+			  Elf_Internal_Rela *rello,
+			  bfd_byte *contents,
+			  bfd_vma value)
+{
+  bfd_vma insn;
+  reloc_howto_type *howto;
+  howto = lookup_howto ((unsigned) ELF32_R_TYPE (rello->r_info));
+  insn = bfd_get_32 (input_bfd, contents + rello->r_offset);
+
+  /* Adjust for PC-relative relocation.  */
+  value -= (input_section->output_section->vma
+	    + input_section->output_offset);
+  value -= rello->r_offset;
+
+  /* Relocate.  */
+  value += rello->r_addend;
+
+  /* Adjust the value by 4, then separate the fields and insert.  */
+  value -= 4;
+  if (((value & 0xffffffff) ^ 0x80000000) - 0x80000000 + 0x20000 >= 0x40000)
+    return bfd_reloc_overflow;
+  value >>= howto->rightshift;
+  value = (((value & 0xf800) << 5) | (value & 0x7ff)) & howto->dst_mask;
+  insn = (insn & ~howto->dst_mask) | value;
+
+  bfd_put_32 (input_bfd, insn, contents + rello->r_offset);
+  return bfd_reloc_ok;
+
+}
+
+/* Specialized relocation handler for R_860_PC26.  This relocation
+   involves a 26-bit, PC-relative field which must be adjusted by 4.  */
+static bfd_reloc_status_type
+elf32_i860_relocate_pc26 (bfd *input_bfd,
+			  asection *input_section,
+			  Elf_Internal_Rela *rello,
+			  bfd_byte *contents,
+			  bfd_vma value)
+{
+  bfd_vma insn;
+  reloc_howto_type *howto;
+  howto = lookup_howto ((unsigned) ELF32_R_TYPE (rello->r_info));
+  insn = bfd_get_32 (input_bfd, contents + rello->r_offset);
+
+  /* Adjust for PC-relative relocation.  */
+  value -= (input_section->output_section->vma
+	    + input_section->output_offset);
+  value -= rello->r_offset;
+
+  /* Relocate.  */
+  value += rello->r_addend;
+
+  /* Adjust value by 4 and insert the field.  */
+  value -= 4;
+  if (((value & 0xffffffff) ^ 0x80000000) - 0x80000000 + 0x8000000 >= 0x10000000)
+    return bfd_reloc_overflow;
+  value = (value >> howto->rightshift) & howto->dst_mask;
+  insn = (insn & ~howto->dst_mask) | value;
+
+  bfd_put_32 (input_bfd, insn, contents + rello->r_offset);
+  return bfd_reloc_ok;
+
+}
+
+/* Specialized relocation handler for R_860_HIGHADJ.  */
+static bfd_reloc_status_type
+elf32_i860_relocate_highadj (bfd *input_bfd,
+			     Elf_Internal_Rela *rel,
+			     bfd_byte *contents,
+			     bfd_vma value)
+{
+  bfd_vma insn;
+
+  insn = bfd_get_32 (input_bfd, contents + rel->r_offset);
+
+  value += rel->r_addend;
+  value += 0x8000;
+  value = ((value >> 16) & 0xffff);
+
+  insn = (insn & 0xffff0000) | value;
+
+  bfd_put_32 (input_bfd, insn, contents + rel->r_offset);
+  return bfd_reloc_ok;
+}
+
+/* Perform a single relocation.  By default we use the standard BFD
+   routines. However, we handle some specially.  */
+static bfd_reloc_status_type
+i860_final_link_relocate (reloc_howto_type *howto,
+			  bfd *input_bfd,
+			  asection *input_section,
+			  bfd_byte *contents,
+			  Elf_Internal_Rela *rel,
+			  bfd_vma relocation)
+{
+  return _bfd_final_link_relocate (howto, input_bfd, input_section,
+				   contents, rel->r_offset, relocation,
+				   rel->r_addend);
+}
+
+/* Dynamic linking.  r15 holds the address of _GLOBAL_OFFSET_TABLE_ in PIC
+   code, but a PLT entry does not depend on it: it finds its slot PC relative
+   and uses r28 to keep the return address across the call reading the PC.
+   There is no lazy binding entry, the C library binds all slots at load.  */
+
+#define PLT_ENTRY_SIZE	32
+#define PLT_ENTRY_WORD0	0xa03c0000	/* mov %r1,%r28 */
+#define PLT_ENTRY_WORD1	0x6c000001	/* call .+8 */
+#define PLT_ENTRY_WORD2	0xa0000000	/* nop */
+#define PLT_ENTRY_WORD3	0xec1f0000	/* orh ha(slot-.),%r0,%r31 */
+#define PLT_ENTRY_WORD4	0x83ff0800	/* addu %r1,%r31,%r31 */
+#define PLT_ENTRY_WORD5	0x17ff0001	/* ld.l l(slot-.)(%r31),%r31 */
+#define PLT_ENTRY_WORD6	0x4000f800	/* bri %r31 */
+#define PLT_ENTRY_WORD7	0xa3810000	/* mov %r28,%r1 */
+#define PLT_PC_OFFSET	12		/* of the return address of the call */
+
+#define GOT_HEADER_WORDS 3
+#define ELF_DYNAMIC_INTERPRETER "/lib/ld.so.1"
+
+struct elf_i860_link_hash_entry
+{
+  struct elf_link_hash_entry root;
+
+  /* Referenced by an absolute address in an instruction: a run time
+     relocation cannot fix that.  */
+  unsigned int has_insn_ref : 1;
+
+  /* TLS accesses to this symbol, and their GOT entries.  */
+  unsigned char tls_mask;
+  bfd_vma tls_gd_got, tls_ie_got;
+};
+
+#define I860_TLS_GD 1
+#define I860_TLS_IE 2
+
+/* Thread local storage, variant II: the block ends at the thread pointer in r30.  */
+#define I860_LOCAL_GD(n) (n)		/* in the local GOT array, after N entries */
+#define I860_LOCAL_IE(n) (2 * (n))
+
+/* Whether a GOT entry of H needs a dynamic relocation with its symbol.  */
+static int
+i860_tls_dynsym (struct bfd_link_info *info, struct elf_link_hash_entry *h)
+{
+  return (h != NULL && h->dynindx != -1
+	  && elf_hash_table (info)->dynamic_sections_created
+	  && !SYMBOL_REFERENCES_LOCAL (info, h));
+}
+
+#define i860_hash_table(p) elf_hash_table (p)
+
+static struct bfd_hash_entry *
+i860_link_hash_newfunc (struct bfd_hash_entry *entry,
+			struct bfd_hash_table *table, const char *string)
+{
+  struct elf_i860_link_hash_entry *ret
+    = (struct elf_i860_link_hash_entry *) entry;
+
+  if (ret == NULL)
+    ret = bfd_hash_allocate (table, sizeof (struct elf_i860_link_hash_entry));
+  if (ret == NULL)
+    return NULL;
+
+  ret = ((struct elf_i860_link_hash_entry *)
+	 _bfd_elf_link_hash_newfunc ((struct bfd_hash_entry *) ret, table,
+				     string));
+  if (ret != NULL)
+    {
+      ret->has_insn_ref = 0;
+      ret->tls_mask = 0;
+      ret->tls_gd_got = ret->tls_ie_got = (bfd_vma) -1;
+    }
+  return (struct bfd_hash_entry *) ret;
+}
+
+static struct bfd_link_hash_table *
+i860_link_hash_table_create (bfd *abfd)
+{
+  struct elf_link_hash_table *ret = bfd_zmalloc (sizeof *ret);
+
+  if (ret == NULL)
+    return NULL;
+  if (!_bfd_elf_link_hash_table_init (ret, abfd, i860_link_hash_newfunc,
+				      sizeof (struct elf_i860_link_hash_entry)))
+    {
+      free (ret);
+      return NULL;
+    }
+  return &ret->root;
+}
+
+static void
+i860_copy_indirect_symbol (struct bfd_link_info *info,
+			   struct elf_link_hash_entry *dir,
+			   struct elf_link_hash_entry *ind)
+{
+  ((struct elf_i860_link_hash_entry *) dir)->has_insn_ref
+    |= ((struct elf_i860_link_hash_entry *) ind)->has_insn_ref;
+
+  ((struct elf_i860_link_hash_entry *) dir)->tls_mask
+    |= ((struct elf_i860_link_hash_entry *) ind)->tls_mask;
+
+  _bfd_elf_link_hash_copy_indirect (info, dir, ind);
+}
+
+static bool
+i860_create_got (bfd *abfd, struct elf_link_hash_table *htab,
+		 struct bfd_link_info *info)
+{
+  if (htab->sgot != NULL)
+    return true;
+  if (htab->dynobj == NULL)
+    htab->dynobj = abfd;
+  return _bfd_elf_create_got_section (htab->dynobj, info);
+}
+
+static bool
+i860_check_relocs (bfd *abfd, struct bfd_link_info *info, asection *sec,
+		   const Elf_Internal_Rela *relocs)
+{
+  Elf_Internal_Shdr *symtab_hdr;
+  struct elf_link_hash_entry **sym_hashes;
+  const Elf_Internal_Rela *rel;
+  const Elf_Internal_Rela *rel_end;
+  struct elf_link_hash_table *htab = i860_hash_table (info);
+  asection *sreloc = NULL;
+
+  if (bfd_link_relocatable (info) || (sec->flags & SEC_ALLOC) == 0)
+    return true;
+
+  symtab_hdr = &elf_tdata (abfd)->symtab_hdr;
+  sym_hashes = elf_sym_hashes (abfd);
+
+  rel_end = relocs + sec->reloc_count;
+  for (rel = relocs; rel < rel_end; rel++)
+    {
+      struct elf_link_hash_entry *h = NULL;
+      unsigned long r_symndx = ELF32_R_SYM (rel->r_info);
+      unsigned int r_type = ELF32_R_TYPE (rel->r_info);
+
+      if (r_symndx >= symtab_hdr->sh_info)
+	{
+	  h = sym_hashes[r_symndx - symtab_hdr->sh_info];
+	  while (h->root.type == bfd_link_hash_indirect
+		 || h->root.type == bfd_link_hash_warning)
+	    h = (struct elf_link_hash_entry *) h->root.u.i.link;
+	  if (strcmp (h->root.root.string, "_GLOBAL_OFFSET_TABLE_") == 0
+	      && !i860_create_got (abfd, htab, info))
+	    return false;
+	}
+
+      switch (r_type)
+	{
+	case R_860_PC26:
+	case R_860_PLT26:
+	  if (h != NULL)
+	    {
+	      h->needs_plt = 1;
+	      h->plt.refcount += 1;
+	    }
+	  break;
+
+	case R_860_TLS_GD_HI:
+	case R_860_TLS_GD_LO:
+	case R_860_TLS_IE_HA:
+	case R_860_TLS_IE_LO1:
+	case R_860_TLS_IE_ABS_HA:
+	case R_860_TLS_IE_ABS_LO1:
+	  {
+	    int gd = r_type == R_860_TLS_GD_HI || r_type == R_860_TLS_GD_LO;
+
+	    if ((r_type == R_860_TLS_IE_ABS_HA || r_type == R_860_TLS_IE_ABS_LO1)
+		&& bfd_link_pic (info))
+	      {
+		_bfd_error_handler
+		  /* xgettext:c-format */
+		  (_("%pB: relocation %s can not be used in position independent "
+		     "output; recompile with -fPIC"),
+		   abfd, lookup_howto (r_type)->name);
+		bfd_set_error (bfd_error_bad_value);
+		return 0;
+	      }
+	    if (!i860_create_got (abfd, htab, info))
+	      return 0;
+	    if (!gd)
+	      info->flags |= DF_STATIC_TLS;
+	    if (h != NULL)
+	      ((struct elf_i860_link_hash_entry *) h)->tls_mask
+		|= gd ? I860_TLS_GD : I860_TLS_IE;
+	    else
+	      {
+		unsigned int n = symtab_hdr->sh_info;
+		bfd_signed_vma *refs = elf_local_got_refcounts (abfd);
+
+		if (refs == NULL)
+		  {
+		    refs = bfd_zalloc (abfd, 3 * n * sizeof (bfd_signed_vma));
+		    if (refs == NULL)
+		      return 0;
+		    elf_local_got_refcounts (abfd) = refs;
+		  }
+		refs[(gd ? I860_LOCAL_GD (n) : I860_LOCAL_IE (n)) + r_symndx] = 1;
+	      }
+	  }
+	  break;
+
+	case R_860_TLS_LE_HI:
+	case R_860_TLS_LE_LO:
+	  if (bfd_link_dll (info))
+	    {
+	      _bfd_error_handler
+		/* xgettext:c-format */
+		(_("%pB: relocation %s can not be used when making a shared "
+		   "object; recompile with -fPIC"),
+		 abfd, lookup_howto (r_type)->name);
+	      bfd_set_error (bfd_error_bad_value);
+	      return 0;
+	    }
+	  break;
+
+	case R_860_LOGOT0:
+	case R_860_SPGOT0:
+	case R_860_LOGOT1:
+	case R_860_SPGOT1:
+	case R_860_HAGOT:
+	case R_860_HIGOT:
+	  if (!i860_create_got (abfd, htab, info))
+	    return false;
+	  if (h != NULL)
+	    h->got.refcount += 1;
+	  else
+	    {
+	      bfd_signed_vma *refs = elf_local_got_refcounts (abfd);
+
+	      if (refs == NULL)
+		{
+		  /* also for the TLS entries of local symbols */
+		  refs = bfd_zalloc (abfd, (3 * symtab_hdr->sh_info
+					    * sizeof (bfd_signed_vma)));
+		  if (refs == NULL)
+		    return false;
+		  elf_local_got_refcounts (abfd) = refs;
+		}
+	      refs[r_symndx] += 1;
+	    }
+	  break;
+
+	case R_860_LOGOTOFF0:
+	case R_860_SPGOTOFF0:
+	case R_860_LOGOTOFF1:
+	case R_860_SPGOTOFF1:
+	case R_860_LOGOTOFF2:
+	case R_860_LOGOTOFF3:
+	case R_860_HAGOTOFF:
+	case R_860_HIGOTOFF:
+	  if (!i860_create_got (abfd, htab, info))
+	    return false;
+	  break;
+
+	case R_860_HIGH:
+	case R_860_HIGHADJ:
+	case R_860_LOW0:
+	case R_860_LOW1:
+	case R_860_LOW2:
+	case R_860_LOW3:
+	case R_860_SPLIT0:
+	case R_860_SPLIT1:
+	case R_860_SPLIT2:
+	  if (bfd_link_pic (info))
+	    {
+	      _bfd_error_handler
+		/* xgettext:c-format */
+		(_("%pB: relocation %s against `%s' can not be used when "
+		   "making a shared object; recompile with -fPIC"),
+		 abfd, lookup_howto (r_type)->name,
+		 h != NULL ? h->root.root.string : "a local symbol");
+	      bfd_set_error (bfd_error_bad_value);
+	      return false;
+	    }
+	  if (h != NULL)
+	    {
+	      h->non_got_ref = 1;
+	      h->plt.refcount += 1;
+	      h->pointer_equality_needed = 1;
+	      ((struct elf_i860_link_hash_entry *) h)->has_insn_ref = 1;
+	    }
+	  break;
+
+	case R_860_32:
+	  if (h != NULL && !bfd_link_pic (info))
+	    {
+	      h->non_got_ref = 1;
+	      h->plt.refcount += 1;
+	      h->pointer_equality_needed = 1;
+	    }
+
+	  /* A shared object must copy these relocs, an executable may need
+	     them for symbols of a shared object if it avoids a copy reloc.  */
+	  if (bfd_link_pic (info)
+	      || (h != NULL
+		  && (h->root.type == bfd_link_hash_defweak
+		      || !h->def_regular)))
+	    {
+	      struct elf_dyn_relocs *p;
+	      struct elf_dyn_relocs **head;
+
+	      if (sreloc == NULL)
+		{
+		  if (htab->dynobj == NULL)
+		    htab->dynobj = abfd;
+		  sreloc = _bfd_elf_make_dynamic_reloc_section
+		    (sec, htab->dynobj, 2, abfd, true);
+		  if (sreloc == NULL)
+		    return false;
+		}
+
+	      if (h != NULL)
+		head = &h->dyn_relocs;
+	      else
+		{
+		  Elf_Internal_Sym *isym;
+		  asection *s;
+		  void *vpp;
+
+		  isym = bfd_sym_from_r_symndx (&htab->sym_cache, abfd, r_symndx);
+		  if (isym == NULL)
+		    return false;
+		  s = bfd_section_from_elf_index (abfd, isym->st_shndx);
+		  if (s == NULL)
+		    s = sec;
+		  vpp = &elf_section_data (s)->local_dynrel;
+		  head = (struct elf_dyn_relocs **) vpp;
+		}
+
+	      p = *head;
+	      if (p == NULL || p->sec != sec)
+		{
+		  p = bfd_alloc (htab->dynobj, sizeof *p);
+		  if (p == NULL)
+		    return false;
+		  p->next = *head;
+		  *head = p;
+		  p->sec = sec;
+		  p->count = 0;
+		  p->pc_count = 0;
+		}
+	      p->count += 1;
+	    }
+	  break;
+
+	default:
+	  break;
+	}
+    }
+  return true;
+}
+
+static bool
+i860_adjust_dynamic_symbol (struct bfd_link_info *info,
+			    struct elf_link_hash_entry *h)
+{
+  struct elf_link_hash_table *htab = i860_hash_table (info);
+  asection *s, *srel;
+
+  if (h->type == STT_FUNC || h->needs_plt)
+    {
+      /* A call to a symbol no dynamic object knows needs no PLT entry.  */
+      if (!bfd_link_pic (info)
+	  && !h->def_dynamic
+	  && !h->ref_dynamic
+	  && h->root.type != bfd_link_hash_undefweak
+	  && h->root.type != bfd_link_hash_undefined)
+	{
+	  h->plt.offset = (bfd_vma) -1;
+	  h->needs_plt = 0;
+	}
+      return true;
+    }
+  h->plt.offset = (bfd_vma) -1;
+
+  if (h->is_weakalias)
+    {
+      struct elf_link_hash_entry *def = weakdef (h);
+
+      BFD_ASSERT (def->root.type == bfd_link_hash_defined);
+      h->root.u.def.section = def->root.u.def.section;
+      h->root.u.def.value = def->root.u.def.value;
+      return true;
+    }
+
+  /* Shared objects reach data of other objects through the GOT only.  */
+  if (bfd_link_pic (info) || !h->non_got_ref)
+    return true;
+
+  /* Keep plain dynamic relocs instead of a copy reloc where possible.  */
+  if (info->nocopyreloc
+      || (!((struct elf_i860_link_hash_entry *) h)->has_insn_ref
+	  && !_bfd_elf_readonly_dynrelocs (h)))
+    {
+      h->non_got_ref = 0;
+      return true;
+    }
+
+  if ((h->root.u.def.section->flags & SEC_READONLY) != 0)
+    {
+      s = htab->sdynrelro;
+      srel = htab->sreldynrelro;
+    }
+  else
+    {
+      s = htab->sdynbss;
+      srel = htab->srelbss;
+    }
+  if ((h->root.u.def.section->flags & SEC_ALLOC) != 0 && h->size != 0)
+    {
+      srel->size += sizeof (Elf32_External_Rela);
+      h->needs_copy = 1;
+    }
+  return _bfd_elf_adjust_dynamic_copy (info, h, s);
+}
+
+static bool
+i860_allocate_dynrelocs (struct elf_link_hash_entry *h, void *inf)
+{
+  struct bfd_link_info *info = (struct bfd_link_info *) inf;
+  struct elf_link_hash_table *htab = i860_hash_table (info);
+  struct elf_dyn_relocs *p;
+  bool dyn = htab->dynamic_sections_created;
+
+  if (h->root.type == bfd_link_hash_indirect)
+    return true;
+
+  if (dyn && h->plt.refcount > 0)
+    {
+      if (h->dynindx == -1 && !h->forced_local
+	  && !UNDEFWEAK_NO_DYNAMIC_RELOC (info, h)
+	  && !bfd_elf_link_record_dynamic_symbol (info, h))
+	return false;
+
+      if (WILL_CALL_FINISH_DYNAMIC_SYMBOL (1, bfd_link_pic (info), h)
+	  && !SYMBOL_CALLS_LOCAL (info, h))
+	{
+	  asection *s = htab->splt;
+
+	  h->plt.offset = s->size;
+
+	  /* The address of a function of a shared object taken in the
+	     executable is its PLT entry, for pointer equality.  */
+	  if (!bfd_link_pic (info) && !h->def_regular)
+	    {
+	      h->root.u.def.section = s;
+	      h->root.u.def.value = h->plt.offset;
+	    }
+
+	  s->size += PLT_ENTRY_SIZE;
+	  htab->sgotplt->size += 4;
+	  htab->srelplt->size += sizeof (Elf32_External_Rela);
+	}
+      else
+	{
+	  h->plt.offset = (bfd_vma) -1;
+	  h->needs_plt = 0;
+	}
+    }
+  else
+    {
+      h->plt.offset = (bfd_vma) -1;
+      h->needs_plt = 0;
+    }
+
+  if (((struct elf_i860_link_hash_entry *) h)->tls_mask)
+    {
+      struct elf_i860_link_hash_entry *th = (struct elf_i860_link_hash_entry *) h;
+      asection *sgot = elf_hash_table (info)->sgot;
+      asection *srelgot = elf_hash_table (info)->srelgot;
+
+      if (h->dynindx == -1 && !h->forced_local
+	  && elf_hash_table (info)->dynamic_sections_created
+	  && !UNDEFWEAK_NO_DYNAMIC_RELOC (info, h)
+	  && !bfd_elf_link_record_dynamic_symbol (info, h))
+	return 0;
+
+      if (th->tls_mask & I860_TLS_GD)
+	{
+	  th->tls_gd_got = sgot->size;
+	  sgot->size += 8;
+	  if (i860_tls_dynsym (info, h))
+	    srelgot->size += 2 * sizeof (Elf32_External_Rela);
+	  else if (bfd_link_pic (info))
+	    srelgot->size += sizeof (Elf32_External_Rela);
+	}
+      if (th->tls_mask & I860_TLS_IE)
+	{
+	  th->tls_ie_got = sgot->size;
+	  sgot->size += 4;
+	  if (i860_tls_dynsym (info, h) || bfd_link_pic (info))
+	    srelgot->size += sizeof (Elf32_External_Rela);
+	}
+    }
+
+  if (h->got.refcount > 0)
+    {
+      if (h->dynindx == -1 && !h->forced_local
+	  && !UNDEFWEAK_NO_DYNAMIC_RELOC (info, h)
+	  && !bfd_elf_link_record_dynamic_symbol (info, h))
+	return false;
+
+      h->got.offset = htab->sgot->size;
+      htab->sgot->size += 4;
+      if (WILL_CALL_FINISH_DYNAMIC_SYMBOL (dyn, bfd_link_pic (info), h))
+	htab->srelgot->size += sizeof (Elf32_External_Rela);
+    }
+  else
+    h->got.offset = (bfd_vma) -1;
+
+  if (h->dyn_relocs == NULL)
+    return true;
+
+  if (bfd_link_pic (info))
+    {
+      if (h->root.type == bfd_link_hash_undefweak)
+	{
+	  /* A RELATIVE reloc would turn the zero into the load address.  */
+	  if (UNDEFWEAK_NO_DYNAMIC_RELOC (info, h))
+	    h->dyn_relocs = NULL;
+	  else if (h->dynindx == -1 && !h->forced_local
+		   && !bfd_elf_link_record_dynamic_symbol (info, h))
+	    return false;
+	}
+    }
+  else
+    {
+      /* Drop relocs of symbols that got a copy reloc or are not dynamic.  */
+      if (!h->non_got_ref
+	  && ((h->def_dynamic && !h->def_regular)
+	      || (dyn
+		  && (h->root.type == bfd_link_hash_undefweak
+		      || h->root.type == bfd_link_hash_undefined))))
+	{
+	  if (h->dynindx == -1 && !h->forced_local
+	      && !UNDEFWEAK_NO_DYNAMIC_RELOC (info, h)
+	      && !bfd_elf_link_record_dynamic_symbol (info, h))
+	    return false;
+	  if (h->dynindx == -1)
+	    h->dyn_relocs = NULL;
+	}
+      else
+	h->dyn_relocs = NULL;
+    }
+
+  for (p = h->dyn_relocs; p != NULL; p = p->next)
+    elf_section_data (p->sec)->sreloc->size
+      += p->count * sizeof (Elf32_External_Rela);
+  return true;
+}
+
+static bool
+i860_late_size_sections (struct bfd_link_info *info)
+{
+  struct elf_link_hash_table *htab = i860_hash_table (info);
+  bfd *dynobj = htab->dynobj;
+  bool relocs = false;
+  asection *s;
+  bfd *ibfd;
+
+  if (dynobj == NULL)
+    return true;
+
+  if (htab->dynamic_sections_created
+      && bfd_link_executable (info) && !info->nointerp)
+    {
+      s = htab->interp;
+      BFD_ASSERT (s != NULL);
+      s->size = sizeof ELF_DYNAMIC_INTERPRETER;
+      s->contents = (unsigned char *) ELF_DYNAMIC_INTERPRETER;
+      s->alloced = 1;
+    }
+
+  /* GOT entries and dynamic relocs of local symbols.  */
+  for (ibfd = info->input_bfds; ibfd != NULL; ibfd = ibfd->link.next)
+    {
+      bfd_signed_vma *local_got, *end_local_got;
+
+      if (bfd_get_flavour (ibfd) != bfd_target_elf_flavour)
+	continue;
+
+      for (s = ibfd->sections; s != NULL; s = s->next)
+	{
+	  struct elf_dyn_relocs *p;
+
+	  for (p = ((struct elf_dyn_relocs *)
+		    elf_section_data (s)->local_dynrel);
+	       p != NULL; p = p->next)
+	    if (!(!bfd_is_abs_section (p->sec)
+		  && bfd_is_abs_section (p->sec->output_section))
+		&& p->count != 0)
+	      {
+		elf_section_data (p->sec)->sreloc->size
+		  += p->count * sizeof (Elf32_External_Rela);
+		if ((p->sec->output_section->flags & SEC_READONLY) != 0)
+		  info->flags |= DF_TEXTREL;
+	      }
+	}
+
+      local_got = elf_local_got_refcounts (ibfd);
+      if (local_got == NULL)
+	continue;
+
+      end_local_got = local_got + elf_tdata (ibfd)->symtab_hdr.sh_info;
+      for (; local_got < end_local_got; ++local_got)
+	if (*local_got > 0)
+	  {
+	    *local_got = htab->sgot->size;
+	    htab->sgot->size += 4;
+	    if (bfd_link_pic (info))
+	      htab->srelgot->size += sizeof (Elf32_External_Rela);
+	  }
+	else
+	  *local_got = (bfd_vma) -1;
+      /* TLS entries of local symbols, in the same array after the GOT counts.  */
+      {
+	unsigned int n = elf_tdata (ibfd)->symtab_hdr.sh_info, i;
+	bfd_signed_vma *refs = elf_local_got_refcounts (ibfd);
+	for (i = 0; i < n; i++)
+	  {
+	    bfd_signed_vma *g = &refs[I860_LOCAL_GD (n) + i];
+	    bfd_signed_vma *e = &refs[I860_LOCAL_IE (n) + i];
+	    if (*g > 0)
+	      {
+		*g = elf_hash_table (info)->sgot->size;
+		elf_hash_table (info)->sgot->size += 8;
+		if (bfd_link_pic (info))
+		  elf_hash_table (info)->srelgot->size += sizeof (Elf32_External_Rela);
+	      }
+	    else
+	      *g = (bfd_vma) -1;
+	    if (*e > 0)
+	      {
+		*e = elf_hash_table (info)->sgot->size;
+		elf_hash_table (info)->sgot->size += 4;
+		if (bfd_link_pic (info))
+		  elf_hash_table (info)->srelgot->size += sizeof (Elf32_External_Rela);
+	      }
+	    else
+	      *e = (bfd_vma) -1;
+	  }
+      }
+    }
+
+  elf_link_hash_traverse (htab, i860_allocate_dynrelocs, info);
+
+  for (s = dynobj->sections; s != NULL; s = s->next)
+    {
+      if ((s->flags & SEC_LINKER_CREATED) == 0)
+	continue;
+
+      if (s == htab->splt || s == htab->sgot
+	  || s == htab->sgotplt || s == htab->sdynbss
+	  || s == htab->sdynrelro)
+	;
+      else if (startswith (bfd_section_name (s), ".rela"))
+	{
+	  if (s->size != 0 && s != htab->srelplt)
+	    relocs = true;
+	  s->reloc_count = 0;
+	}
+      else
+	continue;
+
+      if (s->size == 0)
+	{
+	  s->flags |= SEC_EXCLUDE;
+	  continue;
+	}
+      if ((s->flags & SEC_HAS_CONTENTS) == 0)
+	continue;
+
+      s->contents = bfd_zalloc (dynobj, s->size);
+      if (s->contents == NULL)
+	return false;
+      s->alloced = 1;
+    }
+
+  return _bfd_elf_add_dynamic_tags (info, relocs);
+}
+
+static bfd_vma
+i860_section_addr (asection *s)
+{
+  return s->output_section->vma + s->output_offset;
+}
+
+static void
+i860_append_rela (bfd *output_bfd, asection *srel, Elf_Internal_Rela *rela)
+{
+  bfd_elf32_swap_reloca_out (output_bfd, rela,
+			     srel->contents
+			     + srel->reloc_count * sizeof (Elf32_External_Rela));
+  srel->reloc_count++;
+}
+
+static bool
+i860_finish_dynamic_symbol (struct bfd_link_info *info,
+			    struct elf_link_hash_entry *h,
+			    Elf_Internal_Sym *sym)
+{
+  bfd *output_bfd = info->output_bfd;
+  struct elf_link_hash_table *htab = i860_hash_table (info);
+  Elf_Internal_Rela rela;
+
+  if (h->plt.offset != (bfd_vma) -1)
+    {
+      asection *splt = htab->splt;
+      asection *sgotplt = htab->sgotplt;
+      bfd_byte *ent = splt->contents + h->plt.offset;
+      bfd_vma index = h->plt.offset / PLT_ENTRY_SIZE;
+      bfd_vma got_offset = (index + GOT_HEADER_WORDS) * 4;
+      bfd_vma slot = i860_section_addr (sgotplt) + got_offset;
+      bfd_vma rel = slot - (i860_section_addr (splt) + h->plt.offset
+			    + PLT_PC_OFFSET);
+
+      BFD_ASSERT (h->dynindx != -1);
+
+      bfd_put_32 (output_bfd, PLT_ENTRY_WORD0, ent);
+      bfd_put_32 (output_bfd, PLT_ENTRY_WORD1, ent + 4);
+      bfd_put_32 (output_bfd, PLT_ENTRY_WORD2, ent + 8);
+      bfd_put_32 (output_bfd, PLT_ENTRY_WORD3 | (((rel + 0x8000) >> 16) & 0xffff),
+		  ent + 12);
+      bfd_put_32 (output_bfd, PLT_ENTRY_WORD4, ent + 16);
+      bfd_put_32 (output_bfd, PLT_ENTRY_WORD5 | (rel & 0xfffc), ent + 20);
+      bfd_put_32 (output_bfd, PLT_ENTRY_WORD6, ent + 24);
+      bfd_put_32 (output_bfd, PLT_ENTRY_WORD7, ent + 28);
+
+      rela.r_offset = slot;
+      rela.r_info = ELF32_R_INFO (h->dynindx, R_860_JUMP_SLOT);
+      rela.r_addend = 0;
+      bfd_elf32_swap_reloca_out (output_bfd, &rela,
+				 htab->srelplt->contents
+				 + index * sizeof (Elf32_External_Rela));
+
+      if (!h->def_regular)
+	{
+	  /* A zero value hides the entry from the search for the definition
+	     unless its address has to be the canonical function address.  */
+	  sym->st_shndx = SHN_UNDEF;
+	  if (!h->pointer_equality_needed)
+	    sym->st_value = 0;
+	}
+    }
+
+  if (h->got.offset != (bfd_vma) -1)
+    {
+      asection *sgot = htab->sgot;
+      bool local = (bfd_link_pic (info)
+			   && SYMBOL_REFERENCES_LOCAL (info, h));
+
+      rela.r_offset = i860_section_addr (sgot) + (h->got.offset & ~(bfd_vma) 1);
+      if (local && h->root.type != bfd_link_hash_undefweak)
+	{
+	  rela.r_info = ELF32_R_INFO (0, R_860_RELATIVE);
+	  rela.r_addend = (h->root.u.def.value
+			   + h->root.u.def.section->output_section->vma
+			   + h->root.u.def.section->output_offset);
+	  i860_append_rela (output_bfd, htab->srelgot, &rela);
+	}
+      else if (!local)
+	{
+	  bfd_put_32 (output_bfd, 0,
+		      sgot->contents + (h->got.offset & ~(bfd_vma) 1));
+	  rela.r_info = ELF32_R_INFO (h->dynindx, R_860_GLOB_DAT);
+	  rela.r_addend = 0;
+	  i860_append_rela (output_bfd, htab->srelgot, &rela);
+	}
+    }
+
+  if (h->needs_copy)
+    {
+      BFD_ASSERT (h->dynindx != -1
+		  && (h->root.type == bfd_link_hash_defined
+		      || h->root.type == bfd_link_hash_defweak));
+
+      rela.r_offset = (h->root.u.def.value
+		       + i860_section_addr (h->root.u.def.section));
+      rela.r_info = ELF32_R_INFO (h->dynindx, R_860_COPY);
+      rela.r_addend = 0;
+      i860_append_rela (output_bfd,
+			(h->root.u.def.section == htab->sdynrelro
+			 ? htab->sreldynrelro : htab->srelbss),
+			&rela);
+    }
+
+  if (strcmp (h->root.root.string, "_DYNAMIC") == 0 || h == htab->hgot)
+    sym->st_shndx = SHN_ABS;
+
+  return true;
+}
+
+static bool
+i860_finish_dynamic_sections (struct bfd_link_info *info,
+			      bfd_byte *buf ATTRIBUTE_UNUSED)
+{
+  bfd *output_bfd = info->output_bfd;
+  struct elf_link_hash_table *htab = i860_hash_table (info);
+  bfd *dynobj = htab->dynobj;
+  asection *sgotplt = htab->sgotplt;
+  asection *sdyn = bfd_get_section_by_name (dynobj, ".dynamic");
+
+  if (htab->dynamic_sections_created)
+    {
+      Elf32_External_Dyn *dyncon = (Elf32_External_Dyn *) sdyn->contents;
+      Elf32_External_Dyn *dynconend
+	= (Elf32_External_Dyn *) (sdyn->contents + sdyn->size);
+
+      for (; dyncon < dynconend; dyncon++)
+	{
+	  Elf_Internal_Dyn dyn;
+
+	  bfd_elf32_swap_dyn_in (dynobj, dyncon, &dyn);
+	  switch (dyn.d_tag)
+	    {
+	    case DT_PLTGOT:
+	      dyn.d_un.d_ptr = i860_section_addr (sgotplt);
+	      break;
+	    case DT_JMPREL:
+	      dyn.d_un.d_ptr = i860_section_addr (htab->srelplt);
+	      break;
+	    case DT_PLTRELSZ:
+	      dyn.d_un.d_val = htab->srelplt->size;
+	      break;
+	    default:
+	      continue;
+	    }
+	  bfd_elf32_swap_dyn_out (output_bfd, &dyn, dyncon);
+	}
+
+      if (htab->splt != NULL && htab->splt->size > 0)
+	elf_section_data (htab->splt->output_section)->this_hdr.sh_entsize
+	  = PLT_ENTRY_SIZE;
+    }
+
+  if (sgotplt != NULL && sgotplt->size > 0)
+    {
+      bfd_put_32 (output_bfd,
+		  sdyn != NULL ? i860_section_addr (sdyn) : (bfd_vma) 0,
+		  sgotplt->contents);
+      elf_section_data (sgotplt->output_section)->this_hdr.sh_entsize = 4;
+    }
+  if (htab->sgot != NULL && htab->sgot->size > 0)
+    elf_section_data (htab->sgot->output_section)->this_hdr.sh_entsize = 4;
+
+  return true;
+}
+
+static enum elf_reloc_type_class
+i860_reloc_type_class (const struct bfd_link_info *info ATTRIBUTE_UNUSED,
+		       const asection *rel_sec ATTRIBUTE_UNUSED,
+		       const Elf_Internal_Rela *rela)
+{
+  switch ((int) ELF32_R_TYPE (rela->r_info))
+    {
+    case R_860_RELATIVE:
+      return reloc_class_relative;
+    case R_860_JUMP_SLOT:
+      return reloc_class_plt;
+    case R_860_COPY:
+      return reloc_class_copy;
+    default:
+      return reloc_class_normal;
+    }
+}
+
+static bfd_vma
+i860_tpoff (struct bfd_link_info *info, bfd_vma address)
+{
+  asection *tls = elf_hash_table (info)->tls_sec;
+
+  if (tls == NULL)
+    return 0;
+  return address - (tls->vma + BFD_ALIGN (elf_hash_table (info)->tls_size,
+					  (bfd_vma) 1 << tls->alignment_power));
+}
+
+/* The address of the GOT entries at *OFFP, filled on the first use.  */
+static bfd_vma
+i860_tls_got_entry (bfd *output_bfd, struct bfd_link_info *info,
+		    struct elf_link_hash_entry *h, bfd_vma *offp,
+		    bfd_vma relocation, int gd)
+{
+  asection *sgot = elf_hash_table (info)->sgot;
+  asection *tls = elf_hash_table (info)->tls_sec;
+  bfd_vma off = *offp & ~(bfd_vma) 1;
+  bfd_vma addr = i860_section_addr (sgot) + off;
+  bfd_vma dtpoff = tls != NULL ? relocation - tls->vma : 0;
+
+  BFD_ASSERT (*offp != (bfd_vma) -1);
+  if ((*offp & 1) == 0)
+    {
+      int dynsym = i860_tls_dynsym (info, h);
+      unsigned long sym = dynsym ? h->dynindx : 0;
+      Elf_Internal_Rela rela;
+
+      *offp |= 1;
+      rela.r_offset = addr;
+      rela.r_addend = 0;
+      if (gd)
+	{
+	  /* an executable is module 1 */
+	  bfd_put_32 (output_bfd, dynsym || bfd_link_pic (info) ? 0 : 1,
+		      sgot->contents + off);
+	  bfd_put_32 (output_bfd, dynsym ? 0 : dtpoff, sgot->contents + off + 4);
+	  if (dynsym || bfd_link_pic (info))
+	    {
+	      rela.r_info = ELF32_R_INFO (sym, R_860_TLS_DTPMOD32);
+	      i860_append_rela (output_bfd, elf_hash_table (info)->srelgot, &rela);
+	    }
+	  if (dynsym)
+	    {
+	      rela.r_offset = addr + 4;
+	      rela.r_info = ELF32_R_INFO (sym, R_860_TLS_DTPOFF32);
+	      i860_append_rela (output_bfd, elf_hash_table (info)->srelgot, &rela);
+	    }
+	}
+      else
+	{
+	  bfd_put_32 (output_bfd, dynsym ? 0 : i860_tpoff (info, relocation),
+		      sgot->contents + off);
+	  if (dynsym || bfd_link_pic (info))
+	    {
+	      rela.r_info = ELF32_R_INFO (sym, R_860_TLS_TPOFF32);
+	      rela.r_addend = dynsym ? 0 : dtpoff;
+	      i860_append_rela (output_bfd, elf_hash_table (info)->srelgot, &rela);
+	    }
+	}
+    }
+  return addr;
+}
+
+/* Insert VALUE into a GOT, GOT offset or PC relative immediate field.  */
+static bfd_reloc_status_type
+i860_relocate_pic_field (bfd *abfd, int r_type, bfd_byte *where, bfd_vma value)
+{
+  bfd_vma insn = bfd_get_32 (abfd, where);
+  bfd_vma mask = 0xffff;
+  bool split = false;
+
+  switch (r_type)
+    {
+    case R_860_HAGOT:
+    case R_860_HAGOTOFF:
+    case R_860_HAPC:
+    case R_860_TLS_IE_HA:
+    case R_860_TLS_IE_ABS_HA:
+      value = (value + 0x8000) >> 16;
+      break;
+    case R_860_HIGOT:
+    case R_860_HIGOTOFF:
+    case R_860_TLS_GD_HI:
+    case R_860_TLS_LE_HI:
+      value >>= 16;
+      break;
+    case R_860_LOGOT0:
+    case R_860_LOGOTOFF0:
+    case R_860_LOPC:
+    case R_860_TLS_GD_LO:
+    case R_860_TLS_LE_LO:
+      break;
+    case R_860_LOGOT1:
+    case R_860_LOGOTOFF1:
+    case R_860_TLS_IE_LO1:
+    case R_860_TLS_IE_ABS_LO1:
+      mask = 0xfffe;
+      break;
+    case R_860_LOGOTOFF2:
+      mask = 0xfffc;
+      break;
+    case R_860_LOGOTOFF3:
+      mask = 0xfff8;
+      break;
+    case R_860_SPGOT1:
+    case R_860_SPGOTOFF1:
+      mask = 0xfffe;
+      split = true;
+      break;
+    case R_860_SPGOT0:
+    case R_860_SPGOTOFF0:
+      split = true;
+      break;
+    default:
+      return bfd_reloc_notsupported;
+    }
+
+  value &= mask;
+  if (split)
+    {
+      value = ((value & 0xf800) << 5) | (value & 0x7ff);
+      mask = ((mask & 0xf800) << 5) | (mask & 0x7ff);
+    }
+  bfd_put_32 (abfd, (insn & ~mask) | value, where);
+  return bfd_reloc_ok;
+}
+
+/* The GOT entry of a symbol, relative to _GLOBAL_OFFSET_TABLE_.  Fills the
+   entry unless the dynamic linker does.  */
+static bfd_vma
+i860_got_offset (bfd *output_bfd, struct bfd_link_info *info,
+		 struct elf_link_hash_table *htab,
+		 struct elf_link_hash_entry *h, bfd_vma *local_got,
+		 bfd_vma relocation)
+{
+  asection *sgot = htab->sgot;
+  bfd_vma off;
+
+  if (h != NULL)
+    {
+      off = h->got.offset;
+      BFD_ASSERT (off != (bfd_vma) -1);
+      if (!WILL_CALL_FINISH_DYNAMIC_SYMBOL (htab->dynamic_sections_created,
+					    bfd_link_pic (info), h)
+	  || (bfd_link_pic (info) && SYMBOL_REFERENCES_LOCAL (info, h)))
+	{
+	  if ((off & 1) == 0)
+	    {
+	      bfd_put_32 (output_bfd, relocation, sgot->contents + off);
+	      h->got.offset |= 1;
+	    }
+	  off &= ~(bfd_vma) 1;
+	}
+    }
+  else
+    {
+      off = *local_got;
+      BFD_ASSERT (off != (bfd_vma) -1);
+      if ((off & 1) == 0)
+	{
+	  bfd_put_32 (output_bfd, relocation, sgot->contents + off);
+	  if (bfd_link_pic (info))
+	    {
+	      Elf_Internal_Rela rela;
+
+	      rela.r_offset = i860_section_addr (sgot) + off;
+	      rela.r_info = ELF32_R_INFO (0, R_860_RELATIVE);
+	      rela.r_addend = relocation;
+	      i860_append_rela (output_bfd, htab->srelgot, &rela);
+	    }
+	  *local_got |= 1;
+	}
+      off &= ~(bfd_vma) 1;
+    }
+  return (i860_section_addr (sgot) + off
+	  - (htab->hgot->root.u.def.value
+	     + i860_section_addr (htab->hgot->root.u.def.section)));
+}
+
+static int
+i860_relocate_section (struct bfd_link_info *info, bfd *input_bfd,
+		       asection *input_section, bfd_byte *contents,
+		       Elf_Internal_Rela *relocs, Elf_Internal_Sym *local_syms,
+		       asection **local_sections)
+{
+  bfd *output_bfd = info->output_bfd;
+  struct elf_link_hash_table *htab = i860_hash_table (info);
+  Elf_Internal_Shdr *symtab_hdr = &elf_tdata (input_bfd)->symtab_hdr;
+  struct elf_link_hash_entry **sym_hashes = elf_sym_hashes (input_bfd);
+  bfd_vma *local_got = elf_local_got_offsets (input_bfd);
+  asection *sreloc = elf_section_data (input_section)->sreloc;
+  Elf_Internal_Rela *relend = relocs + input_section->reloc_count;
+  Elf_Internal_Rela *rel;
+
+  for (rel = relocs; rel < relend; rel++)
+    {
+      reloc_howto_type *howto;
+      unsigned long r_symndx = ELF32_R_SYM (rel->r_info);
+      int r_type = ELF32_R_TYPE (rel->r_info);
+      Elf_Internal_Sym *sym = NULL;
+      asection *sec = NULL;
+      struct elf_link_hash_entry *h = NULL;
+      bfd_vma relocation;
+      bfd_reloc_status_type r;
+      const char *name = NULL;
+      bfd_vma pc;
+
+      howto = lookup_howto ((unsigned) r_type);
+      if (howto == NULL)
+	{
+	  /* xgettext:c-format */
+	  _bfd_error_handler (_("%pB: unsupported relocation type %#x"),
+			      input_bfd, r_type);
+	  bfd_set_error (bfd_error_bad_value);
+	  return false;
+	}
+
+      if (r_symndx < symtab_hdr->sh_info)
+	{
+	  sym = local_syms + r_symndx;
+	  sec = local_sections[r_symndx];
+	  relocation = _bfd_elf_rela_local_sym (output_bfd, sym, &sec, rel);
+
+	  name = bfd_elf_string_from_elf_section
+	    (input_bfd, symtab_hdr->sh_link, sym->st_name);
+	  name = (name == NULL) ? bfd_section_name (sec) : name;
+	}
+      else
+	{
+	  bool unresolved_reloc, warned, ignored;
+
+	  RELOC_FOR_GLOBAL_SYMBOL (info, input_bfd, input_section, rel,
+				   r_symndx, symtab_hdr, sym_hashes,
+				   h, sec, relocation,
+				   unresolved_reloc, warned, ignored);
+	  name = h->root.root.string;
+	}
+
+      if (sec != NULL && discarded_section (sec))
+	RELOC_AGAINST_DISCARDED_SECTION (info, input_bfd, input_section,
+					 rel, 1, relend, R_860_NONE,
+					 howto, 0, contents);
+
+      if (bfd_link_relocatable (info))
+	continue;
+
+      pc = i860_section_addr (input_section) + rel->r_offset;
+
+      switch (r_type)
+	{
+	default:
+	  r = i860_final_link_relocate (howto, input_bfd, input_section,
+					contents, rel, relocation);
+	  break;
+
+	case R_860_32:
+	  if (r_symndx != STN_UNDEF
+	      && (input_section->flags & SEC_ALLOC) != 0
+	      && ((bfd_link_pic (info)
+		   && (h == NULL || !UNDEFWEAK_NO_DYNAMIC_RELOC (info, h)))
+		  || (!bfd_link_pic (info)
+		      && h != NULL
+		      && h->dynindx != -1
+		      && !h->non_got_ref
+		      && ((h->def_dynamic && !h->def_regular)
+			  || h->root.type == bfd_link_hash_undefweak
+			  || h->root.type == bfd_link_hash_undefined))))
+	    {
+	      Elf_Internal_Rela outrel;
+	      bfd_vma off = _bfd_elf_section_offset (output_bfd, info,
+						     input_section,
+						     rel->r_offset);
+
+	      BFD_ASSERT (sreloc != NULL);
+	      memset (&outrel, 0, sizeof outrel);
+	      if (off != (bfd_vma) -1 && off != (bfd_vma) -2)
+		{
+		  outrel.r_offset = off + i860_section_addr (input_section);
+		  if (h != NULL && h->dynindx != -1
+		      && !(bfd_link_pic (info)
+			   && SYMBOL_REFERENCES_LOCAL (info, h)))
+		    {
+		      outrel.r_info = ELF32_R_INFO (h->dynindx, R_860_32);
+		      outrel.r_addend = rel->r_addend;
+		    }
+		  else
+		    {
+		      outrel.r_info = ELF32_R_INFO (0, R_860_RELATIVE);
+		      outrel.r_addend = relocation + rel->r_addend;
+		    }
+		}
+	      i860_append_rela (output_bfd, sreloc, &outrel);
+	      /* -2: .eh_frame made pc relative, the value goes in place.  */
+	      if (off != (bfd_vma) -2)
+		continue;
+	    }
+	  r = i860_final_link_relocate (howto, input_bfd, input_section,
+					contents, rel, relocation);
+	  break;
+
+	case R_860_HIGHADJ:
+	  r = elf32_i860_relocate_highadj (input_bfd, rel, contents,
+					   relocation);
+	  break;
+
+	case R_860_PC16:
+	  r = elf32_i860_relocate_pc16 (input_bfd, input_section, rel,
+					contents, relocation);
+	  break;
+
+	case R_860_PC26:
+	case R_860_PLT26:
+	  if (h != NULL && h->plt.offset != (bfd_vma) -1
+	      && htab->splt != NULL)
+	    relocation = (i860_section_addr (htab->splt) + h->plt.offset);
+	  r = elf32_i860_relocate_pc26 (input_bfd, input_section, rel,
+					contents, relocation);
+	  break;
+
+	case R_860_SPLIT0:
+	case R_860_SPLIT1:
+	case R_860_SPLIT2:
+	  r = elf32_i860_relocate_splitn (input_bfd, rel, contents,
+					  relocation);
+	  break;
+
+	case R_860_LOGOT0:
+	case R_860_SPGOT0:
+	case R_860_LOGOT1:
+	case R_860_SPGOT1:
+	case R_860_HAGOT:
+	case R_860_HIGOT:
+	  relocation = i860_got_offset (output_bfd, info, htab, h,
+					(h == NULL && local_got != NULL
+					 ? &local_got[r_symndx] : NULL),
+					relocation + (h == NULL ? 0 : rel->r_addend));
+	  r = i860_relocate_pic_field (input_bfd, r_type,
+				       contents + rel->r_offset, relocation);
+	  break;
+
+	case R_860_LOGOTOFF0:
+	case R_860_SPGOTOFF0:
+	case R_860_LOGOTOFF1:
+	case R_860_SPGOTOFF1:
+	case R_860_LOGOTOFF2:
+	case R_860_LOGOTOFF3:
+	case R_860_HAGOTOFF:
+	case R_860_HIGOTOFF:
+	  relocation += (rel->r_addend
+			 - (htab->hgot->root.u.def.value
+			    + i860_section_addr
+				(htab->hgot->root.u.def.section)));
+	  r = i860_relocate_pic_field (input_bfd, r_type,
+				       contents + rel->r_offset, relocation);
+	  break;
+
+	case R_860_LOPC:
+	case R_860_HAPC:
+	  if (h != NULL && bfd_link_pic (info)
+	      && h != htab->hgot
+	      && !SYMBOL_REFERENCES_LOCAL (info, h))
+	    {
+	      _bfd_error_handler
+		/* xgettext:c-format */
+		(_("%pB: PC relative relocation %s against preemptible "
+		   "symbol `%s'"),
+		 input_bfd, howto->name, name);
+	      bfd_set_error (bfd_error_bad_value);
+	      return false;
+	    }
+	  r = i860_relocate_pic_field (input_bfd, r_type,
+				       contents + rel->r_offset,
+				       relocation + rel->r_addend - pc);
+	  break;
+
+	case R_860_TLS_GD_HI:
+	case R_860_TLS_GD_LO:
+	case R_860_TLS_IE_HA:
+	case R_860_TLS_IE_LO1:
+	case R_860_TLS_IE_ABS_HA:
+	case R_860_TLS_IE_ABS_LO1:
+	  {
+	    int gd = r_type == R_860_TLS_GD_HI || r_type == R_860_TLS_GD_LO;
+	    int abs = r_type == R_860_TLS_IE_ABS_HA || r_type == R_860_TLS_IE_ABS_LO1;
+	    struct elf_i860_link_hash_entry *th = (struct elf_i860_link_hash_entry *) h;
+	    unsigned int n = symtab_hdr->sh_info;
+	    bfd_vma *offp;
+
+	    if (th != NULL)
+	      offp = gd ? &th->tls_gd_got : &th->tls_ie_got;
+	    else
+	      offp = &local_got[(gd ? I860_LOCAL_GD (n) : I860_LOCAL_IE (n)) + r_symndx];
+	    relocation = i860_tls_got_entry (output_bfd, info, h, offp, relocation, gd);
+	    if (!abs)
+	      relocation -= (elf_hash_table (info)->hgot->root.u.def.value
+			     + i860_section_addr
+				 (elf_hash_table (info)->hgot->root.u.def.section));
+	    r = i860_relocate_pic_field (input_bfd, r_type,
+					 contents + rel->r_offset, relocation);
+	  }
+	  break;
+
+	case R_860_TLS_LE_HI:
+	case R_860_TLS_LE_LO:
+	  r = i860_relocate_pic_field (input_bfd, r_type, contents + rel->r_offset,
+				       i860_tpoff (info, relocation) + rel->r_addend);
+	  break;
+
+	/* Output only relocations.  */
+	case R_860_TLS_DTPMOD32:
+	case R_860_TLS_DTPOFF32:
+	case R_860_TLS_TPOFF32:
+	case R_860_COPY:
+	case R_860_GLOB_DAT:
+	case R_860_JUMP_SLOT:
+	case R_860_RELATIVE:
+	  r = bfd_reloc_notsupported;
+	  break;
+	}
+
+      if (r != bfd_reloc_ok)
+	{
+	  const char *msg = NULL;
+
+	  switch (r)
+	    {
+	    case bfd_reloc_overflow:
+	      (*info->callbacks->reloc_overflow)
+		(info, (h ? &h->root : NULL), name, howto->name,
+		 (bfd_vma) 0, input_bfd, input_section, rel->r_offset);
+	      break;
+	    case bfd_reloc_undefined:
+	      (*info->callbacks->undefined_symbol)
+		(info, name, input_bfd, input_section, rel->r_offset, true);
+	      break;
+	    case bfd_reloc_outofrange:
+	      msg = _("internal error: out of range error");
+	      break;
+	    case bfd_reloc_notsupported:
+	      msg = _("internal error: unsupported relocation error");
+	      break;
+	    case bfd_reloc_dangerous:
+	      msg = _("internal error: dangerous relocation");
+	      break;
+	    default:
+	      msg = _("internal error: unknown error");
+	      break;
+	    }
+	  if (msg)
+	    (*info->callbacks->warning) (info, msg, name, input_bfd,
+					 input_section, rel->r_offset);
+	}
+    }
+  return true;
+}
+
+/* Return whether a symbol name implies a local label.  SVR4/860 compilers
+   generate labels of the form ".ep.function_name" to denote the end of a
+   function prolog. These should be local.
+   ??? Do any other SVR4 compilers have this convention? If so, this should
+   be added to the generic routine.  */
+static bool
+elf32_i860_is_local_label_name (bfd *abfd, const char *name)
+{
+  if (name[0] == '.' && name[1] == 'e' && name[2] == 'p' && name[3] == '.')
+    return true;
+
+  return _bfd_elf_is_local_label_name (abfd, name);
+}
