+	pfld.q	%r17(%r12),%f12
+	pfld.q	%r28(%r13),%f8
+	pfld.q	%r31(%r14),%f4
+
+	# Index form, with auto-increment.
+	pfld.q	%r5(%r0)++,%f0
+	pfld.q	%r6(%r1)++,%f4
+	pfld.q	%r7(%r2)++,%f8
+	pfld.q	%r8(%r3)++,%f12
