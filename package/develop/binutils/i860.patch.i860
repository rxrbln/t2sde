+	stio.b	%r17,%r20
+	stio.b	%r28,%r19
+	stio.b	%r31,%r18
+
+	# scyc.b
+	scyc.b	%r0
+	scyc.b	%r5
+	scyc.b	%r6
+	scyc.b	%r13
+	scyc.b	%r14
+	scyc.b	%r28
+	scyc.b	%r29
+	scyc.b	%r30
+	scyc.b	%r31
+
+	# pfld.q
+	# Immediate form, no auto-increment.
+	pfld.q	0(%r0),%f0
+	pfld.q	128(%r1),%f28
+	pfld.q	256(%r2),%f24
+	pfld.q	512(%r3),%f20
+	pfld.q	1024(%r4),%f16
+	pfld.q	4096(%r5),%f12
+	pfld.q	8192(%r6),%f8
+	pfld.q	16384(%r7),%f4
+	pfld.q	32760(%r7),%f0
+	pfld.q	-32768(%r7),%f28
+	pfld.q	-16384(%r8),%f24
+	pfld.q	-8192(%r9),%f20
+	pfld.q	-4096(%r10),%f16
+	pfld.q	-1024(%r11),%f12
+	pfld.q	-512(%r12),%f8
+	pfld.q	-248(%r13),%f4
+	pfld.q	-8(%r14),%f0
+
+	# Immediate form, with auto-increment.
+	pfld.q	0(%r0)++,%f0
+	pfld.q	128(%r1)++,%f4
+	pfld.q	256(%r2)++,%f8
+	pfld.q	512(%r3)++,%f12
+	pfld.q	1024(%r4)++,%f16
+	pfld.q	4096(%r5)++,%f20
+	pfld.q	8192(%r6)++,%f24
+	pfld.q	16384(%r7)++,%f28
