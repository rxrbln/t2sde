diff --git a/gas/testsuite/gas/i860/dual01.s b/gas/testsuite/gas/i860/dual01.s
new file mode 100644
index 00000000000..e7aa271a79b
--- /dev/null
+++ b/gas/testsuite/gas/i860/dual01.s
@@ -0,0 +1,17 @@
+# Test fnop's dual bit (all other floating point operations have their dual
+# bit tested in their individual test files).
+
+	.text
+	.align 8
+	nop
+	nop
+        d.pfadd.dd      %f8,%f10,%f12
+        adds	%r5,%r6,%r6
+        d.pfadd.dd      %f8,%f10,%f12
+        fld.d   16(%r10),%f24
+        d.fnop
+        fld.d   8(%r10),%f8
+        d.fnop
+        fld.d   0(%r10),%f16
+	nop
+	nop
