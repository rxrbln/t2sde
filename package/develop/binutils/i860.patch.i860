diff --git a/gas/config/tc-i860.c b/gas/config/tc-i860.c
new file mode 100644
index 00000000000..d4e0c2298ac
--- /dev/null
+++ b/gas/config/tc-i860.c
@@ -0,0 +1,1586 @@
+/* tc-i860.c -- Assembler for the Intel i860 architecture.
