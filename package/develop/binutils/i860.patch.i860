diff --git a/ld/testsuite/ld-i860/ehframe-hdr.d b/ld/testsuite/ld-i860/ehframe-hdr.d
new file mode 100644
index 00000000000..a6bb9537001
--- /dev/null
+++ b/ld/testsuite/ld-i860/ehframe-hdr.d
@@ -0,0 +1,9 @@
+#source: ehframe.s
+#as:
+#ld: -shared --eh-frame-hdr
+#readelf: -wf
+#...
+.*FDE.*pc=0*[1-9a-f][0-9a-f]*\.\.[0-9a-f]+
+#...
+.*FDE.*pc=0*[1-9a-f][0-9a-f]*\.\.[0-9a-f]+
+#pass
diff --git a/ld/testsuite/ld-i860/ehframe.s b/ld/testsuite/ld-i860/ehframe.s
new file mode 100644
index 00000000000..b8ede66257c
--- /dev/null
+++ b/ld/testsuite/ld-i860/ehframe.s
@@ -0,0 +1,115 @@
+# gcc -O2 -fPIC -fexceptions: gas has no CFI directives for i860, GCC writes .eh_frame itself
+	.text
+	.align	8
+	.globl	f1
+	.type	f1, @function
+	.long	.ep.f1-f1+0xc8000000
+	nop
+f1:
+.LFB0:
+	addu -16,%sp,%sp
+.LCFI0:
+	st.l %fp,0(%sp)
+.LCFI1:
+	addu 0,%sp,%fp
+.LCFI2:
+	st.l %r1,4(%fp)
+.LCFI3:
+.ep.f1:
+	call g@plt
+	nop
+	addu 1,%r16,%r16
+	ld.l 4(%fp),%r1
+	ld.l 0(%fp),%fp
+	bri %r1
+	addu 16,%sp,%sp
+.LFE0:
+	.size	f1, .-f1
+	.align	8
+	.globl	f2
+	.type	f2, @function
+	.long	.ep.f2-f2+0xc8000000
+	nop
+f2:
+.LFB1:
+	addu -16,%sp,%sp
+.LCFI4:
+	st.l %fp,0(%sp)
+.LCFI5:
+	addu 0,%sp,%fp
+.LCFI6:
+	st.l %r1,4(%fp)
+.LCFI7:
+.ep.f2:
+	call g@plt
+	nop
+	addu 2,%r16,%r16
+	ld.l 4(%fp),%r1
+	ld.l 0(%fp),%fp
+	bri %r1
+	addu 16,%sp,%sp
+.LFE1:
+	.size	f2, .-f2
+	.section	.eh_frame,"aw",@progbits
+.Lframe1:
+	.4byte	.LECIE1-.LSCIE1
+.LSCIE1:
+	.4byte	0
+	.byte	0x3
+	.string	""
+	.uleb128 0x1
+	.sleb128 -4
+	.uleb128 0x1
+	.byte	0xc
+	.uleb128 0x2
+	.uleb128 0
+	.align	4
+.LECIE1:
+.LSFDE1:
+	.4byte	.LEFDE1-.LASFDE1
+.LASFDE1:
+	.4byte	.LASFDE1-.Lframe1
+	.4byte	.LFB0
+	.4byte	.LFE0-.LFB0
+	.byte	0x4
+	.4byte	.LCFI0-.LFB0
+	.byte	0xe
+	.uleb128 0x10
+	.byte	0x4
+	.4byte	.LCFI1-.LCFI0
+	.byte	0x83
+	.uleb128 0x4
+	.byte	0x4
+	.4byte	.LCFI2-.LCFI1
+	.byte	0xd
+	.uleb128 0x3
+	.byte	0x4
+	.4byte	.LCFI3-.LCFI2
+	.byte	0x81
+	.uleb128 0x3
+	.align	4
+.LEFDE1:
+.LSFDE3:
+	.4byte	.LEFDE3-.LASFDE3
+.LASFDE3:
+	.4byte	.LASFDE3-.Lframe1
+	.4byte	.LFB1
+	.4byte	.LFE1-.LFB1
+	.byte	0x4
+	.4byte	.LCFI4-.LFB1
+	.byte	0xe
+	.uleb128 0x10
+	.byte	0x4
+	.4byte	.LCFI5-.LCFI4
+	.byte	0x83
+	.uleb128 0x4
+	.byte	0x4
+	.4byte	.LCFI6-.LCFI5
+	.byte	0xd
+	.uleb128 0x3
+	.byte	0x4
+	.4byte	.LCFI7-.LCFI6
+	.byte	0x81
+	.uleb128 0x3
+	.align	4
+.LEFDE3:
diff --git a/ld/testsuite/ld-i860/ld-i860.exp b/ld/testsuite/ld-i860/ld-i860.exp
new file mode 100644
index 00000000000..bede80e9c10
--- /dev/null
+++ b/ld/testsuite/ld-i860/ld-i860.exp
@@ -0,0 +1,32 @@
+# Expect script for ld-i860 tests
+#   Copyright (C) 2026 Free Software Foundation, Inc.
+#   Copyright (C) 2026 René Rebe <rene@exactco.de>
+#
+# This file is part of the GNU Binutils.
+#
+# This program is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation; either version 3 of the License, or
+# (at your option) any later version.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program; if not, write to the Free Software
+# Foundation, Inc., 51 Franklin Street - Fifth Floor, Boston,
+# MA 02110-1301, USA.
+
+if { ![istarget i860-*-linux*] } {
+    return
+}
+
+run_dump_test "shared-relocs"
+run_dump_test "shared-plt"
+run_dump_test "nonpic-shared"
+run_dump_test "static-got"
+run_dump_test "tls-shared"
+run_dump_test "tls-static"
+run_dump_test "ehframe-hdr"
diff --git a/ld/testsuite/ld-i860/nonpic-shared.d b/ld/testsuite/ld-i860/nonpic-shared.d
new file mode 100644
index 00000000000..afc9a542d53
--- /dev/null
+++ b/ld/testsuite/ld-i860/nonpic-shared.d
@@ -0,0 +1,4 @@
+#source: nonpic.s
+#ld: -shared
+#error: .*relocation R_860_HIGH against `a local symbol' can not be used when making a shared object; recompile with -fPIC
