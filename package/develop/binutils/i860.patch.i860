diff --git a/gas/testsuite/gas/i860/pic.d b/gas/testsuite/gas/i860/pic.d
new file mode 100644
index 00000000000..d685e5a03dc
--- /dev/null
+++ b/gas/testsuite/gas/i860/pic.d
@@ -0,0 +1,37 @@
+#as:
+#objdump: -dr
+#name: i860 PIC selectors
+
+.*: +file format .*
+
+
+Disassembly of section \.text:
+
+00000000 <foo>:
+   0:	01 00 00 6c 	call	0x00000008	// 8 <foo\+0x8>
+   4:	00 00 00 a0 	shl	%r0,%r0,%r0
+   8:	00 00 0f ec 	orh	0x0000,%r0,%r15
+			8: R_860_HAPC	_GLOBAL_OFFSET_TABLE_
+   c:	00 00 ef 95 	adds	0,%r15,%r15
+			c: R_860_LOPC	_GLOBAL_OFFSET_TABLE_\+0x4
+  10:	00 08 ef 81 	addu	%r1,%r15,%r15
+  14:	00 00 1f ec 	orh	0x0000,%r0,%r31
+			14: R_860_HAGOT	gsym
+  18:	00 78 ff 83 	addu	%r15,%r31,%r31
+  1c:	01 00 f0 17 	ld\.l	0\(%r31\),%r16
+			1c: R_860_LOGOT1	gsym
+  20:	00 00 1f ec 	orh	0x0000,%r0,%r31
+			20: R_860_HIGOT	gsym
+  24:	00 00 ff e7 	or	0x0000,%r31,%r31
+			24: R_860_LOGOT0	gsym
+  28:	00 00 1f ec 	orh	0x0000,%r0,%r31
+			28: R_860_HIGOTOFF	\.data
+  2c:	00 00 ff e7 	or	0x0000,%r31,%r31
+			2c: R_860_LOGOTOFF0	\.data
+  30:	00 00 1f ec 	orh	0x0000,%r0,%r31
+			30: R_860_HAGOTOFF	\.data\+0x8
+  34:	01 00 f0 17 	ld\.l	0\(%r31\),%r16
+			34: R_860_LOGOTOFF1	\.data\+0x8
+  38:	00 00 00 6c 	call	0x0000003c	// 3c <foo\+0x3c>
+			38: R_860_PLT26	gsym
+  3c:	00 00 00 a0 	shl	%r0,%r0,%r0
diff --git a/gas/testsuite/gas/i860/pic.s b/gas/testsuite/gas/i860/pic.s
new file mode 100644
index 00000000000..09eec20da28
--- /dev/null
+++ b/gas/testsuite/gas/i860/pic.s
@@ -0,0 +1,23 @@
+# PIC selectors and the relocations they select.
+	.text
+foo:
+	call	1f
+	nop
+1:	orh	[_GLOBAL_OFFSET_TABLE_]@pc@ha,%r0,%r15
+	adds	[_GLOBAL_OFFSET_TABLE_+4]@pc@l,%r15,%r15
+	addu	%r1,%r15,%r15
+	orh	[gsym]@got@ha,%r0,%r31
+	addu	%r15,%r31,%r31
+	ld.l	[gsym]@got@l(%r31),%r16
+	orh	[gsym]@got@h,%r0,%r31
+	or	[gsym]@got@l,%r31,%r31
+	orh	[lsym]@gotoff@h,%r0,%r31
+	or	[lsym]@gotoff@l,%r31,%r31
+	orh	[lsym+8]@gotoff@ha,%r0,%r31
+	ld.l	[lsym+8]@gotoff@l(%r31),%r16
+	call	gsym@plt
+	nop
+	.data
+lsym:	.long	0
+	.long	0
+	.long	0
