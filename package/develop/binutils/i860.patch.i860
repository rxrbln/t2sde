+
+	orh	0,%r1,%r2
+	orh	1,%r4,%r5
+	orh	2,%r7,%r8
+	orh	3,%r10,%r11
+	orh	65000,%r13,%r14
+	orh	65535,%r16,%r17
+	orh	0xffff,%r19,%r20
+	orh	0xabcd,%r22,%r23
+	orh	0x1234,%r25,%r26
+	orh	0x0,%r28,%r29
+	orh	0x3,%r31,%r0
+
+	xor	0,%r1,%r2
+	xor	1,%r4,%r5
+	xor	2,%r7,%r8
+	xor	3,%r10,%r11
+	xor	65000,%r13,%r14
