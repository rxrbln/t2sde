+gv:	.long	7
diff --git a/ld/testsuite/ld-i860/tls-shared.d b/ld/testsuite/ld-i860/tls-shared.d
new file mode 100644
index 00000000000..56820232995
--- /dev/null
+++ b/ld/testsuite/ld-i860/tls-shared.d
@@ -0,0 +1,12 @@
+#source: tls.s
+#ld: -shared
+#readelf: -r --wide
+#name: i860 TLS relocations in a shared library
+
+Relocation section '\.rela\.dyn' at offset 0x[0-9a-f]+ contains 5 entries:
+ *Offset +Info +Type +Sym\. *Value +Symbol's Name \+ Addend
+[0-9a-f]+ +[0-9a-f]+ +R_860_TLS_DTPMOD32 +0
+[0-9a-f]+ +[0-9a-f]+ +R_860_TLS_TPOFF32 +8
+[0-9a-f]+ +[0-9a-f]+ +R_860_TLS_DTPMOD32 +[0-9a-f]+ +gtd \+ 0
+[0-9a-f]+ +[0-9a-f]+ +R_860_TLS_DTPOFF32 +[0-9a-f]+ +gtd \+ 0
