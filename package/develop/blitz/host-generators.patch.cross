--- blitz-1.0.2/blitz/CMakeLists.txt
+++ blitz-1.0.2/blitz/CMakeLists.txt
@@ -73,8 +73,13 @@ macro(GENERATE_BLITZ_HEADER header prog
     add_custom_target(${header} ALL)
     add_dependencies(${header} ${prog})
     add_dependencies(generated-headers ${header})
+    if (CMAKE_CROSSCOMPILING AND BLITZ_HOST_GENERATORS)
+        set(gen_cmd ${BLITZ_HOST_GENERATORS}/${prog})
+    else()
+        set(gen_cmd $<TARGET_FILE:${prog}>)
+    endif()
     add_custom_command(
-        COMMAND $<TARGET_FILE:${prog}>
+        COMMAND ${gen_cmd}
         TARGET  ${header}
         WORKING_DIRECTORY ${PROJECT_BINARY_DIR}/blitz/generate
         OUTPUTS ${header}
