Define the virtual yyFlexLexer::yyread() also with a user-defined YY_INPUT,
else C++ scanners fail to link with an undefined yyread in the vtable.

--- flex-2.7.2.orig/src/cpp-flex.skl
+++ flex-2.7.2/src/cpp-flex.skl
@@ -1706,6 +1706,13 @@ m4_ifdef([[M4_MODE_CXX_ONLY]], [[
 ]])
 	 return result;
 }
+m4_ifdef([[M4_MODE_CXX_ONLY]], [[
+#else
+/* FlexLexer.h declares yyread() for a user-defined YY_INPUT, too */
+int yyFlexLexer::yyread(char *buf, size_t max_size) {
+	return LexerInput( buf, (int) max_size );
+}
+]])
 #endif
 ]])
 ]])
