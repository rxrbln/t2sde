# generate the dictionaries with a build host dictgen, install the target one
zxcvbn_dictgen() {
	make CXX=c++ dict-src.h dict-crc.h
	rm -f dictgen
	make CXX="$CXX" dictgen
	touch dict-src.h dict-crc.h zxcvbn.dict
}
atstage cross && hook_add premake 5 zxcvbn_dictgen

var_append makeinstopt ' ' LIBDIR=$libdir
