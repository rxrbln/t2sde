[COPY] --- T2-COPYRIGHT-BEGIN ---
[COPY] t2/package/*/flutter/flutter.desc
[COPY] Copyright (C) 2026 The T2 SDE Project
[COPY] SPDX-License-Identifier: GPL-2.0
[COPY] --- T2-COPYRIGHT-END ---

[I] Framework and tools for building cross-platform applications

[T] Flutter provides a reactive UI framework and development tools for
[T] mobile, web and desktop applications. This package uses the system
[T] Dart SDK and initializes a writable Flutter checkout per user.

[U] https://flutter.dev/

[A] The Flutter Authors
[M] René Rebe <rene@exactco.de>

[C] extra/development

[L] BSD
[V] 3.47.7

[D] 9488686f08142181adc957bc147afc1170b180fa90b10ed50dbdb5e9 flutter-3.47.7.tar.gz https://github.com/flutter/flutter/archive/refs/tags/3.47.7/

runconf=0 runmake=0

flutter_install() {
	local revision
	revision=$(cat "$confdir"/flutter.desc "$confdir"/flutter.sh \
		"$confdir"/system-dart.sh "$confdir"/system-dart.patch | sha224sum)
	revision=${revision%% *}
	mkdir -p "$root$datadir/flutter" "$root$bindir"
	cp -a . "$root$datadir/flutter/"
	install -m755 "$confdir/system-dart.sh" \
		"$root$datadir/flutter/bin/internal/update_dart_sdk.sh"
	mkdir -p "$root$datadir/flutter/bin/cache"
	ln -s "$libdir/dart-sdk" "$root$datadir/flutter/bin/cache/dart-sdk"
	sed -e "s|@DATADIR@|$datadir|g" -e "s|@VERSION@|$ver|g" \
		-e "s|@REVISION@|$revision|g" \
		"$confdir/flutter.sh" > "$root$bindir/flutter"
	chmod 755 "$root$bindir/flutter"
}
hook_add postmake 5 flutter_install
