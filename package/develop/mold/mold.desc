[I] A Modern Linker

[T] Mold is a faster drop-in replacement for existing Unix linkers. It is
[T] several times faster than LLVM lld linker.

[U] https://github.com/rui314/mold

[A] Rui Ueyama <rui314@gmail.com>
[M] René Rebe <rene@exactco.de>

[C] extra/development
[F] CROSS

[L] MIT
[V] 3.0.0

[D] fc86d66f609de9d87bfa12b98912b873bfc7349aa34a98b32448248b mold-3.0.0.tar.gz https://github.com/rui314/mold/archive/v3.0.0/

cargoinstopt=

export MOLD_LIBDIR="$libdir"
mold_install() {
	local target_dir="${CARGO_TARGET_DIR:-$PWD/target}"
	atstage cross && target_dir="$target_dir/$arch_target"
	CARGO_TARGET_DIR="$target_dir" PREFIX="/$prefix" \
		MOLD_LIBDIR="$libdir" DESTDIR="$root" ./install-mold.sh
}
hook_add inmake 5 mold_install
