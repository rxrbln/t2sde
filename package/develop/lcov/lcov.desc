[D] fd8c38d11541316a3ad08c58c851edb0345867c2fbbe51fd2f033c81 lcov-2.6.tar.gz https://github.com/linux-test-project/lcov/releases/download/v2.6/

if atstage cross || ! pkginstalled sphinx-doc; then
	var_append makeopt ' ' LCOV_NO_DOC=1
	var_append makeinstopt ' ' LCOV_NO_DOC=1
fi

if atstage cross; then
	var_append makeopt ' ' LCOV_NO_XS=1
	var_append makeinstopt ' ' LCOV_NO_XS=1
fi
