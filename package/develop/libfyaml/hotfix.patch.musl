When trunc() needs no extra lib (e.g. musl), ac_cv_search_trunc is
"none required", which then ended up in libfyaml.pc Libs.

--- libfyaml-0.9.6/configure.ac.vanilla
+++ libfyaml-0.9.6/configure.ac
@@ -253,7 +253,10 @@
 
 # Link libm on platforms where trunc() lives outside libc.
 AC_SEARCH_LIBS([trunc], [m])
-LIBM="$ac_cv_search_trunc"
+case "$ac_cv_search_trunc" in
+"none required"|no) LIBM="" ;;
+*) LIBM="$ac_cv_search_trunc" ;;
+esac
 if test "x$LIBM" = "xno" || test "x$LIBM" = "xyes" ; then
 	LIBM=""
 fi
