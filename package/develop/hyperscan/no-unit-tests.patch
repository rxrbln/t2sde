Build the unit tests only with BUILD_TESTING.

--- hyperscan-5.4.2.1.orig/CMakeLists.txt
+++ hyperscan-5.4.2.1/CMakeLists.txt
@@ -505,7 +505,9 @@ if (CORRECT_PCRE_VERSION AND PCRE_BUILD_
     set(BUILD_CHIMERA TRUE)
 endif()
 
-add_subdirectory(unit)
+if(BUILD_TESTING)
+    add_subdirectory(unit)
+endif()
 if (EXISTS ${CMAKE_SOURCE_DIR}/tools/CMakeLists.txt)
     add_subdirectory(tools)
 endif()
@@ -558,7 +560,9 @@ if (CORRECT_PCRE_VERSION AND PCRE_BUILD_
     set(BUILD_CHIMERA TRUE)
 endif()
 
-add_subdirectory(unit)
+if(BUILD_TESTING)
+    add_subdirectory(unit)
+endif()
 if (EXISTS ${CMAKE_SOURCE_DIR}/tools/CMakeLists.txt)
     add_subdirectory(tools)
 endif()
