[I] Message Passing Interface - Argonne National Laboratories

[T] A high-performance and widely portable implementation of the Message
[T] Passing Interface (MPI) standard. Both MPI-1 and MPI-2 are supported.

[U] https://www.mpich.org

[A] Argonne National Laboratories
[M] René Rebe <rene@exactco.de>

[C] extra/development
[F] CROSS

[E] opt valgrind

[L] OpenSource
[V] 5.1.0a1

[D] c12f4800559d1aefe0e6236e0949eac3374540083ddd017b4b853d18 mpich-5.1.0a1.tar.gz https://www.mpich.org/static/downloads/5.1.0a1/

var_append GCC_WRAPPER_APPEND ' ' -std=gnu17

# configure cannot run the Fortran type size probes, gfortran defaults
mpich_cross_values() {
	cat > $builddir/cross-values <<-EOT
	CROSS_F77_SIZEOF_INTEGER=4
	CROSS_F77_SIZEOF_REAL=4
	CROSS_F77_SIZEOF_DOUBLE_PRECISION=8
	CROSS_F77_SIZEOF_LOGICAL=4
	CROSS_F77_TRUE_VALUE=1
	CROSS_F77_FALSE_VALUE=0
	CROSS_F90_ADDRESS_KIND=$arch_sizeof_char_p
	CROSS_F90_OFFSET_KIND=8
	CROSS_F90_INTEGER_KIND=4
	EOT
	var_append confopt ' ' --with-cross=$builddir/cross-values
}
atstage cross && hook_add preconf 5 mpich_cross_values
