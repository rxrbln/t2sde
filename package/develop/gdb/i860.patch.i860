 bfd/libbfd.h           |   40 +
 bfd/po/SRC-POTFILES.in |    2 +
 bfd/reloc.c            |   84 ++
 bfd/targets.c          |    5 +
 gdb/Makefile.in        |    1 +
 gdb/configure.tgt      |    5 +
 gdb/i860-tdep.c        |  302 +++++
 include/elf/i860.h     |   11 +
