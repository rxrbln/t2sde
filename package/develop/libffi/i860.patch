+#ifdef FFI_EXEC_STATIC_TRAMP
+/* A page of trampolines, each finding its struct tramp_parm one page above
+   itself: call is the only way to read the PC.  r1 is back in the last slot.
+   In its own section: a page aligned .text as the first section of a static
+   link would leave the ELF headers unmapped, with AT_PHDR = 0, which crashes
+   musl's static_init_tls.  */
