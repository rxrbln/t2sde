+	.globl	trampoline_code_table
+	FFI_HIDDEN(trampoline_code_table)
+	.type	trampoline_code_table,@function
+	.align	I860_TRAMP_MAP_SIZE
+trampoline_code_table:
+	.rept	I860_TRAMP_COUNT
+	mov	%r1,%r28
+	call	.+8
+	nop
+	ld.l	I860_TRAMP_MAP_SIZE-12(%r1),%r29	/* data */
+	ld.l	I860_TRAMP_MAP_SIZE-8(%r1),%r31		/* target */
+	bri	%r31
+	mov	%r28,%r1
+	nop
+	.endr
+	.size	trampoline_code_table,.-trampoline_code_table
+	.text
