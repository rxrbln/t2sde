+   HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY,
+   WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+   OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+   DEALINGS IN THE SOFTWARE.
+   ----------------------------------------------------------------------- */
+
+
+#include <ffi.h>
+#include <ffi_common.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <tramp.h>
+#include "internal.h"
+
+struct i860_regs
+{
+  uint32_t gpr[I860_INT_ARG_BYTES / 4];
+  uint32_t fpr[I860_FP_ARG_BYTES / 4];
+  uint32_t ret[4];
+  uint32_t fret[2];
+} __attribute__ ((aligned (16)));
+
+struct i860_call_frame
+{
+  struct i860_regs regs;
+  void *saved_fp, *saved_r1, *saved_sp;
+} __attribute__ ((aligned (16)));
+
+_Static_assert (offsetof (struct i860_regs, fpr) == I860_REGS_FPR, "regs");
+_Static_assert (offsetof (struct i860_regs, ret) == I860_REGS_RET, "regs");
+_Static_assert (offsetof (struct i860_regs, fret) == I860_REGS_FRET, "regs");
+_Static_assert (sizeof (struct i860_regs) == I860_REGS_SIZE, "regs");
+_Static_assert (offsetof (struct i860_call_frame, saved_fp) == I860_CALL_FP, "frame");
+_Static_assert (offsetof (struct i860_call_frame, saved_r1) == I860_CALL_R1, "frame");
+_Static_assert (offsetof (struct i860_call_frame, saved_sp) == I860_CALL_SP, "frame");
+_Static_assert (sizeof (struct i860_call_frame) == I860_CALL_SIZE, "frame");
+_Static_assert (I860_TRAMP_COUNT * I860_TRAMP_SIZE == I860_TRAMP_MAP_SIZE, "tramp");
+
+extern void ffi_call_i860 (struct i860_call_frame *frame, void *stack,
+			   void (*fn) (void), void *chain) FFI_HIDDEN;
+extern void ffi_closure_i860 (void) FFI_HIDDEN;
+extern void ffi_go_closure_i860 (void) FFI_HIDDEN;
+
+/* Follows GCC's i860_function_arg: a count keeps growing when an argument did
+   not fit, so a register left free is not used by a later argument.  */
+struct arg_walk
+{
+  unsigned int gp, fp, stack;
+};
+
+enum arg_where { ARG_GPR, ARG_FPR, ARG_STACK };
+
+static void
+arg_walk_init (struct arg_walk *w, const ffi_cif *cif)
+{
+  w->gp = cif->rtype->type == FFI_TYPE_STRUCT ? 4 : 0;
+  w->fp = 0;
+  w->stack = 0;
+}
+
+static enum arg_where
+arg_next (struct arg_walk *w, const ffi_type *ty, unsigned int *off)
+{
+  unsigned int size = FFI_ALIGN (ty->size, 4);
+  unsigned int align;
+
+  switch (ty->type)
+    {
+    case FFI_TYPE_STRUCT:
+    case FFI_TYPE_COMPLEX:
+      break;
+
+    case FFI_TYPE_FLOAT:
+    case FFI_TYPE_DOUBLE:
+      *off = FFI_ALIGN (w->fp, size);
+      w->fp = *off + size;
+      if (w->fp <= I860_FP_ARG_BYTES)
+	return ARG_FPR;
+      break;
+
+    default:
+      *off = w->gp;
+      w->gp = *off + size;
+      if (w->gp <= I860_INT_ARG_BYTES)
+	return ARG_GPR;
+      break;
+    }
+
+  align = ty->alignment < 4 ? 4 : ty->alignment > 16 ? 16 : ty->alignment;
+  *off = FFI_ALIGN (w->stack, align);
+  w->stack = *off + size;
+  return ARG_STACK;
+}
+
+static void *
+arg_slot (struct arg_walk *w, const ffi_type *ty, struct i860_regs *regs,
+	  char *stack)
+{
+  unsigned int off;
+
+  switch (arg_next (w, ty, &off))
+    {
+    case ARG_GPR:
+      return (char *) regs->gpr + off;
+    case ARG_FPR:
+      return (char *) regs->fpr + off;
+    default:
+      return stack + off;
+    }
+}
+
+ffi_status FFI_HIDDEN
+ffi_prep_cif_machdep (ffi_cif *cif)
+{
+  struct arg_walk w;
+  unsigned int i, off;
+
+  arg_walk_init (&w, cif);
+  for (i = 0; i < cif->nargs; i++)
+    arg_next (&w, cif->arg_types[i], &off);
+  cif->bytes = FFI_ALIGN (w.stack, 16);
+  return FFI_OK;
+}
+
+static void
+ffi_call_int (ffi_cif *cif, void (*fn) (void), void *rvalue, void **avalue,
+	      void *chain)
+{
+  ffi_type *rtype = cif->rtype;
+  size_t rtemp = !rvalue && rtype->type == FFI_TYPE_STRUCT ? rtype->size : 0;
+  char *stack = alloca (cif->bytes + sizeof (struct i860_call_frame) + rtemp);
+  struct i860_call_frame *frame = (void *) (stack + cif->bytes);
+  struct arg_walk w;
+  unsigned int i;
+
+  arg_walk_init (&w, cif);
+  if (rtype->type == FFI_TYPE_STRUCT)
+    {
+      if (!rvalue)
+	rvalue = frame + 1;
+      frame->regs.gpr[0] = (uintptr_t) rvalue;
+    }
+
+  for (i = 0; i < cif->nargs; i++)
+    {
+      ffi_type *ty = cif->arg_types[i];
+      void *slot = arg_slot (&w, ty, &frame->regs, stack);
+
+      switch (ty->type)
+	{
+	case FFI_TYPE_SINT8:
+	  *(ffi_sarg *) slot = *(int8_t *) avalue[i];
+	  break;
+	case FFI_TYPE_UINT8:
+	  *(ffi_arg *) slot = *(uint8_t *) avalue[i];
+	  break;
+	case FFI_TYPE_SINT16:
+	  *(ffi_sarg *) slot = *(int16_t *) avalue[i];
+	  break;
+	case FFI_TYPE_UINT16:
+	  *(ffi_arg *) slot = *(uint16_t *) avalue[i];
+	  break;
+	default:
+	  memcpy (slot, avalue[i], ty->size);
+	  break;
+	}
+    }
+
+  ffi_call_i860 (frame, stack, fn, chain);
+
+  if (!rvalue)
+    return;
+  switch (rtype->type)
+    {
+    case FFI_TYPE_VOID:
+    case FFI_TYPE_STRUCT:
+      break;
+    case FFI_TYPE_SINT8:
+      *(ffi_sarg *) rvalue = (int8_t) frame->regs.ret[0];
+      break;
+    case FFI_TYPE_UINT8:
+      *(ffi_arg *) rvalue = (uint8_t) frame->regs.ret[0];
+      break;
+    case FFI_TYPE_SINT16:
+      *(ffi_sarg *) rvalue = (int16_t) frame->regs.ret[0];
+      break;
+    case FFI_TYPE_UINT16:
+      *(ffi_arg *) rvalue = (uint16_t) frame->regs.ret[0];
+      break;
+    case FFI_TYPE_FLOAT:
+    case FFI_TYPE_DOUBLE:
+      memcpy (rvalue, frame->regs.fret, rtype->size);
+      break;
+    default:
+      /* Complex values come back in r16-r19 as well, not in FP registers.  */
+      memcpy (rvalue, frame->regs.ret, rtype->size);
+      break;
+    }
+}
+
+void
+ffi_call (ffi_cif *cif, void (*fn) (void), void *rvalue, void **avalue)
+{
+  ffi_call_int (cif, fn, rvalue, avalue, NULL);
+}
+
+void
+ffi_call_go (ffi_cif *cif, void (*fn) (void), void *rvalue, void **avalue,
+	     void *closure)
+{
+  ffi_call_int (cif, fn, rvalue, avalue, closure);
+}
+
+/* Called from sysv.S with the argument registers saved in REGS; returns with
+   the values for r16-r19 and f8/f9 stored there.  */
+void FFI_HIDDEN
+ffi_closure_inner_i860 (ffi_cif *cif,
+			void (*fun) (ffi_cif *, void *, void **, void *),
+			void *user_data, struct i860_regs *regs, char *stack)
+{
+  void **avalue = alloca (cif->nargs * sizeof (void *));
+  ffi_type *rtype = cif->rtype;
+  struct arg_walk w;
+  unsigned int i;
+  void *rvalue;
+
+  arg_walk_init (&w, cif);
+  if (rtype->type == FFI_TYPE_STRUCT)
+    {
+      rvalue = (void *) (uintptr_t) regs->gpr[0];
+      regs->ret[0] = regs->gpr[0];
+    }
+  else if (rtype->type == FFI_TYPE_FLOAT || rtype->type == FFI_TYPE_DOUBLE)
+    rvalue = regs->fret;
+  else
+    rvalue = regs->ret;
+
+  for (i = 0; i < cif->nargs; i++)
+    {
+      ffi_type *ty = cif->arg_types[i];
+
+      avalue[i] = arg_slot (&w, ty, regs, stack);
+      /* Register pairs are not aligned, and fld.d traps on a misaligned word.  */
+      if (((uintptr_t) avalue[i] & (ty->alignment - 1)) != 0)
+	{
+	  void *copy = alloca (ty->size);
+
+	  avalue[i] = memcpy (copy, avalue[i], ty->size);
+	}
+    }
+
+  fun (cif, rvalue, avalue, user_data);
+}
+
+ffi_status
+ffi_prep_closure_loc (ffi_closure *closure, ffi_cif *cif,
+		      void (*fun) (ffi_cif *, void *, void **, void *),
+		      void *user_data, void *codeloc)
+{
+  uint32_t *tramp = (uint32_t *) closure->tramp;
+  uint32_t target = (uintptr_t) ffi_closure_i860;
+  uint32_t chain = (uintptr_t) codeloc;
+
+  if (cif->abi != FFI_SYSV)
+    return FFI_BAD_ABI;
+
+  closure->cif = cif;
+  closure->fun = fun;
+  closure->user_data = user_data;
+
+#ifdef FFI_EXEC_STATIC_TRAMP
+  if (ffi_tramp_is_present (closure))
+    {
+      ffi_tramp_set_parms (closure->ftramp, ffi_closure_i860, closure);
+      return FFI_OK;
+    }
+#endif
+
+  tramp[0] = 0xec1f0000 | (target >> 16);	/* orh hi(target),r0,r31 */
+  tramp[1] = 0xe7ff0000 | (target & 0xffff);	/* or lo(target),r31,r31 */
+  tramp[2] = 0xec1d0000 | (chain >> 16);	/* orh hi(chain),r0,r29 */
+  tramp[3] = 0x4000f800;			/* bri r31 */
+  tramp[4] = 0xe7bd0000 | (chain & 0xffff);	/* or lo(chain),r29,r29 */
+
+  /* After the fields: a second mapping must see them too, as the data cache
+     is tagged by virtual address.  */
+  __builtin___clear_cache ((char *) codeloc,
+			   (char *) codeloc + FFI_TRAMPOLINE_SIZE);
+  return FFI_OK;
+}
+
+ffi_status
+ffi_prep_go_closure (ffi_go_closure *closure, ffi_cif *cif,
+		     void (*fun) (ffi_cif *, void *, void **, void *))
+{
+  if (cif->abi != FFI_SYSV)
+    return FFI_BAD_ABI;
+
+  closure->tramp = ffi_go_closure_i860;
+  closure->cif = cif;
+  closure->fun = fun;
+  return FFI_OK;
+}
+
+#ifdef FFI_EXEC_STATIC_TRAMP
+void *
+ffi_tramp_arch (size_t *tramp_size, size_t *map_size)
+{
+  extern void *trampoline_code_table;
+
+  *tramp_size = I860_TRAMP_SIZE;
+  *map_size = I860_TRAMP_MAP_SIZE;
+  return &trampoline_code_table;
+}
+#endif
