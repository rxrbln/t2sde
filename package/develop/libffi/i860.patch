+   DEALINGS IN THE SOFTWARE.
+   ----------------------------------------------------------------------- */
+
+
+#define LIBFFI_ASM
+#include <fficonfig.h>
+#include <ffi.h>
+#include "internal.h"
+
+	.text
+
+/* void ffi_call_i860 (frame, stack, fn, chain)
+   The caller's alloca holds stack, directly followed by frame.  sp moves up
+   to it, so the saved registers must be in there and not below sp.  */
+	.globl	ffi_call_i860
+	FFI_HIDDEN(ffi_call_i860)
+	.type	ffi_call_i860,@function
+	.align	8
+ffi_call_i860:
+	st.l	%fp,I860_CALL_FP(%r16)
+	st.l	%r1,I860_CALL_R1(%r16)
+	st.l	%sp,I860_CALL_SP(%r16)
+	mov	%r16,%fp
+	mov	%r17,%sp
+	mov	%r18,%r28
+	mov	%r19,%r29
+	fld.d	I860_REGS_FPR+0(%fp),%f8
+	fld.d	I860_REGS_FPR+8(%fp),%f10
