Upstream 15777f10: libdir and includedir from GNUInstallDirs, not lib.

--- LIEF-1.0.0.orig/cmake/LIEF.pc.in
+++ LIEF-1.0.0/cmake/LIEF.pc.in
@@ -1,7 +1,7 @@
 prefix="@CMAKE_INSTALL_PREFIX@"
 exec_prefix="${prefix}"
-libdir="${prefix}/lib"
-includedir="${prefix}/include"
+libdir=@CMAKE_INSTALL_FULL_LIBDIR@
+includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@
 
 Name: LIEF
 Description: Library to Instrument Executable Formats
