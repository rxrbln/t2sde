diff -Nurp a/include/urcu/arch/i860.h b/include/urcu/arch/i860.h
--- a/include/urcu/arch/i860.h	1970-01-01 01:00:00.000000000 +0100
+++ b/include/urcu/arch/i860.h	2026-11-02 10:18:34.854330387 +0100
@@ -0,0 +1,32 @@
+// SPDX-FileCopyrightText: 2026 René Rebe <rene@exactco.de>
+//
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#ifndef _URCU_ARCH_I860_H
+#define _URCU_ARCH_I860_H
+
+#include <urcu/compiler.h>
+#include <urcu/config.h>
+#include <urcu/syscall-compat.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#include <stdlib.h>
+#include <sys/time.h>
+
+/* a single CPU: the compiler barriers of the generic header are all it takes */
+#define cmm_mb()	cmm_barrier()
+
+#if (defined(__linux__) && !defined(__NR_membarrier))
+#define __NR_membarrier		283
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#include <urcu/arch/generic.h>
+
+#endif /* _URCU_ARCH_I860_H */
diff -Nurp a/include/urcu/arch.h b/include/urcu/arch.h
--- a/include/urcu/arch.h	2026-09-11 16:25:10.000000000 +0200
+++ b/include/urcu/arch.h	2026-11-02 10:18:34.854230153 +0100
@@ -152,6 +152,11 @@
 #define URCU_ARCH_RISCV 1
 #include <urcu/arch/riscv.h>
 
+#elif defined(__i860__)
+
+#define URCU_ARCH_I860 1
+#include <urcu/arch/i860.h>
+
 #elif defined(__loongarch__)
 
 #define URCU_ARCH_LOONGARCH 1
diff -Nurp a/include/urcu/uatomic/i860.h b/include/urcu/uatomic/i860.h
--- a/include/urcu/uatomic/i860.h	1970-01-01 01:00:00.000000000 +0100
+++ b/include/urcu/uatomic/i860.h	2026-11-02 10:18:34.854354908 +0100
@@ -0,0 +1,26 @@
+// SPDX-FileCopyrightText: 2026 René Rebe <rene@exactco.de>
+//
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#ifndef _URCU_UATOMIC_ARCH_I860_H
+#define _URCU_UATOMIC_ARCH_I860_H
+
+#include <urcu/compiler.h>
+#include <urcu/system.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* inline with lock and unlock, for up to 32 bits */
+#define UATOMIC_HAS_ATOMIC_BYTE
+#define UATOMIC_HAS_ATOMIC_SHORT
+#define UATOMIC_HAS_ATOMIC_INT
+
+#ifdef __cplusplus
+}
+#endif
+
+#include <urcu/uatomic/generic.h>
+
+#endif /* _URCU_UATOMIC_ARCH_I860_H */
diff -Nurp a/include/urcu/uatomic.h b/include/urcu/uatomic.h
--- a/include/urcu/uatomic.h	2026-09-11 16:25:10.000000000 +0200
+++ b/include/urcu/uatomic.h	2026-11-02 10:18:34.854312166 +0100
@@ -95,6 +95,8 @@ static inline int cmm_to_c11(int mo)
 #include <urcu/uatomic/m68k.h>
 #elif defined(URCU_ARCH_RISCV)
 #include <urcu/uatomic/riscv.h>
+#elif defined(URCU_ARCH_I860)
+#include <urcu/uatomic/i860.h>
 #elif defined(URCU_ARCH_LOONGARCH)
 #include <urcu/uatomic/loongarch.h>
 #else
