Run the t3keyc of the build host, not the cross built one.

diff -Nrup a/Makefile.in b/Makefile.in
--- a/Makefile.in	2024-11-20 14:42:14.000000000 +0100
+++ b/Makefile.in	2026-10-22 17:22:42.169294578 +0200
@@ -83,7 +83,7 @@ install: all
 	$(INSTALL) -s src.util/t3keyc/t3keyc $(_bindir)
 	$(INSTALL) -d $(_datadir)/libt3key1
 	find src/database -type f | while read FILE ; do install -m0644 "$$FILE" $(_datadir)/libt3key1 ; \
-		$(_bindir)/t3keyc -l  $(_datadir)/libt3key1/"$${FILE##*/}" ; done
+		t3keyc -l  $(_datadir)/libt3key1/"$${FILE##*/}" ; done
 	$(INSTALL) -d $(_mandir)/man1
 	$(INSTALL) -m0644 man/t3keyc.1 $(_mandir)/man1
 	if [ -f src.util/t3learnkeys/t3learnkeys ] ; then $(INSTALL) -s src.util/t3learnkeys/t3learnkeys $(_bindir) ; \
@@ -92,7 +92,7 @@ install: all
 uninstall:
 	$(LIBTOOL) --mode=uninstall rm $(_libdir)/libt3key.la
 	rm -rf $(_docdir) $(_datadir)
-	rm -f $(_bindir)/t3keyc $(_bindir)/t3learnkeys $(_pkgconfigdir)/libt3key.pc
+	rm -f t3keyc $(_bindir)/t3learnkeys $(_pkgconfigdir)/libt3key.pc
 	rm -rf $(_includedir)/t3key
 	rm -f $(_mandir)/man1/t3keyc.1 $(_mandir)/man1/t3learnkeys.1
 
