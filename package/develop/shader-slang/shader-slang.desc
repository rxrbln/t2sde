[I] A shading language

[T] Slang is a shading language that makes it easier to build and maintain
[T] large shader codebases in a modular and extensible fashion,

[U] https://github.com/shader-slang/slang

[A] shader-slang
[M] The T2 Project <t2@t2-project.org>

[C] extra/tool
[F] CROSS OBJDIR

[L] APL
[V] 2026.19

[D] 7cde63ae3dabba6e9a0834121651936a849e9f9b4f033a61803c3772 shader-slang-2026.19.tar.gz git+https://github.com/shader-slang/slang v2026.19

var_append cmakeopt ' ' "-DSLANG_ENABLE_TESTS=OFF -DSLANG_ENABLE_EXAMPLES=OFF"
var_append cmakeopt ' ' -DSLANG_ENABLE_SLANG_RHI=OFF
var_append cmakeopt ' ' -DSLANG_USE_SYSTEM_MINIZ=ON
var_append cmakeopt ' ' -DSLANG_USE_SYSTEM_LZ4=ON
var_append cmakeopt ' ' -DSLANG_USE_SYSTEM_GLSLANG=ON
var_append cmakeopt ' ' -DSLANG_USE_SYSTEM_SPIRV_TOOLS=ON
var_append cmakeopt ' ' -DSLANG_USE_SYSTEM_SPIRV_HEADERS=ON

var_append GCC_WRAPPER_APPEND ' ' -I$root/usr/include/glslang

# TODO:
#var_append cmakeopt ' ' -DSLANG_SLANG_LLVM_FLAVOR=USE_SYSTEM_LLVM
#var_append cmakeopt ' ' -DSLANG_USE_SYSTEM_UNORDERED_DENSE=ON
#var_append cmakeopt ' ' -DSLANG_USE_SYSTEM_VULKAN_HEADERS=ON

# the generators run at build time, use them from a native build
slang_native_generators() {
	local nat=$builddir/native
	mkdir -p $nat
	(cd $nat && env PATH="${PATH/$CMD_WRAPPER_MYPATH:/}" CC=$HOSTCC CXX=$HOSTCXX \
		CFLAGS= CXXFLAGS= LDFLAGS= PKG_CONFIG_PATH= PKG_CONFIG_LIBDIR= PKG_CONFIG_SYSROOT_DIR= \
		cmake $builddir/slang -DCMAKE_BUILD_TYPE=Release -DSLANG_ENABLE_TESTS=OFF \
		-DSLANG_ENABLE_EXAMPLES=OFF -DSLANG_ENABLE_SLANG_RHI=OFF -DSLANG_SLANG_LLVM_FLAVOR=DISABLE &&
		make -j$SDECFG_PARALLEL all-generators) || return 1
	var_append cmakeopt ' ' "-DSLANG_GENERATORS_PATH=$nat/generators/Release/bin"
}
atstage cross && hook_add preconf 5 slang_native_generators
