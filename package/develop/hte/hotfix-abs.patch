abs() of an unsigned value is ambiguous, the difference is meant signed.

--- ht-2.1.0/htapp.cc.orig
+++ ht-2.1.0/htapp.cc
@@ -3023,7 +3023,7 @@ static uint isqr(uint u)
 {
 	uint a = 2;
 	uint b = u/a;
-	while (abs(a - b) > 1) {
+	while (abs((int)(a - b)) > 1) {
 		a = (a+b)/2;
 		b = u/a;
         }
