[I] Portable version of the NetBSD make

[T] bmake is a portable version of the NetBSD make(1) with its .for/.if
[T] directives and mk include files, used by BSD style build systems such as
[T] mk-configure. It is maintained by Simon J. Gerraty.

[U] https://www.crufty.net/help/sjg/bmake.html

[A] Simon J. Gerraty <sjg@crufty.net>
[M] The T2 Project <t2@t2-project.org>

[C] extra/development
[F] CROSS

[L] BSD
[V] 20260912
[P] X -----5---9 120.000

[D] 8bb3d5d07d17b271e7e5dd2ce5ec80ae586321c0aa955548da221d2a bmake-20260912.tar.gz https://www.crufty.net/ftp/pub/sjg/

runconf=0 runmake=0

# boot-strap op=build always runs the unit tests, build without them
bmake_boot_strap() {
	local opts="-o objs --prefix=/$prefix --with-default-sys-path=$datadir/mk"
	sh ./boot-strap $opts op=configure &&
	(cd objs && sh ./make-bootstrap.sh && touch tested) &&
	sh ./boot-strap $opts --install-destdir=$root op=install
}
hook_add inmake 5 bmake_boot_strap
