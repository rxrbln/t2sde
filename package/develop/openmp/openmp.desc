# legacy standalone build mode has been removed
srcdir=*/runtimes
var_append cmakeopt ' ' -DLLVM_ENABLE_RUNTIMES=openmp

# shared files with gcc /usr/lib/libgomp.so*
var_append cmakeopt ' ' -DLIBOMP_INSTALL_ALIASES=OFF
