[COPY] --- T2-COPYRIGHT-BEGIN ---
[COPY] t2/package/*/vulkan-loader/vulkan-loader.desc
[COPY] Copyright (C) 2004 - 2026 The T2 SDE Project
[COPY] SPDX-License-Identifier: GPL-2.0
[COPY] --- T2-COPYRIGHT-END ---

[I] Official Khronos Vulkan ICD loader

[T] The Vulkan loader libvulkan discovers the installed Vulkan drivers
[T] (ICDs) and layers and dispatches the Vulkan API calls of applications to
[T] them.

[A] LunarG Inc.
[M] René Rebe <rene@exactco.de>

[U] https://www.vulkan.org/

[C] base/x11
[F] CROSS

[L] OpenSource
[V] 1.4.369
[P] X -----5---9 127.440

[CV-FLAGS] NO-PREFIX
[CV-GROUP] vulkan
[D] 07d7d38ef7b4fcf9eb88deb41bbf3d754a189b6a78f989240b380fec Vulkan-Loader-1.4.369.tar.gz https://github.com/KhronosGroup/Vulkan-Loader/archive/v1.4.369/

pkginstalled wayland-protocols || var_append cmakeopt ' ' -DBUILD_WSI_WAYLAND_SUPPORT=OFF
pkginstalled libx11 || var_append cmakeopt ' ' -DBUILD_WSI_XLIB_SUPPORT=OFF
pkginstalled libxcb || var_append cmakeopt ' ' -DBUILD_WSI_XCB_SUPPORT=OFF

var_append cmakeopt ' ' -DLOADER_CODEGEN=ON
var_append GCC_WRAPPER_INSERT ' ' "-I$root/$(pkgprefix includedir libx11)"

atstage cross && var_append cmakeopt ' ' -DUSE_GAS=OFF

hook_add premake 5 'var_append PATH : "$PWD/loader"'
hook_add premake 5 "mkdir -p $root$sysconfdir/vulkan/icd.d $root$datadir/vulkan/explicit_layer.d"
