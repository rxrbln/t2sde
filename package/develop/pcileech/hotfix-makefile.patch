--- pcileech-4.20/pcileech/Makefile.vanilla	2026-11-10 20:56:47.117007973 +0200
+++ pcileech-4.20/pcileech/Makefile	2026-11-10 20:57:12.681461518 +0200
@@ -6,7 +6,7 @@
 ifeq ($(shell basename $(CC)),gcc)
     CFLAGS  += -pie
 endif
-LDFLAGS +=-Wl,-rpath,'$$ORIGIN' -ldl -L. -l:leechcore.so -l:vmm.so -Wl,-z,noexecstack
+LDFLAGS +=-Wl,-rpath,'$$ORIGIN' -ldl -L. -lleechcore -lvmm -Wl,-z,noexecstack
 DEPS = pcileech.h
 OBJ  = oscompatibility.o charutil.o device.o pcileech.o executor.o extra.o help.o kmd.o memdump.o mempatch.o statistics.o umd.o util.o vfslist.o vfs.o vmmx.o ob/ob_cachemap.o ob/ob_core.o ob/ob_map.o ob/ob_set.o
 
@@ -14,12 +14,8 @@
 	$(CC) -c -o $@ $< $(CFLAGS)
 
 pcileech: $(OBJ)
-	-cp ../files/vmm.so . || cp ../../MemProcFS*/files/vmm.so .
-	-cp ../files/leechcore.so . || cp ../../LeechCore*/files/leechcore.so .
 	$(CC) -o $@ $^ $(CFLAGS) $(LDFLAGS)
 	-mv pcileech ../files/
-	-mv vmm.so ../files/
-	-mv leechcore.so ../files/
 	-rm -f *.o
 	-rm -f */*.o
 	-rm -f *.so
