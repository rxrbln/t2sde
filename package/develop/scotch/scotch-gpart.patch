Install gpart as scotch_gpart, gpart is the partition table guesser.

--- scotch-v7.0.18.orig/src/scotch/CMakeLists.txt
+++ scotch-v7.0.18/src/scotch/CMakeLists.txt
@@ -117,6 +117,7 @@ endif(NOT WIN32)
 # gpart is a special target (same source as gmap)
 add_scotch_exe(gpart gmap.c gmap.h)
 target_compile_definitions(gpart PRIVATE SCOTCH_COMPILE_PART)
+set_target_properties(gpart PROPERTIES OUTPUT_NAME scotch_gpart)
 
 # Install all Scotch executables
 foreach(target ${scotch_exe} gout gpart)
