MPI 5 headers declare the Fortran interop types only with MPI_FORTRAN.

--- scotch-v7.0.18.orig/src/libscotch/common.h
+++ scotch-v7.0.18/src/libscotch/common.h
@@ -154,6 +154,9 @@
 #endif /* HAVE_NOT_SYS_WAIT_H */
 
 #ifdef COMMON_MPI
+#ifndef MPI_FORTRAN
+#define MPI_FORTRAN                               /* MPI 5 declares MPI_Fint only with it */
+#endif /* MPI_FORTRAN */
 #include            <mpi.h>
 #endif /* COMMON_MPI */
 
