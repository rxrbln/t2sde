[I] A superset of JavaScript that compiles to clean JavaScript output

[T] TypeScript is a language for application-scale JavaScript. TypeScript
[T] adds optional types to JavaScript that support tools for large-scale
[T] JavaScript applications for any browser, for any host, on any OS.

[U] https://github.com/microsoft/TypeScript

[A] Microsoft
[M] René Rebe <rene@exactco.de>

[C] extra/development
[F] CROSS

[E] add nodejs

[L] APL
[V] 7.0.2

[D] d18cfed3f9047b84615960e62b35ebc4dd68808b33b636c2f9a0a155 TypeScript-7.0.2.tar.gz https://github.com/microsoft/TypeScript/archive/v7.0.2/

runmake=0

typescript_install() {
	local destdir="$(pkgprefix libdir nodejs)/node_modules/typescript"

	mkdir -p "$destdir"
	cp -a ./. "$destdir"/

	ln -sfv "$destdir/bin/tsc" "$root/$bindir/tsc"
	ln -sfv "$destdir/bin/tsserver" "$root/$bindir/tsserver"
}
hook_add postmake 5 typescript_install
