[I] A Prolog System

[T] SWI-Prolog is a prolog compiler with an interactiv textinterface based
[T] on GNU-readline, targeting primarily at research and education.
[T]
[T] SWI-Prolog comes with a comprehensive set of built-in predicates,
[T] covering Edinburgh Prolog, and large parts of The ISO standard,
[T] Quintus and SICStus Prolog. It includes the XPCE GUI toolkit as well
[T] as packages for dealing with processes, TCP/IP connections, XML, SGML
[T] and RDF documents. There are interfaces for C and C++.

[U] https://www.swi-prolog.org/

[A] Jan Wielemaker <jan@swi-prolog.org>
[M] Lars Kuhtz <lars@kuhtz.eu>

[C] extra/development
[F] CROSS OBJDIR NO-LTO

[E] opt openjdk

[L] GPL
[V] 10.0.2

[D] 146e6e8f234e290bc23bea4353280d4e234b3f0c4fbf4dd76439a265 swipl-10.0.2.tar.gz https://www.swi-prolog.org/download/stable/src/

var_append cmakeopt ' ' -DBUILD_TESTING=OFF

if atstage cross; then
	# the build runs Prolog with the package foreign libraries,
	# it needs a native swipl friend build with the same packages
	swipl_native() {
		env -u CC -u CXX -u CFLAGS -u CXXFLAGS -u LDFLAGS -u PKG_CONFIG_PATH -u PKG_CONFIG_LIBDIR \
			cmake -S .. -B ../native -DCMAKE_C_COMPILER=$BUILDCC -DCMAKE_BUILD_TYPE=Release \
			-DSWIPL_PACKAGES_GUI=OFF -DSWIPL_PACKAGES_JAVA=OFF \
			-DINSTALL_DOCUMENTATION=OFF -DBUILD_TESTING=OFF
		cmake --build ../native --parallel
	}
	hook_add preconf 4 swipl_native
	var_append cmakeopt ' ' '-DSWIPL_NATIVE_FRIEND=$PWD/../native -DQSORT_R_GNU=1 -DHAVE_WEAK_ATTRIBUTE_EXITCODE=0 -DLLROUND_OK=1 -DMODF_OK=1 -DBSD_SIGNALS=1 -DINSTALL_DOCUMENTATION=OFF -DSWIPL_PACKAGES_GUI=OFF'
fi
