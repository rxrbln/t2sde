[I] Cuts 65% of tokens by talking like caveman

[T] Claude Code skill that cuts 65% of tokens by talking like caveman.

[U] https://github.com/juliusbrussee/caveman

[A] JuliusBrussee
[M] The T2 Project <t2@t2-project.org>

[C] extra/tool
[F] CROSS

[E] add node

[L] MIT
[V] 2.0.0

[D] 5b18be5124e0f04823bdfbb2ca1b156d31afd4f9bfcd00f54e71b1af caveman-2.0.0.tar.gz https://github.com/juliusbrussee/caveman/archive/v2.0.0/


runmake=0
cavemandir="$datadir/caveman"

install_caveman() {
	mkdir -p $root$cavemandir
	cp -a agents cli commands dist plugins skills src package.json \
		$root$cavemandir/
	chmod 755 $root$cavemandir/cli/install.js

	ln -sf $cavemandir/cli/install.js $root$bindir/caveman
}

hook_add inmake 5 install_caveman
