diff --git a/gcc/config/i860/i860-pipe.cc b/gcc/config/i860/i860-pipe.cc
new file mode 100644
index 00000000000..ec362839945
--- /dev/null
+++ b/gcc/config/i860/i860-pipe.cc
@@ -0,0 +1,1294 @@
+/* Pipelined floating point loops for the i860.
+   Copyright (C) 2026 René Rebe <rene@exactco.de>
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 3, or (at your option)
+any later version.
+
+GCC is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+/* A pipelined instruction writes to its destination the result of the instruction that
+   entered its unit some pushes ago.  So a whole iteration cannot run at once: each insn of a
+   counted loop gets a stage, and the data of iteration I is handled by it in the run I + stage
+   of the loop.  With N iterations and D the largest stage there are D prologue runs, N - D of
+   the loop itself and D more to drain the pipes.  Runs in which an operation has no data
+   push f0 instead, which keeps a unit advancing.
+
+   The accesses of an iteration are spread over runs, which is valid if no two of them can
+   overlap in a way that changes their order: known for one base register, asked of the alias
+   oracle or else tested at run time for two.  The original loop stays for what fails these
+   tests and for N <= D.  A recurrence stays scalar as its result is needed by the next run.  */
+
+#define IN_TARGET_CODE 1
+
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "backend.h"
+#include "target.h"
+#include "rtl.h"
+#include "tree.h"
+#include "df.h"
+#include "memmodel.h"
+#include "tm_p.h"
+#include "insn-config.h"
+#include "regs.h"
+#include "emit-rtl.h"
+#include "recog.h"
+#include "insn-attr.h"
+#include "cfghooks.h"
+#include "cfgrtl.h"
+#include "cfganal.h"
+#include "cfgbuild.h"
+#include "alias.h"
+#include "explow.h"
+#include "optabs.h"
+#include "expr.h"
+#include "predict.h"
+#include "tree-pass.h"
+#include "rtl-iter.h"
+#include "output.h"
+
+namespace {
+
+const int FP0 = 32;
+const int MAX_STAGE = 16;
+const int MAX_EMITTED = 64;
+
+enum pipe_kind { PIPE_LOAD, PIPE_STORE, PIPE_OP, PIPE_INCR };
+
+struct pipe_insn
+{
+  rtx_insn *insn;
+  enum pipe_kind kind;
+  machine_mode mode;
+  rtx mem;
+  int stream;
+  HOST_WIDE_INT disp;
+  enum rtx_code code;
+  int unit;			/* 0 multiplier, 1 adder, 2 pipelined loads */
+  bool scalar;
+  int dest;
+  int src[2];			/* the registers read */
+  int val[2];			/* the insns defining them here, or -1 */
+  int nsrc;
+  int pop_to, pop_runs;		/* where and how many runs later the result arrives */
+  int stage;
+  int newreg;
+  bool field_used;
+};
+
+struct pipe_stream
+{
+  int reg;
+  HOST_WIDE_INT stride;
+  bool autoinc;
+  int incr_pos;
+  bool store;
+  HOST_WIDE_INT maxdisp;
+};
+
+class pipe_loop
+{
+public:
+  pipe_loop (basic_block, bool);
+  bool analyze ();
+  void transform (pipe_loop *);
+
+  int depth;
+
+private:
+  bool scan_body ();
+  bool scan_mem (rtx, int);
+  bool find_values ();
+  bool map_units ();
+  bool solve_stages ();
+  int ready (int, int);
+  bool check_memory ();
+  bool check_displacements ();
+  bool allocate ();
+  HOST_WIDE_INT access_disp (int, bool, int);
+  void emit_run (bool, int);
+  void emit_flush ();
+  bool piped (const pipe_insn &p) const
+    { return (p.kind == PIPE_OP && !p.scalar) || (p.kind == PIPE_LOAD && use_pfld); }
+  void emit_path (basic_block, int, rtx, basic_block);
+  rtx real_pattern (int, bool, int);
+  void item_regs (int, auto_vec<int> &, auto_vec<int> &);
+  bool items_conflict (int, int);
+  bool plan_pairs ();
+  rtx dual_kernel ();
+  rtx_insn *branch_to_scalar (enum rtx_code, rtx, rtx);
+  bool after_incr (int i)
+    { const pipe_stream &s = streams[body[i].stream]; return s.incr_pos >= 0 && i > s.incr_pos; }
+  int value_reg (int);
+  HOST_WIDE_INT test_margin (const pipe_stream &a, const pipe_stream &b)
+    { return (depth + 2) * abs_hwi (a.stride) + 2 * MAX (a.maxdisp, b.maxdisp) + 32; }
+
+  basic_block loop, pre, exit_bb;
+  rtx_insn *jump, *prime;
+  rtx count, step;
+  auto_vec<pipe_insn> body;
+  auto_vec<pipe_stream> streams;
+  auto_vec<std::pair<int, int> > tests;
+  bool use_pfld;
+  int minstage[3];
+  int lastpop[3];		/* the last drain run in which a unit delivers something */
+  struct pair { int fp, core; bool bla; };
+  auto_vec<pair> pairs;
+  rtx scalar_label;
+  int tmp_reg;
+};
+
+pipe_loop::pipe_loop (basic_block bb, bool pfld)
+  : depth (0), loop (bb), pre (NULL), exit_bb (NULL), jump (NULL), prime (NULL), count (NULL),
+    step (NULL), use_pfld (pfld), scalar_label (NULL), tmp_reg (-1)
+{
+  for (int u = 0; u < 3; u++)
+    {
+      minstage[u] = 0;
+      lastpop[u] = -1;
+    }
+}
+
+/* A memory reference of insn I: one stream per base register.  */
+
+bool
+pipe_loop::scan_mem (rtx mem, int i)
+{
+  rtx addr = XEXP (mem, 0);
+  pipe_insn &p = body[i];
+  HOST_WIDE_INT size = GET_MODE_SIZE (GET_MODE (mem));
+  HOST_WIDE_INT disp = 0;
+  bool autoinc = false;
+  rtx base;
+
+  if (MEM_VOLATILE_P (mem) || MEM_ALIGN (mem) < size * BITS_PER_UNIT)
+    return false;
+  if (REG_P (addr))
+    base = addr;
+  else if (GET_CODE (addr) == PLUS && REG_P (XEXP (addr, 0)) && CONST_INT_P (XEXP (addr, 1)))
+    {
+      base = XEXP (addr, 0);
+      disp = INTVAL (XEXP (addr, 1));
+    }
+  else if (GET_CODE (addr) == PRE_INC || GET_CODE (addr) == PRE_DEC)
+    {
+      base = XEXP (addr, 0);
+      autoinc = true;
+    }
+  else
+    return false;
+  if (disp % size != 0 || rtx_equal_p (base, count) || rtx_equal_p (base, step))
+    return false;
+
+  p.mem = mem;
+  p.disp = disp;
+  unsigned s;
+  for (s = 0; s < streams.length (); s++)
+    if (streams[s].reg == (int) REGNO (base))
+      break;
+  if (s == streams.length ())
+    {
+      pipe_stream n = { (int) REGNO (base), 0, false, -1, false, 0 };
+      streams.safe_push (n);
+    }
+  else if (autoinc || streams[s].autoinc)
+    return false;
+  if (autoinc)
+    {
+      streams[s].autoinc = true;
+      streams[s].stride = GET_CODE (addr) == PRE_INC ? size : -size;
+    }
+  streams[s].store |= p.kind == PIPE_STORE;
+  streams[s].maxdisp = MAX (streams[s].maxdisp, abs_hwi (disp));
+  p.stream = s;
+  return true;
+}
+
+/* Only FP loads, stores and arithmetic, and increments of the base registers.  */
+
+bool
+pipe_loop::scan_body ()
+{
+  rtx_insn *insn;
+
+  FOR_BB_INSNS (loop, insn)
+    {
+      if (!NONDEBUG_INSN_P (insn) || insn == jump)
+	continue;
+      rtx set = single_set (insn);
+      if (!set || GET_CODE (PATTERN (insn)) != SET || volatile_insn_p (PATTERN (insn)))
+	return false;
+      rtx dst = SET_DEST (set), src = SET_SRC (set);
+      pipe_insn p = {};
+      p.insn = insn;
+      p.stream = p.dest = p.pop_to = -1;
+      p.val[0] = p.val[1] = -1;
+      p.newreg = -1;
+      p.mode = GET_MODE (dst);
+      int i = body.length ();
+
+      if (MEM_P (src) || MEM_P (dst))
+	if (p.mode != SFmode && p.mode != DFmode)
+	  return false;
+      if (FP_REG_P (dst) && MEM_P (src))
+	{
+	  p.kind = PIPE_LOAD;
+	  p.unit = 2;
+	  p.dest = REGNO (dst);
+	  body.safe_push (p);
+	  if (!scan_mem (src, i))
+	    return false;
+	}
+      else if (MEM_P (dst) && FP_REG_P (src))
+	{
+	  p.kind = PIPE_STORE;
+	  p.src[0] = REGNO (src);
+	  p.nsrc = 1;
+	  body.safe_push (p);
+	  if (!scan_mem (dst, i))
+	    return false;
+	}
+      else if (FP_REG_P (dst)
+	       && (GET_CODE (src) == PLUS || GET_CODE (src) == MINUS || GET_CODE (src) == MULT)
+	       && FP_REG_P (XEXP (src, 0)) && FP_REG_P (XEXP (src, 1))
+	       && GET_MODE (src) == p.mode
+	       && GET_MODE (XEXP (src, 0)) == p.mode && GET_MODE (XEXP (src, 1)) == p.mode)
+	{
+	  p.kind = PIPE_OP;
+	  p.code = GET_CODE (src);
+	  p.unit = p.code == MULT ? 0 : 1;
+	  p.dest = REGNO (dst);
+	  p.src[0] = REGNO (XEXP (src, 0));
+	  p.src[1] = REGNO (XEXP (src, 1));
+	  p.nsrc = 2;
+	  body.safe_push (p);
+	}
+      else if (REG_P (dst) && GP_REGNO_P (REGNO (dst)) && GET_CODE (src) == PLUS
+	       && rtx_equal_p (XEXP (src, 0), dst) && CONST_INT_P (XEXP (src, 1))
+	       && !rtx_equal_p (dst, count) && !rtx_equal_p (dst, step))
+	{
+	  p.kind = PIPE_INCR;
+	  p.dest = REGNO (dst);
+	  p.disp = INTVAL (XEXP (src, 1));
+	  body.safe_push (p);
+	}
+      else
+	return false;
+    }
+
+  for (unsigned i = 0; i < body.length (); i++)
+    if (body[i].kind == PIPE_INCR)
+      {
+	bool found = false;
+	for (unsigned s = 0; s < streams.length (); s++)
+	  if (streams[s].reg == body[i].dest)
+	    {
+	      if (streams[s].autoinc || streams[s].incr_pos >= 0)
+		return false;
+	      streams[s].stride = body[i].disp;
+	      streams[s].incr_pos = i;
+	      found = true;
+	    }
+	/* a counter nothing here uses: not worth a special case */
+	if (!found)
+	  return false;
+      }
+  return true;
+}
+
+/* Who defines what each insn reads.  */
+
+bool
+pipe_loop::find_values ()
+{
+  auto_vec<int> def, defs;
+  def.safe_grow_cleared (FIRST_PSEUDO_REGISTER);
+  defs.safe_grow_cleared (FIRST_PSEUDO_REGISTER);
+  for (int r = 0; r < FIRST_PSEUDO_REGISTER; r++)
+    def[r] = -1;
+
+  for (unsigned i = 0; i < body.length (); i++)
+    if (body[i].kind == PIPE_LOAD || body[i].kind == PIPE_OP)
+      {
+	int words = GET_MODE_SIZE (body[i].mode) / UNITS_PER_WORD;
+	for (int w = 0; w < words; w++)
+	  defs[body[i].dest + w]++;
+      }
+
+  bool accum[2] = { false, false };
+  bitmap live_out = df_get_live_in (exit_bb);
+
+  for (unsigned i = 0; i < body.length (); i++)
+    {
+      pipe_insn &p = body[i];
+      if (p.kind == PIPE_INCR)
+	continue;
+      int words = GET_MODE_SIZE (p.mode) / UNITS_PER_WORD;
+      for (int n = 0; n < p.nsrc; n++)
+	{
+	  int r = p.src[n];
+	  int d = def[r];
+	  if (words == 2 && def[r + 1] != d)
+	    return false;
+	  if (d >= 0 && body[d].mode != p.mode)
+	    return false;
+	  if (d >= 0)
+	    p.val[n] = d;
+	  else if (defs[r] || (words == 2 && defs[r + 1]))
+	    {
+	      /* only the update of an accumulator reads an older value */
+	      if (p.kind != PIPE_OP || p.dest != r || defs[r] != 1
+		  || (words == 2 && defs[r + 1] != 1))
+		return false;
+	      p.scalar = true;
+	      accum[p.unit] = true;
+	    }
+	}
+      if (p.kind == PIPE_STORE)
+	continue;
+      for (int w = 0; w < words; w++)
+	def[p.dest + w] = i;
+      /* the temporaries get other registers */
+      if (!p.scalar
+	  && (REGNO_REG_SET_P (live_out, p.dest)
+	      || REGNO_REG_SET_P (live_out, p.dest + words - 1)))
+	return false;
+    }
+
+  /* a scalar and a pipelined instruction do not share a unit */
+  for (unsigned i = 0; i < body.length (); i++)
+    if (body[i].kind == PIPE_OP && accum[body[i].unit])
+      body[i].scalar = true;
+  return true;
+}
+
+/* With K pipelined insns on a unit of L stages, each pops the result of L pushes ago.  */
+
+bool
+pipe_loop::map_units ()
+{
+  bool any = false;
+
+  for (int unit = 0; unit < 3; unit++)
+    {
+      auto_vec<int> ops;
+      machine_mode mode = VOIDmode;
+
+      for (unsigned i = 0; i < body.length (); i++)
+	if (body[i].kind != PIPE_STORE && body[i].kind != PIPE_INCR
+	    && body[i].unit == unit && piped (body[i]))
+	  {
+	    if (mode != VOIDmode && mode != body[i].mode)
+	      return false;
+	    mode = body[i].mode;
+	    ops.safe_push (i);
+	  }
+      if (ops.is_empty ())
+	continue;
+      any |= unit < 2;
+      int stages = unit == 0 && mode == DFmode ? 2 : 3;
+      int k = ops.length ();
+      for (int j = 0; j < k; j++)
+	{
+	  body[ops[j]].pop_to = ops[(j + stages) % k];
+	  body[ops[j]].pop_runs = (j + stages) / k;
+	}
+    }
+  return any;
+}
+
+/* The stage in which insn C can read the value of insn V.  */
+
+int
+pipe_loop::ready (int v, int c)
+{
+  const pipe_insn &p = body[v];
+
+  if (piped (p))
+    return p.stage + p.pop_runs + (c < p.pop_to ? 1 : 0);
+  return p.stage;
+}
+
+bool
+pipe_loop::solve_stages ()
+{
+  int n = body.length ();
+  bool changed = true;
+
+  for (int round = 0; changed; round++)
+    {
+      changed = false;
+      if (round > 8 * MAX_STAGE)
+	return false;
+      for (int c = 0; c < n; c++)
+	for (int s = 0; s < body[c].nsrc; s++)
+	  {
+	    int v = body[c].val[s];
+	    if (v < 0)
+	      continue;
+	    int r = ready (v, c);
+	    if (r > body[c].stage)
+	      {
+		body[c].stage = r;
+		changed = true;
+	      }
+	  }
+      for (int c = n - 1; c >= 0; c--)
+	for (int s = 0; s < body[c].nsrc; s++)
+	  {
+	    int v = body[c].val[s];
+	    if (v < 0)
+	      continue;
+	    int r = ready (v, c);
+	    if (r < body[c].stage)
+	      {
+		body[v].stage += body[c].stage - r;
+		changed = true;
+	      }
+	  }
+      for (int i = 0; i < n; i++)
+	if (body[i].stage > MAX_STAGE)
+	  return false;
+    }
+
+  /* a pipelined insn must not read the destination it writes */
+  depth = 0;
+  for (int u = 0; u < 3; u++)
+    {
+      lastpop[u] = -1;
+      minstage[u] = MAX_STAGE;
+    }
+  for (int c = 0; c < n; c++)
+    {
+      pipe_insn &p = body[c];
+      for (int s = 0; s < p.nsrc; s++)
+	if (p.val[s] >= 0)
+	  {
+	    if (ready (p.val[s], c) != p.stage)
+	      return false;
+	    const pipe_insn &d = body[p.val[s]];
+	    if (piped (d))
+	      {
+		if (d.pop_to == c)
+		  return false;
+		body[d.pop_to].field_used = true;
+		lastpop[d.unit] = MAX (lastpop[d.unit], d.stage - 1 + d.pop_runs);
+	      }
+	  }
+      if (p.kind != PIPE_INCR)
+	depth = MAX (depth, p.stage);
+      if (piped (p))
+	minstage[p.unit] = MIN (minstage[p.unit], p.stage);
+    }
+  return depth > 0 && depth * n <= MAX_EMITTED;
+}
+
+/* Whether accesses in iterations DELTA apart reorder.  Different base registers go to
+   the alias oracle, what may alias is tested at run time.  */
+
+bool
+pipe_loop::check_memory ()
+{
+  int n = body.length ();
+  bool any_store = false;
+
+  for (unsigned s = 0; s < streams.length (); s++)
+    any_store |= streams[s].store;
+  for (unsigned s = 0; s < streams.length (); s++)
+    if (any_store && streams[s].stride == 0)
+      return false;
+
+  for (int a = 0; a < n; a++)
+    for (int b = a + 1; b < n; b++)
+      {
+	const pipe_insn &pa = body[a], &pb = body[b];
+
+	if (pa.stream < 0 || pb.stream < 0
+	    || (pa.kind != PIPE_STORE && pb.kind != PIPE_STORE))
+	  continue;
+	const pipe_stream &sa = streams[pa.stream], &sb = streams[pb.stream];
+	if (pa.stream == pb.stream)
+	  {
+	    HOST_WIDE_INT oa = pa.disp + (after_incr (a) ? sa.stride : 0);
+	    HOST_WIDE_INT ob = pb.disp + (after_incr (b) ? sa.stride : 0);
+	    HOST_WIDE_INT la = GET_MODE_SIZE (pa.mode), lb = GET_MODE_SIZE (pb.mode);
+
+	    for (int d = -depth - 2; d <= depth + 2; d++)
+	      {
+		HOST_WIDE_INT addr = ob + d * sa.stride;
+
+		if (addr >= oa + la || oa >= addr + lb)
+		  continue;
+		/* A is before B in the same iteration */
+		bool before = d >= 0;
+		bool after = pa.stage < d + pb.stage || (pa.stage == d + pb.stage);
+		if (before != after)
+		  return false;
+	      }
+	    continue;
+	  }
+	if (!may_alias_p (pa.mem, pb.mem))
+	  continue;
+	if (abs_hwi (sa.stride) != abs_hwi (sb.stride) || sa.stride == 0
+	    || test_margin (sa, sb) > 0x3fff)
+	  return false;
+	std::pair<int, int> t (MIN (pa.stream, pb.stream), MAX (pa.stream, pb.stream));
+	bool dup = false;
+	for (unsigned i = 0; i < tests.length (); i++)
+	  dup |= tests[i] == t;
+	if (!dup)
+	  tests.safe_push (t);
+      }
+  return tests.length () <= 6;
+}
+
+/* The displacement of the load or store I.  In the prologue and the loop the base register
+   advances every run; in the drain it stands at the value after the last iteration.  */
+
+HOST_WIDE_INT
+pipe_loop::access_disp (int i, bool drain, int run)
+{
+  const pipe_insn &p = body[i];
+  const pipe_stream &s = streams[p.stream];
+
+  if (!drain)
+    return p.disp - p.stage * s.stride;
+  return p.disp + (run - p.stage) * s.stride + (after_incr (i) ? s.stride : 0);
+}
+
+bool
+pipe_loop::check_displacements ()
+{
+  for (unsigned i = 0; i < body.length (); i++)
+    if (body[i].stream >= 0 && !streams[body[i].stream].autoinc)
+      {
+	HOST_WIDE_INT size = GET_MODE_SIZE (body[i].mode);
+
+	for (int run = -1; run < body[i].stage; run++)
+	  {
+	    HOST_WIDE_INT d = access_disp (i, run >= 0, run);
+	    if (d % size != 0 || !IN_RANGE (d, -0x8000, 0x7fff - size))
+	      return false;
+	  }
+      }
+  return true;
+}
+
+/* One register for each value: the temporaries of the scalar loop are free here.  */
+
+bool
+pipe_loop::allocate ()
+{
+  HARD_REG_SET taken;
+  bitmap in = df_get_live_in (loop), out = df_get_live_in (exit_bb);
+
+  CLEAR_HARD_REG_SET (taken);
+  for (int r = FP0; r < FP0 + 32; r++)
+    if (REGNO_REG_SET_P (in, r) || REGNO_REG_SET_P (out, r) || fixed_regs[r]
+	|| !call_used_or_fixed_reg_p (r))
+      SET_HARD_REG_BIT (taken, r);
+
+  for (unsigned i = 0; i < body.length (); i++)
+    for (int s = 0; s < body[i].nsrc; s++)
+      if (body[i].val[s] < 0)
+	{
+	  int words = GET_MODE_SIZE (body[i].mode) / UNITS_PER_WORD;
+	  for (int w = 0; w < words; w++)
+	    SET_HARD_REG_BIT (taken, body[i].src[s] + w);
+	}
+  for (unsigned i = 0; i < body.length (); i++)
+    if (body[i].kind == PIPE_OP && body[i].scalar)
+      {
+	int words = GET_MODE_SIZE (body[i].mode) / UNITS_PER_WORD;
+	for (int s = 0; s < 2; s++)
+	  if (body[i].val[s] < 0 && body[i].src[s] == body[i].dest)
+	    {
+	      body[i].newreg = body[i].dest;
+	      for (int w = 0; w < words; w++)
+		SET_HARD_REG_BIT (taken, body[i].dest + w);
+	    }
+      }
+
+  for (unsigned i = 0; i < body.length (); i++)
+    {
+      pipe_insn &p = body[i];
+
+      if (p.kind != PIPE_LOAD && p.kind != PIPE_OP)
+	continue;
+      if (p.newreg >= 0)
+	continue;
+      if (piped (p) && !p.field_used)
+	{
+	  p.newreg = FP0;
+	  continue;
+	}
+      int words = GET_MODE_SIZE (p.mode) / UNITS_PER_WORD, r;
+      for (r = FP0 + 32 - words; r > FP0; r -= words)
+	if (!TEST_HARD_REG_BIT (taken, r) && (words == 1 || !TEST_HARD_REG_BIT (taken, r + 1)))
+	  break;
+      if (r <= FP0)
+	return false;
+      p.newreg = r;
+      for (int w = 0; w < words; w++)
+	SET_HARD_REG_BIT (taken, r + w);
+    }
+
+  if (!tests.is_empty ())
+    {
+      for (int r = 16; r < 30 && tmp_reg < 0; r++)
+	if (!REGNO_REG_SET_P (in, r) && !fixed_regs[r] && call_used_or_fixed_reg_p (r)
+	    && r != (int) REGNO (count) && r != (int) REGNO (step))
+	  tmp_reg = r;
+      if (tmp_reg < 0)
+	return false;
+    }
+  return true;
+}
+
+bool
+pipe_loop::analyze ()
+{
+  jump = BB_END (loop);
+  if (!JUMP_P (jump) || recog_memoized (jump) != CODE_FOR_i860_bla_loop
+      || !optimize_bb_for_speed_p (loop) || EDGE_COUNT (loop->succs) != 2
+      || EDGE_COUNT (loop->preds) != 2)
+    return false;
+
+  edge e;
+  edge_iterator ei;
+  FOR_EACH_EDGE (e, ei, loop->succs)
+    if (e->dest != loop)
+      exit_bb = e->dest;
+  FOR_EACH_EDGE (e, ei, loop->preds)
+    if (e->src != loop)
+      pre = e->src;
+  if (!exit_bb || !pre || !find_edge (loop, loop) || exit_bb == EXIT_BLOCK_PTR_FOR_FN (cfun)
+      || pre == ENTRY_BLOCK_PTR_FOR_FN (cfun) || !single_succ_p (pre))
+    return false;
+
+  rtx pat = PATTERN (jump);
+  count = SET_DEST (XVECEXP (pat, 0, 1));
+  step = XEXP (XVECEXP (pat, 0, 2), 0);
+  if (!REG_P (count) || !REG_P (step))
+    return false;
+
+  prime = BB_END (pre);
+  while (prime != BB_HEAD (pre) && !NONDEBUG_INSN_P (prime))
+    prime = PREV_INSN (prime);
+  if (!NONDEBUG_INSN_P (prime) || recog_memoized (prime) != CODE_FOR_i860_bla_prime
+      || !rtx_equal_p (SET_DEST (PATTERN (prime)), count)
+      || prime == BB_HEAD (pre))
+    return false;
+
+  if (!(scan_body () && find_values () && map_units () && solve_stages ()
+	&& check_memory () && check_displacements () && allocate ()))
+    return false;
+  if (TARGET_DUAL_FP && !plan_pairs ())
+    pairs.truncate (0);
+  return true;
+}
+
+int
+pipe_loop::value_reg (int v)
+{
+  const pipe_insn &p = body[v];
+
+  if (piped (p))
+    return body[p.pop_to].newreg;
+  return p.newreg;
+}
+
+rtx
+pipe_loop::real_pattern (int i, bool drain, int run)
+{
+  const pipe_insn &p = body[i];
+
+  if (p.kind == PIPE_INCR)
+    {
+      rtx r = gen_rtx_REG (SImode, p.dest);
+      return gen_rtx_SET (r, plus_constant (SImode, r, p.disp));
+    }
+  if (p.kind == PIPE_OP)
+    {
+      rtx a = gen_rtx_REG (p.mode, p.val[0] >= 0 ? value_reg (p.val[0]) : p.src[0]);
+      rtx b = gen_rtx_REG (p.mode, p.val[1] >= 0 ? value_reg (p.val[1]) : p.src[1]);
+      rtx d = gen_rtx_REG (p.mode, p.newreg);
+
+      if (p.scalar)
+	return gen_rtx_SET (d, gen_rtx_fmt_ee (p.code, p.mode, a, b));
+      if (p.mode == DFmode)
+	return (p.code == MULT ? gen_i860_pfmuldf (d, a, b)
+		: p.code == PLUS ? gen_i860_pfadddf (d, a, b)
+		: gen_i860_pfsubdf (d, a, b));
+      return (p.code == MULT ? gen_i860_pfmulsf (d, a, b)
+	      : p.code == PLUS ? gen_i860_pfaddsf (d, a, b)
+	      : gen_i860_pfsubsf (d, a, b));
+    }
+
+  rtx mem = copy_rtx (p.mem);
+  if (!streams[p.stream].autoinc)
+    {
+      rtx base = gen_rtx_REG (SImode, streams[p.stream].reg);
+      XEXP (mem, 0) = plus_constant (SImode, base, access_disp (i, drain, run));
+    }
+  set_mem_expr (mem, NULL_TREE);
+  clear_mem_offset (mem);
+  if (p.kind == PIPE_LOAD && use_pfld)
+    return (p.mode == DFmode ? gen_i860_pflddf (gen_rtx_REG (DFmode, p.newreg), mem)
+	    : gen_i860_pfldsf (gen_rtx_REG (SFmode, p.newreg), mem));
+  if (p.kind == PIPE_LOAD)
+    return gen_rtx_SET (gen_rtx_REG (p.mode, p.newreg), mem);
+  return gen_rtx_SET (mem, gen_rtx_REG (p.mode, p.val[0] >= 0 ? value_reg (p.val[0]) : p.src[0]));
+}
+
+/* The FP registers insn I reads and writes.  */
+
+void
+pipe_loop::item_regs (int i, auto_vec<int> &reads, auto_vec<int> &writes)
+{
+  const pipe_insn &p = body[i];
+  int words = p.kind == PIPE_INCR ? 1 : GET_MODE_SIZE (p.mode) / UNITS_PER_WORD;
+
+  for (int s = 0; s < p.nsrc; s++)
+    for (int w = 0; w < words; w++)
+      reads.safe_push ((p.val[s] >= 0 ? value_reg (p.val[s]) : p.src[s]) + w);
+  if (p.kind == PIPE_LOAD || p.kind == PIPE_OP)
+    for (int w = 0; w < words; w++)
+      writes.safe_push (p.newreg + w);
+}
+
+bool
+pipe_loop::items_conflict (int a, int b)
+{
+  auto_vec<int> ra, wa, rb, wb;
+
+  item_regs (a, ra, wa);
+  item_regs (b, rb, wb);
+  for (unsigned i = 0; i < wa.length (); i++)
+    {
+      if (wa[i] == FP0 || wa[i] == FP0 + 1)
+	continue;
+      for (unsigned j = 0; j < rb.length (); j++)
+	if (wa[i] == rb[j])
+	  return true;
+      for (unsigned j = 0; j < wb.length (); j++)
+	if (wa[i] == wb[j])
+	  return true;
+    }
+  for (unsigned i = 0; i < wb.length (); i++)
+    {
+      if (wb[i] == FP0 || wb[i] == FP0 + 1)
+	continue;
+      for (unsigned j = 0; j < ra.length (); j++)
+	if (wb[i] == ra[j])
+	  return true;
+    }
+  return false;
+}
+
+/* FP and core halves of the loop as pairs, each after what it depends on and not in one pair with
+   it: which half of a pair sees the other's result is not known.  The slot of bla holds fnop, as
+   a real FP half could not run again after a trap there.  False if this saves nothing.  */
+
+bool
+pipe_loop::plan_pairs ()
+{
+  auto_vec<int> fps, cores, placed;
+  int n = body.length ();
+
+  placed.safe_grow_cleared (n);
+  for (int i = 0; i < n; i++)
+    {
+      placed[i] = -1;
+      if (body[i].kind == PIPE_OP)
+	fps.safe_push (i);
+      else
+	cores.safe_push (i);
+    }
+
+  unsigned nf = 0, nc = 0;
+  while (nf < fps.length () || nc < cores.length ())
+    {
+      int f = nf < fps.length () ? fps[nf] : -1;
+      int c = nc < cores.length () ? cores[nc] : -1;
+      int now = pairs.length ();
+      auto ready = [&] (int x)
+	{
+	  if (x < 0)
+	    return false;
+	  for (int e = 0; e < x; e++)
+	    if ((placed[e] < 0 || placed[e] == now) && items_conflict (e, x))
+	      return false;
+	  return true;
+	};
+      bool fok = ready (f), cok = ready (c);
+
+      if (fok && cok && items_conflict (f, c))
+	{
+	  if (f < c)
+	    cok = false;
+	  else
+	    fok = false;
+	}
+      if (!fok && !cok)
+	return false;
+      pair p = { fok ? f : -1, cok ? c : -1, false };
+      pairs.safe_push (p);
+      if (fok)
+	{
+	  placed[f] = now;
+	  nf++;
+	}
+      if (cok)
+	{
+	  placed[c] = now;
+	  nc++;
+	}
+    }
+
+  /* bla and its slot at the end */
+  pair last = pairs.last ();
+  if (last.fp >= 0)
+    {
+      pairs.last ().core = -1;
+      pairs.last ().bla = true;
+      pair slot = { -1, last.core, false };
+      pairs.safe_push (slot);
+    }
+  else
+    {
+      unsigned m = pairs.length ();
+      if (m >= 2 && pairs[m - 2].core < 0)
+	pairs[m - 2].bla = true;
+      else
+	{
+	  pair b = { -1, -1, true };
+	  pairs.safe_insert (m - 1, b);
+	}
+    }
+  return (int) pairs.length () < n + 1;
+}
+
+/* The loop as one insn: the first element marks it, then an FP and a core half per pair.  */
+
+rtx
+pipe_loop::dual_kernel ()
+{
+  int m = pairs.length ();
+  rtvec v = rtvec_alloc (1 + 2 * m);
+
+  RTVEC_ELT (v, 0) = gen_rtx_UNSPEC_VOLATILE (VOIDmode, gen_rtvec (1, const0_rtx),
+					      UNSPECV_DUAL_KERNEL);
+  for (int i = 0; i < m; i++)
+    {
+      const pair &p = pairs[i];
+
+      RTVEC_ELT (v, 1 + 2 * i) = (p.fp >= 0 ? real_pattern (p.fp, false, 0)
+				  : gen_rtx_USE (VOIDmode, const0_rtx));
+      if (p.bla)
+	RTVEC_ELT (v, 2 + 2 * i)
+	  = gen_rtx_SET (count, gen_rtx_UNSPEC_VOLATILE (SImode, gen_rtvec (2, count, step),
+							 UNSPECV_DUAL_BLA));
+      else
+	RTVEC_ELT (v, 2 + 2 * i) = (p.core >= 0 ? real_pattern (p.core, false, 0)
+				    : gen_rtx_USE (VOIDmode, const0_rtx));
+    }
+  return gen_rtx_PARALLEL (VOIDmode, v);
+}
+
+/* One run outside of the loop.  RUN counts from zero in the prologue and in the drain.  */
+
+void
+pipe_loop::emit_run (bool drain, int run)
+{
+  for (unsigned i = 0; i < body.length (); i++)
+    {
+      const pipe_insn &p = body[i];
+      bool active = drain ? run < p.stage : run >= p.stage;
+
+      if (p.kind == PIPE_INCR)
+	active = !drain;
+      if (active)
+	emit_insn (real_pattern (i, drain, run));
+      else if (piped (p)
+	       && (drain ? run <= lastpop[p.unit] : run >= minstage[p.unit]))
+	{
+	  rtx z = gen_rtx_REG (p.mode, FP0);
+	  rtx d = gen_rtx_REG (p.mode, p.newreg);
+
+	  /* the stack is always there to read */
+	  if (p.unit == 2)
+	    {
+	      rtx m = gen_frame_mem (p.mode, stack_pointer_rtx);
+	      emit_insn (p.mode == DFmode ? gen_i860_pflddf (d, m) : gen_i860_pfldsf (d, m));
+	    }
+	  else if (p.mode == DFmode)
+	    emit_insn (p.unit == 0 ? gen_i860_pfmuldf (d, z, z) : gen_i860_pfadddf (d, z, z));
+	  else
+	    emit_insn (p.unit == 0 ? gen_i860_pfmulsf (d, z, z) : gen_i860_pfaddsf (d, z, z));
+	}
+    }
+}
+
+/* A pop writes what the stage holds in its own precision: a double left by earlier code would
+   overwrite the neighbour of a single destination.  So the old contents go to f0 first.  With
+   double destinations a stale value stays within the register it is meant for.  */
+
+void
+pipe_loop::emit_flush ()
+{
+  for (int unit = 0; unit < 3; unit++)
+    for (unsigned i = 0; i < body.length (); i++)
+      if (body[i].kind != PIPE_STORE && body[i].kind != PIPE_INCR
+	  && body[i].unit == unit && piped (body[i]))
+	{
+	  rtx z = gen_rtx_REG (SFmode, FP0);
+
+	  if (body[i].mode == SFmode)
+	    for (int n = 0; n < 3; n++)
+	      emit_insn (unit == 2 ? gen_i860_pfldsf (z, gen_frame_mem (SFmode, stack_pointer_rtx))
+			 : unit == 0 ? gen_i860_pfmulsf (z, z, z) : gen_i860_pfaddsf (z, z, z));
+	  break;
+	}
+}
+
+rtx_insn *
+pipe_loop::branch_to_scalar (enum rtx_code code, rtx a, rtx b)
+{
+  rtx cond = gen_rtx_fmt_ee (code, VOIDmode, a, b);
+  rtx ref = gen_rtx_LABEL_REF (Pmode, scalar_label);
+  rtx_insn *j = emit_jump_insn (gen_rtx_SET (pc_rtx,
+					     gen_rtx_IF_THEN_ELSE (VOIDmode, cond, ref, pc_rtx)));
+  JUMP_LABEL (j) = scalar_label;
+  LABEL_NUSES (scalar_label)++;
+  return j;
+}
+
+/* What was emitted before the block NEXT since FIRST becomes a block after PREV.  */
+
+static basic_block
+new_block (rtx_insn *seq, basic_block prev, basic_block next, profile_count cnt)
+{
+  rtx_insn *first = seq, *last = seq;
+
+  emit_insn_before_noloc (seq, BB_HEAD (next), NULL);
+  for (rtx_insn *i = first; i != BB_HEAD (next); i = NEXT_INSN (i))
+    if (!BARRIER_P (i))
+      last = i;
+  basic_block bb = create_basic_block (first, last, prev);
+  BB_COPY_PARTITION (bb, prev);
+  bb->count = cnt;
+  return bb;
+}
+
+/* One way through the loop, from the block PREV with FLAGS on the edge, up to a jump to the exit.
+   Its blocks go in front of the scalar loop.  */
+
+void
+pipe_loop::emit_path (basic_block prev, int flags, rtx entry, basic_block scalar)
+{
+  profile_count cnt = pre->count;
+  rtx_insn *seq;
+  edge e;
+
+  start_sequence ();
+  if (entry)
+    emit_label (entry);
+  emit_insn (gen_rtx_SET (count, plus_constant (SImode, count, -depth)));
+  emit_flush ();
+  for (int run = 0; run < depth; run++)
+    emit_run (false, run);
+  emit_insn (gen_i860_bla_prime (count, step));
+  rtx exit_label = block_label (exit_bb);
+  if (!pairs.is_empty ())
+    {
+      emit_insn (dual_kernel ());
+      for (int run = 0; run < depth; run++)
+	emit_run (true, run);
+      rtx_insn *dj = emit_jump_insn (gen_jump (exit_label));
+      JUMP_LABEL (dj) = exit_label;
+      LABEL_NUSES (exit_label)++;
+      emit_barrier ();
+    }
+  seq = get_insns ();
+  end_sequence ();
+  basic_block setup = new_block (seq, scalar->prev_bb, scalar, cnt);
+  e = make_edge (prev, setup, flags);
+  e->probability = profile_probability::likely ();
+  if (entry)
+    LABEL_NUSES (entry)++;
+  if (!pairs.is_empty ())
+    {
+      e = make_edge (setup, exit_bb, 0);
+      e->probability = profile_probability::always ();
+      return;
+    }
+
+  rtx label = gen_label_rtx ();
+  start_sequence ();
+  emit_label (label);
+  for (unsigned i = 0; i < body.length (); i++)
+    emit_insn (real_pattern (i, false, 0));
+  rtx_insn *lj = emit_jump_insn (gen_i860_bla_loop (count, label, step));
+  JUMP_LABEL (lj) = label;
+  LABEL_NUSES (label)++;
+  seq = get_insns ();
+  end_sequence ();
+  basic_block kernel = new_block (seq, setup, scalar, loop->count);
+  e = make_edge (setup, kernel, EDGE_FALLTHRU);
+  e->probability = profile_probability::always ();
+  e = make_edge (kernel, kernel, 0);
+  e->probability = find_edge (loop, loop)->probability;
+
+  start_sequence ();
+  for (int run = 0; run < depth; run++)
+    emit_run (true, run);
+  rtx_insn *ej = emit_jump_insn (gen_jump (exit_label));
+  JUMP_LABEL (ej) = exit_label;
+  LABEL_NUSES (exit_label)++;
+  emit_barrier ();
+  seq = get_insns ();
+  end_sequence ();
+  basic_block drain = new_block (seq, kernel, scalar, cnt);
+  e = make_edge (kernel, drain, EDGE_FALLTHRU);
+  e->probability = find_edge (loop, loop)->probability.invert ();
+  e = make_edge (drain, exit_bb, 0);
+  e->probability = profile_probability::always ();
+}
+
+/* The tests, then the ways through the loop.  With BIG, this variant with pipelined loads is for
+   what does not fit the data cache: pfld does not replace its lines.  */
+
+void
+pipe_loop::transform (pipe_loop *big)
+{
+  pipe_loop *t = big ? big : this;
+  edge se = split_block (pre, PREV_INSN (prime));
+  basic_block scalar = se->dest;
+  basic_block last = pre;
+  profile_count cnt = pre->count;
+  profile_probability likely = profile_probability::likely ();
+
+  scalar_label = block_label (scalar);
+  t->scalar_label = scalar_label;
+
+  start_sequence ();
+  branch_to_scalar (LE, count, GEN_INT (MAX (depth, t->depth)));
+  rtx_insn *seq = get_insns ();
+  end_sequence ();
+  rtx_insn *j = emit_insn_after_noloc (seq, BB_END (pre), pre);
+  gcc_assert (JUMP_P (j));
+  se->flags &= ~EDGE_FALLTHRU;
+  se->probability = likely.invert ();
+
+  /* every test: if the bases are closer than a reordering can matter, the scalar loop */
+  for (unsigned n = 0; n < t->tests.length (); n++)
+    {
+      const pipe_stream &a = t->streams[t->tests[n].first], &b = t->streams[t->tests[n].second];
+      HOST_WIDE_INT margin = t->test_margin (a, b);
+      rtx tmp = gen_rtx_REG (SImode, t->tmp_reg);
+
+      start_sequence ();
+      emit_insn (gen_rtx_SET (tmp, gen_rtx_MINUS (SImode, gen_rtx_REG (SImode, a.reg),
+						  gen_rtx_REG (SImode, b.reg))));
+      emit_insn (gen_rtx_SET (tmp, plus_constant (SImode, tmp, margin)));
+      branch_to_scalar (LTU, tmp, GEN_INT (2 * margin));
+      seq = get_insns ();
+      end_sequence ();
+      basic_block bb = new_block (seq, last, scalar, cnt);
+      edge e = make_edge (last, bb, EDGE_FALLTHRU);
+      e->probability = likely;
+      e = make_edge (bb, scalar, 0);
+      e->probability = likely.invert ();
+      last = bb;
+    }
+
+  if (!big)
+    {
+      emit_path (last, EDGE_FALLTHRU, NULL_RTX, scalar);
+      return;
+    }
+
+  /* the bytes all loads of the loop read */
+  HOST_WIDE_INT bytes = 0;
+  for (unsigned n = 0; n < big->body.length (); n++)
+    if (big->body[n].kind == PIPE_LOAD)
+      bytes += abs_hwi (big->streams[big->body[n].stream].stride);
+  HOST_WIDE_INT limit = bytes ? (i860_pfld_min_bytes + bytes - 1) / bytes : 0;
+
+  rtx small = gen_label_rtx ();
+  start_sequence ();
+  rtx ref = gen_rtx_LABEL_REF (Pmode, small);
+  rtx_insn *sj = emit_jump_insn (gen_rtx_SET (pc_rtx,
+					      gen_rtx_IF_THEN_ELSE (VOIDmode,
+								    gen_rtx_fmt_ee (LT, VOIDmode, count,
+										    GEN_INT (limit)),
+								    ref, pc_rtx)));
+  JUMP_LABEL (sj) = small;
+  seq = get_insns ();
+  end_sequence ();
+  basic_block choose = new_block (seq, last, scalar, cnt);
+  edge e = make_edge (last, choose, EDGE_FALLTHRU);
+  e->probability = likely;
+
+  big->emit_path (choose, EDGE_FALLTHRU, NULL_RTX, scalar);
+  emit_path (choose, 0, small, scalar);
+}
+
+} // anon namespace
+
+/* The insn made by dual_kernel.  */
+
+const char *
+i860_output_dual_kernel (rtx par)
+{
+  /* The D bit acts one instruction later: dual mode starts after the entry pair and ends one pair
+     after the first without it, as in the code of the SVR4 libm.  */
+  fputs ("\t.balignl 8,0xa0000000\n\td.fnop\n\tnop\n1:\n", asm_out_file);
+  for (int i = 1; i < XVECLEN (par, 0); i++)
+    {
+      rtx x = XVECEXP (par, 0, i);
+      rtx ops[3];
+      char t[64];
+
+      if (GET_CODE (x) == USE)
+	{
+	  output_asm_insn (i & 1 ? "d.fnop" : "nop", ops);
+	  continue;
+	}
+      rtx dst = SET_DEST (x), src = SET_SRC (x);
+      ops[0] = dst;
+      if (MEM_P (dst))
+	{
+	  ops[1] = src;
+	  output_asm_insn (GET_MODE (dst) == DFmode ? "fst.d %1,%0" : "fst.l %1,%0", ops);
+	}
+      else if (MEM_P (src))
+	{
+	  ops[1] = src;
+	  output_asm_insn (GET_MODE (src) == DFmode ? "fld.d %1,%0" : "fld.l %1,%0", ops);
+	}
+      else if (GET_CODE (src) == UNSPEC_VOLATILE && XINT (src, 1) == UNSPECV_PFLD)
+	{
+	  ops[1] = XVECEXP (src, 0, 0);
+	  output_asm_insn (GET_MODE (dst) == DFmode ? "pfld.d %1,%0" : "pfld.l %1,%0", ops);
+	}
+      else if (GET_CODE (src) == UNSPEC_VOLATILE && XINT (src, 1) == UNSPECV_DUAL_BLA)
+	{
+	  ops[1] = XVECEXP (src, 0, 1);
+	  output_asm_insn ("bla %1,%0,1b", ops);
+	}
+      else if (GP_REGNO_P (REGNO (dst)))
+	{
+	  ops[1] = XEXP (src, 1);
+	  output_asm_insn ("addu %1,%0,%0", ops);
+	}
+      else
+	{
+	  const char *sfx = GET_MODE (dst) == DFmode ? "dd" : "ss";
+	  const char *name;
+
+	  if (GET_CODE (src) == UNSPEC_VOLATILE)
+	    {
+	      name = (XINT (src, 1) == UNSPECV_PFADD ? "pfadd"
+		      : XINT (src, 1) == UNSPECV_PFSUB ? "pfsub" : "pfmul");
+	      ops[1] = XVECEXP (src, 0, 0);
+	      ops[2] = XVECEXP (src, 0, 1);
+	    }
+	  else
+	    {
+	      name = (GET_CODE (src) == PLUS ? "fadd"
+		      : GET_CODE (src) == MINUS ? "fsub" : "fmul");
+	      ops[1] = XEXP (src, 0);
+	      ops[2] = XEXP (src, 1);
+	    }
+	  snprintf (t, sizeof t, "d.%s.%s %%1,%%2,%%0", name, sfx);
+	  output_asm_insn (t, ops);
+	}
+    }
+  fputs ("\tfnop\n\tnop\n\tfnop\n\tnop\n", asm_out_file);
+  return "";
+}
+
+namespace {
+
+const pass_data pass_data_i860_pipeline =
+{
+  RTL_PASS,
+  "i860_pipeline",
+  OPTGROUP_NONE,
+  TV_MACH_DEP,
+  0, 0, 0, 0,
+  TODO_df_finish,
+};
+
+class pass_i860_pipeline : public rtl_opt_pass
+{
+public:
+  pass_i860_pipeline (gcc::context *ctxt)
+    : rtl_opt_pass (pass_data_i860_pipeline, ctxt)
+  {}
+
+  bool gate (function *) final override
+  {
+    return ((i860_pipelined_fp > 0 || (i860_pipelined_fp < 0 && optimize >= 3))
+	    && optimize >= 2 && !optimize_size);
+  }
+
+  unsigned int execute (function *) final override;
+};
+
+unsigned int
+pass_i860_pipeline::execute (function *fun)
+{
+  auto_vec<basic_block> loops;
+  basic_block bb;
+
+  df_analyze ();
+  FOR_EACH_BB_FN (bb, fun)
+    if (JUMP_P (BB_END (bb)) && recog_memoized (BB_END (bb)) == CODE_FOR_i860_bla_loop)
+      loops.safe_push (bb);
+
+  /* the analysis needs the liveness of the unchanged function */
+  bool changed = false;
+  for (unsigned i = 0; i < loops.length (); i++)
+    {
+      pipe_loop l (loops[i], false);
+      pipe_loop big (loops[i], true);
+      bool pfld = i860_pfld > 0 || (i860_pfld < 0 && optimize >= 3);
+
+      if (changed)
+	df_analyze ();
+      if (!l.analyze ())
+	{
+	  if (dump_file)
+	    fprintf (dump_file, "loop in bb %d stays scalar\n", loops[i]->index);
+	  continue;
+	}
+      if (dump_file)
+	fprintf (dump_file, "loop in bb %d pipelined, %d stages\n", loops[i]->index, l.depth);
+      l.transform (pfld && big.analyze () ? &big : NULL);
+      changed = true;
+    }
+  return 0;
+}
+
+} // anon namespace
+
+rtl_opt_pass *
+make_pass_i860_pipeline (gcc::context *ctxt)
+{
+  return new pass_i860_pipeline (ctxt);
+}
