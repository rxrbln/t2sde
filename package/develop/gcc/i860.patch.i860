 #This file is part of GCC.
 
@@ -946,6 +947,13 @@ x86_64-*-mingw*)
 		extra_parts="$extra_parts vtv_start.o vtv_end.o vtv_start_preinit.o vtv_end_preinit.o"
 	fi
 	;;
+i860-*-linux*)
+	tmake_file="$tmake_file i860/t-i860"
+	;;
+i860-*-sysv4*)
+	tmake_file="$tmake_file i860/t-i860"
+	extra_parts="$extra_parts crtbegin.o crtend.o"
+	;;
 ia64*-*-elf*)
 	extra_parts="$extra_parts crtbeginS.o crtendS.o crtfastmath.o"
 	tmake_file="ia64/t-ia64 ia64/t-ia64-elf ia64/t-eh-ia64 t-crtfm t-softfp-tf ia64/t-softfp t-softfp ia64/t-softfp-compat"
diff --git a/libgcc/config/i860/fdiv-special.c b/libgcc/config/i860/fdiv-special.c
new file mode 100644
index 00000000000..7c2b64a04d4
--- /dev/null
+++ b/libgcc/config/i860/fdiv-special.c
@@ -0,0 +1,54 @@
+/* IEEE results of a division where the Newton-Raphson sequence gave a NaN:
+   a NaN operand, a zero or infinite divisor, or a reciprocal that overflowed.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   Copyright (C) 2026 René Rebe <rene@exactco.de>
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+Under Section 7 of GPL version 3, you are granted additional
+permissions described in the GCC Runtime Library Exception, version
+3.1, as published by the Free Software Foundation.
+
+You should have received a copy of the GNU General Public License and
+a copy of the GCC Runtime Library Exception along with this program;
+see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
+<http://www.gnu.org/licenses/>.  */
+
+extern double __i860_fdiv_special (double, double);
+extern float __i860_fdivs_special (float, float);
+
+#define BIG 18446744073709551616.0	/* 2^64 */
+
+double
+__i860_fdiv_special (double x, double y)
+{
+  double inf = __builtin_inf ();
+  double sign = __builtin_copysign (1.0, x) * __builtin_copysign (1.0, y);
+
+  if (x != x)
+    return x;
+  if (y != y)
+    return y;
+  if (y == 0)
+    return x == 0 ? __builtin_nan ("") : __builtin_copysign (inf, sign);
+  if (__builtin_isinf (y))
+    return __builtin_isinf (x) ? __builtin_nan ("") : __builtin_copysign (0.0, sign);
+  /* The divisor is so small that its reciprocal is out of range.  */
+  return (x / (y * BIG)) * BIG;
+}
+
+float
+__i860_fdivs_special (float x, float y)
+{
+  return (float) __i860_fdiv_special (x, y);
+}
diff --git a/libgcc/config/i860/libgcc-i860.ver b/libgcc/config/i860/libgcc-i860.ver
new file mode 100644
index 00000000000..c5ebf98de0d
--- /dev/null
+++ b/libgcc/config/i860/libgcc-i860.ver
@@ -0,0 +1,24 @@
+# Copyright (C) 2026 Free Software Foundation, Inc.
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+#
+# This file is part of GCC.
+#
+# GCC is free software; you can redistribute it and/or modify it under
