+#ifndef GCC_I860_PROTOS_H
+#define GCC_I860_PROTOS_H
+
+extern HOST_WIDE_INT i860_initial_elimination_offset (int, int);
+extern void i860_expand_prologue (void);
+extern void i860_expand_epilogue (bool);
+extern rtx i860_sibcall_mem (rtx);
