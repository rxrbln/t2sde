diff --git a/gcc/config/i860/linux.h b/gcc/config/i860/linux.h
new file mode 100644
index 00000000000..371d5107c9a
--- /dev/null
+++ b/gcc/config/i860/linux.h
@@ -0,0 +1,67 @@
+/* Definitions for Intel i860 running GNU/Linux.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   Copyright (C) 2026 René Rebe <rene@exactco.de>
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 3, or (at your option)
+any later version.
+
+GCC is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_I860_LINUX_H
+#define GCC_I860_LINUX_H
+
+#define TARGET_OS_CPP_BUILTINS() GNU_USER_TARGET_OS_CPP_BUILTINS ()
+
+/* Linux ABI: 64-bit integers in integer register pairs, and r30 is the
+   thread pointer (never allocated, set by the C library and clone).  */
+#define I860_DIMODE_ARGS_IN_GPRS 1
+#define I860_THREAD_POINTER_REGNUM 30
+#define I860_PIC_SUPPORTED 1
+
+/* The caches are only reachable through dirbase, so this takes the kernel's
+   cacheflush syscall.  It flushes everything, the range is only checked.  */
+#define I860_NR_CACHEFLUSH 244
+#define CLEAR_INSN_CACHE(BEG, END)					\
+  do									\
+    {									\
+      register long r28_ __asm__ ("r28") = I860_NR_CACHEFLUSH;		\
+      register long r16_ __asm__ ("r16") = (long) (BEG);		\
+      register long r17_ __asm__ ("r17") = (long) (END) - (long) (BEG);	\
+      register long r18_ __asm__ ("r18") = 0;				\
+      __asm__ __volatile__ ("trap %%r0,%%r0,%%r0"			\
+			    : "+r" (r28_), "+r" (r16_)			\
+			    : "r" (r17_), "r" (r18_)			\
+			    : "memory");				\
+    }									\
+  while (0)
+
+#define GLIBC_DYNAMIC_LINKER "/lib/ld-linux-i860.so.1"
+#undef MUSL_DYNAMIC_LINKER
+#define MUSL_DYNAMIC_LINKER "/lib/ld-musl-i860.so.1"
+
+#undef CPP_SPEC
+#define CPP_SPEC "%{posix:-D_POSIX_SOURCE} %{pthread:-D_REENTRANT}"
+
+#undef LINK_SPEC
+#define LINK_SPEC							\
+  "%{shared:-shared} "							\
+  "%{!shared:%{!static:%{!static-pie:"					\
+  "%{rdynamic:-export-dynamic} "					\
+  "-dynamic-linker " GNU_USER_DYNAMIC_LINKER "}}} "			\
+  "%{static:-static} %{static-pie:-static -pie --no-dynamic-linker}"
+
+#endif /* GCC_I860_LINUX_H */
+
+/* Nothing on Linux reads it, and the word before an entry point is never a delayed branch.  */
+#define I860_SVR4_FUNCTION_PREFIX 0
diff --git a/gcc/config/i860/predicates.md b/gcc/config/i860/predicates.md
new file mode 100644
index 00000000000..a944c091c27
--- /dev/null
+++ b/gcc/config/i860/predicates.md
@@ -0,0 +1,94 @@
+;; Predicate definitions for the Intel i860.
+;; Copyright (C) 2026 Free Software Foundation, Inc.
+;; Copyright (C) 2026 René Rebe <rene@exactco.de>
+;;
+;; This file is part of GCC.
+;;
+;; GCC is free software; you can redistribute it and/or modify it
+;; under the terms of the GNU General Public License as published
+;; by the Free Software Foundation; either version 3, or (at your
+;; option) any later version.
+;;
+;; GCC is distributed in the hope that it will be useful, but WITHOUT
+;; ANY WARRANTY; without even the implied warranty of MERCHANTABILITY
+;; or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public
+;; License for more details.
+;;
+;; You should have received a copy of the GNU General Public License
+;; along with GCC; see the file COPYING3.  If not see
+;; <http://www.gnu.org/licenses/>.
+
+(define_predicate "reg_or_0_operand"
+  (ior (match_operand 0 "register_operand")
+       (and (match_code "const_int,const_double")
+	    (match_test "op == CONST0_RTX (mode)"))))
+
+(define_predicate "arith_operand"
+  (ior (match_operand 0 "register_operand")
+       (and (match_code "const_int")
+	    (match_test "satisfies_constraint_I (op)"))))
+
+(define_predicate "logic_operand"
+  (ior (match_operand 0 "register_operand")
+       (and (match_code "const_int")
+	    (match_test "satisfies_constraint_L (op)"))))
+
+;; Anything an and/or/xor pattern can output in at most two insns.
+(define_predicate "logic_or_const_operand"
+  (ior (match_operand 0 "register_operand")
+       (match_code "const_int")))
+
+(define_predicate "shift_operand"
+  (ior (match_operand 0 "register_operand")
+       (and (match_code "const_int")
+	    (match_test "IN_RANGE (INTVAL (op), 0, 31)"))))
+
+(define_predicate "bte_operand"
+  (ior (match_operand 0 "register_operand")
+       (and (match_code "const_int")
+	    (match_test "satisfies_constraint_K (op)"))))
+
+;; A memory reference with a reg+reg address: valid for loads only.
+(define_predicate "indexed_memory_operand"
+  (and (match_code "mem")
+       (match_test "i860_indexed_address_p (XEXP (op, 0), false)")))
+
+;; An access through a GOT offset in the displacement, see *gotoff_load.
+(define_predicate "gotoff_memory_operand"
+  (and (match_code "mem")
+       (match_test "GET_CODE (XEXP (op, 0)) == UNSPEC
+		    && XINT (XEXP (op, 0), 1) == UNSPEC_GOTOFF")))
+
+;; Any operand a load instruction can read.
+(define_predicate "reg_or_load_operand"
+  (ior (match_operand 0 "nonimmediate_operand")
+       (match_operand 0 "indexed_memory_operand")))
+
+(define_predicate "symbol_ref_operand"
+  (match_code "symbol_ref"))
+
+(define_predicate "call_insn_operand"
+  (and (match_code "mem")
+       (match_test "i860_call_address_p (XEXP (op, 0), false)")))
+
+(define_predicate "fp_reg_or_0_operand"
+  (ior (match_operand 0 "register_operand")
+       (and (match_code "const_double")
+	    (match_test "op == CONST0_RTX (mode)"))))
+
+(define_predicate "i860_fp_comparison_operator"
+  (match_code "eq,ne,lt,gt,le,ge,unlt,ungt,unle,unge,uneq,ltgt,
+	       ordered,unordered"))
+
+(define_predicate "i860_eqne_operator"
+  (match_code "eq,ne"))
+
+(define_special_predicate "i860_dual_kernel_operation"
+  (match_code "parallel")
+{
+  rtx first = XVECEXP (op, 0, 0);
+
+  return (GET_CODE (first) == UNSPEC_VOLATILE
+	  && XINT (first, 1) == UNSPECV_DUAL_KERNEL);
+})
+
diff --git a/gcc/config/i860/sysv4.h b/gcc/config/i860/sysv4.h
new file mode 100644
index 00000000000..f25bc09af3b
--- /dev/null
+++ b/gcc/config/i860/sysv4.h
@@ -0,0 +1,65 @@
+/* Target definitions for GCC for Intel 80860 running System V.4
+   Copyright (C) 1991-2005, 2026 Free Software Foundation, Inc.
+   Copyright (C) 2026 René Rebe <rene@exactco.de>
+
+   Written by Ron Guilmette (rfg@netcom.com).
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 3, or (at your option)
+any later version.
+
+GCC is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#define TARGET_OS_CPP_BUILTINS()		\
+  do						\
+    {						\
+      builtin_define_std ("unix");		\
+      builtin_define ("SVR4");			\
+      builtin_define ("__svr4__");		\
+      builtin_assert ("system=unix");		\
+      builtin_assert ("system=svr4");		\
+    }						\
+  while (0)
+
+/* Integer division comes from the native libc (.div, .udiv, ...).  */
+#define I860_SVR4_DIVMOD_NAMES 1
+
+/* Startup files and libraries of the native /usr/ccs/lib.  */
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC							\
+  "%{!shared:%{pg:pcrt1.o%s}%{!pg:%{p:mcrt1.o%s}%{!p:crt1.o%s}}} "	\
+  "%{pg:pcrti.o%s}%{!pg:crti.o%s} "					\
+  "%{ansi:values-Xc.o%s} %{!ansi:values-Xa.o%s} crtbegin.o%s"
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC "crtend.o%s %{pg:pcrtn.o%s}%{!pg:crtn.o%s}"
+
+#undef LIB_SPEC
+#define LIB_SPEC "%{!shared:%{!symbolic:-lc}}"
+
+#undef LINK_SPEC
+#define LINK_SPEC							\
+  "%{h*} %{v:-V} %{b} "							\
+  "%{static:-dn -Bstatic} "						\
+  "%{shared:-G -dy -z text} "						\
+  "%{symbolic:-Bsymbolic -G -dy -z text} "				\
+  "%{G:-G} "								\
+  "%{YP,*} "								\
+  "%{!YP,*:%{p:-Y P,/usr/ccs/lib/libp:/usr/lib/libp:/usr/ccs/lib:/usr/lib} " \
+  "%{!p:-Y P,/usr/ccs/lib:/usr/lib}} "					\
+  "%{Qy:} %{!Qn:-Qy}"
+
+#undef MD_STARTFILE_PREFIX
+#define MD_STARTFILE_PREFIX "/usr/ccs/lib/"
+
+#define I860_SVR4_FUNCTION_PREFIX 1
diff --git a/gcc/config/i860/t-i860 b/gcc/config/i860/t-i860
new file mode 100644
index 00000000000..cf987c5fdb5
--- /dev/null
+++ b/gcc/config/i860/t-i860
@@ -0,0 +1,23 @@
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+#
+# This file is part of GCC.
+#
+# GCC is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation; either version 3, or (at your option)
+# any later version.
+#
+# GCC is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with GCC; see the file COPYING3.  If not see
+# <http://www.gnu.org/licenses/>.
+
+PASSES_EXTRA += $(srcdir)/config/i860/i860-passes.def
+
+i860-pipe.o: $(srcdir)/config/i860/i860-pipe.cc
+	$(COMPILE) $<
+	$(POSTCOMPILE)
diff --git a/gcc/doc/install.texi b/gcc/doc/install.texi
index 2be38423c79..93250acf50e 100644
--- a/gcc/doc/install.texi
+++ b/gcc/doc/install.texi
@@ -4342,6 +4342,25 @@ If you receive Signal 11 errors when building on GNU/Linux, then it is
 possible you have a hardware problem.  Further information on this can be
 found on @uref{https://www.bitwizard.nl/sig11/,,www.bitwizard.nl}.
 
+@html
+<hr />
+@end html
+@anchor{i860-x-linux}
+@heading i860-*-linux
+Intel i860 running GNU/Linux.  Requires GNU binutils 2.30 or older,
+the last release supporting the i860.  Only non-PIC code is generated,
+so configure with @option{--disable-shared}.
+
+@html
+<hr />
+@end html
+@anchor{i860-x-sysv4}
+@heading i860-*-sysv4
+Intel i860 running UNIX System V Release 4, e.g.@: Stardent/Kubota
+UNIX System V/i860.  Integer division uses the native @code{.div},
+@code{.udiv}, @code{.rem} and @code{.urem} helpers of the system C
+library.
+
 @html
 <hr />
 @end html
diff --git a/gcc/doc/invoke.texi b/gcc/doc/invoke.texi
index 60d7163eee3..3d946a66767 100644
--- a/gcc/doc/invoke.texi
+++ b/gcc/doc/invoke.texi
@@ -1134,6 +1134,9 @@ Objective-C and Objective-C++ Dialects}.
 -mschedule=@var{cpu-type}  -msoft-mult  -msio  -mwsio
 -munix=@var{unix-std}  -nolibdld  -static  -threads}
 
+@emph{i860 Options} (@ref{i860 Options})
+@gccoptlist{-mxp  -mxr  -mpipelined-fp  -mdual-fp  -mpfld  -mpfld-min-bytes=@var{n}}
+
 @emph{IA-64 Options} (@ref{IA-64 Options})
 @gccoptlist{-mbig-endian  -mlittle-endian  -mgnu-as  -mgnu-ld  -mno-pic
 -mvolatile-asm-stop  -mregister-names  -msdata
@@ -21416,6 +21419,7 @@ other compilers on the same platform.
 * GNU/Linux Options::
 * H8/300 Options::
 * HPPA Options::
+* i860 Options::
 * IA-64 Options::
 * LM32 Options::
 * LoongArch Options::
@@ -27554,6 +27558,50 @@ under HP-UX@.  This option sets flags for both the preprocessor and
 linker.
 @end table
 
+@node i860 Options
+@subsection Intel 860 Options
+@cindex i860 Options
+
+These @samp{-m} options are defined for the Intel i860 processor
+(@samp{i860-*-linux*} and @samp{i860-*-sysv4*} configurations).
+
+@table @gcctabopt
+@opindex mxp
+@item -mxp
+Generate code for the i860XP and define the macro @code{__i860XP__}.
+
+@opindex mxr
+@item -mxr
+Generate code for the i860XR.  This is the default.
+
+@opindex mpipelined-fp
+@opindex mno-pipelined-fp
+@item -mpipelined-fp
+@itemx -mno-pipelined-fp
+Use the pipelined floating point instructions in counted loops.  This is
+enabled at @option{-O3}, and needs @option{-O2} when given explicitly; it grows
+these loops about threefold.  It does not apply when optimizing for size.  The loops
+keep their scalar form for short iteration counts and for arrays found at
+run time to overlap.
+
+@opindex mdual-fp
+@opindex mno-dual-fp
+@item -mdual-fp
+@itemx -mno-dual-fp
+Run the loops of @option{-mpipelined-fp} in dual-instruction mode where this
+takes fewer pairs than instructions.  Enabled by default.
+
+@opindex mpfld
+@opindex mno-pfld
+@opindex mpfld-min-bytes
+@item -mpfld
+@itemx -mno-pfld
+@itemx -mpfld-min-bytes=@var{n}
+Give the loops of @option{-mpipelined-fp} another form with pipelined loads,
+for iteration counts that read at least @var{n} bytes (default 8192, the size
+of the data cache).  Enabled at @option{-O3}.
+@end table
+
 @node IA-64 Options
 @subsection IA-64 Options
 @cindex IA-64 Options
diff --git a/gcc/testsuite/gcc.c-torture/execute/20101011-1.c b/gcc/testsuite/gcc.c-torture/execute/20101011-1.c
index 9fdfb5265be..47c0efd0a77 100644
--- a/gcc/testsuite/gcc.c-torture/execute/20101011-1.c
+++ b/gcc/testsuite/gcc.c-torture/execute/20101011-1.c
@@ -97,6 +97,9 @@ __aeabi_idiv0 (int return_value)
 #elif defined (__moxie__)
   /* Not all moxie configurations may raise exceptions.  */
 # define DO_TEST 0
+#elif defined (__i860__)
+  /* No divide instruction, and __divsi3 does not trap.  */
+# define DO_TEST 0
 #elif defined (__or1k__)
   /* On OpenRISC division by zero does not trap.  */
 # define DO_TEST 0
