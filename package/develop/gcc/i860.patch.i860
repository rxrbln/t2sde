From: René Rebe <rene@exactco.de>
Subject: [PATCH] i860: restore the backend, port to current GCC, add Linux target

Restores the backend removed from GCC: no cc0, LRA, RTL prologue and epilogue, i860-*-sysv4* and i860-*-linux*. PIC and shared libraries, TLS, IEEE division through libgcc, filled delay slots.

Against upstream commit ada5b8f08739b26bf76558c9d5157cbbdd16c205 (tree-optimization/128322 - amend PR127377 fix).
Branch i860 at 2e6b2767043. Tested in the MAME magicst2 model only, not on real hardware.

Signed-off-by: René Rebe <rene@exactco.de>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gcc/config.gcc                     |   11 +
 gcc/config/i860/constraints.md     |   68 +
 gcc/config/i860/i860-protos.h      |   68 +
 gcc/config/i860/i860.cc            | 1959 ++++++++++++++++++++++++++++
 gcc/config/i860/i860.h             |  278 ++++
 gcc/config/i860/i860.md            | 1122 ++++++++++++++++
 gcc/config/i860/i860.opt           |   28 +
 gcc/config/i860/i860.opt.urls      |    8 +
 gcc/config/i860/linux.h            |   61 +
 gcc/config/i860/predicates.md      |   84 ++
 gcc/config/i860/sysv4.h            |   63 +
 gcc/doc/install.texi               |   19 +
 gcc/doc/invoke.texi                |   21 +
 libgcc/config.host                 |    8 +
 libgcc/config/i860/fdiv-special.c  |   54 +
 libgcc/config/i860/libgcc-i860.ver |   24 +
 libgcc/config/i860/t-i860          |   27 +
 17 files changed, 3903 insertions(+)

diff --git a/gcc/config.gcc b/gcc/config.gcc
index 01750947c4d..9b8b1fa4f6a 100644
--- a/gcc/config.gcc
+++ b/gcc/config.gcc
@@ -289,6 +289,7 @@ esac
 case ${target}${target_min} in
  # Avoid special cases that are not obsolete
    arm*-*-*eabi*			\
+ | i860-*-sysv4*			\
  )
 	;;
    arm*-wince-pe*			\
@@ -436,6 +437,9 @@ ft32*)	cpu_type=ft32
 moxie*)	cpu_type=moxie
 	target_has_targetm_common=no
 	;;
+i860*)	cpu_type=i860
+	target_has_targetm_common=no
+	;;
 fido-*-*)
 	cpu_type=m68k
 	extra_headers=math-68881.h
@@ -2352,6 +2356,13 @@ x86_64-*-fuchsia*)
 	tmake_file="${tmake_file} i386/t-x86_64-elf"
 	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h newlib-stdint.h i386/i386elf.h i386/x86-64.h fuchsia.h"
 	;;
+i860-*-linux*)
+	tm_file="elfos.h ${tm_file} gnu-user.h linux.h glibc-stdint.h i860/linux.h"
+	;;
+i860-*-sysv4*)
+	tm_file="elfos.h newlib-stdint.h ${tm_file} i860/sysv4.h"
+	use_gcc_stdint=wrap
+	;;
 ia64*-*-elf*)
 	tm_file="${tm_file} elfos.h newlib-stdint.h ia64/sysv4.h ia64/elf.h"
 	tmake_file="ia64/t-ia64"
diff --git a/gcc/config/i860/constraints.md b/gcc/config/i860/constraints.md
new file mode 100644
index 00000000000..57bbe51b94c
--- /dev/null
+++ b/gcc/config/i860/constraints.md
@@ -0,0 +1,68 @@
+;; Constraint definitions for the Intel i860.
+;; Copyright (C) 2026 Free Software Foundation, Inc.
+;; Copyright (C) 2026 René Rebe <rene@exactco.de>
+;;
+;; This file is part of GCC.
+;;
+;; GCC is free software; you can redistribute it and/or modify it
+;; under the terms of the GNU General Public License as published
+;; by the Free Software Foundation; either version 3, or (at your
+;; option) any later version.
+;;
+;; GCC is distributed in the hope that it will be useful, but WITHOUT
+;; ANY WARRANTY; without even the implied warranty of MERCHANTABILITY
+;; or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public
+;; License for more details.
+;;
+;; You should have received a copy of the GNU General Public License
+;; along with GCC; see the file COPYING3.  If not see
+;; <http://www.gnu.org/licenses/>.
+
+(define_register_constraint "f" "FP_REGS"
+  "Floating point registers.")
+
+;; Not -0x8000: add/subtract immediates are sometimes negated.
+(define_constraint "I"
+  "A signed 16-bit immediate for add/subtract."
+  (and (match_code "const_int")
+       (match_test "IN_RANGE (ival, -0x7fff, 0x7fff)")))
+
+(define_constraint "J"
+  "Integer zero."
+  (and (match_code "const_int")
+       (match_test "ival == 0")))
+
+(define_constraint "K"
+  "An unsigned 5-bit immediate (bte/btne)."
+  (and (match_code "const_int")
+       (match_test "IN_RANGE (ival, 0, 31)")))
+
+(define_constraint "L"
+  "An unsigned 16-bit immediate for logical instructions."
+  (and (match_code "const_int")
+       (match_test "IN_RANGE (ival, 0, 0xffff)")))
+
+(define_constraint "M"
+  "A constant with the low 16 bits clear (orh/andh/xorh)."
+  (and (match_code "const_int")
+       (match_test "(ival & 0xffff) == 0")))
+
+(define_constraint "G"
+  "Floating point zero."
+  (and (match_code "const_double")
+       (match_test "op == CONST0_RTX (GET_MODE (op))")))
+
+(define_memory_constraint "Q"
+  "A memory reference with a register, register + register or
+   register + offset address (no constant address)."
+  (and (match_code "mem")
+       (match_test "i860_q_address_p (XEXP (op, 0), mode)")))
+
+(define_memory_constraint "Y"
+  "A call target: memory at an integer register or symbol address."
+  (and (match_code "mem")
+       (match_test "i860_call_address_p (XEXP (op, 0), true)")))
+
+(define_constraint "Z"
+  "A symbol as a direct call target, also valid in PIC code."
+  (match_code "symbol_ref"))
