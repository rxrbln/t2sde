+extern rtx i860_eh_return_handler_rtx (void);
+extern void i860_expand_move (machine_mode, rtx *);
+extern void i860_expand_floatsidf (rtx, rtx);
+extern bool i860_indexed_address_p (rtx, bool);
+extern bool i860_q_address_p (rtx, machine_mode);
+extern bool i860_call_address_p (rtx, bool);
+extern bool i860_mem_aligned8_p (rtx);
+extern int i860_mem_move_length (rtx *);
+extern int i860_move_double_length (rtx *);
+extern int i860_logic_length (enum rtx_code, rtx *);
+extern rtx i860_gotoff_mem (rtx, rtx, rtx);
+extern const char *i860_output_gotoff_access (rtx *, bool);
+extern const char *i860_output_load (rtx *);
+extern const char *i860_output_store (rtx *);
+extern const char *i860_output_load_ext (rtx *, const char *);
+extern const char *i860_output_sf_const (rtx *);
+extern const char *i860_output_move_double (rtx *);
+extern const char *i860_output_logic (enum rtx_code, rtx *);
+extern bool i860_cbranch_operand_p (enum rtx_code, rtx);
+extern const char *i860_output_bla (rtx_insn *, rtx *, int);
+extern void i860_expand_fdiv (machine_mode, rtx *);
+extern bool i860_bte_form_p (rtx *);
+extern bool i860_symbolic_p (rtx);
+extern rtx i860_legitimize_pic_address (rtx, rtx);
+extern int i860_cbranch_length (rtx *, bool);
+extern const char *i860_output_cbranch (rtx_insn *, rtx *, bool);
+extern const char *i860_output_bit_cbranch (rtx *, bool);
+extern const char *i860_output_fp_cbranch (rtx *, machine_mode, bool);
+extern bool i860_fp_cbranch_simple_p (rtx *, bool);
+extern bool i860_annul_branch_p (rtx_insn *);
+extern const char *i860_output_call (rtx *, int);
+#endif
+
+#ifdef TREE_CODE
