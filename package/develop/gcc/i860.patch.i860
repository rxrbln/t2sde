+# along with GCC; see the file COPYING3.  If not see
+# <http://www.gnu.org/licenses/>.
+
+# Division calls these, also from shared libraries.
+GCC_4.0.0 {
+  __i860_fdiv_special
+  __i860_fdivs_special
+}
diff --git a/libgcc/config/i860/t-i860 b/libgcc/config/i860/t-i860
new file mode 100644
index 00000000000..b078f037e30
--- /dev/null
+++ b/libgcc/config/i860/t-i860
@@ -0,0 +1,27 @@
+# Copyright (C) 2026 Free Software Foundation, Inc.
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+#
+# This file is part of GCC.
+#
+# GCC is free software; you can redistribute it and/or modify it under
