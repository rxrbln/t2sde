+# <http://www.gnu.org/licenses/>.
+
+# The i860 has no integer divide instruction.
+LIB2ADD += $(srcdir)/divmod.c \
+	   $(srcdir)/udivmod.c \
+	   $(srcdir)/udivmodsi4.c \
+	   $(srcdir)/config/i860/fdiv-special.c
+
+# Division calls these, also from shared libraries.
+SHLIB_MAPFILES += $(srcdir)/config/i860/libgcc-i860.ver
