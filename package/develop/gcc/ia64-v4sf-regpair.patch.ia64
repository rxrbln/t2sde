@@ -1510,9 +1527,9 @@
 	    /* Add 8, subtract 24.  */
 	    base = XEXP (base, 0);
 	    out[0] = adjust_automodify_address
-	      (in, DImode, gen_rtx_POST_INC (Pmode, base), 0);
