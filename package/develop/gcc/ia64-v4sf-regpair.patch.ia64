    May return an insn which is to be emitted after the moves.  */
 
 static rtx
-ia64_split_tmode (rtx out[2], rtx in, bool reversed, bool dead)
+ia64_split_tmode (rtx out[2], rtx in, bool reversed, bool dead,
+		  machine_mode hmode)
 {
   rtx fixup = 0;
 
   switch (GET_CODE (in))
     {
     case REG:
-      out[reversed] = gen_rtx_REG (DImode, REGNO (in));
-      out[!reversed] = gen_rtx_REG (DImode, REGNO (in) + 1);
+      out[reversed] = gen_rtx_REG (hmode, REGNO (in));
+      out[!reversed] = gen_rtx_REG (hmode, REGNO (in) + 1);
+      break;
+
+    case CONST_VECTOR:
+      /* Cannot occur reversed.  */
+      gcc_assert (!reversed);
+      {
+	int n = GET_MODE_NUNITS (GET_MODE (in)) / 2;
+	rtvec lo = rtvec_alloc (n), hi = rtvec_alloc (n);
+	for (int k = 0; k < n; k++)
+	  {
+	    RTVEC_ELT (lo, k) = CONST_VECTOR_ELT (in, k);
+	    RTVEC_ELT (hi, k) = CONST_VECTOR_ELT (in, k + n);
+	  }
+	out[0] = gen_rtx_CONST_VECTOR (hmode, lo);
+	out[1] = gen_rtx_CONST_VECTOR (hmode, hi);
+      }
       break;
 
     case CONST_INT:
@@ -1481,9 +1498,9 @@
