[I] Viewing physical memory as files in a virtual file system

[T] MemProcFS is an easy and convenient way of viewing physical memory as files in a virtual file system.

[U] https://github.com/ufrisk/MemProcFS

[A] ufrisk
[M] andrei32 <andrei32.t2@gmail.com>

[C] extra/tool
[F] CROSS

[L] AGPL
[V] 5.19

[D] 07c4e97e06c91a901a2a3e247e022b01e00614b2de5c526f8da318de MemProcFS-5.19.tar.gz https://github.com/ufrisk/MemProcFS/archive/v5.19/

runmake=0

vmm(){
	cd vmm
	make
	cd ..
	cp -fv files/vmm.so $libdir/libvmm.so
	ldconfig
}
hook_add postmake 5 vmm

memprocfs(){
	cd memprocfs
	make
	cd ..
	cp -fv files/memprocfs $bindir/
}
hook_add postmake 6 memprocfs
