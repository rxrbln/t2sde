@@ -12,7 +12,7 @@
 	#DEBUG FLAGS BELOW
 	#CFLAGS  += -g -O0 -Wextra
 endif
-LDFLAGS += -Wl,-rpath,'$$ORIGIN' -ldl -L. -l:vmm.so -Wl,-z,noexecstack `pkg-config fuse --libs`
+LDFLAGS += -Wl,-rpath,'$$ORIGIN' -ldl -L. -lvmm -Wl,-z,noexecstack `pkg-config fuse --libs`
 DEPS = vfs.h vmmloader.h
