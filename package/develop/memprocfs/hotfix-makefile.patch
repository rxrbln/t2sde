 	  vmmdll_remote.o vmmdll_scatter.o vmm.o vmmex_light.o fc.o              \
@@ -66,10 +66,8 @@
 	$(CC) -c -o $@ $< $(CFLAGS)
 
 vmm: $(OBJ)
