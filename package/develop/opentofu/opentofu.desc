[COPY] --- T2-COPYRIGHT-END ---

[I] Declaratively manage your cloud infrastructure

[T] OpenTofu is a reliable, flexible, community-driven infrastructure as code
[T] tool. It serves as a drop-in replacement for Terraform, preserving your
[T] existing workflows and configurations.

[U] https://opentofu.org/

[A] Opentofu
[M] Daniel Ashkenazi <daniel.ashkenazi@gmail.com>

[C] extra/tool
[F] CROSS
[R] + x86 x86-64 arm arm64 ppc64le mips mips64 mipsel

[L] MPL
[V] 1.13.1

[D] 6e057ac8f8a9ce7261dba0ca3ff58eec08b71b2460fc5ab9cd2c4309 opentofu-1.13.1.tar.gz https://github.com/opentofu/opentofu/archive/v1.13.1/

. $base/package/*/*/go-conf.in

rungo=0 makeinstopt=
var_append goconfopt ' ' "-o bin/$pkg"
var_append makeopt ' ' build

hook_add preconf 5 "go mod edit -require=golang.org/x/net@v0.59.0; export GOMODCACHE=/root/go/pkg/mod; go mod tidy"
hook_add postmake 5 "install -Dvm755 tofu $root$bindir"
pkginstalled bash-completion && hook_add postmake 7 "echo 'complete -C /usr/bin/tofu tofu' > $root/etc/bash_completion.d/tofu"
