--- hivex-1.3.24/images/Makefile.am
+++ hivex-1.3.24/images/Makefile.am
@@ -44,7 +44,7 @@ mkzero_CFLAGS = $(WARN_CFLAGS) $(WERROR_
 mkzero_LDADD = -lntdll
 endif
 
-noinst_DATA = large
+# the large test hive is generated by running the target mklarge
 
 large: mklarge$(EXEEXT)
 	cmp -s $(srcdir)/minimal $(builddir)/minimal || \
--- hivex-1.3.24/images/Makefile.in
+++ hivex-1.3.24/images/Makefile.in
@@ -397,7 +397,7 @@ mklarge_LDADD = ../lib/libhivex.la
 @IS_WINDOWS_TRUE@mkzero_SOURCES = mkzero.c
 @IS_WINDOWS_TRUE@mkzero_CFLAGS = $(WARN_CFLAGS) $(WERROR_CFLAGS)
 @IS_WINDOWS_TRUE@mkzero_LDADD = -lntdll
-noinst_DATA = large
+# the large test hive is generated by running the target mklarge
 CLEANFILES = $(noinst_DATA)
 all: all-am
 
