[I] A Freedesktop Notifications Library

[T] A Freedesktop notifications library.

[U] https://gitlab.gnome.org/GNOME/libnotify

[A] Christian Hammond <chipx86@chipx86.com>
[A] Mike Hearn <mike@navi.cx>
[A] John (J5) Palmieri <johnp@redhat.com>
[M] René Rebe <rene@exactco.de>

[C] extra/development
[F] CROSS

[E] opt libxml

[L] GPL
[V] 0.8.9
[P] X -----5---9 150.100

[D] 0824293f5e4c3cb4b3e8ea7ac2e041c6be7848c8751d1810dadd92c5 libnotify-0.8.9.tar.bz2 https://gitlab.gnome.org/GNOME/libnotify/-/archive/0.8.9/

export GI_SCANNER_DISABLE_CACHE=1
var_append mesonopt ' ' -Dtests=false

pkginstalled gtk-doc gi-docgen docbook-xml docbook-xsl && ! atstage cross || var_append mesonopt ' ' -Dgtk_doc=false
pkginstalled gobject-introspection || var_append mesonopt ' ' -Dintrospection=disabled
pkginstalled libxslt docbook-xml docbook-xsl || var_append mesonopt ' ' -Dman=false
pkginstalled xmlto || var_append mesonopt ' ' -Ddocbook_docs=disabled
