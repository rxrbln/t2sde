[L] LGPL
[V] 25.03

[D] 74b3560c7b90c7a3b07503df551307630cc72a75f6ceeda629a776e5 codeblocks_25.03.tar.xz https://download.sourceforge.net/project/codeblocks/Sources/25.03/

hook_add preconf 5 ./bootstrap

codeblocks_native_autorevision() {
	# build the autorevision.h generator for the build host, after the target tinyxml it would relink with
	$MAKE -C src/base/tinyxml
	pushd src/build_tools/autorevision
	$BUILDCXX -O2 -DTIXML_USE_STL=YES -I../../include -I../../include/tinyxml -c autorevision.cpp
	$BUILDCXX -O2 -DTIXML_USE_STL=YES -I../../include/tinyxml -o auto_revision autorevision.o \
		../../base/tinyxml/tinyxml{,error,parser}.cpp
	popd
}
atstage cross && hook_add premake 5 codeblocks_native_autorevision
