[I] Header-only math functions of LLVM libc

[T] The header-only, correctly rounded math functions of the LLVM C library,
[T] used by ladybird.

[U] https://libc.llvm.org/

[A] LLVM Developers
[M] The T2 Project <t2@t2-project.org>

[C] extra/development
[F] CROSS

[L] APL
[V] e541694
[P] X -----5---9 150.300

[D] 34405bb9a313ca1687c607cff45ab9a453c294c0d0e6c5265f76ab70 llvm-libc-e541694.tar.gz https://github.com/llvm/llvm-project/archive/e54169423e7ee5d8b41c2f1b6f7a59000c901ee0/

runmake=0 runcmake=0 rungpepinstall=0 runpysetup=0

# only the headers the math functions include, at their paths below libc/
llvm_libc_install() {
	local d
	for d in hdr include shared src/__support src/string/memory_utils; do
		(cd libc; find $d -name '*.h' -exec install -Dm644 {} $root$includedir/llvm-libc/{} \;)
	done
}
hook_add postmake 5 llvm_libc_install
