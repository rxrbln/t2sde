--- boomerang-0.5.2/cmake-scripts/FindCapstone.cmake
+++ boomerang-0.5.2/cmake-scripts/FindCapstone.cmake
@@ -60,7 +60,7 @@ find_program(Capstone_CSTOOL
 )
 
 
