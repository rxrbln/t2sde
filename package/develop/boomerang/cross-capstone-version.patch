     execute_process(COMMAND ${Capstone_CSTOOL} -v
         OUTPUT_VARIABLE CSTOOL_OUTPUT
     )
@@ -71,7 +71,14 @@ if (Capstone_CSTOOL)
         set(Capstone_VERSION_MINOR "${CMAKE_MATCH_2}")
