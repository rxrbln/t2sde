+/*
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/* The kernel table has no time32 ABI. */
+#define HAVE_ARCH_TIME32_SYSCALLS 0
+
+/* __WORDSIZE of musl is only in <sys/reg.h> and <sys/user.h>. */
+#define PERSONALITY_DESIGNATORS { "32" }
+#define PERSONALITY_NAMES { "32 bit" }
+
+#define PERSONALITY0_AUDIT_ARCH { AUDIT_ARCH_I860, 0 }
diff --git a/src/linux/i860/arch_prstatus_regset.c b/src/linux/i860/arch_prstatus_regset.c
new file mode 100644
index 000000000..236468435
--- /dev/null
+++ b/src/linux/i860/arch_prstatus_regset.c
@@ -0,0 +1,52 @@
+/*
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+static void
+arch_decode_prstatus_regset(struct tcb *const tcp,
+			    const kernel_ulong_t addr,
+			    const kernel_ulong_t size)
+{
+	struct_prstatus_regset regs;
+	const size_t fetch_size = MIN(sizeof(regs), size);
+
+	if (!size || size & 3) {
+		printaddr(addr);
+	} else if (!umoven_or_printaddr(tcp, addr, fetch_size, &regs)) {
+		tprint_struct_begin();
+		PRINT_FIELD_ARRAY_UPTO(regs, gpr, fetch_size / 4, tcp,
+				       print_xint_array_member);
+		const size_t offset_of_fpr =
+			offsetof(struct_prstatus_regset, fpr);
+		if (fetch_size > offset_of_fpr) {
+			tprint_struct_next();
+			PRINT_FIELD_ARRAY_UPTO(regs, fpr,
+					       (fetch_size - offset_of_fpr) / 4,
+					       tcp, print_xint_array_member);
+		}
+		if (fetch_size > offsetof(struct_prstatus_regset, psr)) {
+			tprint_struct_next();
+			PRINT_FIELD_X(regs, psr);
+		}
+		if (fetch_size > offsetof(struct_prstatus_regset, epsr)) {
+			tprint_struct_next();
+			PRINT_FIELD_X(regs, epsr);
+		}
+		if (fetch_size > offsetof(struct_prstatus_regset, fir)) {
+			tprint_struct_next();
+			PRINT_FIELD_X(regs, fir);
+		}
+		if (fetch_size > offsetof(struct_prstatus_regset, fsr)) {
+			tprint_struct_next();
+			PRINT_FIELD_X(regs, fsr);
+		}
+		if (size > sizeof(regs)) {
+			tprint_struct_next();
+			tprint_more_data_follows();
+		}
+		tprint_struct_end();
+	}
+}
