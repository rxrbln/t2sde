diff --git a/tests/ptrace.c b/tests/ptrace.c
index aee56d16c..c86c08418 100644
--- a/tests/ptrace.c
+++ b/tests/ptrace.c
@@ -263,7 +263,7 @@ typedef struct {
 } sparc32_regs;
 #  define TRACEE_REGS_STRUCT sparc32_regs
 # endif
-#elif defined __riscv
+#elif defined __riscv || defined __i860__
 # define TRACEE_REGS_STRUCT struct user_regs_struct
 #elif defined __mips__
 typedef struct {
@@ -702,6 +702,45 @@ print_prstatus_regset(const void *const rs, const size_t size)
 	}
 #  endif
 
+# elif defined __i860__
+
+	const size_t ngpr = MIN(size, sizeof(regs->gpr)) / sizeof(regs->gpr[0]);
+	fputs("gpr=[", stdout);
+	for (size_t i = 0; i < ngpr; ++i) {
+		if (i)
+			fputs(", ", stdout);
+		PRINT_VAL_X(regs->gpr[i]);
+	}
+	fputs("]", stdout);
+	if (size > offsetof(TRACEE_REGS_STRUCT, fpr)) {
+		const size_t nfpr =
+			MIN(size - offsetof(TRACEE_REGS_STRUCT, fpr),
+			    sizeof(regs->fpr)) / sizeof(regs->fpr[0]);
+		fputs(", fpr=[", stdout);
+		for (size_t i = 0; i < nfpr; ++i) {
+			if (i)
+				fputs(", ", stdout);
+			PRINT_VAL_X(regs->fpr[i]);
+		}
+		fputs("]", stdout);
+	}
+	if (size >= offsetofend(TRACEE_REGS_STRUCT, psr)) {
+		fputs(", ", stdout);
+		PRINT_FIELD_X(*regs, psr);
+	}
+	if (size >= offsetofend(TRACEE_REGS_STRUCT, epsr)) {
+		fputs(", ", stdout);
+		PRINT_FIELD_X(*regs, epsr);
+	}
+	if (size >= offsetofend(TRACEE_REGS_STRUCT, fir)) {
+		fputs(", ", stdout);
+		PRINT_FIELD_X(*regs, fir);
+	}
+	if (size >= offsetofend(TRACEE_REGS_STRUCT, fsr)) {
+		fputs(", ", stdout);
+		PRINT_FIELD_X(*regs, fsr);
+	}
+
 # elif defined __riscv
 
 	PRINT_FIELD_X(*regs, pc);
