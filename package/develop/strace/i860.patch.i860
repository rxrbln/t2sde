+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+static struct user_regs_struct i860_regs;
+#define ARCH_REGS_FOR_GETREGSET i860_regs
+#define ARCH_PC_REG i860_regs.fir
+#define ARCH_SP_REG i860_regs.gpr[2]
diff --git a/src/linux/i860/get_error.c b/src/linux/i860/get_error.c
new file mode 100644
index 000000000..e4fd2240b
--- /dev/null
+++ b/src/linux/i860/get_error.c
@@ -0,0 +1,19 @@
+/*
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "negated_errno.h"
+
+static void
+arch_get_error(struct tcb *tcp, const bool check_errno)
+{
+	if (check_errno && is_negated_errno(i860_regs.gpr[16])) {
+		tcp->u_rval = -1;
+		tcp->u_error = -i860_regs.gpr[16];
+	} else {
+		tcp->u_rval = i860_regs.gpr[16];
+	}
+}
diff --git a/src/linux/i860/get_scno.c b/src/linux/i860/get_scno.c
new file mode 100644
index 000000000..324ab36cc
--- /dev/null
+++ b/src/linux/i860/get_scno.c
@@ -0,0 +1,14 @@
+/*
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/* Return codes: 1 - ok, 0 - ignore, other - error. */
+static int
+arch_get_scno(struct tcb *tcp)
+{
+	tcp->scno = i860_regs.gpr[28];
+	return 1;
+}
diff --git a/src/linux/i860/get_syscall_args.c b/src/linux/i860/get_syscall_args.c
new file mode 100644
index 000000000..9a7837ef5
--- /dev/null
+++ b/src/linux/i860/get_syscall_args.c
@@ -0,0 +1,14 @@
+/*
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+static int
+arch_get_syscall_args(struct tcb *tcp)
+{
+	for (unsigned int i = 0; i < 6; i++)
+		tcp->u_arg[i] = i860_regs.gpr[16 + i];
+	return 1;
+}
