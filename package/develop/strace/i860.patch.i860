diff --git a/src/linux/i860/raw_syscall.h b/src/linux/i860/raw_syscall.h
new file mode 100644
index 000000000..7919449f2
--- /dev/null
+++ b/src/linux/i860/raw_syscall.h
@@ -0,0 +1,29 @@
+/*
+ * Raw syscalls.
+ *
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#ifndef STRACE_RAW_SYSCALL_H
+# define STRACE_RAW_SYSCALL_H
+
+# include "kernel_types.h"
+
+static inline kernel_ulong_t
+raw_syscall_0(const kernel_ulong_t nr, kernel_ulong_t *err)
+{
+	*err = 0;
+	register kernel_ulong_t r28 __asm__("r28") = nr;
+	register kernel_ulong_t r16 __asm__("r16");
+	__asm__ __volatile__("trap %%r0,%%r0,%%r0"
+			     : "=r"(r16), "+r"(r28)
+			     :
+			     : "memory");
+	return r16;
+}
+# define raw_syscall_0 raw_syscall_0
+
+#endif /* !STRACE_RAW_SYSCALL_H */
diff --git a/src/linux/i860/set_error.c b/src/linux/i860/set_error.c
new file mode 100644
index 000000000..27c6df585
--- /dev/null
+++ b/src/linux/i860/set_error.c
@@ -0,0 +1,20 @@
+/*
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+static int
+arch_set_error(struct tcb *tcp)
+{
+	i860_regs.gpr[16] = -tcp->u_error;
+	return set_regs(tcp->pid);
+}
+
+static int
+arch_set_success(struct tcb *tcp)
+{
+	i860_regs.gpr[16] = tcp->u_rval;
+	return set_regs(tcp->pid);
+}
diff --git a/src/linux/i860/set_scno.c b/src/linux/i860/set_scno.c
new file mode 100644
index 000000000..a94b6bf55
--- /dev/null
+++ b/src/linux/i860/set_scno.c
@@ -0,0 +1,15 @@
+/*
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+static int
+arch_set_scno(struct tcb *tcp, kernel_ulong_t scno)
+{
+	if (ptrace_syscall_info_is_valid() && get_regs(tcp) < 0)
+		return -1;
+	i860_regs.gpr[28] = scno;
+	return set_regs(tcp->pid);
+}
