[I] Physical Memory Acquisition Library & The LeechAgent Remote Memory Acquisition Agent

[T] LeechCore - Physical Memory Acquisition Library & The LeechAgent Remote Memory Acquisition Agent

[U] https://github.com/ufrisk/LeechCore

[A] ufrisk
[M] andrei32 <andrei32.t2@gmail.com>

[C] extra/tool
[F] CROSS

[L] GPL
[V] 2.23

[D] 9efe436f365bd8ac0bf680f7ae7428afac91b44e2cc59501c1f9279d LeechCore-2.23.tar.gz https://github.com/ufrisk/LeechCore/archive/v2.23/

runmake=0

leechcore(){
	cd leechcore
	make
	cd ..
	cp -fv files/leechcore.so $libdir/libleechcore.so
	ldconfig
}
hook_add postmake 5 leechcore

leechagent(){
	cd leechagent_linux
	make
	cd ..
	cp -fv files/leechagent $bindir/
}
hook_add postmake 6 leechagent

leechcorepyc(){
	cd leechcorepyc
	make
	cd ..
	cp -fv files/leechcorepyc.so $libdir/libleechcorepyc.so
	ldconfig
}
hook_add postmake 7 leechcorepyc
