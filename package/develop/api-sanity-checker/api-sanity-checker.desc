[D] d0ec9dc6ae84e37c04896738069275768eff42f20fc8db8840bd8e37 api-sanity-checker-1.98.7.tar.gz https://github.com/lvc/api-sanity-checker/archive/1.98.7/

acc_wrapper() {
	mkdir -p $builddir/bin
	echo "exec perl $root$bindir/abi-compliance-checker \"\$@\"" > $builddir/bin/abi-compliance-checker
	chmod +x $builddir/bin/abi-compliance-checker
	export PATH="$PATH:$builddir/bin" DESTDIR="$root"
}
atstage cross && hook_add premake 5 acc_wrapper
