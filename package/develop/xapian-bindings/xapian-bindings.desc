[I] Information retrieval library

[T] Xapian is a Probabilistic Information Retrieval library. It is
[T] written in C++ with bindings to Perl, Python, PHP, Java, Tcl, and
[T] C#. It is an adaptable toolkit that allows developers to add advanced
[T] indexing and search facilities to their own applications.

[U] https://www.xapian.org/

[A] Olly Betts <olly@survex.com>
[M] René Rebe <rene@exactco.de>

[C] extra/tool
[F] CROSS

[E] opt luajit
[E] opt openjdk
[E] opt mono
[E] opt perl
[E] opt ruby
[E] opt tcl

[L] GPL
[V] 2.1.0

[D] 8390cd7b1864df5ead953261bd7df20fbb192c38e14c6a0a69a7aaad xapian-bindings-2.1.0.tar.xz https://oligarchy.co.uk/xapian/2.1.0/

var_remove confopt ' ' '--disable-debug' # unsupported

if atstage cross; then
	# the toolchain ruby carries the build host RbConfig
	var_append confopt ' ' --without-ruby
	var_append confopt ' ' XAPIAN_CONFIG=$root$bindir/xapian-config
	# install the bindings into the target, not the toolchain interpreters
	xapian_cross_dirs() {
		local tc=$root/TOOLCHAIN/cross x
		x=$(perl -MConfig -e 'print $Config{installsitearch}'); export PERL_ARCH=${x#$tc}
		x=$(perl -MConfig -e 'print $Config{installsitelib}'); export PERL_LIB=${x#$tc}
		export TCL_LIB=$libdir TCL_INC=$root$includedir
	}
	hook_add preconf 5 xapian_cross_dirs
fi
