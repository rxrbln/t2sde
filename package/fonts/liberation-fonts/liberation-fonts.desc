[D] 5125cdc588bce74a971caf84f11fedb31754d9d98e87ceda64bc4092 liberation-fonts-ttf-2.1.5-release.tar.gz !https://github.com/liberationfonts/liberation-fonts/files/7261482/liberation-fonts-ttf-2.1.5.tar.gz

runmake=0

ttf_inst() {
	mkdir -p $root$datadir/fonts
	cp -v *.ttf $root$datadir/fonts/
}
hook_add postmake 5 ttf_inst
