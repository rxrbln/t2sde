[I] RPM Package Manager

[T] RPM is the RPM Package Manager. T2 SDE is _not_ based on RPM packages.
[T] The program is only here for compatibility reasons.

[A] Erik Troan <ewt@redhat.com>
[A] Marc Ewing <marc@redhat.com>
[M] René Rebe <rene@exactco.de>

[C] base/tool
[F] FPIC CROSS
[E] opt doxygen
[E] opt graphviz

[L] GPL
[V] 6.1.0

[D] 1ceee388000149d248f73cdf93229d9eac90ac0be692b22f51387bdd rpm-6.1.0.tar.bz2 https://ftp.osuosl.org/pub/rpm/releases/rpm-6.1.x/

pkginstalled python || var_append cmakeopt ' ' -DENABLE_PYTHON=OFF
pkginstalled libselinux || var_append cmakeopt ' ' -DWITH_SELINUX=OFF
pkginstalled rpm-sequoia || var_append cmakeopt ' ' -DWITH_SEQUOIA=OFF
pkginstalled audit || var_append cmakeopt ' ' -DWITH_AUDIT=OFF
pkginstalled acl || var_append cmakeopt ' ' -DWITH_ACL=OFF
pkginstalled libcap || var_append cmakeopt ' ' -DWITH_CAP=OFF

[ "$SDECFG_DEFAULT_CC" = clang ] && var_append GCC_WRAPPER_REMOVE ' ' -fhardened
