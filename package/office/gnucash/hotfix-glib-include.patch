Include glib.h from the pkg-config include path, glib-2.0/glib.h only works
with glib below /usr/include.

diff -urp a/libgnucash/core-utils/gnc-unicode.cpp b/libgnucash/core-utils/gnc-unicode.cpp
--- a/libgnucash/core-utils/gnc-unicode.cpp	2026-07-16 20:13:43.000000000 +0000
+++ b/libgnucash/core-utils/gnc-unicode.cpp	2026-11-24 23:26:56.300004967 +0000
@@ -28,7 +28,7 @@
 #include <unicode/tblcoll.h>
 #include <unicode/coll.h>
 #include "gnc-locale-utils.h"
-#include <glib-2.0/glib.h>
+#include <glib.h>
 
 constexpr const char *logdomain{"gnc.locale"};
 
