Use the host target of the system rustc, Chromium hardcodes the
*-unknown-linux-* vendor for the Rust std rlibs.

--- qtwebengine-everywhere-src-6.140.0.orig/cmake/QtToolchainHelpers.cmake
+++ qtwebengine-everywhere-src-6.140.0/cmake/QtToolchainHelpers.cmake
@@ -289,6 +289,12 @@ macro(append_build_type_setup)
       get_filename_component(rustBasePath ${rustBasePath} DIRECTORY)
       list(APPEND gnArgArg rust_sysroot_absolute="${rustBasePath}")
       list(APPEND gnArgArg rustc_version="${QWERust_VERSION}")
+      if(NOT CMAKE_CROSSCOMPILING)
+          execute_process(COMMAND ${QWERustc_EXECUTABLE} -vV
+              OUTPUT_VARIABLE rustcInfo OUTPUT_STRIP_TRAILING_WHITESPACE)
+          string(REGEX MATCH "host: ([^\n]+)" rustcHost "${rustcInfo}")
+          list(APPEND gnArgArg rust_abi_target_override="${CMAKE_MATCH_1}")
+      endif()
 
       # adler2 known to be absent in 1.85 and present in 1.89
       if("${QWERust_VERSION}" VERSION_LESS "1.87.0")
--- qtwebengine-everywhere-src-6.140.0.orig/src/3rdparty/chromium/build/config/rust.gni
+++ qtwebengine-everywhere-src-6.140.0/src/3rdparty/chromium/build/config/rust.gni
@@ -394,6 +394,14 @@ if (toolchain_has_rust) {
              "`//${_known_rust_target_triples_filepath}`")
 }
 
+declare_args() {
+  # A system Rust toolchain built for a different vendor triplet.
+  rust_abi_target_override = ""
+}
+if (rust_abi_target_override != "") {
+  rust_abi_target = rust_abi_target_override
+}
+
 # This variable is passed to the Rust libstd build.
 rust_target_arch = ""
 if (current_cpu == "x86") {
