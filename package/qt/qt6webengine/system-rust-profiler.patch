The system Rust is built without profiler_builtins, only needed for
coverage instrumentation builds.

--- qtwebengine-everywhere-src-6.140.0.orig/src/3rdparty/chromium/build/rust/std/BUILD.gn
+++ qtwebengine-everywhere-src-6.140.0/src/3rdparty/chromium/build/rust/std/BUILD.gn
@@ -83,7 +83,6 @@ if (toolchain_has_rust) {
   # don't need to pass to the C++ linker because they're used for specialized
   # purposes.
   skip_stdlib_files = [
-    "profiler_builtins",
     "rustc_std_workspace_alloc",
     "rustc_std_workspace_core",
     "rustc_std_workspace_std",
