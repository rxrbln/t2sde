. $base/package/*/*/qt6-conf.in

var_append GCC_WRAPPER_APPEND ' ' "-I$root/$(pkgprefix includedir libxcb)"
atstage toolchain && var_append cmakeopt ' ' -DFEATURE_quick3dxr_openxr=OFF
export XDG_CACHE_HOME="$builddir/cache"
