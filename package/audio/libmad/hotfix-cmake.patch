Fix CMake configure error on ARM: if() requires upper-case AND.

Signed-off-by: René Rebe <rene@exactco.de>

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -83,7 +83,7 @@ elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "(
 elseif(CMAKE_SYSTEM_PROCESSOR MATCHES ".*(arm|ARM).*")
   message(STATUS "Using ARM fixed point math")
   option (FPM_ARM "ARM fixed point math" ON)
-  if(ASO and FALSE)
+  if(ASO AND FALSE)
     enable_language(ASM)
     list(APPEND MAD_CONFIG_DEFS ASO_INTERLEAVE1 ASO_IMDCT)
     if (BUILD_SHARED_LIBS)
