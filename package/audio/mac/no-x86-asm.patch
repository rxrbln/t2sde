@@ -1,12 +1,19 @@
 #ifndef APE_ASSEMBLY_H
 #define APE_ASSEMBLY_H
 
+#ifdef ENABLE_ASSEMBLY
 extern "C" 
 {
     void Adapt(short * pM, const short * pAdapt, int nDirection, int nOrder);
     int CalculateDotProduct(const short * pA, const short * pB, int nOrder);
     BOOL GetMMXAvailable();
 };
+#else
+// the NASM code is 32-bit x86 only, the C code paths are used without MMX
+static inline void Adapt(short *, const short *, int, int) { }
+static inline int CalculateDotProduct(const short *, const short *, int) { return 0; }
+static inline BOOL GetMMXAvailable() { return FALSE; }
+#endif
 
 #endif // #ifndef APE_ASSEMBLY_H
 
