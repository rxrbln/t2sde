+/* FLAC: "fLaC" and the STREAMINFO block; the stream is sent from offset 0 */
+void get_codec_flac(FILE *file, struct compr_config *config,
+		struct snd_codec *codec)
+{
+	unsigned char d[42];
+	unsigned int min_frame, max_frame;
+
+	if (fread(d, 1, sizeof(d), file) != sizeof(d) ||
+	    memcmp(d, "fLaC", 4) || (d[4] & 0x7f) != 0) {
+		fprintf(stderr, "Error: no FLAC STREAMINFO\n");
+		fclose(file);
+		exit(EXIT_FAILURE);
+	}
+	memset(codec, 0, sizeof(*codec));
+	codec->id = SND_AUDIOCODEC_FLAC;
+	codec->sample_rate = (unsigned int)d[18] << 12 | d[19] << 4 | d[20] >> 4;
+	codec->ch_in = codec->ch_out = (d[20] >> 1 & 7) + 1;
+	codec->format = SND_AUDIOSTREAMFORMAT_FLAC;
+	codec->options.flac_d.sample_size = ((d[20] & 1) << 4 | d[21] >> 4) + 1;
+	codec->options.flac_d.min_blk_size = d[8] << 8 | d[9];
+	codec->options.flac_d.max_blk_size = d[10] << 8 | d[11];
+	/* 24 bit fields in STREAMINFO, 16 bit in snd_dec_flac */
+	min_frame = d[12] << 16 | d[13] << 8 | d[14];
+	max_frame = d[15] << 16 | d[16] << 8 | d[17];
+	codec->options.flac_d.min_frame_size = min_frame > 0xffff ? 0xffff : min_frame;
+	codec->options.flac_d.max_frame_size = max_frame > 0xffff ? 0xffff : max_frame;
+	if (!codec->sample_rate) {
+		fprintf(stderr, "invalid sample rate 0\n");
+		fclose(file);
+		exit(EXIT_FAILURE);
+	}
+	if (verbose)
+		printf("FLAC: %u Hz, %u ch, %u bit, blocks %u..%u\n",
+		       codec->sample_rate, codec->ch_in,
+		       codec->options.flac_d.sample_size,
+		       codec->options.flac_d.min_blk_size,
+		       codec->options.flac_d.max_blk_size);
+	fseek(file, 0, SEEK_SET);
+}
