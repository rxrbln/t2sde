uint comes from <sys/types.h>, only implicitly included by glibc, not musl.

--- tinycompress-1.2.16.orig/src/utils/sofprobeclient/probes_demux.c	2026-06-01 10:04:29.000000000 +0200
+++ tinycompress-1.2.16/src/utils/sofprobeclient/probes_demux.c	2026-11-19 22:13:09.781964119 +0100
@@ -318,7 +318,7 @@
 
 int parser_parse_data(struct dma_frame_parser *p, size_t d_len)
 {
-	uint i = 0;
+	unsigned int i = 0;
 
 	p->len = p->start + d_len;
 	/* processing all loaded bytes */
@@ -383,7 +383,7 @@
 		}
 		/* data copying section */
 		if (p->total_data_to_copy > 0) {
-			uint data_to_copy;
+			unsigned int data_to_copy;
 
 			/* check if there is enough bytes loaded */
 			/* or copy partially if not */
