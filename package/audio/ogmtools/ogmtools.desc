[I] Tools for OGG media streams

[T] These tools allow information about (ogminfo) or extraction
[T] from (ogmdemux) or creation of (ogmmerge) OGG media streams.

[U] https://www.bunkus.org/videotools/ogmtools/

[A] Moritz Bunkus <moritz@bunkus.org>
[M] René Rebe <rene@exactco.de>

[C] extra/multimedia
[F] CROSS

[L] OpenSource
[V] 1.5

[D] 898b0c896684bf703803b13b04920a9419fe79186eea80b2d74de2dc ogmtools-1.5.tar.bz2 https://www.bunkus.org/videotools/ogmtools/

atstage cross && hook_add preconf 5 "echo 'ac_cv_file___dvdread_dvd_reader_h=no
ac_cv_file__usr_local_include_dvdread_dvd_reader_h=no
ac_cv_file__usr_include_dvdread_dvd_reader_h=$([ -e $root/usr/include/dvdread/dvd_reader.h ] && echo yes || echo no)' >> config.cache"

var_append CXX_WRAPPER_APPEND ' ' -std=gnu++14
