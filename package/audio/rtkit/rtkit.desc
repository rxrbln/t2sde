[I] D-Bus system service that enables real time scheduling on request

[T] RealtimeKit is a D-Bus system service that changes the scheduling policy of
[T] user processes/threads to SCHED_RR (i.e. realtime scheduling mode) on
[T] request.

[U] https://gitlab.freedesktop.org/pipewire/rtkit/

[A] Rtkit Authors
[M] René Rebe <rene@exactco.de>

[C] extra/base
[F] CROSS

[L] GPL3 MIT
[V] 0.14

[D] a3e54ead2671abd9d80d9e336fb0d26c798c62c6a05ab6449370ec39 rtkit-v0.14.tar.gz https://gitlab.freedesktop.org/pipewire/rtkit/-/archive/v0.14/

rtkit_ensure_user() {
	if [ -x /usr/bin/systemd-sysusers ]; then
		/usr/bin/systemd-sysusers /usr/lib/sysusers.d/rtkit.conf
	fi
	if ! id rtkit >/dev/null 2>&1; then
		getent group rtkit || groupadd -r rtkit
		useradd -r -g rtkit -d / -s /bin/false -c "RealtimeKit" rtkit
	fi
}
hook_add postmake 5 rtkit_ensure_user
