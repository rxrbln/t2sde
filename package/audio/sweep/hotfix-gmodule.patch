Link against gmodule-2.0 for the plugin loader, not pulled in by gtk+-2.0 anymore.

diff -Nrup sweep-0.9.3.orig/configure sweep-0.9.3/configure
--- sweep-0.9.3.orig/configure	2008-04-11 16:09:14.000000000 +0200
+++ sweep-0.9.3/configure	2026-09-27 18:00:30.399053208 +0200
@@ -28642,11 +28642,11 @@ if test -n "$PKG_CONFIG"; then
     else
         if test -n "$PKG_CONFIG" && \
     { (echo "$as_me:$LINENO: \$PKG_CONFIG --exists --print-errors \"glib-2.0 >=  2.2.0\"") >&5
-  ($PKG_CONFIG --exists --print-errors "glib-2.0 >=  2.2.0") 2>&5
+  ($PKG_CONFIG --exists --print-errors "glib-2.0 >=  2.2.0 gmodule-2.0") 2>&5
   ac_status=$?
   echo "$as_me:$LINENO: \$? = $ac_status" >&5
   (exit $ac_status); }; then
-  pkg_cv_GLIB_CFLAGS=`$PKG_CONFIG --cflags "glib-2.0 >=  2.2.0" 2>/dev/null`
+  pkg_cv_GLIB_CFLAGS=`$PKG_CONFIG --cflags "glib-2.0 >=  2.2.0 gmodule-2.0" 2>/dev/null`
 else
   pkg_failed=yes
 fi
@@ -28660,11 +28660,11 @@ if test -n "$PKG_CONFIG"; then
     else
         if test -n "$PKG_CONFIG" && \
     { (echo "$as_me:$LINENO: \$PKG_CONFIG --exists --print-errors \"glib-2.0 >=  2.2.0\"") >&5
-  ($PKG_CONFIG --exists --print-errors "glib-2.0 >=  2.2.0") 2>&5
+  ($PKG_CONFIG --exists --print-errors "glib-2.0 >=  2.2.0 gmodule-2.0") 2>&5
   ac_status=$?
   echo "$as_me:$LINENO: \$? = $ac_status" >&5
   (exit $ac_status); }; then
-  pkg_cv_GLIB_LIBS=`$PKG_CONFIG --libs "glib-2.0 >=  2.2.0" 2>/dev/null`
+  pkg_cv_GLIB_LIBS=`$PKG_CONFIG --libs "glib-2.0 >=  2.2.0 gmodule-2.0" 2>/dev/null`
 else
   pkg_failed=yes
 fi
@@ -28683,9 +28683,9 @@ else
         _pkg_short_errors_supported=no
 fi
         if test $_pkg_short_errors_supported = yes; then
-	        GLIB_PKG_ERRORS=`$PKG_CONFIG --short-errors --errors-to-stdout --print-errors "glib-2.0 >=  2.2.0"`
+	        GLIB_PKG_ERRORS=`$PKG_CONFIG --short-errors --errors-to-stdout --print-errors "glib-2.0 >=  2.2.0 gmodule-2.0"`
         else
-	        GLIB_PKG_ERRORS=`$PKG_CONFIG --errors-to-stdout --print-errors "glib-2.0 >=  2.2.0"`
+	        GLIB_PKG_ERRORS=`$PKG_CONFIG --errors-to-stdout --print-errors "glib-2.0 >=  2.2.0 gmodule-2.0"`
         fi
 	# Put the nasty error message in config.log where it belongs
 	echo "$GLIB_PKG_ERRORS" >&5
diff -Nrup sweep-0.9.3.orig/configure.ac sweep-0.9.3/configure.ac
--- sweep-0.9.3.orig/configure.ac	2008-04-11 16:08:56.000000000 +0200
+++ sweep-0.9.3/configure.ac	2026-09-27 18:00:19.576409778 +0200
@@ -73,7 +73,7 @@ if test "x$HAVE_GTK" != xyes ; then
     AC_CHECK_LIB(gtk-x11-2.0, gtk_init, HAVE_GTK="maybe", sweep_config_ok="no")
 fi
 
-PKG_CHECK_MODULES(GLIB, glib-2.0 >=  2.2.0, HAVE_GLIB="yes", sweep_config_ok="no")
+PKG_CHECK_MODULES(GLIB, glib-2.0 >=  2.2.0 gmodule-2.0, HAVE_GLIB="yes", sweep_config_ok="no")
 AC_SUBST(GLIB_CFLAGS)
 AC_SUBST(GLIB_LIBS)
 if test "x$HAVE_GLIB" != xyes ; then
