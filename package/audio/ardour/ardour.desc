[I] A multitrack, multichannel audio recorder/non-linear editor

[T] Ardour is a professional multitrack/multichannel audio recorder and DAW
[T] for Linux, using ALSA-supported audio interfaces. It supports up to 32
[T] bit samples, 24+ channels at up to 96kHz, full MMC control, a
[T] non-destructive, non-linear editor, and LADSPA plugins.

[U] https://ardour.org/

[A] Artjom Simon
[M] René Rebe <rene@exactco.de>

[C] extra/multimedia
[F] NO-LTO

[E] add flac
[E] opt jack

[L] GPL
[V] 9.10

[D] e6a6525f6475928f0f4d4d81a4e7ffcd42db7f4d2ccec66fd0f8649d Ardour-9.10.tar.bz2 !https://community.ardour.org/download/release/652?expires=1794580341&signature=3f4645e1dd8f3eeb8a96774c8725f698fd2ead0f5626d9abf8aa66ecb0f09a6e

runmake=0
AS="$CC -c"

var_append GCC_WRAPPER_APPEND ' ' -std=c++17

wafconfopt=
if atstage cross; then
	# waf autodetects the build host CPU
	case "$arch" in
		x86) wafconfopt=--dist-target=i686 ;;
		x86-64) wafconfopt=--dist-target=x86_64 ;;
		arm) wafconfopt=--dist-target=armhf ;;
		arm64) wafconfopt=--dist-target=aarch64 ;;
		*) wafconfopt=--dist-target=none ;;
	esac
fi
hook_add preconf 5 "./waf configure --prefix=/$prefix $wafconfopt"
hook_add inmake 5 ./waf
hook_add postmake 5 "./waf install --destdir=$root"
