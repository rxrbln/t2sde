TypeScript 6 reports the bind_property_full overload mismatch at the null
argument, move the @ts-expect-error directives there.

diff -urp a/src/playback-rate-button.ts b/src/playback-rate-button.ts
--- a/src/playback-rate-button.ts	2026-11-24 21:01:41.763531155 +0000
+++ b/src/playback-rate-button.ts	2026-11-24 21:01:41.777471488 +0000
@@ -36,7 +36,6 @@ export class APPlaybackRateButton extend
       GObject.BindingFlags.SYNC_CREATE,
     );
 
-    // @ts-expect-error GObject.BindingTransformFunc return arguments are not correctly typed
     window.stream.bind_property_full(
       "rate",
       this._label,
@@ -46,6 +45,7 @@ export class APPlaybackRateButton extend
         const rounded = from.toFixed(1);
         return [true, `× ${rounded}`];
       },
+      // @ts-expect-error GObject.BindingTransformFunc return arguments are not correctly typed
       null,
     );
   }
