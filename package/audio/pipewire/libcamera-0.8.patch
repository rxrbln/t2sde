Adapt to libcamera 0.8 renamed properties::CameraLocation* enumerators.

Signed-off-by: René Rebe <rene@exactco.de>

--- pipewire-1.6.11.orig/spa/plugins/libcamera/libcamera-device.cpp
+++ pipewire-1.6.11/spa/plugins/libcamera/libcamera-device.cpp
@@ -28,6 +28,14 @@
 
 #include <libcamera/camera.h>
 #include <libcamera/property_ids.h>
+#include <libcamera/version.h>
+
+/* libcamera 0.8 renamed the CameraLocation* enumerators */
+#if LIBCAMERA_VERSION_MAJOR == 0 && LIBCAMERA_VERSION_MINOR < 8
+#define LocationFront CameraLocationFront
+#define LocationBack CameraLocationBack
+#define LocationExternal CameraLocationExternal
+#endif
 
 using namespace libcamera;
 
@@ -69,11 +77,11 @@ const char *cameraLoc(const Camera& came
 {
 	if (auto location = camera.properties().get(properties::Location)) {
 		switch (location.value()) {
-		case properties::CameraLocationFront:
+		case properties::LocationFront:
 			return "front";
-		case properties::CameraLocationBack:
+		case properties::LocationBack:
 			return "back";
-		case properties::CameraLocationExternal:
+		case properties::LocationExternal:
 			return "external";
 		}
 	}
