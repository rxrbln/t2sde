[I] An audio labelling library

[T] Aubio is a library for audio labelling. Its features include segmenting
[T] a sound file before each of its attacks, performing pitch detection,
[T] tapping the beat and producing midi streams from live audio.

[U] https://aubio.org

[A] Paul Brossier <piem@altern.org>
[M] Aldas Nabazas <baldzius@gmail.com>

[C] extra/multimedia
[F] CROSS

[E] opt doxygen
[E] opt ffmpeg
[E] opt jack
[E] opt libsamplerate
[E] opt libsndfile

[L] GPL
[V] 0.4.9 e559ff1
[P] X -----5---9 400.500

[D] 76696dc9afdc22b84e2f58adbd500f969c8013f9a14fdb784a873cac aubio-0.4.9-e559ff1.tar.gz !https://github.com/aubio/aubio/archive/e559ff1.tar.gz
[D] 57d49d91d58b5b7feaa991cb57b98539d98a971e3c26794cc3470b50 waf-2.0.26.tar.bz2 https://waf.io/

runmake=0 runpysetup=0 runmeson=0 runcmake=0
aubio_waf() {
	tar xf $(match_source_file -p waf)
	(cd waf-2.0.26 && NOCLIMB=1 python waf-light --tools=c_emscripten)
	cp waf-2.0.26/waf .
}
hook_add preconf 2 aubio_waf
hook_add preconf 5 "python waf configure --prefix=/$prefix"
hook_add inmake 5 "python waf build --disable-tests -j$SDECFG_PARALLEL"
hook_add postmake 5 "python waf install --disable-tests --destdir=$root"
