Pass the ATQA length by reference to rfid_layer2_getopt, declare the
exported mfcl_set_key and mfcl_auth and include string.h for memcpy.

diff -urp a/include/librfid/rfid_protocol_mifare_classic.h b/include/librfid/rfid_protocol_mifare_classic.h
--- a/include/librfid/rfid_protocol_mifare_classic.h	2006-12-01 12:49:05.000000000 +0000
+++ b/include/librfid/rfid_protocol_mifare_classic.h	2026-11-24 22:01:46.346190703 +0000
@@ -21,6 +21,10 @@ enum rfid_proto_mfcl_opt {
 	RFID_OPT_P_MFCL_SIZE	=	0x10000001,
 };
 
+struct rfid_protocol_handle;
+int mfcl_set_key(struct rfid_protocol_handle *ph, unsigned char *key);
+int mfcl_auth(struct rfid_protocol_handle *ph, u_int8_t cmd, u_int8_t block);
+
 #ifdef __LIBRFID__
 
 extern const struct rfid_protocol rfid_protocol_mfcl;
diff -urp a/src/rfid_layer2.c b/src/rfid_layer2.c
--- a/src/rfid_layer2.c	2006-10-13 22:22:56.000000000 +0000
+++ b/src/rfid_layer2.c	2026-11-24 22:01:46.346140683 +0000
@@ -20,6 +20,7 @@
 #include <stdlib.h>
 #include <stdio.h>
 #include <errno.h>
+#include <string.h>
 
 #include <librfid/rfid.h>
 #include <librfid/rfid_layer2.h>
diff -urp a/src/rfid_proto_mifare_ul.c b/src/rfid_proto_mifare_ul.c
--- a/src/rfid_proto_mifare_ul.c	2006-12-01 13:25:28.000000000 +0000
+++ b/src/rfid_proto_mifare_ul.c	2026-11-24 22:01:46.346070554 +0000
@@ -139,7 +139,7 @@ mful_init(struct rfid_layer2_handle *l2h
 	
 	/* According to "Type Identification Procedure Rev. 1.3" */
 	rfid_layer2_getopt(l2h, RFID_OPT_14443A_ATQA,
-			   &atqa, atqa_len);
+			   &atqa, &atqa_len);
 	if (atqa != 0x0044)
 		return NULL;
 
