[I] A Java graphics library

[T] LWJGL is a Java library that enables cross-platform access to popular
[T] native APIs useful in the development of graphics.

[U] https://github.com/LWJGL/lwjgl3

[A] LWJGL
[M] xanthe

[C] extra/development

[L] BSD
[V] 3.4.3

[D] 05df13d405f14ad0e6b35516491c2aa171b88598a34e87a4be1d1137 lwjgl-3.4.3.tar.gz https://github.com/LWJGL/lwjgl3/archive/3.4.3/

runconf=0 runmake=0 runmaven=0

#.tmp has no exec rights
export MAVEN_OPTS="-Djansi.tmpdir=$HOME/.jansi"
export JAVA_HOME="/opt/java"

hook_add inmake 2 "mvn install -Dmaven.repo.local=${JAVA_HOME}/lwjgl3"
