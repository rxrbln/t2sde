Create the target directories, else the files are installed as bin, pixmaps
and applications.

--- murrine-configurator-0.5.orig/install.sh
+++ murrine-configurator-0.5/install.sh
@@ -46,9 +46,9 @@ function check_install {
 function installation {
 	echo "Installing files under $PREFIX..."
 	sleep 1
-	install -m0755 files/murrine-configurator ${PREFIX}/bin
-	install -m0644 files/murrine-configurator.png ${PREFIX}/share/pixmaps
-	install -m0644 files/murrine-configurator.desktop ${PREFIX}/share/applications
+	install -Dm0755 files/murrine-configurator ${PREFIX}/bin/murrine-configurator
+	install -Dm0644 files/murrine-configurator.png ${PREFIX}/share/pixmaps/murrine-configurator.png
+	install -Dm0644 files/murrine-configurator.desktop ${PREFIX}/share/applications/murrine-configurator.desktop
 	if [ ! -e previous_installation.log ]
 	then 
 		echo "$PREFIX" > previous_installation.log
