[I] A simple, small, C++ XML parser (legacy TinyXML-1)

[T] TinyXML is a simple, small, C++ XML parser that can be easily
[T] integrated into other programs. This is the legacy first generation
[T] library, superseded by TinyXML-2, but still required by some
[T] applications, such as Kodi. Built with TIXML_USE_STL enabled.

[U] https://sourceforge.net/projects/tinyxml/

[A] Lee Thomason
[M] Dennie Mahne <dennie.mahne@gmail.com>

[C] extra/development
[F] CROSS

[L] ZLIB
[V] 2.6.2

[D] 99fed279201208ba82d238c2cd2aabcd9015d1886419dc9b9bb4d7db tinyxml_2_6_2.tar.gz https://downloads.sourceforge.net/project/tinyxml/tinyxml/2.6.2/

runmake=0

pkg_tinyxml_main() {
	local so=libtinyxml.so.0.$ver
	echo "Building $so ..."

	# build
	$CXX $CXXFLAGS -fPIC -DTIXML_USE_STL -c \
		tinyxml.cpp tinyxmlparser.cpp tinyxmlerror.cpp tinystr.cpp
	$CXX $LDFLAGS -shared -Wl,-soname,libtinyxml.so.0 -o $so \
		tinyxml.o tinyxmlparser.o tinyxmlerror.o tinystr.o

	# install
	install -m 755 $so $root$libdir/
	ln -sfv $so $root$libdir/libtinyxml.so.0
	ln -sfv libtinyxml.so.0 $root$libdir/libtinyxml.so
	install -m 644 tinyxml.h tinystr.h $root$includedir/
}
hook_add inmake 5 pkg_tinyxml_main
