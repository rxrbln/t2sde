--- mandoc-1.14.6/configure.vanilla	2026-11-10 19:19:03.825254451 +0200
+++ mandoc-1.14.6/configure	2026-11-10 19:24:28.548985710 +0200
@@ -36,7 +36,7 @@
 SOURCEDIR=`dirname "${0}"`
 
 MANPATH_BASE="/usr/share/man:/usr/X11R6/man"
-MANPATH_DEFAULT="/usr/share/man:/usr/X11R6/man:/usr/local/man"
+MANPATH_DEFAULT="/usr/share/man:/usr/X11/man:/opt/gnome/man:/opt/java/man:/opt/libreoffice/man:/opt/lighttpd/man:/opt/mate/man:/opt/mono/man:/opt/openldap/man:/opt/prelude/man:/opt/sdcc/man:/opt/texlive/man:/opt/xfce4/man"
 OSENUM=
 OSNAME=
 UTF8_LOCALE=
@@ -53,8 +53,8 @@
 STATIC=
 
 BUILD_CGI=0
-BUILD_CATMAN=0
-INSTALL_LIBMANDOC=0
+BUILD_CATMAN=1
+INSTALL_LIBMANDOC=1
 
 HAVE_ATTRIBUTE=
 HAVE_CMSG=
@@ -102,13 +102,13 @@
 MANDOC_COBJS=
 SOELIM_COBJS=
 
-PREFIX="/usr/local"
-BINDIR=
-SBINDIR=
+PREFIX="/usr"
+BINDIR="/usr/bin"
+SBINDIR="/usr/sbin"
 BIN_FROM_SBIN=
-INCLUDEDIR=
-LIBDIR=
-MANDIR=
+INCLUDEDIR="/usr/include"
+LIBDIR="/usr/lib64"
+MANDIR="/usr/man"
 READ_ALLOWED_PATH=
 
 WWWPREFIX="/var/www"
@@ -122,9 +122,9 @@
 BINM_SOELIM="soelim"
 BINM_WHATIS="whatis"
 BINM_PAGER=
-MANM_MAN="man"
+MANM_MAN="mandoc_man"
 MANM_MANCONF="man.conf"
-MANM_MDOC="mdoc"
+MANM_MDOC="mandoc_mdoc"
-MANM_ROFF="roff"
+MANM_ROFF="mandoc_roff
 MANM_EQN="eqn"
 MANM_TBL="tbl"
