[I] A TeX distribution

[T] TeX Live is an easy way to get up and running with the TeX document
[T] production system. It provides a comprehensive TeX system with
[T] binaries for most flavors of Unix, including GNU/Linux, and also
[T] Windows. It includes all the major TeX-related programs, macro
[T] packages, and fonts that are free software, including support for many
[T] languages around the world.

[U] https://tug.org/texlive/

[A] Donald E. Knuth {Author of TeX}
[A] Leslie Lamport {Original Author of LaTeX}
[A] Sebastian Rahtz {Original Author of TeXLive}
[A] Karl Berry and others {Current Authors of TeXLive} karl@freefriends.org
[M] Roger Mason <rmason@mun.ca>

[C] extra/office
[F] NO-LTO

[L] OpenSource
[V] 2026
[P] X -----5---9 600.000

[D] 5225efa68a0a9d6fc6cd68cfb614daa803e316df494aa146b9f3d203 texlive-20260301-source.tar.xz https://texlive.info/historic/systems/texlive/2026/
[D] 6674cb4d3d88efee6dc1f1a85d19fcb2674c24efa65b34b321236fcf texlive-20260301-texmf.tar.xz https://texlive.info/historic/systems/texlive/2026/
[D] 85e5ae18eeb4b85aac740442c3d0e24069acd5f23bcfc02a75e8a1f0 texlive-20260301-extra.tar.xz https://texlive.info/historic/systems/texlive/2026/

[ $prefix_auto = 1 ] && prefix="/opt/texlive" && set_confopt

autoextract=0

var_append GCC_WRAPPER_APPEND ' ' -std=gnu++17

texlive_source_unpack() {
	cd $builddir
	tar --use-compress-program xz -xf `match_source_file -p source`
	cd $builddir/texlive-*-source
}
hook_add prepatch 5 texlive_source_unpack

# remove useless opts
var_append confopt ' ' --disable-multiplatform
var_append confopt ' ' --disable-native-texlive-build
var_append confopt ' ' --with-banner-add="/T2"
var_append confopt ' ' --with-ps=gs
var_append confopt ' ' --with-system-cairo
var_append confopt ' ' --with-system-freetype2
var_append confopt ' ' --with-system-gd
var_append confopt ' ' --with-system-gmp
var_append confopt ' ' --with-system-graphite
var_append confopt ' ' --with-system-graphite2
var_append confopt ' ' --with-system-harfbuzz
var_append confopt ' ' --with-system-icu
var_append confopt ' ' --with-system-libpng
var_append confopt ' ' --with-system-mpfr
var_append confopt ' ' --with-system-ncurses
var_append confopt ' ' --with-system-pixman
var_append confopt ' ' --with-system-pnglib
var_append confopt ' ' --with-system-poppler
var_append confopt ' ' --with-system-potrace
var_append confopt ' ' --with-system-t1lib
var_append confopt ' ' --with-system-zlib
var_append confopt ' ' --with-x-dvi-toolkit=xaw
var_append confopt ' ' --with-system-libpaper
var_append confopt ' ' --with-system-zziplib
var_append confopt ' ' --with-system-teckit
var_append confopt ' ' --without-texinfo
var_append confopt ' ' --enable-build-in-source-tree

# fail build
#var_append confopt ' ' --with-system-luajit

texlive_post_install() {
	export PATH=/$prefix/bin:$PATH
	export TEXMFROOT=/$prefix
	texlinks -f /$prefix/share/texmf-dist/web2c/fmtutil.cnf /$prefix/bin
	mkdir -p /$prefix/tlpkg/TeXLive/
	install -v -m644 $builddir/texlive-*-source/texk/tests/TeXLive/* /$prefix/tlpkg/TeXLive/
	echo "Install extra"
	tar -C /$prefix/tlpkg --strip-components=2 --use-compress-program xz -xf `match_source_file -p extra`
	echo "Install texmf"
	tar -C /$prefix --strip-components=1 --use-compress-program xz -xf `match_source_file -p texmf`
	mktexlsr
	fmtutil-sys --all

	cat > $root/etc/profile.d/texlive <<-EOT
		export TEXMFROOT="/$prefix"
		export TEXMFDIST="/$prefix/texmf-dist"
		export TEXMFSYSVAR="/$prefix/texmf-var"
	EOT
}
hook_add postinstall 5 texlive_post_install
