The documentation is formatted with the just built htmldoc.

diff -Nrup a/doc/Makefile b/doc/Makefile
--- a/doc/Makefile	2026-08-29 16:04:41.000000000 +0200
+++ b/doc/Makefile	2026-10-22 17:22:42.903444190 +0200
@@ -27,8 +27,8 @@ SOURCES	=	1-intro.html \
 		a-license.html \
 		b-book.html
 
-DOCUMENTS =	htmldoc.epub htmldoc.html htmldoc.pdf htmldoc.ps
-DOCFILES =	help.html htmldoc.pdf
+DOCUMENTS =
+DOCFILES = help.html
 
 HTMLDOC	=	../htmldoc/htmldoc$(EXEEXT) --datadir .. --strict
 
