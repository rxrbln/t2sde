[COPY] SPDX-License-Identifier: GPL-2.0
[COPY] --- T2-COPYRIGHT-END ---

[I] A complete audio and video stream library

[T] FFmpeg is a complete solution to record, convert and stream audio and
[T] video. It includes libavcodec, the leading audio/video codec library.

[U] https://ffmpeg.org/

[A] Many - see the CREDITS file
[M] René Rebe <rene@exactco.de>

[C] extra/multimedia
[F] CROSS FPIC NO-LTO

[E] opt libx11 libxcb libxext libxv xorgproto
# TODO: needs nasm || yasm on x86*
[E] opt nasm yasm
[E] opt libogg
[E] opt libva
[E] opt perl-libintl
[E] opt pesign
[E] opt nvidia-vaapi-driver
[E] opt sndio
[E] opt clang
[E] opt libcdio-paranoia
[E] opt amf-headers
[E] opt zlib
[E] opt glib gdk-pixbuf
[E] opt cairo

[L] LGPL
[V] 9.0.2
[P] X -----5---9 152.700

[D] 0d01eb37ccb3f3ea6d6de4143b252cdd698356f7dfc5885a2b6de6ef ffmpeg-9.0.2.tar.xz https://ffmpeg.org/releases/

hook_add preconf 5 'export TMPDIR="$(mktemp -d -p $PWD)"'

atstage cross &&
	var_append confopt ' ' "--enable-cross-compile --cross-prefix=${arch_target}- \
		--arch=$SDECFG_ARCH --target-os=$SDECFG_KERNEL --pkg-config=pkg-config"

# select architecture, for cross compilation
var_append confopt ' ' "--arch=`echo $arch | arch2uname`"

[ "$SDECFG_X8664_X32" = 1 ] && var_append confopt ' ' --disable-asm

# .so file location
var_append confopt ' ' --shlibdir=$libdir

pkginstalled valgrind || var_append confopt ' ' --disable-valgrind-backtrace

# Licenses (L)GPL version 3
var_append confopt ' ' --enable-version3 # (L)GPL version 3
var_append confopt ' ' --enable-gpl # GPL

# shared libraries
[ "$SDECFG_STATIC" = 1 ] || var_append confopt ' ' --enable-shared

# fill options the configure does not attempt to detect ...
var_append confopt ' ' --enable-pthreads

# disks support
pkginstalled xvid && var_append confopt ' ' --enable-libxvid
pkginstalled libbluray && var_append confopt ' ' --enable-libbluray
pkginstalled libcdio && var_append confopt ' ' --enable-libcdio
pkginstalled libdvdnav && var_append confopt ' ' --enable-libdvdnav
pkginstalled libdvdread && var_append confopt ' ' --enable-libdvdread

# codec: av1
pkginstalled dav1d && var_append confopt ' ' --enable-libdav1d
pkginstalled rav1e && var_append confopt ' ' --enable-librav1e
pkginstalled libaom && var_append confopt ' ' --enable-libaom
pkginstalled svt-av1 && var_append confopt ' ' --enable-libsvtav1

# graphic codecs
pkginstalled davs2 && var_append confopt ' ' --enable-libdavs2
pkginstalled libjxl && var_append confopt ' ' --enable-libjxl
pkginstalled kvazaar && var_append confopt ' ' --enable-libkvazaar
pkginstalled lcevcdec && var_append confopt ' ' --enable-liblcevc-dec
#pkginstalled openapv && var_append confopt ' ' --enable-liboapv # build fails
pkginstalled openh264 && var_append confopt ' ' --enable-libopenh264
pkginstalled openjpeg && var_append confopt ' ' --enable-libopenjpeg
pkginstalled libqrencode && var_append confopt ' ' --enable-libqrencode
pkginstalled libquirc && var_append confopt ' ' --enable-libquirc
pkginstalled shine && var_append confopt ' ' --enable-libshine
pkginstalled svt-jpeg-xs && var_append confopt ' ' --enable-libsvtjpegxs
pkginstalled libtheora && var_append confopt ' ' --enable-libtheora
pkginstalled twolame && var_append confopt ' ' --enable-libtwolame
pkginstalled uavs3d && var_append confopt ' ' --enable-libuavs3d
pkginstalled libvpx && var_append confopt ' ' --enable-libvpx
pkginstalled libwebp && var_append confopt ' ' --enable-libwebp
pkginstalled x264 && var_append confopt ' ' --enable-libx264
pkginstalled x265 && var_append confopt ' ' --enable-libx265

# hardware acceleration
var_append confopt ' ' --disable-vulkan
pkginstalled libvpl intel-onevpl && var_append confopt ' ' --enable-libvpl
pkginstalled libvdpau || var_append confopt ' ' --disable-vdpau
pkginstalled nvidia-vaapi-driver || var_append confopt ' ' --disable-vaapi

# window system
if ! pkginstalled libsdl2; then
	var_append confopt ' ' --disable-sdl2
	var_append confopt ' ' --disable-ffplay
fi

# external libs
pkginstalled lcms2 && var_append confopt ' ' --enable-lcms2
pkginstalled libcaca && var_append confopt ' ' --enable-libcaca
pkginstalled fribidi && var_append confopt ' ' --enable-libfribidi
pkginstalled lame && var_append confopt ' ' --enable-libmp3lame
pkginstalled opencolorio && var_append confopt ' ' --enable-libopencolorio
#pkginstalled libplacebo && var_append confopt ' ' --enable-libplacebo #fails to ld
pkginstalled librsvg && var_append confopt ' ' --enable-librsvg
pkginstalled libxml && var_append confopt ' ' --enable-libxml2
pkginstalled zimg && var_append confopt ' ' --enable-libzimg
pkginstalled libzmq && var_append confopt ' ' --enable-libzmq

# font support
pkginstalled harfbuzz && var_append confopt ' ' --enable-libharfbuzz
pkginstalled freetype && var_append confopt ' ' --enable-libfreetype
pkginstalled fontconfig && var_append confopt ' ' --enable-libfontconfig

# compression
pkginstalled snappy && var_append confopt ' ' --enable-libsnappy

# network
# openssl, gnutls and mbedtls are mutually excluding
pkginstalled openssl && var_append confopt ' ' --enable-openssl
#pkginstalled gnutls && var_append confopt ' ' --enable-gnutls
#pkginstalled mbedtls && var_append confopt ' ' --enable-mbedtls

# transport
pkginstalled libdc1394 libraw1394 libavc1394 && var_append confopt ' ' --enable-libdc1394
pkginstalled libiec61883 && var_append confopt ' ' --enable-libiec61883
pkginstalled librist && var_append confopt ' ' --enable-librist
pkginstalled libsrt && var_append confopt ' ' --enable-libsrt
pkginstalled libssh && var_append confopt ' ' --enable-libssh

# video support
pkginstalled libass && var_append confopt ' ' --enable-libass # subtitles
#pkginstalled lensfun && var_append confopt ' ' --enable-liblensfun
#pkginstalled opencv && var_append confopt ' ' --enable-libopencv # wants opncv4
pkginstalled tesseract && var_append confopt ' ' --enable-libtesseract
pkginstalled libv4l && var_append confopt ' ' --enable-libv4l2
pkginstalled vmaf && var_append confopt ' ' --enable-libvmaf
pkginstalled xvid && var_append confopt ' ' --enable-libxvid

# audio support
pkginstalled chromaprint && var_append confopt ' ' --enable-chromaprint
pkginstalled frei0r && var_append confopt ' ' --enable-frei0r
pkginstalled ladspa && var_append confopt ' ' --enable-ladspa
pkginstalled libbs2b && var_append confopt ' ' --enable-libbs2b
pkginstalled flite && var_append confopt ' ' --enable-libflite
pkginstalled libgme && var_append confopt ' ' --enable-libgme
pkginstalled jack && var_append confopt ' ' --enable-libjack
pkginstalled libmodplug && var_append confopt ' ' --enable-libmodplug
pkginstalled libopenmpt && var_append confopt ' ' --enable-libopenmpt
pkginstalled pulseaudio && var_append confopt ' ' --enable-libpulse
pkginstalled rubberband && var_append confopt ' ' --enable-librubberband
pkginstalled soxr && var_append confopt ' ' --enable-libsoxr

# audio codec
pkginstalled codec2 && var_append confopt ' ' --enable-libcodec2
#pkginstalled libaac && var_append confopt ' ' --enable-libfdk-aac # nonfree
pkginstalled gsm && var_append confopt ' ' --enable-libgsm
pkginstalled libilbc && var_append confopt ' ' --enable-libilbc
pkginstalled liblc3 && var_append confopt ' ' --enable-liblc3
#pkginstalled mpeghdec && var_append confopt ' ' --enable-libmpeghdec #nonfree
pkginstalled libopus && var_append confopt ' ' --enable-libopus
pkginstalled opencore-amr &&
	var_append confopt ' ' "--enable-libopencore-amrnb --enable-libopencore-amrwb"
pkginstalled speex && var_append confopt ' ' --enable-libspeex

# Imlib2 support
if pkginstalled imlib2; then
	pkgprefix -t imlib2
	var_append confopt ' ' "--extra-cflags=-I$root$(pkgprefix includedir imlib2)"
	var_append confopt ' ' "--extra-ldflags=-L$root$(pkgprefix libdir imlib2)"
fi

# Ogg Vorbis support
pkginstalled libvorbis && var_append confopt ' ' --enable-libvorbis

var_append makeopt ' ' LD=$CC
var_append makeinstopt ' ' LD=$CC
var_remove_regex makeopt ' ' 'STRIP=.*'
var_remove_regex makeopt ' ' 'AS=.*'
