oneTBB parallel_sort calls the comparator with const references, upstream
main has the same fix.

--- a/source/blender/modifiers/intern/MOD_grease_pencil_build.cc	2026-11-24 20:29:35.237639165 +0000
+++ b/source/blender/modifiers/intern/MOD_grease_pencil_build.cc	2026-11-24 20:29:35.253792432 +0000
@@ -492,7 +492,7 @@ static bke::CurvesGeometry reorder_strok
   }
 
   parallel_sort(
-      distances.begin(), distances.end(), [](Pair &a, Pair &b) { return a.value < b.value; });
+      distances.begin(), distances.end(), [](const Pair &a, const Pair &b) { return a.value < b.value; });
 
   Array<int> new_order(curves.curves_num());
   for (const int i : curves.curves_range()) {
