diff -urp a/intern/cycles/hydra/field.cpp b/intern/cycles/hydra/field.cpp
--- a/intern/cycles/hydra/field.cpp	2026-11-24 09:50:13.333336769 +0000
+++ b/intern/cycles/hydra/field.cpp	2026-11-24 09:50:13.341531820 +0000
@@ -33,7 +33,11 @@ class HdCyclesVolumeLoader : public VDBI
 #  ifdef OPENVDB_USE_DELAYED_LOADING
       file.setCopyMaxBytes(0);
 #  endif
+#  if OPENVDB_LIBRARY_MAJOR_VERSION_NUMBER >= 14
+      if (file.open()) {
+#  else
       if (file.open(delay_load)) {
+#  endif
         grid = file.readGrid(gridName);
       }
     }
diff -urp a/source/blender/blenkernel/intern/volume_grid_file_cache.cc b/source/blender/blenkernel/intern/volume_grid_file_cache.cc
--- a/source/blender/blenkernel/intern/volume_grid_file_cache.cc	2026-11-24 09:50:13.330336939 +0000
+++ b/source/blender/blenkernel/intern/volume_grid_file_cache.cc	2026-11-24 09:50:13.341502580 +0000
@@ -96,7 +96,11 @@ static FileCache create_file_cache(const
 #  ifdef OPENVDB_USE_DELAYED_LOADING
     file.setCopyMaxBytes(0);
 #  endif
