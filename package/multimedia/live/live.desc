[I] A set of C++ libraries for RTSP multimedia streaming

[T] This code forms a set of C++ libraries for multimedia streaming, using
[T] open standard protocols (RTP/RTCP, RTSP, SIP). These libraries - which
[T] can be compiled for Unix (including Linux and Mac OS X), Windows, and
[T] QNX (and other POSIX-compliant systems) - can be used to build
[T] streaming applications.

[U] http://www.live555.com/liveMedia/

[A] Developers at live.com
[M] René Rebe <rene@exactco.de>

[C] extra/multimedia
[F] NOPARALLEL FPIC CROSS

[L] LGPL
[V] 2026.10.24

[D] c4ad3ac2dcd7286c9066d4fe3eec3a5dbd4496bf2928642a26af797c live.2026.10.24.tar.gz https://download.live555.com/

rtsp_pm() {
	echo "Manually installing files ..."
	find . -name '*.hh' -o -name '*.h' | while read file; do
		mkdir -p $root$includedir/`dirname $file | sed s,include/,,`
		cp -r $file $root$includedir/`echo $file | sed s,include/,,`
	done
	find . -name '*.so' -o -name '*.a' | while read file; do
		cp -r $file $root$libdir/
	done
}

# no ./configure and no make install ...
runconf=0
makeinstopt=

live_config() {
	sed -i -e "s|^C_COMPILER =.*|C_COMPILER = $CC|" \
	       -e "s|^CPLUSPLUS_COMPILER =.*|CPLUSPLUS_COMPILER = $CXX|" \
	       -e "s|^LINK =.*|LINK = $CXX -o|" \
	       -e "s|^LIBRARY_LINK =.*|LIBRARY_LINK = $AR cr |" config.linux
}
hook_add premake 2 live_config
hook_add premake 3 "./genMakefiles linux"

# CPP is the C++ source suffix in these Makefiles
var_append makeopt ' ' CPP=cpp
hook_add postmake 3 rtsp_pm
