+      "{ .mii\n\t nop.m 0\n\t pmpy2.r r20 = %[s3], %[f3]\n\t pmpy2.l r21 = %[s3], %[f3]\n\t}\n\t"
+      "{ .mii\n\t nop.m 0\n\t pmpy2.r r22 = %[s4], %[f4]\n\t pmpy2.l r23 = %[s4], %[f4]\n\t}\n\t"
