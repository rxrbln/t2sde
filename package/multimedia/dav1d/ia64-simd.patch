+    const i16x4 H45 = itx_mul2(G50, ITXC(181), G45, ITXC(-181), 8);
+    const i16x4 H46 = itx_mul2(G49, ITXC(181), G46, ITXC(-181), 8);
+    const i16x4 H47 = itx_mul2(G48, ITXC(181), G47, ITXC(-181), 8);
+    const i16x4 H48 = itx_mul2(G48, ITXC(181), G47, ITXC( 181), 8);
+    const i16x4 H49 = itx_mul2(G49, ITXC(181), G46, ITXC( 181), 8);
+    const i16x4 H50 = itx_mul2(G50, ITXC(181), G45, ITXC( 181), 8);
+    const i16x4 H51 = itx_mul2(G51, ITXC(181), G44, ITXC( 181), 8);
+    const i16x4 H52 = itx_mul2(G52, ITXC(181), G43, ITXC( 181), 8);
+    const i16x4 H53 = itx_mul2(G53, ITXC(181), G42, ITXC( 181), 8);
+    const i16x4 H54 = itx_mul2(G54, ITXC(181), G41, ITXC( 181), 8);
+    const i16x4 H55 = itx_mul2(G55, ITXC(181), G40, ITXC( 181), 8);
