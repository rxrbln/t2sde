+    *q0 = r0; *q1 = r1; *q2 = r2; *q3 = r3;
+}
+
+SIMD_FN i16x4 h8_pix4_6t(const pixel *const b, const i16x4 *const F,
+                         const i16x4 bias, const int shift)
+{
+    return h8_core_6t(ldu_u8x8(b), ldu_u8x8(b + 3), F, bias, shift);
