+        t10a = itx_mul2(in[5],  ITXC(1931), in[11], ITXC(-3612), 12);
+        t11a = itx_mul2(in[13], ITXC(3920), in[3],  ITXC(-1189), 12);
+        t12a = itx_mul2(in[13], ITXC(1189), in[3],  ITXC( 3920), 12);
+        t13a = itx_mul2(in[5],  ITXC(3612), in[11], ITXC( 1931), 12);
+        t14a = itx_mul2(in[9],  ITXC(1299), in[7],  ITXC( 1583), 11);
