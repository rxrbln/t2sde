+    const i16x4 t11 = padd2_sss(t11a, t10a);
+    const i16x4 t12 = padd2_sss(t12a, t13a);
+    const i16x4 t13 = psub2_sss(t12a, t13a);
+    const i16x4 t14 = psub2_sss(t15a, t14a);
+    const i16x4 t15 = padd2_sss(t15a, t14a);
+
+    const i16x4 t9a_b  = itx_mul2(t14, ITXC( 1567), t9,  ITXC(-3784), 12);
+    const i16x4 t14a_b = itx_mul2(t14, ITXC( 3784), t9,  ITXC( 1567), 12);
+    const i16x4 t10a_b = itx_mul2(t13, ITXC(-3784), t10, ITXC(-1567), 12);
+    const i16x4 t13a_b = itx_mul2(t13, ITXC( 1567), t10, ITXC(-3784), 12);
+
+    const i16x4 t8a_c  = padd2_sss(t8,  t11);
+    const i16x4 t9_c   = padd2_sss(t9a_b,  t10a_b);
+    const i16x4 t10_c  = psub2_sss(t9a_b,  t10a_b);
+    const i16x4 t11a_c = psub2_sss(t8,  t11);
+    const i16x4 t12a_c = psub2_sss(t15, t12);
+    const i16x4 t13_c  = psub2_sss(t14a_b, t13a_b);
+    const i16x4 t14_c  = padd2_sss(t14a_b, t13a_b);
+    const i16x4 t15a_c = padd2_sss(t15, t12);
+
+    const i16x4 t10a_d = itx_mul2(t13_c,  ITXC(181), t10_c,  ITXC(-181), 8);
+    const i16x4 t13a_d = itx_mul2(t13_c,  ITXC(181), t10_c,  ITXC( 181), 8);
+    const i16x4 t11_d  = itx_mul2(t12a_c, ITXC(181), t11a_c, ITXC(-181), 8);
+    const i16x4 t12_d  = itx_mul2(t12a_c, ITXC(181), t11a_c, ITXC( 181), 8);
