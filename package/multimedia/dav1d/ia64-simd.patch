+    const i16x4 t4 = padd2_sss(t4a, t5a);
+    const i16x4 x5 = psub2_sss(t4a, t5a);      /* t5a in the C */
+    const i16x4 t7 = padd2_sss(t7a, t6a);
+    const i16x4 x6 = psub2_sss(t7a, t6a);      /* t6a in the C */
