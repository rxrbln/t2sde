+      ";;\n\t"
+      "{ .mmi\n\t padd4 r14 = r14, r22\n\t padd4 r15 = r15, r23\n\t nop.i 0\n\t}\n\t"
+      ";;\n\t"
+      "{ .mmi\n\t padd4 r14 = r14, %[bias]\n\t padd4 r15 = r15, %[bias]\n\t nop.i 0\n\t}\n\t"
+      ";;\n\t"
