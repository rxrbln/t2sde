+    __asm__ volatile(
+        "{ .mmi\n\t ld8 r3 = [%[pb]]\n\t ld8 r2 = [%[pa]]\n\t nop.i 0\n\t}\n\t"
+        ";;\n\t"
+        "{ .mmi\n\t ld8 r11 = [%[pa1]]\n\t ld8 r10 = [%[pb2]]\n\t nop.i 0\n\t}\n\t"
+        ";;\n\t"
