+    out[ 0] = padd2_sss(e[0], t15a_c);
+    out[ 1] = padd2_sss(e[1], t14_c);
+    out[ 2] = padd2_sss(e[2], t13a_d);
+    out[ 3] = padd2_sss(e[3], t12_d);
+    out[ 4] = padd2_sss(e[4], t11_d);
+    out[ 5] = padd2_sss(e[5], t10a_d);
+    out[ 6] = padd2_sss(e[6], t9_c);
+    out[ 7] = padd2_sss(e[7], t8a_c);
+    out[ 8] = psub2_sss(e[7], t8a_c);
+    out[ 9] = psub2_sss(e[6], t9_c);
+    out[10] = psub2_sss(e[5], t10a_d);
+    out[11] = psub2_sss(e[4], t11_d);
+    out[12] = psub2_sss(e[3], t12_d);
+    out[13] = psub2_sss(e[2], t13a_d);
+    out[14] = psub2_sss(e[1], t14_c);
+    out[15] = psub2_sss(e[0], t15a_c);
+}
