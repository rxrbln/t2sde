+        t9a  = itx_mul1(in[7], ITXC(-2598), 12);
+        t10a = itx_mul1(in[5], ITXC( 1931), 12);
+        t11a = itx_mul1(in[3], ITXC(-1189), 12);
+        t12a = itx_mul1(in[3], ITXC( 3920), 12);
+        t13a = itx_mul1(in[5], ITXC( 3612), 12);
