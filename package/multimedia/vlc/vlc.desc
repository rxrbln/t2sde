[E] opt libcddb
[E] opt libdc1394
[E] opt libdvbpsi
[E] opt libdvdnav
[E] opt libidn
[E] opt libmad
[E] opt libmodplug
[E] opt libmpcdec
[E] opt libnfs
[E] opt libnotify
[E] opt libopus
[E] opt libraw1394
[E] opt librist
[E] opt libsamplerate
[E] opt libsecret
[E] opt libshout
[E] opt libsrt
[E] opt libupnp
[E] opt libvpx
[E] opt libxext
[E] opt libzvbi
[E] opt live
