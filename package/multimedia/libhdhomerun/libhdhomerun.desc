[D] 86cb80c5eedec4dea7144a5b5f4630d0f6c87e7e60ddff4b9cb0c653 libhdhomerun_20260326.tgz http://download.silicondust.com/hdhomerun/

libhdhomerun_install() {
	install -Dm755 hdhomerun_config $root$bindir/hdhomerun_config
	install -Dm755 libhdhomerun.so $root$libdir/libhdhomerun.so
	mkdir -p $root$includedir/libhdhomerun
	install -m644 *.h $root$includedir/libhdhomerun/
}
hook_add postmake 5 libhdhomerun_install
