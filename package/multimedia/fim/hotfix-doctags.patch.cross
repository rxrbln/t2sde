Build doctags with the build host compiler.

diff -Nrup a/doc/Makefile.in b/doc/Makefile.in
--- a/doc/Makefile.in	2026-09-30 08:42:20.000000000 +0200
+++ b/doc/Makefile.in	2026-10-22 17:22:42.818010016 +0200
@@ -727,7 +727,7 @@ fimgs.man.html: fimgs.man tags
 @WITH_PERL_TRUE@	if test ! -s $@ ; then $(MANTOTXT) ./$< > $<.txt && $(PERL) $(srcdir)/vim2html.pl tags $<.txt && mv $<.txt.html $@ ; fi
 
 doctags$(EXEEXT): doctags.c
-	$(CC) $(CFLAGS) $(CPPFLAGS) $(LDFLAGS) -o $@ $<
+	$(CC_FOR_BUILD) -o $@ $<
 
 #clean:
 #	        $(RM) -f  doctags.o doctags$(EXEEXT) FIM.html tags fim-stylesheet.css fim.man.html fimgs.man.html
