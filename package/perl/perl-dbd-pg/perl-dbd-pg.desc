[I] The PostgresSQL Perl (DBI/DBD) Driver

[T] This is the Perl (DBI) Driver for accessing PostgreSQL.

[U] https://metacpan.org/pod/DBD::Pg

[A] Bruce Momjian
[A] David Wheeler
[M] René Rebe <rene@exactco.de>

[C] extra/database
[F] CROSS

[L] GPL
[V] 3.21.2
[P] X -----5---9 176.200

[D] 82a27a9919e14b4463131965194d344c926e114dec1758576d6f5355 DBD-Pg-3.21.2.tar.gz https://cpan.metacpan.org/authors/id/T/TU/TURNSTEP/

var_append GCC_WRAPPER_APPEND ' ' -std=gnu11

if atstage cross; then
	pkgprefix -t postgresql
	pgdir=$root/$(pkgprefix postgresql)
	# the target pg_config can not run, answer the queries used by Makefile.PL
	pg_config_cross() {
		mkdir -p cross-bin
		cat > cross-bin/pg_config <<-EOT
		#!/bin/sh
		case "\$1" in
		--version) echo "PostgreSQL $(sed -n 's/^#define PG_VERSION "\(.*\)"/\1/p' $pgdir/include/pg_config.h)" ;;
		--includedir) echo $pgdir/include ;;
		--libdir) echo $pgdir/lib ;;
		--bindir) echo $pgdir/bin ;;
		esac
		EOT
		chmod +x cross-bin/pg_config
		export PATH="$PWD/cross-bin:$PATH"
	}
	hook_add preconf 5 pg_config_cross
fi
