[M] René Rebe <rene@exactco.de>

[C] extra/development
[F] CROSS

[L] Artistic GPL
[V] 0.4234
[P] X -----5---9 140.600

[D] 723f5e5ce539cf292008f8a5521f91b33c4f236a7eaf26b40284546c Module-Build-0.4234.tar.gz https://cpan.metacpan.org/authors/id/L/LE/LEONT/

if atstage cross; then
	# the Makefile.PL pass-through can not be redirected to the target paths
	mb_cross_build() {
		local k v args=
		for k in installprivlib installarchlib installbin installscript installman1dir installman3dir; do
			v=$(perl -MConfig -e "print \$Config{$k}")
			args="$args --config $k=${v#$root/TOOLCHAIN/cross}"
		done
		perl Build.PL --installdirs core $args
		perl Build
		perl Build install --destdir $root
	}
	runmkpl=0 runmake=0
	hook_add premake 5 mb_cross_build
fi
