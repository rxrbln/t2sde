+	fst.q	%f12,-32(%r19)
+	fst.q	%f16,-48(%r19)
+	fst.q	%f20,-64(%r19)
+	adds	-64,%r17,%r17
+	adds	-64,%r19,%r19
+	adds	-64,%r18,%r18
+	subu	63,%r18,%r0
+	bnc	.Lbq64
+.Lbq16:
