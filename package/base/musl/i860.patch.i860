new file mode 100644
index 00000000..4c7050bd
--- /dev/null
+++ b/arch/i860/reloc.h
@@ -0,0 +1,16 @@
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#define LDSO_ARCH "i860"
+
+#define TPOFF_K 0
+
+#define REL_SYMBOLIC    R_860_32
+#define REL_GOT         R_860_GLOB_DAT
+#define REL_PLT         R_860_JUMP_SLOT
+#define REL_RELATIVE    R_860_RELATIVE
+#define REL_COPY        R_860_COPY
+#define REL_DTPMOD      R_860_TLS_DTPMOD32
+#define REL_DTPOFF      R_860_TLS_DTPOFF32
+#define REL_TPOFF       R_860_TLS_TPOFF32
+
+#define CRTJMP(pc,sp) __asm__ __volatile__( \
+	"mov %1,%%sp\n\tbri %0\n\tnop" : : "r"(pc), "r"(sp) : "memory" )
diff --git a/arch/i860/syscall_arch.h b/arch/i860/syscall_arch.h
new file mode 100644
index 00000000..0b918f4c
--- /dev/null
+++ b/arch/i860/syscall_arch.h
@@ -0,0 +1,88 @@
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+/*
+ * i860 Linux syscalls: "trap r0,r0,r0", number in r28, arguments in
+ * r16-r21, result in r16. All other registers are preserved; r28 may be
+ * changed by a restarted syscall. 64-bit arguments occupy two
+ * consecutive registers, low word first, without alignment.
+ */
+#define __SYSCALL_LL_E(x) \
+((union { long long ll; long l[2]; }){ .ll = x }).l[0], \
+((union { long long ll; long l[2]; }){ .ll = x }).l[1]
+#define __SYSCALL_LL_O(x) __SYSCALL_LL_E((x))
+
+#define __asm_syscall(...) \
+	__asm__ __volatile__ ("trap %%r0,%%r0,%%r0" \
+	: "+r"(r16), "+r"(r28) : __VA_ARGS__ : "memory"); \
+	return r16;
+
+static inline long __syscall0(long n)
+{
+	register long r28 __asm__("r28") = n;
+	register long r16 __asm__("r16");
+	__asm__ __volatile__ ("trap %%r0,%%r0,%%r0"
+		: "=r"(r16), "+r"(r28) : : "memory");
+	return r16;
+}
+
+static inline long __syscall1(long n, long a)
+{
+	register long r28 __asm__("r28") = n;
+	register long r16 __asm__("r16") = a;
+	__asm_syscall()
+}
+
+static inline long __syscall2(long n, long a, long b)
+{
+	register long r28 __asm__("r28") = n;
+	register long r16 __asm__("r16") = a;
+	register long r17 __asm__("r17") = b;
+	__asm_syscall("r"(r17))
+}
+
+static inline long __syscall3(long n, long a, long b, long c)
+{
+	register long r28 __asm__("r28") = n;
+	register long r16 __asm__("r16") = a;
+	register long r17 __asm__("r17") = b;
+	register long r18 __asm__("r18") = c;
+	__asm_syscall("r"(r17), "r"(r18))
+}
+
+static inline long __syscall4(long n, long a, long b, long c, long d)
+{
+	register long r28 __asm__("r28") = n;
+	register long r16 __asm__("r16") = a;
+	register long r17 __asm__("r17") = b;
+	register long r18 __asm__("r18") = c;
+	register long r19 __asm__("r19") = d;
+	__asm_syscall("r"(r17), "r"(r18), "r"(r19))
+}
+
+static inline long __syscall5(long n, long a, long b, long c, long d, long e)
+{
+	register long r28 __asm__("r28") = n;
+	register long r16 __asm__("r16") = a;
+	register long r17 __asm__("r17") = b;
+	register long r18 __asm__("r18") = c;
+	register long r19 __asm__("r19") = d;
+	register long r20 __asm__("r20") = e;
+	__asm_syscall("r"(r17), "r"(r18), "r"(r19), "r"(r20))
+}
+
+static inline long __syscall6(long n, long a, long b, long c, long d, long e, long f)
+{
+	register long r28 __asm__("r28") = n;
+	register long r16 __asm__("r16") = a;
+	register long r17 __asm__("r17") = b;
+	register long r18 __asm__("r18") = c;
+	register long r19 __asm__("r19") = d;
+	register long r20 __asm__("r20") = e;
+	register long r21 __asm__("r21") = f;
+	__asm_syscall("r"(r17), "r"(r18), "r"(r19), "r"(r20), "r"(r21))
+}
+
+#define IPC_64 0
+
+#define VDSO_USEFUL
+#define VDSO_CGT_SYM "__vdso_clock_gettime"
+#define VDSO_CGT_VER "LINUX_2.6"
