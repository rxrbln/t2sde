diff --git a/arch/i860/bits/user.h b/arch/i860/bits/user.h
new file mode 100644
index 00000000..24f0a197
--- /dev/null
+++ b/arch/i860/bits/user.h
@@ -0,0 +1 @@
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
diff --git a/arch/i860/crt_arch.h b/arch/i860/crt_arch.h
new file mode 100644
index 00000000..99097589
--- /dev/null
+++ b/arch/i860/crt_arch.h
@@ -0,0 +1,20 @@
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+__asm__(
+".text\n"
+".global " START "\n"
+".type " START ",@function\n"
+START ":\n"
+"	mov %r0,%fp\n"
+"	mov %sp,%r16\n"
+#ifdef SHARED
+/* Nothing is relocated yet: find _DYNAMIC relative to the PC (r1 after call) */
+"	call 1f\n"
+"	nop\n"
+"1:	orh [_DYNAMIC]@pc@ha,%r0,%r17\n"
+"	adds [_DYNAMIC+4]@pc@l,%r17,%r17\n"
+"	addu %r1,%r17,%r17\n"
+#endif
+"	andnot 15,%sp,%sp\n"
+"	call " START "_c\n"
+"	mov %r0,%r1\n"
+);
diff --git a/arch/i860/kstat.h b/arch/i860/kstat.h
new file mode 100644
index 00000000..24f0a197
