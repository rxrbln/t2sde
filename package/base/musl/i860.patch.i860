+	or	%r20,%r17,%r17		# byte replicated into a word
+	subu	15,%r18,%r0		# CC = n < 16
+	bc	.Lbytes
+
+.Lhead:
+	and	15,%r19,%r0
+	bc	.Lq
+	st.b	%r17,0(%r19)
+	addu	1,%r19,%r19
+	br	.Lhead
+	adds	-1,%r18,%r18
+
+.Lq:
+	ixfr	%r17,%f8
+	ixfr	%r17,%f9
+	ixfr	%r17,%f10
+	ixfr	%r17,%f11
+	subu	63,%r18,%r0		# CC = n < 64
+	bc	.Lq16
+.Lq64:
+	fst.q	%f8,0(%r19)
+	fst.q	%f8,16(%r19)
+	fst.q	%f8,32(%r19)
+	fst.q	%f8,48(%r19)
+	addu	64,%r19,%r19
+	adds	-64,%r18,%r18
+	subu	63,%r18,%r0
+	bnc	.Lq64
+.Lq16:
+	subu	15,%r18,%r0
+	bc	.Lwords
+	fst.q	%f8,0(%r19)
+	addu	16,%r19,%r19
+	br	.Lq16
+	adds	-16,%r18,%r18
+
+	# the cursor is 16-byte aligned here
+.Lwords:
+	subu	3,%r18,%r0		# CC = n < 4
+	bc	.Lbytes
+	st.l	%r17,0(%r19)
+	addu	4,%r19,%r19
+	br	.Lwords
+	adds	-4,%r18,%r18
+
+.Lbytes:
+	bte	0,%r18,2f
+1:	st.b	%r17,0(%r19)
