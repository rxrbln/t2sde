diff --git a/src/time/i860/time.c b/src/time/i860/time.c
new file mode 100644
index 00000000..fe574d25
--- /dev/null
+++ b/src/time/i860/time.c
@@ -0,0 +1,14 @@
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+#include <time.h>
+#include "syscall.h"
+
+/* Only the coarse clock needs no system call here, as the timer is not readable from user mode. */
+int __clock_gettime(clockid_t, struct timespec *);
+
+time_t time(time_t *t)
+{
+	struct timespec ts;
+	__clock_gettime(CLOCK_REALTIME_COARSE, &ts);
+	if (t) *t = ts.tv_sec;
+	return ts.tv_sec;
+}
