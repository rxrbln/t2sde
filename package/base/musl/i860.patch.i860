diff --git a/src/ldso/i860/dlsym.s b/src/ldso/i860/dlsym.s
new file mode 100644
index 00000000..2c4187cf
--- /dev/null
+++ b/src/ldso/i860/dlsym.s
@@ -0,0 +1,10 @@
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+# The caller's address selects the library search scope. A PLT entry has
+# already restored r1 when it gets here.
+.global dlsym
+.hidden __dlsym
+.type dlsym,@function
+.align 8
+dlsym:
+	br	__dlsym
+	mov	%r1,%r18
diff --git a/src/setjmp/i860/longjmp.s b/src/setjmp/i860/longjmp.s
new file mode 100644
index 00000000..481fcb13
--- /dev/null
+++ b/src/setjmp/i860/longjmp.s
@@ -0,0 +1,34 @@
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+.global _longjmp
+.global longjmp
+.type _longjmp,@function
+.type longjmp,@function
+.align 8
+_longjmp:
+longjmp:
+	mov	%r17,%r18
+	btne	0,%r18,1f
+	or	1,%r0,%r18
+1:	ld.l	4(%r16),%sp
+	ld.l	8(%r16),%fp
+	ld.l	12(%r16),%r4
+	ld.l	16(%r16),%r5
+	ld.l	20(%r16),%r6
+	ld.l	24(%r16),%r7
+	ld.l	28(%r16),%r8
+	ld.l	32(%r16),%r9
+	ld.l	36(%r16),%r10
+	ld.l	40(%r16),%r11
+	ld.l	44(%r16),%r12
+	ld.l	48(%r16),%r13
+	ld.l	52(%r16),%r14
+	ld.l	56(%r16),%r15
+	fld.l	60(%r16),%f2
+	fld.l	64(%r16),%f3
+	fld.l	68(%r16),%f4
+	fld.l	72(%r16),%f5
+	fld.l	76(%r16),%f6
+	fld.l	80(%r16),%f7
+	ld.l	0(%r16),%r1
+	bri	%r1
+	mov	%r18,%r16
diff --git a/src/setjmp/i860/setjmp.s b/src/setjmp/i860/setjmp.s
new file mode 100644
index 00000000..0f19c0eb
--- /dev/null
+++ b/src/setjmp/i860/setjmp.s
@@ -0,0 +1,35 @@
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+# jmp_buf: r1, sp, fp, r4-r15, f2-f7 (the callee-saved state)
+.global __setjmp
+.global _setjmp
+.global setjmp
+.type __setjmp,@function
+.type _setjmp,@function
+.type setjmp,@function
+.align 8
+__setjmp:
+_setjmp:
+setjmp:
+	st.l	%r1,0(%r16)
+	st.l	%sp,4(%r16)
+	st.l	%fp,8(%r16)
+	st.l	%r4,12(%r16)
+	st.l	%r5,16(%r16)
+	st.l	%r6,20(%r16)
+	st.l	%r7,24(%r16)
+	st.l	%r8,28(%r16)
+	st.l	%r9,32(%r16)
+	st.l	%r10,36(%r16)
+	st.l	%r11,40(%r16)
+	st.l	%r12,44(%r16)
+	st.l	%r13,48(%r16)
+	st.l	%r14,52(%r16)
+	st.l	%r15,56(%r16)
+	fst.l	%f2,60(%r16)
+	fst.l	%f3,64(%r16)
+	fst.l	%f4,68(%r16)
+	fst.l	%f5,72(%r16)
+	fst.l	%f6,76(%r16)
+	fst.l	%f7,80(%r16)
+	bri	%r1
+	mov	%r0,%r16
diff --git a/src/signal/i860/restore.s b/src/signal/i860/restore.s
new file mode 100644
index 00000000..54dcf07f
--- /dev/null
+++ b/src/signal/i860/restore.s
@@ -0,0 +1,12 @@
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+.global __restore
+.hidden __restore
+.type __restore,@function
+.global __restore_rt
+.hidden __restore_rt
+.type __restore_rt,@function
+.align 8
+__restore:
+__restore_rt:
+	or	139,%r0,%r28		# SYS_rt_sigreturn
+	trap	%r0,%r0,%r0
diff --git a/src/signal/i860/sigsetjmp.s b/src/signal/i860/sigsetjmp.s
new file mode 100644
index 00000000..ba740e84
--- /dev/null
+++ b/src/signal/i860/sigsetjmp.s
@@ -0,0 +1,25 @@
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+# __fl (offset 88) and __ss[2] (offset 100) of the sigjmp_buf hold r1 and r4
+# across setjmp; __sigsetjmp_tail only uses __ss[0..1].
+.global sigsetjmp
+.global __sigsetjmp
+.type sigsetjmp,@function
+.type __sigsetjmp,@function
+.align 8
+sigsetjmp:
+__sigsetjmp:
+	btne	0,%r17,1f
+	br	setjmp
+	nop
+1:	st.l	%r1,88(%r16)
+	st.l	%r4,100(%r16)
+	call	setjmp
+	mov	%r16,%r4
+
+	mov	%r16,%r17
+	mov	%r4,%r16
+	ld.l	100(%r16),%r4
+	ld.l	88(%r16),%r1
+.hidden __sigsetjmp_tail
+	br	__sigsetjmp_tail
+	nop
diff --git a/src/string/i860/memcpy.s b/src/string/i860/memcpy.s
new file mode 100644
index 00000000..049905e4
--- /dev/null
+++ b/src/string/i860/memcpy.s
@@ -0,0 +1,209 @@
+# Copyright (C) 2026 René Rebe <rene@exactco.de>
+# Generated by tmp/musl/gen-string.py from the kernel arch/i860/lib.
+.text
+# void *memcpy(void *dst = r16, const void *src = r17, size_t n = r18)
+.global memcpy
+.global __memcpy_fwd
+.hidden __memcpy_fwd
+.type memcpy,@function
+.align 8
+memcpy:
+	mov	%r16,%r19		# r19 = d, r16 is returned
+__memcpy_fwd:
+	xor	%r19,%r17,%r20
+	subu	15,%r18,%r0		# CC = n < 16
+	bc	.Lfsmall
+	and	15,%r20,%r0		# CC = d, s equally aligned mod 16
+	bnc	.Lf8
+
+	# bytes up to a 16-byte boundary
+.Lfhead16:
+	and	15,%r19,%r0
+	bc	.Lfq
+	ld.b	0(%r17),%r20
+	st.b	%r20,0(%r19)
+	addu	1,%r17,%r17
+	addu	1,%r19,%r19
+	br	.Lfhead16
+	adds	-1,%r18,%r18
+
+.Lfq:
+	subu	63,%r18,%r0		# CC = n < 64
+	bc	.Lfq16
+.Lfq64:
+	fld.q	0(%r17),%f8
+	fld.q	16(%r17),%f12
+	fld.q	32(%r17),%f16
+	fld.q	48(%r17),%f20
+	fst.q	%f8,0(%r19)
+	fst.q	%f12,16(%r19)
+	fst.q	%f16,32(%r19)
+	fst.q	%f20,48(%r19)
+	addu	64,%r17,%r17
+	addu	64,%r19,%r19
+	adds	-64,%r18,%r18
+	subu	63,%r18,%r0
+	bnc	.Lfq64
+.Lfq16:
+	subu	15,%r18,%r0
+	bc	.Lfbytes
+	fld.q	0(%r17),%f8
+	fst.q	%f8,0(%r19)
+	addu	16,%r17,%r17
+	addu	16,%r19,%r19
+	br	.Lfq16
+	adds	-16,%r18,%r18
+
+	# doublewords
+.Lf8:
+	and	7,%r20,%r0		# CC = equally aligned mod 8
+	bnc	.Lf4
+.Lfhead8:
+	and	7,%r19,%r0
+	bc	.Lfd32
+	ld.b	0(%r17),%r20
+	st.b	%r20,0(%r19)
+	addu	1,%r17,%r17
+	addu	1,%r19,%r19
+	br	.Lfhead8
+	adds	-1,%r18,%r18
+.Lfd32:
+	subu	31,%r18,%r0		# CC = n < 32
+	bc	.Lfd
+	fld.d	0(%r17),%f8
+	fld.d	8(%r17),%f10
+	fld.d	16(%r17),%f12
+	fld.d	24(%r17),%f14
+	fst.d	%f8,0(%r19)
+	fst.d	%f10,8(%r19)
+	fst.d	%f12,16(%r19)
+	fst.d	%f14,24(%r19)
+	addu	32,%r17,%r17
+	addu	32,%r19,%r19
+	br	.Lfd32
+	adds	-32,%r18,%r18
+.Lfd:
+	subu	7,%r18,%r0		# CC = n < 8
+	bc	.Lfbytes
+	fld.d	0(%r17),%f8
+	fst.d	%f8,0(%r19)
+	addu	8,%r17,%r17
+	addu	8,%r19,%r19
+	br	.Lfd
+	adds	-8,%r18,%r18
+
+	# words
+.Lfsmall:
+	subu	3,%r18,%r0		# CC = n < 4
+	bc	.Lfbytes
+.Lf4:
+	and	3,%r20,%r0		# CC = equally aligned mod 4
+	bnc	.Lfmerge
+.Lfhead4:
+	and	3,%r19,%r0
+	bc	.Lfw32
+	ld.b	0(%r17),%r20
+	st.b	%r20,0(%r19)
+	addu	1,%r17,%r17
+	addu	1,%r19,%r19
+	br	.Lfhead4
+	adds	-1,%r18,%r18
+.Lfw32:
+	subu	31,%r18,%r0		# CC = n < 32
+	bc	.Lfw
+	ld.l	0(%r17),%r20
+	ld.l	4(%r17),%r21
+	ld.l	8(%r17),%r22
+	ld.l	12(%r17),%r23
+	ld.l	16(%r17),%r24
+	ld.l	20(%r17),%r25
+	ld.l	24(%r17),%r26
+	ld.l	28(%r17),%r27
+	st.l	%r20,0(%r19)
+	st.l	%r21,4(%r19)
+	st.l	%r22,8(%r19)
+	st.l	%r23,12(%r19)
+	st.l	%r24,16(%r19)
+	st.l	%r25,20(%r19)
+	st.l	%r26,24(%r19)
+	st.l	%r27,28(%r19)
+	addu	32,%r17,%r17
+	addu	32,%r19,%r19
+	br	.Lfw32
+	adds	-32,%r18,%r18
+.Lfw:
+	subu	3,%r18,%r0		# CC = n < 4
+	bc	.Lfbytes
+	ld.l	0(%r17),%r20
+	st.l	%r20,0(%r19)
+	addu	4,%r17,%r17
+	addu	4,%r19,%r19
+	br	.Lfw
+	adds	-4,%r18,%r18
+
+		# Different alignment mod 4: aligned words of the source, shifted into
+	# place. Only words holding bytes to copy are read, so no fault past
+	# the end of the source.
+.Lfmerge:
+	subu	15,%r18,%r0		# CC = n < 16
+	bc	.Lfbytes
+.Lfmhead:
+	and	3,%r19,%r0
+	bc	.Lfmgo
+	ld.b	0(%r17),%r20
+	st.b	%r20,0(%r19)
+	addu	1,%r17,%r17
+	addu	1,%r19,%r19
+	br	.Lfmhead
+	adds	-1,%r18,%r18
+.Lfmgo:
+	and	3,%r17,%r21
+	shl	3,%r21,%r21		# bits to shift right
+	or	32,%r0,%r22
+	subu	%r22,%r21,%r22		# bits to shift left
+	andnot	3,%r17,%r17
+	ld.l	0(%r17),%r20
+.Lfm16:
+	subu	15,%r18,%r0		# CC = n < 16
+	bc	.Lfmend
+	ld.l	4(%r17),%r23
+	ld.l	8(%r17),%r24
+	ld.l	12(%r17),%r25
+	ld.l	16(%r17),%r26
+	shr	%r21,%r20,%r20
+	shl	%r22,%r23,%r27
+	or	%r27,%r20,%r20
+	st.l	%r20,0(%r19)
+	shr	%r21,%r23,%r23
+	shl	%r22,%r24,%r27
+	or	%r27,%r23,%r23
+	st.l	%r23,4(%r19)
+	shr	%r21,%r24,%r24
+	shl	%r22,%r25,%r27
+	or	%r27,%r24,%r24
+	st.l	%r24,8(%r19)
+	shr	%r21,%r25,%r25
+	shl	%r22,%r26,%r27
+	or	%r27,%r25,%r25
+	st.l	%r25,12(%r19)
+	mov	%r26,%r20
+	addu	16,%r17,%r17
+	addu	16,%r19,%r19
+	br	.Lfm16
+	adds	-16,%r18,%r18
+.Lfmend:
+	shr	3,%r21,%r21
