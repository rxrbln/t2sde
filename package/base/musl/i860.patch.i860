diff --git a/arch/i860/pthread_arch.h b/arch/i860/pthread_arch.h
new file mode 100644
index 00000000..8ccf6b62
--- /dev/null
+++ b/arch/i860/pthread_arch.h
@@ -0,0 +1,10 @@
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+/* r30 is the thread pointer of the i860 Linux ABI (fixed in the compiler) */
+static inline uintptr_t __get_tp()
+{
+	uintptr_t tp;
+	__asm__ ("mov %%r30,%0" : "=r"(tp));
+	return tp;
+}
+
+#define MC_PC __fir
