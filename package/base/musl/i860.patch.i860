diff --git a/arch/i860/atomic_arch.h b/arch/i860/atomic_arch.h
new file mode 100644
index 00000000..ee8c51ec
--- /dev/null
+++ b/arch/i860/atomic_arch.h
@@ -0,0 +1,33 @@
+/* Copyright (C) 2026 René Rebe <rene@exactco.de> */
+/*
+ * Compare-and-swap in a lock/unlock interlocked sequence: the bus stays
+ * locked and interrupts are held off from the load until the access after
+ * unlock. A trap inside the sequence makes the kernel restart it at the
+ * lock instruction (EPSR.IL).
+ */
+#define a_cas a_cas
+static inline int a_cas(volatile int *p, int t, int s)
+{
+	int old;
+
+	__asm__ __volatile__ (
+		"lock\n\t"
+		"ld.l 0(%1),%0\n\t"
+		"xor %0,%2,%%r0\n\t"
+		"bnc 1f\n\t"
+		"unlock\n\t"
+		"st.l %3,0(%1)\n\t"
+		"br 2f\n\t"
+		"nop\n"
+		"1:\tunlock\n\t"
+		"ld.l 0(%1),%%r0\n"
+		"2:"
+		: "=&r"(old) : "r"(p), "r"(t), "r"(s) : "memory");
+	return old;
+}
+
+#define a_barrier a_barrier
+static inline void a_barrier()
+{
+	__asm__ __volatile__ ("" : : : "memory");
+}
