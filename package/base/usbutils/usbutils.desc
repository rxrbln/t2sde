[I] Linux USB Utilities

[T] This package contains various utilities for inspecting and
[T] setting of devices connected to the USB bus. Requires a kernel
[T] version including usbdevfs support - and this usbdevfs mounted
[T] to /proc/bus/usb.

[U] http://www.linux-usb.org/

[A] Thomas Sailer <sailer@ife.ee.ethz.ch>
[M] René Rebe <rene@exactco.de>

[C] base/system

[F] CROSS AUTOMAKE-QUIRK LATOMIC.sparc

[L] GPL
[V] 020

[D] 0db599d4ffce523af25c0ffba725b2bdf0ca21d59f28b8db2d2cecfb usbutils-020.tar.xz https://www.kernel.org/pub/linux/utils/usb/usbutils/

atstage native || hook_add preconf 5 "echo 'ac_cv_func_malloc_0_nonnull=yes' >> config.cache"
var_append confopt ' ' --disable-usbids
hook_add postmake 5 "ln -sfv hwdata/usb.ids $root$datadir/"
