+      shr.u         GR_p_X_Sgnd    = GR_p_X_Sgnd, 60
+                                       // Obtain only 4 bits of significand
+}
+{ .mfi
+      nop.m        0
+      nop.f        0
+      add          GR_p_Bias           = 0xffff, r0 // Set bias
+};;
+
+{ .mfi
