From b971d8c74a75d18550466c0e4e5e1a31fd5585ba Mon Sep 17 00:00:00 2001
From: Johnny Mnemonic <jm@machine-hall.org>
Date: Wed, 12 Mar 2025 22:40:10 +0100
Subject: [PATCH 26/44] Revert "elf: Move _dl_rtld_map, _dl_rtld_audit_state
 out of GL"

This reverts commit ef5823d955dd7e6b4ffed9f3a8455d131cd7a737.

706209867f1ba89c458033408d419e92d8055f58 also needs adaptations due to
the prior changes.

Unbreaks `ld.so` on ia64.
---
 elf/dl-load.c              |  10 +--
 elf/rtld.c                 | 123 ++++++++++++++++++-------------------
 elf/setup-vdso.h           |   4 +-
 sysdeps/generic/ldsodefs.h |  19 +++---
 4 files changed, 78 insertions(+), 78 deletions(-)

diff --git a/elf/dl-load.c b/elf/dl-load.c
index 95404adae94..48182404db1 100644
--- a/elf/dl-load.c
+++ b/elf/dl-load.c
@@ -751,7 +751,7 @@ _dl_init_paths (const char *llp, const char *source,
   l = GL(dl_ns)[LM_ID_BASE]._ns_loaded;
 #ifdef SHARED
   if (l == NULL)
-    l = &_dl_rtld_map;
+    l = &GL (dl_rtld_map);
 #endif
   assert (l->l_type != lt_loaded);
 
@@ -1189,8 +1189,8 @@ _dl_map_object_from_fd (const char *name, const char *origname, int fd,
   /* When loading into a namespace other than the base one we must
      avoid loading ld.so since there can only be one copy.  Ever.  */
   if (__glibc_unlikely (nsid != LM_ID_BASE)
-      && (_dl_file_id_match_p (&id, &_dl_rtld_map.l_file_id)
-	  || _dl_name_match_p (name, &_dl_rtld_map)))
+      && (_dl_file_id_match_p (&id, &GL(dl_rtld_map).l_file_id)
