+//
+//
+
+#include "libm_support.h"
+
+double __libm_ldexp(double, int, int);
+
+
+double ldexp(double x, int n)
+{
+
+#ifdef SIZE_INT_64
+   return __libm_ldexp(x,n,1);
+#else
+
+#ifdef SIZE_INT_32
+   return __libm_ldexp(x,n,0);
+#endif
+
+#endif
+
+}
+libm_alias_double_other (ldexp, ldexp)
