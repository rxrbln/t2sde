+
+#ifndef __ARCH_I860_DEFS_H
+#define __ARCH_I860_DEFS_H
+
+#define REG_RA		1
+#define REG_SP		2
+#define REG_FP		3
+#define REG_LINK	15	/* callee saved: uc_link for the trampoline */
+#define REG_A0		16
+#define NARG_REGS	12	/* r16-r27 */
+
+/* offsets in ucontext_t, checked by the test: gregs, fpregs, fir, and the mask */
+#define G1		24
+#define G2		28
+#define G3		32
+#define G4		36
+#define G5		40
+#define G6		44
+#define G7		48
+#define G8		52
+#define G9		56
+#define G10		60
+#define G11		64
+#define G12		68
+#define G13		72
+#define G14		76
+#define G15		80
+#define G16		84
+#define G17		88
+#define G18		92
+#define G19		96
+#define G20		100
+#define G21		104
+#define G22		108
+#define G23		112
+#define G24		116
+#define G25		120
+#define G26		124
+#define G27		128
+#define F2		156
+#define F3		160
+#define F4		164
+#define F5		168
+#define F6		172
+#define F7		176
+#define FIR		284
+#define SIGMASK		424
+
+#define NR_RT_SIGPROCMASK	135
+#define SIG_SETMASK_	2
+#define SIGSET_BYTES	8
+
+#ifdef __ASSEMBLER__
+	.macro	SAVE_CONTEXT base
+	st.l	%r1,G1(\base)
+	st.l	%r1,FIR(\base)
+	st.l	%sp,G2(\base)
+	st.l	%fp,G3(\base)
+	st.l	%r4,G4(\base)
+	st.l	%r5,G5(\base)
+	st.l	%r6,G6(\base)
+	st.l	%r7,G7(\base)
+	st.l	%r8,G8(\base)
+	st.l	%r9,G9(\base)
+	st.l	%r10,G10(\base)
+	st.l	%r11,G11(\base)
+	st.l	%r12,G12(\base)
+	st.l	%r13,G13(\base)
+	st.l	%r14,G14(\base)
+	st.l	%r15,G15(\base)
+	st.l	%r0,G16(\base)
+	fst.l	%f2,F2(\base)
+	fst.l	%f3,F3(\base)
+	fst.l	%f4,F4(\base)
+	fst.l	%f5,F5(\base)
+	fst.l	%f6,F6(\base)
+	fst.l	%f7,F7(\base)
+	.endm
+
+	/* r29 = the context; r16 last, in the slot of the jump through r31 */
+	.macro	RESTORE_CONTEXT
+	fld.l	F2(%r29),%f2
+	fld.l	F3(%r29),%f3
+	fld.l	F4(%r29),%f4
+	fld.l	F5(%r29),%f5
+	fld.l	F6(%r29),%f6
+	fld.l	F7(%r29),%f7
+	ld.l	G1(%r29),%r1
+	ld.l	G2(%r29),%sp
+	ld.l	G3(%r29),%fp
+	ld.l	G4(%r29),%r4
+	ld.l	G5(%r29),%r5
+	ld.l	G6(%r29),%r6
+	ld.l	G7(%r29),%r7
+	ld.l	G8(%r29),%r8
+	ld.l	G9(%r29),%r9
+	ld.l	G10(%r29),%r10
+	ld.l	G11(%r29),%r11
+	ld.l	G12(%r29),%r12
+	ld.l	G13(%r29),%r13
+	ld.l	G14(%r29),%r14
+	ld.l	G15(%r29),%r15
+	ld.l	G17(%r29),%r17
+	ld.l	G18(%r29),%r18
+	ld.l	G19(%r29),%r19
+	ld.l	G20(%r29),%r20
+	ld.l	G21(%r29),%r21
+	ld.l	G22(%r29),%r22
+	ld.l	G23(%r29),%r23
+	ld.l	G24(%r29),%r24
+	ld.l	G25(%r29),%r25
+	ld.l	G26(%r29),%r26
+	ld.l	G27(%r29),%r27
+	ld.l	FIR(%r29),%r31
+	bri	%r31
+	ld.l	G16(%r29),%r16
+	.endm
+#endif
+
+#include "common-defs.h"
+
+#endif
