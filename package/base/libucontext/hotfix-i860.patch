+ * implied.  In no event shall the authors be liable for any damages arising
+ * from the use of this software.
+ */
+
+#ifndef LIBUCONTEXT_BITS_H
+#define LIBUCONTEXT_BITS_H
+
+typedef unsigned long libucontext_greg_t;
+
+typedef struct {
+	unsigned long __gregs[32];
+	unsigned long __fpregs[32];
+	unsigned long __psr, __epsr, __fir, __fsr;
+	unsigned long __oldmask;
+	unsigned long __fp_pipe[32];
+} libucontext_mcontext_t;
+
+typedef struct {
+	void *ss_sp;
+	int ss_flags;
+	size_t ss_size;
+} libucontext_stack_t;
+
+typedef struct libucontext_ucontext {
+	unsigned long uc_flags;
+	struct libucontext_ucontext *uc_link;
+	libucontext_stack_t uc_stack;
+	libucontext_mcontext_t uc_mcontext;
+	unsigned long uc_sigmask[128 / sizeof(unsigned long)];
+} libucontext_ucontext_t;
+
+#endif
diff -Nurp a/arch/i860/makecontext.c b/arch/i860/makecontext.c
--- a/arch/i860/makecontext.c	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/i860/makecontext.c	2026-11-02 10:12:39.557857488 +0100
@@ -0,0 +1,50 @@
+/*
+ * Copyright (C) 2026 René Rebe <rene@exactco.de>
+ *
+ * Permission to use, copy, modify, and/or distribute this software for any
+ * purpose with or without fee is hereby granted, provided that the above
+ * copyright notice and this permission notice appear in all copies.
+ *
+ * This software is provided 'as is' and without any warranty, express or
+ * implied.  In no event shall the authors be liable for any damages arising
+ * from the use of this software.
+ */
+
+#include <stddef.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include "defs.h"
+#include <libucontext/libucontext.h>
+
+extern void libucontext_trampoline(void);
+
+void
+libucontext_makecontext(libucontext_ucontext_t *ucp, void (*func)(void), int argc, ...)
+{
+	libucontext_greg_t *sp, *regs = ucp->uc_mcontext.__gregs;
+	va_list va;
+	int i;
+
+	/* arguments past the registers start at sp at the call */
+	sp = (libucontext_greg_t *) ((uintptr_t) ucp->uc_stack.ss_sp + ucp->uc_stack.ss_size);
+	sp -= argc < NARG_REGS ? 0 : argc - NARG_REGS;
+	sp = (libucontext_greg_t *) ((uintptr_t) sp & -16L);
+
+	regs[REG_RA] = (libucontext_greg_t) libucontext_trampoline;
+	regs[REG_SP] = (libucontext_greg_t) sp;
+	regs[REG_FP] = 0;
+	regs[REG_LINK] = (libucontext_greg_t) ucp->uc_link;
+	ucp->uc_mcontext.__fir = (libucontext_greg_t) func;
+
+	va_start(va, argc);
+	for (i = 0; i < argc && i < NARG_REGS; i++)
+		regs[REG_A0 + i] = va_arg(va, libucontext_greg_t);
+	for (; i < argc; i++)
+		*sp++ = va_arg(va, libucontext_greg_t);
+	va_end(va);
+}
+
+#ifdef EXPORT_UNPREFIXED
+extern __typeof(libucontext_makecontext) makecontext __attribute__((weak, __alias__("libucontext_makecontext")));
+extern __typeof(libucontext_makecontext) __makecontext __attribute__((weak, __alias__("libucontext_makecontext")));
+#endif
