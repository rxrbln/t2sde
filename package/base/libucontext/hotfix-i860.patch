+
+ALIAS(setcontext, libucontext_setcontext)
+ALIAS(__setcontext, libucontext_setcontext)
+
+	.text
+FUNC(libucontext_setcontext)
+	mov	%r16,%r29
+	/* rt_sigprocmask(SIG_SETMASK, &ucp->uc_sigmask, NULL, 8) */
+	adds	SIG_SETMASK_,%r0,%r16
+	addu	SIGMASK,%r29,%r17
+	adds	0,%r0,%r18
+	adds	SIGSET_BYTES,%r0,%r19
+	or	NR_RT_SIGPROCMASK,%r0,%r28
+	trap	%r0,%r0,%r0
+	RESTORE_CONTEXT
+END(libucontext_setcontext)
