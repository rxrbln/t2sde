[I] T2 package mirror server

[T] Unofficial server for caching downloads of T2 packages.
[T] Can be used in both a local network for reducing internet traffic,
[T] and on a public server as CDN.

[U] https://github.com/alex-s168/t2-mirror-server

[A] Alexander Nutz <alexandernutz68@gmail.com>
[M] Alexander Nutz <alexandernutz68@gmail.com>

[C] extra/server
[F] CROSS

[E] dep subversion

[L] APL
[V] 1.1.0

[D] d7a4ac70ec6af9bb2be8813a07f2b699d8433e1ea474862908282536 downcache-1.1.0.tar.gz https://github.com/alex-s168/t2-mirror-server/releases/download/1.1.0/

runmake=0

t2_mirror_server_inmake() {
	(cd allib
	 $BUILDCC build.c -DCC="\"$CC\"" -DAR="\"$AR\"" $(CC=$BUILDCC AR=ar build_c/slowdb/build.sh) -o build.exe
	 ./build.exe all.a)
	$CC -o t2-mirror-server *.c C-Http-Server/src/*.c C-Http-Server/thread-pool/*.c \
		allib/build/all.a $(slowdb/build.sh) -lcurl -lcjson -lhocon

	install -Dm755 t2-mirror-server $root$bindir/t2-mirror-server
	install -Dm644 config.hocon.def $root$sysconfdir/t2-mirror-server.hocon
}
hook_add inmake 5 t2_mirror_server_inmake
