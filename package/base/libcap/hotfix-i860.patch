libcap: psx for i860

Signed-off-by: René Rebe <rene@exactco.de>

diff -Nurp a/psx/psx_calls.c b/psx/psx_calls.c
--- a/psx/psx_calls.c	2026-03-12 15:20:26.000000000 +0100
+++ b/psx/psx_calls.c	2026-11-02 10:18:34.815083363 +0100
@@ -50,7 +50,7 @@
     || defined(__alpha__) || defined(__hppa__) || defined(__sh__) \
     || defined(__m68k__) || defined(__sparc__) || defined(__arc__) \
     || defined(__microblaze__) || defined(__or1k__) \
-    || defined(__xtensa__)
+    || defined(__xtensa__) || defined(__i860__)
 
 #undef _NSIG
 #undef _NSIG_BPW
@@ -80,7 +80,7 @@
     || defined(__aarch64__) \
     || defined(__m68k__) || defined(__sh__) \
     || defined(__s390__) || defined(__sparc__) \
-    || defined(__xtensa__)
+    || defined(__xtensa__) || defined(__i860__)
 /* field defined */
 #define _HAS_SA_RESTORER   void *sa_restorer;
 #else
