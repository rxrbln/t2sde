Install the libraries and CMake configs into CMAKE_INSTALL_LIBDIR, and use it
for the install RPATH, instead of the hardcoded lib.

diff -urp a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt	2026-11-06 23:51:25.000000000 +0000
+++ b/CMakeLists.txt	2026-11-25 12:58:59.984446715 +0000
@@ -139,9 +139,9 @@ elseif(APPLE)
     set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)
     set(CMAKE_BUILD_RPATH
         "${CMAKE_BINARY_DIR}/lib"
-        "${CMAKE_INSTALL_PREFIX}/lib")
+        "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_LIBDIR}")
 else()
-    set(CMAKE_INSTALL_RPATH "$ORIGIN/../lib")
+    set(CMAKE_INSTALL_RPATH "$ORIGIN/../${CMAKE_INSTALL_LIBDIR}")
 endif()
 
 if(ftk_TESTS)
@@ -258,7 +258,7 @@ set(INCLUDE_INSTALL_DIR include)
 configure_package_config_file(
     ftkConfig.cmake.in
     ${CMAKE_CURRENT_BINARY_DIR}/ftkConfig.cmake
-    INSTALL_DESTINATION lib/cmake/ftk
+    INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/ftk
     PATH_VARS INCLUDE_INSTALL_DIR)
 install(
     FILES
@@ -267,7 +267,7 @@ install(
         cmake/ftkIconResources.cmake
         cmake/ftkIconResources.h.in
         cmake/ftkIconResources.cpp.in
-    DESTINATION lib/cmake/ftk
+    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/ftk
     COMPONENT dev)
 
 # Last, once everything is installed: the extra copies of each library a
diff -urp a/bin/ftk-resource/CMakeLists.txt b/bin/ftk-resource/CMakeLists.txt
--- a/bin/ftk-resource/CMakeLists.txt	2026-11-06 23:51:25.000000000 +0000
+++ b/bin/ftk-resource/CMakeLists.txt	2026-11-25 12:58:33.967191320 +0000
@@ -25,7 +25,7 @@ if(PROJECT_IS_TOP_LEVEL)
     install(
         EXPORT ftk-resourceTargets
         FILE ftk-resourceTargets.cmake
-        DESTINATION "lib/cmake/ftk"
+        DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/ftk"
         NAMESPACE ftk::
         COMPONENT dev)
 endif()
diff -urp a/lib/ftk/Core/CMakeLists.txt b/lib/ftk/Core/CMakeLists.txt
--- a/lib/ftk/Core/CMakeLists.txt	2026-11-06 23:51:25.000000000 +0000
+++ b/lib/ftk/Core/CMakeLists.txt	2026-11-25 12:58:33.962192964 +0000
@@ -159,13 +159,13 @@ set_target_properties(ftkCore PROPERTIES
 install(
     TARGETS ftkCore
     EXPORT ftkCoreTargets
-    ARCHIVE DESTINATION lib COMPONENT dev
-    LIBRARY DESTINATION lib
