[I] C++ toolkit for building professional tools for film, VFX, and animation

[T] A lightweight C++ toolkit for building professional tools for film, VFX, and animation.

[U] https://github.com/grizzlypeak3d/feather-tk

[A] grizzlypeak3d
[M] andrei32 <andrei32.t2@gmail.com>

[C] extra/tool
[F] CROSS OBJDIR

[L] BSD
[V] 0.17.0

[D] 75dae135169bc30ea9d9bc8a08d0910693abf459d83903550f6ebbd2 feather-tk-0.17.0.tar.gz https://github.com/grizzlypeak3d/feather-tk/archive/0.17.0/

var_append cmakeopt ' ' -Dftk_TESTS=OFF
var_append cmakeopt ' ' -Dftk_EXAMPLES=OFF
pkginstalled python nanobind && var_append cmakeopt ' ' -Dftk_PYTHON=ON
pkginstalled python nanobind && var_append cmakeopt ' ' \
	"-Dftk_PYTHON_INSTALL_DIR=${libdir##*/}/python$(pkgprefix ver python | sed 's/\.[0-9]*$//')/site-packages/feather_tk"
# FIX build and make it install in the right places
#pkginstalled python scikit-build-core && var_append cmakeopt ' ' -DSKBUILD=ON

# ftk-resource generates sources at build time, build it for the build host
# and install it into the toolchain for the dependent packages
if atstage cross; then
	hook_add preconf 5 "c++ -std=c++17 -O2 -o ftk-resource.build ../bin/ftk-resource/{App,main}.cpp -lz"
	var_append cmakeopt ' ' '-Dftk_RESOURCE=$PWD/ftk-resource.build'
	hook_add postmake 5 "install -m 755 ftk-resource.build $root/TOOLCHAIN/$toolsdir/bin/ftk-resource"
fi
