flex 2.7 derives YY_BUF_SIZE from YY_READ_BUF_SIZE, keep the former 16k read size.

--- asymptote-3.15.orig/interact.h
+++ asymptote-3.15/interact.h
@@ -66,7 +66,7 @@ public:
 
 void setCompleter(completer *c);
 
-#define YY_READ_BUF_SIZE YY_BUF_SIZE
+#define YY_READ_BUF_SIZE 16384
 
 void init_readline(bool tabcompletion);
 }
