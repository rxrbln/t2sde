atstage cross || ! pkginstalled tetex && var_append makeopt ' ' DOCSUBDIRS=
makeinstopt="$makeopt"' DESTDIR="$root" install'
var_append CC_WRAPPER_APPEND ' ' -std=gnu17

atstage cross && var_append confopt ' ' "ac_cv_c_gcc_strength_bug=no ac_16bit_type=short ac_32bit_type=int ac_64bit_type=$([ $arch_sizeof_long = 8 ] && echo long || echo none)"
