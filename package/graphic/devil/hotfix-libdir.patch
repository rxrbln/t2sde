 )
 
--- DevIL.orig/src-ILUT/pkgconfig/ILUT.pc.cmake.in	2017-01-02 01:03:56.000000000 +0100
+++ DevIL/src-ILUT/pkgconfig/ILUT.pc.cmake.in	2026-09-27 18:34:03.344530862 +0200
@@ -1,7 +1,7 @@
 prefix=@CMAKE_INSTALL_PREFIX@
