[I] A rendering engine for PDF, XFS, and EPUB

[T] A rendering engine for PDF, XFS, and EPUB.

[U] https://mupdf.com

[A] Artifex Software Inc.
[M] Riley Beckett <rbeckettvt@gmail.com>

[C] extra/development
[F] CROSS

[L] AGPL
[V] 1.28.1
[P] X -----5---9 400.000

[D] b6c653c544ae07c42bbc2ebe134957081c614896639e4f61623f88db mupdf-1.28.1-source.tar.gz https://mupdf.com/downloads/archive/

rungpepinstall=0 runpysetup=0 runpipinstall=0

var_append makeopt ' ' USE_SYSTEM_LIBS=yes
#var_append makeopt ' ' USE_SYSTEM_CMARK_GFM=yes  # makes build fail
var_append makeopt ' ' USE_SYSTEM_LCMS2=yes

pkginstalled leptonlib && var_append makeopt ' ' HAVE_LEPTONICA=yes
pkginstalled tesseract curl libarchive &&
	var_append makeopt ' ' HAVE_TESSERACT=yes &&
	var_append GCC_WRAPPER_APPEND ' ' "-lcurl -larchive"
pkginstalled zxing-cpp && var_append makeopt ' ' HAVE_ZXINGCPP=yes

makeinstopt="$makeopt install"

pkginstalled python pipcl && var_append makeinstopt ' ' install-shared-python

hook_add postmake 7 "ln -sfv mupdf-gl $root$bindir/mupdf"
