--- hugin-2025.0.1.orig/CMakeModules/FindVIGRA.cmake	2026-10-18 07:25:57.500567921 +0200
+++ hugin-2025.0.1/CMakeModules/FindVIGRA.cmake	2026-10-18 07:25:57.510001924 +0200
@@ -66,10 +66,16 @@ IF (VIGRA_FOUND)
 
   # check if vigraimpex is linked against OpenEXR
   IF(CMAKE_SYSTEM_NAME STREQUAL "Linux")
-    FIND_PROGRAM(LDD_EXECUTABLE ldd)
+    # ldd cannot inspect target libraries when cross compiling
+    IF(CMAKE_CROSSCOMPILING AND CMAKE_OBJDUMP)
+      SET(LDD_EXECUTABLE ${CMAKE_OBJDUMP})
+      SET(LDD_ARGS -p)
+    ELSE()
+      FIND_PROGRAM(LDD_EXECUTABLE ldd)
+    ENDIF()
     IF(LDD_EXECUTABLE)
       EXECUTE_PROCESS(
-        COMMAND ${LDD_EXECUTABLE} ${VIGRA_LIBRARIES}
+        COMMAND ${LDD_EXECUTABLE} ${LDD_ARGS} ${VIGRA_LIBRARIES}
         OUTPUT_VARIABLE OUTPUT_LDD_VIGRA
         OUTPUT_STRIP_TRAILING_WHITESPACE
       )
