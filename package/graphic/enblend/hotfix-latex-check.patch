Without LaTeX only skip the documentation: AC_PROG_LATEX, which the class
checks require, failed hard, and the class checks tested the never set
$latex instead of can_build_doc.

diff -urp a/configure.ac b/configure.ac
--- a/configure.ac	2026-11-25 13:17:14.079920041 +0000
+++ b/configure.ac	2026-11-25 13:17:14.090124510 +0000
@@ -324,7 +324,7 @@ AC_PATH_PROG(PDFLATEX, pdflatex,
              [AC_MSG_WARN([missing PDFLaTeX translator -- no direct translation of LaTeX to PDF available])
               missing_for_doc="$missing_for_doc pdflatex"])
 
-if test "$latex" != 'no'
+if test "$can_build_doc" = yes
 then
   AC_LATEX_CLASS(report,report,[],
                  [AC_MSG_WARN(missing document class report.cls)
diff -urp a/m4/ac_prog_latex.m4 b/m4/ac_prog_latex.m4
--- a/m4/ac_prog_latex.m4	2026-11-25 13:17:53.201588002 +0000
+++ b/m4/ac_prog_latex.m4	2026-11-25 13:17:53.209587934 +0000
@@ -35,7 +35,7 @@ AC_CHECK_PROGS(latex,[latex elatex lambd
 export latex;
 if test $latex = "no" ;
 then
-        AC_MSG_ERROR([Unable to find a LaTeX application]);
+        AC_MSG_WARN([Unable to find a LaTeX application]);
 fi
 AC_SUBST(latex)
 ])
