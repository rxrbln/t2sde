[I] The world's biggest computer vision library

[T] The world's largest open source vision library, containing over 2500
[T] algorithms,

[U] https://opencv.org

[A] Open Source Vision Foundation
[M] René Rebe <rene@exactco.de>

[C] extra/multimedia
[F] CROSS OBJDIR NO-LTO.hppa NO-LTO.hppa64

[E] opt eigen
[E] opt libwebp
[E] opt openblas
[E] opt openexr ilmbase
[E] opt openjdk
[E] opt vtk

[L] GPL
[V] 5.1.0
[P] X -----5---9 150.010

[D] e758de87e55f356b4f7a3a329efda0cc4739b9a05ee9fcde7f540e42 opencv-5.1.0.tar.gz https://github.com/opencv/opencv/archive/5.1.0/
[D] 7cd5cf1529927d32f328e3294b944a58c4e72f770f74aafa1a08d33e opencv_contrib-5.1.0.tar.gz https://github.com/opencv/opencv_contrib/archive/5.1.0/

var_append cmakeopt ' ' -DOPENCV_GENERATE_PKGCONFIG=ON
var_append cmakeopt ' ' -DENABLE_CCACHE=OFF
var_append cmakeopt ' ' '-DOPENCV_EXTRA_MODULES_PATH=$builddir/$xsrcdir/opencv_contrib-$ver/modules/ml'

atstage cross && var_append cmakeopt ' ' -DWITH_OPENJPEG=OFF
[ $arch = arm64 ] && var_remove_regex GCC_WRAPPER_REMOVE ' ' -march.*

# ml moved to opencv_contrib in OpenCV 5, used e.g. by digikam
hook_add prepatch 5 'tar $taropt $(match_source_file -p opencv_contrib)'
