The giflib lookup only forces the wrap fallback for a bundled leptonica, not
needed with the system one (giflib ships no pkg-config file).

--- jbig2enc-0.32/meson.build.orig
+++ jbig2enc-0.32/meson.build
@@ -78,9 +78,6 @@ add_project_arguments(
     language: 'cpp',
 )
 
-# Pre-resolve giflib with required:true so wrap fallback activates.
-# Leptonica uses required:false which skips wraps entirely.
-dependency('giflib')
 lept_dep = dependency('lept', version: '>=1.74')
 dependencies = [
     lept_dep,
