Install the libraries and CMake configs into CMAKE_INSTALL_LIBDIR, and use it
for the install RPATH, instead of the hardcoded lib.

diff -urp a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt	2026-11-06 23:51:25.000000000 +0000
+++ b/CMakeLists.txt	2026-11-25 12:58:59.984660703 +0000
@@ -118,9 +118,9 @@ elseif(APPLE)
     set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)
     set(CMAKE_BUILD_RPATH
         "${CMAKE_BINARY_DIR}/lib"
-        "${CMAKE_INSTALL_PREFIX}/lib")
+        "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_LIBDIR}")
 else()
-    set(CMAKE_INSTALL_RPATH "$ORIGIN/../lib")
+    set(CMAKE_INSTALL_RPATH "$ORIGIN/../${CMAKE_INSTALL_LIBDIR}")
 endif()
 # The rest of an rpath, relative to <prefix>/lib: a wheel names the libraries
 # of the tlrender and feather_tk packages beside it. The libraries are loaded
@@ -245,11 +245,11 @@ set(INCLUDE_INSTALL_DIR include/djv)
 configure_package_config_file(
     djvConfig.cmake.in
     ${CMAKE_CURRENT_BINARY_DIR}/djvConfig.cmake
-    INSTALL_DESTINATION lib/cmake/djv
+    INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/djv
     PATH_VARS INCLUDE_INSTALL_DIR)
 install(
     FILES ${CMAKE_CURRENT_BINARY_DIR}/djvConfig.cmake
-    DESTINATION lib/cmake/djv
+    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/djv
     COMPONENT dev)
 
 #-------------------------------------------------------------------------------
diff -urp a/cmake/Modules/Package.cmake b/cmake/Modules/Package.cmake
--- a/cmake/Modules/Package.cmake	2026-11-06 23:51:25.000000000 +0000
+++ b/cmake/Modules/Package.cmake	2026-11-25 12:58:34.248148445 +0000
@@ -213,7 +213,7 @@ elseif(APPLE)
         else()
             djv_install_dep(
                 DIRECTORY ${CMAKE_INSTALL_PREFIX}/lib/usd
-                DESTINATION lib)
+                DESTINATION ${CMAKE_INSTALL_LIBDIR})
             djv_install_dep(
                 DIRECTORY ${CMAKE_INSTALL_PREFIX}/plugin
                 DESTINATION ".")
@@ -233,7 +233,7 @@ elseif(APPLE)
             COMPONENT bundle
             EXCLUDE_FROM_ALL)
     else()
-        djv_install_dep(FILES ${INSTALL_DYLIBS} DESTINATION lib)
+        djv_install_dep(FILES ${INSTALL_DYLIBS} DESTINATION ${CMAKE_INSTALL_LIBDIR})
     endif()
 
     if(DJV_MACOS_PACKAGE)
@@ -310,13 +310,13 @@ else()
 
         djv_install_dep(
             DIRECTORY ${CMAKE_INSTALL_PREFIX}/lib/usd
-            DESTINATION lib)
+            DESTINATION ${CMAKE_INSTALL_LIBDIR})
         djv_install_dep(
             DIRECTORY ${CMAKE_INSTALL_PREFIX}/plugin
             DESTINATION ".")
     endif()
     
-    djv_install_dep(FILES ${INSTALL_LIBS} DESTINATION lib)
+    djv_install_dep(FILES ${INSTALL_LIBS} DESTINATION ${CMAKE_INSTALL_LIBDIR})
 
 endif()
 
