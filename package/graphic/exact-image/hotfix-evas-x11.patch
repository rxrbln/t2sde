--- a/configure
+++ b/configure
@@ -61,6 +61,16 @@
 else EVASGL=0
 fi
 
+if [ "$WITHEVAS" = 1 ] &&
+   ! headercheck "cc $EVASINCS " "Evas_Engine_Software_X11.h"; then
+	WITHEVAS=0
+	cat <<-EOT
+
+		The Evas software X11 engine header was not found - edisplay is disabled.
+
+EOT
+fi
+
 pkgcheck libjpeg header LIBJPEG cc jconfig.h
 pkgcheck libjxl pkg-config LIBJXL atleast 0.6
 pkgcheck libheif pkg-config LIBHEIF atleast 1.16
