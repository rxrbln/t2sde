[I] A tiny simple gtk image viewer

[T] A tiny simple gtk image viewer

[U] https://gview.sourceforge.net/

[A] Jason Barto
[M] René Rebe <rene@exactco.de>

[C] extra/multimedia
[F] CROSS

[L] GPL
[V] 0.9.1a

[D] e5ad6818bddd2180d93b1458b85a223d54bd1a720628193d4d9dcfcc gview-0.9.1a.tar.gz https://prdownloads.sourceforge.net/sourceforge/gview/

gview_build() {
    rm -f gview
    $CC -fcommon -c *.c $(pkg-config --cflags gtk+-2.0)
    $CC -o gview *.o $(pkg-config --libs gtk+-2.0)
    install -D -m755 gview $root$bindir/gview
}
runmake=0
hook_add postmake 5 gview_build
