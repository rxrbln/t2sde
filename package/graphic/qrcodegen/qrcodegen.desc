[I] QR Code generator C and C++ library

[T] qrcodegen is the C/C++ implementation of Project Nayuki's QR Code
[T] generator library.

[U] https://www.nayuki.io/page/qr-code-generator-library

[A] Project Nayuki
[M] kei <keletrh@gmail.com>

[C] extra/graphic
[F] CROSS FPIC OBJDIR

[L] MIT
[V] 1.8.0
[P] X -----5---9 400.000

[D] b5346805d2be5d0ad222cfdeaceb17cacff73c3c5e5de93d7e6af54a qrcodegencpp-1.8.0.tar.gz https://github.com/nayuki/QR-Code-generator/archive/refs/tags/v1.8.0/
[D] c8066979c573cf97552ba68f6b58478df3323d64f4b0ebdb3450f49c qrcodegen-cmake-1.8.0-cmake5.tar.gz https://github.com/EasyCoding/qrcodegen-cmake/archive/v1.8.0-cmake5/

[ "$SDECFG_STATIC" = 1 ] || var_append cmakeopt ' ' -DBUILD_SHARED_LIBS=ON

untar_cmake() {
	tar $taropt $(match_source_file -p cmake) -C $builddir
	cp -Rv $builddir/qrcodegen-cmake*/{cmake,CMakeLists.txt} $builddir/QR-Code-generator*/
}
hook_add preconf 5 untar_cmake
