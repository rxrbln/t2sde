[I] Framework for digital image processing

[T] G'MIC is a full-featured open-source framework for digital image processing.

[U] https://gmic.eu

[A] David Tschumperlé {https://tschumperle.users.greyc.fr/}
[M] andrei32 <andrei32.t2@gmail.com>

[C] extra/tool
[F] CROSS OBJDIR

[L] CeCILL-C
[V] 4.0.6

[D] b01197b58e99559b6be7b6c96f845e90f262be5c3af2e5a326127245 gmic_4.0.6.tar.gz https://gmic.eu/files/source/

var_append GCC_WRAPPER_APPEND ' ' "-L$root$(pkgprefix libdir libx11)"

var_append cmakeopt ' ' -DENABLE_OPENCV=ON

# for qt build
#var_append cmakeopt ' ' -DBUILD_WITH_QT6=ON
#pkginstalled gimp && var_append cmakeopt ' ' -DGMIC_QT_HOST=gimp3
atstage cross && var_append cmakeopt ' ' '-DSTRIP_TOOL=$(type -p $STRIP) -DBUILD_MAN=OFF -DBUILD_BASH_COMPLETION=OFF'
atstage cross && hook_add postmake 5 "install -Dm644 ../man/gmic.1.gz $root$mandir/man1/gmic.1.gz; install -Dm644 ../resources/gmic_bashcompletion.sh $root$datadir/bash-completion/completions/gmic"
