[I] Library for visual effects, film, and animation.

[T] tlRender is an open source library for building playback and review
[T] applications for visual effects, film, and animation.

[U] https://github.com/grizzlypeak3d/tlRender

[A] grizzlypeak3d
[M] andrei32 <andrei32.t2@gmail.com>

[C] extra/tool
[F] CROSS OBJDIR

[L] BSD
[V] 0.24.3

[D] 3bf7c10a2067446f145fd68efbb777c168f2e6b9888cb2703bb74dc2 tlRender-0.24.3.tar.gz https://github.com/grizzlypeak3d/tlRender/archive/0.24.3/

var_append cmakeopt ' ' -DTLRENDER_FFMPEG_PLUGIN=OFF # breaks build
var_append cmakeopt ' ' -DTLRENDER_EXAMPLES=OFF
var_append cmakeopt ' ' -DTLRENDER_TESTS=OFF

var_append cmakeopt ' ' -DTLRENDER_FTK_PACKAGE=ON
# FIX
#pkginstalled python && var_append cmakeopt ' ' -DTLRENDER_PYTHON=ON
#pkginstalled python scikit-build-core && var_append cmakeopt ' ' -DSKBUILD=ON

atstage cross && var_append cmakeopt ' ' -Dftk_RESOURCE=$root/TOOLCHAIN/$toolsdir/bin/ftk-resource
