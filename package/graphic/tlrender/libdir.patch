Install the libraries and CMake configs into CMAKE_INSTALL_LIBDIR, and use it
for the install RPATH, instead of the hardcoded lib.

diff -urp a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt	2026-11-06 23:51:25.000000000 +0000
+++ b/CMakeLists.txt	2026-11-25 12:58:59.984599584 +0000
@@ -140,9 +140,9 @@ elseif(APPLE)
     set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)
     set(CMAKE_BUILD_RPATH
         "${CMAKE_BINARY_DIR}/lib"
-        "${CMAKE_INSTALL_PREFIX}/lib")
+        "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_LIBDIR}")
 else()
-    set(CMAKE_INSTALL_RPATH "$ORIGIN/../lib")
+    set(CMAKE_INSTALL_RPATH "$ORIGIN/../${CMAKE_INSTALL_LIBDIR}")
 endif()
 # The rest of an rpath, relative to <prefix>/lib: a wheel names feather-tk's
 # libraries in the feather_tk package beside it.
@@ -433,11 +433,11 @@ set(INCLUDE_INSTALL_DIR include/tlRender
 configure_package_config_file(
     tlRenderConfig.cmake.in
     ${CMAKE_CURRENT_BINARY_DIR}/tlRenderConfig.cmake
-    INSTALL_DESTINATION lib/cmake/tlRender
+    INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/tlRender
     PATH_VARS INCLUDE_INSTALL_DIR)
 install(
     FILES ${CMAKE_CURRENT_BINARY_DIR}/tlRenderConfig.cmake
-    DESTINATION lib/cmake/tlRender
+    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/tlRender
     COMPONENT dev)
 
 # Last, once everything is installed: the wheel's CMake packages are made
diff -urp a/lib/tlRender/BakeApp/CMakeLists.txt b/lib/tlRender/BakeApp/CMakeLists.txt
--- a/lib/tlRender/BakeApp/CMakeLists.txt	2026-11-06 23:51:25.000000000 +0000
+++ b/lib/tlRender/BakeApp/CMakeLists.txt	2026-11-25 12:58:34.126746922 +0000
@@ -26,7 +26,7 @@ set_target_properties(tlBakeApp PROPERTI
 set_target_properties(tlBakeApp PROPERTIES PUBLIC_HEADER "${HEADERS}")
 
 install(TARGETS tlBakeApp
-    ARCHIVE DESTINATION lib COMPONENT dev
-    LIBRARY DESTINATION lib
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT dev
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
     RUNTIME DESTINATION bin
     PUBLIC_HEADER DESTINATION include/tlRender/BakeApp COMPONENT dev)
