--- libquirc-1.0.1/Makefile.vanilla	2026-10-02 19:19:06.042517694 +0300
+++ libquirc-1.0.1/Makefile	2026-10-02 19:20:23.146595093 +0300
@@ -15,8 +15,8 @@
 
 CC ?= gcc
 PREFIX ?= /usr/local
-SDL_CFLAGS ?= pkg-config --cflags sdl 
-SDL_LIBS ?= pkg-config --libs sdl
+SDL_CFLAGS ?= $(pkg-config --cflags sdl)
+SDL_LIBS ?= $(pkg-config --libs sdl)
 
 LIB_VERSION = 1.0
 
@@ -62,12 +62,11 @@
 .c.o:
 	$(CC) $(QUIRC_CFLAGS) -o $@ -c $<
 
-install: libquirc.a libquirc.so.$(LIB_VERSION) quirc-demo quirc-scanner
+install: libquirc.a libquirc.so.$(LIB_VERSION) quirc-scanner
 	install -o root -g root -m 0644 lib/quirc.h $(DESTDIR)$(PREFIX)/include
-	install -o root -g root -m 0644 libquirc.a $(DESTDIR)$(PREFIX)/lib
+	install -o root -g root -m 0644 libquirc.a $(DESTDIR)$(PREFIX)/lib64
 	install -o root -g root -m 0755 libquirc.so.$(LIB_VERSION) \
-		$(DESTDIR)$(PREFIX)/lib
-	install -o root -g root -m 0755 quirc-demo $(DESTDIR)$(PREFIX)/bin
+		$(DESTDIR)$(PREFIX)/lib64
 	install -o root -g root -m 0755 quirc-scanner $(DESTDIR)$(PREFIX)/bin
 
 uninstall:
