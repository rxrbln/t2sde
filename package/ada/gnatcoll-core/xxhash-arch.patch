Allow GNATCOLL_XXHASH_ARCH to select the generic xxhash, the x86_64 dispatcher
refuses to build with the AVX enabled by the T2 default -march.

--- gnatcoll-core-26.0.0/core/gnatcoll_core.gpr.py.orig	2025-11-28 12:36:47.000000000 +0000
+++ gnatcoll-core-26.0.0/core/gnatcoll_core.gpr.py	2026-11-21 09:53:05.386683082 +0000
@@ -51,6 +51,7 @@ class GNATCollCore(BuilderApp):
             xxhash_arch = "x86_64"
         else:
             xxhash_arch = "generic"
+        xxhash_arch = os.environ.get("GNATCOLL_XXHASH_ARCH", xxhash_arch)
 
         logging.debug(f"xxhash implementation: {xxhash_arch}")
         gpr.set_variable("GNATCOLL_XXHASH_ARCH", xxhash_arch)
