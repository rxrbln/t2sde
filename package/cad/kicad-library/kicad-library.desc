[D] b7d45c21a0b5954fdcac1edab92998100ff7a96cedec9ed2ac3f0333 kicad-footprints-10.0.8.tar.bz2 https://gitlab.com/kicad/libraries/kicad-footprints/-/archive/10.0.8/
[D] 9b12d3f87209bb5a12164d8b39152e397aaad8545e2ff059199a77e0 kicad-packages3D-10.0.8.tar.bz2 https://gitlab.com/kicad/libraries/kicad-packages3D/-/archive/10.0.8/
[D] 4cab036fdea5582ec79fe6d026bf5d8b4f6d845463a9bc2029affa4c kicad-symbols-10.0.8.tar.bz2 https://gitlab.com/kicad/libraries/kicad-symbols/-/archive/10.0.8/
[D] 51405c933a76903d367964ccca3ad3fd6c07c4b9a0c69e4841ff08dd kicad-templates-10.0.8.tar.bz2 https://gitlab.com/kicad/libraries/kicad-templates/-/archive/10.0.8/

packages3D() {
	tar -xf $(match_source_file -p kicad-packages3D.*tar.*)
	cd kicad-packages3D-*
	eval cmake -B kicad-library $cmakeopt
	cmake --build kicad-library
	DESTDIR=$root cmake --install kicad-library
	cd ..

}
hook_add postmake 3 packages3D

symbols() {
	tar -xf $(match_source_file -p kicad-symbols.*tar.*)
	cd kicad-symbols-*
	eval cmake -B kicad-library $cmakeopt
	cmake --build kicad-library
	DESTDIR=$root cmake --install kicad-library
	cd ..

}
hook_add postmake 4 symbols

templates() {
	tar -xf $(match_source_file -p kicad-templates.*tar.*)
	cd kicad-templates-*
	eval cmake -B kicad-library $cmakeopt
	cmake --build kicad-library
	DESTDIR=$root cmake --install kicad-library
}
hook_add postmake 5 templates
