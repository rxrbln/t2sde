[I] Kicad libraries

[T] KiCad organizes symbols into symbol libraries, which hold collections
[T] of symbols. Each symbol in a schematic is uniquely identified by a
[T] full name that is composed of a library nickname and a symbol name.
[T] For example, the identifier Audio:AD1853 refers to the AD1853 symbol
[T] in the Audio library.

[U] https://www.kicad.org/

[A] Jean-Pierre Charras
[M] Aleksi Venäläinen <aleksi.venalainen@outlook.com>

[C] extra/cad
[F] NO-LTO

[L] OpenSource
[V] 10.0.7

[CV-GROUP] kicad
[D] b7400c922ce8b92b36cfeb01fe9aaef0518b4a5e0c9a552ffbf2c7ab kicad-footprints-10.0.7.tar.bz2 https://gitlab.com/kicad/libraries/kicad-footprints/-/archive/10.0.7/
[D] 115d621e4d8c98796774ced00d5aa96e0160fc8b46ffeb99b13a8894 kicad-packages3D-10.0.7.tar.bz2 https://gitlab.com/kicad/libraries/kicad-packages3D/-/archive/10.0.7/
[D] ca48446828df4c1a7c98104d8a9db4c5fd762bdfe63de69f4b43a5cc kicad-symbols-10.0.7.tar.bz2 https://gitlab.com/kicad/libraries/kicad-symbols/-/archive/10.0.7/
[D] d3591726849c7935c744e2e7d0f923ebcd3cf801bab1bb40c8fc512c kicad-templates-10.0.7.tar.bz2 https://gitlab.com/kicad/libraries/kicad-templates/-/archive/10.0.7/

packages3D() {
	tar -xf $(match_source_file -p kicad-packages3D.*tar.*)
	cd kicad-packages3D-*
	eval cmake -B kicad-library $cmakeopt
	cmake --build kicad-library
	cmake --install kicad-library
	cd ..

}
hook_add postmake 3 packages3D

symbols() {
	tar -xf $(match_source_file -p kicad-symbols.*tar.*)
	cd kicad-symbols-*
	eval cmake -B kicad-library $cmakeopt
	cmake --build kicad-library
	cmake --install kicad-library
	cd ..

}
hook_add postmake 4 symbols

templates() {
	tar -xf $(match_source_file -p kicad-templates.*tar.*)
	cd kicad-templates-*
	eval cmake -B kicad-library $cmakeopt
	cmake --build kicad-library
	cmake --install kicad-library
}
hook_add postmake 5 templates
