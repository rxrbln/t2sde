[D] 1d5aba3ce327d61fb8510b687b4ede73436774a480fcb19d48b8503f kicad-footprints-10.0.6.tar.bz2 https://gitlab.com/kicad/libraries/kicad-footprints/-/archive/10.0.6/
[D] 218e2c71777e826f0b78ceb9552b0ecb2ef5ba32bb0be025375add33 kicad-packages3D-10.0.6.tar.bz2 https://gitlab.com/kicad/libraries/kicad-packages3D/-/archive/10.0.6/
[D] daf9a647f3d65f6c9e2dee5881c5771ce697ec7ebd8756403b6d3e12 kicad-symbols-10.0.6.tar.bz2 https://gitlab.com/kicad/libraries/kicad-symbols/-/archive/10.0.6/
[D] fe0922a68269123aca00ae49881416ecb361bdfbceb1a70da6e404fa kicad-templates-10.0.6.tar.bz2 https://gitlab.com/kicad/libraries/kicad-templates/-/archive/10.0.6/

packages3D() {
	tar -xf $(match_source_file -p kicad-packages3D.*tar.*)
	cd kicad-packages3D-*
	eval cmake -B kicad-library $cmakeopt
	cmake --build kicad-library
	cmake --install kicad-library
	cd ..

}
hook_add postmake 3 packages3D

symbols() {
	tar -xf $(match_source_file -p kicad-symbols.*tar.*)
	cd kicad-symbols-*
	eval cmake -B kicad-library $cmakeopt
	cmake --build kicad-library
	cmake --install kicad-library
	cd ..

}
hook_add postmake 4 symbols

templates() {
	tar -xf $(match_source_file -p kicad-templates.*tar.*)
	cd kicad-templates-*
	eval cmake -B kicad-library $cmakeopt
	cmake --build kicad-library
	cmake --install kicad-library
}
hook_add postmake 5 templates
