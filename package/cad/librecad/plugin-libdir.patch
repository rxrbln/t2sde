Install the plugins to $libdir/librecad/plugins, where they are searched,
not below bin, blocking /usr/bin/resources of the resources system monitor.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1032,7 +1032,7 @@ foreach(name ${PLUGIN_NAMES})
   target_link_libraries(${name} PRIVATE plugin_deps)
   set_target_properties(${name} PROPERTIES AUTOMOC ON AUTOUIC ON)
   install(TARGETS ${name}
-    LIBRARY DESTINATION bin/resources/plugins
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}/librecad/plugins
     RUNTIME DESTINATION bin/resources/plugins
   )
 endforeach()
