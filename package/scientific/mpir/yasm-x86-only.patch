--- mpir-mpir-3.0.0.orig/configure.ac	2026-10-18 06:25:49.331844669 +0200
+++ mpir-mpir-3.0.0/configure.ac	2026-10-18 06:25:49.340642997 +0200
@@ -1732,7 +1732,10 @@ test -n "$CCAS" || CCAS="$CC -c"
 AC_SUBST(CCAS)
 
 # If the user provided its Yasm, check it seems functional
+# Yasm is only used for the x86 assembly
 MPIR_AS=""
+case $host in
+  X86_PATTERN | X86_64_PATTERN)
 if test -z "$with_yasm"; then
   echo "Looking for a system-wide yasm..."
   MPIR_AS=`which yasm`
@@ -1746,6 +1749,8 @@ echo "Checking yasm..."
 if ! test -f "$MPIR_AS" || ! test -x "$MPIR_AS"; then
   AC_MSG_ERROR([$MPIR_AS does not seem functional])
 fi
+  ;;
+esac
 AC_SUBST(MPIR_AS)
 
