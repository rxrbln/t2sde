var_append cmakeopt ' ' -DVTK_MODULE_ENABLE_VTK_IOH5Rage=WANT -DVTK_MODULE_ENABLE_VTK_IOOMF=WANT
var_append cmakeopt ' ' -DVTK_MODULE_ENABLE_VTK_IOParallelExodus=WANT
var_append cmakeopt ' ' -DVTK_MODULE_ENABLE_VTK_IOParallelLSDyna=WANT
var_append cmakeopt ' ' -DVTK_MODULE_ENABLE_VTK_IOTRUCHAS=WANT
var_append cmakeopt ' ' -DVTK_MODULE_ENABLE_VTK_FiltersParallelStatistics=WANT
var_append cmakeopt ' ' -DVTK_MODULE_ENABLE_VTK_GUISupportQt=WANT
var_append cmakeopt ' ' -DVTK_MODULE_ENABLE_VTK_cli11=WANT
var_append cmakeopt ' ' -DVTK_MODULE_ENABLE_VTK_RenderingParallel=WANT
var_append cmakeopt ' ' -DVTK_MODULE_ENABLE_VTK_RenderingVolumeAMR=WANT
var_append cmakeopt ' ' -DVTK_MODULE_ENABLE_VTK_IOH5part=WANT
