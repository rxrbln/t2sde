[I] An electrical circuit simulator

[T] Third version of spice3f5 for Linux. Many bugs are fixed here,
[T] and now spice is quite good working simulator.

[U] http://bwrcs.eecs.berkeley.edu/Classes/IcBook/SPICE/

[A] U.C. Berkeley CAD group {Author}
[A] Michael Widlok <widlok@uci.agh.edu.pl> {Maintainer}
[M] René Rebe <rene@exactco.de>

[C] extra/scientific
[F] CROSS

[L] Free-to-use
[V] 3f5

[D] 6be61c1bf99057a2c044ed3d369e33db94d9883f2e419e668625734b spice3f5sfix.tar.gz http://sunsite.unc.edu/pub/Linux/apps/circuits/

runconf=0 runmake=0

var_append GCC_WRAPPER_APPEND ' ' -std=gnu89
pkgprefix -t libxaw

spice_main() {
    local opt=(CC="$CC" AR="$AR" ARLOCAL= RANLIB="$RANLIB" LDFLAGS="-lncurses -lm"
	       X_DIR=/$(pkgprefix libxaw))
    ./util/build linux "${opt[@]}"
    # makeidx generates the help index at install time
    $BUILDCC -std=gnu89 -Isrc/include -o obj/bin/makeidx src/bin/makeidx.c
    ./util/build linux install "${opt[@]}" SPICE_DIR=$root/usr/spice S_SPICE_DIR=/usr/spice
    ln -sf /usr/spice/bin/spice3 $root$bindir/spice
    cp -vf $confdir/spiceinit $root$docdir
}
hook_add postmake 5 spice_main
