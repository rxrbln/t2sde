[COPY] --- T2-COPYRIGHT-BEGIN ---
[COPY] t2/package/*/openblas/openblas.desc
[COPY] Copyright (C) 2022 - 2026 The T2 SDE Project
[COPY] SPDX-License-Identifier: GPL-2.0
[COPY] --- T2-COPYRIGHT-END ---

[I] Fast BSD-licensed BLAS based on gotoBLAS2

[T] Fast BSD-licensed BLAS based on gotoBLAS2.

[U] https://www.openblas.net/

[A] Openblas Authors
[M] René Rebe <rene@exactco.de>

[C] extra/base
[F] OBJDIR CROSS

[E] opt lapack

[L] BSD
[V] 0.3.34

[D] 3a74f0c2123db6fbb0091670cc8da5e1a5bd666a551f3ff6b0d07592 openblas-0.3.34.tar.gz https://github.com/xianyi/OpenBLAS/archive/v0.3.34/

GCC_WRAPPER_BYPASS=1 # TODO: flexible configure their SIMD optimizations
var_append cmakeopt ' ' -DBUILD_TESTING=OFF
pkginstalled lapack || var_append cmakeopt ' ' -DBUILD_WITHOUT_LAPACK=ON
var_append makeinstopt ' ' OPENBLAS_LIBRARY_DIR=$libdir
[ "$SDECFG_STATIC" = 1 ] || var_append cmakeopt ' ' -DBUILD_SHARED_LIBS=ON

if [ $arch = alpha ]; then
	# the CMake build lacks alpha support, use the Makefile build from the source dir
	runcmake=0
	case "$SDECFG_ALPHA_OPT" in
		ev6*) obtarget=EV6 ;;
		ev5*|pca56) obtarget=EV5 ;;
		*) obtarget=EV4 ;;
	esac
	obopt="-C .. TARGET=$obtarget FC=\"\$FC\""
	# same header location as the CMake build, not clashing with lapack
	var_append obopt ' ' "OPENBLAS_INCLUDE_DIR=$includedir/openblas"
	pkginstalled lapack || var_append obopt ' ' NO_LAPACK=1
	atstage cross && var_append obopt ' ' CROSS=1
	var_append makeopt ' ' "$obopt"
	var_append makeinstopt ' ' "$obopt"
fi
