[I] DICOM toolkit

[T] DICOM toolkit (DCMTK) package consists of source code, documentation
[T] and installation instructions for a set of software libraries and
[T] applications implementing part of the DICOM/MEDICOM Standard.

[U] https://git.dcmtk.org/?p=dcmtk.git;a=summary

[A] OFFIS e.V.
[M] NoTag <notag@t2sde.org>

[C] extra/development
[F] CROSS OBJDIR

[E] opt doxygen

[L] OpenSource
[V] 3.7.1

[D] 0b51228f5132b39b57facb3da77e37616edd412d1729e685304507fd dcmtk-3.7.1.tar.gz https://github.com/DCMTK/dcmtk/archive/DCMTK-3.7.1/

var_append cmakeopt ' ' -DDCMTK_WITH_WRAP=OFF
[ "$SDECFG_STATIC" = 1 ] || var_append cmakeopt ' ' -DBUILD_SHARED_LIBS=ON

# glibc iconv results, the checks run a test program
atstage cross && var_append cmakeopt ' ' "-DDCMTK_NO_TRY_RUN=ON -DDCMTK_ICONV_FLAGS_ANALYZED=TRUE \
	-DDCMTK_FIXED_ICONV_CONVERSION_FLAGS=AbortTranscodingOnIllegalSequence -DDCMTK_STDLIBC_ICONV_HAS_DEFAULT_ENCODING=1"
