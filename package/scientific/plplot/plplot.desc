[I] Scientific graphics plotting library

[T] Scientific graphics plotting library.

[U] https://plplot.sourceforge.net/

[A] Plplot Authors
[M] René Rebe <rene@exactco.de>

[C] extra/base

[V] 5.15.0
[L] LGPL

[D] d99c799dadcd6393faab56c59827058007f43e469fd7df2476852799 plplot-5.15.0.tar.gz https://downloads.sourceforge.net/project/plplot/plplot/5.15.0%20Source/

atstage cross && var_append cmakeopt ' ' '-DNaNAwareCCompiler=ON -DRUN_RESULT=0 -DRUN_RESULT__TRYRUN_OUTPUT= -DLIBHARU_VERSION_LARGE_ENOUGH_EXITCODE=0'

# the header generators run at build time, import them from a native build
plplot_native_tools() {
	local nat=$builddir/native
	mkdir -p $nat
	(cd $nat && env PATH="${PATH/$CMD_WRAPPER_MYPATH:/}" CC=$HOSTCC CXX=$HOSTCXX \
		CFLAGS= CXXFLAGS= LDFLAGS= PKG_CONFIG_PATH= PKG_CONFIG_LIBDIR= PKG_CONFIG_SYSROOT_DIR= \
		cmake $builddir/plplot-$ver -DDEFAULT_NO_BINDINGS=ON -DDEFAULT_NO_DEVICES=ON \
			-DENABLE_DYNDRIVERS=OFF -DBUILD_DOC=OFF -DBUILD_TEST=OFF &&
		make tai-utc-gen deltaT-gen plhershey-unicode-gen) || return 1
	var_append cmakeopt ' ' "-DCMAKE_NATIVE_BINARY_DIR=$nat"
}
atstage cross && hook_add preconf 5 plplot_native_tools

var_append cmakeopt ' ' -DENABLE_tcl=OFF

if atstage cross; then
	plplot_np=$(ls -d $root$libdir/python3.*/site-packages/numpy/_core/include/numpy 2>/dev/null | tail -n 1)
	if [ "$plplot_np" ]; then
		var_append cmakeopt ' ' -DNUMPY_INCLUDE_PATH=$plplot_np
		var_append GCC_WRAPPER_APPEND ' ' -I${plplot_np%/numpy}
	fi
fi
