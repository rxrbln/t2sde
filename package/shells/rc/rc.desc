[I] The Plan 9 Shell

[T] Rc is a command interpreter for Plan 9 that provides similar facilities to
[T] UNIX's Bourne shell, with some small additions and less idiosyncratic syntax.

[U] https://tobold.org/article/rc

[A] Tom Duff {Original Author of rc}
[A] Tim Goodwin <tjg@star.le.ac.uk>
[M] René Rebe <rene@exactco.de>

[C] extra/shell
[F] CROSS

[L] GPL
[V] 1.7.4

[D] a66fc9af1774596babd11e8f4e75cb3f238357d9e233be17f51d0f7f rc-1.7.4.tar.gz https://github.com/rakitzis/rc/archive/v1.7.4/

# we have a rc - Runlevel Control - init wrapper we must not shadow ...
var_append INSTALL_WRAPPER_FILTER '|' "sed -e 's,/rc$,/rcsh,' -e 's,/rc\.,/rcsh.,'"

# host helpers, mksignal with the target signal numbers
rc_host_tools() {
	echo '#include <signal.h>' | $CC -E -dM - |
		sed -n 's/^#define \(_*SIG[A-Z0-9]*\|_*NSIG\) \(.*\)/#undef \1\n#define \1 \2/p' > target-signal.h
	$BUILDCC -include signal.h -include ./target-signal.h -o mksignal.build mksignal.c
	$BUILDCC -o mkstatval.build mkstatval.c
}
atstage cross && hook_add premake 5 rc_host_tools
var_append CC_WRAPPER_APPEND ' ' -std=gnu17
