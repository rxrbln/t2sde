Do not run the target gen_osinfo, it only records the build system uname.

diff -Nrup a/src/Makefile.in b/src/Makefile.in
--- a/src/Makefile.in	2000-01-14 23:46:31.000000000 +0100
+++ b/src/Makefile.in	2026-10-22 17:22:43.093004215 +0200
@@ -52,9 +52,7 @@ ikeygen: ikeygen.o version.o
 
 c_osinfo.o:	gen_osinfo.o support.o safeio.o
 	$(CC) $(CFLAGS) -o gen_osinfo gen_osinfo.o support.o safeio.o $(LDFLAGS)
-	./gen_osinfo > c_osinfo.c
 	$(CC) $(CFLAGS) -c -o c_osinfo.o c_osinfo.c
-	rm -f c_osinfo.c gen_osinfo
 
 
 # Installing
