[I] An implementation of Shamir's secret sharing scheme for UNIX systems

[T] Ssss is an implementation of Shamir's secret sharing scheme for UNIX systems.

[U] http://point-at-infinity.org/ssss/

[A] Ssss Authors
[M] René Rebe <rene@exactco.de>

[C] extra/base
[F] CROSS

[V] 0.5.7
[L] GPL

[D] ce31e3c53a78f9c5492a907cfe86caf7960412d704057eee59e64a8c ssss-0.5.7.tar.gz https://github.com/MrJoy/ssss/archive/releases/v0.5.7/

makeinstopt=

ssss_install() {
	install -D -m 755 ssss-split $root$bindir/ssss-split
	ln -sf ssss-split $root$bindir/ssss-combine
	if [ -e ssss.1 ]; then
		install -D -m 644 -t $root$mandir/man1 ssss.1 ssss-split.1 ssss-combine.1
	fi
}
hook_add postmake 5 ssss_install
