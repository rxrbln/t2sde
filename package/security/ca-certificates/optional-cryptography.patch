+    from cryptography import x509
+except ImportError:
+    x509 = None
 
 
 objects = []
@@ -122,8 +125,9 @@ for obj in objects:
         if not obj['CKA_LABEL'] in trust or not trust[obj['CKA_LABEL']]:
             continue
 
