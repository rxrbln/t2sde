var_append cmakeopt ' ' -DWITH_XC_DOCS=OFF
var_append GCC_WRAPPER_APPEND ' ' -I$root$(pkgprefix includedir libxcb)
var_append GCC_WRAPPER_INSERT ' ' "-c?:-L$(pkgprefix libdir libx11) -lX11 -lXrender"
