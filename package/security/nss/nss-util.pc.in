prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: NSS-UTIL
Description: Network Security Services Utility Library
Version: @NSS_VERSION@
Requires: nspr >= @NSPR_VERSION@
Libs: -L${libdir} -lnssutil3
Cflags: -I${includedir}
