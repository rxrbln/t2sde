Python 3.13 removed PyEval_CallObject(), PyIOBase_Type is not exported since 3.12.

--- libprelude-5.2.0.orig/bindings/python/_prelude.cxx
+++ libprelude-5.2.0/bindings/python/_prelude.cxx
@@ -366,6 +366,20 @@ SWIGINTERNINLINE int SWIG_CheckState(int
 
 #include <string.h>
 
+/* PyIOBase_Type is not exported since Python 3.12 */
+static PyObject *__prelude_io_base(void)
+{
+  static PyObject *type;
+  if (!type) {
+    PyObject *io = PyImport_ImportModule("io");
+    if (io) {
+      type = PyObject_GetAttrString(io, "IOBase");
+      Py_DECREF(io);
+    }
+  }
+  return type;
+}
+
 #ifdef __cplusplus
 extern "C" {
 #endif
@@ -4112,7 +4126,7 @@ static void _cb_python_log(int level, co
         SWIG_PYTHON_THREAD_BEGIN_BLOCK;
 
         arglist = Py_BuildValue("(i,s)", level, str);
-        result = PyEval_CallObject(__prelude_log_func, arglist);
+        result = PyObject_CallObject(__prelude_log_func, arglist);
 
         Py_DECREF(arglist);
         Py_XDECREF(result);
@@ -17755,8 +17769,7 @@ SWIGINTERN int _wrap_new_IDMEF__SWIG_4(P
     
   }
 #else
-  extern PyTypeObject PyIOBase_Type;
-  if ( ! PyObject_IsInstance((PyObject *) swig_obj[0], (PyObject *) &PyIOBase_Type) ) {
+  if ( ! PyObject_IsInstance((PyObject *) swig_obj[0], __prelude_io_base()) ) {
     SWIG_exception_fail(SWIG_RuntimeError, "Argument is not a file object");
   }
 #endif
@@ -17822,8 +17835,7 @@ check_3:
 #if PY_VERSION_HEX < 0x03000000
       _v = PyFile_Check((PyObject *) argv[0]);
 #else
-      extern PyTypeObject PyIOBase_Type;
-      _v = PyObject_IsInstance((PyObject *) argv[0], (PyObject *) &PyIOBase_Type);
+      _v = PyObject_IsInstance((PyObject *) argv[0], __prelude_io_base());
 #endif
     }
     if (!_v) goto check_4;
@@ -17871,8 +17883,7 @@ SWIGINTERN PyObject *_wrap_IDMEF_write(P
     
   }
 #else
-  extern PyTypeObject PyIOBase_Type;
-  if ( ! PyObject_IsInstance((PyObject *) swig_obj[0], (PyObject *) &PyIOBase_Type) ) {
+  if ( ! PyObject_IsInstance((PyObject *) swig_obj[0], __prelude_io_base()) ) {
     SWIG_exception_fail(SWIG_RuntimeError, "Argument is not a file object");
   }
 #endif
@@ -17919,8 +17930,7 @@ SWIGINTERN PyObject *_wrap_IDMEF_read(Py
     
   }
 #else
-  extern PyTypeObject PyIOBase_Type;
-  if ( ! PyObject_IsInstance((PyObject *) swig_obj[0], (PyObject *) &PyIOBase_Type) ) {
+  if ( ! PyObject_IsInstance((PyObject *) swig_obj[0], __prelude_io_base()) ) {
     SWIG_exception_fail(SWIG_RuntimeError, "Argument is not a file object");
   }
 #endif
@@ -17971,8 +17981,7 @@ SWIGINTERN PyObject *_wrap_IDMEF_readExc
     
   }
 #else
-  extern PyTypeObject PyIOBase_Type;
-  if ( ! PyObject_IsInstance((PyObject *) swig_obj[0], (PyObject *) &PyIOBase_Type) ) {
+  if ( ! PyObject_IsInstance((PyObject *) swig_obj[0], __prelude_io_base()) ) {
     SWIG_exception_fail(SWIG_RuntimeError, "Argument is not a file object");
   }
 #endif
