[I] Client for Cisco VPN3000 Concentrator, IOS and PIX

[T] Vpnc is a VPN client for the Cisco 3000 VPN Concentrator, creating an
[T] IPSec-like connection as a tunneling network device for the local system.
[T] It uses the TUN/TAP driver in Linux kernel 2.4 and above.

[U] https://www.unix-ag.uni-kl.de/~massar/vpnc/

[A] Maurice Massar <massar@unix-ag.uni-kl.de>
[M] René Rebe <rene@exactco.de>

[C] extra/security
[F] CROSS

[L] GPL

[V] 0.5.3

[D] 2d58a0ba0a78df86288a8ba56947de1162bf2c8c2dad5c5ac94a90cd vpnc-0.5.3.tar.gz https://www.unix-ag.uni-kl.de/~massar/vpnc/

hook_add premake 5 "sed -i 's/libgcrypt-config \(--[a-z]*\)/pkg-config \1 libgcrypt/' Makefile"

# the man page is generated from the --long-help output
vpnc_host_man() {
	mkdir -p host-build
	cp -a *.c *.h *.pl Makefile VERSION mk-version vpnc.8.template host-build/
	make -C host-build CC="$BUILDCC" vpnc
	(cd host-build && ./makeman.pl)
	cp host-build/vpnc.8 .
}
if atstage cross; then
	hook_add premake 4 vpnc_host_man
	var_append makeopt ' ' '-o vpnc.8'
	var_append makeinstopt ' ' '-o vpnc.8'
fi
