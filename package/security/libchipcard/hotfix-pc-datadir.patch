Define datadir before pkgdatadir uses it, pkg-config fails on undefined variables.

--- libchipcard-5.1.6.orig/libchipcard-client.pc.in
+++ libchipcard-5.1.6/libchipcard-client.pc.in
@@ -6,9 +6,9 @@ prefix=@prefix@
 exec_prefix=@exec_prefix@
 libdir=@libdir@
 includedir=@includedir@
-pkgdatadir=@lc_client_xml_dir@
 datarootdir=@datarootdir@
 datadir=@datadir@
+pkgdatadir=@lc_client_xml_dir@
 bindir=@bindir@
 sysconfdir=@sysconfdir@
 
