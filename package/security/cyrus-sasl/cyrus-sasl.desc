[I] Legacy release of the Cyrus SASL authentication library

[T] Cyrus SASL is an implementation of the Simple Authentication and
[T] Security Layer API, usable on the client or server side to provide
[T] authentication and authorization services for protocols such as IMAP,
[T] SMTP and LDAP. This package is the old 2.1.21 release.

[U] https://www.cyrusimap.org/sasl/

[A] Cyrus staff at CMU
[M] René Rebe <rene@exactco.de>

[C] base/library
[F] NO-LTO FCOMMON

[L] OpenSource
[V] 2.1.21
[P] X -----5---9 114.100

[D] f601d699ad8c76e8415f70711e548ff0c59e349bfd3fb206dd4b8ac4 cyrus-sasl-2.1.21.tar.gz https://web.archive.org/web/20060519070606id_/http://ftp.andrew.cmu.edu/pub/cyrus-mail/

includedir=$includedir/sasl

var_append confopt ' ' --disable-krb4
var_append confopt ' ' --disable-sample

# have to use gdbm for now since bdb4 isn't supported
var_append confopt ' ' --with-dblib=gdbm

var_append INSTALL_WRAPPER_FILTER '|' \
	'sed -e "s,man3/sasl,man3/sasl1,g" -e "s,man8/sasl,man8/sasl1,g"'

hook_add postinstall 3 "cd $includedir; ln -sf . include"
