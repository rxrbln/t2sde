[I] A command-line ftp upload utility

[T] Wput is the opposite of wget, capable of uploading files to FTP servers
[T] with an easy to use command line interface similar to wget's interface.

[U] https://wput.sourceforge.net

[A] Hagen Fritsch <itooktheredpill@gmx.de>
[M] Michael Tross <michael@tross.org>

[C] extra/network
[F] CROSS FCOMMON

[L] GPL
[V] 0.6.2

[D] 2663440b11b7206a4e61210e3391d8d83be187ec60ad7c79ba6b9547 wput-0.6.2.tgz https://prdownloads.sourceforge.net/sourceforge/wput/

makeinstopt=

# the Makefile installs without DESTDIR
wput_install() {
	$MAKE -C po DESTDIR=$root install
	install -D -m 755 wput $root$bindir/wput
	ln -sf wput $root$bindir/wdel
	install -D -m 644 -t $root$mandir/man1 doc/wput.1.gz doc/wdel.1.gz
}
hook_add postmake 5 wput_install
