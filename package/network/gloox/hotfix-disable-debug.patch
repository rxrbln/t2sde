--disable-debug enabled debugging, -g3 -fno-inline -DDEBUG then also leaked into
gloox.pc, breaking users like 0ad with its release SpiderMonkey.

--- gloox-1.0.28.orig/configure.ac
+++ gloox-1.0.28/configure.ac
@@ -304,7 +304,7 @@ debug="no"
 AC_ARG_ENABLE( debug,
                [AC_HELP_STRING([--enable-debug],
                                [turn on debugging [default=no]])],
-               [debug="yes"] )
+               [debug="$enableval"] )
 if test "x$debug" = "xyes"; then
       CPPFLAGS="$CPPFLAGS -g3 -fno-inline -DDEBUG"
 fi
