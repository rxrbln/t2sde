--- a/configure.ac	2026-10-19 16:55:37.853287183 +0200
+++ b/configure.ac	2026-10-19 16:55:37.889318598 +0200
@@ -1219,7 +1219,7 @@ AC_RUN_IFELSE([AC_LANG_PROGRAM([[
                                ]])],
               [AC_MSG_RESULT([yes])],
               [AC_MSG_ERROR([strerror() is not C99-compliant])],
-              [AC_MSG_ERROR([strerror() is not C99-compliant])])
+              [AC_MSG_RESULT([assuming yes when cross compiling])])
 
 AC_RUN_IFELSE([AC_LANG_PROGRAM([[#include <stdio.h>]], [[
     const char *s = "some-command-line-arg";
@@ -1229,7 +1229,7 @@ AC_RUN_IFELSE([AC_LANG_PROGRAM([[#includ
                                ]])],
               [have_sscanf_m="yes"],
               [have_sscanf_m="no"],
-              [have_sscanf_m="no"])
+              [have_sscanf_m="yes"])
 AS_IF([test x"$have_sscanf_m" = x"yes"],
       [AC_DEFINE([HAVE_SSCANF_M], [1],
                  [Define to 1 if sscanf %m modifier is available])])
@@ -1247,7 +1247,7 @@ AC_RUN_IFELSE([AC_LANG_PROGRAM([[#includ
                                ]])],
               [have_strftime_width="yes"],
               [have_strftime_width="no"],
-              [have_strftime_width="no"])
+              [have_strftime_width="yes"])
 AS_IF([test x"$have_strftime_width" = x"yes"],
       [AC_DEFINE([HAVE_STRFTIME_WIDTH], [1],
                  [Define to 1 if strftime supports field width])])
