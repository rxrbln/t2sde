 $(LIB): $(OFILES)
--- a/posix-port/tas.c	1970-01-01 01:00:00.000000000 +0100
+++ b/posix-port/tas.c	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,18 @@
+#include "u.h"
+#include "libc.h"
+
+int
+tas(int *x)
+{
+	int v;
+
+	v = __atomic_exchange_n(x, 1, __ATOMIC_ACQUIRE);
+	switch(v) {
+	case 0:
+	case 1:
+		return v;
+	default:
+		print("canlock: corrupted 0x%lux\n", v);
+		return 1;
+	}
+}
