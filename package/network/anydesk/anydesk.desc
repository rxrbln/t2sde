[I] Remote desktop application

[T] AnyDesk is a proprietary remote desktop application providing remote
[T] access, file transfer and VPN functionality. This package installs the
[T] upstream generic Linux build, which is statically linked against its
[T] own Qt and needs no additional libraries.

[U] https://anydesk.com

[A] AnyDesk Software GmbH
[M] Dennie Mahne <dennie.mahne@gmail.com>

[C] extra/network
[F] BINARY
[R] + x86-64

[L] Free-to-use
[V] 6.4.2

[D] afad343192c372bdc473f53c5e1fd337271f3ca72ec19cc4892cb9d9 anydesk-6.4.2-amd64.tar.gz https://download.anydesk.com/linux/

# prebuilt binary
runmake=0

pkg_anydesk_main() {
	install -D -C -v -m 755 anydesk $root$libdir/anydesk/anydesk

	rm -f $root$bindir/anydesk
	cat > $root$bindir/anydesk <<-EOT
	#!/bin/sh
	export QT_QPA_PLATFORM="\${QT_QPA_PLATFORM:-xcb}"
	exec $root$libdir/anydesk/anydesk "\$@"
	EOT
	chmod 755 $root$bindir/anydesk

	install -D -m 644 anydesk.desktop \
		$root$datadir/applications/anydesk.desktop

	local i
	for i in icons/hicolor/*/apps/anydesk.png; do
		[ -e "$i" ] || continue
		install -D -m 644 "$i" "$root$datadir/${i#icons/}"
	done

	for i in icons/hicolor/*/apps/anydesk.png; do
		[ -e "$i" ] || continue
		install -D -m 644 "$i" "$root$datadir/icons/${i#icons/}"
	done

	install -D -m 644 polkit-1/com.anydesk.anydesk.policy \
		$root$datadir/polkit-1/actions/com.anydesk.anydesk.policy

	install -D -m 644 systemd/anydesk.service \
		$root$(pkgprefix systemd)/lib/systemd/system/anydesk.service

	#install -D -m 644 init/anydesk \
	#	$root/etc/init.d/anydesk
}
hook_add inmake 5 pkg_anydesk_main
