[I] The easiest, most secure way to use WireGuard and 2FA

[T] The easiest, most secure way to use WireGuard and 2FA.

[U] https://tailscale.com/

[A] Tailscale Authors
[M] René Rebe <rene@exactco.de>

[C] extra/base
[R] + arm arm64 loongarch64 mips mips64 powerpc64 riscv64 s390x x86 x86-64

[L] BSD
[V] 1.104.4

[D] c93652aa27105835eea86cbecc09c6eb3f2267d194fc235e07146587 tailscale-1.104.4.tar.gz https://github.com/tailscale/tailscale/archive/v1.104.4/

. $base/package/*/*/go-conf.in

hook_add preconf 5 'rm -rf cmd/tsshd'
var_append goconfopt ' ' '-o bin/ ./cmd/*'
hook_add postmake 5 tailscale_postmake

tailscale_postmake() {
	for x in bin/*; do
		cmd="${x##*/}"
		[[ "$cmd" != "tailscale"* ]] && cmd="${pkg}-${cmd}"
		cp -v $x $root$bindir/${cmd}
	done
}
