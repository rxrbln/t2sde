[I] The Apple reference Zeroconf implementation

[T] Zeroconf lets you create an instant network of computers and smart
[T] devices just by getting them connected to each other.
[T]
[T] The computers and devices take over from there, automatically broadcasting
[T] and discovering what services each is offering for the use of others.

[U] https://github.com/apple-oss-distributions/mDNSResponder

[A] Apple Computer, Inc.
[M] René Rebe <rene@exactco.de>

[F] CROSS
[C] extra/network

[L] APSL
[V] 2881.120.11
[P] X -----5---9 128.750

[D] dc71d02bdbf5cf577906f5a9cf5787de7ce0340b149db2388eee0f28 mDNSResponder-2881.120.11.tar.gz https://github.com/apple-oss-distributions/mDNSResponder/archive/

hook_add preconf 3 "cd mDNSPosix"
var_insert makeopt ' ' os=linux
var_append makeopt ' ' 'LD=$CC'
var_append CC_WRAPPER_APPEND ' ' -std=gnu17
makeinstopt="$makeopt INSTBASE=$root/$prefix NSSINSTPATH=$root$libdir InstalledDaemon InstalledLib InstalledManPages InstalledNSS"

mdns_cross_install() {
	install -Dm755 build/prod/mdnsd $root/$prefix/sbin/mdnsd
	install -Dm755 build/prod/libdns_sd.so $root$libdir/libdns_sd.so.1
	ln -sf libdns_sd.so.1 $root$libdir/libdns_sd.so
	install -Dm644 ../mDNSShared/dns_sd.h $root$includedir/dns_sd.h
	install -Dm644 ../mDNSShared/mDNSResponder.8 $root$mandir/man8/mdnsd.8
	install -Dm755 build/prod/libnss_mdns-0.2.so $root$libdir/libnss_mdns-0.2.so
	ln -sf libnss_mdns-0.2.so $root$libdir/libnss_mdns.so.2
	install -Dm644 nss_mdns.conf $root/etc/nss_mdns.conf
	install -Dm644 nss_mdns.conf.5 $root$mandir/man5/nss_mdns.conf.5
	install -Dm644 libnss_mdns.8 $root$mandir/man8/libnss_mdns.8
}

# the upstream install targets restart the daemon and edit the host nsswitch.conf
atstage cross && var_append makeopt ' ' 'all nss_mdns'
atstage cross && makeinstopt= && hook_add postmake 5 mdns_cross_install
