The pango pkg-config module is pango, not the library name pango-1.0, the
giomm include dir lookup lacked its pkg-config hints and the giomm library
lookup used the include hints, they were only found below /usr.

diff -urp a/cmake/Findglibmm.cmake b/cmake/Findglibmm.cmake
--- a/cmake/Findglibmm.cmake	2026-11-25 13:07:47.561576539 +0000
+++ b/cmake/Findglibmm.cmake	2026-11-25 13:08:18.589961540 +0000
@@ -38,6 +38,7 @@ find_library(GLIBMM_LIBRARY
 
 find_path(GIOMM_INCLUDE_DIR
           NAMES giomm.h
+          HINTS ${GIOMM_INCLUDE_HINTS}
           PATH_SUFFIXES ${GIOMM_LIBRARY_NAME})
 
 find_path(GIOMM_CONFIG_INCLUDE_DIR
@@ -49,7 +50,7 @@ find_path(GIOMM_CONFIG_INCLUDE_DIR
 find_library(GIOMM_LIBRARY
              NAMES ${GIOMM_LIBRARY_NAME}
                    giomm
-             HINTS ${GIOMM_INCLUDE_HINTS}
+             HINTS ${GIOMM_LIBRARY_HINTS}
                    /usr/lib
                    /usr/local/lib
                    /opt/local/lib
diff -urp a/cmake/Findpango.cmake b/cmake/Findpango.cmake
--- a/cmake/Findpango.cmake	2026-11-25 13:07:16.023823180 +0000
+++ b/cmake/Findpango.cmake	2026-11-25 13:07:16.191821871 +0000
@@ -8,7 +8,7 @@ find_package(Freetype)
 
 find_package(PkgConfig)
 if (PKG_CONFIG_FOUND)
-  pkg_check_modules(PC_PANGO QUIET ${PANGO_LIBRARY_NAME})
+  pkg_check_modules(PC_PANGO QUIET pango)
   set(PANGO_DEFINITIONS ${PC_PANGO_CFLAGS_OTHER})
 endif (PKG_CONFIG_FOUND)
 
