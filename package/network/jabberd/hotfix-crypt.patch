crypt() is no longer declared in unistd.h, crypt.h of libxcrypt clashes with the
bundled crypt_blowfish.h.

--- jabberd-2.7.0.orig/storage/authreg_ldapfull.c
+++ jabberd-2.7.0/storage/authreg_ldapfull.c
@@ -35,6 +35,7 @@
 #ifdef STORAGE_LDAP
 #ifdef HAVE_CRYPT
 #include <unistd.h>
+char *crypt(const char *key, const char *salt);
 #endif
 
 #ifdef HAVE_SSL
--- jabberd-2.7.0.orig/storage/authreg_mysql.c
+++ jabberd-2.7.0/storage/authreg_mysql.c
@@ -34,6 +34,7 @@
 #else
 #ifdef HAVE_CRYPT
 #include <unistd.h>
+char *crypt(const char *key, const char *salt);
 #endif
 #endif
 
--- jabberd-2.7.0.orig/storage/authreg_pgsql.c
+++ jabberd-2.7.0/storage/authreg_pgsql.c
@@ -32,6 +32,7 @@
 #else
 #ifdef HAVE_CRYPT
 #include <unistd.h>
+char *crypt(const char *key, const char *salt);
 #endif
 #endif
 
--- jabberd-2.7.0.orig/storage/authreg_sqlite.c
+++ jabberd-2.7.0/storage/authreg_sqlite.c
@@ -41,6 +41,7 @@
 #else
 #ifdef HAVE_CRYPT
 #include <unistd.h>
+char *crypt(const char *key, const char *salt);
 #endif
 #endif
 
