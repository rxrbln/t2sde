[I] An application for file copying over the OBEX protocol

[T] Free open source application for file copying over the Object Exchange
[T] (OBEX) protocol.

[U] https://triq.net/obex/

[A] Christian W. Zuckschwerdt <zany@triq.net>
[M] René Rebe <rene@exactco.de>

[C] extra/filesystem
[F] CROSS

[L] GPL
[V] 0.24.2

[D] eaf812d7e33922cef872668037f66e25554a9b6d30e861bd748273ab obexftp-0.24.2-Source.tar.gz https://download.sourceforge.net/project/openobex/obexftp/0.24.2/

var_append GCC_WRAPPER_APPEND ' ' -Wno-int-conversion

# crctable generates a source file at build time
obexftp_crctable() {
	$BUILDCC -std=gnu17 -o $builddir/crctable bfb/crcmodel.c bfb/crctable.c || return 1
	var_append cmakeopt ' ' -DCRCTABLE_EXECUTABLE=$builddir/crctable
}
atstage cross && hook_add preconf 5 obexftp_crctable
