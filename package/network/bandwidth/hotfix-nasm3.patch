NASM 3 treats cpu ia64 as the Itanium IA-32 level, which rejects cpuid and
the SIMD instructions, the highest level in NASM 2 is spelled all.

diff -urp a/OOC/utility-x86-32bit.asm b/OOC/utility-x86-32bit.asm
--- a/OOC/utility-x86-32bit.asm	2026-11-25 15:03:21.148582543 +0000
+++ b/OOC/utility-x86-32bit.asm	2026-11-25 15:03:21.185777200 +0000
@@ -19,7 +19,7 @@
 ;=============================================================================
 
 bits	32
-cpu	ia64
+cpu	all
 
 global	_get_cpuid1_ecx
 global	_get_cpuid1_edx
diff -urp a/OOC/utility-x86-64bit.asm b/OOC/utility-x86-64bit.asm
--- a/OOC/utility-x86-64bit.asm	2026-11-25 15:03:21.194777165 +0000
+++ b/OOC/utility-x86-64bit.asm	2026-11-25 15:03:21.229777030 +0000
@@ -19,7 +19,7 @@
 ;=============================================================================
 
 bits	64
-cpu	ia64
+cpu	all
 
 ; Note:
 ; Unix ABI says integer param are put in these registers in this order:
diff -urp a/routines-x86-32bit.asm b/routines-x86-32bit.asm
--- a/routines-x86-32bit.asm	2026-11-25 15:03:21.316776695 +0000
+++ b/routines-x86-32bit.asm	2026-11-25 15:03:21.319776684 +0000
@@ -20,7 +20,7 @@
 ;=============================================================================
 
 bits	32
-cpu	ia64
+cpu	all
 
 global  IncrementRegisters
 global  _IncrementRegisters
diff -urp a/routines-x86-64bit.asm b/routines-x86-64bit.asm
--- a/routines-x86-64bit.asm	2026-11-25 15:03:21.271788211 +0000
+++ b/routines-x86-64bit.asm	2026-11-25 15:03:21.273776861 +0000
@@ -38,7 +38,7 @@
 %endif
 
 bits	64
-cpu	ia64
+cpu	all
 
 global	CopyWithMainRegisters
 global	_CopyWithMainRegisters
