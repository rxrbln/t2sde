Store the last brand string register at offset 44, offset 48 overflowed the
49 byte buffer, detected by the stack protector.

diff -urp a/OOC/utility-x86-32bit.asm b/OOC/utility-x86-32bit.asm
--- a/OOC/utility-x86-32bit.asm	2026-11-25 15:07:38.032679837 +0000
+++ b/OOC/utility-x86-32bit.asm	2026-11-25 15:07:38.077776475 +0000
@@ -97,7 +97,7 @@ _get_cpuid_model:
 	mov	[esi+32], eax
 	mov	[esi+36], ebx
 	mov	[esi+40], ecx
-	mov	[esi+48], edx
+	mov	[esi+44], edx
 	
 	pop	edx
 	pop	ecx
diff -urp a/OOC/utility-x86-64bit.asm b/OOC/utility-x86-64bit.asm
--- a/OOC/utility-x86-64bit.asm	2026-11-25 15:05:41.179909066 +0000
+++ b/OOC/utility-x86-64bit.asm	2026-11-25 15:05:41.220141899 +0000
@@ -256,7 +256,7 @@ _get_cpuid_model:
 	mov	[rdi+32], eax
 	mov	[rdi+36], ebx
 	mov	[rdi+40], ecx
-	mov	[rdi+48], edx
+	mov	[rdi+44], edx
 	
 	pop	rdi
 	pop	rdx
