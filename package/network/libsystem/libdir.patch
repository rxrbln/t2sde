Take the library directory name for the pkg-config file from LIBDIRNAME,
and drop the shipped libSystem.pc generated for /usr/local.

diff -urpN a/data/libSystem.pc b/data/libSystem.pc
--- a/data/libSystem.pc	2026-11-24 22:10:38.441884955 +0000
+++ b/data/libSystem.pc	1970-01-01 00:00:00.000000000 +0000
@@ -1,10 +0,0 @@
-prefix=/usr/local
-includedir=${prefix}/include
-exec_prefix=${prefix}
-libdir=${exec_prefix}/lib
-
-Name: libSystem
-Description: DeforaOS System essential library
-Version: 0.1.6
-Cflags: -I${includedir}
-Libs: -L${libdir} -Wl,-rpath-link,${libdir} -Wl,-rpath,${libdir} -lSystem
diff -urpN a/data/libSystem.pc.in b/data/libSystem.pc.in
--- a/data/libSystem.pc.in	2026-11-24 22:10:38.434885017 +0000
+++ b/data/libSystem.pc.in	2026-11-24 22:10:38.455315815 +0000
@@ -1,7 +1,7 @@
 prefix=PREFIX
 includedir=${prefix}/include
 exec_prefix=${prefix}
-libdir=${exec_prefix}/lib
+libdir=${exec_prefix}/LIBDIRNAME
 
 Name: libSystem
 Description: DeforaOS System essential library
diff -urpN a/data/pkgconfig.sh b/data/pkgconfig.sh
--- a/data/pkgconfig.sh	2026-11-24 22:10:38.429555211 +0000
+++ b/data/pkgconfig.sh	2026-11-24 22:10:38.455281135 +0000
@@ -58,7 +58,8 @@ while [ $# -gt 0 ]; do
 	shift
 done
 
-PKGCONFIG="$PREFIX/lib/pkgconfig"
+[ -n "$LIBDIRNAME" ] || LIBDIRNAME="lib"
+PKGCONFIG="$PREFIX/$LIBDIRNAME/pkgconfig"
 while [ $# -gt 0 ]; do
 	target="$1"
 	shift
@@ -77,6 +78,7 @@ while [ $# -gt 0 ]; do
 	fi
 
 	#create
-	$SED -e "s,PREFIX,$PREFIX," -e "s,VERSION,$VERSION," "$target.in" \
+	$SED -e "s,PREFIX,$PREFIX," -e "s,VERSION,$VERSION," \
+		-e "s,LIBDIRNAME,$LIBDIRNAME," "$target.in" \
 		> "$target"					|| exit 2
 done
