[I] All-in-one voice and text chat for gamers

[T] Discord is a proprietary voice, video and text chat client. The Linux
[T] tarball ships a small bootstrap and updater; the Electron application
[T] itself is fetched into the user's home directory on first start, so no
[T] system Electron is required.

[U] https://discord.com

[A] Discord Inc.
[M] Dennie Mahne <dennie.mahne@gmail.com>

[C] extra/network
[F] BINARY
[R] + x86-64

[L] Free-to-use
[V] 1.0.149

[D] 55355befdce6278e2c743ae46b41375d16c21d434e0758ee1e29cd1c discord-1.0.149.tar.gz https://stable.dl2.discordapp.net/apps/linux/1.0.149/

# prebuilt bootstrap
runmake=0

pkg_discord_main() {
	prefix=/usr	

	mkdir -p $root$prefix/lib/discord
	install -D -m 755 discord \
		$root$prefix/lib/discord/discord
	install -D -m 755 updater_bootstrap \
		$root$prefix/lib/discord/updater_bootstrap	
	cp -fv discord.png $root$prefix/lib/discord/

	rm -f $root$bindir/discord
	cat > $root$bindir/discord <<-EOT
	#!/bin/sh
	export QT_QPA_PLATFORM="\${QT_QPA_PLATFORM:-xcb}"
	exec $prefix/lib/discord/discord \
		--ozone-platform-hint="\${OZONE_PLATFORM_HINT:-x11}" "\$@"
	EOT
	chmod 755 $root$bindir/discord

	install -D -m 644 discord.png \
		$root$datadir/icons/hicolor/256x256/apps/discord.png

	sed -e "s,^Exec=.*,Exec=$root$bindir/discord %U," \
		-e 's,^Icon=.*,Icon=discord,' \
		discord.desktop > $root$datadir/applications/discord.desktop

}
hook_add inmake 5 pkg_discord_main
