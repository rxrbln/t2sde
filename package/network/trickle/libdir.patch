Look for trickle-overload.so in $libdir/trickle where it is installed, not
in $prefix/lib/trickle.

--- a/configure.in
+++ b/configure.in
@@ -213,7 +213,10 @@ else
     csysconfdir="$sysconfdir"
 fi
 
-clibdir="$prefix/lib/trickle"
+test "x$prefix" = xNONE && prefix="$ac_default_prefix"
+test "x$exec_prefix" = xNONE && exec_prefix="$prefix"
+eval clibdir="$libdir"
+eval clibdir="$clibdir/trickle"
 
 AC_DEFINE_UNQUOTED(SYSCONFDIR, "$csysconfdir")
 AC_DEFINE_UNQUOTED(LIBDIR, "$clibdir")
