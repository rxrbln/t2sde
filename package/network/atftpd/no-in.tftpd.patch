Do not install in.tftpd links, that name belongs to tftp-hpa.

--- atftp-0.7.dfsg/Makefile.am.orig
+++ atftp-0.7.dfsg/Makefile.am
@@ -38,13 +38,10 @@ atftpd_SOURCES   = tftpd.c logger.c opti
 		   tftpd_mtftp.c
 
 install-exec-hook:
-	(cd $(DESTDIR)$(sbindir) && ln -s atftpd in.tftpd)
 
 install-data-hook:
-	(cd $(DESTDIR)$(mandir)/man8 && ln -s atftpd.8 in.tftpd.8)
 
 uninstall-local:
-	rm -f $(DESTDIR)$(sbindir)/in.tftpd $(DESTDIR)$(mandir)/man8/in.tftpd.8
 
 dist-hook:
 	cd $(distdir) && rm -rf `find . -type d -name CVS`
--- atftp-0.7.dfsg/Makefile.in.orig
+++ atftp-0.7.dfsg/Makefile.in
@@ -854,13 +854,10 @@ uninstall-man: uninstall-man1 uninstall-
 
 
 install-exec-hook:
-	(cd $(DESTDIR)$(sbindir) && ln -s atftpd in.tftpd)
 
 install-data-hook:
-	(cd $(DESTDIR)$(mandir)/man8 && ln -s atftpd.8 in.tftpd.8)
 
 uninstall-local:
-	rm -f $(DESTDIR)$(sbindir)/in.tftpd $(DESTDIR)$(mandir)/man8/in.tftpd.8
 
 dist-hook:
 	cd $(distdir) && rm -rf `find . -type d -name CVS`
