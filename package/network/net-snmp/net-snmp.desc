[I] NET-SNMP / UCD-SNMP

[T] This is the NET-SNMP distribution. This includes the SNMP library, many
[T] client applications, and supporting documentation. It is the continued
[T] development of CMU-SNMP and UCD-SNMP.

[U] http://www.net-snmp.org/

[A] Carnegie Mellon University
[M] René Rebe <rene@exactco.de>

[C] extra/network
[F] NO-LTO.gcc NOPARALLEL CROSS

[L] OpenSource
[V] 5.9.5.2
[P] X -----5---9 133.500

[D] fe14d4f17a94130d6f2837f0ce0f1abeea5e17c79b89bffd3d34848a net-snmp-5.9.5.2.tar.gz https://prdownloads.sourceforge.net/sourceforge/net-snmp/

# optional bdb support never detected (enable?)
# Use defaults for prompted values
var_append confopt ' ' --with-defaults
# optional tcp_wrappers support
pkginstalled tcp_wrappers && var_append confopt ' ' --with-libwrap
# install SNMP perl module
if atstage cross; then
	var_append confopt ' ' "--disable-embedded-perl --without-perl-modules"
else
	pkginstalled perl && var_append confopt ' ' --with-perl-modules
fi

var_append makeopt ' ' 'RANLIB=:'
var_append makeinstopt ' ' 'RANLIB=:'
