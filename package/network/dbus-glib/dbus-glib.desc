[I] GLib bindings for D-Bus

[T] The deprecated GLib bindings for the D-Bus message bus. New code should
[T] use GDBus from GLib's GIO.

[U] https://freedesktop.org/wiki/Software/dbus

[A] Havoc Pennington <hp@redhat.com>
[M] Juergen "George" Sawinski <jsaw@gmx.net>

[C] extra/network
[F] CROSS NO-AS-NEEDED NO-LTO

[E] opt gtk-doc

[L] GPL
[V] 0.116
[P] X -----5---9 136.820

[D] 8228472bbe86dbb24bfabf7f76008c63a8d44da51194778fc66fdcf1 dbus-glib-0.116.tar.gz https://dbus.freedesktop.org/releases/dbus-glib/

if atstage cross; then
	hook_add preconf 5 "echo 'ac_cv_func_posix_getpwnam_r=yes' >> config.cache"
	var_append makeopt ' ' DBUS_BINDING_TOOL=dbus-binding-tool
fi

pkginstalled pyrexc && var_append confopt ' ' --enable-python

hook_add premake 5 'cp -v $confdir/dbus-bus-introspect.xml tools/'
