Install the .pc file into CMAKE_INSTALL_LIBDIR, as the library, not lib.

--- libpcap-1.11.1.orig/CMakeLists.txt
+++ libpcap-1.11.1/CMakeLists.txt
@@ -3602,7 +3602,7 @@ if(NOT MSVC)
     configure_file(${CMAKE_CURRENT_SOURCE_DIR}/pcap-config.in ${CMAKE_CURRENT_BINARY_DIR}/pcap-config @ONLY)
     configure_file(${CMAKE_CURRENT_SOURCE_DIR}/libpcap.pc.in ${CMAKE_CURRENT_BINARY_DIR}/libpcap.pc @ONLY)
     install(PROGRAMS ${CMAKE_CURRENT_BINARY_DIR}/pcap-config DESTINATION bin)
-    install(FILES ${CMAKE_CURRENT_BINARY_DIR}/libpcap.pc DESTINATION lib/pkgconfig)
+    install(FILES ${CMAKE_CURRENT_BINARY_DIR}/libpcap.pc DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig)
 
     #
     # Man pages.
