groff 1.25 warns about the trailing n of inch units like 0.15in (the unit is i)
and tbl about the empty entry after the trailing ; of the OXM class rows, the
manpage-check fails on these warnings.

--- openvswitch-4.0.0.orig/build-aux/extract-ofp-fields
+++ openvswitch-4.0.0/build-aux/extract-ofp-fields
@@ -342,7 +342,7 @@ Prefix;Vendor;Class
             s += r"\fL0x%08x\fR;" % vendor
         else:
             s += "(none);"
-        s += r"\fL0x%04x\fR;" % class_
+        s += r"\fL0x%04x\fR" % class_
         s += "\n"
     e = document.createElement("tbl")
     e.appendChild(document.createTextNode(s))
@@ -378,7 +378,7 @@ def make_ovs_fields(meta_flow_h, meta_fl
 .fp 5 L CR              \" Make fixed-width font available as \fL.
 .de ST
 .  PP
-.  RS -0.15in
+.  RS -0.15i
 .  I "\\$1"
 .  RE
 ..
--- openvswitch-4.0.0.orig/build-aux/xml2nroff
+++ openvswitch-4.0.0/build-aux/xml2nroff
@@ -86,7 +86,7 @@ def manpage_to_nroff(xml_file, subst, in
 ..
 .de ST
 .  PP
-.  RS -0.15in
+.  RS -0.15i
 .  I "\\$1"
 .  RE
 ..
--- openvswitch-4.0.0.orig/lib/ovs.tmac
+++ openvswitch-4.0.0/lib/ovs.tmac
@@ -14,7 +14,7 @@
 .\" Introduces a sub-subsection
 .de ST
 .  PP
-.  RS -0.15in
+.  RS -0.15i
 .  I "\\$1"
 .  RE
 ..
--- openvswitch-4.0.0.orig/ovsdb/ovsdb-doc
+++ openvswitch-4.0.0/ovsdb/ovsdb-doc
@@ -126,9 +126,9 @@ def tableSummaryToNroff(summary, level=0
     s = ""
     for type, name, arg in summary:
         if type == 'column':
-            s += ".TQ %.2fin\n\\fB%s\\fR\n%s\n" % (3 - level * .25, name, arg)
+            s += ".TQ %.2fi\n\\fB%s\\fR\n%s\n" % (3 - level * .25, name, arg)
         else:
-            s += ".TQ .25in\n\\fI%s:\\fR\n.RS .25in\n" % name
+            s += ".TQ .25i\n\\fI%s:\\fR\n.RS .25i\n" % name
             s += tableSummaryToNroff(arg, level + 1)
             s += ".RE\n"
     return s
@@ -184,7 +184,7 @@ def docsToNroff(schemaFile, xmlFile, erF
 ..
 .de ST
 .  PP
-.  RS -0.15in
+.  RS -0.15i
 .  I "\\$1"
 .  RE
 ..
@@ -224,12 +224,12 @@ def docsToNroff(schemaFile, xmlFile, erF
 The following list summarizes the purpose of each of the tables in the
 \fB%s\fR database.  Each table is described in more detail on a later
 page.
-.IP "Table" 1in
+.IP "Table" 1i
 Purpose
 """ % schema.name
     for name, title in summary:
         s += r"""
-.TQ 1in
+.TQ 1i
 \fB%s\fR
 %s
 """ % (name, text_to_nroff(title))
@@ -249,7 +249,7 @@ represents.  Edges are labeled with thei
 constraint on the number of allowed values: \fB?\fR for zero or one,
 \fB*\fR for zero or more, \fB+\fR for one or more.  Thick lines
 represent strong references; thin lines represent weak references.
-.RS -1in
+.RS -1i
 """
         erStream = open(erFile, "r")
         for line in erStream:
--- openvswitch-4.0.0.orig/python/ovs_build_helpers/nroff.py
+++ openvswitch-4.0.0/python/ovs_build_helpers/nroff.py
@@ -321,7 +321,7 @@ def block_xml_to_nroff(nodes, para='.PP'
                         if node.tagName == 'ul':
                             s += ".IP \\(bu\n"
                         else:
-                            s += ".IP %d. .4in\n" % i
+                            s += ".IP %d. .4i\n" % i
                         s += block_xml_to_nroff(li_node.childNodes, ".IP")
                     elif li_node.nodeType == node.COMMENT_NODE:
                         pass
@@ -345,7 +345,7 @@ def block_xml_to_nroff(nodes, para='.PP'
                         if prev == 'dd':
                             s += '.TP\n'
                         else:
-                            s += '.TQ .5in\n'
+                            s += '.TQ .5i\n'
                         prev = 'dt'
                     elif (li_node.nodeType == node.ELEMENT_NODE
                           and li_node.tagName == 'dd'):
--- openvswitch-4.0.0.orig/utilities/ovs-kmod-ctl.8
+++ openvswitch-4.0.0/utilities/ovs-kmod-ctl.8
@@ -6,7 +6,7 @@
 ..
