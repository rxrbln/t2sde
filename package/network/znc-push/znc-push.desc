[I] Push notification service module for ZNC

[T] Push notification service module for ZNC.

[U] https://wiki.znc.in/Push

[A] Znc-push Authors
[M] René Rebe <rene@exactco.de>

[C] extra/base
[F] CROSS

[V] 2.0.0-dev
[L] MIT

[D] a3e497d7c08121a1dbf0717ead0e93ff0bfa10af23c996ab717d209a znc-push-2.0.0-dev.tar.gz https://github.com/jreese/znc-push/archive/21c4da3b3173c0138f5c9e49ae9863a70600518b/

runmake=0

# znc-buildmod generates a native CMake project, the install goes to $HOME
znc_push_flags=
pkginstalled curl && znc_push_flags="-DUSE_CURL -lcurl"
znc_push_build() {
	$CXX -std=c++17 -O2 -fPIC -shared $(pkg-config --cflags znc) \
		-DPUSHVERSION="\"$ver\"" push.cpp -o push.so $znc_push_flags
	install -D -m 755 push.so $root$libdir/znc/push.so
}
hook_add inmake 5 znc_push_build
