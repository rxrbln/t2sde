Include the headers declaring localtime, strftime, mcheck and memcpy, the
implicit int localtime truncated the returned pointer on 64-bit.

diff -urp a/ez-ipupdate.c b/ez-ipupdate.c
--- a/ez-ipupdate.c	2002-03-11 23:31:47.000000000 +0000
+++ b/ez-ipupdate.c	2026-11-24 22:00:53.928818644 +0000
@@ -121,6 +121,10 @@
 #include <string.h>
 #include <ctype.h>
 #include <unistd.h>
+#include <time.h>
+#if defined(DEBUG) && defined(__linux__)
+#  include <mcheck.h>
+#endif
 #if HAVE_FCNTL_H
 #  include <fcntl.h>
 #endif
diff -urp a/md5.c b/md5.c
--- a/md5.c	2000-08-08 07:09:48.000000000 +0000
+++ b/md5.c	2026-11-24 22:00:53.928905863 +0000
@@ -27,11 +27,7 @@
 #ifdef USE_MD5
 
 #include <stdlib.h>
-#ifdef HAVE_STRING_H
-# include <string.h>
-#else
-# include <strings.h>
-#endif
+#include <string.h>
 
 #include "md5.h"
 
