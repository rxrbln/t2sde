[I] Asynchronous DNS stub resolver library

[T] UDNS is a stub DNS resolver library with the ability to perform both
[T] synchronous and asynchronous DNS queries, used by jabberd.

[U] https://www.corpit.ru/mjt/udns.html

[A] Michael Tokarev
[M] René Rebe <rene@exactco.de>

[C] extra/network
[F] CROSS

[L] LGPL
[V] 0.7
[P] X -----5---9 140.000

[D] 150f09d8d24394b40a80f81e344210ecacc7b42581d4b88049acc520 udns-0.7.tar.gz https://www.corpit.ru/mjt/udns/

runconf=0 runmake=0

# no install target, build and install the shared library and tools manually
udns_main() {
	./configure
	eval make $makeopt sharedlib dnsget_s rblcheck_s
	install -Dvm644 udns.h $root$includedir/udns.h
	install -Dvm755 libudns.so.0 $root$libdir/libudns.so.0
	ln -sfv libudns.so.0 $root$libdir/libudns.so
	install -Dvm755 dnsget_s $root$bindir/dnsget
	install -Dvm755 rblcheck_s $root$bindir/rblcheck
	install -Dvm644 udns.3 $root$mandir/man3/udns.3
	install -Dvm644 -t $root$mandir/man1 dnsget.1 rblcheck.1
}
hook_add inmake 5 udns_main
