OpenCV 5 removed the TensorFlow importer, readNet() still loads it with
OpenCV 4 and throws with 5, so the aesthetic detection is just unavailable.

--- a/core/libs/imgqsort/detectors/aesthetic_detector.cpp
+++ b/core/libs/imgqsort/detectors/aesthetic_detector.cpp
@@ -149,11 +149,11 @@ bool AestheticDetector::s_loadModel()
 
 #ifdef Q_OS_WIN
 
-            s_model = cv::dnn::readNetFromTensorflow(nnmodel.toLocal8Bit().constData());
+            s_model = cv::dnn::readNet(nnmodel.toLocal8Bit().constData());
 
 #else
 
-            s_model = cv::dnn::readNetFromTensorflow(nnmodel.toStdString());
+            s_model = cv::dnn::readNet(nnmodel.toStdString());
 
 #endif
             s_model.setPreferableBackend(cv::dnn::DNN_TARGET_CPU);
--- a/core/tests/imgqsort/NIMA_inference_cli.cpp
+++ b/core/tests/imgqsort/NIMA_inference_cli.cpp
@@ -47,7 +47,7 @@ int main(int argc, char** argv)
         return -1;
     }
 
-    cv::dnn::Net net = cv::dnn::readNetFromTensorflow(argv[2]);
+    cv::dnn::Net net = cv::dnn::readNet(argv[2]);
 
     if (net.empty())
     {
