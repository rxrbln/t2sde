[I] Qt client library for the accounts database

[T] Qt based client library to access the accounts and services of the
[T] accounts-sso online accounts database.

[U] https://gitlab.com/accounts-sso/libaccounts-qt

[A] Accounts SSO
[M] René Rebe <rene@exactco.de>

[C] extra/library
[F] CROSS

[L] LGPL
[V] 1.17

[D] 64d326e4c5fba06457f51ca355b8271c578b17d6e16038b0935b3278 libaccounts-qt-VERSION_1.17.tar.bz2 https://gitlab.com/accounts-sso/libaccounts-qt/-/archive/VERSION_1.17/

qmake=qmake
atstage cross && qmake='$root$bindir/host-qmake6 QMAKE_CC=$CC QMAKE_CXX=$CXX QMAKE_LINK=$CXX QMAKE_LINK_SHLIB=$CXX'
hook_add premake 5 "$qmake PREFIX=/$prefix LIBDIR=$libdir"
var_append makeinstopt ' ' INSTALL_ROOT=$root
