[CV-GROUP] kde-gear
[D] 38c851211784c7c66e86706ae8280abb86eddacca65c8072bd63de4d akonadi-26.08.1.tar.xz https://download.kde.org/stable/release-service/26.08.1/src/

. $base/package/*/*/kde-conf.in

# protocolgen is a build-time code generator
build_native_protocolgen() {
	local d=$(find $builddir -maxdepth 4 -type d -path '*/private/protocolgen' | head -1)
	local out=$builddir/protocolgen-native
	$HOSTCXX $(pkg-config --cflags Qt6Core) \
		$d/main.cpp $d/cppgenerator.cpp $d/cpphelper.cpp \
		$d/nodetree.cpp $d/typehelper.cpp $d/xmlparser.cpp \
		-fPIC -o $out $(pkg-config --libs Qt6Core)

	var_append cmakeopt ' ' -DPROTOCOLGEN_EXECUTABLE=$out
}
atstage cross && hook_add preconf 5 build_native_protocolgen
