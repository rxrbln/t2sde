[I] The office-suite of the KDE project

[T] KOffice is the full-featured office-suite of the KDE project.
[T]
[T] This release includes the following components: KWord (a frame-based,
[T] full-featured word processor); KPresenter (a presentation application);
[T] KSpread (a spreadsheet application); KIllustrator (a vector-drawing
[T] application); Krayon (a bitmap image editor); Kivio (a flowchart app-
[T] lication); KChart (a chart drawing application); KFormula (a formula
[T] editor); Kugar (a tool for generating business quality reports); and
[T] filters (for importing/exporting documents).

[U] https://calligra.org/

[A] The KDE-Team
[M] René Rebe <rene@exactco.de>

[C] extra/office extra/desktop/kde
[F] CROSS OBJDIR

[E] opt cups
[E] opt okular
[E] opt qt6webengine

[L] GPL
[V] 26.08.2

[CV-GROUP] kde-gear
[D] 029f975a914acbdeb6c62955c1b744a22ef1b8f71d2e0e06902b05dd calligra-26.08.2.tar.xz https://download.kde.org/stable/release-service/26.08.2/src/

. $base/package/*/*/kde-conf.in

var_append CXX_WRAPPER_APPEND ' ' "-I$root/$(pkgprefix includedir fontconfig)"

[ "$SDECFG_LIBC" = glibc ] && atstage cross &&
	var_append cmakeopt ' ' -DMODERN_ICONV_RUN=0

build_native_tools() {
	local qt=$root/TOOLCHAIN/cross/qt t src
	for t in devtools/rng2cpp/rng2cpp filters/sheets/excel/sidewinder/recordsxml2cpp; do
		src=$(find $builddir -maxdepth 6 -path "*/$t.cpp" | head -1)
		$HOSTCXX -std=c++17 -fPIC -I$qt/include -I$qt/include/QtCore -I$qt/include/QtXml \
			$src -o $builddir/${t##*/}-native \
			-L$qt/lib -lQt6Xml -lQt6Core -Wl,-rpath,$qt/lib
	done
	var_append cmakeopt ' ' -DRNG2CPP_EXECUTABLE=$builddir/rng2cpp-native
	var_append cmakeopt ' ' -DRECORDSXML2CPP_EXECUTABLE=$builddir/recordsxml2cpp-native
}
atstage cross && hook_add preconf 5 build_native_tools
