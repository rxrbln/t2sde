Use the FlexLexer.h installed with the flex generating the scanner. The bundled
flex 2.6.4 copy does not declare yyread(), as emitted by newer flex (2.6.14):

holidayscannerplan.lpp:79:25: error: no declaration matches 'int HolidayScannerFlexLexer::yyread(char*, size_t)'

Signed-off-by: René Rebe <rene@exactco.de>

--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -30,7 +30,6 @@ target_sources(
         lunarphase.h
         parsers/holidayparserdriver.cpp
         parsers/holidayparserdriver_p.h
-        parsers/plan2/FlexLexer.h
         parsers/plan2/holidayparserdriverplan.cpp
         parsers/plan2/holidayparserdriverplan_p.h
         parsers/plan2/holidayscannerplan_p.h
@@ -90,6 +89,9 @@ ecm_generate_export_header(KF6Holidays
 target_include_directories(KF6Holidays INTERFACE "$<INSTALL_INTERFACE:${KDE_INSTALL_INCLUDEDIR_KF}/KHolidays>")
 target_include_directories(KF6Holidays PUBLIC "$<BUILD_INTERFACE:${KHolidays_SOURCE_DIR}/src/parsers/plan2>")
 target_include_directories(KF6Holidays PRIVATE "${CMAKE_BINARY_DIR}/src")
+if(FLEX_INCLUDE_DIRS)
+    target_include_directories(KF6Holidays PRIVATE ${FLEX_INCLUDE_DIRS})
+endif()
 
 target_link_libraries(KF6Holidays PUBLIC Qt6::Core)
 
--- a/src/parsers/plan2/holidayscannerplan_p.h
+++ b/src/parsers/plan2/holidayscannerplan_p.h
@@ -2,6 +2,7 @@
     This file is part of the kholidays library.
 
     SPDX-FileCopyrightText: 2010 John Layt <john@layt.net>
+    SPDX-FileCopyrightText: 2026 René Rebe <rene@exactco.de>
 
     SPDX-License-Identifier: LGPL-2.0-or-later
 */
@@ -21,7 +22,7 @@
 
 #ifndef __FLEX_LEXER_H
 #define yyFlexLexer HolidayScannerFlexLexer
-#include "FlexLexer.h"
+#include <FlexLexer.h>
 #undef yyFlexLexer
 #endif
 
