[I] Libraries and daemons to implement searching in Akonadi

[T] Xapian-based indexing and query infrastructure for Akonadi.

[U] https://invent.kde.org/pim/akonadi-search

[A] The KDE-Team
[M] René Rebe <rene@exactco.de>

[C] extra/office extra/desktop/kde
[F] CROSS OBJDIR

[L] GPL
[V] 26.08.3
[P] X -----5---9 202.000

[CV-GROUP] kde-gear
[D] a0c5ef6f96c02c70e4011c427dcb10522ee65afa1b6870f4fd4a88d3 akonadi-search-26.08.3.tar.xz https://download.kde.org/stable/release-service/26.08.3/src/

. $base/package/*/*/kde-conf.in

pkginstalled rustc ||
	var_append cmakeopt ' ' -DCMAKE_DISABLE_FIND_PACKAGE_Corrosion=ON

atstage cross && var_append cmakeopt ' ' "-DXAPIAN_SHARED_LIBRARY=$root$(pkgprefix libdir xapian-core)/libxapian.so -DXAPIAN_INCLUDE_DIR=$root$(pkgprefix includedir xapian-core)"
