[I] Plasma workspace

[T] Plasma Workspace is used as the base for Plasma Desktop, Mobile, and
[T] Bigscreen. It contains shared KCMs, applets as well as multiple libraries.

[U] https://invent.kde.org/plasma/plasma-workspace

[A] The KDE-Team
[M] René Rebe <rene@exactco.de>

[C] extra/office extra/desktop/kde
[F] CROSS OBJDIR

[E] opt systemd
[E] opt libqualculate
[E] opt xdotool

[L] GPL
[V] 6.8.2
[P] X -----5---9 200.310

[CV-GROUP] kde-plasma
[D] c3d4d0acc932c82b45f33ff59616ee2df8bb7ce3a7aa3a84cd56f239 plasma-workspace-6.8.2.tar.xz https://download.kde.org/stable/plasma/6.8.2/

. $base/package/*/*/kde-conf.in

plasma_splash() {
	gzip -9 < $base/misc/artwork/t2.svg > \
		lookandfeel/org.kde.breeze/contents/splash/images/plasma.svgz

	patch -p1 < $confdir/fullscreen-splash.diff
	sed -i "s,images/plasma.svgz,$datadir/wallpapers/Next/contents/images/1743x1196.jpg," \
		lookandfeel/org.kde.breeze/contents/splash/Splash.qml
}
hook_add preconf 1 plasma_splash

var_append GCC_WRAPPER_APPEND ' ' "-I$root$(pkgprefix includedir xcb-util) -L$root$(pkgprefix libdir xcb-util)"

atstage cross && var_append CXX_WRAPPER_APPEND ' ' "-L$root$(pkgprefix libdir glib)"
pkginstalled kdoctools docbook-xml docbook-xsl || var_append cmakeopt ' ' -DBUILD_DOC=OFF
