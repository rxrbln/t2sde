 using namespace Qt::StringLiterals;
 
+// splits a locale name into its base and @modifier part, dropping the charset
+static std::pair<QString, QString> splitLocaleName(const QString &name)
+{
+    const qsizetype at = name.indexOf(u'@');
+    const QString modifier = at < 0 ? QString() : name.mid(at);
+    QString base = at < 0 ? name : name.left(at);
+    const qsizetype dot = base.indexOf(u'.');
+    if (dot >= 0) {
+        base.truncate(dot);
+    }
+    return {base, modifier};
+}
