[I] Library for Wayland based shells

[T] Mir is set of libraries for building Wayland based shells.

[U] https://canonical.com/mir

[A] Canonical
[M] andrei32 <andrei32.t2@gmail.com>

[C] extra/base
[F] CROSS OBJDIR

[E] add pillow
[E] add wlcs
[R] - alpha arc avr32 blackfin cris hppa hppa64 i860 m68k microblaze nios2 openrisc superh

[L] GPL LGPL
[V] 2.31.0

[D] e180012e28429ca52c9b3238a953bf9a74cbe16f5d4ebb1bf706a420 mir-2.31.0.tar.gz https://github.com/canonical/mir/archive/v2.31.0/

runcargo=0

var_append GCC_WRAPPER_APPEND ' ' "-I$(pkgprefix includedir libx11) -L$(pkgprefix libdir libx11)"

# tests need python-dbusmock
var_append cmakeopt ' ' -DMIR_ENABLE_TESTS=OFF

# the wayland wrapper generator runs at build time, build it for the build host
mir_host_generator() {
	$BUILDCXX -std=c++20 -O2 -o $builddir/$xsrcdir/mir_wayland_generator.host $builddir/$xsrcdir/src/wayland/generator/*.cpp \
		$(PKG_CONFIG_PATH="$SYSPKG_CONFIG_PATH" PKG_CONFIG_LIBDIR="$SYSPKG_CONFIG_LIBDIR" \
		  pkg-config --cflags --libs libxml++-5.0) -Wl,-rpath,$root/TOOLCHAIN/cross/lib
}
atstage cross && hook_add preconf 5 mir_host_generator
atstage cross && var_append cmakeopt ' ' '-DMIR_WAYLAND_GENERATOR=$builddir/$xsrcdir/mir_wayland_generator.host'
