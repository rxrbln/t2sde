agreety uses nix::sys::utsname, built alone it does not get the feature
unified from the greetd workspace member.

--- greetd-0.10.3.orig/agreety/Cargo.toml
+++ greetd-0.10.3/agreety/Cargo.toml
@@ -13,4 +13,4 @@
 rpassword = "5.0"
 getopts = "0.2"
 enquote = "1.1"
-nix = "0.27"
+nix = { version = "0.27", features = ["feature"] }
