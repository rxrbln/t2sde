Use the project version when building a release tarball outside an hg checkout.

--- wofi-v1.5.3.orig/meson.build
+++ wofi-v1.5.3/meson.build
@@ -14,7 +14,10 @@ hg = find_program('hg', native : true, r
 version = meson.project_version()
 
 if hg.found()
-	version = run_command(hg, 'identify', check : true).stdout().strip()
+	hg_id = run_command(hg, 'identify', check : false)
+	if hg_id.returncode() == 0
+		version = hg_id.stdout().strip()
+	endif
 endif
 
 add_project_arguments('-D_GNU_SOURCE', '-DVERSION="' + version + '"', language : 'c')
