[I] A wayland compsitor based neuswc, forked from wsxwm and inspired by hevel

[T] Neuwm is a wayland compsitor based neuswc, forked from wsxwm
[T] and inspired by hevel.

[U] https://git.sr.ht/~pfr/neuwm

[A] pfr
[M] The T2 Project <t2@t2-project.org>

[C] extra/tool
[F] CROSS

[L] UNL
[V] 2ab821a8

[D] 6364e91721c2a3e5fa578a65fc1401d94bf2a5cfe926e05e10858e1a neuwm-2ab821a8.tar.gz git+https://git.sr.ht/~pfr/neuwm

hook_add postmake 5 'neuwm_postinst'

neuwm_postinst() {
	mkdir -v $root$sysconfdir/$pkg/
	cp -v example/config.lua $root$sysconfdir/$pkg/config.lua.example
}
