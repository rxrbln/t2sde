[I] Wayland C++ bindings

[T] C++ bindings and a protocol scanner (wayland-scanner++) for the
[T] Wayland window system protocol, required e.g. by Kodi for its
[T] Wayland windowing backend.

[U] https://github.com/NilsBrause/waylandpp

[A] Nils Brause
[M] Dennie Mahne <dennie.mahne@gmail.com>

[C] extra/wayland
[F] CROSS

[E] opt doxygen graphviz

[L] MIT
[V] 1.0.1

[D] ee607937b33d1803a89b5fc31578fd1527d376fda6fc78a60ecacce2 waylandpp-1.0.1.tar.gz https://github.com/NilsBrause/waylandpp/archive/1.0.1/

# the protocol generator runs at build time, build it natively
waylandpp_native_scanner() {
	local nat=$builddir/native
	mkdir -p $nat
	(cd $nat && env PATH="${PATH/$CMD_WRAPPER_MYPATH:/}" CC=$HOSTCC CXX=$HOSTCXX \
		CFLAGS= CXXFLAGS= LDFLAGS= PKG_CONFIG_SYSROOT_DIR= \
		PKG_CONFIG_PATH=$root/TOOLCHAIN/cross/lib/pkgconfig PKG_CONFIG_LIBDIR=$root/TOOLCHAIN/cross/lib/pkgconfig \
		cmake $builddir/waylandpp-$ver -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
			-DBUILD_LIBRARIES=OFF -DBUILD_DOCUMENTATION=OFF &&
		make wayland-scanner++) || return 1
	var_append cmakeopt ' ' "-DWAYLAND_SCANNERPP=$nat/wayland-scanner++"
}
atstage cross && hook_add preconf 5 waylandpp_native_scanner
