The strict c11 convert_cont lacked the strdup declaration, its implicit int
return truncated the pointer and the build time helper crashed.

--- a/cursor/convert_font.c
+++ b/cursor/convert_font.c
@@ -26,6 +26,8 @@
  * http://fontforge.org/pcf-format.html
  */
 
+#define _POSIX_C_SOURCE 200809L
+
 #include <assert.h>
 #include <fcntl.h>
 #include <stdint.h>
