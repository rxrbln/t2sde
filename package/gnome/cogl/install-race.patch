Fix parallel install race: relinking libgstcogl needs the installed libcogl-gst.

--- cogl-1.22.8.orig/cogl-gst/Makefile.am	2020-06-04 13:57:11.000000000 +0200
+++ cogl-1.22.8/cogl-gst/Makefile.am	2026-09-25 19:34:40.189753691 +0200
@@ -50,6 +50,8 @@ libgstcogl_la_SOURCES =	\
 	$(NULL)
 
 plugin_LTLIBRARIES = libgstcogl.la
+# relinking the plugin needs the installed libcogl-gst
+install-pluginLTLIBRARIES: install-libLTLIBRARIES
 
 libgstcogl_la_CFLAGS = $(COGL_DEP_CFLAGS) $(COGL_GST_DEP_CFLAGS) $(COGL_EXTRA_CFLAGS) $(MAINTAINER_CFLAGS)
 libgstcogl_la_LIBADD = \
--- cogl-1.22.8.orig/cogl-gst/Makefile.in	2020-06-04 14:59:53.000000000 +0200
+++ cogl-1.22.8/cogl-gst/Makefile.in	2026-09-25 19:34:40.190243183 +0200
@@ -1086,6 +1086,9 @@ uninstall-am: uninstall-cogl_gstheadersH
 
 @HAVE_INTROSPECTION_TRUE@CoglGst-2.0.gir: libcogl-gst.la Makefile
 
+# relinking the plugin needs the installed libcogl-gst
+install-pluginLTLIBRARIES: install-libLTLIBRARIES
+
 # Tell versions [3.59,3.63) of GNU make to not export all variables.
 # Otherwise a system limit (for SysV at least) may be exceeded.
 .NOEXPORT:
