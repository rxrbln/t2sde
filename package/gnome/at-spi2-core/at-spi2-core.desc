[D] 55f0a97ba0e162172acc3546a414be43467a898ad33ff03582f8dd47 at-spi2-core-2.62.1.tar.xz http://ftp.gnome.org/pub/gnome/sources/at-spi2-core/2.62/

. $base/package/*/*/gnome-conf.in

var_append mesonopt ' ' "-Ddbus_services_dir=$root/usr/share/dbus-1/services -Dsystemd_user_dir=$root/usr/lib/systemd/user"

pkginstalled dbus-glib && var_append mesonopt ' ' -Ddbus_glib=enabled
