[I] C support library

[T] GLib is a library which includes support routines for C such as
[T] lists, trees, hashes, memory allocation, and many other things.

[U] https://www.gtk.org/

[A] Peter Mattis <petm@xcf.berkeley.edu>
[M] René Rebe <rene@exactco.de>

[C] extra/development
[F] CROSS

[E] add jinja2 typogrify

[L] LGPL
[V] 2.90.1
[P] X -----5---9 127.400

[CV-URL] https://download.gnome.org/sources/glib-networking/cache.json
[D] 85db1d7d8a57c25281caaa94fa462689c971f39f000b90200afd8633 glib-networking-2.90.1.tar.xz https://download.gnome.org/sources/glib-networking/2.90/

. $base/package/*/*/gnome-conf.in

var_append mesonopt ' ' --libexecdir=$root/$prefix/libexec
var_append mesonopt ' ' --localedir=$root/$datadir/locale
var_remove mesonopt ' ' --prefix=$root/$prefix
var_append mesonopt ' ' --prefix=$root/usr

var_append mesonopt ' ' -Dtests=false
pkginstalled openssl && var_append mesonopt ' ' -Dopenssl=enabled
