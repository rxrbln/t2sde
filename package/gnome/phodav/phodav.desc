[I] Gnome phodav package

[T] Core Gnome phodav package.

[U] https://www.gnome.org

[A] The GNOME Project <gnome-devel-list@gnome.org>
[M] René Rebe <rene@exactco.de>

[C] extra/shell extra/desktop/gnome
[F] CROSS

[L] LGPL
[V] 3.2

[CV-URL] https://download.gnome.org/sources/phodav/cache.json
[D] 88d1586c7b63b33b926e35bdc7674a79e07e37308f5049a9f0957e97 phodav-3.2.tar.xz https://download.gnome.org/sources/phodav/3.2/

. $base/package/*/*/gnome-conf.in

pkginstalled asciidoc docbook-xml docbook-xsl xmlto libxml libxslt gtk-doc && ! atstage cross ||
	var_append mesonopt ' ' -Dgtk_doc=disabled
pkginstalled avahi || var_append mesonopt ' ' -Davahi=disabled
