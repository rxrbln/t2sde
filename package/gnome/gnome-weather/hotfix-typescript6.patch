TypeScript 6 removed the baseUrl option, map the src/ imports with paths,
needs an explicit rootDir and reports the bind_property_full mismatch at the
first argument, move the @ts-expect-error directives there.

diff -urp a/src/app/thermometer.ts b/src/app/thermometer.ts
--- a/src/app/thermometer.ts	2026-11-25 20:38:14.618959231 +0000
+++ b/src/app/thermometer.ts	2026-11-25 20:38:14.629239150 +0000
@@ -287,10 +287,11 @@ export class Thermometer extends Gtk.Wid
             GObject.BindingFlags.DEFAULT
         );
 
-        // @ts-expect-error ts-for-gir does not `bind_property_full` correctly. In GJS it actually returns a
+        // ts-for-gir does not `bind_property_full` correctly. In GJS it actually returns a
         // tuple of [boolean, value] where the boolean is whether the transformation succeeded, and the value
         // is the transformed value.
         this.bind_property_full(
+            // @ts-expect-error see above
             'range',
             this.lowLabel,
             'label',
@@ -301,8 +302,8 @@ export class Thermometer extends Gtk.Wid
             null
         );
 
-        // @ts-expect-error Same as the above.
         this.bind_property_full(
+            // @ts-expect-error Same as the above.
             'range',
             this.highLabel,
             'label',
diff -urp a/tsconfig.json b/tsconfig.json
--- a/tsconfig.json	2026-11-25 20:37:24.198242525 +0000
+++ b/tsconfig.json	2026-11-25 20:38:14.629280660 +0000
@@ -2,8 +2,11 @@
     "compilerOptions": {
         "experimentalDecorators": true,
         "strict": true,
+        "rootDir": "./src",
+        "paths": {
+            "src/*": ["./src/*"]
+        },
         "target": "ES2022",
-        "baseUrl": ".",
         "moduleResolution": "bundler",
         "module": "ES2022",
         "lib": [
@@ -18,4 +21,4 @@
         "types",
         "src",
     ]
-}
\ No newline at end of file
+}
