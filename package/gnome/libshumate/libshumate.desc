[I] A GTK toolkit providing widgets for embedded maps

[T] Shumate is a GTK toolkit providing widgets for embedded maps.

[U] https://gitlab.gnome.org/GNOME/libshumate

[A] The GNOME Project
[M] René Rebe <rene@exactco.de>

[C] extra/tool
[F] CROSS

[E] opt sysprof

[L] LGPL
[V] 1.7.1

[D] e0df67a994eeaefb991703b7d2b529dc4403d7878e3fffea6c297ade libshumate-1.7.1.tar.gz https://gitlab.gnome.org/GNOME/libshumate/-/archive/1.7.1/

hook_add preconf 1 "rm -rvf $builddir/$pkg-$ver/subprojects/"
pkginstalled gobject-introspection || var_append mesonopt ' ' -Dgir=false
pkginstalled vala || var_append mesonopt ' ' -Dvapi=false
pkginstalled gi-docgen && ! atstage cross || var_append mesonopt ' ' -Dgtk_doc=false
