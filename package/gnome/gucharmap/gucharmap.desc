[I] A Unicode/ISO10646 character map and font viewer

[T] gucharmap displays the whole Unicode range for any chosen font.
[T] For single characters it displays among other information the
[T] Unicode codepoint, the official character name, aliases, usage
[T] notes and cross-references. Searching is supported and of course
[T] copying. It includes a GTK+2 Input Method Module.

[U] https://gitlab.gnome.org/GNOME/gucharmap gucharmap Homepage

[A] Noah Levitt <nlevitt@columbia.edu>

[M] Susanne Klaus <vadja@gmx.de>

[C] extra/desktop/gnome extra/text
[F] CROSS

[L] GPL
[V] 18.0.0

[D] 70bcb2b7af2ae2a3a620dbaf0b26f26cfe947b2d08df74db61c25c67 gucharmap-18.0.0.tar.bz2 https://gitlab.gnome.org/GNOME/gucharmap/-/archive/18.0.0/
[D] a282e8116bc8560b0156eab843ed70b0a6058c6afe81031276053aaf unicode-ucd-18.0.0.zip https://www.unicode.org/Public/18.0.0/ucd/UCD.zip
[D] 925857fc36ccdc01773ce735bb540bbe380676d00773a9d0b7e25474 unicode-unihan-18.0.0.zip https://www.unicode.org/Public/18.0.0/ucd/Unihan.zip

. $base/package/*/*/gnome-conf.in

gucharmap_ucd() {
	# the Unicode character database matching the version
	mkdir -p ucd
	unzip -oq $(match_source_file -p unicode-ucd) -d ucd
	cp $(match_source_file -p unicode-unihan) ucd/Unihan.zip
}
hook_add preconf 5 gucharmap_ucd
var_append mesonopt ' ' -Ducd_path=$builddir/$pkg-$ver/ucd
