Generate the sqlite and sqlcipher provider .pc files from their .pc.in, without
input meson writes the configuration as C header, breaking pkg-config --list-all.

--- libgda-6.0.0.orig/providers/sqlcipher/meson.build
+++ libgda-6.0.0/providers/sqlcipher/meson.build
@@ -97,7 +97,8 @@ sqlcipher_cargs += [
 sqlcipher_cargs += c_args
 
 
-libgda_sqlcipher_providerpc = configure_file(output : 'libgda-sqlcipher-'+project_api_version+'.pc',
+libgda_sqlcipher_providerpc = configure_file(input : 'libgda-sqlcipher-'+project_api_version+'.pc.in',
+			output : 'libgda-sqlcipher-'+project_api_version+'.pc',
 			configuration : conf,
 			install_dir: join_paths(get_option('libdir'),'pkgconfig')
 			)
--- libgda-6.0.0.orig/providers/sqlite/meson.build
+++ libgda-6.0.0/providers/sqlite/meson.build
@@ -58,7 +58,8 @@ libgda_sqlite_sources = files([
 	])
 libgda_sqlite_sources += sqlite_resources
 
-libgda_sqlite_providerpc = configure_file(output : 'libgda-sqlite-'+project_api_version+'.pc',
+libgda_sqlite_providerpc = configure_file(input : 'libgda-sqlite-'+project_api_version+'.pc.in',
+			output : 'libgda-sqlite-'+project_api_version+'.pc',
 			configuration : conf,
 			install_dir: join_paths(get_option('libdir'),'pkgconfig')
 			)
