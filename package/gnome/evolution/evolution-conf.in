# Enable SSL support depending on Mozilla NSS/NSPR
pkginstalled nss && var_append confopt ' ' '--enable-nss=yes --enable-smime'
pkginstalled firefox && var_append confopt ' ' '--enable-nss=yes --enable-smime'
pkginstalled seamonkey && var_append confopt ' ' '--enable-nss=yes --enable-smime'

# Enable LDAP support in evolution
if pkginstalled openldap; then
	pkgprefix -t openldap
	var_append confopt ' ' "--with-openldap=$root/$(pkgprefix openldap)"
	[ "$SDECFG_STATIC" = 1 ] && var_append confopt ' ' "--with-static-ldap=yes" ||
		var_append confopt ' ' "--with-static-ldap=no"
fi

