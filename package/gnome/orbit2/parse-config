# the pkg-config orbit_idl is the target binary, use the native one for cross builds
if ! atstage native && [ -x $root/TOOLCHAIN/cross/bin/orbit-idl-2 ]; then
	export ORBIT_IDL=$root/TOOLCHAIN/cross/bin/orbit-idl-2
fi
