[I] Gnome gnome-software package

[T] Core Gnome gnome-software package.

[U] https://www.gnome.org

[A] The GNOME Project <gnome-devel-list@gnome.org>
[M] René Rebe <rene@exactco.de>

[C] extra/shell extra/desktop/gnome

[L] LGPL
[V] 51.1

[CV-URL] https://download.gnome.org/sources/gnome-software/cache.json
[D] 9330d475e6e4e4c4ea6cc8702c34bc635dd354fefcad19cd81c6a2e7 gnome-software-51.1.tar.xz https://download.gnome.org/sources/gnome-software/51/

. $base/package/*/*/gnome-conf.in

pkginstalled flatpak || var_append mesonopt ' ' -Dflatpak=false
pkginstalled malcontent || var_append mesonopt ' ' -Dmalcontent=false
pkginstalled packagekit || var_append mesonopt ' ' -Dpackagekit=false
pkginstalled fwupd || var_append mesonopt ' ' -Dfwupd=false
