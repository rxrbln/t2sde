[I] Gnome gspell package

[T] Core Gnome gspell package.

[U] https://www.gnome.org

[A] The GNOME Project <gnome-devel-list@gnome.org>
[M] René Rebe <rene@exactco.de>

[C] extra/shell extra/desktop/gnome
[F] CROSS

[L] LGPL
[V] 1.14.6
[P] X -----5---9 177.200

[D] 3a493cd66b8e9a94c3581717e3b67a78d51304b70963c5f873a51b6c gspell-1.14.6.tar.gz https://gitlab.gnome.org/GNOME/gspell/-/archive/1.14.6/

. $base/package/*/*/gnome-conf.in

var_append mesonopt ' ' -Dtests=false
pkginstalled vala || var_append mesonopt ' ' -Dvapi=false
pkginstalled gobject-introspection || var_append mesonopt ' ' -Dgobject_introspection=false
pkginstalled gtk-doc docbook-xml docbook-xsl && ! atstage cross || var_append mesonopt ' ' -Dgtk_doc=false
