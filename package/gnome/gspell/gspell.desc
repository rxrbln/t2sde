[V] 1.14.5
[P] X -----5---9 177.200

[D] b1199e2f820f3e789eb0cca3b71f1ea9182a0b929114f975bda74167 gspell-1.14.5.tar.gz https://gitlab.gnome.org/GNOME/gspell/-/archive/1.14.5/

. $base/package/*/*/gnome-conf.in

var_append mesonopt ' ' -Dtests=false
pkginstalled vala || var_append mesonopt ' ' -Dvapi=false
pkginstalled gobject-introspection || var_append mesonopt ' ' -Dgobject_introspection=false
pkginstalled gtk-doc docbook-xml docbook-xsl || var_append mesonopt ' ' -Dgtk_doc=false
